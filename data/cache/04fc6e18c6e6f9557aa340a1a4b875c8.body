<script>
(function ($) {
$(document).ready(function(){
  var dcookcheck = getCookie('adfilter');
  //console.log(dcookcheck);
  if(dcookcheck == 'advanceFilter'){
    $(".leftFilterShow").removeAttr("style");
    $(".fullShow").removeClass("col-lg-12"); 
    $(".advanceFilter .fa-times").removeClass("active");
  }else{
    //console.log('hi');
    $(".leftFilterShow").hide();
    $(".fullShow").addClass("col-lg-12"); 
    $(".advanceFilter .fa-times").addClass("active");
  }            
            
  $("#advanceFilterId").click(function(e){
    //alert('123');
    e.preventDefault();
    var dcook = getCookie('adfilter');
    if(dcook != 'advanceFilter'){
      var currentVal = $(this).attr('class');
      //console.log(currentVal);
      setCookie('adfilter',currentVal,'1');
      //$.cookie(currentVal,'1','1',true);
      var dcook = getCookie('adfilter');
      $(".leftFilterShow").removeAttr("style");
      $(".fullShow").removeClass("col-lg-12"); 
      $(".advanceFilter .fa-times").removeClass("active");
    }else{
      eraseCookie('adfilter');
      $(".leftFilterShow").hide();
      $(".fullShow").addClass("col-lg-12"); 
      $(".advanceFilter .fa-times").addClass("active");
    } 

  }); 
});
function setCookie(name,value,days) {
    //alert('set');
    var expires = "";
    if (days) {
        var date = new Date();
        date.setTime(date.getTime() + (days*24*60*60*1000));
        expires = "; expires=" + date.toUTCString();
    }
    document.cookie = name + "=" + (value || "");
}
function getCookie(name) {
    //alert('get');
    var nameEQ = name + "=";
    var ca = document.cookie.split(';');
    for(var i=0;i < ca.length;i++) {
        var c = ca[i];
        while (c.charAt(0)==' ') c = c.substring(1,c.length);
        if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length,c.length);
    }
    return null;
}
function eraseCookie(name) {   
    //alert('remove');
