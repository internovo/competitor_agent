  <script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://www.squareyards.com/#organization","name":"Square Yards","url":"https://www.squareyards.com/","logo":{"@type":"ImageObject","@id":"https://www.squareyards.com/#logo","url":"https://www.squareyards.com/assets/images/squareyards-logo-new.png","contentUrl":"https://www.squareyards.com/assets/images/squareyards-logo-new.png","caption":"Square Yards"},"image":{"@id":"https://www.squareyards.com/#logo"},"address":{"@type":"PostalAddress","streetAddress":"M3M Urbana Business Park, 1st Floor, Tower A, Sector 67","addressLocality":"Gurgaon","addressRegion":"Haryana","postalCode":"122102","addressCountry":"IN"},"contactPoint":[{"@type":"ContactPoint","email":"connect@squareyards.com","availableLanguage":"en"}],"sameAs":["https://www.facebook.com/SquareYards","https://www.linkedin.com/company/square-yards","https://www.youtube.com/@Square_Yards","https://www.instagram.com/square_yards/"]},{"@type":"WebSite","@id":"https://www.squareyards.com/#website","url":"https://www.squareyards.com/","name":"Square Yards","publisher":{"@id":"https://www.squareyards.com/#organization"},"inLanguage":"en-IN"},{"@type":"Organization","@id":"https://www.squareyards.com/neminath-projects/1254/builder#organization","name":"Neminath","url":"https://www.squareyards.com/neminath-projects/1254/builder","logo":{"@type":"ImageObject","url":"https://static.squareyards.com/resources/images/developerlogo/neminath-1254.jpg","contentUrl":"https://static.squareyards.com/resources/images/developerlogo/neminath-1254.jpg","caption":"Neminath developer logo"},"description":"Neminath Group is a well known realty conglomerate in Mumbai with more than 27 years of experience. It is synonymous with quality, reliability, trust, transparency, customer commitment and a firm dedication towards offering upgraded ecosystems for clients. The portfolio of Neminath projects covers more than 150 projects while it has 3, 000 happy families under its belt so far. It aims at establishing new industry benchmarks by way of quality along with adhering to all standards and regulatory guidelines. All properties are delivered on time to clients with a view towards ensuring well connected locations as well. Rapidly developing areas like Mira Road, Goregaon, Andheri, Malad, Virar, Vasai, Bhayandar are chosen for most projects. There are several commercial properties developed by the Group at strategic places too. Beautiful, peaceful ecosystems where clients co-exist with nature amidst a serene ambience is the primary goal. Major offerings include Ocean View, Rosebud, Avenue, Imperia etc. As listed on Square Yards, Neminath has 23 total projects, of which 19 are delivered."},{"@type":"ImageObject","@id":"https://www.squareyards.com/mumbai-residential-property/neminath-one-reserve/342584/project#primaryimage","url":"https://static.squareyards.com/resources/images/mumbai/project-image/neminath-one-reserve-project-project-large-image1-5404-opt-313adab7-8c1b-4372-92fd-00fef8b1eb7a.jpg","contentUrl":"https://static.squareyards.com/resources/images/mumbai/project-image/neminath-one-reserve-project-project-large-image1-5404-opt-313adab7-8c1b-4372-92fd-00fef8b1eb7a.jpg","caption":"Cover image of Neminath One Reserve, Borivali West, Mumbai"},{"@type":"BreadcrumbList","@id":"https://www.squareyards.com/mumbai-residential-property/neminath-one-reserve/342584/project#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.squareyards.com"},{"@type":"ListItem","position":2,"name":"New Projects in Mumbai","item":"https://www.squareyards.com/new-projects-in-mumbai"},{"@type":"ListItem","position":3,"name":"Projects in Borivali West","item":"https://www.squareyards.com/projects-in-borivali-west-mumbai"},{"@type":"ListItem","position":4,"name":"Neminath One Reserve","item":"https://www.squareyards.com/mumbai-residential-property/neminath-one-reserve/342584/p