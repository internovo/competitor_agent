<script src="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/glide.min.js"></script>
	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
async function fnSendMeDetail(formId, e) {
  if (e) e.preventDefault();

  const form = document.getElementById(formId);
  if (!form) {
    console.error("Form not found:", formId);
    return false;
  }

  const errorEl = form.querySelector(".form_error");
  const setErr = (msg) => { if (errorEl) errorEl.textContent = msg || ""; };

  const name = (form.querySelector('input[name="name"]')?.value || "").trim();
  const email = (form.querySelector('input[name="email"]')?.value || "").trim();
  let mobileRaw = (form.querySelector('input[name="mobile"]')?.value || "").trim();

  // ✅ sanitize mobile: keep digits only, keep last 10 digits
  let mobile = mobileRaw.replace(/\D/g, "");
  if (mobile.length > 10) mobile = mobile.slice(-10);

  const email_pattern = /^\w+([-.+']\w+)*@\w+([-.]\w+)*\.\w+([-.]\w+)*$/;
  const mobile_pattern = /^[6-9]\d{9}$/; // India standard

  if (!name) { setErr("Please enter name"); return false; }
  if (!email) { setErr("Please enter email"); return false; }
  if (!email_pattern.test(email)) { setErr("Please enter a valid email"); return false; }
  if (!mobile) { setErr("Please enter mobile no."); return false; }
  if (!mobile_pattern.test(mobile)) { setErr("Please enter a valid 10-digit mobile no."); return false; }

  setErr("");

  const btn = form.querySelector('button[type="submit"], button');
  if (btn) btn.disabled = true;

  const formattedDate = new Date().toLocaleString("en-IN", {
    timeZone: "Asia/Kolkata",
    hour12: false,
  });

  const lead = {
    name,
    email,
    mobile,
    project_id: "Bhoomi Airavat",
    ip: "",
    datetime: formattedDate,
  };

  // ✅ fetch IP (optional)
  try {
    const ipRes = await fetch("https://api.ipify.org?format=json", { cache: "no-store" });
    if (ipRes.ok) {
      const ipData = await ipRes.json();
      lead.ip = ipData.ip || "";
    }
  } catch (err) {
    console.warn("IP fetch failed, continuing without IP.");
  }

  // ✅ send lead (no-cors avoids CORS blocking that breaks success callback)
  try {
    await fetch("https://script.google.com/macros/s/AKfycbysMSoDPvAdBetrC6bu4TOXVw7Zwpevp2kfD4mFPKRlCf4q2UQi1IuA-W718j7cwJaQ/exec", {
      method: "POST",
      mode: "no-cors",
      headers: { "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8" },
      body: new URLSearchParams(lead).toString(),
    });

    window.location.href = "/thanks.html";
  } catch (err) {
    console.error("Lead POST failed:", err);
    if (btn) btn.disabled = false;
    setErr("Something went wrong. Please try again.");
  }

  return false;
}
</script>

</body>
