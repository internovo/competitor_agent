<!-- ✅ Only styling changes (same classes / same HTML) -->
<style>
  /* Navbar background */
  .main-navbar.navbar {
    background-color: #0E2A3B !important;
  }

  /* Menu text + icons white */
  .main-navbar .navbar-nav .nav-link,
  .main-navbar .navbar-nav .nav-link i {
    color: #ffffff !important;
  }

  /* Active link in gold */
  .main-navbar .navbar-nav .nav-link.active {
    color: #C8A24A !important;
  }

  /* Optional: make toggler icon visible on dark background */
  .main-navbar .navbar-toggler {
    border-color: rgba(255, 255, 255, 0.35) !important;
  }
  .main-navbar .navbar-toggler-icon {
    filter: invert(1) brightness(2);
  }

  /* Brand logo image */
  .brand-logo { display: inline-flex; align-items: center; padding: 2px 0; }
  .brand-logo-img { height: 52px; width: auto; display: block; }
  @media (max-width: 575px) {
    .brand-logo-img { height: 40px; }
  }
</style>

<script>
  /* Fix: the external app.js binds preventDefault() + smooth-scroll to EVERY
     navbar anchor (this.nav.querySelectorAll("a")). That swallows clicks on
     real-page links like About / Contact / the logo. Intercept those in the
     capture phase so the browser navigates normally; leave in-page anchor
     links (#...) and the Brochure modal trigger for app.js / Bootstrap. */
  (function () {
    var nav = document.querySelector('nav.main-navbar');
    if (!nav) return;
    nav.addEventListener('click', function (e) {
      var a = e.target.closest('a');
      if (!a || !nav.contains(a)) return;
      var href = a.getAttribute('href') || '';
      if (!href || href.charAt(0) === '#') return;       // in-page anchors -> app.js smooth scroll
      if (a.hasAttribute('data-bs-toggle')) return;       // modal triggers (Brochure)
      e.stopImmediatePropagation();                        // block app.js's preventDefault on this link
    }, true);                                              // capture: runs before app.js's per-link handler
  })();
</script>

