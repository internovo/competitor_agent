				<div class="row row-cols-1 row-cols-md-2 align-content-center">
					<div class="col justify-content-center align-content-center">
						<div class="bd-img">

							
							<picture>
								<source data-srcset="./img/banner/Shot_04_revised.jpg.jpeg">
								<img data-sizes="auto"  class="lazyload" src="./img/banner/Shot_04_revised.jpg.jpeg" data-srcset="./img/banner/Shot_04_revised.jpg.jpeg" alt="Schedule a Site Visit for Bhoomi Airavat, Borivali West">
							</picture>

													</div>
					</div>

					<div class="col pt-5">
	<form id="sitevisit" class="enq-form" onsubmit="return fnSendMeDetail('sitevisit', event)">
  <input name="form_name" type="hidden" value="Open Site Visit Form">
  <input name="is_te" type="hidden" value="">

  <input type="text" class="form-control" name="name" placeholder="Name" required>

  <input type="email" class="form-control" name="email" placeholder="Email" required>

  <input
    name="mobile"
    required
    autocomplete="off"
    type="tel"
    class="form-control"
    placeholder="Mobile No."
    inputmode="numeric"
    maxlength="10"
    pattern="[6-9][0-9]{9}"
  >

  <div class="consent">
    <div class="form-check">
      <input class="form-check-input" type="checkbox" checked required id="consentCheck-siteVisit">
      <label class="form-check-label" for="consentCheck-siteVisit">
        I Consent to The Processing of Provided Data According To I Authorize Bhoomi Shashwat Estate Private Limited and its representatives to Call, SMS, Email or WhatsApp Me About Its Products and Offers. This Consent Overrides Any Registration For DNC/NDNC.
      </label>
    </div>
  </div>

  <div class="btn-wrapper">
    <button type="submit" class="btn btn-dark btn-cta">Submit</button>
  </div>
</form>

