<style>
  /* ===== Keep your existing heights EXACT (same as you wrote) ===== */
  #mainSlider .glide__slide { height: 720px; }
  @media (max-width: 750px) {
    #mainSlider .glide__slide { height: 740px; }
  }

  /* IMPORTANT: Parent ko bhi same height do, warna absolute slides me layout break hota hai */
  #mainSlider .glide__track,
  #mainSlider .glide__slides {
    height: 720px;
  }
  @media (max-width: 750px) {
    #mainSlider .glide__track,
    #mainSlider .glide__slides {
      height: 740px;
    }
  }

  /* image sizing same as you want */
  #mainSlider picture,
  #mainSlider img {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ✅ Override any global aspect-ratio forcing landscape (your screenshot shows this is happening) */
  #mainSlider .glide__slide img {
    aspect-ratio: auto !important;
  }

  /* ===== Fade only ===== */
  #mainSlider .glide__track { overflow: hidden; }

  #mainSlider .glide__slides{
    position: relative;
    transform: translate3d(0,0,0) !important; /* stop glide translate */
    transition: none !important;
  }

  /* If clones exist, hide them (prevents ghost overlaps) */
  #mainSlider .glide__slide--clone {
    display: none !important;
  }

  #mainSlider .glide__slide{
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;

    opacity: 0;
    transition: opacity 900ms ease-in-out;
    z-index: 1;
    pointer-events: none;
  }

  #mainSlider .glide__slide--active{
    opacity: 1;
    z-index: 2;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #mainSlider .glide__slide { transition: none !important; }
  }
</style>



<script>
  document.addEventListener("DOMContentLoaded", function () {
    const slider = new Glide("#mainSlider", {
      type: "slider",
      perView: 1,
      gap: 0,
      autoplay: 4000,
      hoverpause: true,
      animationDuration: 0 // fade CSS handles animation
    });

    slider.mount();
  });
</script>



