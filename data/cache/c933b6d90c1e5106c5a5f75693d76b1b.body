<style>
	/* Parent glide container ko relative rakho */
.glide {
  position: relative;
}

/* Arrows wrapper ko full width + center vertically */
.glide__arrows {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  z-index: 1;
  pointer-events: none; /* wrapper clicks block na kare */
}

/* Buttons clickable */
.glide__arrow {
  pointer-events: auto;
  position: absolute;
  width: 44px;
  height: 44px;
  border-radius: 999px;
  border: none;
  background: #fff;
  box-shadow: 0 8px 20px rgba(0,0,0,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

/* Left side */
.glide__arrow--left {
  left: 8px;
}

/* Right side */
.glide__arrow--right {
  right: 8px;
}

/* Icon sizing */
.glide__arrow i {
  font-size: 22px;
}

/* Disabled state */
.glide__arrow:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

</style>
