function loadJSGDPR(file) {
    var jsElm = document.createElement("script");
    jsElm.type = "application/javascript";
    jsElm.src = file;
    document.body.appendChild(jsElm);
}

setTimeout(function(){
	loadJSGDPR("https://cdn.staticmb.com/magicservicestatic/js/gdpr.js")
},3500);
