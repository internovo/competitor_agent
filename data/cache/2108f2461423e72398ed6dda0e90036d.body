<script type="text/javascript">
var domainUrl='https://www.magicbricks.com/';
function shareReqPopupOpen(str){
	var iframe = document.getElementById("frameDemo");
	iframe.removeAttribute("src");
    iframe.onload = function() {
    	console.log('onload fired, about to pushState');
    	top.history.pushState('shareYourRequirementMobilePopupOpen', null, null);
    	console.log('pushState done, current state:', history.state);
        iframe.contentWindow.location.replace(domainUrl+"mbsearch/mobilePostRequirement?source=mbsrpMob&isLDP=LDP_mob&saveRequirement=Y&category=S&pType=10002,10003,10021,10022&propertyType=10002,10003,10021,10022&city=4320&alliance=&banks=&searchType=1&saveClick=Y");
        iframe.onload = null;
    };
    iframe.srcdoc = "";
	//document.getElementById("frameDemo").src = domainUrl+"mbsearch/mobilePostRequirement?source=mbsrpMob&isLDP=LDP_mob&saveRequirement=Y&category=S&pType=10002,10003,10021,10022&propertyType=10002,10003,10021,10022&city=4320&alliance=&banks=&searchType=1&saveClick=Y";
	//document.getElementById("frameDemo").src = "http://localhost:8086/mbutility/mbsearch/shareYourRequirement?&city=3327&disWap=N&frmwhrid=plot-mela";
    document.getElementById(str).classList.add("show");
    document.getElementsByTagName("body")[0].classList.add("no-overflow");
    document.getElementById('background-layer').classList.add("show");
}
function shareReqPopupClose(str){
    document.getElementById(str).classList.remove("show");
    document.getElementsByTagName("body")[0].classList.remove("no-overflow");
    document.getElementById('background-layer').classList.remove("show");
    document.getElementById("frameDemo").src ="";
    var iframe = document.getElementById("frameDemo");
    iframe.srcdoc = "";
    iframe.removeAttribute("src");
    
}
</script>
