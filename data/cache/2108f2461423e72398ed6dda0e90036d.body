	function fireHomeLoanGA(ctaParam, linkElement) {
	    
	    if (typeof (window.MB_GTM_dataLayer) === "undefined") {
	        window.MB_GTM_dataLayer = [];
	    }

	    let data = {
	        "event": "event_tracking",
	        "eventName": "hp_tool_advice",
	        "nonInteraction": false,
	        "eventCategory": "home_loan",
	        "eventAction": "home_loan initiated",
	        "eventLabel": "source_page:hp|cta:" + (ctaParam),
	        "eventValue": 0
	    };

	    // Add cd169 only if URL contains "homeloan"
	    data["cd169"] = "home_loan_hook";
	    MB_GTM_dataLayer.push(data);
	}

