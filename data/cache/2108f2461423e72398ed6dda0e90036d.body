.background-layer {
	position: fixed;
	width: 100%;
	height: 100%;
	top: 0;
	left: 0;
	z-index: 9999;
	background: rgba(0, 0, 0, 0.8);
	-webkit-transition: all 0.3s;
	-moz-transition: all 0.3s;
	transition: all 0.3s;
	display: none
}
.background-layer.show {
	display: block
}
.requirement-poup {
	border-radius: 8px;
	background-color: #fff;
	z-index: 10000;
	box-sizing: border-box;
	position: absolute;
	top: 50%;
	left: 50%;
    translate: -50% -50%;
	position: fixed;
	display: none;
	width: 420px;
	height: 520px;
    font-family: 'Open Sans';
    font-weight: 400;
    color: #303030;
    font-size: 14px;
    overflow: hidden;
}
.requirement-poup.show {
	display: block
}
.requirement-poup__close a {
	cursor: pointer;
	line-height: 1em;
	position: absolute;
	right: 8px;
	top: 8px;
	width: 20px;
	height: 20px;
	z-index: 1
}
.requirement-poup__close a:before,
.requirement-poup__close a:after {
	background-color: #fff;
	content: " ";
	height: 18px;
	position: absolute;
	width: 2px;
	top: 50%;
	left: 50%;
    translate: -50% -50%;
}
.requirement-poup__close a:before {
	transform: rotate(45deg)
}
.requirement-poup__close a:after {
	transform: rotate(-45deg)
}

.requirement-poup__head {
	font-size: 18px;
	color: #333;
	font-weight: 600;
	text-align: center;
	padding: 2px 0 12px 0
}
.requirement-poup__content {
    font-family: 'Open Sans';
    font-weight: 400;
    height: 100%;
    box-sizing: border-box;
}

.requirement-poup__content iframe{
    width: 100%;
    height: 100%;
}

</style>
 





 

 















