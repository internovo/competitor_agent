										<img data-src="https://img.staticmb.com/mbimages/photo_dir/developer/original_images/61167/Kaustubh-Constructions-Pvt.-Ltd.-1401788821052-d.gif" class="loc-det__buildeslogo-img custom-lazy" alt=""/>
									
									
								
