Certain rooms offer in-room amusement features such as the television for your enjoyment. It is worth noting that certain guest bathrooms feature a hair dryer and toiletries for your convenience. At the hotel, an assortment of easily accessible and delicious meal choices are available to satisfy your appetite whenever it strikes.","address":{"@type":"PostalAddress","addressCountry":"IN","addressLocality":"Badami","addressRegion":"","postalCode":"587201","streetAddress":"Krishna Heritage Hotel"},"photo":"https://images.getaroom-cdn.com/image/upload/s--sONPVi8N--/c_limit,e_improve,fl_lossy.immutable_cache,h_940,q_auto:good,w_940/v1737471715/2ba51f596fc2676bc68e9f0bcfb4510213822c39?_a=BACAEuEv&atc=e7cd1cfa"}</script><script type="97907f1624b6be851fb15967-application/javascript">window._CTZ = {"enabled":true,"verticals":{"hotel":{"active":true,"property":{"id":"f91c4171-9aba-5b5c-bb19-c57a7e701c09","name":"Krishna heritage","address":"Krishna Heritage Hotel","latitude":"15.91633415","longitude":"75.66459656"},"search":{"city":"Badami","province":"","countryCode":"IN","checkInDate":"09/08/2026","checkOutDate":"09/09/2026","rooms":[{"adults":2,"children":0,"infants":0}]}}},"extra":{"hotel_url":"/krishna-heritage/booking","hotel_name":"Krishna heritage","hotel_image_url":"https://images.getaroom-cdn.com/image/upload/s--r4jmAlke--/c_limit,e_improve,fl_lossy.immutable_cache,h_460,q_auto:good,w_460/v1737471715/2ba51f596fc2676bc68e9f0bcfb4510213822c39?_a=BACAEuEv&atc=e7cd1cfa"}};</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the address for Krishna heritage?","acceptedAnswer":{"@type":"Answer","text":"The property is located at Krishna Heritage Hotel in Badami."}},{"@type":"Question","name":"How much does it cost per night to stay at Krishna heritage?","acceptedAnswer":{"@type":"Answer","text":"Prices vary based on dates and availability. Select the dates of your stay above to find the best price on all available rooms."}},{"@type":"Question","name":"What times are check-in and check-out at Krishna heritage?","acceptedAnswer":{"@type":"Answer","text":"Check-in begins at 12:00 and check-out is at 11:00 at Krishna heritage. Early check-in or late check-out may be available at an additional cost."}},{"@type":"Question","name":"Does Krishna heritage have a pool?","acceptedAnswer":{"@type":"Answer","text":"No, this hotel does not have a pool, but it has other amenities for guests to enjoy. Please see the hotel description above for more information."}},{"@type":"Question","name":"Is there a restaurant at Krishna heritage?","acceptedAnswer":{"@type":"Answer","text":"Yes, this hotel does have at least one on-site restaurant to enjoy during your stay. Room service is also available should you prefer meals from the comfort of your room. Check out the hotel description above to learn more about the dining options available at Krishna heritage."}},{"@type":"Question","name":"Is there free breakfast available at Krishna heritage?","acceptedAnswer":{"@type":"Answer","text":"Breakfast may be available at Krishna heritage, and may come free with your room, depending on your selection. Please check for dates and room availability above to see what's included with your stay."}},{"@type":"Question","name":"What is there to do at Krishna heritage?","acceptedAnswer":{"@type":"Answer","text":"Guests at Krishna heritage can enjoy amenities such as a restaurant during their stay. Check out the hotel description to learn more about the amenities available during your stay."}},{"@type":"Question","name":"Are there any discounts or deals for Krishna heritage?","acceptedAnswer":{"@type":"Answer","text":"We offer a wide variety of rates on Krishna heritage. Discounted rates are available throughout the year, depending on your travel dates. Search for your dates above and we'll show you our lowest prices."}},{"@type":"Question","name":"Are there promo or coupon codes available for Krishna heritage?","acceptedAnswer":{"@type":"Answer","text":"By logging into our site using the login banner above, you'll receive an instant discount of 5% on your booking today with no limit to how much you can save. Log in, claim your promo code, select your dates and room and apply your code at checkout."}}]}</script>        <link rel="alternate" type="text/html" hreflang="x-default" href="https://www.guestreservations.com/krishna-heritage/booking" title="English"/><link rel="alternate" type="text/html" hreflang="en-US" href="https://www.guestreservations.com/krishna-heritage/booking" title="English"/><link rel="alternate" type="text/html" hreflang="es-419" href="https://www.guestreservations.com/es/krishna-heritage/booking" title="Español"/><link rel="alternate" type="text/html" hreflang="es-ES" href="https://www.guestreservations.com/es-ES/krishna-heritage/booking" title="Español (España)"/><link rel="alternate" type="text/html" hreflang="de-DE" href="https://www.guestreservations.com/de/krishna-heritage/booking" title="Deutsch"/><link rel="alternate" type="text/html" hreflang="fr-FR" href="https://www.guestreservations.com/fr/krishna-heritage/booking" title="Français"/><link rel="alternate" type="text/html" hreflang="pt-PT" href="https://www.guestreservations.com/pt/krishna-heritage/booking" title="Português"/><link rel="alternate" type="text/html" hreflang="it-IT" href="https://www.guestreservations.com/it/krishna-heritage/booking" title="Italiano"/><link rel="alternate" type="text/html" hreflang="nl-NL" href="https://www.guestreservations.com/nl/krishna-heritage/booking" title="Nederlands"/><link rel="alternate" type="text/html" hreflang="pl-PL" href="https://www.guestreservations.com/pl/krishna-heritage/booking" title="Polski"/><link rel="alternate" type="text/html" hreflang="tr-TR" href="https://www.guestreservations.com/tr/krishna-heritage/booking" title="Türkçe"/><link rel="alternate" type="text/html" hreflang="id-ID" href="https://www.gues