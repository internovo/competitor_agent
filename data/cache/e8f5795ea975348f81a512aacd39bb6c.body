/* ── Lazy images (IntersectionObserver) ── */
(function(){
  if(!('IntersectionObserver' in window)){
    document.querySelectorAll('.lazy').forEach(function(i){i.src=i.dataset.src;i.classList.add('loaded')});return;
  }
  var obs=new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        var img=e.target;
        img.src=img.dataset.src;
        img.onload=function(){img.classList.add('loaded')};
        obs.unobserve(img);
      }
    });
  },{rootMargin:'200px 0px'});
  document.querySelectorAll('.lazy').forEach(function(i){obs.observe(i)});
})();

/* ── Scroll animations ── */
(function(){
  if(!('IntersectionObserver' in window))return;
  var obs=new IntersectionObserver(function(entries){
    entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('vis');obs.unobserve(e.target)}});
  },{threshold:.07,rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.proj-card,.cat-card,.loc-card,.faq-item').forEach(function(el){obs.observe(el)});
})();

/* ── Vanilla JS Form Validation ── */
var V={
  name:function(v){return v.trim().length>=2?'':'Please enter your full name'},
  email:function(v){return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim())?'':'Please enter a valid email'},
  phone:function(v){return /^[\+\d\s\-\(\)]{8,15}$/.test(v.trim())?'':'Please enter a valid phone number'}
};
function showErr(id,msg){var el=document.getElementById(id);if(!el)return;el.textContent=msg;el.style.display=msg?'block':'none'}
function vField(inp,errId,key){var err=V[key](inp.value);showErr(errId,err);var fg=inp.closest('.cf-group');if(fg)fg.classList.toggle('has-err',!!err);return !err}
/* Real-time blur validation */
var flds=[['cf-name','cfe-name','name'],['cf-email','cfe-email','email'],['cf-phone','cfe-phone','phone']];
flds.forEach(function(f){var el=document.getElementById(f[0]);if(el)el.addEventListener('blur',function(){vField(this,f[1],f[2])},{passive:true})});

function handleLeadSubmit(e){
  e.preventDefault();
  /* Honeypot check */
  var hp=document.querySelector('[name="_hp"]');if(hp&&hp.value)return false;
  var ok=true;
  flds.forEach(function(f){if(!vField(document.getElementById(f[0]),f[1],f[2]))ok=false});
  if(!ok)return false;
  var btn=document.getElementById('cfSubmit');
  var txt=document.getElementById('cfSubmitText');
  var spin=document.getElementById('cfSpinner');
  btn.disabled=true;txt.textContent='Sending…';spin.hidden=false;
  setTimeout(function(){
    btn.disabled=false;txt.textContent='📩 Request My Property Shortlist';spin.hidden=true;
    document.getElementById('cfSuccess').hidden=false;
    document.getElementById('leadForm').reset();
    setTimeout(function(){document.getElementById('cfSuccess').hidden=true},5000);
  },1400);
  return false;
}

/* ── Floating WhatsApp show on scroll ── */

/* ── Popup (15s, sessionStorage guard) ── */
function openPopup(){
  var p=document.getElementById('propPopup');
  var b=document.getElementById('popupBox');
  p.classList.add('open');p.setAttribute('aria-hidden','false');
  document.body.style.overflow='hidden';
  setTimeout(function(){b.classList.add('shown')},10);
}
function closePopup(){
  var p=document.getElementById('propPopup');
  var b=document.getElementById('popupBox');
  b.classList.remove('shown');
  setTimeout(function(){p.classList.remove('open');p.setAttribute('aria-hidden','true');document.body.style.overflow=''},200);
}
document.getElementById('propPopup').addEventListener('click',function(e){if(e.target===this)closePopup()});
var _ps=false;
/*setTimeout(function(){
  if(!_ps&&!sessionStorage.getItem('pc_popup')){openPopup();_ps=true;sessionStorage.setItem('pc_popup','1')}
},15000);*/

function handlePopupSubmit(e){
  e.preventDefault();
  setTimeout(function(){
    alert('Thank you! We\'ll contact you within 24 hours with matching properties.');
    closePopup();
    document.getElementById('popupForm').reset();
  },400);
  return false;
}

/* ── Cities Modal ── */
function openCitiesModal(){
  var m=document.getElementById('citiesModal');
  var b=document.getElementById('citiesModalBox');
  m.setAttribute('aria-hidden','false');
  m.classList.add('open');
  document.body.style.overflow='hidden';
  setTimeout(function(){b.classList.add('shown')},10);
}
function closeCitiesModal(){
  var m=document.getElementById('citiesModal');
  var b=document.getElementById('citiesModalBox');
  b.classList.remove('shown');
  setTimeout(function(){
    m.classList.remove('open');
    m.setAttribute('aria-hidden','true');
    document.body.style.overflow='';
  },260);
}
document.addEventListener('keydown',function(e){
  if(e.key==='Escape' && document.getElementById('citiesModal').classList.contains('open')) closeCitiesModal();
});

/* ── Escape key ── */
document.addEventListener('keydown',function(e){
  if(e.key==='Escape'){closeMob();closePopup();if(document.getElementById('citiesModal').classList.contains('open'))closeCitiesModal()}
});

/* ── Smooth anchor scroll ── */
document.querySelectorAll('a[href^="#"]').forEach(function(a){
  a.addEventListener('click',function(e){
    var id=this.getAttribute('href').slice(1);
    var el=document.getElementById(id);
    if(el){e.preventDefault();closeMob();el.scrollIntoView({behavior:'smooth',block:'start'})}
  });
});

/* ── Navbar shadow on scroll ── */
window.addEventListener('scroll',function(){
  document.getElementById('navbar').classList.toggle('scrolled',window.pageYOffset>10);
},{passive:true});
</script>
