<!-- JAVASCRIPT -->
<script type="01a08a1283613c9a792866d7-text/javascript">
/* Navbar scroll */
window.addEventListener('scroll',function(){document.getElementById('navbar').classList.toggle('scrolled',window.pageYOffset>10)},{passive:true});

/* Gallery swap */
var galleryImages=['https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=900&h=675&fit=crop&auto=format','https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=900&h=675&fit=crop&auto=format','https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=900&h=675&fit=crop&auto=format','https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=900&h=675&fit=crop&auto=format'];
function swapGallery(thumb,i){document.getElementById('galleryMain').src=galleryImages[i];document.querySelectorAll('.gallery-thumb').forEach(function(t){t.classList.remove('active')});thumb.classList.add('active')}

/* About Read More */
function toggleAbout(){var m=document.getElementById('aboutMore');var b=document.getElementById('aboutToggle');if(m.classList.contains('open')){m.classList.remove('open');b.innerHTML='Read More <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M19 9l-7 7-7-7"/></svg>'}else{m.classList.add('open');b.innerHTML='Read Less <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M5 15l7-7 7 7"/></svg>'}}

/* Floor Plan tabs */
function switchFP(i,tab){document.querySelectorAll('.fp-panel').forEach(function(p){p.classList.remove('active')});document.querySelectorAll('.fp-tab').forEach(function(t){t.classList.remove('active')});document.getElementById('fp'+i).classList.add('active');tab.classList.add('active')}

/* Brochure Modal */
function openBrochureModal(){document.getElementById('brochureOverlay').classList.add('active');document.body.style.overflow='hidden'}
function closeBrochureModal(){document.getElementById('brochureOverlay').classList.remove('active');document.body.style.overflow='';setTimeout(function(){document.getElementById('brochureFormBody').style.display='';document.getElementById('brochureSuccess').style.display='none';document.querySelectorAll('#brochureFormBody input').forEach(function(el){el.value='';el.classList.remove('bm-error')})},300)}
function submitBrochureForm(){var valid=true;['bmName','bmPhone','bmEmail'].forEach(function(id){var el=document.getElementById(id);if(!el.value.trim()){el.classList.add('bm-error');valid=false}else{el.classList.remove('bm-error')}});var emailEl=document.getElementById('bmEmail');if(emailEl.value&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value)){emailEl.classList.add('bm-error');valid=false}if(!valid)return;document.getElementById('brochureFormBody').style.display='none';document.getElementById('brochureSuccess').style.display='block'}
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&document.getElementById('brochureOverlay').classList.contains('active'))closeBrochureModal()})

/* FAQ accordion */
function toggleFaq(q){var a=q.nextElementSibling;var arrow=q.querySelector('.faq-arrow');var isOpen=a.classList.contains('open');document.querySelectorAll('.faq-a.open').forEach(function(fa){fa.classList.remove('open')});document.querySelectorAll('.faq-arrow.open').forEach(function(ar){ar.classList.remove('open')});if(!isOpen){a.classList.add('open');arrow.classList.add('open')}}

/* Star rating */
var currentRating=0;
function setRating(n){currentRating=n;var stars=document.querySelectorAll('#starRating span');stars.forEach(function(s,i){s.classList.toggle('active',i<n)})}

/* Review submit */
function submitReview(e){e.preventDefault();alert('Thank you for your review!');e.target.reset();currentRating=0;document.querySelectorAll('#starRating span').forEach(function(s){s.classList.remove('active')})}

/* Enquiry Modal */
function openEnquiryModal(){var m=document.getElementById('enqModal');var b=document.getElementById('enqBox');document.getElementById('enqForm').style.display='flex';document.getElementById('enqSuccess').classList.remove('show');m.setAttribute('aria-hidden','false');m.classList.add('open');document.body.style.overflow='hidden';setTimeout(function(){b.classList.add('shown')},10);setTimeout(function(){document.getElementById('enqName').focus()},300)}
function closeEnquiryModal(){var m=document.getElementById('enqModal');var b=document.getElementById('enqBox');b.classList.remove('shown');setTimeout(function(){m.classList.remove('open');m.setAttribute('aria-hidden','true');document.body.style.overflow=''},250)}
function submitEnquiry(){var name=document.getElementById('enqName').value.trim();var phone=document.getElementById('enqPhone').value.trim();if(!name){document.getElementById('enqName').focus();document.getElementById('enqName').style.borderColor='#dc2626';return}if(!phone){document.getElementById('enqPhone').focus();document.getElementById('enqPhone').style.borderColor='#dc2626';return}document.getElementById('enqForm').style.display='none';document.getElementById('enqSuccess').classList.add('show')}

/* Report Error Modal */
function openReportModal(){var m=document.getElementById('reportModal');var b=document.getElementById('reportBox');m.setAttribute('aria-hidden','false');m.classList.add('open');document.body.style.overflow='hidden';setTimeout(function(){b.classList.add('shown')},10)}
function closeReportModal(){var m=document.getElementById('reportModal');var b=document.getElementById('reportBox');b.classList.remove('shown');setTimeout(function(){m.classList.remove('open');m.setAttribute('aria-hidden','true');document.body.style.overflow=''},250)}
function submitReport(){var name=document.getElementById('repName').value.trim();var email=document.getElementById('repEmail').value.trim();if(!name||!email){alert('Please fill in name and email.');return}alert('Thank you! Your report has been submitted.');closeReportModal()}

/* Escape key */
document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeMob();if(document.getElementById('citiesModal').classList.contains('open'))closeCitiesModal();if(document.getElementById('enqModal').classList.contains('open'))closeEnquiryModal();if(document.getElementById('reportModal').classList.contains('open'))closeReportModal()}});
</script>