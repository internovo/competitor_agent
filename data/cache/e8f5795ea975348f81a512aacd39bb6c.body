<style>
.contact-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:10000;display:none;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)}
.contact-modal-overlay.active{display:flex}
.contact-modal{background:#fff;border-radius:16px;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;position:relative;box-shadow:0 25px 60px rgba(0,0,0,.3);animation:contactSlideUp .3s ease}
@keyframes contactSlideUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.contact-modal-header{background:var(--secondary);color:#fff;padding:28px 32px 24px;border-radius:16px 16px 0 0;position:relative}
.contact-modal-header h2{font-family:var(--font-sans);font-size:1.5rem;font-weight:700;margin:0 0 4px}
.contact-modal-header p{font-size:.9rem;color:rgba(255,255,255,.7);margin:0}
.contact-modal-close{position:absolute;top:16px;right:16px;width:36px;height:36px;border-radius:50%;border:none;background:rgba(255,255,255,.1);color:#fff;font-size:1.3rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s}
.contact-modal-close:hover{background:rgba(255,255,255,.25)}
.contact-modal-body{padding:28px 32px 32px}
.cm-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.cm-field{margin-bottom:16px}
.cm-field:last-child{margin-bottom:0}
.cm-field label{display:block;font-size:.8rem;font-weight:600;color:var(--gray-700);margin-bottom:6px;text-transform:uppercase;letter-spacing:.04em}
.cm-field input,.cm-field select,.cm-field textarea{width:100%;padding:11px 14px;border:1.5px solid var(--gray-200);border-radius:8px;font-size:.95rem;font-family:var(--font-sans);color:var(--gray-900);transition:border-color .2s,box-shadow .2s;box-sizing:border-box}
.cm-field input:focus,.cm-field select:focus,.cm-field textarea:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(30,126,52,.1)}
.cm-field textarea{resize:vertical;min-height:80px}
.cm-field input.cm-error,.cm-field select.cm-error,.cm-field textarea.cm-error{border-color:#dc2626}
.cm-submit-btn{width:100%;padding:14px;background:var(--primary);color:#fff;border:none;border-radius:10px;font-size:1rem;font-weight:600;font-family:var(--font-sans);cursor:pointer;transition:background .2s,transform .2s;margin-top:8px}
.cm-submit-btn:hover{background:var(--primary-hover);transform:translateY(-1px)}
.cm-contact-info{display:flex;gap:20px;margin-top:20px;padding-top:20px;border-top:1px solid var(--gray-200)}
.cm-contact-info a{display:flex;align-items:center;gap:6px;font-size:.85rem;color:var(--gray-600);text-decoration:none;transition:color .2s}
.cm-contact-info a:hover{color:var(--primary)}
.cm-success{display:none;text-align:center;padding:40px 32px}
.cm-success svg{width:64px;height:64px;color:var(--primary);margin-bottom:16px}
.cm-success h3{font-family:var(--font-sans);font-size:1.3rem;color:var(--gray-900);margin:0 0 8px}
.cm-success p{color:var(--gray-500);font-size:.95rem;margin:0 0 24px}
.cm-success-btn{padding:12px 32px;background:var(--primary);color:#fff;border:none;border-radius:8px;font-size:.95rem;font-weight:600;cursor:pointer;transition:background .2s}
.cm-success-btn:hover{background:var(--primary-hover)}
@media(max-width:540px){.cm-row{grid-template-columns:1fr}.contact-modal-header,.contact-modal-body{padding:20px 20px}.contact-modal{margin:10px}}
</style>

<div class="contact-modal-overlay" id="contactModalOverlay" onclick="if (!window.__cfRLUnblockHandlers) return false; if(event.target===this)closeContactModal()" data-cf-modified-01a08a1283613c9a792866d7-="">
  <div class="contact-modal">
    <div class="contact-modal-header">
      <h2>Contact Us</h2>
      <p>We'd love to hear from you. Fill in the details below.</p>
      <button class="contact-modal-close" onclick="if (!window.__cfRLUnblockHandlers) return false; closeContactModal()" aria-label="Close" data-cf-modified-01a08a1283613c9a792866d7-="">&times;</button>
    </div>
    <div class="contact-modal-body" id="contactFormBody">
      <div class="cm-row">
        <div class="cm-field"><label>Name *</label><input type="text" id="cmName" placeholder="Your name"></div>
        <div class="cm-field"><label>Phone *</label><input type="tel" id="cmPhone" placeholder="+91 XXXXX XXXXX"></div>
      </div>
      <div class="cm-field"><label>Email *</label><input type="email" id="cmEmail" placeholder="your@email.com"></div>
      <div class="cm-field"><label>Subject</label><select id="cmSubject"><option value="">Select a subject</option><option>Buy Property</option><option>Sell Property</option><option>Rent Property</option><option>Home Loan</option><option>Property Valuation</option><option>General Inquiry</option></select></div>
      <div class="cm-field"><label>Message *</label><textarea id="cmMessage" placeholder="Tell us how we can help you..."></textarea></div>
      <button class="cm-submit-btn" onclick="if (!window.__cfRLUnblockHandlers) return false; submitContactForm()" data-cf-modified-01a08a1283613c9a792866d7-="">Send Message</button>
      <div class="cm-contact-info">        ✉ <a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="0f7f7d607f6a7d7b766c7d60784f68626e6663216c6062">[email&#160;protected]</a>
      </div>
    </div>
    <div class="cm-success" id="contactSuccess">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12l2.5 2.5L16 9"/></svg>
      <h3>Message Sent!</h3>
      <p>Thank you for reaching out. Our team will get back to you within 24 hours.</p>
      <button class="cm-success-btn" onclick="if (!window.__cfRLUnblockHandlers) return false; closeContactModal()" data-cf-modified-01a08a1283613c9a792866d7-="">Close</button>
    </div>
  </div>
</div>

<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script type="01a08a1283613c9a792866d7-text/javascript">
function openContactModal(){document.getElementById('contactModalOverlay').classList.add('active');document.body.style.overflow='hidden'}
function closeContactModal(){document.getElementById('contactModalOverlay').classList.remove('active');document.body.style.overflow='';setTimeout(()=>{document.getElementById('contactFormBody').style.display='';document.getElementById('contactSuccess').style.display='none';document.querySelectorAll('#contactFormBody input,#contactFormBody select,#contactFormBody textarea').forEach(el=>{el.value='';el.classList.remove('cm-error')})},300)}
function submitContactForm(){
  let valid=true;
  ['cmName','cmPhone','cmEmail','cmMessage'].forEach(id=>{const el=document.getElementById(id);if(!el.value.trim()){el.classList.add('cm-error');valid=false}else{el.classList.remove('cm-error')}});
  const emailEl=document.getElementById('cmEmail');if(emailEl.value&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value)){emailEl.classList.add('cm-error');valid=false}
  if(!valid)return;
  document.getElementById('contactFormBody').style.display='none';document.getElementById('contactSuccess').style.display='block';
}
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&document.getElementById('contactModalOverlay').classList.contains('active'))closeContactModal()});
</script>

<script type="01a08a1283613c9a792866d7-text/javascript">
(function(){
    /* === Lazy-load reCAPTCHA on first form interaction (keeps it off the critical path) === */
    var rcLoaded=false;
    window.loadRecaptcha=function(){
        if(rcLoaded) return; rcLoaded=true;
        var s=document.createElement('script');
        s.src='https://www.google.com/recaptcha/api.js?render=6LdUjDgtAAAAAACh9dPMzNNaRvkH8psoPfwLKTqw';
        s.async=true; s.defer=true;
        document.head.appendChild(s);
    };
    document.querySelectorAll('form input').forEach(function(i){
        i.addEventListener('focus', window.loadRecaptcha, { once:true });
    });
})();
(function(){
    /* === Form submission — vanilla JS, no jQuery === */
    window.submitFormV3=function(form,suffix){
        var n=form.name.value.trim(),
            e=form.email.value.trim(),
            m=form.mobile.value.trim(),
            errM=form.querySelector('.errmsg'+suffix),
            succM=document.querySelector('.succmsg'+suffix);

        if(!n){alert('Please Enter Name.');form.name.focus();return false}
        if(!m){alert('Please Enter Contact Number.');form.mobile.focus();return false}
        if(!e||!/^[\w.-]+@[\w.-]+\.\w{2,6}$/i.test(e)){alert('Please enter a valid Email address!');form.email.focus();return false}

        var btn=form.querySelector('button[type="submit"]');
        btn.disabled=true;btn.textContent='Submitting...';

		grecaptcha.ready(function() {
            grecaptcha.execute('6LdUjDgtAAAAAACh9dPMzNNaRvkH8psoPfwLKTqw', {action: 'enquiry'}).then(function(token){
                form.recaptcha_token.value = token;
				//console.log("aaa "+token);
				var fd=new FormData(form);
				fetch('/postemailusqc.php',{method:'POST',body:fd})
				.then(function(r){return r.text()})
				.then(function(d){ console.log('resp'+d);
					if(d.trim()=='true'){
						errM.style.display='none';errM.innerHTML='';
						//window.location='thankyou.html';
						form.style.display='none';
						succM.style.display='block';
					}else{
						errM.innerHTML=d;errM.style.display='block';
						btn.disabled=false;btn.textContent='Submit';
						form.style.display='block';
						succM.style.display='none';
					}
				})
				.catch(function(){
					alert('An error occurred. Please try again.');
					btn.disabled=false;btn.textContent='Submit';
				});
			});
        });

        return false;
    };
})();
</script>
<script src="/cdn-cgi/scripts/7d0fa10a/cloudflare-static/rocket-loader.min.js" data-cf-settings="01a08a1283613c9a792866d7-|49" defer></script><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"dfe113155d6f48c0bd8d0c76654358d8","r":1,"spa":2}' crossorigin="anonymous"></script>
</body>
