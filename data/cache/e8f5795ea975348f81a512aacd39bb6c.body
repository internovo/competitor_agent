/* ── Non-blocking font load ── */
(function(){
  var l=document.createElement('link');
  l.rel='stylesheet';
  l.href='https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap';
  document.head.appendChild(l);
})();

/* ── Mobile menu ── */
var ham=document.getElementById('hamburger');
var mob=document.getElementById('mobileMenu');
var ov=document.getElementById('mobileOverlay');
var mc=document.getElementById('mobileClose');
function openMob(){ham.classList.add('active');mob.classList.add('active');ov.classList.add('active');document.body.style.overflow='hidden';mob.setAttribute('aria-hidden','false');ham.setAttribute('aria-expanded','true')}
function closeMob(){ham.classList.remove('active');mob.classList.remove('active');ov.classList.remove('active');document.body.style.overflow='';mob.setAttribute('aria-hidden','true');ham.setAttribute('aria-expanded','false')}
ham.addEventListener('click',function(){mob.classList.contains('active')?closeMob():openMob()});
mc.addEventListener('click',closeMob);
ov.addEventListener('click',closeMob);

/* Mobile accordion dropdowns */
document.querySelectorAll('.mob-dropdown-toggle').forEach(function(el){
  el.addEventListener('click',function(){
    var target=document.getElementById(el.dataset.target);
    var arrow=el.querySelector('.mob-dropdown-arrow');
    var isOpen=target.classList.contains('open');
    document.querySelectorAll('.mob-dropdown-content').forEach(function(c){c.classList.remove('open')});
    document.querySelectorAll('.mob-dropdown-arrow').forEach(function(a){a.classList.remove('open')});
    if(!isOpen){target.classList.add('open');arrow.classList.add('open')}
  });
});

