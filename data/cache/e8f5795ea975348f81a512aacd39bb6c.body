  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- ════════════════════════════════════
       CRITICAL ABOVE-THE-FOLD CSS (Inlined)
       Nav + Hero + Search Box + Mobile Menu
  ════════════════════════════════════ -->
  <style>
    /* ── TOKENS ── */
    :root{
      --primary:#1e7e34;
      --primary-hover:#166428;
      --primary-light:#27a847;
      --secondary:#0d2016;
      --secondary-light:#152a1d;
      --secondary-lighter:#1c3d2a;
      --gold:#c8960c;
      --white:#ffffff;
      --gray-50:#f9fafb;
      --gray-100:#f3f4f6;
      --gray-200:#e5e7eb;
      --gray-300:#d1d5db;
      --gray-400:#9ca3af;
      --gray-500:#6b7280;
      --gray-600:#4b5563;
      --gray-700:#374151;
      --gray-900:#111827;
      --font-serif:'Playfair Display',Georgia,serif;
      --font-sans:'Inter',system-ui,-apple-system,sans-serif;
      --transition:.3s ease;
      --shadow-sm:0 1px 3px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.06);
      --shadow-md:0 4px 6px rgba(0,0,0,.07),0 2px 4px rgba(0,0,0,.06);
      --shadow-lg:0 10px 40px rgba(0,0,0,.1);
      --shadow-xl:0 20px 60px rgba(0,0,0,.15);
    }

    /* ── RESET ── */
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
    body{font-family:var(--font-sans);color:var(--gray-900);background:var(--white);line-height:1.6;overflow-x:hidden}
    img{display:block;max-width:100%;height:auto}
    a{text-decoration:none;color:inherit}
    button,input,select,textarea{font:inherit;border:none;outline:none;background:none}
    ul{list-style:none}

    /* ── TYPOGRAPHY ── */
    h1,h2,h3{font-family:var(--font-serif);line-height:1.15;font-weight:600}
    h1{font-size:clamp(2rem,5vw,4rem);letter-spacing:-.5px;line-height:1}
    h2{font-size:clamp(1.75rem,4vw,3.75rem);letter-spacing:-.3px}
    h3{font-size:clamp(1.1rem,2vw,1.5rem)}

    /* ── UTILITIES ── */
    .container{max-width:1280px;margin:0 auto;padding:0 24px}
    @media(min-width:768px){.container{padding:0 32px}}
    .sr-only{position:absolute;width:1px;height:1px;clip:rect(0,0,0,0);overflow:hidden}

    /* ══════════════════════════
       NAVBAR (white, fixed)
    ══════════════════════════ */
    #navbar{
      position:fixed;top:0;left:0;right:0;z-index:50;
      background:var(--white);
      box-shadow:var(--shadow-sm);
    }
    .nav-inner{
      display:flex;align-items:center;justify-content:space-between;
      height:80px;
    }
    /* Logo - NEVER animated */
    .logo{
      display:flex;align-items:center;
      text-decoration:none;
      flex-shrink:0;
    }
    .logo img{width:250px;height:auto}
    .logo-accent{color:var(--primary)}

    /* Desktop nav links */
    .nav-links{display:none;align-items:center;gap:32px}
    @media(min-width:1024px){.nav-links{display:flex}}
    .nav-links a{
      font-size:.875rem;letter-spacing:.025em;color:var(--secondary);
      transition:color var(--transition);white-space:nowrap;
      padding:4px 0;
    }
    .nav-links a:hover{color:var(--primary)}
    .nav-cta-btn{
      display:inline-block;padding:10px 24px!important;
      background:var(--primary);color:#fff!important;
      font-size:.875rem;font-weight:600;letter-spacing:.03em;
      transition:box-shadow var(--transition),transform var(--transition),background var(--transition);
      white-space:nowrap;
    }
    .nav-cta-btn:hover{background:var(--primary-hover);box-shadow:var(--shadow-lg);transform:translateY(-1px);color:#fff!important}
    .nav-cta-outline{background:transparent!important;border:2px solid var(--primary);color:var(--primary)!important}
    .nav-cta-outline:hover{background:var(--primary)!important;color:#fff!important}

    /* Mobile sticky bottom bar */
    .mob-sticky-bar{display:none;position:fixed;bottom:0;left:0;right:0;z-index:800;background:#fff;border-top:1px solid var(--gray-200);padding:10px 16px;box-shadow:0 -4px 20px rgba(0,0,0,.08);gap:10px}
    .mob-sticky-btn{flex:1;text-align:center;padding:12px 16px;font-size:.88rem;font-weight:600;font-family:var(--font-sans);border-radius:8px;transition:all .2s;text-decoration:none}
    .mob-sticky-fill{background:var(--primary);color:#fff}
    .mob-sticky-fill:hover{background:var(--primary-hover)}
    .mob-sticky-outline{background:#fff;color:var(--primary);border:2px solid var(--primary)}
    .mob-sticky-outline:hover{background:var(--primary);color:#fff}
    @media(max-width:1023px){.mob-sticky-bar{display:flex}body{padding-bottom:70px}.float-wa{bottom:80px!important}}

    /* Dropdown */
    .dropdown{position:relative}
    .dropdown-menu{
      position:absolute;top:calc(100% + 8px);left:0;
      background:var(--white);min-width:220px;
      box-shadow:0 10px 40px rgba(0,0,0,.1);
      border-radius:8px;
      opacity:0;visibility:hidden;
      transform:translateY(-10px);
      transition:all var(--transition);z-index:100;
    }
    .dropdown:hover .dropdown-menu{opacity:1;visibility:visible;transform:translateY(0)}
    .dropdown-menu a{
      display:block;padding:12px 20px;
      color:var(--secondary);font-size:.875rem;
      transition:all .2s ease;
    }
    .dropdown-menu a:first-child{border-radius:8px 8px 0 0}
    .dropdown-menu a:last-child{border-radius:0 0 8px 8px}
    .dropdown-menu a:hover{background:var(--gray-100);color:var(--primary);padding-left:24px}
    .dropdown-arrow{display:inline-block;margin-left:4px;transition:transform var(--transition)}
    .dropdown:hover .dropdown-arrow{transform:rotate(180deg)}

    /* Hamburger */
    .hamburger{
      display:flex;flex-direction:column;justify-content:space-around;
      width:24px;height:20px;cursor:pointer;
      background:none;border:none;color:var(--secondary);
    }
    @media(min-width:1024px){.hamburger{display:none}}
    .hamburger span{
      display:block;width:100%;height:2px;
      background:currentColor;transition:all var(--transition);
    }
    .hamburger.active span:nth-child(1){transform:rotate(45deg) translate(5px,5px)}
    .hamburger.active span:nth-child(2){opacity:0}
    .hamburger.active span:nth-child(3){transform:rotate(-45deg) translate(7px,-7px)}

    /* ══════════════════════
       MOBILE MENU (slides from right)
    ══════════════════════ */
    .mobile-menu{
      position:fixed;top:0;right:-100%;
      width:100%;max-width:400px;height:100vh;
      background:var(--secondary);z-index:9999;
      transition:right .4s cubic-bezier(.4,0,.2,1);
      overflow-y:auto;
      box-shadow:-4px 0 24px rgba(0,0,0,.3);
    }
    .mobile-menu.active{right:0}
    .mobile-overlay{
      position:fixed;inset:0;
      background:rgba(0,0,0,.5);z-index:9998;
      opacity:0;visibility:hidden;
      transition:opacity .4s ease,visibility .4s ease;
    }
    .mobile-overlay.active{opacity:1;visibility:visible}
    .mobile-menu-inner{padding:24px}
    .mobile-menu-header{
      display:flex;align-items:center;justify-content:space-between;
      margin-bottom:48px;
    }
    .mobile-logo{font-size:1.5rem;font-weight:600;color:#fff;letter-spacing:-.5px}
    .mobile-logo span{color:var(--primary-light)}
    .mobile-close{
      color:#fff;background:none;border:none;cursor:pointer;padding:8px;
      display:flex;align-items:center;justify-content:center;
    }
    .mobile-close svg{width:24px;height:24px}
    .mobile-nav-link{
      display:block;color:#fff;font-size:1.125rem;font-weight:500;
      padding:12px 0;border-bottom:1px solid rgba(255,255,255,.1);
      transition:color var(--transition);
    }
    .mobile-nav-link:hover{color:var(--primary-light)}
    .mob-dropdown-toggle{
      display:flex;align-items:center;justify-content:space-between;cursor:pointer;
    }
    .mob-dropdown-arrow{transition:transform var(--transition)}
    .mob-dropdown-arrow.open{transform:rotate(180deg)}
    .mob-dropdown-content{
      max-height:0;overflow:hidden;
      transition:max-height .3s ease;
      padding-left:1rem;
    }
    .mob-dropdown-content.open{max-height:500px}
    .mob-dropdown-content a{
      display:block;padding:10px 0;
      color:rgba(255,255,255,.7);font-size:.95rem;
      border-bottom:1px solid rgba(255,255,255,.05);
      transition:color var(--transition);
    }
    .mob-dropdown-content a:hover{color:var(--primary-light)}

    /* ── BREADCRUMB ── */
    .breadcrumb{background:var(--gray-50);border-bottom:1px solid var(--gray-200);padding:12px 0}
    .breadcrumb-inner{display:flex;align-items:center;gap:6px;font-size:.78rem;color:var(--gray-500)}
    .breadcrumb-inner a{color:var(--primary);transition:color .2s}
    .breadcrumb-inner a:hover{color:var(--primary-hover)}
    .breadcrumb-sep{color:var(--gray-400)}
    .breadcrumb-item{display:inline;}

        #navbar{z-index:500;transition:box-shadow var(--transition)}
    #navbar.scrolled{box-shadow:0 2px 20px rgba(0,0,0,.12)}
    .breadcrumb{margin-top:72px}
    /* HERO */
    .detail-hero{padding:32px 0 40px}
    .detail-hero-grid{display:grid;grid-template-columns:1fr;gap:28px}
    .detail-hero-grid .gallery{order:2}
    .detail-hero-grid .info-card{order:1}
    @media(min-width:900px){.detail-hero-grid{grid-template-columns:1.3fr 1fr;gap:36px}.detail-hero-grid .gallery{order:1}.detail-hero-grid .info-card{order:2}}
    .gallery-main{width:100%;aspect-ratio:4/3;overflow:hidden;background:var(--gray-100);position:relative}
    .gallery-main img{width:100%;height:100%;object-fit:cover;transition:opacity .3s}
    .gallery-thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:8px}
    .gallery-thumb{aspect-ratio:4/3;overflow:hidden;cursor:pointer;border:2px solid transparent;background:var(--gray-100);transition:border-color .2s}
    .gallery-thumb.active{border-color:var(--primary)}
    .gallery-thumb img{width:100%;height:100%;object-fit:cover}
    .info-card{background:var(--white);border:1px solid var(--gray-200);padding:28px;display:flex;flex-direction:column;gap:16px}
    @media(min-width:900px){.info-card{position:sticky;top:88px}}
    .info-badge{display:inline-block;padding:4px 12px;background:#dcfce7;color:var(--primary);font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;align-self:flex-start}
    .info-developer{font-size:.8rem;color:var(--gray-500)}
    .info-card h1{color:var(--secondary);margin:0}
    .info-loc{display:flex;align-items:flex-start;gap:6px;font-size:.85rem;color:var(--gray-600)}
    .info-loc svg{flex-shrink:0;margin-top:2px;color:var(--primary)}
    .info-chips{display:flex;flex-wrap:wrap;gap:6px}
    .info-chip{padding:5px 14px;border:1.5px solid var(--gray-300);font-size:.78rem;font-weight:600;color:var(--gray-700);border-radius:20px}
    .info-config-text{font-size:.85rem;font-weight:600;color:var(--gray-700)}
    .info-price-row{display:flex;flex-direction:column;gap:12px}
    .info-price-item{display:flex;flex-direction:column;gap:2px}
    .info-price-label{font-size:.7rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:.06em}
    .info-price-val{font-size:1.05rem;font-weight:700;color:var(--secondary)}
    .info-price-val--green{color:var(--primary)}
    .info-cta-row{display:flex;gap:10px}
    .info-cta-enq{flex:1;padding:13px 16px;background:var(--primary);color:#fff;font-size:.85rem;font-weight:700;letter-spacing:.03em;text-transform:uppercase;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:background .2s}
    .info-cta-enq:hover{background:var(--primary-hover)}
    .info-cta-wa{width:48px;height:48px;background:#25D366;color:#fff;display:flex;align-items:center;justify-content:center;border:none;cursor:pointer;flex-shrink:0;transition:box-shadow .2s}
    .info-cta-wa:hover{box-shadow:0 4px 16px rgba(37,211,102,.4)}
    .info-rera{font-size:.75rem;color:var(--gray-500);line-height:1.5}
    .info-rera strong{color:var(--gray-700)}

    /* QUICK INFO BAR */
    .quick-bar{background:var(--gray-50);border-top:1px solid var(--gray-200);border-bottom:1px solid var(--gray-200);padding:20px 0}
    .quick-bar-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
    @media(min-width:640px){.quick-bar-grid{grid-template-columns:repeat(3,1fr)}}
    @media(min-width:900px){.quick-bar-grid{grid-template-columns:repeat(5,1fr)}}
    .quick-item{text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px}
    .quick-item svg{color:var(--primary)}
    .quick-label{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--gray-500)}
    .quick-val{font-size:.9rem;font-weight:700;color:var(--secondary)}

    /* SECTION COMMON */
    .detail-section{padding:48px 0;border-bottom:1px solid var(--gray-200)}
    .section-title{font-size:3rem!important;color:var(--secondary);margin-bottom:1.5rem!important}
    .section-overline{font-size:.68rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--primary);display:block;margin-bottom:8px}

    /* ABOUT */
    .about-text, .about-text p{font-size:.9rem;color:var(--gray-600);line-height:1.8;margin-bottom:14px}
    .about-more{display:none}
    .about-more.open{display:inline;margin-left:-4px;}
    .about-toggle-btn{display:inline-flex;align-items:center;gap:4px;font-size:.82rem;font-weight:700;color:var(--primary);cursor:pointer;border:none;background:none;padding:4px 0;transition:color .2s}
    .about-toggle-btn:hover{color:var(--primary-hover)}

    /* PRICE TABLE */
    .price-table{width:100%;border-collapse:collapse;border:1px solid var(--gray-200)}
    .price-table th{background:var(--secondary);color:#fff;padding:12px 16px;font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;text-align:left;border:1px solid var(--gray-200)}
    .price-table td{padding:12px 16px;font-size:.85rem;color:var(--gray-700);border:1px solid var(--gray-200)}
    .price-table tr:nth-child(even) td{background:var(--gray-50)}
    .price-table .type-header td{background:var(--gray-100);font-weight:700;color:var(--secondary);font-size:.82rem}
    @media(max-width:640px){.price-table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}}

    /* PAYMENT PLANS */
    .payment-cards{display:grid;grid-template-columns:1fr;gap:16px}
    @media(min-width:640px){.payment-cards{grid-template-columns:1fr 1fr}}
    .payment-card{border:1.5px solid var(--gray-200);padding:24px;display:flex;flex-direction:column;gap:8px;transition:border-color .2s}
    .payment-card:hover{border-color:var(--primary)}
    .payment-card h3{font-size:1rem;color:var(--secondary)}
    .payment-card p{font-size:.85rem;color:var(--gray-500);line-height:1.6}

    /* AMENITIES */
    .amenities-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
    @media(min-width:640px){.amenities-grid{grid-template-columns:repeat(3,1fr)}}
    @media(min-width:900px){.amenities-grid{grid-template-columns:repeat(4,1fr)}}
    .amenity-item{display:flex;align-items:center;gap:12px;padding:14px 16px;border:1px solid var(--gray-200);transition:border-color .2s,background .2s}
    .amenity-item:hover{border-color:var(--primary);background:#f0fdf4}
    .amenity-icon{width:36px;height:36px;background:var(--gray-50);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--primary)}
    .amenity-label{font-size:.82rem;font-weight:600;color:var(--gray-700)}

    /* SPECS */
    .spec-group{margin-bottom:20px}
    .spec-group-title{font-size:.85rem;font-weight:700;color:var(--secondary);padding:12px 0;border-bottom:1px solid var(--gray-200);margin-bottom:8px;text-transform:uppercase;letter-spacing:.04em;font-family:var(--font-sans)}
    .spec-list{padding-left:20px;list-style:disc}
    .spec-list li{font-size:.85rem;color:var(--gray-600);line-height:1.8;margin-bottom:4px}

    /* BROCHURE BUTTON */
    .brochure-btn{width:100%;padding:12px 16px;background:none;border:1.5px solid var(--primary)!important;color:var(--primary);font-size:.85rem;font-weight:700;letter-spacing:.03em;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:all .2s}
    .brochure-btn:hover{background:var(--primary);color:#fff}

    /* BROCHURE MODAL */
    .brochure-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:10000;display:none;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)}
    .brochure-overlay.active{display:flex}
    .brochure-modal{background:#fff;border-radius:16px;width:100%;max-width:480px;overflow:hidden;box-shadow:0 25px 60px rgba(0,0,0,.3);animation:brochureSlide .3s ease}
    @keyframes brochureSlide{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
    .brochure-modal-header{background:var(--secondary);color:#fff;padding:24px 28px;position:relative}
    .brochure-modal-header h2{font-family:var(--font-sans);font-size:1.3rem;font-weight:700;margin:0 0 4px}
    .brochure-modal-header p{font-size:.85rem;color:rgba(255,255,255,.7);margin:0}
    .brochure-modal-close{position:absolute;top:14px;right:14px;width:34px;height:34px;border-radius:50%;border:none;background:rgba(255,255,255,.1);color:#fff;font-size:1.2rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s}
    .brochure-modal-close:hover{background:rgba(255,255,255,.25)}
    .brochure-modal-body{padding:24px 28px 28px}
    .bm-field{margin-bottom:14px}
    .bm-field label{display:block;font-size:.75rem;font-weight:600;color:var(--gray-700);margin-bottom:5px;text-transform:uppercase;letter-spacing:.04em}
    .bm-field input{width:100%;padding:11px 14px;border:1.5px solid var(--gray-200);border-radius:8px;font-size:.9rem;font-family:var(--font-sans);color:var(--gray-900);transition:border-color .2s;box-sizing:border-box}
    .bm-field input:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(30,126,52,.1)}
    .bm-field input.bm-error{border-color:#dc2626}
    .bm-submit{width:100%;padding:13px;background:var(--primary);color:#fff;border:none;border-radius:10px;font-size:.95rem;font-weight:600;font-family:var(--font-sans);cursor:pointer;transition:background .2s;margin-top:4px;display:flex;align-items:center;justify-content:center;gap:8px}
    .bm-submit:hover{background:var(--primary-hover)}
    .bm-success{display:none;text-align:center;padding:36px 28px}
    .bm-success svg{width:56px;height:56px;color:var(--primary);margin-bottom:14px}
    .bm-success h3{font-family:var(--font-sans);font-size:1.2rem;color:var(--gray-900);margin:0 0 6px}
    .bm-success p{color:var(--gray-500);font-size:.9rem;margin:0 0 20px}
    .bm-success-btn{padding:10px 28px;background:var(--primary);color:#fff;border:none;border-radius:8px;font-size:.9rem;font-weight:600;cursor:pointer;transition:background .2s}
    .bm-success-btn:hover{background:var(--primary-hover)}
    @media(max-width:540px){.brochure-modal-header,.brochure-modal-body{padding:20px}.brochure-modal{margin:10px}}

    /* FLOOR PLAN BLUR OVERLAY */
    .fp-placeholder{position:relative;overflow:hidden;cursor:pointer}
    .fp-placeholder img{width:100%;height:100%;object-fit:cover;filter:blur(4px);transform:scale(1.05)}
    .fp-enquire-overlay{position:absolute;inset:0;background:rgba(0,0,0,.3);display:flex;flex-direction:column;align-items:center;justify-content:center;opacity:0;transition:opacity .3s}
    .fp-placeholder:hover .fp-enquire-overlay{opacity:1}
    .fp-enquire-btn{padding:14px 32px;background:var(--primary);color:#fff;font-size:.9rem;font-weight:700;border:none;border-radius:8px;cursor:pointer;display:flex;align-items:center;gap:8px;transition:background .2s,transform .2s;letter-spacing:.03em}
    .fp-enquire-btn:hover{background:var(--primary-hover);transform:scale(1.05)}
    .fp-lock-text{color:#fff;font-size:.78rem;margin-top:10px;font-weight:500;text-shadow:0 1px 4px rgba(0,0,0,.5)}

    /* FLOOR PLAN TABS */
    .fp-tabs{display:flex;gap:0;border-bottom:2px solid var(--gray-200);margin-bottom:24px}
    .fp-tab{padding:12px 24px;font-size:.85rem;font-weight:600;color:var(--gray-500);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;transition:color .2s,border-color .2s}
    .fp-tab.active{color:var(--primary);border-bottom-color:var(--primary)}
    .fp-tab:hover{color:var(--primary)}
    .fp-panel{display:none}
    .fp-panel.active{display:block}
    .fp-placeholder{width:100%;max-width:600px;aspect-ratio:4/3;background:var(--gray-100);display:flex;align-items:center;justify-content:center;color:var(--gray-400);font-size:.9rem;margin:0 auto}

    /* RERA */
    .rera-box{display:flex;align-items:center;gap:24px;padding:24px;border:1px solid var(--gray-200);background:var(--gray-50);flex-wrap:wrap}
    .rera-qr{width:120px;height:120px;background:var(--gray-200);display:flex;align-items:center;justify-content:center;color:var(--gray-400);font-size:.75rem;flex-shrink:0}
    .rera-info{display:flex;flex-direction:column;gap:6px}
    .rera-info p{font-size:.85rem;color:var(--gray-600)}
    .rera-info strong{color:var(--secondary)}
    .rera-info a{color:var(--primary);font-weight:600;font-size:.82rem}

    /* LOCATION */
    .loc-map{display:none}
    .loc-close-to{margin-bottom:20px}
    .loc-close-to p{font-size:.85rem;color:var(--gray-600);line-height:1.6}
    .loc-close-to strong{color:var(--secondary)}
    .nearby-grid{display:grid;grid-template-columns:1fr;gap:16px}
    @media(min-width:640px){.nearby-grid{grid-template-columns:1fr 1fr}}
    @media(min-width:900px){.nearby-grid{grid-template-columns:1fr 1fr 1fr}}
    .nearby-cat{background:var(--gray-50);padding:16px;border:1px solid var(--gray-200)}
    .nearby-cat h4{font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--primary);margin-bottom:10px;font-family:var(--font-sans)}
    .nearby-cat ul{padding-left:16px;list-style:disc}
    .nearby-cat li{font-size:.82rem;color:var(--gray-600);line-height:1.7}

    /* FAQ */
    .faq-item{border:1px solid var(--gray-200);margin-bottom:8px}
    .faq-q{display:flex;align-items:center;justify-content:space-between;padding:16px 20px!important;cursor:pointer;font-size:.9rem;font-weight:600;color:var(--secondary);transition:background .2s}
    .faq-q:hover{background:var(--gray-50)}
    .faq-q::after{display:none!important}
    .faq-arrow{transition:transform .25s;flex-shrink:0;color:var(--gray-400)}
    .faq-arrow.open{transform:rotate(180deg)}
    .faq-a{max-height:0!important;overflow:hidden!important;transition:max-height .35s ease;padding:0!important}
    .faq-a.open{max-height:300px!important}
    .faq-a-inner{padding:0 20px 16px;font-size:.85rem;color:var(--gray-600);line-height:1.7}

    /* SHARE */
    .share-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
    .share-btn{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid var(--gray-200);color:var(--gray-600);transition:all .2s;cursor:pointer}
    .share-btn:hover{border-color:var(--primary);color:var(--primary);background:#f0fdf4}

    /* REVIEWS */
    .review-form{max-width:520px;display:flex;flex-direction:column;gap:14px}
    .review-field{display:flex;flex-direction:column;gap:5px}
    .review-field label{font-size:.7rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:.07em}
    .review-field input,.review-field textarea{padding:10px 12px;border:1.5px solid var(--gray-200);font-size:.875rem;color:var(--gray-900);background:#fff;transition:border-color .2s}
    .review-field input:focus,.review-field textarea:focus{border-color:var(--primary)}
    .review-field textarea{resize:none;min-height:80px}
    .star-rating{display:flex;gap:4px}
    .star-rating span{font-size:1.4rem;cursor:pointer;color:var(--gray-300);transition:color .15s}
    .star-rating span.active,.star-rating span:hover{color:#f59e0b}
    .review-submit{padding:12px 28px;background:var(--primary);color:#fff;font-size:.85rem;font-weight:700;border:none;cursor:pointer;align-self:flex-start;transition:background .2s}
    .review-submit:hover{background:var(--primary-hover)}

    /* REPORT ERROR MODAL */
    .report-overlay{position:fixed;inset:0;z-index:800;background:rgba(13,32,22,.72);backdrop-filter:blur(5px);display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;pointer-events:none;transition:opacity .25s ease}
    .report-overlay.open{opacity:1;pointer-events:auto}
    .report-box{background:#fff;width:100%;max-width:440px;box-shadow:0 32px 80px rgba(0,0,0,.28);transform:translateY(18px) scale(.97);transition:transform .25s ease;overflow:hidden}
    .report-box.shown{transform:translateY(0) scale(1)}

    /* SIMILAR PROJECTS */
    .proj-grid{display:grid!important;grid-template-columns:repeat(2,1fr)!important;gap:12px!important}
    @media(min-width:1024px){.proj-grid{grid-template-columns:repeat(3,1fr)!important;gap:20px!important}}
    .proj-card{border:1px solid var(--gray-200);overflow:hidden;background:var(--white);transition:box-shadow .3s,transform .3s}
    .proj-card:hover{box-shadow:var(--shadow-lg);transform:translateY(-4px)}
    .proj-img-wrap{position:relative;overflow:hidden}
    .proj-img{width:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .4s}
    .proj-card:hover .proj-img{transform:scale(1.04)}
    .proj-badge-tl{position:absolute;top:12px;left:12px;padding:4px 10px;font-size:.68rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;z-index:2}
    .proj-badge--new{background:#dcfce7;color:#166534}
    .proj-badge--uc{background:#fef3c7;color:#92400e}
    .proj-body{padding:18px 20px 20px}
    .proj-developer{font-size:.72rem;color:var(--gray-500);margin-bottom:6px;font-weight:500}
    .proj-name-link{display:block}
    .proj-name{font-size:1.05rem;color:var(--secondary);margin-bottom:6px;transition:color .2s}
    .proj-name-link:hover .proj-name{color:var(--primary)}
    .proj-loc{display:flex;align-items:flex-start;gap:5px;font-size:.78rem;color:var(--gray-500);margin-bottom:12px;line-height:1.4}
    .proj-loc-icon{width:14px;height:14px;flex-shrink:0;margin-top:1px;color:var(--primary)}
    .proj-config-row{display:flex;flex-wrap:wrap;gap:0;margin-bottom:14px}
    .proj-config-chip{padding:0;border:none!important;font-size:.8rem;font-weight:600;color:var(--secondary);letter-spacing:.02em;border-radius:0;background:none}
    .proj-info-row{display:flex;gap:20px;margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid var(--gray-100);justify-content:flex-start!important;text-align:left!important}
    .proj-info-item{text-align:left!important;align-items:flex-start!important}
    .proj-info-item{display:flex;flex-direction:column;gap:2px}
    .proj-info-label{font-size:.68rem;font-weight:700;color:var(--gray-400);text-transform:uppercase;letter-spacing:.06em}
    .proj-info-val{font-size:.82rem;font-weight:600;color:var(--secondary)}
    .proj-info-val--price{color:var(--primary)}
    .proj-cta-row{display:flex;align-items:center;gap:8px}
    .proj-cta-btn{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:10px 14px;background:var(--primary);color:#fff;font-size:.8rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;border:none;cursor:pointer;transition:background .22s,transform .22s}
    .proj-cta-btn:hover{background:var(--primary-hover);transform:translateY(-1px)}
    .proj-cta-wa{width:42px;height:42px;display:flex;align-items:center;justify-content:center;border:1.5px solid #25D366;color:#25D366;flex-shrink:0;transition:all .2s}
    .proj-cta-wa:hover{background:#25D366;color:#fff}

    @media(max-width:639px){
      .proj-body{padding:10px 10px 12px!important}
      .proj-developer{font-size:.62rem!important;margin-bottom:4px!important}
      .proj-name{font-size:.82rem!important;margin-bottom:4px!important}
      .proj-loc{font-size:.65rem!important;margin-bottom:8px!important;gap:3px}
      .proj-loc-icon{width:11px;height:11px}
      .proj-config-chip{font-size:.65rem!important}
      .proj-config-row{margin-bottom:8px!important}
      .proj-info-row{gap:10px!important;margin-bottom:10px!important;padding-bottom:8px!important}
      .proj-info-label{font-size:.58rem!important}
      .proj-info-val{font-size:.7rem!important}
      .proj-cta-btn{padding:8px 8px!important;font-size:.65rem!important}
      .proj-cta-wa{width:34px!important;height:34px!important}
      .proj-badge-tl{top:8px;left:8px;padding:3px 7px;font-size:.58rem}
    }
          /* PROPERTY DEALS LINKS */
    .deals-grid{display:flex;flex-wrap:wrap;gap:8px}
    .deal-pill{display:inline-block;padding:7px 16px;border:1.5px solid var(--gray-200);font-size:.8rem;font-weight:500;color:var(--secondary);border-radius:99px;transition:all .2s;white-space:nowrap}
    .deal-pill:hover{border-color:var(--primary);background:var(--primary);color:#fff}

    /* FOOTER */
    .site-footer{background:var(--secondary);color:rgba(255,255,255,.75);padding:64px 0 0}
    .footer-grid{display:grid;grid-template-columns:1fr;gap:40px;margin-bottom:48px}
    @media(min-width:640px){.footer-grid{grid-template-columns:repeat(2,1fr)}}
    @media(min-width:1024px){.footer-grid{grid-template-columns:1.6fr 1fr 1fr 1fr}}
    .footer-logo{font-family:var(--font-serif);font-size:1.5rem;color:#fff;font-weight:600;margin-bottom:8px}
    .footer-tagline{font-size:.8rem;color:var(--primary-light);font-weight:600;letter-spacing:.08em;text-transform:uppercase;margin-bottom:12px}
    .footer-desc{font-size:.82rem;line-height:1.7;color:rgba(255,255,255,.55);margin-bottom:16px}
    .footer-contact{display:flex;flex-direction:column;gap:6px;font-size:.82rem}
    .footer-contact a{color:var(--primary-light);transition:color .2s}
    .footer-contact a:hover{color:#fff}
    .footer-col h4{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.4);margin-bottom:16px}
    .footer-col ul{display:flex;flex-direction:column;gap:8px}
    .footer-col a{font-size:.82rem;color:rgba(255,255,255,.6);transition:color .2s}
    .footer-col a:hover{color:var(--primary-light)}
    .footer-disclaimer{padding:24px 0;border-top:1px solid rgba(255,255,255,.08);font-size:.72rem;color:rgba(255,255,255,.35);line-height:1.7}
    .footer-disclaimer strong{color:rgba(255,255,255,.55)}
    .footer-bottom{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:16px 0;border-top:1px solid rgba(255,255,255,.08);font-size:.75rem;color:rgba(255,255,255,.35)}
    .footer-bottom strong{color:rgba(255,255,255,.55)}
    .footer-bottom-links{display:flex;gap:16px}
    .footer-bottom-links a{color:rgba(255,255,255,.35);transition:color .2s}
    .footer-bottom-links a:hover{color:var(--primary-light)}

    /* FLOATING WA */
    .float-wa{position:fixed;bottom:24px;right:24px;z-index:500;width:56px;height:56px;border-radius:50%;background:#25D366;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;border:none;box-shadow:0 4px 20px rgba(37,211,102,.4);opacity:0;transform:translateY(8px);transition:opacity .3s,transform .3s,box-shadow .2s;text-decoration:none}
    .float-wa.visible{opacity:1;transform:translateY(0)}
    .float-wa:hover{box-shadow:0 6px 28px rgba(37,211,102,.55)}

    /* ENQUIRY MODAL */
    .enq-overlay{position:fixed;inset:0;z-index:800;background:rgba(13,32,22,.72);backdrop-filter:blur(5px);display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;pointer-events:none;transition:opacity .25s ease}
    .enq-overlay.open{opacity:1;pointer-events:auto}
    .enq-box{background:#fff;width:100%;max-width:480px;box-shadow:0 32px 80px rgba(0,0,0,.28);transform:translateY(18px) scale(.97);transition:transform .25s ease;overflow:hidden}
    .enq-box.shown{transform:translateY(0) scale(1)}
    .enq-hd{background:var(--secondary);padding:24px 28px 20px;position:relative}
    .enq-hd h2{font-family:var(--font-serif);font-size:1.25rem;font-weight:600;color:#fff;margin-bottom:4px}
    .enq-hd-proj{font-size:.75rem;color:var(--primary-light);font-weight:600;letter-spacing:.02em}
    .enq-close{position:absolute;top:16px;right:16px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.12);border:none;cursor:pointer;color:#fff;transition:background .2s}
    .enq-close:hover{background:rgba(255,255,255,.22)}
    .enq-body{padding:24px 28px 28px;display:flex;flex-direction:column;gap:14px}
    .enq-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .enq-field{display:flex;flex-direction:column;gap:5px}
    .enq-field label{font-size:.7rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:.07em}
    .enq-field input,.enq-field select,.enq-field textarea{padding:10px 12px;border:1.5px solid var(--gray-200);font-size:.875rem;color:var(--gray-900);background:#fff;transition:border-color .2s;-webkit-appearance:none;appearance:none}
    .enq-field input:focus,.enq-field select:focus,.enq-field textarea:focus{outline:none;border-color:var(--primary)}
    .enq-field textarea{resize:none;min-height:72px}
    .enq-submit{width:100%;padding:13px 16px;background:var(--primary);color:#fff;font-size:.875rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;border:none;cursor:pointer;transition:background .22s,transform .22s;display:flex;align-items:center;justify-content:center;gap:8px;margin-top:4px}
    .enq-submit:hover{background:var(--primary-hover);transform:translateY(-1px)}
    .enq-note{font-size:.7rem;color:var(--gray-400);text-align:center;margin-top:8px}
    .enq-success{display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:40px 28px;text-align:center}
    .enq-success.show{display:flex}
    .enq-success-icon{width:56px;height:56px;background:#dcfce7;border-radius:50%;display:flex;align-items:center;justify-content:center}
    .enq-success h3{font-family:var(--font-serif);font-size:1.3rem;color:var(--secondary)}
    .enq-success p{font-size:.85rem;color:var(--gray-500);line-height:1.6}

    /* CITIES MODAL */
    .cities-modal-overlay{position:fixed;inset:0;z-index:900;background:rgba(13,32,22,.75);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;pointer-events:none;transition:opacity .26s ease}
    .cities-modal-overlay.open{opacity:1;pointer-events:auto}
    .cities-modal-box{background:#fff;width:100%;max-width:860px;max-height:88vh;display:flex;flex-direction:column;box-shadow:0 32px 100px rgba(0,0,0,.3);transform:translateY(20px) scale(.97);transition:transform .26s ease;overflow:hidden}
    .cities-modal-box.shown{transform:translateY(0) scale(1)}
    .cities-modal-hd{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:28px 32px 24px;background:var(--secondary);flex-shrink:0}
    .cities-modal-hd h2{font-family:var(--font-serif);font-size:clamp(1.2rem,2.5vw,1.6rem);font-weight:600;color:#fff;margin-bottom:4px}
    .cities-modal-hd p{font-size:.8rem;color:rgba(255,255,255,.6)}
    .cities-modal-close{flex-shrink:0;width:38px;height:38px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.12);border:none;cursor:pointer;color:#fff;transition:background .2s}
    .cities-modal-close:hover{background:rgba(255,255,255,.22)}
    .cities-modal-body{overflow-y:auto;padding:28px 32px 32px;display:flex;flex-direction:column;gap:28px}
    .cities-region-title{font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gray-400);margin-bottom:12px}
    .cities-list{display:flex;flex-wrap:wrap;gap:8px}
    .city-pill{display:inline-block;padding:7px 16px;border:1.5px solid var(--gray-200);font-size:.82rem;font-weight:500;color:var(--secondary);border-radius:99px;transition:all .2s;white-space:nowrap}
    .city-pill:hover{border-color:var(--primary);background:var(--primary);color:#fff;transform:translateY(-1px)}
  </style>

