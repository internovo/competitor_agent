 <script id="google_gtagjs-js" type="litespeed/javascript" data-src="https://www.googletagmanager.com/gtag/js?id=GT-MRLWH8B"></script> <script id="google_gtagjs-js-after" type="litespeed/javascript">window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}
gtag("set","linker",{"domains":["www.sarthakestates.com"]});gtag("js",new Date());gtag("set","developer_id.dZTNiMT",!0);gtag("config","GT-MRLWH8B",{"googlesitekit_post_type":"post"});window._googlesitekit=window._googlesitekit||{};window._googlesitekit.throttledEvents=[];window._googlesitekit.gtagEvent=(name,data)=>{var key=JSON.stringify({name,data});if(!!window._googlesitekit.throttledEvents[key]){return}window._googlesitekit.throttledEvents[key]=!0;setTimeout(()=>{delete window._googlesitekit.throttledEvents[key]},5);gtag("event",name,{...data,event_source:"site-kit"})}</script> <link rel="https://api.w.org/" href="https://www.sarthakestates.com/wp-json/" /><link rel="alternate" title="JSON" type="application/json" href="https://www.sarthakestates.com/wp-json/wp/v2/posts/18760" /><link rel="EditURI" type="application/rsd+xml" title="RSD" href="https://www.sarthakestates.com/xmlrpc.php?rsd" /><meta name="generator" content="WordPress 7.1" /><link rel='shortlink' href='https://www.sarthakestates.com/?p=18760' /><meta name="generator" content="Site Kit by Google 1.187.0" /><style id="sarthak-leads-css">/* ── STICKY TOP BAR ───────────────────────────────────────── */
#sl-topbar{position:fixed;top:0;left:0;width:100%;z-index:99999;background:#1a1a1a;color:#fff;text-align:center;padding:9px 16px;font-size:14px;font-family:Arial,sans-serif;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;box-shadow:0 2px 8px rgba(0,0,0,.4)}
#sl-topbar a{color:#f5c518;font-weight:700;text-decoration:none;white-space:nowrap;border:1.5px solid #f5c518;padding:4px 14px;border-radius:20px;font-size:13px;transition:background .2s}
#sl-topbar a:hover{background:#f5c518;color:#000}
#sl-topbar-close{position:absolute;right:12px;top:50%;transform:translateY(-50%);cursor:pointer;font-size:16px;line-height:1;color:#fff;background:rgba(255,255,255,0.15);border:1.5px solid rgba(255,255,255,0.4);border-radius:50%;width:26px;height:26px;display:flex;align-items:center;justify-content:center;padding:0;flex-shrink:0;transition:background .2s,color .2s;z-index:10}
#sl-topbar-close:hover{background:#fff;color:#1a1a1a}
#sl-topbar.sl-hidden{display:none!important}
body.sl-topbar-closed{margin-top:0!important}
body{margin-top:44px !important}

/* ── FLOATING WHATSAPP + CALL BUTTONS ─────────────────────── */
#sl-float{position:fixed;bottom:24px;right:20px;z-index:99998;display:flex;flex-direction:column;gap:10px;align-items:flex-end}
.sl-fab{display:flex;align-items:center;gap:8px;padding:12px 18px;border-radius:50px;text-decoration:none;font-weight:700;font-size:14px;font-family:Arial,sans-serif;box-shadow:0 4px 16px rgba(0,0,0,.28);transition:transform .2s,box-shadow .2s;white-space:nowrap}
.sl-fab:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.35)}
.sl-fab-wa{background:#25D366;color:#fff}
.sl-fab-call{background:#B8860B;color:#fff}
.sl-fab svg{flex-shrink:0}
.sl-fab-label{display:inline}
@media(max-width:480px){.sl-fab-label{display:none}.sl-fab{padding:14px}}

/* ── EXIT INTENT POPUP ────────────────────────────────────── */
#sl-popup-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:999999;align-items:center;justify-content:center}
#sl-popup-overlay.active{display:flex}
#sl-popup{background:#fff;border-radius:12px;max-width:480px;width:92%;padding:32px 28px;position:relative;font-family:Arial,sans-serif;box-shadow:0 8px 40px rgba(0,0,0,.3)}
#sl-popup-close{position:absolute;top:12px;right:16px;font-size:22px;cursor:pointer;color:#999;background:none;border:none;line-height:1}
#sl-popup h2{margin:0 0 6px;font-size:22px;color:#1a1a1a}
#sl-popup p{margin:0 0 18px;color:#555;font-size:14px;line-height:1.6}
#sl-popup-form input{width:100%;padding:11px 14px;border:1.5px solid #ddd;border-radius:6px;font-size:14px;margin-bottom:10px;box-sizing:border-box;outline:none;transition:border-color .2s}
#sl-popup-form input:focus{border-color:#B8860B}
#sl-popup-form button{width:100%;padding:13px;background:#B8860B;color:#fff;border:none;border-radius:6px;font-size:16px;font-weight:700;cursor:pointer;transition:background .2s}
#sl-popup-form button:hover{background:#a07508}
.sl-popup-or{text-align:center;color:#888;font-size:13px;margin:12px 0}
.sl-popup-actions{display:flex;gap:10px}
.sl-popup-actions a{flex:1;text-align:center;padding:11px;border-radius:6px;font-weight:700;font-size:14px;text-decoration:none}
.sl-popup-wa{background:#25D366;color:#fff}
.sl-popup-call{background:#1a1a1a;color:#fff}

/* ── INLINE CTA BOX (injected into posts/pages) ──────────── */
.sl-cta-box{background:#1a1a1a;color:#fff;padding:24px 26px;border-radius:8px;margin:32px 0;border-left:5px solid #B8860B;font-family:Arial,sans-serif}
.sl-cta-box h3{color:#f5c518;margin:0 0 8px;font-size:18px}
.sl-cta-box p{margin:0 0 16px;font-size:14px;color:#ccc;line-height:1.6}
.sl-cta-actions{display:flex;gap:10px;flex-wrap:wrap}
.sl-cta-actions a{padding:11px 20px;border-radius:5px;font-weight:700;font-size:14px;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
.sl-cta-call{background:#B8860B;color:#fff}
.sl-cta-wa{background:#25D366;color:#fff}
.sl-cta-actions a:hover{opacity:.88}

/* ── TRUST BADGE STRIP ───────────────────────────────────── */
.sl-trust{display:flex;flex-wrap:wrap;gap:10px;margin:24px 0;font-family:Arial,sans-serif}
.sl-trust-item{display:flex;align-items:center;gap:6px;background:#f9f6ee;border:1px solid #e8d98a;border-radius:20px;padding:6px 14px;font-size:13px;color:#5a4a00;font-weight:600}

/* ── LEAD FORM (shortcode) ───────────────────────────────── */
.sl-form-wrap{background:#f9f9f9;border:1px solid #e0e0e0;border-radius:10px;padding:28px;font-family:Arial,sans-serif;margin:28px 0}
.sl-form-wrap h3{margin:0 0 6px;font-size:20px;color:#1a1a1a}
.sl-form-wrap p{margin:0 0 18px;color:#666;font-size:13px}
.sl-form-wrap input,.sl-form-wrap select,.sl-form-wrap textarea{width:100%;padding:11px 14px;border:1.5px solid #ddd;border-radius:6px;font-size:14px;margin-bottom:12px;box-sizing:border-box;outline:none;font-family:Arial,sans-serif}
.sl-form-wrap input:focus,.sl-form-wrap select:focus{border-color:#B8860B}
.sl-form-wrap button{background:#B8860B;color:#fff;border:none;padding:13px 28px;border-radius:6px;font-size:16px;font-weight:700;cursor:pointer;width:100%}
.sl-form-wrap button:hover{background:#a07508}
.sl-form-success{display:none;background:#e6f9ee;border:1px solid #25D366;border-radius:6px;padding:14px;color:#1a6e38;font-size:14px;text-align:center;margin-top:10px}

/* ── MOBILE BOTTOM BAR ───────────────────────────────────── */
#sl-mobile-bar{display:none;position:fixed;bottom:0;left:0;width:100%;z-index:99997;background:#1a1a1a;border-top:2px solid #B8860B}
#sl-mobile-bar a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;flex:1;padding:10px 0;text-decoration:none;font-size:11px;font-weight:700;font-family:Arial,sans-serif}
#sl-mobile-bar a span{font-size:10px}
.sl-mb-call{color:#f5c518}
.sl-mb-wa{color:#25D366}
.sl-mb-mail{color:#aaa}
#sl-mobile-bar{display:flex}
