<header class="dh-header dh-header--static dh-header--home-solid" id="dh-header" role="banner" data-header-behavior="static" data-dh-runtime="1.4.27-b37.07-admin-layout-lead-action-closure">
  <div class="dh-container dh-header__inner">

    <!-- Logo -->
    <a href="https://divyahousingagency.com/" class="dh-header__logo" aria-label="Divya Housing Agency — Home">
      <img src="https://divyahousingagency.com/wp-content/themes/divya-housing-premium/assets/images/logo.webp"
           alt="Divya Housing Agency — Property Consultants Malad West Mumbai"
           width="220" height="39" loading="eager" fetchpriority="high">
    </a>

    <!-- Desktop Nav -->
    <nav class="dh-nav" role="navigation" aria-label="Primary Navigation">
      <ul class="dh-nav__list">
