<style id="divya-lead-bridge-frontend-css">.dlb-overlay{position:fixed;inset:0;z-index:2147482500;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(15,23,42,.56);box-sizing:border-box}.dlb-overlay.is-open{display:flex}.dlb-modal{width:min(420px,100%);max-height:min(720px,calc(100vh - 36px));overflow:auto;background:#fff!important;color:#1f2937!important;border:1px solid #d7dce3;border-radius:14px;box-shadow:0 24px 70px rgba(15,23,42,.26);font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.dlb-modal__head{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:16px 18px;border-bottom:1px solid #d7dce3;background:#e9edf2!important;color:#172033!important}.dlb-modal__title{margin:0;font-size:18px;line-height:1.25;font-weight:750;color:inherit!important}.dlb-modal__close{appearance:none;border:0;background:transparent!important;color:inherit!important;width:34px;height:34px;border-radius:999px;font-size:24px;line-height:1;cursor:pointer}.dlb-modal__body{padding:18px;background:#fff!important;color:#1f2937!important}.dlb-modal__intro{margin:0 0 14px;color:#64748b!important;font-size:13px;line-height:1.5}.dlb-field{margin:0 0 12px}#dlb-lead-overlay.dlb-overlay .dlb-modal .dlb-modal__body .dlb-field>label{display:block;margin:0 0 5px;font-size:12px;line-height:1.3;font-weight:700;color:#111827!important;-webkit-text-fill-color:#111827!important;opacity:1!important}.dlb-overlay .dlb-modal .dlb-field input,.dlb-overlay .dlb-modal .dlb-field textarea{display:block;width:100%;box-sizing:border-box;border:1px solid #cbd5e1!important;border-radius:9px;background:#fff!important;color:#0f172a!important;-webkit-text-fill-color:#0f172a!important;caret-color:#0f172a!important;opacity:1!important;padding:10px 12px;font:500 15px/1.4 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important;outline:0!important;box-shadow:none}.dlb-overlay .dlb-modal .dlb-field input::placeholder,.dlb-overlay .dlb-modal .dlb-field textarea::placeholder{color:#64748b!important;-webkit-text-fill-color:#64748b!important;opacity:1!important}.dlb-field textarea{min-height:88px;resize:vertical}.dlb-overlay .dlb-modal .dlb-field input:focus,.dlb-overlay .dlb-modal .dlb-field textarea:focus{border-color:#64748b!important;box-shadow:0 0 0 3px rgba(100,116,139,.14)!important}.dlb-hp{position:absolute!important;left:-10000px!important;top:auto!important;width:1px!important;height:1px!important;overflow:hidden!important}.dlb-submit{display:flex;width:100%;min-height:44px;align-items:center;justify-content:center;gap:8px;border:0;border-radius:9px;background:#334155!important;color:#fff!important;-webkit-text-fill-color:#fff!important;padding:10px 16px;font-size:14px;font-weight:750;cursor:pointer}.dlb-submit:disabled{opacity:.62;cursor:wait}.dlb-form-status{min-height:18px;margin:9px 0 0;font-size:12px;line-height:1.45;color:#64748b!important}.dlb-form-status.is-error{color:#b42318!important}.dlb-form-status.is-success{color:#18864b!important}.dlb-theme-divya .dlb-modal{font-family:var(--font-primary,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif)}.dlb-theme-divya .dlb-modal__title{font-family:var(--font-heading,var(--font-primary,system-ui,sans-serif))}.dlb-theme-divya .dlb-modal .dlb-field label,.dlb-theme-divya .dlb-modal .dlb-field input,.dlb-theme-divya .dlb-modal .dlb-field textarea,.dlb-theme-divya .dlb-submit{font-family:var(--font-primary,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif)!important}.dlb-theme-divya .dlb-modal__head{background:var(--dh-primary,#8B1A1A)!important;color:var(--dh-primary-contrast,#fff)!important;border-bottom-color:color-mix(in srgb,var(--dh-primary,#8B1A1A) 75%,#000)!important}.dlb-theme-divya .dlb-submit{background:var(--dh-whatsapp,#C9A84C)!important;border-color:var(--dh-whatsapp,#C9A84C)!important;color:#111827!important;-webkit-text-fill-color:#111827!important}.dlb-theme-divya .dlb-submit:hover,.dlb-theme-divya .dlb-submit:focus-visible{background:var(--dh-wa-hover-bg,#B8922E)!important;border-color:var(--dh-wa-hover-bg,#B8922E)!important;color:#111827!important;-webkit-text-fill-color:#111827!important}.dlb-theme-divya .dlb-modal .dlb-field input:focus,.dlb-theme-divya .dlb-modal .dlb-field textarea:focus{border-color:var(--dh-primary,#8B1A1A)!important;box-shadow:0 0 0 3px rgba(var(--dh-primary-rgb,139,26,26),.14)!important}.dlb-floating[data-dlb-generated-actions]{position:fixed!important;right:0!important;top:50%!important;z-index:2147481500!important;display:flex!important;flex-direction:column!important;gap:4px!important;transform:translateY(-50%)!important;width:auto!important;margin:0!important;padding:0!important;background:transparent!important;border:0!important;box-shadow:none!important}.dlb-floating[data-dlb-generated-actions] .dlb-float-action{appearance:none!important;display:flex!important;align-items:center!important;justify-content:center!important;width:48px!important;min-width:48px!important;max-width:48px!important;height:46px!important;min-height:46px!important;max-height:46px!important;margin:0!important;padding:0!important;border:1px solid #d7dce3!important;border-radius:10px 0 0 10px!important;background:#f8fafc!important;color:#334155!important;box-shadow:0 5px 16px rgba(15,23,42,.14)!important;font:inherit!important;line-height:1!important;text-decoration:none!important;text-indent:0!important;cursor:pointer!important;overflow:hidden!important;opacity:1!important;visibility:visible!important}.dlb-floating[data-dlb-generated-actions] .dlb-float-action:hover,.dlb-floating[data-dlb-generated-actions] .dlb-float-action:focus-visible{background:#e9edf2!important;color:#0f172a!important;border-color:#cbd5e1!important}.dlb-floating[data-dlb-generated-actions] .dlb-float-action--whatsapp{background:#25D366!important;color:#fff!important;border-color:#25D366!important}.dlb-floating[data-dlb-generated-actions] .dlb-float-action--whatsapp:hover,.dlb-floating[data-dlb-generated-actions] .dlb-float-action--whatsapp:focus-visible{background:#1ebe5d!important;color:#fff!important;border-color:#1ebe5d!important}.dlb-floating[data-dlb-generated-actions] .dlb-float-action--enquiry{background:#eef1f5!important;color:#1f2937!important;border-color:#d7dce3!important}.dlb-floating[data-dlb-generated-actions] .dlb-float-action svg,.dlb-mobile-bar[data-dlb-generated-actions] .dlb-mobile-action svg{display:block!important;width:21px!important;height:21px!important;min-width:21px!important;max-width:21px!important;fill:currentColor!important;stroke:none!important;flex:0 0 auto!important;margin:0!important;padding:0!important}.dlb-mobile-bar[data-dlb-generated-actions]{display:none!important}
@media(max-width:767px){.dlb-floating[data-dlb-generated-actions]{display:none!important}.dlb-mobile-bar[data-dlb-generated-actions]{position:fixed!important;left:12px!important;right:12px!important;bottom:calc(10px + env(safe-area-inset-bottom,0px))!important;z-index:2147481500!important;display:grid!important;grid-template-columns:repeat(var(--dlb-action-count,3),minmax(0,1fr))!important;gap:0!important;min-height:58px!important;margin:0 auto!important;padding:0!important;border:1px solid #d7dce3!important;border-radius:18px!important;background:#fff!important;box-shadow:0 9px 28px rgba(15,23,42,.20)!important;overflow:hidden!important;max-width:520px!important;backdrop-filter:none!important}.dlb-mobile-bar[data-dlb-generated-actions] .dlb-mobile-action{appearance:none!important;display:flex!important;min-width:0!important;min-height:58px!important;height:58px!important;align-items:center!important;justify-content:center!important;flex-direction:row!important;gap:0!important;margin:0!important;padding:0!important;border:0!important;border-right:1px solid #e5e7eb!important;border-radius:0!important;background:#fff!important;color:#334155!important;box-shadow:none!important;font:inherit!important;line-height:1!important;text-decoration:none!important;text-indent:0!important;cursor:pointer!important;opacity:1!important;visibility:visible!important}.dlb-mobile-bar[data-dlb-generated-actions] .dlb-mobile-action:last-child{border-right:0!important}.dlb-mobile-bar[data-dlb-generated-actions] .dlb-mobile-action:hover,.dlb-mobile-bar[data-dlb-generated-actions] .dlb-mobile-action:focus-visible{background:#f1f5f9!important;color:#0f172a!important}.dlb-mobile-bar[data-dlb-generated-actions] .dlb-mobile-action--whatsapp{background:#25D366!important;color:#fff!important}.dlb-mobile-bar[data-dlb-generated-actions] .dlb-mobile-action--whatsapp:hover,.dlb-mobile-bar[data-dlb-generated-actions] .dlb-mobile-action--whatsapp:focus-visible{background:#1ebe5d!important;color:#fff!important}.dlb-mobile-bar[data-dlb-generated-actions] .dlb-mobile-action--enquiry{background:#f8fafc!important;color:#1f2937!important}.dlb-mobile-bar[data-dlb-generated-actions] .dlb-mobile-action svg{width:22px!important;height:22px!important;min-width:22px!important;max-width:22px!important}.dlb-modal{max-height:calc(100svh - 24px)}.dlb-overlay{padding:12px;align-items:flex-end}.dlb-modal{border-radius:18px 18px 12px 12px}}</style><div class="dlb-overlay dlb-theme-divya" id="dlb-lead-overlay" aria-hidden="true"><div class="dlb-modal" role="dialog" aria-modal="true" aria-labelledby="dlb-modal-title"><div class="dlb-modal__head"><h2 class="dlb-modal__title" id="dlb-modal-title">WhatsApp Enquiry</h2><button type="button" class="dlb-modal__close" data-dlb-close aria-label="Close">&times;</button></div><div class="dlb-modal__body"><p class="dlb-modal__intro" id="dlb-modal-intro">Share your details and continue to WhatsApp.</p><form id="dlb-lead-form" novalidate><input class="dlb-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"><div class="dlb-field"><label class="dlb-field__label" for="dlb-name">Name</label><input id="dlb-name" name="name" autocomplete="name" placeholder="Your name" required></div><div class="dlb-field"><label class="dlb-field__label" for="dlb-mobile">Mobile number</label><input id="dlb-mobile" name="mobile" inputmode="tel" autocomplete="tel" placeholder="Mobile number" required></div><div class="dlb-field"><label class="dlb-field__label" for="dlb-message">Message</label><textarea id="dlb-message" name="message" placeholder="Message"></textarea></div><button type="submit" class="dlb-submit" id="dlb-submit">Continue to WhatsApp</button><div class="dlb-form-status" id="dlb-status" aria-live="polite"></div></form></div></div></div><script id="divya-lead-bridge-frontend-js">window.DivyaLeadBridgeFrontend={"ajaxUrl":"https:\/\/divyahousingagency.com\/wp-admin\/admin-ajax.php","nonce":"20d8232301","phone":"919892340129","isDivi":false,"isDivya":true,"captureWhatsApp":true,"floating":false,"rewriteDivi":false,"showCall":true,"showWhatsApp":true,"showEnquiry":true,"blogId":1,"siteHost":"divyahousingagency.com"};(function(){
'use strict';
const cfg=window.DivyaLeadBridgeFrontend||{};
const overlay=document.getElementById('dlb-lead-overlay');
const form=document.getElementById('dlb-lead-form');
if(!overlay||!form)return;
const title=document.getElementById('dlb-modal-title');
const intro=document.getElementById('dlb-modal-intro');
const submit=document.getElementById('dlb-submit');
const status=document.getElementById('dlb-status');
const message=document.getElementById('dlb-message');
let mode='whatsapp',targetHref='',opener=null;
const targetPhone=String(cfg.phone||'').replace(/\D+/g,'');
const SESSION_IDENTITY_KEY='dlb_lead_identity_v1';
const readSessionIdentity=()=>{
  try{
    const raw=sessionStorage.getItem(SESSION_IDENTITY_KEY);
    if(!raw)return null;
    const data=JSON.parse(raw);
    const name=String(data&&data.name||'').trim();
    const mobile=String(data&&data.mobile||'').replace(/\D+/g,'');
    if(!name||mobile.length<10)return null;
    return {name:name,mobile:mobile};
  }catch(e){return null;}
};
const saveSessionIdentity=(name,mobile)=>{
  try{
    const cleanName=String(name||'').trim();
    const cleanMobile=String(mobile||'').replace(/\D+/g,'');
    if(cleanName&&cleanMobile.length>=10)sessionStorage.setItem(SESSION_IDENTITY_KEY,JSON.stringify({name:cleanName,mobile:cleanMobile}));
  }catch(e){}
};
const WA_ELEMENT_SELECTOR=[
  'a[href*="wa.me"]',
  'a[href*="whatsapp.com"]',
  'a[href^="whatsapp:"]',
  '[data-dlb-whatsapp]',
  '[data-whatsapp-url]',
  '[data-whatsapp]',
  '[data-href*="wa.me"]',
  '[data-href*="whatsapp.com"]',
  '[data-url*="wa.me"]',
  '[data-url*="whatsapp.com"]',
  '[onclick*="wa.me"]',
  '[onclick*="whatsapp.com"]'
].join(',');
const track=(event,extra)=>{
  const data=Object.assign({event:event,lead_bridge:true,site_host:cfg.siteHost||'',blog_id:cfg.blogId||0},extra||{});
  if(Array.isArray(window.dataLayer))window.dataLayer.push(data);
  if(typeof window.gtag==='function')window.gtag('event',event,Object.assign({site_host:cfg.siteHost||'',blog_id:cfg.blogId||0},extra||{}));
};
const uuid=()=>{
  if(window.crypto&&crypto.randomUUID)return crypto.randomUUID();
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.random()*16|0,v=c==='x'?r:(r&3|8);return v.toString(16);});
};
const cleanMessage=t=>String(t||'').replace(/\s+/g,' ').trim();
const isWhatsAppUrl=href=>/^(?:whatsapp:|https?:\/\/[^/]*(?:wa\.me|whatsapp\.com)(?:\/|$))/i.test(String(href||'').trim());
const normalizeAttrUrl=value=>String(value||'').replace(/&amp;/g,'&').trim();
const phoneFromHref=(href)=>{
  try{
    const u=new URL(href,location.href);
    if(/wa\.me$/i.test(u.hostname))return (u.pathname.match(/(\d{10,15})/)||[])[1]||'';
    if(/whatsapp\.com$/i.test(u.hostname))return (u.searchParams.get('phone')||'').replace(/\D+/g,'');
    if(/^whatsapp:/i.test(href))return (u.searchParams.get('phone')||'').replace(/\D+/g,'');
  }catch(e){}
  return '';
};
const msgFromHref=(href)=>{
  try{const u=new URL(href,location.href);return u.searchParams.get('text')||'';}catch(e){return '';}
};
const whatsappHrefFromElement=el=>{
  if(!el)return '';
  const candidates=[];
  if(el.href)candidates.push(el.href);
  ['href','data-href','data-url','data-whatsapp-url','data-whatsapp'].forEach(name=>{
    const v=el.getAttribute&&el.getAttribute(name);
    if(v)candidates.push(v);
  });
  const onclick=el.getAttribute&&el.getAttribute('onclick');
  if(onclick){
    const m=onclick.match(/(?:https?:\/\/(?:wa\.me|(?:[^/]+\.)?whatsapp\.com)[^'"\s)]*|whatsapp:[^'"\s)]*)/i);
    if(m)candidates.push(m[0].replace(/\\\//g,'/'));
  }
  for(const raw of candidates){
    const href=normalizeAttrUrl(raw);
    if(isWhatsAppUrl(href))return href;
  }
  return '';
};
const whatsappTriggerFromEvent=e=>{
  const nodes=[];
  if(e&&typeof e.composedPath==='function'){
    try{e.composedPath().forEach(node=>{if(node&&node.nodeType===1)nodes.push(node);});}catch(err){}
  }
  if(e&&e.target&&e.target.nodeType===1)nodes.push(e.target);
  const seen=new Set();
  for(const node of nodes){
    if(seen.has(node))continue;
    seen.add(node);
    let el=null;
    try{
      if(node.matches&&node.matches(WA_ELEMENT_SELECTOR))el=node;
      else if(node.closest)el=node.closest(WA_ELEMENT_SELECTOR);
    }catch(err){el=null;}
    if(!el||seen.has(el)&&el!==node)continue;
    if(el.hasAttribute&&el.hasAttribute('data-dlb-no-capture'))return null;
    const href=whatsappHrefFromElement(el);
    if(href||targetPhone)return {el:el,href:href};
  }
  return null;
};
const isGenericMessage=t=>{
  const v=cleanMessage(t).toLowerCase();
  return !v||v==='hi divya housing, i would like to enquire about a property.'||v==='hi divya housing, i would like to enquire about a property'||v==='hi, i would like to enquire about a property.'||v==='hi, i would like to enquire about a property'||v==='i would like to enquire about a property.'||v==='i would like to enquire about a property';
};
const pageSpecificMessage=(clicked,trigger)=>{
  const direct=cleanMessage(clicked);
  if(direct&&!isGenericMessage(direct))return direct;
  const singleDivya=!!cfg.isDivya&&/^\/(?:project|property)\//i.test(location.pathname);
  const shouldSearch=singleDivya||!!cfg.isDivi;
  if(!shouldSearch)return direct;
  let best='',bestScore=-1;
  document.querySelectorAll(WA_ELEMENT_SELECTOR).forEach(a=>{
    if(a===trigger)return;
    const href=whatsappHrefFromElement(a);
    const candidate=cleanMessage(msgFromHref(href));
    if(!candidate||isGenericMessage(candidate))return;
    let score=candidate.length;
    const pageTitle=document.title.split(/[|–—]/)[0].trim().toLowerCase();
    if(pageTitle&&candidate.toLowerCase().includes(pageTitle))score+=300;
    if(candidate.includes(location.href)||candidate.includes(location.origin+location.pathname))score+=240;
    if(/\b(?:bhk|sqft|price|project|property|availability|site visit|rent|sale|resale)\b/i.test(candidate))score+=80;
    if(score>bestScore){best=candidate;bestScore=score;}
  });
  return best||direct;
};
const whatsappHref=(phone,text)=>'https://wa.me/'+String(phone||targetPhone).replace(/\D+/g,'')+(text?'?text='+encodeURIComponent(text):'');
const resolvedMessageFor=(href,trigger)=>{
  const clicked=msgFromHref(href);
  return pageSpecificMessage(clicked,trigger)||('Hi, I am interested in '+document.title.replace(/\s*[|–—-].*$/,'').trim()+'. Please share details.');
};
const contextFromTrigger=trigger=>{
  if(!trigger||!trigger.closest)return {};
  let owner=null;
  try{owner=trigger.closest('[data-dh-project-id],[data-dh-property-id],.dh-prop-card');}catch(e){owner=null;}
  if(!owner)return {};
  const attr=name=>String(owner.getAttribute&&owner.getAttribute(name)||'').trim();
  return {
    project_name:attr('data-dh-project-name')||attr('data-dh-property-name'),
    project_id:attr('data-dh-project-id'),
    property_id:attr('data-dh-property-id'),
    location:attr('data-dh-area'),
    sub_location:attr('data-dh-sublocation')
  };
};
const capturePayload=(type,name,mobile,msg,submission,context)=>{
  const values={action:'divya_lead_bridge_frontend_capture',nonce:String(cfg.nonce||''),capture_type:type,name:String(name||''),mobile:String(mobile||''),message:String(msg||''),page_url:location.href,submission_uuid:submission||uuid(),website:''};
  Object.entries(context||{}).forEach(([key,value])=>{if(String(value||'').trim()!=='')values[key]=String(value);});
  return new URLSearchParams(values);
};
const postCapture=(payload,keepalive=false)=>fetch(cfg.ajaxUrl,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:payload.toString(),credentials:'same-origin',keepalive:!!keepalive});
const looksPhoneText=t=>/[6-9][\d\s+()-]{8,}/.test(t||'');
const rewriteVisiblePhone=a=>{
  const walker=document.createTreeWalker(a,NodeFilter.SHOW_TEXT);
  const nodes=[];
  while(walker.nextNode())nodes.push(walker.currentNode);
  nodes.forEach(n=>{if(looksPhoneText(n.nodeValue))n.nodeValue=n.nodeValue.replace(/(?:\+?91[\s-]?)?[6-9](?:[\s()\-]*\d){9}/g,targetPhone.slice(-10));});
};
const rewriteDivi=()=>{
  if(!cfg.rewriteDivi||!targetPhone)return;
  document.querySelectorAll('a[href^="tel:"]').forEach(a=>{a.href='tel:+'+targetPhone;rewriteVisiblePhone(a);});
  document.querySelectorAll(WA_ELEMENT_SELECTOR).forEach(a=>{
    const href=whatsappHrefFromElement(a);
    if(!href)return;
    const text=msgFromHref(href);
    if(a.tagName==='A')a.href=whatsappHref(targetPhone,text);
    ['data-href','data-url','data-whatsapp-url','data-whatsapp'].forEach(name=>{if(a.hasAttribute(name)&&isWhatsAppUrl(a.getAttribute(name)))a.setAttribute(name,whatsappHref(targetPhone,text));});
  });
};
const openModal=(kind,href,prefill,trigger)=>{
  mode=kind;targetHref=href||'';opener=trigger||document.activeElement;overlay.dataset.mode=kind;status.textContent='';status.className='dlb-form-status';
  if(kind==='whatsapp'){
    title.textContent='WhatsApp Enquiry';
    intro.textContent='Share your details. We will record your enquiry and then open WhatsApp.';
    submit.textContent='Continue to WhatsApp';
    const resolved=pageSpecificMessage(prefill,trigger);
    message.value=resolved||('Hi, I am interested in '+document.title.replace(/\s*[|–—-].*$/,'').trim()+'. Please share details.');
    track('whatsapp_form_open',{message_source:resolved?(cleanMessage(prefill)===resolved?'clicked_link':'page_context'):'fallback'});
  }else{
    title.textContent='Send an Enquiry';intro.textContent='Share your details and our property team will get back to you.';submit.textContent='Send Enquiry';
    if(!message.value)message.value='I would like more details about this property.';
    track('enquiry_form_open');
  }
  overlay.classList.add('is-open');overlay.setAttribute('aria-hidden','false');setTimeout(()=>document.getElementById('dlb-name')?.focus(),20);
};
const close=()=>{
  overlay.classList.remove('is-open');overlay.setAttribute('aria-hidden','true');submit.disabled=false;
  if(opener&&typeof opener.focus==='function')setTimeout(()=>opener.focus(),0);
};
const interceptWhatsAppClick=e=>{
  if(!cfg.captureWhatsApp||e.__dlbWhatsAppHandled)return false;
  const found=whatsappTriggerFromEvent(e);
  if(!found)return false;
  const phone=phoneFromHref(found.href)||targetPhone;
  if(!phone)return false;
  e.__dlbWhatsAppHandled=true;
  e.preventDefault();
  e.stopImmediatePropagation();
  track('whatsapp_click',{cta:'WhatsApp'});
  const remembered=readSessionIdentity();
  if(remembered){
    const msg=resolvedMessageFor(found.href,found.el);
    const submission=uuid();
    const payload=capturePayload('whatsapp',remembered.name,remembered.mobile,msg,submission,contextFromTrigger(found.el));
    postCapture(payload,true).then(r=>r.json()).then(json=>{
      if(json&&json.success)track('whatsapp_lead_captured',{cta:'WhatsApp',session_reuse:true});
    }).catch(()=>{});
    track('whatsapp_session_reuse',{cta:'WhatsApp'});
    track('whatsapp_opened',{cta:'WhatsApp',session_reuse:true});
    const destination=cfg.rewriteDivi&&targetPhone?targetPhone:(phoneFromHref(found.href)||targetPhone);
    window.location.href=destination?whatsappHref(destination,msg):found.href;
    return true;
  }
  openModal('whatsapp',found.href,msgFromHref(found.href),found.el);
  return true;
};
/* The listener sits on window capture, ahead of document/target handlers used by
   theme cards and builders. composedPath() also makes SVG-icon clicks resolve
   back to their owning WhatsApp anchor. Explicit data-dlb-no-capture is the
   only supported bypass. */
window.addEventListener('click',e=>{
  if(interceptWhatsAppClick(e))return;
},true);
document.addEventListener('click',e=>{
  const closeBtn=e.target.closest&&e.target.closest('[data-dlb-close]');
  if(closeBtn){e.preventDefault();close();return;}
  const enquiry=e.target.closest&&e.target.closest('[data-dlb-enquiry]');
  if(enquiry){e.preventDefault();e.stopImmediatePropagation();openModal('enquiry','','',enquiry);return;}
  const call=e.target.closest&&e.target.closest('a[href^="tel:"]');
  if(call)track('call_click',{cta:'Call'});
},true);
overlay.addEventListener('click',e=>{if(e.target===overlay)close();});
document.addEventListener('keydown',e=>{
  if(!overlay.classList.contains('is-open'))return;
  if(e.key==='Escape'){close();return;}
  if(e.key==='Tab'){
    const focusable=[...overlay.querySelectorAll('button:not([disabled]),input:not([disabled]),textarea:not([disabled]),select:not([disabled]),a[href]')].filter(el=>el.offsetParent!==null);
    if(!focusable.length)return;
    const first=focusable[0],last=focusable[focusable.length-1];
    if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}
    else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}
  }
});
form.addEventListener('submit',async e=>{
  e.preventDefault();
  const fd=new FormData(form);
  const name=String(fd.get('name')||'').trim();
  const mobile=String(fd.get('mobile')||'').replace(/\D+/g,'');
  const msg=String(fd.get('message')||'').trim();
  if(!name){status.textContent='Please enter your name.';status.className='dlb-form-status is-error';return;}
  if(mobile.length<10){status.textContent='Please enter a valid mobile number.';status.className='dlb-form-status is-error';return;}
  submit.disabled=true;status.textContent='Recording your enquiry…';status.className='dlb-form-status';
  const payload=capturePayload(mode,name,String(fd.get('mobile')||''),msg,uuid(),contextFromTrigger(opener));
  let accepted=false;
  try{
    const controller=new AbortController();const timer=setTimeout(()=>controller.abort(),4500);
    const res=await fetch(cfg.ajaxUrl,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:payload.toString(),credentials:'same-origin',signal:controller.signal});
    clearTimeout(timer);
    const json=await res.json();accepted=!!(json&&json.success);
    if(!accepted)throw new Error((json&&json.data&&json.data.message)||'Capture failed');
  }catch(err){
    status.textContent=mode==='whatsapp'?'We could not confirm CRM capture. Opening WhatsApp so you can still contact us.':'We could not record the enquiry. Please try again.';
    status.className='dlb-form-status is-error';
    if(mode!=='whatsapp'){submit.disabled=false;return;}
  }
  if(accepted){
    saveSessionIdentity(name,mobile);
    status.textContent=mode==='whatsapp'?'Enquiry recorded. Opening WhatsApp…':'Thank you. Your enquiry has been recorded.';
    status.className='dlb-form-status is-success';
    track(mode==='whatsapp'?'whatsapp_lead_captured':'enquiry_lead_captured',{cta:mode==='whatsapp'?'WhatsApp':'Enquiry'});
  }
  if(mode==='whatsapp'){
    track('whatsapp_opened',{cta:'WhatsApp'});
    const destination=cfg.rewriteDivi&&targetPhone?targetPhone:(phoneFromHref(targetHref)||targetPhone);
    const href=destination?whatsappHref(destination,msg||msgFromHref(targetHref)):targetHref;
    setTimeout(()=>{window.location.href=href;},120);
  }else{
    setTimeout(()=>{close();form.reset();submit.disabled=false;},900);
  }
});
rewriteDivi();
if(cfg.rewriteDivi){const observer=new MutationObserver(()=>rewriteDivi());observer.observe(document.documentElement,{childList:true,subtree:true});setTimeout(()=>observer.disconnect(),12000);}
})();</script></body>
</html>


