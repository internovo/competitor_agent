		<style>
		.grecaptcha-badge{ z-index: 2 }
		@media only screen and (max-width: 799px) { .grecaptcha-badge{ bottom: 50px !important } }
	</style>
	<script>
	  	addEventListener("DOMContentLoaded", (event) => {
		  setTimeout(() => {
			  loadRecaptcha();
			  console.log(typeof grecaptcha);
			  if (typeof grecaptcha == 'undefined') {
				const interval = setInterval(() => {
				  if (typeof grecaptcha !== 'undefined') {
					clearInterval(interval);
					attachForms();
				  }
				}, 100);
			  } else {
				attachForms();
			  }
		  }, 3500);
		});
		
		function loadRecaptcha() {
		  const script = document.createElement('script');
		  script.src = `https://www.google.com/recaptcha/api.js?render=6LdlnWcrAAAAADLpxNO1vi-Xim7Yf4LD2Vyc_2c-`;
		  script.defer = true;
		  document.head.appendChild(script);
		}

		function attachForms() {
		  document.querySelectorAll('form').forEach(form => {
			if (!form.querySelector('[name="g-recaptcha-response"]')) {
			  const input = document.createElement('input');
			  input.type = 'hidden';
			  input.name = 'g-recaptcha-response';
			  form.appendChild(input);
			}
			if (!form.querySelector('[name="recaptchaCheck"]')) {
			  const input = document.createElement('input');
			  input.type = 'hidden';
			  input.name = 'recaptchaCheck';
			  input.value = 'yes';
			  form.appendChild(input);
			}

			form.addEventListener('submit', function (e) {
			  e.preventDefault();

			  const rawAction = form.querySelector('[name="form_name"]')?.value || 'submit';
			  const actionName = rawAction.trim().toLowerCase().replace(/<[^>]*>/g, '').replace(/[^A-Za-z_]/g, '');

			  grecaptcha.ready(function () {
				grecaptcha.execute('6LdlnWcrAAAAADLpxNO1vi-Xim7Yf4LD2Vyc_2c-', { action: actionName }).then(function (token) {
				  form.querySelector('[name="g-recaptcha-response"]').value = token;
				  form.submit();
				});
			  });
			});
		  });
		}
	</script>
	
