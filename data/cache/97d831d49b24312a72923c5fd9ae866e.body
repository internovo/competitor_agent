        NavigationBar_NavButton__JwONn primary" data-testid="blox-button"><div class="Button_ButtonContent__qPyqO Button_ButtonContent-md__1XTQo"><div class="undefined Button_Text-md__R7FDU Button_BtnText__nrjra  primary " data-testid="text-custom">BOOK PROPERTY</div></div></div></div></div><div class="PropertyDetails_RelativeComponentCtn__xJB6K"><div class="PropertyDetails_BodyWrapper__xzEAL"><div class="PropertyDetails_leftSection__nwaCM"><section id="Overview"><div class="Overview_OverviewMain__jK_BF"><div class="Overview_Overview__Bc1p3 false" data-testid="blox-Overview"><h2 class="text_Htitle__vsNcm undefined Overview_HeadingTextOverview__4Xh33"><div class="undefined  text_text-20px__KiVZf" data-testid="text-custom">Overview</div></h2><div class="Overview_OverviewData__cLXua"><div class="TruncatedText_TruncateText__iKHoI text-12 
            undefined
            undefined"><div class="undefined TruncatedText TruncatedText_line-4__CGy8m Overview_OverviewDescriptionTruncText__KLEw7 
                 " data-testid="text-custom">The prices mentioned in the website includes Stamp duty and Registration charges. Please visit the Site for exact details.The ACME Group has launched an exclusive gated residential project, ACME Avenue in Kandivali. Located in the prime location of Mumbai, this high-rise magnificent towers of ACME Avenue is rising above everything else and presenting a life of a higher order. Placed off Kandivali Link Road near Inorbit Mall / Mindspace &amp; Infinity II Mall, this is an abode beyond the clutter of Mumbai, where every room of your home is blessed with the view of nature. Situated in a peaceful and serene surroundings, ACME Avenue redefines the concept of future living. Replete with space, luxury, lifestyle and state-of-the-art technology, ACME Avenue redefines the concept of future living!</div></div></div><div class="Overview_OverviewGrid__OKQXI false"><div><div class="Overview_LabelValue__6n8p7"><div class="undefined Overview_OverviewLabel__SqP8W text_text-14px__aPnkg" data-testid="text-custom">Configuration</div><div class="undefined Overview_Value__mQWHK text_text-14px__aPnkg" data-testid="text-custom">2 BHK, 3 BHK</div></div></div><div class="Overview_Separator__72rcU"></div><div><div class="Overview_LabelValue__6n8p7"><div class="undefined Overview_OverviewLabel__SqP8W text_text-14px__aPnkg" data-testid="text-custom">Ready to move</div><div class="undefined Overview_Value__mQWHK text_text-14px__aPnkg" data-testid="text-custom">Completed in Dec 2021</div></div></div><div class="Overview_Separator__72rcU"></div><div><div class="Overview_LabelValue__6n8p7"><div class="undefined Overview_OverviewLabel__SqP8W text_text-14px__aPnkg" data-testid="text-custom">Avg. Price</div><div class="undefined Overview_Value__mQWHK text_text-14px__aPnkg" data-testid="text-custom">₹16,700/sq.ft</div></div></div><div class="Overview_Separator__72rcU"></div><div><div class="Overview_LabelValue__6n8p7"><div class="undefined Overview_OverviewLabel__SqP8W text_text-14px__aPnkg" data-testid="text-custom">RERA Carpet Area</div><div class="undefined Overview_Value__mQWHK text_text-14px__aPnkg" data-testid="text-custom">642 - 1056 sqft</div></div></div></div></div><div><div class="Overview_ListContainer__RcPDE "><div class="Overview_highlightHeading__8JSvd">Why consider <span>buying this property</span>?</div><div class="Overview_HighlightsContainer__cYf_c"><ul class="Overview_Squarelist__NXH7D"><li>Best Design Innovation Award-Western Suburbs 2016</li><li>Close to Charkop-Nariman Point Road Project</li><li>Accessibility to key landmarks</li></ul><ul class="Overview_Squarelist__NXH7D"><li>Well-connected to Western Express Highway</li><li>Properties with 100% power backup available</li></ul></div></div></div></div></section><section id="AIReviewSummary"><div class="AIReviewSummary_Container__cdZ_7 Card_secondary__V9lZX Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="AIReviewSummary_Header__Z33Z1"><div class="AIReviewSummary_TitleWrapper__VrIqs"><div class="AIReviewSummary_TitleRow__RxyFc"><h2 class="text_Htitle__vsNcm AIReviewSummary_Title__r4_AU"><div class="undefined  text_desktop-heading-3__6qV5j" data-testid="text-custom">Google AI Summary</div></h2><span class="AIReviewSummary_Sparkle__4AIGg">✦</span></div><div class="AIReviewSummary_AiBadge__yHMUt"></div></div></div><div class="AIReviewSummary_ContentWrapper__H1KTG" style="max-height:380px"><div class="undefined AIReviewSummary_SummaryText__LoG_f text_desktop-body__tJn8c" data-testid="text-custom">Acme Avenue is an ultra-luxury residential project in Charkop, Kandivali West, consisting of two high-rise towers (Wings A and B). While the project is praised for its architectural design, premium internal specifications, and strategic location near the New Link Road and upcoming metro stations, it is heavily criticized for extreme possession delays. Many buyers report waiting over a decade for their homes, with some wings still under construction or awaiting final completion.</div><div class="AIReviewSummary_Grid__9zT79"><div class="AIReviewSummary_PointsCard__WtPbt  Card_secondary__V9lZX Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="AIReviewSummary_CardHeader__W5nac"><img alt="up-thumb" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class="AIReviewSummary_CardIcon__x8doc" style="color:transparent" src="/assets/icons/up-thumb.svg"/><h3 class="text_Htitle__vsNcm AIReviewSummary_CardTitle__3bBl_"><div class="undefined  text_desktop-heading-5__YAUk5" data-testid="text-custom">The good things</div></h3></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Strategic Location</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Excellent connectivity to the New Link Road, Western Express Highway, and Kandivali Railway Station.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Premium Amenities</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Features a grand clubhouse, swimming pool, fitness center with spa/sauna, and 4-tier advanced security systems.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">High-End Interiors</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Apartments include laminated wooden flooring in master bedrooms, vitrified tiles, and French-style windows.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Scenic Views</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Higher floors offer picturesque views of the city skyline, surrounding greenery, and the Global Pagoda.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Neighborhood Infrastructure</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Proximity to major malls (Inorbit, Infinity II), schools (Kangaroo Kids, Billabong), and hospitals.</div></div></div></div><div class="AIReviewSummary_PointsCard__WtPbt  Card_secondary__V9lZX Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="AIReviewSummary_CardHeader__W5nac"><img alt="down-thumb" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class="AIReviewSummary_CardIcon__x8doc" style="color:transparent" src="/assets/icons/down-thumb.svg"/><h3 class="text_Htitle__vsNcm AIReviewSummary_CardTitle__3bBl_"><div class="undefined  text_desktop-heading-5__YAUk5" data-testid="text-custom">Needs improvement</div></h3></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Severe Delays</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Significant history of project stagnation, with some buyers waiting since 2013 or earlier for possession.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Communication Issues</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Numerous complaints regarding non-responsive customer service and lack of transparency from the developer.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Construction Pace</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Reports of slow work progress on Tower B and multiple RERA completion date extensions.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Management Reputation</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Many reviewers express a loss of trust in the builder due to the prolonged &quot;under-construction&quot; status.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Parking &amp; Congestion</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Some reports of issues with visitor parking and congestion in the immediate vicinity.</div></div></div></div></div><div><hr class="AIReviewSummary_Divider__md7XZ"/><div class="undefined AIReviewSummary_VerdictLabel__jEfM0 text_desktop-heading-5__YAUk5" data-testid="text-custom">The Verdict</div><div class="AIReviewSummary_VerdictTags___OivB"><span class="AIReviewSummary_VerdictTag__XMXZK"><div class="undefined  text_desktop-body-sm__qq5_7" data-testid="text-custom">For End-Users</div></span><span class="AIReviewSummary_VerdictTag__XMXZK"><div class="undefined  text_desktop-body-sm__qq5_7" data-testid="text-custom">For Investors</div></span><span class="AIReviewSummary_VerdictTag__XMXZK"><div class="undefined  text_desktop-body-sm__qq5_7" data-testid="text-custom">Critical Note</div></span></div></div><div class="AIReviewSummary_FadeOverlay__CFpBd" style="opacity:1"></div></div><div class="AIReviewSummary_ToggleContainer__OfGS6 "><button class="AIReviewSummary_ViewMoreBtn__LXBrc"><div class="undefined AIReviewSummary_BtnText__a2mA5 text_mobile-cta__98PCA" data-testid="text-custom">REVEAL FULL SUMMARY</div><span class="AIReviewSummary_BtnIcon__HS5CT">✦</span><div class="AIReviewSummary_Shimmer__D9tsE"></div></button></div></div></section><section id="Amenities"><div class="Amenities_Amenities__Idw7g" data-testid="blox-Amenities"><div class="Amenities_AmmCard__Gu2e5 Card_secondary__V9lZX Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="Amenities_AmenitiesHeadingTxt__bxyH0 squarebx rightPos"><h2 class="text_Htitle__vsNcm "><div class="undefined  text_text-20px__KiVZf" data-testid="text-custom">Amenities</div></h2></div><div class="Amenities_amenitiesDesktop__NRcWU"><div class="Amenities_TagGrid__rI9__"><div class="Amenities_IconLabel__WOGsG"><img alt="amenities/gym-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class="" style="color:transparent" src="/assets/icons/amenities/gym-secondary.svg"/><div>Gymnasium</div></div><div class="Amenities_IconLabel__WOGsG"><img alt="amenities/indoor-games-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class=