em\":\"https://blox.xyz/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Properties in Mumbai\",\"item\":\"https://blox.xyz/buy/mumbai/1a256\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Properties in Kandivali West\",\"item\":\"https://blox.xyz/buy/mumbai/kandivali-west-1a256b7a71\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Acme Group\",\"item\":\"https://blox.xyz/buy/mumbai/kandivali-west-acme-group-1a256b7a71b13a65\"},{\"@type\":\"ListItem\",\"position\":5,\"name\":\"Acme Avenue\",\"item\":\"https://blox.xyz/projects/acme-avenue\"}]\n}","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\"@type\":\"Question\",\"name\":\"When is the possession date for Acme Avenue?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Possession date of Acme Avenue is 30 Dec 2021\"}},{\"@type\":\"Question\",\"name\":\"What is the RERA carpet area range of Acme Avenue?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The RERA carpet area range for Acme Avenue is 642 - 1056 sqft\"}},{\"@type\":\"Question\",\"name\":\"What is the price range of Acme Avenue?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The price range of Acme Avenue is ₹1.07 Cr - 1.65 Cr\"}},{\"@type\":\"Question\",\"name\":\"Where is Acme Avenue located?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Acme Avenue is located at Ambedkar Rd, Kandivali, Charkop, Ambedkar Nagar, Kandivali West, Mumbai, Maharashtra 400067.\"}},{\"@type\":\"Question\",\"name\":\"What configurations are available in Acme Avenue?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Acme Avenue has 2 BHK, 3 BHK configurations.\"}},{\"@type\":\"Question\",\"name\":\"What is the status of Acme Avenue?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The status of Acme Avenue is Ready to move.\"}},{\"@type\":\"Question\",\"name\":\"Which amenities are provided in Acme Avenue?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The amenities are Gymnasium, Indoor Games, Jogging / Cycle Track, Kids Play Areas / Sand Pits, Large Green Area, Spa, Swimming Pool.\"}},{\"@type\":\"Question\",\"name\":\"Who is the developer of Acme Avenue?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The developer of Acme Avenue is Acme Group.\"}}]\n}\n","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"Acme Avenue\",\n  \"image\": \"https://cdn.blox.xyz/builders/thumb/241221043544-Acme.png\",\n  \"description\": \"The prices mentioned in the website includes Stamp duty and Registration charges. Please visit the Site for exact details.The ACME Group has launched an exclusive gated residential project, ACME Avenue in Kandivali. Located in the prime location of Mumbai, this high-rise magnificent towers of ACME Avenue is rising above everything else and presenting a life of a higher order. Placed off Kandivali Link Road near Inorbit Mall / Mindspace \u0026 Infinity II Mall, this is an abode beyond the clutter of Mumbai, where every room of your home is blessed with the view of nature. Situated in a peaceful and serene surroundings, ACME Avenue redefines the concept of future living. Replete with space, luxury, lifestyle and state-of-the-art technology, ACME Avenue redefines the concept of future living!\",\n  \"brand\": {\n\t\t\"@type\": \"Brand\",\n\t\t\"name\": \"Acme Group\"\n\t},\n  \"offers\": {\n\t\t\"@type\": \"AggregateOffer\",\n    \"url\": \"https://blox.xyz/projects/acme-avenue\",\n\t\t\"priceCurrency\": \"INR\",\n\t\t\"lowPrice\": \"10700000.00\",\n\t\t\"highPrice\": \"16500000.00\"\n\t}\n}\n","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": [\n      \"SingleFamilyResidence\",\n      \"Product\",\n      \"RealEstateListing\"\n  ],\n  \"@id\": \"https://blox.xyz/projects/acme-avenue\",\n  \"mpn\": \"P51800002030\",\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"@id\": \"https://blox.xyz/buy/mumbai/acme-group-1a256b13a65\",\n    \"name\": \"Acme Group\"\n  },\n  \"url\": \"https://blox.xyz/projects/acme-avenue\",\n  \"containedInPlace\": {\n      \"@type\": \"Place\",\n      \"@id\": \"Acme Avenue\",\n      \"url\": \"https://blox.xyz/projects/acme-avenue\",\n      \"name\": \"Acme Avenue\",\n      \"address\": {\n          \"@type\": \"PostalAddress\",\n          \"streetAddress\": \"Ambedkar Rd, Kandivali, Charkop, Ambedkar Nagar, Kandivali West, Mumbai, Maharashtra 400067\",\n          \"addressLocality\": \"Kandivali West\",\n          \"addressRegion\": \"Mumbai\",\n          \"postalCode\": \"400067\",\n          \"addressCountry\": \"IN\"\n      }\n  },\n  \"description\": \"The prices mentioned in the website includes Stamp duty and Registration charges. Please visit the Site for exact details.The ACME Group has launched an exclusive gated residential project, ACME Avenue in Kandivali. Located in the prime location of Mumbai, this high-rise magnificent towers of ACME Avenue is rising above everything else and presenting a life of a higher order. Placed off Kandivali Link Road near Inorbit Mall / Mindspace \u0026 Infinity II Mall, this is an abode beyond the clutter of Mumbai, where every room of your home is blessed with the view of nature. Situated in a peaceful and serene surroundings, ACME Avenue redefines the concept of future living. Replete with space, luxury, lifestyle and state-of-the-art technology, ACME Avenue redefines the concept of future living!\",\n  \"floorSize\": [\n      {\n          \"@type\": \"QuantitativeValue\",\n          \"unitCode\": \"SQFT\",\n          \"minValue\": \"642\",\n          \"maxValue\": \"1056\"\n      }\n  ],\n  \"image\": [\n      {\n          \"@type\": \"ImageObject\",\n          \"url\": \"https://cdn.blox.xyz/builders/thumb/241221043544-Acme.png\"\n      }\n  ],\n  \"name\": \"Acme Avenue\",\n  \"offers\": {\n      \"@type\": \"Offer\",\n      \"@id\": \"P51800002030\",\n      \"availability\": \"https://schema.org/InStock\",\n      \"name\": \"Sale of Acme Avenue Unit\",\n      \"url\": \"https://blox.xyz/projects/acme-avenue\",\n      \"price\": 10700000.00,\n      \"priceCurrency\": \"INR\"\n  }\n}\n"],"aiReviewSummary":{"summary":"Acme Avenue is an ultra-luxury residential project in Charkop, Kandivali West, consisting of two high-rise towers (Wings A and B). While the project is praised for its architectural design, premium internal specifications, and strategic location near the New Link Road and upcoming metro stations, it is heavily criticized for extreme possession delays. Many buyers report waiting over a decade for their homes, with some wings still under construction or awaiting final completion.","pros":[{"title":"Strategic Location","description":"Excellent connectivity to the New Link Road, Western Express Highway, and Kandivali Railway Station."},{"title":"Premium Amenities","description":"Features a grand clubhouse, swimming pool, fitness center with spa/sauna, and 4-tier advanced security systems."},{"title":"High-End Interiors","description":"Apartments include laminated wooden flooring in master bedrooms, vitrified tiles, and French-style windows."},{"title":"Scenic Views","description":"Higher floors offer picturesque views of the city skyline, surrounding greenery, and the Global Pagoda."},{"title":"Neighborhood Infrastructure","description":"Proximity to major malls (Inorbit, Infinity II), schools (Kangaroo Kids, Billabong), and hospitals."}],"cons":[{"title":"Severe Delays","description":"Significant history of project stagnation, with some buyers waiting since 2013 or earlier for possession."},{"title":"Communication Issues","description":"Numerous complaints regarding non-responsive customer service and lack of transparency from the developer."},{"title":"Construction Pace","description":"Reports of slow work progress on Tower B and multiple RERA completion date extensions."},{"title":"Management Reputation","description":"Many reviewers express a loss of trust in the builder due to the prolonged \"under-construction\" status."},{"title":"Parking \u0026 Congestion","description":"Some reports of issues with visitor parking and congestion in the immediate vicinity."}],"verdict":["For End-Users","For Investors","Critical Note"]},"googleReviews":null},"isMobile":false,"footerData":{"featured":{"kolkata":{"label":"Kolkata","id":14},"mumbai":{"label":"Mumbai","id":256},"navi-mumbai":{"label":"Navi Mumbai","id":261},"pune":{"label":"Pune","id":300},"thane":{"label":"Thane","id":269}},"others":{"alibaug":{"label":"Alibaug","id":1907},"bangalore":{"label":"Bangalore","id":95},"noida":{"label":"Noida","id":84},"palghar":{"label":"Palghar","id":264},"raigad":{"label":"Raigad","id":3323},"telangana":{"label":"Telangana","id":3326}}},"__N_SSP":true},"page":"/projects/[project_name]","query":{"project_name":"acme-avenue"},"buildId":"t4LZHlTlBLViwyNa5GApO","isFallback":false,"gssp":true,"appGip":true,"scriptLoader":[]}</script></body></html>