tainer"><div role="link" tabindex="0" class="listing-card-root block listing-card--portrait" aria-label="View 2 BHK Flat for Sale in Romell Allure details"><div class="listing-card__image-section"><img src="/assets/webp/listing-images-missing.webp" alt="2 BHK Flat for Sale in Romell Allure" width="400" height="300" loading="lazy" decoding="async"/><div class="listing-card__category-pill-overlay"><div class="inline-flex items-center gap-1 rounded-md px-2 py-1 w-max capitalize border transition-colors text-amber-700 bg-amber-100 border-amber-500 border-none px-2 py-1 cursor-text hover:border-none hover:shadow-none"><div class="relative flex h-4 w-4 items-center justify-center"><div class="h-[85%] w-[85%] rounded-full bg-current"></div><div class="absolute top-[90%] h-0 w-0 border-x-[2px] border-x-transparent border-t-[3px] border-t-current"></div></div><p class="text-xs font-semibold">residential</p></div></div></div><div class="listing-card__details"><div class="listing-card__header-row"><div class="listing-card__title-section"><h3 class="listing-card__title">2 BHK Flat for Sale in Romell Allure</h3><div class="listing-card__subheader"><div class="listing-card__subheader-main"><span class="listing-card__category-pill-wrap shrink-0"><div class="inline-flex items-center gap-1 rounded-md px-2 py-1 w-max capitalize border transition-colors text-amber-700 bg-amber-100 border-amber-500 border-none px-2 py-1 cursor-text hover:border-none hover:shadow-none"><div class="relative flex h-4 w-4 items-center justify-center"><div class="h-[85%] w-[85%] rounded-full bg-current"></div><div class="absolute top-[90%] h-0 w-0 border-x-[2px] border-x-transparent border-t-[3px] border-t-current"></div></div><p class="text-xs font-semibold">residential</p></div></span><span class="listing-card__location">Romell Allure</span></div></div></div><div class="listing-card__actions-header"><button type="button" class="listing-card__icon-btn" aria-label="Share"><svg xmlns="http://www.w3.org/2000/