<script>
$(function () {
    // AJAX Login
    $("#adminLoginForm").on("submit", function(e){
        e.preventDefault(); // prevent page refresh
        var formData = $(this).serialize();

        $.ajax({
            url: "bittu/assets_b/admin-settings/login_handler.php",
            type: "POST",
            data: formData,
            success: function(res){
                res = res.trim();
                if(res === "success"){
                   $(".loginMessage").html(`<span class="text-success">✅ Successfully logged in!</span>`);
                    $(".loginMessage").after(`
                        <form id="logoutForm" method="post" action="assets_b/logout_handler.php" class="ms-auto mb-0">
                            <button type="submit" class="btn btn-sm btn-outline-danger float-end">Logout</button>
                        </form>
                    `);

                    setTimeout(function(){
                        $("#loginFormWrapper").hide();
                        $("#themeSettingsWrapper").show();
                        $("#adminSettingsModalLabel").text("Theme Settings");
                    }, 500);
                } else {
                    $(".loginMessage").html('<span class="text-danger">❌ Invalid email or password</span>');
                }
            },
            error: function(){
                $(".loginMessage").html('<span class="text-danger">❌ Something went wrong</span>');
            }
        });
    });
});
$(document).on("submit", "#logoutForm", function(e){
    e.preventDefault();
    $.post("assets_b/admin-settings/logout_handler.php", function(res){
        if(res.trim() === "logged_out"){
            $(".loginMessage").html('<span class="text-info">🔒 Logged out</span>');
            $("#themeSettingsWrapper").hide();
            $("#loginFormWrapper").show();
            $("#adminSettingsModalLabel").text("Admin Login");
            $("#logoutForm").remove();
        }
    });
});
</script>

