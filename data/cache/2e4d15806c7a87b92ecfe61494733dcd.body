ph_Builders-Triumph_Towers--Bedroom-1642167120.webp"},{"title":"Elevation","url":"https://cdn.blox.xyz/projects-2x/triumph-ventures-triumph-towers-elevation-1724326989.webp"},{"title":"Bedroom","url":"https://cdn.blox.xyz/projects-2x/triumph-ventures-triumph-towers-elevation-1724326633.webp"},{"title":"Location Map","url":"https://cdn.blox.xyz/projects-2x/triumph-ventures-triumph-towers-bedroom-1673196263.webp"}],"crmVideosList":[],"realgramVideosList":[],"breadcrumbs":[{"name":"Mumbai","path":"/"},{"name":"Properties in Mumbai","path":"/buy/mumbai/1a256"},{"name":"Properties in Malad West","path":"/buy/mumbai/malad-west-1a256b7a91"},{"name":"Triumph Ventures","path":"/buy/mumbai/malad-west-triumph-ventures-1a256b7a91b13a390"}],"propertyName":"Triumph Towers","propertyArea":"Malad West","propertyAddress":"Triumph Towers ,Bajaj Hall, Swami Vivekananda Rd, Malad, Pawan Baug, Liliya Nagar, Malad West, Mumbai, Maharashtra 400064","priceRange":"₹1.93 Cr - 2.84 Cr","propertyImage":"https://cdn.blox.xyz/builders/thumb/100522113411-triumphven.png","rmContactNumber":"7977272815","tags":[],"rmCardData":{"projectId":269,"rmId":2776,"name":"Aijaz Nalband","experience":"","rating":"4.5","reviewCount":"","profileImage":"https://cdn.blox.xyz/users/080526111634-img-20260113-111125-aijaznalband.webp","headerText":"Our team is here to help you with any questions”","subHeaderText":"One of our RMs will assist you.","contactNumber":"7977272815"},"BookingTypes":["Direct Booking"],"configuration":"2 BHK, 3 BHK","carpetArea":"765 - 1125 sqft","cityName":"Mumbai","FloorPlanData":[{"label":"2 BHK","value":[{"Property_type":"Apartment","agreement_price":"19299420.00","booking_amount":"100000","configLabel":"2 BHK","configuration":"2 BHK","floor_plan_media_url":"https://cdn.blox.xyz/properties/triumph-ventures-triumph-towers-2-bhk-bedroom-1673195746.webp","id":1310,"online_payment":0,"possesion":"30 Jun 2023","project_tower_property_id":1310,"rera_carpet_area":"765 sq. ft","rera_id":"P51800027364","tower":"Triumph Towers"}]},{"label":"3 BHK","value":[{"Property_type":"Apartment","agreement_price":"28381500.00","booking_amount":"100000","configLabel":"3 BHK","configuration":"3 BHK","floor_plan_media_url":"https://cdn.blox.xyz/properties/triumph-ventures-triumph-towers-3-bhk-bedroom-1673195614.webp","id":1312,"online_payment":0,"possesion":"30 Jun 2023","project_tower_property_id":1312,"rera_carpet_area":"1125 sq. ft","rera_id":"P51800027364","tower":"Triumph Towers"}]}],"bookPropertyEnabled":false},"OverviewProps":{"description":"Introducing Triumph Tower, a stunning development with thoughtfully planned living spaces that feature well-designed apartments at affordable prices. With its remarkable apartments in Malad, Triumph Tower offers a lifestyle fit for royalty. Triumph Tower allows you to forget that you live in the heart of the city, making your home the perfect retreat after a long day at work. These residential apartments in Malad provide luxurious residences that seamlessly escape the city center's noise. Additionally, living in apartments in a prime location offers a range of advantages. Triumph Tower is ideally situated in Malad, providing unparalleled connectivity to all major landmarks and essential services, including numerous reputable medical facilities, schools, supermarkets, parks, entertainment venues, recreational centers, and more.","project_area_range":"765-1125 sq. ft.","carpetArea":"765 - 1125 sqft","possession":"30 Jun 2023","construction_status":"Ready to move","avgPrice":"25228","reraId":"P51800027364","configuration":"2 BHK, 3 BHK","configuration_short":"2, 3 BHK","highlights":["Connected to trains via Malad Railway Station on the Mumbai Suburban Railway's Western Line","Being close to the Western Express Highway provides quick access to places like Kandivali, Borivali East, and Aarey.","Connected to Manori, Gorai, and Versova through ferries","Where renowned educational institutions like Ryan International School, Witty International School, and Rejoice International School are located","There are many hospitals here, including Lifeline Multispeciality Hospital, Zenith Hospital, and Saraswati Hospital.","Numerous shopping malls, including as Evershine Mall, Infiniti Mall, and Inorbit Mall, are located in Malad (West).","Popular tourist attractions in the area include Sanjay Gandhi National Park, Marve Beach, and Ashtavinayak Temple."],"projectType":"Residential"},"AmenitiesProps":{"AmenitiesData":[{"icon":"cctv","id":47,"name":"CCTV / Video Surveillance"},{"icon":"gym","id":49,"name":"Gymnasium"},{"icon":"indoor-games","id":38,"name":"Indoor Games"},{"icon":"Intercom-Facility","id":67,"name":"Intercom Facility"},{"icon":"jogging","id":57,"name":"Jogging / Cycle Track"},{"icon":"kids-play-areas","id":54,"name":"Kids Play Areas / Sand Pits"},{"icon":"large-green-area","id":34,"name":"Large Green Area"},{"icon":"Library-And-Business-Centre","id":75,"name":"Library And Business Centre"},{"icon":"Multi-purpose-court","id":80,"name":"Multipurpose Hall"},{"icon":"snooker-pool-billiards","id":59,"name":"Snooker / Billiards"},{"icon":"swimming-pool","id":50,"name":"Swimming Pool"},{"icon":"table-tennis","id":58,"name":"Table Tennis"},{"icon":"yoga-areas","id":56,"name":"Yoga Area"}]},"BrochureProps":{"brochure_url":""},"PaymentPlanDataProps":{"payment_plans":null},"PriceRange":{"Price":""},"BookProperty":{"Banner_id":0,"Banner_image_url":""},"DeveloperInfoProps":{"name":"Triumph Ventures","logo_url":"https://cdn.blox.xyz/builders/thumb/100522113411-triumphven.png","description":"Triumph Ventures is the brainchild of Mr. Rajiv Anant Shah, who is part of the Chintamani Group, a diversified conglomerate with interests in real estate, textiles and film studios. Over the years the group has developed various residential and commercial properties across the city in Zaveri Bazar, Mahim, Andheri and Goregaon. Mr. Shah carries with himself almost 2 decades of experience in Real Estate. He has been actively involved in every stage of these projects, right from identifying potential development to its acquisition, its planning, execution and completion till the final handover. Triumph Ventures are also redeveloping the adjoining society plot under the name “Omkareshwar”. Both projects combined are all set to change the look and skyline of Rajendra Nagar and the lifestyle of the residents with their design and modern amenities. Triumph Group envisages to create projects of impeccable quality and efficient design which would add value to the lifestyle of a buyer.","propertyName":"Triumph Towers"},"PriceFloorPlanProps":{"FloorPlanData":null},"LocalityProps":{"mapProps":{"lat":19.177704,"lng":72.844482,"zoomLevel":15,"markerList":[{"lat":19.177704,"lng":72.844482,"name":"Triumph Towers","address":"","markerAddress":"Triumph Towers ,Bajaj Hall, Swami Vivekananda Rd, Malad, Pawan Baug, Liliya Nagar, Malad West, Mumbai, Maharashtra 400064"}]},"placeTypes":[{"type":"school","places":[{"name":"St Mary's English School","numRatings":"","rating":"","distance":"0.2 km","iconName":"","propertyMarker":{"lat":19.1776118,"lng":72.84680929999999,"name":"St Mary's English School","address":"5RHW+2PV, Chincholi Signal, near Legacy of mumbai restaurant, Malad, Chincholi Phatak, Malad West, Mumbai"}},{"name":"Kudilal Govindram Seksaria Sarvodaya School","numRatings":"","rating":"","distance":"0.2 km","iconName":"","propertyMarker":{"lat":19.176752,"lng":72.8455846,"name":"Kudilal Govindram Seksaria Sarvodaya School","address":"RSET Campus, KGSS, Swami Vivekanand Rd, Mandlik Nagar, Sunder Nagar, Malad West, Mumbai"}},{"name":"J Kumar International School","numRatings":"","rating":"","distance":"0.2 km","iconName":"","propertyMarker":{"lat":19.1791011,"lng":72.84390669999999,"name":"J Kumar International School","address":"2/36, Chincholi Bunder Rd, Malad, Nadiyawala Colony 2, Malad West, Mumbai"}},{"name":"Umedbhai Patel English School","numRatings":"","rating":"","distance":"0.3 km","icon