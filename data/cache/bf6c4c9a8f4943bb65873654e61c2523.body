<section class="bread-payment">
    <div class="breadcrumb" style="background-image:linear-gradient(45deg, rgba(0, 0, 0, 0.589), rgba(0, 0, 0, 0.589)), url(https://whispering-heights.in/wp-content/uploads/2025/02/4-bhk-luxury-flats-in-Faridabad.jpg);background-size: cover;">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <h1 class="common-heading2">3 BHK Apartments in Faridabad</h1>
                </div>
