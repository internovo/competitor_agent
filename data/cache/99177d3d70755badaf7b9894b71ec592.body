    <script>
        function get_location_prices(e){$.ajax({type:"get",dataType:"json",url:"https://www.addressofchoice.com/property_detail/get_location_price_trend",data:{location_id:e},success:function(e){1==e.st&&("empty"!=e.data?new Morris.Line({element:"myfirstchart",data:e.data,xkey:"year",ykeys:["value"],labels:["Value"]}):$(".charset_class").html(""))}})}
        document.addEventListener('DOMContentLoaded', function () {
            const filterButtons = document.querySelectorAll('.filter-btn');
            const properties = document.querySelectorAll('.property-item');
            filterButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    const filter = this.getAttribute('data-filter');
                    // Button active state
                    filterButtons.forEach(function (btn) {
                        btn.classList.remove('active', 'btn-primary');
                        btn.classList.add('btn-outline-primary');
                    });
                    this.classList.add('active', 'btn-primary');
                    this.classList.remove('btn-outline-primary');
                    // Filter properties
                    properties.forEach(function (property) {
                        if (filter === 'all' || property.classList.contains(filter)) {
                            property.style.display = '';
                        } else {
                            property.style.display = 'none';
                        }
                    });
                });
            });
        });
    </script>
    <script>
        $(document).ready(function() {
            const inventorySwiper = new Swiper(".inventory", {
                slidesPerView: 3,
                navigation: {
                    nextEl: ".swiper-button-next",
                    prevEl: ".swiper-button-prev",
                },
                breakpoints: {
                    300: {
                        slidesPerView: 1,
                    },
                    600: {
                        slidesPerView: 2,
                    },
                    1199: {
                        slidesPerView: 3,
                    },
                }
            });
            $("div[id='#avail_count_1']").trigger('onclick');
            $("#emi_starting").html($("#first_emi_price").val());
        });
    </script>
