jQuery(document).ready(function ($) {
  // Project data
  const projectData = {
    raaya: {
      title: "Runwal Raaya",
      location: "Worli, Mumbai",
      description:
        "Runwal Raaya redefines luxury living with thoughtfully designed spaces, modern amenities, and serene surroundings at the heart of Kanjurmarg.",
    },
    sanctuary: {
      title: "Runwal Sanctuary",
      location: "Mulund, Mumbai",
      description:
        "Set against the dramatic backdrop of Yogi Hills, Sanctuary, Mulund brings Oasis living to life in harmony with nature. With about 75% open space, rooftop pools mirror the mountains, yoga gardens breathe calm, and quiet family lounges turn every return home into a retreat.",
    },
    landsend: {
      title: "Runwal Land’s End",
      location: "Kolshet, Thane",
      description:
        "An exclusive address with panoramic views and sophisticated living — Runwal Land’s End brings elegance and comfort together seamlessly.",
    },
    runwallife: {
      title: "Runwal 25 Hour Life",
      location: "Manpada, Thane",
      description:
        "An exclusive address with panoramic views and sophisticated living — Runwal Land’s End brings elegance and comfort together seamlessly.",
    },
    runwalcentralpark: {
      title: "Runwal The Central Park",
      location: "Pimpri Chinchwad",
      description:
        "An exclusive address with panoramic views and sophisticated living — Runwal Land’s End brings elegance and comfort together seamlessly.",
    },
  };

  // ✅ Set default active (sanctuary)
  $(".circle-main-div").each(function () {
    const title = $(this).attr("data-title");
    if (title === "sanctuary") {
      $(this).find(".circle-inner-div").addClass("active");
      $(this).css({
        border: "3px solid #AA8A4B",
        background: "#AA8A4B",
      });
    } else {
      $(this).find(".circle-inner-div").removeClass("active");
      $(this).css({
        border: "5px solid #AA8A4B",
        background: "#fff",
      });
    }
  });

  // ✅ On image marker click
  $(".location-point").on("click", function () {
    const key = $(this).data("project");
    const data = projectData[key];

    // Reset all circles
    $(".circle-main-div").each(function () {
      $(this).find(".circle-inner-div").removeClass("active");
      $(this).css({
        border: "5px solid #AA8A4B",
        background: "#fff",
      });
    });

    // Activate selected
    const circle = $(this).find(".circle-main-div");
    circle.find(".circle-inner-div").addClass("active");
    circle.css({
      border: "3px solid #AA8A4B",
      background: "#AA8A4B",
    });

    // Change text smoothly
    if (data) {
      $(".project-info-box h2, .project-info-box p, .project-info-box .location-text").fadeOut(200, function () {
        $(".project-info-box h2").text(data.title);
        $(".project-info-box .location-text").text(data.location);
        $(".project-info-box .description-text").text(data.description);
        $(".project-info-box h2, .project-info-box p, .project-info-box .location-text").fadeIn(300);
      });
    }
  });
});
        $(document).ready(function () {
            $(".accordion-header").click(function () {
                const body = $(this).next(".accordion-body");
                const symbol = $(this).find("span");

                // Close all open accordions
                $(".accordion-body").not(body).slideUp(300);
                $(".accordion-header span").text("+");

                // Toggle the clicked one
                if (body.is(":visible")) {
                    body.slideUp(300);
                    symbol.text("+");
                } else {
                    body.slideDown(300);
                    symbol.text("-");
                }
            });
        });


        AOS.init({
            duration: 1500,
            easing: 'ease-in-out',
            offset: 100,
            delay: 100,
            once: true,
            mirror: false,
        });
    </script>
    
