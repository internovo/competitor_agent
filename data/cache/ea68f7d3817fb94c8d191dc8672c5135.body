// Runwal The Central Park footer Read More toggle — self-contained, same behaviour as Company Overview
function toggleFooterReadMore() {
    var content = document.getElementById('footerMoreContent');
    var btn = document.getElementById('footerReadMoreBtn');
    if (content.style.display === 'none' || content.style.display === '') {
        content.style.display = 'block';
        btn.style.display = 'none';
    } else {
        content.style.display = 'none';
        btn.style.display = 'inline-flex';
        setTimeout(function() { btn.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 100);
    }
}
</script>

