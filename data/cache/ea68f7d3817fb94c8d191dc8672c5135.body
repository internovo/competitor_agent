    <script type="rocketlazyloadscript">
const phoneSlide = document.getElementById("phoneSlide");
const phoneText = document.getElementById("phoneText");

phoneSlide.addEventListener("click", () => {
    if (phoneSlide.classList.contains("max-w-12")) {
        phoneSlide.classList.remove("max-w-12");
        phoneSlide.classList.add("max-w-[500px]");
        phoneText.classList.remove("opacity-0");
        phoneText.classList.add("opacity-100");
    } else {
        phoneSlide.classList.add("max-w-12");
        phoneSlide.classList.remove("max-w-[500px]");
        phoneText.classList.add("opacity-0");
        phoneText.classList.remove("opacity-100");
    }
});

</script>


