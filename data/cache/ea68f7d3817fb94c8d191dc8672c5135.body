//         })

 $('.categoryList li').click(function () {
    // Check which slider should be active
    $('.Complted-slider, .Complted_slider2').each(function () {
        if ($(this).is(':visible')) { // Check if the slider is visible
            $(this).slick('setPosition'); // Adjust its position
            $(this).slick('slickPlay');  // Restart autoplay
        }
    });
});



document.addEventListener("DOMContentLoaded", function () {
    const blurImageLoop = document.getElementById("blurImageLoop"); // Blur image loop container
    const sliderLoop = document.getElementById("sliderLoop"); // Slider container
    const popupModal = document.getElementById("popupModal2"); // Form modal
    const form = document.getElementById("floorPlanForm"); // The form
    const closeModalBtn = popupModal.querySelector(".close-btn"); // Close button in modal

    // Function to show the modal on blur image click
    document.querySelectorAll(".popupform").forEach(item => {
        item.addEventListener("click", function () {
            popupModal.classList.remove("visibility"); // Show form modal
        });
    });

    // Close modal on close button click
    closeModalBtn.addEventListener("click", function () {
        popupModal.classList.add("visibility");
    });

    // Form submission logic
    form.addEventListener("submit", function (e) {
        e.preventDefault(); // Prevent default form submission

        const formData = new FormData(form); // Gather form data

        // Submit form using fetch API
        fetch(form.action, {
            method: "POST",
            body: formData,
        })
            .then(response => {
                console.log("Response Status:", response.status);  // Log response status

                // Check if the response is successful
                if (response.status === 200) {
                    return response.json();  // Parse JSON if status is 200
                } else {
                    throw new Error("Server error: " + response.status);  // Throw error if not 200
                }
            })
            .then(data => {
                console.log("Response Data:", data);  // Log response data

                if (data.success) {
                    // Handle success (hide modal, show slider, etc.)
                    popupModal.classList.add("visibility");
                    blurImageLoop.classList.add("visibility");
                    sliderLoop.classList.remove("visibility");

                    // alert("Thank you! Your details have been submitted successfully.");
                } else {
                    alert("Submission failed: " + (data.message || "Please try again."));
                }
            })
            .catch(error => {
                console.error("Error:", error);
                alert("An error occurred while submitting the form. Please try again.");
            });
    });
});





    </script>
    <script type="rocketlazyloadscript">
document.getElementById("brochureForm").addEventListener("submit", function () {
    const consentCheckbox = document.getElementById("myCheckbox");
    
    if (!consentCheckbox.checked) {
        // Create a hidden input to send "false" if unchecked
        const hiddenConsent = document.createElement("input");
        hiddenConsent.type = "hidden";
        hiddenConsent.name = "consent";
        hiddenConsent.value = "false";
        this.appendChild(hiddenConsent);
    }
});
</script>

