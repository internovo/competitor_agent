$(document).ready(function() {
    // Open modal on button click
    $('.read-more-btn').click(function(event) {
        event.preventDefault();
        const targetModal = $(this).data('target'); // Get the target modal from data attribute
        $(targetModal).removeClass('hidden').fadeIn(); // Show the modal
    });

    // Close modal on close button click
    $(document).on('click', '.close-btn', function() {
        $(this).closest('.modal').fadeOut(function() {
            $(this).addClass('hidden'); // Hide the modal
        });
    });

    // Close modal on clicking outside the modal content
    $(window).click(function(event) {
        $('.modal').each(function() {
            if ($(event.target).is(this)) {
                $(this).fadeOut(function() {
                    $(this).addClass('hidden'); // Hide the modal
                });
            }
        });
    });
});

