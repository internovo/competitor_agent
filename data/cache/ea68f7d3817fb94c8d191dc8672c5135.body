.popup-content {
  position: absolute;
  width: 1200px !important
		;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  padding: 0px;
  border-radius: 10px;
  text-align: center;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
	background-color: #fff7eb;
}

#customPopup {
  display: none;
  position: fixed;
  width: 800px;
  max-width: 90%;
  background: #fff;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.2);
  border-radius: 10px;
  z-index: 9999;
	  background-color: #fff7eb;
}
@media (max-width:768){
	#customPopup .popup-content{
	height:800px !important:
		overflow-x:scroll;
	}
}
#customPopup .popup-content {
  display: flex;
	flex-wrap: wrap;

	    width: 100%;
    aspect-ratio: 2 / 1;
  flex-direction: row;
	  background-color: #fff7e9;
}
@media (max-width:578px){
	#customPopup .popup-right {
    width: 100% !important ;
	
	}}
#customPopup .popup-left {
    width: 50%;
    background: url(https://runwalrealty.com/wp-content/uploads/2025/07/popupdesk.jpeg) no-repeat center center;
    background-size: contain;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
	cursor: pointer;
}

#customPopup .popup-right {
  width: 50%;
  padding: 15px;
  text-align: start;
  background-color: #fff7e9;
}

#popupOverlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9998;
}

