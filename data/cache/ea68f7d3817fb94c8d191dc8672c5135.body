$('.about-trigger').click(function() {
    $(this).parent().siblings('li').children('.dropDown').hide();
    $(this).next('.dropDown').toggle();
    if ($(this).children('span').text() == '+') {
        $(this).parent().siblings('li').find('span').text('+')
        $(this).children('span').text('-')
    } else {
        $(this).children('span').text('+')
    }
})

