    display:flex;
    
}

.extra-amenities-section.hidden{
    display:none;
    
}
.customers_slider .slick-track {
    margin: 0;
}
.visibility{
    display:none !important;
}
.brochure-range-slider {
    position: relative;
    height: 5px;
    margin-top: 3rem;
}
.brochure-range-slider .slider-track,
.brochure-range-slider .slider-range {
    position: absolute;
    height: 100%;
    border-radius: 3px;
    margin-top: -8px;
}
.brochure-range-slider .slider-track {
    background-color: #e5e7eb;
    width: 100%;
    z-index: 1;
}
.brochure-range-slider .slider-range {
    background-color: #aa8a4b;
    z-index: 2;
}
.brochure-range-slider input[type=range] {
    position: absolute;
    -webkit-appearance: none;
    width: 100%;
    height: 5px;
    background: none;
    pointer-events: none;
    top: -8px;
    margin: 0;
    z-index: 3;
}
.brochure-range-slider input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    pointer-events: all;
    width: 20px;
    height: 20px;
    background-color: #aa8a4b;
    border-radius: 50%;
    cursor: pointer;
}
.brochure-range-slider input[type=range]::-moz-range-thumb {
    -webkit-appearance: none;
    pointer-events: all;
    width: 20px;
    height: 20px;
    background-color: #aa8a4b;
    border-radius: 50%;
    cursor: pointer;
    border: none;
}

