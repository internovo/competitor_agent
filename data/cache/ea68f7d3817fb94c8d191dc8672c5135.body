<script type="rocketlazyloadscript">
document.querySelectorAll('#showAmenitiesBtn').forEach(button => {
    button.addEventListener('click', function() {
        const extraAmenities = this.closest('.resident').querySelectorAll('.extra-amenities');
        extraAmenities.forEach(amenity => {
            amenity.classList.remove('hidden');
        });
        this.remove();
    });
});
</script>
<script type="rocketlazyloadscript">
$(document).ready(function() {
    // Handle click event on list items
    $('.ongoingLoc li p').on('click', function() {
        var location = $(this).data('location');
        var transformValue = $(this).data('transform'); // Get the translate value

        // Reset all paths to their original size and color
        $('svg .mapLocation path').attr('fill', 'white').attr('transform', 'scale(1) translate(0, 0)');

        // Find the corresponding path and update its fill color and size
        $('svg .mapLocation[data-location="' + location + '"] path')
            .attr('fill', '#AA8A4B') // Change to the desired color
            .attr('transform', 'scale(1.3) ' + transformValue); // Increase size and set position
    });
});
</script>
<script type="rocketlazyloadscript">
function filterPosts() {
    const selectedYear = document.getElementById('yearFilter').value;
    const currentPage = new URLSearchParams(window.location.search).get('paged') || 1;

    fetch(`https://runwalrealty.com/wp-admin/admin-ajax.php?action=filter_posts&year=${selectedYear}&paged=${currentPage}`)
        .then(response => response.json())
        .then(data => {
            document.getElementById('postContainer').innerHTML = data.posts;
            document.getElementById('paginationContainer').innerHTML = data.pagination;
        })
        .catch(error => console.error('Error fetching posts:', error));
}

// Year Filter Event Listener
document.getElementById('yearFilter').addEventListener('change', filterPosts);

// Pagination Click Event Listener
document.getElementById('paginationContainer').addEventListener('click', function(e) {
    if (e.target.tagName === 'A') {
        e.preventDefault();
        const selectedYear = document.getElementById('yearFilter').value;
        const pageLink = new URL(e.target.href);
        const currentPage = pageLink.searchParams.get('paged') || 1;

        fetch(
                `https://runwalrealty.com/wp-admin/admin-ajax.php?action=filter_posts&year=${selectedYear}&paged=${currentPage}`
            )
            .then(response => response.json())
            .then(data => {
                document.getElementById('postContainer').innerHTML = data.posts;
                document.getElementById('paginationContainer').innerHTML = data.pagination;
            })
            .catch(error => console.error('Error fetching posts:', error));
    }
});
</script>

<script type="rocketlazyloadscript">
document.addEventListener('DOMContentLoaded', function() {
    const bhkFilter = document.getElementById('bhkFilter');
    const locationFilter = document.getElementById('locationFilter');
    const posts = document.querySelectorAll('.residentGrid');

    function filterPosts() {
        const selectedBHK = bhkFilter.value;
        const selectedLocation = locationFilter.value;

        posts.forEach(post => {
            const bhkData = post.getAttribute('data-bhk').split(',');
            const locationData = post.getAttribute('data-location').split(',');
            const showBHK = !selectedBHK || bhkData.includes(selectedBHK);
            const showLocation = !selectedLocation || locationData.includes(selectedLocation);

            if (showBHK && showLocation) {
                post.style.display = 'flex';
            } else {
                post.style.display = 'none';
            }
        });
    }

    bhkFilter.addEventListener('change', filterPosts);
    locationFilter.addEventListener('change', filterPosts);
});
</script>



<!----upcoming -->
<script type="rocketlazyloadscript">
document.addEventListener('DOMContentLoaded', function() {
    const bhkFilter = document.getElementById('bhkFilter');
    const locationFilter = document.getElementById('locationFilter');
    const postsContainer = document.getElementById('upcomingPostsContainer');

    function loadFilteredPosts(page = 1) {
        const selectedBHK = bhkFilter.value;
        const selectedLocation = locationFilter.value;

        // AJAX request to the PHP handler
        const data = new FormData();
        data.append('action', 'load_filtered_posts');
        data.append('page', page);
        data.append('bhk', selectedBHK);
        data.append('location', selectedLocation);

        fetch('https://runwalrealty.com/wp-admin/admin-ajax.php', {
                method: 'POST',
                body: data
            })
            .then(response => response.text())
            .then(html => {
                postsContainer.innerHTML = html;

                // Reattach pagination events after new posts are loaded
                attachPaginationEvents();
            });
    }

    // Attach events to filter changes
    bhkFilter.addEventListener('change', () => loadFilteredPosts(1));
    locationFilter.addEventListener('change', () => loadFilteredPosts(1));

    // Attach pagination events to load specific pages
    function attachPaginationEvents() {
        document.querySelectorAll('.pagination a').forEach(link => {
            link.addEventListener('click', function(event) {
                event.preventDefault();
                const page = new URL(this.href).searchParams.get('paged') || 1;
                loadFilteredPosts(page);
            });
        });
    }

    // Initial pagination event attachment
    attachPaginationEvents();
});
</script>
<script type="rocketlazyloadscript">
document.addEventListener("DOMContentLoaded", function() {
    const projectFilter = document.getElementById("projectFilter");
    const eventsContainer = document.getElementById("eventsContainer");
    const eventItems = eventsContainer.querySelectorAll(".event-item");

    projectFilter.addEventListener("change", function() {
        const selectedProject = projectFilter.value;

        eventItems.forEach(item => {
            const projects = item.getAttribute("data-project").split(',');

            if (selectedProject === "" || projects.includes(selectedProject)) {
                item.style.display = "block";
            } else {
                item.style.display = "none";
            }
        });
    });
});
</script>
<script type="rocketlazyloadscript">
jQuery(document).ready(function($) {
    $('#vyearFilters').change(function() {
        const selectedYear = $(this).val();
        const paged = 1;

        $.ajax({
            url: 'https://runwalrealty.com/wp-admin/admin-ajax.php',
            type: 'POST',
            data: {
                action: 'filter_video_coverage',
                year: selectedYear,
                paged: paged
            },
            beforeSend: function() {
                $('#postContainer').html('<p>Loading...</p>');
            },
            success: function(response) {
                $('#postContainer').html(response);
            }
        });
    });
});
</script>
<script type="rocketlazyloadscript">
document.addEventListener('DOMContentLoaded', function() {

    document.getElementById('projectFilters').addEventListener('change', function() {
        var selectedProject = this.value;
        var awardItems = document.querySelectorAll('.award-item');


        awardItems.forEach(function(item) {
            var itemProjects = item.getAttribute('data-project');
            if (selectedProject === "" || itemProjects.includes(selectedProject)) {
                item.classList.remove('hidden');
            } else {
                item.classList.add('hidden');
            }
        });
    });
});
</script>
<script type="rocketlazyloadscript">
document.addEventListener('DOMContentLoaded', function() {
    const eventItems = document.querySelectorAll('.event-item');
    const popupModal = document.getElementById('popupModal');
    const popupTitle = document.getElementById('popupTitle');
    const galleryContainer = document.getElementById('galleryContainer');
    const popupHeading = document.getElementById('popupHeading');
    const closeBtn = document.querySelector('.close-btn');

    eventItems.forEach(item => {
        item.addEventListener('click', () => {
            const title = item.getAttribute('data-title');
            const gallery = JSON.parse(item.getAttribute('data-gallery'));
            const heading = item.querySelector('.text-center').textContent;

            // Update modal content
            popupTitle.textContent = title;
            popupHeading.textContent = heading;
            galleryContainer.innerHTML = ''; // Clear previous gallery images

            if (gallery && gallery.length > 0) {
                gallery.forEach(image => {
                    const imgElement = document.createElement('img');
                    imgElement.src = image.gallery_images;
                    imgElement.alt = title;
                    imgElement.style.width = '100%';
                    galleryContainer.appendChild(imgElement);
                });
            } else {
                galleryContainer.innerHTML = '<p>No images available.</p>';
            }

            // Show modal
            popupModal.classList.remove('hidden');
        });
    });

    closeBtn.addEventListener('click', () => {
        popupModal.classList.add('hidden');
    });
});

//form 
document.querySelectorAll("form").forEach(function(form) {
    form.addEventListener("submit", function(e) {
        let captcha = form.querySelector("[name='g-recaptcha-response']");
        let errorBox = form.querySelector(".captcha-error");

        if (!errorBox) {
            errorBox = document.createElement("div");
            errorBox.className = "captcha-error";
            errorBox.style.color = "red";
            captcha.parentNode.appendChild(errorBox);
        }

        if (!captcha || captcha.value === "") {
            e.preventDefault(); // stop form submit
            errorBox.innerHTML = "⚠️ Please complete the reCAPTCHA.";
        } else {
            errorBox.innerHTML = ""; // clear error
        }
    });
});

</script>

