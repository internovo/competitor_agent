            document.addEventListener("DOMContentLoaded", function() {

            document.querySelectorAll('.categoryList.Specification2 li').forEach((tab) => {
    tab.addEventListener('click', function (event) {
        event.preventDefault(); // Prevent any default behavior like scrolling

        const target = this.getAttribute('data-target');

        // Remove 'active' class from all tabs
        document.querySelectorAll('.categoryList.Specification2 li').forEach((item) => item.classList.remove('active'));

        // Add 'active' class to the clicked tab
        this.classList.add('active');

        // Hide all tab panels
        document.querySelectorAll('.resident[role="tabpanel"]').forEach((panel) => panel.classList.add('hidden'));

        // Show the corresponding panel
        const activePanel = document.getElementById(target);
        if (activePanel) {
            activePanel.classList.remove('hidden');
            activePanel.classList.add('active');
        }
    });
});
});


//  $('.categoryList li').click(function () {       
