<script type="rocketlazyloadscript" id="jquery-migrate-js" data-rocket-src="https://runwalrealty.com/wp-includes/js/jquery/jquery-migrate.min.js?ver=3.4.1"></script>
<script type="rocketlazyloadscript" id="jquery-js-after">
jQuery(document).ready(function($) {
            $(".toggleVlm").on("click", function () {
                const isMobile = window.innerWidth <= 768;
                const videoDesktop = document.getElementById("myVideoDesktop");
                const videoMobile = document.getElementById("myVideoMobile");

                const video = isMobile ? videoMobile : videoDesktop;

                // Pause the video not in view
                if (isMobile) {
                    videoDesktop.pause();
                } else {
                    videoMobile.pause();
                }

                // Toggle mute
                const isMuted = video.muted;
                video.muted = !isMuted;

                // Update icon
                if (!isMuted) {
                    $(this).html("<i class='fa fa-volume-mute'></i>");
                } else {
                    $(this).html("<i class='fa fa-volume-up'></i>");
                }

                // Force video to continue playing
                video.setAttribute("playsinline", "true");
                video.setAttribute("preload", "auto");
                const playPromise = video.play();
                if (playPromise !== undefined) {
                    playPromise.catch((error) => {
                        console.warn("Video play failed:", error);
                    });
                }
            });
        });
    
//# sourceURL=jquery-js-after
</script>
