                var target = $(this).val();

                // Hide all sliders and show selected
                $('.developmentSlider').hide();
                $('.developmentSlider.' + target).show();

                // Update Swiper if using Swiper
                $('.developmentSlider.' + target + ' .swiper').each(function () {
                    if ($(this)[0].swiper) $(this)[0].swiper.update();
                });

                // Optional: Update desktop tabs active state
                $('.galleryList li').removeClass('active');
                $('.galleryList li[data-target="' + target + '"]').addClass('active');
            });

