<!-- JavaScript for Show/Hide Functionality -->
<script type="rocketlazyloadscript">
    document.querySelectorAll('.show-amenities-btn').forEach(button => {
        button.addEventListener('click', function() {
            const residentSection = this.closest('.resident');
            const extraAmenitiesSection = residentSection.querySelector('.extra-amenities-section');
            if (extraAmenitiesSection.classList.contains('hidden')) {
                extraAmenitiesSection.classList.remove('hidden');
                this.textContent = "Show Less Amenities"; // Update button text
            } else {
                extraAmenitiesSection.classList.add('hidden');
                this.textContent = "Show More Amenities"; // Update button text
            }
        });
    });
</script>

