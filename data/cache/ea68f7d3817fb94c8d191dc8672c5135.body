$(document).ready(function () {
    // Open modal on button click
    $('.popupform').click(function (event) {
        event.preventDefault();
        const targetModal = $(this).data('target'); // Get the target modal from data attribute
        $(targetModal).removeClass('hidden').addClass('modal-opened').fadeIn(); // Show the modal and add class
    });

    // Close modal on close button click
    $(document).on('click', '.close-btn', function () {
        $(this).closest('.modal').fadeOut(function() {
            $(this).addClass('hidden').removeClass('modal-opened'); // Hide and remove class
        });
    });

    // Close modal on clicking outside the modal content
    $(window).click(function (event) {
        $('.modal').each(function () {
            if ($(event.target).is(this)) {
                $(this).fadeOut(function() {
                    $(this).addClass('hidden').removeClass('modal-opened'); // Hide and remove class
                });
            }
        });
    });
});

//

document.addEventListener("DOMContentLoaded", function() {
    const form = document.getElementById("brochureForm");
    const submitBtn = document.getElementById("submitBtn");
    const pleaseWaitMessage = document.getElementById("pleaseWaitMessage");
    const pdfLink = "https://runwalrealty.com/wp-content/uploads/2025/04/TCP_Brochure-13Feb26_Low.pdf"; // PDF URL from PHP
    const popupModal = document.getElementById("popupModal");
    const closeBtn = document.querySelector(".close-btn");
    const thankYouMessage = document.createElement("p");

    // Set up the Thank You message
    thankYouMessage.classList.add("thank-you-message");
    thankYouMessage.textContent = "Thank you for submitting the form!";
    thankYouMessage.style.display = "none"; // Hidden initially
    form.parentNode.appendChild(thankYouMessage);

    form.addEventListener("submit", function(event) {
        event.preventDefault(); // Prevent default form submission

        // Show the "Please Wait" message and disable the submit button
        pleaseWaitMessage.style.display = "block";
        submitBtn.disabled = true;

        // Collect form data and use fetch to send it
        fetch(form.action, {
            method: form.method,
            body: new FormData(form)
        })
        .then(response => response.text())
        .then(data => {
            // Check if the response indicates success
            if (data.includes("success")) {
                // Open the PDF in a new window
                window.open(pdfLink, "_blank");

                // Show the Thank You message
                thankYouMessage.style.display = "block";

                // Reset the form and hide the popup modal
                form.reset();
                popupModal.classList.add("hidden");

                // Hide the "Please Wait" message and re-enable the submit button
                pleaseWaitMessage.style.display = "none";
                submitBtn.disabled = false;

                // Hide the Thank You message after 3 seconds
                setTimeout(() => {
                    thankYouMessage.style.display = "none";
                }, 3000); // 3 seconds
            } else {
                alert("Form submission failed. Please try again.");
                pleaseWaitMessage.style.display = "none";
                submitBtn.disabled = false;
            }
        })
        .catch(error => {
            console.error("Error:", error);
            alert("An error occurred. Please try again.");
            pleaseWaitMessage.style.display = "none";
            submitBtn.disabled = false;
        });
    });

    // Close the popup modal when the close button is clicked
    closeBtn.addEventListener("click", function() {
        popupModal.classList.add("hidden");
    });
});



</script>
