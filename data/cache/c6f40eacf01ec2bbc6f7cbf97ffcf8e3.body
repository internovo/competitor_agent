      <style>
         body { background:#f9f9fa; }
         .hide-search-icon { display:none!important; }
         /* ===== NEW HEADER ===== */
         #rg-header {
           position:fixed; top:0; left:0; right:0; z-index:9999;
           background:#000000; color:#ffffff;
           height:64px; display:flex; align-items:center;
         }
         #rg-header .rg-hdr-inner {
           display:flex; align-items:center; gap:16px;
           padding-top:0; padding-bottom:0;
         }
         /* Logo */
         .rg-logo { flex-shrink:0; display:flex; align-items:center; text-decoration:none; }
         .rg-logo img { height:40px; width:auto; display:block; }
         /* City Picker */
         /* City Picker */
         .rg-city-picker { position:relative; flex-shrink:0; }
         .rg-city-btn {
           display:flex; align-items:center; gap:7px;
           border:1.5px solid #fff; border-radius:8px;
           padding:7px 14px; background:transparent; cursor:pointer;
           font-size:14px; font-weight:500; color:#fff;
           transition:border-color .2s, color .2s; white-space:nowrap;
         }
         .rg-city-btn:hover { border-color:#FFD000; color:#FFD000; }
         .rg-city-btn .rg-cicon { font-size:11px; color:#fff; transition:transform .2s; }
         .rg-city-picker.open .rg-city-btn .rg-cicon { transform:rotate(180deg); }
         /* Dropdown panel */
         .rg-city-drop {
           position:absolute; top:calc(100% + 8px); left:0;
           background:#fff; border:1px solid #e8e8e8; border-radius:12px;
           box-shadow:0 12px 40px rgba(0,0,0,0.14);
           width:430px; display:none; z-index:200;
           overflow:hidden;
         }
         .rg-city-picker.open .rg-city-drop { display:block; }
         /* Search bar */
         .rgcd-search {
           display:flex; align-items:center; gap:10px;
           padding:12px 16px; border-bottom:1px solid #f0f0f0;
           background:#f7f8fa;
         }
         .rgcd-search i { color:#999; font-size:14px; flex-shrink:0; }
         .rgcd-search input {
           border:none; background:none; outline:none; width:100%;
           font-size:14px; color:#333;
         }
         .rgcd-search input::placeholder { color:#aaa; }
         /* Actions row */
         .rgcd-actions {
           display:flex; align-items:center; justify-content:space-between;
           padding:10px 16px; border-bottom:1px solid #f0f0f0;
         }
         .rgcd-detect {
           background:none; border:none; cursor:pointer; padding:0;
           font-size:13px; font-weight:600; color:#333;
           display:flex; align-items:center; gap:7px;
         }
         .rgcd-detect:hover { color:#FFD000; }
         .rgcd-detect i { font-size:12px; }
         .rgcd-reset {
           font-size:13px; font-weight:600; color:#555;
           text-decoration:none; transition:color .15s;
         }
         .rgcd-reset:hover { color:#FFD000; }
         /* Section labels */
         .rgcd-section-title {
           font-size:12px; font-weight:700; color:#333;
           padding:12px 16px 8px; background:#f7f8fa;
           border-bottom:1px solid #f0f0f0;
         }
         /* Top cities grid */
         .rgcd-top-grid {
           display:grid; grid-template-columns:repeat(4,1fr);
           padding:8px; gap:2px;
         }
         .rgcd-city-card {
           display:flex; flex-direction:column; align-items:center;
           gap:6px; padding:10px 6px; border-radius:8px;
           text-decoration:none; color:#333; cursor:pointer;
           transition:background .15s; border:1.5px solid transparent;
         }
         .rgcd-city-card:hover { background:#fff8f0; color:#FFD000; }
         .rgcd-city-card.active { border-color:#FFD000; color:#FFD000; background:#fff8f0; }
         .rgcd-city-icon { width:48px; height:48px; color:#555; }
         .rgcd-city-card.active .rgcd-city-icon { color:#FFD000; }
         .rgcd-city-icon svg { width:100%; height:100%; }
         .rgcd-city-card span { font-size:11px; font-weight:600; text-align:center; line-height:1.2; }
         /* Other cities list */
         .rgcd-other-list {
           max-height:200px; overflow-y:auto; padding:4px 0;
           border-top:1px solid #f0f0f0;
         }
         .rgcd-other-list::-webkit-scrollbar { width:4px; }
         .rgcd-other-list::-webkit-scrollbar-thumb { background:#ddd; border-radius:4px; }
         .rgcd-other-item {
           display:block; padding:10px 16px; font-size:13px; color:#444;
           text-decoration:none; border-bottom:1px solid #f7f7f7;
           transition:background .12s;
         }
         .rgcd-other-item:hover { background:#fff8f0; color:#FFD000; }
         .rgcd-other-item.active { color:#FFD000; font-weight:700; }
         .rgcd-other-item.rg-hidden { display:none; }
         .rgcd-city-card.rg-hidden { display:none; }
         /* Mobile adjustments */
         @media(max-width:480px){
           .rg-city-drop { width:calc(100vw - 20px); left:-10px; }
           .rgcd-top-grid { grid-template-columns:repeat(3,1fr); }
         }
         /* Nav */
         .rg-nav { flex:1; display:flex; align-items:center; justify-content:center; gap:2px; }
         .rg-nav-item { position:relative; }
         .rg-nav-icon { display:none; } /* icons hidden on desktop */
         .rg-nav-link {
           display:flex; align-items:center; gap:5px;
           padding:8px 12px; border-radius:6px; font-size:12px;
           font-weight:500; color:#fff; text-decoration:none;
           cursor:pointer; white-space:nowrap; background:none; border:none;
           transition:color .2s;
         }
         .rg-nav-link:hover, .rg-nav-link.active { color:#FFD000; background:transparent; }
         .rg-nav-link i { font-size:10px; color:rgba(255,255,255,0.65); transition:transform .2s; }
         .rg-nav-item:hover .rg-nav-link i { transform:rotate(180deg); color:#FFD000; }
         /* Dropdown */
         .rg-drop {
           position:absolute; top:calc(100% + 6px); left:50%; transform:translateX(-50%);
           background:#fff; border:1px solid #eee; border-radius:10px;
           box-shadow:0 8px 32px rgba(0,0,0,0.12);
           padding:8px 0; min-width:200px; display:none; z-index:100;
         }
         .rg-drop::before {
           content:''; position:absolute; bottom:100%; left:-20px; right:-20px; height:10px;
         }
         .rg-nav-item:hover .rg-drop,
         .rg-nav-item.open .rg-drop { display:block; }
         .rg-drop a {
           display:block; padding:9px 18px; font-size:13px; color:#444;
           text-decoration:none; transition:background .15s;
         }
         .rg-drop a:hover { background:#fff8f0; color:#FFD000; }
         /* Mega Menu */
         .rg-mega {
           position:absolute; top:calc(100% + 6px); left:50%; transform:translateX(-50%);
           background:#fff; border:1px solid #eee; border-radius:12px;
           box-shadow:0 12px 40px rgba(0,0,0,0.14);
           padding:20px 24px; display:none; z-index:100;
           width:740px;
         }
         .rg-mega::before {
           content:''; position:absolute; bottom:100%; left:-40px; right:-40px; height:10px;
         }
         .rg-nav-item:hover .rg-mega,
         .rg-nav-item.open .rg-mega { display:flex; gap:24px; }
         .rg-mega-col { flex:1; min-width:140px; }
         .rg-mega-col--city { flex:1.7; min-width:220px; }
         .rg-mega-col--selected-city { flex:1.6; min-width:230px; }
         .rg-mega-col--selected-city a { white-space:normal; line-height:1.3; }
         .rg-mega-col-title {
           font-size:11px; font-weight:700; color:#999; text-transform:uppercase;
           letter-spacing:.8px; margin-bottom:10px; padding-bottom:6px;
           border-bottom:1px solid #f0f0f0;
         }
         .rg-mega-col a {
           display:flex; align-items:center; gap:8px;
           padding:7px 6px; font-size:13px; color:#444;
           text-decoration:none; border-radius:6px; transition:all .15s;
           white-space:nowrap;
         }
         .rg-mega-col a:hover { background:#fff8f0; color:#FFD000; padding-left:10px; }
         .rg-mega-col a i { font-size:10px; color:#FFD000; width:12px; }
         .rg-mega-col-list {
           max-height:370px; overflow-y:auto;
           scrollbar-width:thin; scrollbar-color:transparent transparent;
         }
         .rg-mega-col-list.rg-scrolling { scrollbar-color:#ccc transparent; }
         .rg-mega-col-list::-webkit-scrollbar { width:6px; }
         .rg-mega-col-list::-webkit-scrollbar-track { background:transparent; }
         .rg-mega-col-list::-webkit-scrollbar-thumb { background:transparent; border-radius:3px; }
         .rg-mega-col-list.rg-scrolling::-webkit-scrollbar-thumb { background:#ccc; }
         /* CTA Buttons */
         .rg-hdr-ctas { display:flex; align-items:center; gap:10px; flex-shrink:0; }
         .rg-btn-consult {
           background:transparent; color:#fff; border:none;
           padding:8px 4px; font-size:14px; font-weight:500; cursor:pointer;
           text-decoration:none; white-space:nowrap; transition:color .2s;
         }
         .rg-btn-consult:hover { color:#FFD000; }
         .rg-btn-signin {
           background:transparent; color:#fff; border:1.5px solid #fff; border-radius:6px;
           padding:8px 20px; font-size:14px; font-weight:600; cursor:pointer;
           text-decoration:none; white-space:nowrap; transition:all .2s;
         }
         .rg-btn-signin:hover { border-color:#FFD000; color:#FFD000; }
         /* Logged-in user menu */
         .rg-user-menu { position:relative; display:inline-flex; align-items:center; }
         .rg-user-trigger {
           display:inline-flex; align-items:center; gap:7px; background:transparent;
           border:1.5px solid rgba(255,255,255,.35); border-radius:8px;
           padding:6px 12px; color:#fff; font-size:13px; font-weight:600; cursor:pointer;
           transition:border-color .2s;
         }
         .rg-user-trigger:hover { border-color:#FFD000; }
         .rg-user-avatar {
           width:26px; height:26px; border-radius:50%; background:#FFD000;
           color:#1a1a2e; font-size:12px; font-weight:700;
           display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;
         }
         .rg-user-name { max-width:90px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
         .rg-user-chev { font-size:10px; transition:transform .2s; }
         .rg-user-menu.open .rg-user-chev { transform:rotate(180deg); }
         .rg-user-dropdown {
           display:none; position:absolute; top:calc(100% + 8px); right:0;
           background:#fff; border-radius:10px; box-shadow:0 4px 24px rgba(0,0,0,.16);
           min-width:170px; z-index:9999; overflow:hidden;
           animation:rgDdFade .15s ease;
         }
         @keyframes rgDdFade { from{opacity:0;transform:translateY(-6px)} to{opacity:1;transform:translateY(0)} }
         .rg-user-menu.open .rg-user-dropdown { display:block; }
         .rg-user-dd-item {
           display:flex; align-items:center; gap:9px; padding:12px 16px;
           color:#1a1a2e; text-decoration:none; font-size:13px; font-weight:600;
           transition:background .15s;
         }
         .rg-user-dd-item:hover { background:#f5f5f5; }
         .rg-user-dd-item i { width:14px; text-align:center; color:#888; }
         .rg-user-dd-signout { border-top:1px solid #f0f0f0; color:#e53935; }
         .rg-user-dd-signout i { color:#e53935; }
         /* Sign-In Modal */
         .rg-signin-overlay {
           display:none; position:fixed; inset:0; background:rgba(0,0,0,.55);
           z-index:99999; align-items:center; justify-content:center;
         }
         .rg-signin-overlay.open { display:flex; }
         .rg-signin-modal {
           background:#fff; border-radius:14px; padding:36px 32px 28px;
           width:100%; max-width:420px; position:relative; box-shadow:0 8px 40px rgba(0,0,0,.22);
           animation:rgsiSlideUp .25s ease;
         }
         @keyframes rgsiSlideUp { from{transform:translateY(30px);opacity:0} to{transform:translateY(0);opacity:1} }
         .rg-signin-modal .rgsi-icon { text-align:center; margin-bottom:10px; }
         .rg-signin-modal .rgsi-icon img { width:56px; height:56px; object-fit:contain; }
         .rg-signin-modal span#rgsiTitle { display:block; text-align:center; font-size:20px; font-weight:700; color:#1a1a2e; margin:0 0 4px; }
         .rg-signin-modal p.rgsi-sub { text-align:center; color:#888; font-size:13px; margin:0 0 22px; }
         .rg-signin-modal .rgsi-field { margin-bottom:16px; }
         .rg-signin-modal .rgsi-field label { display:block; font-size:12px; font-weight:600; color:#555; margin-bottom:5px; }
         .rg-signin-modal .rgsi-field input {
           width:100%; padding:11px 14px; border:1.5px solid #ddd; border-radius:8px;
           font-size:14px; outline:none; transition:border-color .2s; box-sizing:border-box;
         }
         .rg-signin-modal .rgsi-field input:focus { border-color:#1a1a2e; }
         .rg-signin-modal .rgsi-submit {
           width:100%; padding:13px; background:#1a1a2e; color:#fff; border:none;
           border-radius:8px; font-size:15px; font-weight:700; cursor:pointer;
           transition:background .2s; margin-top:4px;
         }
         .rg-signin-modal .rgsi-submit:hover { background:#FFD000; color:#1a1a2e; }
         .rg-signin-modal .rgsi-submit:disabled { opacity:.6; cursor:not-allowed; }
         .rg-signin-modal .rgsi-close {
           position:absolute; top:14px; right:16px; background:none; border:none;
           font-size:22px; color:#999; cursor:pointer; line-height:1; padding:0;
         }
         .rg-signin-modal .rgsi-close:hover { color:#333; }
         .rg-signin-modal .rgsi-msg { text-align:center; font-size:13px; margin-top:10px; min-height:18px; }
         .rg-signin-modal .rgsi-msg.err { color:#e53935; }
         .rg-signin-modal .rgsi-msg.ok  { color:#2e7d32; }
         /* Buy Together split button */
         .rg-tb-btn {
           display:inline-flex; align-items:center;
           background:transparent; border-radius:6px;
           border:1.5px solid #FFD000; text-decoration:none;
           overflow:hidden; transition:opacity .2s;
           flex-shrink:0;
         }
         .rg-tb-btn:hover { opacity:.85; }
         .rg-tb-label {
           padding:7px 14px;
           font-size:13px; font-weight:700;
           color:#FFD000; white-space:nowrap;
           letter-spacing:.2px;
         }
         .rg-tb-badge {
           background:#FFD000; color:#1a1a1a;
           padding:4px 12px;
           font-size:9px; font-weight:900;
           text-transform:uppercase; letter-spacing:.5px;
           line-height:1.4; text-align:center;
           white-space:nowrap;
         }
         /* Desktop: show Buy Together in CTAs, hide from nav */
         .rg-tb-mob-item { display:none; }
         .rg-tb-desk { display:inline-flex; }
         /* Mobile burger */
         .rg-burger { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:6px 4px; }
         .rg-burger span { display:block; width:24px; height:2px; background:#fff; border-radius:2px; transition:all .3s; }
         /* Body offset for fixed header */
         body { padding-top:64px; }

         /* ── Mobile city row (hidden on desktop) ── */
         .rg-mob-city-row { display:none; }

         /* ── Mobile ── */
         @media(max-width:991px){
           html, body { overflow-x:hidden; max-width:100%; }
           /* Header becomes two-row on mobile */
           #rg-header { height:auto; flex-direction:column; align-items:stretch; }
           #rg-header .rg-hdr-inner { height:56px; padding:0 16px; justify-content:space-between; }
           body { padding-top:54px; }

           /* Row 1: hide city picker & nav from inner row */
           .rg-city-picker { display:none; }
           .rg-nav { display:none; }
           .rg-hdr-ctas .rg-btn-signin,
           .rg-hdr-ctas .rg-btn-consult { display:none; }
           .rg-hdr-ctas .rg-tb-btn { display:none; }
           .rg-burger { display:flex; }

           /* Row 2: mobile city bar */
           .rg-mob-city-row {
             display:block;
             background:#1c1c1e;
             border-top:1px solid rgba(255,255,255,0.07);
           }
           .rg-mob-city-btn {
             display:flex; align-items:center; gap:10px;
             width:100%; padding:12px 16px;
             background:none; border:none; cursor:pointer;
             color:rgba(255,255,255,0.88); font-size:15px; font-weight:500;
             text-align:left;
           }
           .rg-mob-city-btn i.rg-mob-loc { color:rgba(255,255,255,0.45); font-size:16px; }
           .rg-mob-city-btn i.rg-mob-chev { margin-left:auto; color:rgba(255,255,255,0.55); font-size:13px; transition:transform .2s; }
           .rg-mob-city-row.open .rg-mob-city-btn i.rg-mob-chev { transform:rotate(180deg); }

           /* City dropdown on mobile — full width, fixed */
           .rg-mob-city-drop {
             display:none;
             position:fixed; top:54px; left:0; right:0;
             background:#fff; z-index:9997;
             max-height:calc(100vh - 54px); overflow-y:auto;
             border-top:2px solid #FFD000;
             box-shadow:0 8px 32px rgba(0,0,0,0.18);
           }
           .rg-mob-city-row.open .rg-mob-city-drop { display:block; }

           /* ── Full-screen mobile nav ── */
           .rg-nav.open {
             display:flex; flex-direction:column; align-items:stretch; justify-content:flex-start;
             position:fixed; top:54px; left:0; right:0; bottom:0;
             background:#fff; padding:0; gap:0;
             overflow-y:auto; z-index:9996;
             border-top:3px solid #FFD000;
           }
           .rg-nav.open .rg-nav-item {
             width:100%;
             border-bottom:1px solid #ececec;
           }
           /* Nav link row */
           .rg-nav.open .rg-nav-link {
             display:flex; align-items:center; gap:14px;
             width:100%; padding:14px 16px;
             border-radius:0; color:#1a1a1a; font-size:15px; font-weight:500;
             border-bottom:none; background:none;
           }
           .rg-nav.open .rg-nav-link:hover { background:#fafafa; color:#1a1a1a; }
           /* Icon box */
           .rg-nav-icon {
             display:none; /* hidden on desktop */
           }
           .rg-nav.open .rg-nav-icon {
             display:flex; align-items:center; justify-content:center;
             width:38px; height:38px; flex-shrink:0;
             border:1.5px solid #ddd; border-radius:8px;
           }
           .rg-nav.open .rg-nav-icon svg {
             width:20px; height:20px; stroke:#444; flex-shrink:0;
           }
           /* Desktop: show down chevron; Mobile: show right arrow via ::after */
           .rg-desk-chev { font-size:11px; color:#fff; transition:transform .2s; }
           .rg-nav.open .rg-desk-chev { display:none; }
           @media(max-width:991px){
             .rg-nav.open .rg-nav-link::after {
               content:'\f054';
               font-family:'Font Awesome 6 Free';
               font-weight:900;
               margin-left:auto;
               color:#bbb;
               font-size:13px;
               flex-shrink:0;
             }
             .rg-nav.open .rg-nav-item.mob-open .rg-nav-link::after { transform:rotate(90deg); display:inline-block; }
           }
           /* Sub-menus: hidden by default, shown when item is mob-open */
           .rg-nav.open .rg-drop,
           .rg-nav.open .rg-mega {
             display:none !important;
             position:static; transform:none; box-shadow:none;
             border:none; border-top:1px solid #f5f5f5;
             padding:0; width:auto; min-width:unset;
             background:#f9f9f9; border-radius:0;
           }
           .rg-nav.open .rg-nav-item.mob-open .rg-drop,
           .rg-nav.open .rg-nav-item.mob-open .rg-mega { display:block !important; }
           .rg-nav.open .rg-mega { flex-direction:column !important; gap:0 !important; }
           .rg-nav.open .rg-mega-col { padding:8px 0; }
           .rg-nav.open .rg-mega-col-title { padding:8px 16px; font-size:11px; }
           .rg-nav.open .rg-mega-col a,
           .rg-nav.open .rg-drop a {
             padding:10px 16px 10px 20px; font-size:14px; color:#444;
             border-bottom:1px solid #f0f0f0;
           }
           .rg-nav.open .rg-mega-col a:hover,
           .rg-nav.open .rg-drop a:hover { background:#fff8f0; color:#FFD000; padding-left:24px; }
           .rg-nav.open .rg-mega-col-list { max-height:none; overflow-y:visible; }
           /* Buy Together on mobile: show in nav, hide desktop CTA version */
           .rg-tb-mob-item { display:block; }
           .rg-tb-desk { display:none !important; }
           .rg-nav-link--tb {
             background:none !important; border:none !important;
             border-radius:0 !important; padding:14px 16px !important;
           }
           .rg-tb-mob-badge {
             display:none;
             font-size:10px; font-weight:700; color:#FFD000;
             margin-left:auto; text-transform:uppercase; letter-spacing:.3px;
           }
           .rg-nav.open .rg-tb-mob-badge { display:block; }
           .rg-nav.open .rg-nav-link--tb .rg-tb-label { display:none; }
           .rg-nav.open .rg-nav-link--tb .rg-tb-badge { display:none; }
           /* Show nav icons on mobile */
           .rg-nav-icon { display:inline-flex; }
         }
         @media(max-width:480px){
           .rg-logo img { height:34px; }
         }
         /* Slide-in animation */
         @keyframes rg-fadedown { from{opacity:0;transform:translateY(-6px)} to{opacity:1;transform:translateY(0)} }
         .rg-city-picker.open .rg-city-drop,
         .rg-nav-item:hover .rg-drop,
         .rg-nav-item:hover .rg-mega { animation:rg-fadedown .18s ease; }
      </style>
