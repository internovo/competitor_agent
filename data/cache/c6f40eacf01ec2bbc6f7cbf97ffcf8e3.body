      <script>
      /* ---- City Picker ---- */
      function rgToggleCity(e){
        e.stopPropagation();
        var p = document.getElementById('rgCityPicker');
        var wasOpen = p.classList.contains('open');
        p.classList.toggle('open');
        if(!wasOpen){ document.getElementById('rgCitySearch').focus(); }
      }
      document.addEventListener('click', function(e){
        var picker = document.getElementById('rgCityPicker');
        if(picker && !picker.contains(e.target)){
          picker.classList.remove('open');
          var s = document.getElementById('rgCitySearch');
          if(s){ s.value=''; rgFilterCities(''); }
        }
      });
      function rgFilterCities(q){
        q = q.toLowerCase().trim();
        var cards   = document.querySelectorAll('.rgcd-city-card');
        var items   = document.querySelectorAll('.rgcd-other-item');
        var topLabel   = document.getElementById('rgTopLabel');
        var otherLabel = document.getElementById('rgOtherLabel');
        var topGrid    = document.getElementById('rgTopGrid');
        var visTop=0, visOther=0;
        cards.forEach(function(c){
          var match = !q || c.dataset.name.indexOf(q) > -1;
          c.classList.toggle('rg-hidden', !match);
          if(match) visTop++;
        });
        items.forEach(function(a){
          var match = !q || a.dataset.name.indexOf(q) > -1;
          a.classList.toggle('rg-hidden', !match);
          if(match) visOther++;
        });
        if(topLabel)   topLabel.style.display   = visTop   ? '' : 'none';
        if(topGrid)    topGrid.style.display     = visTop   ? '' : 'none';
        if(otherLabel) otherLabel.style.display  = visOther ? '' : 'none';
      }
      function rgDetectCity(){
        if(!navigator.geolocation){
          alert('Geolocation is not supported by your browser.');
          return;
        }
        var btn = document.querySelector('.rgcd-detect');
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Detecting...';
        btn.disabled = true;
        navigator.geolocation.getCurrentPosition(function(pos){
          var lat = pos.coords.latitude, lon = pos.coords.longitude;
          fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat='+lat+'&lon='+lon)
            .then(function(r){ return r.json(); })
            .then(function(d){
              var city = d.address.city || d.address.town || d.address.village || d.address.county || '';
              if(city){
                document.getElementById('rgCitySearch').value = city;
                rgFilterCities(city);
              }
              btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Detect my location';
              btn.disabled = false;
            })
            .catch(function(){ btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Detect my location'; btn.disabled = false; });
        }, function(){
          alert('Unable to retrieve your location. Please allow location access.');
          btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i> Detect my location';
          btn.disabled = false;
        });
      }
      /* Close nav on outside click (mobile) */
      document.addEventListener('click', function(e){
        var nav = document.getElementById('rgNav');
        var burger = document.getElementById('rgBurger');
        if(nav && burger && !nav.contains(e.target) && !burger.contains(e.target)){
          nav.classList.remove('open');
        }
      });

      /* ---- Mobile city row toggle ---- */
      function rgMobToggleCity(e){
        e.stopPropagation();
        var row = document.getElementById('rgMobCityRow');
        row.classList.toggle('open');
        if(row.classList.contains('open')){
          var inp = document.getElementById('rgMobCitySearch');
          if(inp) setTimeout(function(){ inp.focus(); }, 80);
        }
      }
      document.addEventListener('click', function(e){
        var row = document.getElementById('rgMobCityRow');
        if(row && !row.contains(e.target)){
          row.classList.remove('open');
          var s = document.getElementById('rgMobCitySearch');
          if(s){ s.value=''; }
        }
      });
      /* Burger: close city row when nav opens */
      document.getElementById('rgBurger').addEventListener('click', function(){
        document.getElementById('rgMobCityRow').classList.remove('open');
      });

      /* ── Mobile nav accordion ── */
      function rgMobNavToggle(e, link) {
        var nav = document.getElementById('rgNav');
        if (!nav.classList.contains('open')) return; // desktop: do nothing
        var item = link.closest('.rg-nav-item');
        var hasSub = item.querySelector('.rg-drop, .rg-mega');
        if (!hasSub) return; // no sub-menu: follow link normally
        e.preventDefault();
        var isOpen = item.classList.contains('mob-open');
        // Close all
        nav.querySelectorAll('.rg-nav-item.mob-open').forEach(function(i){ i.classList.remove('mob-open'); });
        if (!isOpen) item.classList.add('mob-open');
      }

      /* Mega-menu column lists: show the scrollbar only while actively scrolling */
      document.querySelectorAll('.rg-mega-col-list').forEach(function(list){
        var hideTimer;
        list.addEventListener('scroll', function(){
          list.classList.add('rg-scrolling');
          clearTimeout(hideTimer);
          hideTimer = setTimeout(function(){ list.classList.remove('rg-scrolling'); }, 700);
        });
      });
      </script>

      <!-- Sign-In Modal -->
      <div class="rg-signin-overlay" id="rgSignInOverlay" onclick="rgCloseSignIn(event)">
        <div class="rg-signin-modal" role="dialog" aria-modal="true" aria-labelledby="rgsiTitle">
          <button class="rgsi-close" onclick="rgCloseSignIn()" aria-label="Close">&times;</button>
          <div class="rgsi-icon">
            <img src="https://www.rathiglobalrealty.com/uploads/logo/1777987165-logo-gold.png" alt="Rathi Global Realty" onerror="this.style.display='none'">
          </div>
          <span id="rgsiTitle">Sign In / Register</span>
          <p class="rgsi-sub">Enter your name and mobile number to continue</p>
          <div class="rgsi-field">
            <label for="rgsiName">Full Name</label>
            <input type="text" id="rgsiName" placeholder="e.g. Rahul Sharma" autocomplete="name">
          </div>
          <div class="rgsi-field">
            <label for="rgsiMobile">Mobile Number</label>
            <input type="tel" id="rgsiMobile" placeholder="10-digit mobile number" maxlength="10" autocomplete="tel">
          </div>
          <button class="rgsi-submit" id="rgsiSubmit" onclick="rgSubmitSignIn()">Sign In / Register</button>
          <div class="rgsi-msg" id="rgsiMsg"></div>
        </div>
      </div>
      <script>
      function rgUserDdToggle(e) {
        e.stopPropagation();
        var menu = document.getElementById('rgUserMenu');
        if (menu) menu.classList.toggle('open');
      }
      document.addEventListener('click', function(e){
        var menu = document.getElementById('rgUserMenu');
        if (menu && !menu.contains(e.target)) menu.classList.remove('open');
      });

      function rgOpenSignIn() {
        document.getElementById('rgSignInOverlay').classList.add('open');
        document.getElementById('rgsiName').focus();
      }
      function rgCloseSignIn(e) {
        if (!e || e.target === document.getElementById('rgSignInOverlay')) {
          document.getElementById('rgSignInOverlay').classList.remove('open');
          document.getElementById('rgsiMsg').textContent = '';
          document.getElementById('rgsiMsg').className = 'rgsi-msg';
        }
      }
      document.addEventListener('keydown', function(e){
        if(e.key === 'Escape') rgCloseSignIn({target: document.getElementById('rgSignInOverlay')});
      });
      function rgSubmitSignIn() {
        var name   = document.getElementById('rgsiName').value.trim();
        var mobile = document.getElementById('rgsiMobile').value.trim();
        var msg    = document.getElementById('rgsiMsg');
        var btn    = document.getElementById('rgsiSubmit');
        msg.className = 'rgsi-msg';
        msg.textContent = '';
        if (!name)   { msg.className = 'rgsi-msg err'; msg.textContent = 'Please enter your name.'; return; }
        if (!/^[0-9]{10}$/.test(mobile)) { msg.className = 'rgsi-msg err'; msg.textContent = 'Enter a valid 10-digit mobile number.'; return; }
        btn.disabled = true;
        btn.textContent = 'Please wait...';
        var xhr = new XMLHttpRequest();
        xhr.open('POST', window.CI_BASE + 'home/userSignIn', true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onload = function() {
          btn.disabled = false;
          btn.textContent = 'Sign In / Register';
          try {
            var res = JSON.parse(xhr.responseText);
            if (res.status) {
              msg.className = 'rgsi-msg ok';
              msg.textContent = res.message || 'Welcome, ' + res.name + '!';
              setTimeout(function(){ location.reload(); }, 900);
            } else {
              msg.className = 'rgsi-msg err';
              msg.textContent = res.error || 'Something went wrong.';
            }
          } catch(ex) {
            msg.className = 'rgsi-msg err';
            msg.textContent = 'Unexpected error. Please try again.';
          }
        };
        xhr.onerror = function() {
          btn.disabled = false;
          btn.textContent = 'Sign In / Register';
          msg.className = 'rgsi-msg err';
          msg.textContent = 'Network error. Please try again.';
        };
        xhr.send('name=' + encodeURIComponent(name) + '&mobile=' + encodeURIComponent(mobile));
      }
      </script>

      <!--Begin::Content-->
