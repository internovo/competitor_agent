<script>
/* BROCHURE GATED DOWNLOAD -- opens the sitewide lead popup; the actual file
   is only released from rgrsSubmitEnquiry's success handler (footer.php)
   once the lead is submitted, matching the reference flow (squareyards.com
   gates its brochure PDF behind the same kind of lead-form submit before
   revealing the download link). */
function pdOpenBrochureLead() {
        window._rgrsPendingDownload = {
        brochure: ""    };
    rgrsOpenEnquiry(
        "3 BHK Apartment For Sale in Amann Solitaire",
        '41609',
        '',
        "Mumbai",
        "Amann Infradevelopment Ltd"    );
}

function pdOpenMasterPlanLead() {
        window._rgrsPendingDownload = { masterplans: [] };
    rgrsOpenEnquiry("3 BHK Apartment For Sale in Amann Solitaire", '41609', '', "Mumbai", "Amann Infradevelopment Ltd");
}
function pdOpenAllDownloadsLead() {
        window._rgrsPendingDownload = { brochure: "", masterplans: [] };
    rgrsOpenEnquiry("3 BHK Apartment For Sale in Amann Solitaire", '41609', '', "Mumbai", "Amann Infradevelopment Ltd");
}

/* OVERVIEW TOGGLE */
function toggleOverview() {
    var el  = document.getElementById('overviewText');
    var btn = document.getElementById('overviewBtn');
    if (el.style.maxHeight === 'none') {
        el.style.maxHeight = '120px';
        btn.textContent = '+ Read More';
    } else {
        el.style.maxHeight = 'none';
        btn.textContent = '− Read Less';
    }
}

/* MOBILE TITLE DESCRIPTION READ MORE TOGGLE */
function pdToggleTitleDesc() {
    var el  = document.getElementById('pdTitleDesc');
    var btn = document.getElementById('pdTitleDescBtn');
    if (!el || !btn) return;
    var expanded = el.classList.toggle('pd-expanded');
    btn.classList.toggle('pd-expanded', expanded);
    btn.firstChild.textContent = expanded ? 'Read less ' : 'Read more ';
}

/* AMENITIES INTRO TOGGLE */
function toggleAmenitiesIntro() {
    var el  = document.getElementById('amenitiesIntroText');
    var btn = document.getElementById('amenitiesIntroBtn');
    if (el.style.maxHeight === 'none') {
        el.style.maxHeight = '48px';
        btn.innerHTML = 'Read More <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg>';
    } else {
        el.style.maxHeight = 'none';
        btn.innerHTML = 'Read Less <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 14l5-5 5 5z"/></svg>';
    }
}

/* AMENITIES SECTION COLLAPSE */
function pdMediaTab(btn, which) {
    document.querySelectorAll('.pd-media-tab').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    var photosPane = document.getElementById('pdMediaPanePhotos');
    var videosPane = document.getElementById('pdMediaPaneVideos');
    if (photosPane) photosPane.style.display = which === 'photos' ? '' : 'none';
    if (videosPane) videosPane.style.display = which === 'videos' ? '' : 'none';
}
function pdMediaTab(btn, which) {
    document.querySelectorAll('.pd-media-tab').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    var photosPane = document.getElementById('pdMediaPanePhotos');
    var videosPane = document.getElementById('pdMediaPaneVideos');
    if (photosPane) photosPane.style.display = which === 'photos' ? '' : 'none';
    if (videosPane) videosPane.style.display = which === 'videos' ? '' : 'none';
}
function toggleAmenitiesSection() {
    document.getElementById('sec-amenities').classList.toggle('collapsed');
}
function toggleReraSection() {
    document.getElementById('sec-rera').classList.toggle('collapsed');
}
function toggleDownloadsSection() {
    document.getElementById('sec-downloads').classList.toggle('collapsed');
}
function showAllAmenities() {
    document.querySelectorAll('#sec-amenities .pd-ami-hidden').forEach(function(el) { el.classList.remove('pd-ami-hidden'); });
    var btn = document.getElementById('amenitiesMoreBtn');
    if (btn) btn.remove();
}

/* RERA INTRO TOGGLE */
function toggleReraIntro() {
    var el  = document.getElementById('reraIntroText');
    var btn = document.getElementById('reraIntroBtn');
    var clamped = el.classList.toggle('clamped');
    btn.textContent = clamped ? 'Read more' : 'Read less';
}

/* SECTION NAV HIGHLIGHT */
(function() {
    var navLinks = document.querySelectorAll('.pd-sec-nav a');
    if (!navLinks.length) return;
    window.addEventListener('scroll', function() {
        var scrollY = window.scrollY + 120;
        var current = '';
        navLinks.forEach(function(link) {
            var id = link.getAttribute('href').replace('#', '');
            var el = document.getElementById(id);
            if (el && el.offsetTop <= scrollY) current = link.getAttribute('href');
        });
        navLinks.forEach(function(link) {
            link.classList.toggle('active', link.getAttribute('href') === current);
        });
    });
    navLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            var id = link.getAttribute('href').replace('#', '');
            var el = document.getElementById(id);
            if (el) window.scrollTo({ top: el.offsetTop - 100, behavior: 'smooth' });
        });
    });
})();

/* FLOOR PLAN TABS */
function pdFpSwitch(btn,idx){
    document.querySelectorAll('.pd-fp-tab-btn').forEach(function(b){b.classList.remove('active');});
    document.querySelectorAll('.pd-fp-unit-item').forEach(function(u){u.classList.remove('active');});
    document.querySelectorAll('.pd-fp-panel').forEach(function(p){p.style.display='none';});
    document.querySelectorAll('.pd-fp-quote-item').forEach(function(q){q.classList.remove('active');});
    if(btn) btn.classList.add('active');
    var ui=document.getElementById('pd-fp-unit-'+idx);
    if(ui) ui.classList.add('active');
    var panel=document.getElementById('pd-fp-panel-'+idx);
    if(panel) panel.style.display='block';
    var qi=document.getElementById('pd-fp-quote-'+idx);
    if(qi) qi.classList.add('active');
}

/* BUILD YOUR IDEAL UNIT */
(function() {
    if (!window.pdCfgData) return;
    var pdCfgTaps = 0;
    var pdCfgFacing = (document.querySelector('.pd-cfg-pill.active') || {}).dataset ? document.querySelector('.pd-cfg-pill.active').dataset.facing : 'North';
    var pdCfgFloorBand = 'Mid';

    function pdCfgTap() {
        pdCfgTaps++;
        var el = document.getElementById('pdCfgTaps');
        if (el) el.textContent = pdCfgTaps + (pdCfgTaps === 1 ? ' Tap' : ' Taps');
    }

    function pdCfgPopulateTypes(bhk) {
        var sel = document.getElementById('pdCfgTypeSelect');
        if (!sel) return;
        var rows = window.pdCfgData[bhk] || [];
        sel.innerHTML = '';
        rows.forEach(function(r, i) {
            var opt = document.createElement('option');
            opt.value = i;
            opt.textContent = r.label;
            sel.appendChild(opt);
        });
    }

    function pdCfgUpdateSelection() {
        var tab = document.querySelector('.pd-cfg-tab.active');
        var bhk = tab ? tab.dataset.bhk : null;
        var sel = document.getElementById('pdCfgTypeSelect');
        var rows = bhk ? (window.pdCfgData[bhk] || []) : [];
        var row  = rows[sel ? sel.value : 0] || null;

        var mainEl  = document.getElementById('pdCfgSelMain');
        var subEl   = document.getElementById('pdCfgSelSub');
        var priceEl = document.getElementById('pdCfgSelPrice');
        if (!mainEl || !row) return;

        mainEl.textContent = (bhk ? bhk + ' BHK' : '') + ' · ' + pdCfgFacing + '-facing · ' + pdCfgFloorBand + '-floor';
        subEl.textContent  = row.size || row.label;
        priceEl.textContent = row.price || 'Price on request';
    }

    window.pdCfgTabClick = function(btn) {
        document.querySelectorAll('.pd-cfg-tab').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        pdCfgPopulateTypes(btn.dataset.bhk);
        pdCfgUpdateSelection();
        pdCfgTap();
    };
    window.pdCfgOnTypeChange = function() {
        pdCfgUpdateSelection();
        pdCfgTap();
    };
    window.pdCfgFacingPick = function(btn) {
        document.querySelectorAll('.pd-cfg-pill').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        pdCfgFacing = btn.dataset.facing;
        pdCfgUpdateSelection();
        pdCfgTap();
    };
    window.pdCfgFloorPick = function(btn) {
        document.querySelectorAll('.pd-cfg-floorbtn').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        pdCfgFloorBand = btn.dataset.band;
        pdCfgUpdateSelection();
        pdCfgTap();
    };
    var firstTab = document.querySelector('.pd-cfg-tab.active');
    if (firstTab) pdCfgPopulateTypes(firstTab.dataset.bhk);
    pdCfgUpdateSelection();
})();

/* WHY MODAL */
function pdWhyOpen(){
    var m=document.getElementById('pdWhyModal');
    if(!m) return;
    document.getElementById('pdWhySheet').classList.remove('closing');
    m.classList.add('open');
    document.body.style.overflow='hidden';
}
function pdWhyClose(){
    var s=document.getElementById('pdWhySheet');
    var m=document.getElementById('pdWhyModal');
    s.classList.add('closing');
    setTimeout(function(){m.classList.remove('open');s.classList.remove('closing');document.body.style.overflow='';},280);
}

/* STAR RATING */
(function() {
    var wrap = document.getElementById('pdStarWrap');
    if (!wrap) return;
    var stars = wrap.querySelectorAll('.fa');
    var input = wrap.querySelector('.rating-value');
    stars.forEach(function(star, i) {
        star.addEventListener('mouseenter', function() {
            stars.forEach(function(s, j) { s.classList.toggle('active', j <= i); });
        });
        star.addEventListener('click', function() {
            input.value = i + 1;
            stars.forEach(function(s, j) {
                s.classList.toggle('fas', j <= i);
                s.classList.toggle('far', j > i);
            });
        });
    });
    wrap.addEventListener('mouseleave', function() {
        var val = parseInt(input.value) || 0;
        stars.forEach(function(s, j) { s.classList.toggle('active', j < val); });
    });
})();

/* REVIEW SUBMIT */
document.getElementById('submit_review') && document.getElementById('submit_review').addEventListener('click', function() {
    var name    = document.getElementById('reviewer_name').value;
    var comment = document.getElementById('reviewer_comment').value;
    var rating  = document.querySelector('.rating-value') ? document.querySelector('.rating-value').value : 0;
    var pid     = document.getElementById('product_id') ? document.getElementById('product_id').value : '';
    if (!name || !comment) { alert('Please enter your name and comment.'); return; }
    $.ajax({
        url: window.CI_BASE + 'Home/saveReview',
        method: 'POST',
        data: { name: name, comment: comment, star_rating: rating, product_id: pid },
        success: function(res) { alert('Thank you for your review!'); location.reload(); },
        error: function() { alert('Failed to submit review.'); }
    });
});

/* TRACK AVAILABILITY WIDGET (phone-only quick capture, below About Project) */
function pdTrackSubmit(e) {
    e.preventDefault();
    var form = e.target;
    var btn  = form.querySelector('button[type="submit"]');
    var mobileVal = (form.querySelector('[name="mobile"]') || {}).value || '';
    if (!mobileVal) { alert('Please enter your phone number.'); return; }
    var origHtml = btn.innerHTML;
    btn.disabled = true; btn.innerHTML = 'Sending…';
    $.ajax({
        url: window.CI_BASE + 'Home/ajaxEnquiry',
        method: 'POST',
        data: {
            name: 'Website Visitor',
            mobile: mobileVal,
            product_id: '41609',
            property_name: "3 BHK Apartment For Sale in Amann Solitaire",
            message: 'Enquiry via "Track Property Availability" widget'
        },
        success: function(res) {
            var r; try { r = typeof res==='string' ? JSON.parse(res) : res; } catch(ex){ r={}; }
            btn.disabled = false; btn.innerHTML = origHtml;
            if (r.status) {
                window.location.href = window.CI_BASE + 'thank-you';
            } else {
                pdShowToast('Something went wrong. Please try again.');
            }
        },
        error: function() { btn.disabled = false; btn.innerHTML = origHtml; pdShowToast('Something went wrong. Please try again.'); }
    });
}

/* SCHEDULE A WALKTHROUGH BANNER */
function pdWalkSubmit(e) {
    e.preventDefault();
    var form = e.target;
    var btn  = form.querySelector('button[type="submit"]');
    var get  = function(n){ return (form.querySelector('[name="' + n + '"]') || {}).value || ''; };
    var platformVal = get('platform'), dateVal = get('date'), timeVal = get('time'), mobileVal = get('mobile');
    if (!platformVal || !dateVal || !timeVal || !mobileVal) { alert('Please fill in all fields.'); return; }
    var origHtml = btn.innerHTML;
    btn.disabled = true; btn.innerHTML = 'Scheduling…';
    $.ajax({
        url: window.CI_BASE + 'Home/ajaxEnquiry',
        method: 'POST',
        data: {
            name: 'Website Visitor',
            mobile: mobileVal,
            product_id: '41609',
            property_name: "3 BHK Apartment For Sale in Amann Solitaire",
            message: 'Property walkthrough requested via ' + platformVal + ' on ' + dateVal + ' at ' + timeVal
        },
        success: function(res) {
            var r; try { r = typeof res==='string' ? JSON.parse(res) : res; } catch(ex){ r={}; }
            btn.disabled = false; btn.innerHTML = origHtml;
            if (r.status) {
                window.location.href = window.CI_BASE + 'thank-you';
            } else {
                pdShowToast('Something went wrong. Please try again.');
            }
        },
        error: function() { btn.disabled = false; btn.innerHTML = origHtml; pdShowToast('Something went wrong. Please try again.'); }
    });
}

/* RIGHT PANEL FORM */
function pdPanelSubmit(e) {
    e.preventDefault();
    var form = e.target;
    var btn  = form.querySelector('button[type="submit"]');
    var nameVal   = (form.querySelector('[name="name"]')   || {}).value || '';
    var mobileVal = (form.querySelector('[name="mobile"]') || {}).value || '';
    var emailVal  = (form.querySelector('[name="email"]')  || {}).value || '';
    if (!nameVal || !mobileVal) { alert('Please enter your name and phone number.'); return; }
    btn.disabled = true; btn.textContent = 'Sending…';
    $.ajax({
        url: window.CI_BASE + 'Home/ajaxEnquiry',
        method: 'POST',
        data: {
            name: nameVal, mobile: mobileVal, email: emailVal,
            product_id: '41609',
            property_name: "3 BHK Apartment For Sale in Amann Solitaire"        },
        success: function(res) {
            var r; try { r = typeof res==='string' ? JSON.parse(res) : res; } catch(ex){ r={}; }
            btn.disabled = false; btn.textContent = 'Contact Now';
            if (r.status) {
                window.location.href = window.CI_BASE + 'thank-you';
            } else {
                pdShowToast('Something went wrong. Please try again.');
            }
        },
        error: function() { btn.disabled = false; btn.textContent = 'Contact Now'; pdShowToast('Something went wrong. Please try again.'); }
    });
}

/* LIGHTBOX */
var pdImages = [];
var pdImageAlts = [];
var pdCurrent = 0;

/* Main-image dot pagination (independent of the lightbox's own position) */
function pdGalDotGo(idx) {
    var img = document.getElementById('pdGalMainImg');
    if (!img || !pdImages[idx]) return;
    img.src = pdImages[idx];
    img.alt = pdImageAlts[idx] || '';
    var dots = document.getElementById('pdGalDots');
    if (dots) {
        dots.querySelectorAll('.pd-gal-dot').forEach(function(d, i){ d.classList.toggle('active', i === idx); });
    }
}

/* ===== Wishlist Toggle (mirrors location.php's working implementation) ===== */
var PD_HEART_FILLED = 'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z';
var PD_HEART_EMPTY = 'M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z';
function rgrsToggleWish(btn, pid) {
        rgOpenSignIn();
    return;
        btn.disabled = true;
    var xhr = new XMLHttpRequest();
    xhr.open('POST', window.CI_BASE + 'home/toggleWishlist', true);
    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
    xhr.onload = function() {
        btn.disabled = false;
        try {
            var res = JSON.parse(xhr.responseText);
            if (!res.status) return;
            if (res.action === 'login') { rgOpenSignIn(); return; }
            var wished = res.action === 'added';
            var path = btn.querySelector('svg path');
            if (path) path.setAttribute('d', wished ? PD_HEART_FILLED : PD_HEART_EMPTY);
            btn.title = wished ? 'Shortlisted' : 'Shortlist';
            btn.setAttribute('aria-label', wished ? 'Shortlisted' : 'Shortlist');
            for (var i = 0; i < btn.childNodes.length; i++) {
                var n = btn.childNodes[i];
                if (n.nodeType === 3 && n.textContent.trim() !== '') { n.textContent = wished ? ' Shortlisted' : ' Shortlist'; break; }
            }
        } catch(e) {}
    };
    xhr.onerror = function() { btn.disabled = false; };
    xhr.send('product_id=' + pid);
}
function pdBuildThumbs() {
    var strip = document.getElementById('pdLbThumbs');
    strip.innerHTML = '';
    pdImages.forEach(function(src, i) {
        var div = document.createElement('div');
        div.className = 'pd-lb-thumb' + (i === pdCurrent ? ' active' : '');
        div.onclick = (function(idx){ return function(){ pdGoTo(idx); }; })(i);
        var img = document.createElement('img');
        img.src = src; img.alt = pdImageAlts[i] || '';
        div.appendChild(img); strip.appendChild(div);
    });
}
function pdGoTo(n) {
    pdCurrent = (n + pdImages.length) % pdImages.length;
    document.getElementById('pdLightboxImg').src = pdImages[pdCurrent];
    document.getElementById('pdLightboxImg').alt = pdImageAlts[pdCurrent] || '';
    document.getElementById('pdLightboxCounter').textContent = (pdCurrent + 1) + ' / ' + pdImages.length;
    var thumbs = document.getElementById('pdLbThumbs').querySelectorAll('.pd-lb-thumb');
    thumbs.forEach(function(t, i){ t.classList.toggle('active', i === pdCurrent); });
    if (thumbs[pdCurrent]) thumbs[pdCurrent].scrollIntoView({behavior:'smooth', inline:'center', block:'nearest'});
}
function pdUnmuteVideo() {
    var fr = document.getElementById('pdBannerYtIframe');
    if (fr && fr.contentWindow) {
        fr.contentWindow.postMessage('{"event":"command","func":"unMute","args":""}', '*');
        fr.contentWindow.postMessage('{"event":"command","func":"setVolume","args":[100]}', '*');
    }
    var btn = document.getElementById('pdVidSoundBtn');
    if (btn) btn.style.display = 'none';
}
function pdOpenLightbox(index) {
    if (!pdImages.length) return;
    pdCurrent = index || 0;
    document.getElementById('pdLightbox').classList.add('open');
    document.getElementById('pdLbBackdrop').classList.add('open');
    pdBuildThumbs(); pdGoTo(pdCurrent);
    document.body.style.overflow = 'hidden';
}
function pdCloseLightbox() {
    document.getElementById('pdLightbox').classList.remove('open');
    document.getElementById('pdLbBackdrop').classList.remove('open');
    document.body.style.overflow = '';
}
function pdLightboxMove(dir) { pdGoTo(pdCurrent + dir); }
function pdLbSubmit(e) {
    e.preventDefault();
    var form = e.target;
    var btn  = form.querySelector('button[type="submit"]');
    var fields = form.querySelectorAll('input,textarea');
    var name = fields[0].value, email = fields[1].value, phone = fields[2].value, msg = fields[3].value;
    if (!name || !phone) { alert('Please enter your name and phone number.'); return; }
    btn.disabled = true; btn.textContent = 'Sending…';
    $.ajax({
        url: window.CI_BASE + 'Home/ajaxEnquiry',
        method: 'POST',
        data: { name:name, email:email, mobile:phone, message:msg,
                product_id:'41609',
                property_name: "3 BHK Apartment For Sale in Amann Solitaire" },
        success: function(res) {
            var r; try { r = typeof res==='string' ? JSON.parse(res) : res; } catch(ex){ r={}; }
            btn.disabled = false; btn.textContent = 'Contact Now';
            if (r.status) {
                window.location.href = window.CI_BASE + 'thank-you';
            } else {
                pdShowToast('Something went wrong. Please try again.');
            }
        },
        error: function() { btn.disabled = false; btn.textContent = 'Contact Now'; pdShowToast('Something went wrong. Please try again.'); }
    });
}
document.addEventListener('keydown', function(e) {
    if (!document.getElementById('pdLightbox').classList.contains('open')) return;
    if (e.key === 'ArrowLeft')  pdLightboxMove(-1);
    if (e.key === 'ArrowRight') pdLightboxMove(1);
    if (e.key === 'Escape')     pdCloseLightbox();
});

/* SIMILAR PROJECTS CAROUSEL */
(function() {
    var track    = document.getElementById('pdSimTrack');
    var viewport = document.getElementById('pdSimViewport');
    var btnPrev  = document.getElementById('pdSimPrev');
    var btnNext  = document.getElementById('pdSimNext');
    if (!track || !viewport) return;

    var current  = 0;
    var GAP      = 14;

    function isMobile() { return window.innerWidth <= 767; }

    function cardWidth() {
        var card = track.querySelector('.pd-sim-card');
        return card ? card.offsetWidth + GAP : 274;
    }

    function totalCards() { return track.querySelectorAll('.pd-sim-card').length; }

    function visibleCount() {
        return Math.max(1, Math.floor((viewport.offsetWidth + GAP) / cardWidth()));
    }

    function maxIndex() { return Math.max(0, totalCards() - visibleCount()); }

    function updateArrows() {
        if (isMobile()) return;
        btnPrev.disabled = current <= 0;
        btnNext.disabled = current >= maxIndex();
    }

    function goTo(idx) {
        if (isMobile()) return;
        current = Math.max(0, Math.min(idx, maxIndex()));
        track.style.transform = 'translateX(-' + (current * cardWidth()) + 'px)';
        updateArrows();
    }

    window.pdSimMove = function(dir) { goTo(current + dir); };

    updateArrows();
    window.addEventListener('resize', function() {
        if (isMobile()) {
            track.style.transform = '';
            current = 0;
        } else {
            goTo(current);
        }
    });
})();
/* Generic version of the Similar Projects carousel above, reused for the
   Resale Units and Projects-by-Developer sections (same .pd-sim-card /
   .pd-sim-scroll / .pd-sim-viewport markup, different element ids). */
function pdInitCarousel(trackId, viewportId, prevId, nextId, cardSelector) {
    cardSelector = cardSelector || '.pd-sim-card';
    var track    = document.getElementById(trackId);
    var viewport = document.getElementById(viewportId);
    var btnPrev  = document.getElementById(prevId);
    var btnNext  = document.getElementById(nextId);
    if (!track || !viewport) return;

    var current = 0;
    var GAP     = 14;

    function isMobile() { return window.innerWidth <= 767; }
    function visibleCards() { return Array.prototype.filter.call(track.querySelectorAll(cardSelector), function(c){ return c.style.display !== 'none'; }); }
    function cardWidth() {
        var cards = visibleCards();
        return cards.length ? cards[0].offsetWidth + GAP : 274;
    }
    function totalCards() { return visibleCards().length; }
    function visibleCount() { return Math.max(1, Math.floor((viewport.offsetWidth + GAP) / cardWidth())); }
    function maxIndex() { return Math.max(0, totalCards() - visibleCount()); }
    function updateArrows() {
        if (isMobile() || !btnPrev || !btnNext) return;
        btnPrev.disabled = current <= 0;
        btnNext.disabled = current >= maxIndex();
    }
    function goTo(idx) {
        if (isMobile()) return;
        current = Math.max(0, Math.min(idx, maxIndex()));
        track.style.transform = 'translateX(-' + (current * cardWidth()) + 'px)';
        updateArrows();
    }
    function move(dir) { goTo(current + dir); }
    if (btnPrev) btnPrev.addEventListener('click', function(){ move(-1); });
    if (btnNext) btnNext.addEventListener('click', function(){ move(1); });

    updateArrows();
    window.addEventListener('resize', function() {
        if (isMobile()) { track.style.transform = ''; current = 0; }
        else { goTo(current); }
    });
    // Exposed so a filter-tab click can reset scroll position and re-measure
    // against only the now-visible cards.
    return { reset: function() { current = 0; track.style.transform = ''; updateArrows(); } };
}
pdInitCarousel('pdResaleTrack', 'pdResaleViewport', 'pdResalePrev', 'pdResaleNext');
(function() {
    var devCarousel = pdInitCarousel('pdDevProjTrack', 'pdDevProjViewport', 'pdDevProjPrev', 'pdDevProjNext');
    var tabs = document.getElementById('pdDevProjTabs');
    if (!tabs) return;
    var track = document.getElementById('pdDevProjTrack');
    tabs.addEventListener('click', function(e) {
        var btn = e.target.closest('.pd-dp-tab');
        if (!btn) return;
        tabs.querySelectorAll('.pd-dp-tab').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        var status = btn.getAttribute('data-status');
        track.querySelectorAll('.pd-sim-card').forEach(function(card) {
            var show = status === 'all' || card.getAttribute('data-status') === status;
            card.style.display = show ? '' : 'none';
        });
        if (devCarousel) devCarousel.reset();
    });
})();
pdInitCarousel('pdNewLaunchTrack', 'pdNewLaunchViewport', 'pdNewLaunchPrev', 'pdNewLaunchNext');
(function() {
    var zones = window.PD_HOTSPOT_ZONES;
    var tabs  = document.getElementById('pdHotspotTabs');
    var track = document.getElementById('pdHotspotTrack');
    var viewall = document.getElementById('pdHotspotViewall');
    if (!zones || !tabs || !track) return;

    var carousel = pdInitCarousel('pdHotspotTrack', 'pdHotspotViewport', 'pdHotspotPrev', 'pdHotspotNext', '.pd-hotspot-card');

    function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    function renderZone(idx) {
        var zone = zones[idx];
        if (!zone) return;
        track.innerHTML = zone.projects.map(function(p) {
            return '<a class="pd-hotspot-card" href="' + esc(p.url) + '">' +
                '<div class="pd-hotspot-img-ring"><img src="' + esc(p.img) + '" alt="' + esc(p.name) + '" loading="lazy"></div>' +
                '<div class="pd-hotspot-name">' + esc(p.name) + '</div>' +
                (p.loc ? '<div class="pd-hotspot-loc">' + esc(p.loc) + '</div>' : '') +
                (p.price ? '<div class="pd-hotspot-price">' + esc(p.price) + '</div>' : '') +
                '</a>';
        }).join('');
        if (carousel) carousel.reset();
        // "View All" link tracks the active tab's own locality page --
        // falls back to the city root (data-city-* attrs) when this zone
        // has no resolvable URL.
        if (viewall) {
            var hasZoneUrl = !!zone.url;
            viewall.href = hasZoneUrl ? zone.url : viewall.getAttribute('data-city-url');
            var total = hasZoneUrl ? zone.total : viewall.getAttribute('data-city-total');
            var name  = hasZoneUrl ? zone.name : viewall.getAttribute('data-city-name');
            viewall.innerHTML = 'View All ' + total + ' Projects in ' + esc(name) + ' &rarr;';
        }
    }

    tabs.addEventListener('click', function(e) {
        var btn = e.target.closest('.pd-hotspot-tab');
        if (!btn) return;
        tabs.querySelectorAll('.pd-hotspot-tab').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        renderZone(parseInt(btn.getAttribute('data-zone'), 10));
    });

    renderZone(0);
})();
/* PHOTOS SLIDER */
(function(){
    function initPhotosSlider(){
        if(typeof Splide==='undefined')return;
        var mainEl=document.getElementById('pdPhotosSlider');
        var thumbEl=document.getElementById('pdPhotosThumbs');
        if(!mainEl)return;
        var _isMobile=window.innerWidth<=767;
        var main=new Splide(mainEl,{type:'loop',perPage:1,perMove:1,pagination:false,arrows:true,gap:0,speed:500,autoplay:_isMobile,interval:3500,pauseOnHover:false,pauseOnFocus:false});
        if(thumbEl){
            var thumbs=new Splide(thumbEl,{fixedWidth:90,fixedHeight:62,isNavigation:true,gap:6,focus:'center',pagination:false,arrows:false,cover:true,rewind:true,breakpoints:{480:{fixedWidth:64,fixedHeight:44}}});
            main.sync(thumbs);
            thumbs.mount();
        }
        main.mount();
        // update counter on slide change
        main.on('moved',function(idx){
            var counters=mainEl.querySelectorAll('.pd-phs-counter');
            counters.forEach(function(c){c.style.display='none';});
            var activeCounter=mainEl.querySelector('.splide__slide.is-active .pd-phs-counter');
            if(!activeCounter){
                // restore counter on first slide counter element
                var first=mainEl.querySelector('.pd-phs-counter');
                if(first)first.style.display='';
            }
        });
    }
    if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',initPhotosSlider);}
    else{initPhotosSlider();}
})();
/* DEV ABOUT READ MORE */
function pdDevToggle(){
    var w=document.getElementById('devAboutWrap');
    if(!w)return;
    var btn=w.querySelector('.pd-dev-readmore');
    if(w.classList.contains('collapsed')){w.classList.remove('collapsed');btn.textContent='Read Less';}
    else{w.classList.add('collapsed');btn.textContent='Read More';w.scrollIntoView({behavior:'smooth',block:'nearest'});}
}
/* ENQUIRY POPUP -- opening/closing/submit now all live in footer.php's
   rgrsOpenEnquiry()/rgrsSubmitEnquiry() (the sitewide #rgrs-enq-overlay,
   Rathi-branded, consistent with the "Unlock Pros & Cons" popup instead of
   this page's own separate developer-branded one). pdOpenPopup() kept as a
   thin wrapper -- every existing onclick="pdOpenPopup()" across this page
   (On Request links, CTAs, FAQ "click here", mobile bar, etc.) now opens
   the consolidated popup with no changes needed at each call site. */
function pdOpenPopup(){
    rgrsOpenEnquiry("3 BHK Apartment For Sale in Amann Solitaire",41609,"https:\/\/www.rathiglobalrealty.com\/uploads\/product\/","Mumbai");
}
function _pdAutoPopupTick(){
    if(!document.getElementById('rgrs-enq-overlay').classList.contains('active')){
        pdOpenPopup();
    }
    _pdAutoTimer = setTimeout(_pdAutoPopupTick, 60000);
}
var _pdAutoTimer = setTimeout(_pdAutoPopupTick, 120000);
function pdShowToast(msg){
    var t=document.getElementById('pdToast');
    t.textContent=msg;
    t.classList.remove('show');
    void t.offsetWidth; // force reflow so transition fires
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); },4500);
}
function pdFaqToggle(btn){
    var item=btn.closest('.pd-faq-item');
    var open=item.classList.contains('open');
    document.querySelectorAll('.pd-faq-item.open').forEach(function(el){el.classList.remove('open');el.querySelector('.pd-faq-q').setAttribute('aria-expanded','false');});
    if(!open){item.classList.add('open');btn.setAttribute('aria-expanded','true');}
}
function pdFurnToggle(){
    var grid = document.getElementById('pdFurnMoreGrid');
    var chevron = document.getElementById('pdFurnMoreChevron');
    var label = document.querySelector('#pdFurnMoreBtn .pd-furn-more-label');
    if (!grid) return;
    var isOpen = grid.style.display !== 'none';
    grid.style.display = isOpen ? 'none' : 'grid';
    if (chevron) chevron.classList.toggle('pd-furn-open', !isOpen);
    if (label) label.childNodes[0].nodeValue = isOpen ? 'More ' : 'Less ';
}
</script>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" media="print" onload="this.onload=null;this.media='all'">
<noscript><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""></noscript>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="" defer></script>
<script>
(function(){
var PROP_LAT = 19.2304552;
var PROP_LNG = 72.8489628;
var _nearbyMap;

function initNearbyMap(){
    var el=document.getElementById('nearbyMap');
    if(!el) return;
    _nearbyMap=L.map('nearbyMap',{zoomControl:true}).setView([PROP_LAT,PROP_LNG],14);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
        attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',maxZoom:19
    }).addTo(_nearbyMap);
    var propIcon=L.divIcon({html:'<div style="background:#c08830;border:3px solid #fff;border-radius:50%;width:18px;height:18px;box-shadow:0 2px 8px rgba(0,0,0,.4)"></div>',iconSize:[18,18],iconAnchor:[9,9],className:''});
    L.marker([PROP_LAT,PROP_LNG],{icon:propIcon}).addTo(_nearbyMap).bindPopup('<strong>3 BHK Apartment For Sale in Amann Solitaire</strong>').openPopup();
}

/* CHECK TRAVEL TIME -- free OSM stack (Nominatim geocode via server proxy,
   OSRM public demo for driving route, haversine+avg-speed estimate for
   walking since OSRM's free public demo only serves the driving profile). */
(function() {
    var input    = document.getElementById('pdTtInput');
    var suggest  = document.getElementById('pdTtSuggest');
    var showBtn  = document.getElementById('pdTtShowBtn');
    var resultEl = document.getElementById('pdTtResult');
    if (!input) return;

    var destLat = 19.2304552;
    var destLng = 72.8489628;
    var chosen  = null; // {label, lat, lon}
    var debounceTimer = null;

    function haversineKm(lat1, lon1, lat2, lon2) {
        var R = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = Math.sin(dLat/2)*Math.sin(dLat/2) +
                Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180) *
                Math.sin(dLon/2)*Math.sin(dLon/2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }
    function fmtDuration(mins) {
        mins = Math.round(mins);
        if (mins < 60) return mins + ' mins';
        var h = Math.floor(mins / 60), m = mins % 60;
        return h + ' hour' + (h > 1 ? 's' : '') + (m ? ' ' + m + ' mins' : '');
    }

    input.addEventListener('input', function() {
        chosen = null;
        var term = input.value.trim();
        clearTimeout(debounceTimer);
        if (term.length < 3) { suggest.classList.remove('open'); suggest.innerHTML = ''; return; }
        debounceTimer = setTimeout(function() {
            fetch('https://www.rathiglobalrealty.com/Home/travel_geocode?term=' + encodeURIComponent(term))
                .then(function(r) { return r.json(); })
                .then(function(rows) {
                    if (!rows || !rows.length) {
                        suggest.innerHTML = '<div class="pd-tt-suggest-empty">No matches found</div>';
                        suggest.classList.add('open');
                        return;
                    }
                    suggest.innerHTML = rows.map(function(r, i) {
                        return '<div class="pd-tt-suggest-item" data-i="' + i + '">' + r.label.replace(/</g,'&lt;') + '</div>';
                    }).join('');
                    suggest.classList.add('open');
                    suggest.querySelectorAll('.pd-tt-suggest-item').forEach(function(el, i) {
                        el.addEventListener('click', function() {
                            chosen = rows[i];
                            input.value = rows[i].label;
                            suggest.classList.remove('open');
                            pdTtCompute();
                        });
                    });
                })
                .catch(function() { suggest.classList.remove('open'); });
        }, 400);
    });
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.pd-tt-search-wrap')) suggest.classList.remove('open');
    });

    window.pdTtCompute = function() {
        if (!chosen) {
            if (input.value.trim().length < 3) return;
            resultEl.style.display = 'block';
            resultEl.innerHTML = '<div class="pd-tt-result-error">Please choose a starting point from the suggestions list.</div>';
            return;
        }
        resultEl.style.display = 'block';
        resultEl.innerHTML = '<div class="pd-tt-result-loading">Calculating travel time...</div>';

        var walkKm = haversineKm(chosen.lat, chosen.lon, destLat, destLng);
        var walkMins = (walkKm / 5) * 60; // ~5 km/h average walking speed

        fetch('https://router.project-osrm.org/route/v1/driving/' + chosen.lon + ',' + chosen.lat + ';' + destLng + ',' + destLat + '?overview=false')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var driveHtml = '';
                if (data && data.code === 'Ok' && data.routes && data.routes[0]) {
                    var route = data.routes[0];
                    driveHtml = '<div class="pd-tt-pill"><svg viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16C5.67 16 5 15.33 5 14.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5S16.67 13 17.5 13s1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>'
                        + fmtDuration(route.duration / 60) + ' (' + (route.distance/1000).toFixed(1) + ' km)</div>';
                }
                var walkHtml = '<div class="pd-tt-pill"><svg viewBox="0 0 24 24"><path d="M13.5 5.5c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zM9.8 8.9L7 23h2.1l1.8-8 2.1 2v6h2v-7.5l-2.1-2 .6-3C14.8 12 16.8 13 19 13v-2c-1.9 0-3.5-1-4.3-2.4l-1-1.6c-.4-.6-1-1-1.7-1-.3 0-.5.1-.8.1L6 8.3V13h2V9.6l1.8-.7"/></svg>'
                        + fmtDuration(walkMins) + ' (' + walkKm.toFixed(1) + ' km)</div>';
                resultEl.innerHTML =
                    '<div class="pd-tt-result-addr"><svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>'
                    + '<span style="flex:1">' + chosen.label.replace(/</g,'&lt;') + '</span>'
                    + '<button type="button" class="pd-tt-result-close" onclick="pdTtClear()">&times;</button></div>'
                    + '<div class="pd-tt-result-pills">' + driveHtml + walkHtml + '</div>';
            })
            .catch(function() {
                resultEl.innerHTML = '<div class="pd-tt-result-error">Could not calculate travel time. Please try again.</div>';
            });
    };

    window.pdTtClear = function() {
        chosen = null;
        input.value = '';
        resultEl.style.display = 'none';
        resultEl.innerHTML = '';
    };
})();

if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',initNearbyMap);}
else{initNearbyMap();}
})();
</script>

