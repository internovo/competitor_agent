<style>
/* ===== SEO LINKS SECTION ===== */
.rgrs-seo-section { background:#f7f7f8; padding:40px 0 30px; }
.rgrs-seo-tabs { list-style:none; display:flex; gap:0; padding:0; margin:0 0 24px; border-bottom:2px solid #e8e8e8; }
.rgrs-seo-tab { padding:10px 24px 12px; font-size:14px; font-weight:600; color:#666; cursor:pointer; position:relative; white-space:nowrap; transition:color .2s; }
.rgrs-seo-tab::after { content:''; position:absolute; bottom:-2px; left:0; right:0; height:2px; background:transparent; transition:background .2s; }
.rgrs-seo-tab.active { color:#1a1a1a; }
.rgrs-seo-tab.active::after { background:#1a1a1a; }
.rgrs-seo-tab:hover { color:#c08830; }
.rgrs-seo-content { display:none; }
.rgrs-seo-content.active { display:block; }
.rgrs-seo-grid { display:flex; flex-wrap:wrap; gap:20px 40px; }
/* Each column scrolls after 8 visible links (~260px) */
.rgrs-seo-col { flex:1; min-width:160px; max-height:260px; overflow-y:auto; padding-right:6px; scroll-behavior:smooth; }
.rgrs-seo-col-title { font-size:13px; font-weight:700; color:#333; margin:0 0 10px; position:sticky; top:0; background:#f7f7f8; z-index:1; padding:4px 0 6px; }
.rgrs-seo-col a { display:block; font-size:13px; color:#555; text-decoration:none; padding:3px 0; line-height:1.5; transition:color .15s; }
.rgrs-seo-col a:hover { color:#c08830; }
.rgrs-seo-col::-webkit-scrollbar { width:4px; }
.rgrs-seo-col::-webkit-scrollbar-track { background:transparent; }
.rgrs-seo-col::-webkit-scrollbar-thumb { background:#d0d0d0; border-radius:4px; }
.rgrs-seo-col::-webkit-scrollbar-thumb:hover { background:#aaa; }
.rgrs-seo-col { scrollbar-width:thin; scrollbar-color:#d0d0d0 transparent; }

/* ===== FOOTER ===== */
.rgrs-footer { background:#111; color:#ccc; padding:60px 0 0; }
.rgrs-footer-top { display:grid; grid-template-columns:2fr 1fr 1fr 1fr; gap:48px; padding-bottom:48px; border-bottom:1px solid #2a2a2a; }
.rgrs-footer-brand {}
.rgrs-footer-logo { height:48px; width:auto; filter:brightness(0) invert(1); margin-bottom:16px; display:block; }
.rgrs-footer-text-logo { font-size:18px; font-weight:800; color:#fff; text-decoration:none; display:block; margin-bottom:16px; line-height:1.2; }
.rgrs-footer-text-logo span { font-size:11px; font-weight:400; letter-spacing:2px; color:#999; }
.rgrs-footer-tagline { font-size:13px; color:#999; line-height:1.7; margin-bottom:20px; }
.rgrs-footer-subscribe form { display:flex; gap:0; }
.rgrs-footer-subscribe input { flex:1; background:#1e1e1e; border:1px solid #333; border-radius:6px 0 0 6px; padding:10px 14px; font-size:13px; color:#fff; outline:none; }
.rgrs-footer-subscribe input::placeholder { color:#666; }
.rgrs-footer-subscribe button { background:#ffd000; color:#000000; border:none; border-radius:0 6px 6px 0; padding:10px 18px; font-size:13px; font-weight:600; cursor:pointer; white-space:nowrap; transition:background .2s; }
.rgrs-footer-subscribe button:hover { background:#a8711e; }
.rgrs-footer-col span { display:block; color:#fff; font-size:15px; font-weight:700; margin:0 0 16px; }
.rgrs-footer-col ul { list-style:none; padding:0; margin:0; }
.rgrs-footer-col ul li { margin-bottom:9px; }
.rgrs-footer-col ul li a { color:#999; font-size:13px; text-decoration:none; transition:color .2s; }
.rgrs-footer-col ul li a:hover { color:#c08830; }
.rgrs-footer-contact { margin-top:16px; display:flex; flex-direction:column; gap:10px; }
.rgrs-footer-contact a { color:#999; font-size:13px; text-decoration:none; display:flex; align-items:center; gap:8px; }
.rgrs-footer-contact a.rgrs-footer-phone { font-size:18px; font-weight:700; color:#fff; letter-spacing:.5px; }
.rgrs-footer-contact a.rgrs-footer-phone i { color:#c08830; font-size:16px; }
.rgrs-footer-contact a.rgrs-footer-phone:hover { color:#c08830; }
.rgrs-footer-contact a i { color:#c08830; width:14px; }
.rgrs-footer-contact a:hover { color:#c08830; }
/* Bottom bar */
.rgrs-footer-bottom { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; padding:20px 0; border-top:1px solid #2a2a2a; }
.rgrs-footer-bottom p { font-size:13px; color:#666; margin:0; }
.rgrs-footer-bottom-links { display:flex; gap:20px; }
.rgrs-footer-bottom-links a { font-size:13px; color:#666; text-decoration:none; transition:color .2s; }
.rgrs-footer-bottom-links a:hover { color:#c08830; }
.rgrs-footer-social { display:flex; gap:10px; }
.rgrs-footer-social a { width:36px; height:36px; border-radius:50%; border:none; display:flex; align-items:center; justify-content:center; color:#fff; font-size:16px; text-decoration:none; transition:transform .2s,opacity .2s; }
.rgrs-footer-social a:hover { transform:scale(1.15); opacity:.9; }
.rgrs-si-facebook,.rgrs-si-facebook-f { background:#1877F2; }
.rgrs-si-instagram { background:radial-gradient(circle at 30% 107%,#fdf497 0%,#fd5949 45%,#d6249f 60%,#285AEB 90%); }
.rgrs-si-twitter { background:#1DA1F2; }
.rgrs-si-x-twitter { background:#000; }
.rgrs-si-youtube { background:#FF0000; }
.rgrs-si-linkedin,.rgrs-si-linkedin-in { background:#0A66C2; }
.rgrs-si-whatsapp { background:#25D366; }
.rgrs-si-pinterest,.rgrs-si-pinterest-p { background:#E60023; }
.rgrs-si-tiktok { background:#010101; }
/* WhatsApp float */
.rgrs-wa-float { position:fixed; bottom:28px; right:24px; z-index:9990; }
.rgrs-wa-float a { width:52px; height:52px; background:#25d366; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:26px; color:#fff; text-decoration:none; box-shadow:0 4px 16px rgba(37,211,102,.4); transition:transform .2s; }
.rgrs-wa-float a:hover { transform:scale(1.1); }
/* Responsive */
@media(max-width:992px){
  .rgrs-footer-top { grid-template-columns:1fr 1fr; gap:32px; }
  .rgrs-footer-brand { grid-column:1/-1; }
  .rgrs-seo-grid { gap:16px 24px; }
  .rgrs-seo-col { min-width:140px; }
}
@media(max-width:600px){
  .rgrs-footer-top { grid-template-columns:1fr; }
  .rgrs-footer-bottom { flex-direction:column; align-items:flex-start; gap:10px; }
  .rgrs-seo-tabs { overflow-x:auto; }
  .rgrs-seo-tab { padding:10px 16px 12px; }
  .rgrs-seo-grid { flex-direction:column; }
}
</style>

