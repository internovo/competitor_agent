<style>
:root{--gold:#c08830;--dark:#333;--bg:#f1f1f1;--card:#fff;--border:#e1e1e1;--text2:#666;--radius:8px}
body{background:var(--bg);font-family:Arial,"sans-serif";color:var(--dark)}
.pd-page{background:var(--bg);padding-bottom:60px}

/* BREADCRUMB */
.pd-sec ul li,.pd-section ul li{font-size:14px;line-height:24px}
.pd-bc{background:#fff;border-bottom:1px solid var(--border);padding:9px 0;font-size:13px;color:#999}
.pd-bc ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;align-items:center;gap:4px}
.pd-bc ul li{font-size:9px !important}
.pd-bc ul li+li::before{content:'/';margin-right:4px;color:#ccc}
.pd-bc ul li a{color:#999;text-decoration:none}.pd-bc ul li a:hover{color:var(--dark)}
.pd-bc ul li:last-child{color:var(--dark);font-weight:500}
/* CONTAINER OVERRIDE */
.pd-page{overflow-x:clip} /* clip instead of hidden — doesn't break position:sticky */
.pd-page .container{width:100%;box-sizing:border-box;max-width:1200px;padding-left:20px;padding-right:20px}
@media(max-width:767px){.pd-page .container{padding-left:12px;padding-right:12px}}

/* GALLERY */
.pd-gallery{display:grid;grid-template-columns:2fr 1fr;grid-template-rows:202px 202px;gap:6px;border-radius:var(--radius);overflow:hidden;margin-top:18px}
.pd-gal-main{grid-row:1/3;position:relative;overflow:hidden;border-radius:var(--radius)}
.pd-gal-main img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}
.pd-gal-main:hover img{transform:scale(1.02)}
.pd-gal-side{position:relative;overflow:hidden;border-radius:var(--radius)}
.pd-gal-side img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}
.pd-gal-side:hover img{transform:scale(1.02)}
.pd-gal-status{position:absolute;top:12px;left:12px;background:var(--gold);color:#fff;font-size:11px;font-weight:700;padding:4px 12px;border-radius:4px;letter-spacing:.5px;z-index:2}
.pd-view-all{position:absolute;bottom:10px;right:10px;background:rgba(0,0,0,.65);color:#fff;border:none;border-radius:6px;padding:7px 13px;font-size:12px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;backdrop-filter:blur(4px)}
.pd-view-all:hover{background:rgba(0,0,0,.85)}
@media(max-width:767px){
  .pd-gallery{grid-template-columns:1fr;grid-template-rows:260px;height:260px}
  .pd-gal-main{grid-row:1/2}
  .pd-gal-side{display:none}
}

/* PROPERTY HEADER */
.pd-prop-header{background:#fff;border-radius:var(--radius);padding:0 18px 18px;margin-top:14px}
.pd-prop-name{font-size:22px;font-weight:700;color:var(--dark);margin:0 0 6px}
.pd-prop-loc{font-size:13px;color:var(--text2);display:flex;align-items:center;gap:4px;margin-bottom:12px}
.pd-prop-loc svg{width:13px;height:13px;fill:var(--gold);flex-shrink:0}
.pd-prop-stats{display:flex;flex-wrap:wrap;gap:0;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
.pd-stat{flex:1;min-width:100px;padding:10px 14px;border-right:1px solid var(--border);text-align:center}
.pd-stat:last-child{border-right:none}
.pd-stat-label{font-size:11px;color:#999;text-transform:uppercase;letter-spacing:.4px;margin-bottom:3px}
.pd-stat-val{font-size:14px;font-weight:700;color:var(--dark)}
@media(max-width:575px){.pd-stat{min-width:50%;border-bottom:1px solid var(--border)}.pd-stat:nth-child(even){border-right:none}}

/* MAIN LAYOUT */
.pd-layout{display:flex;gap:24px;align-items:flex-start;margin-top:15px}
.pd-left{flex:1;min-width:0}
.pd-right{width:320px;flex:none;position:sticky;top:68px}
@media(min-width:1200px){.pd-right{width:360px}}
@media(max-width:991px){.pd-layout{flex-direction:column}.pd-right{width:100%;position:static}}
@media(max-width:540px){.pd-left{flex:1;min-width:0;width:100%}}

/* STICKY SECTION NAV */
.pd-sec-nav{background:#fff;border-radius:var(--radius);margin-bottom:15px;position:sticky;top:64px;z-index:100;overflow-x:auto;scrollbar-width:none;white-space:nowrap;width:100%}
.pd-sec-nav::-webkit-scrollbar{display:none}
.pd-sec-nav-inner{display:flex;padding:0 8px;border-bottom:1px solid var(--border)}
.pd-sec-nav a{display:inline-block;padding:14px 15px;font-size:13px;font-weight:700;color:var(--text2);text-decoration:none;border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .2s;white-space:nowrap}
.pd-sec-nav a:hover{color:var(--dark);border-bottom-color:var(--gold)}
.pd-sec-nav a.active{color:var(--dark);border-bottom-color:var(--gold)}

/* SECTION CARD — white-box style */
.pd-sec{background:#fff;border-radius:var(--radius);padding:0 18px 18px;margin-bottom:15px;min-height:60px}
.pd-sec-title{display:flex;align-items:center;min-height:56px;border-bottom:1px solid var(--border);font-size:18px;font-weight:700;color:var(--dark);margin:0 0 18px;padding:0}
.pd-sec-title span{color:var(--gold);margin-left:5px}

/* OVERVIEW */
.pd-ov-row{display:flex;gap:18px;align-items:flex-start}
.pd-ov-icon{width:52px;height:56px;flex-shrink:0}
.pd-ov-icon img{width:100%;height:100%;display:block}
.pd-ov-body{flex:1;min-width:0}
.pd-ov-readmore{display:inline-block;color:var(--gold);font-size:13px;font-weight:600;text-decoration:underline;cursor:pointer;margin-top:6px}
@media(max-width:575px){.pd-ov-row{gap:12px}.pd-ov-icon{width:40px;height:43px}}
.pd-overview-text{font-size:15px;color:#444;line-height:24px}
.pd-overview-text p{margin:0 0 10px;font-size:15px;line-height:24px}
.pd-overview-text ul,.pd-overview-text ol{font-size:15px;line-height:24px;padding-left:20px;margin:0 0 10px}
.pd-overview-text li{font-size:15px;line-height:24px;margin-bottom:4px}
.pd-overview-text h2,.pd-overview-text h3{font-size:18px;font-weight:bold;color:var(--dark);margin:14px 0 6px}
.pd-read-more-btn{background:none;border:none;color:var(--gold);font-size:13px;font-weight:600;cursor:pointer;padding:8px 0 0;display:inline-flex;align-items:center;gap:4px}

/* TRACK AVAILABILITY WIDGET */
.pd-track-widget{background:#fdf8ee;border:1.5px solid var(--gold);border-radius:12px;padding:18px 20px;margin-bottom:15px}
.pd-track-head{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.pd-track-icon{width:30px;height:30px;border-radius:50%;background:#2e7d4f;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pd-track-icon svg{width:15px;height:15px}
.pd-track-title{font-size:17px;font-weight:800;color:var(--dark);margin:0}
.pd-track-stat{font-size:13.5px;color:#555;margin-bottom:14px}
.pd-track-stat strong{color:var(--dark)}
.pd-track-form{display:flex;gap:10px;flex-wrap:wrap}
.pd-track-phone{display:flex;align-items:center;border:1.5px solid var(--gold);border-radius:8px;background:#fff;overflow:hidden;flex:1;min-width:160px}
.pd-track-phone-prefix{padding:0 12px;font-size:14px;font-weight:600;color:var(--dark);border-right:1.5px solid var(--gold);align-self:stretch;display:flex;align-items:center}
.pd-track-input{flex:1;border:none;outline:none;padding:12px;font-size:14px;color:var(--dark);font-family:inherit;min-width:0}
.pd-track-btn{background:#ffd000;color:#1a1a1a;border:none;border-radius:8px;padding:12px 20px;font-size:14px;font-weight:700;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:8px;transition:background .2s}
.pd-track-btn:hover{background:#e6bb00}
@media(max-width:575px){.pd-track-widget{padding:16px}.pd-track-form{flex-direction:column}.pd-track-btn{justify-content:center}}

/* SCHEDULE A WALKTHROUGH BANNER */
.pd-walk-banner{background:#12141c;border-radius:var(--radius);padding:26px 28px;margin-bottom:16px;display:flex;align-items:center;gap:28px;flex-wrap:wrap;position:relative;overflow:hidden}
.pd-walk-banner::before{content:'';position:absolute;right:-40px;top:-40px;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(192,136,48,.18),transparent 70%);pointer-events:none}
.pd-walk-text{flex:1;min-width:240px;position:relative}
.pd-walk-eyebrow{color:var(--gold);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
.pd-walk-text h3{color:#fff;font-size:19px;font-weight:800;margin:0 0 8px;line-height:1.35}
.pd-walk-text p{color:#a9adb8;font-size:13px;line-height:1.6;margin:0}
.pd-walk-form{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;position:relative}
.pd-walk-field{display:flex;flex-direction:column;gap:5px}
.pd-walk-field label{font-size:10.5px;color:#9297a3;text-transform:uppercase;letter-spacing:.3px}
.pd-walk-field select,.pd-walk-field input{background:#1d202b;border:1.5px solid #333747;border-radius:7px;color:#fff;padding:10px 12px;font-size:13px;font-family:inherit;outline:none;min-width:130px}
.pd-walk-field select:focus,.pd-walk-field input:focus{border-color:var(--gold)}
.pd-walk-field input::-webkit-calendar-picker-indicator{filter:invert(1)}
.pd-walk-btn{background:var(--gold);color:#1a1a1a;border:none;border-radius:7px;padding:11px 20px;font-size:13.5px;font-weight:700;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:8px;height:38px}
.pd-walk-btn:hover{background:#a97426}
@media(max-width:767px){.pd-walk-form{width:100%}.pd-walk-field{flex:1;min-width:120px}.pd-walk-field select,.pd-walk-field input{width:100%;min-width:0}}

/* BUILD YOUR IDEAL UNIT CONFIGURATOR */
.pd-cfg-body{background:#f4faf6;border:1px solid #d9ecdf;border-radius:10px;padding:20px}
.pd-cfg-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 20px}
.pd-cfg-tab{background:#fff;border:1.5px solid #d0d0d0;border-radius:6px;padding:9px 22px;font-size:14px;font-weight:700;color:#555;cursor:pointer;transition:all .15s;font-family:inherit}
.pd-cfg-tab.active{background:var(--gold);color:#fff;border-color:var(--gold)}
.pd-cfg-panel{background:#fff;border:1px solid #e2e2e2;border-radius:10px;padding:18px 20px}
.pd-cfg-controls-row{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.pd-cfg-row-label{font-size:12px;font-weight:700;color:#555;margin:0 0 10px}
.pd-cfg-controls-row .pd-cfg-row-label{margin-top:0}
.pd-cfg-select-wrap{position:relative}
.pd-cfg-select{width:100%;appearance:none;background:#fff;border:1.5px solid #d0d0d0;border-radius:6px;padding:11px 36px 11px 14px;font-size:13.5px;font-weight:600;color:#444;font-family:inherit;cursor:pointer}
button.pd-cfg-select{text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pd-cfg-select-wrap svg{position:absolute;right:12px;top:50%;transform:translateY(-50%);width:14px;height:14px;fill:#888;pointer-events:none}
.pd-cfg-floorbond-row{display:flex;gap:8px;flex-wrap:wrap}
.pd-cfg-floorbond-row .pd-cfg-select-wrap{flex:1;min-width:112px}
.pd-cfg-floorbtn.active{background:var(--gold);border-color:var(--gold);color:#fff}
.pd-cfg-floorbtn.active + svg{fill:#fff}
.pd-cfg-pills{display:flex;gap:8px;flex-wrap:wrap}
.pd-cfg-pill{display:inline-flex;align-items:center;gap:6px;background:#fdf9ef;border:1.5px solid #f0dfa6;border-radius:6px;padding:9px 16px;font-size:13.5px;font-weight:600;color:#444;cursor:pointer;transition:all .15s;font-family:inherit}
.pd-cfg-pill svg{width:11px;height:11px;fill:#999;flex-shrink:0}
.pd-cfg-pill.active{background:var(--gold);border-color:var(--gold);color:#fff}
.pd-cfg-pill.active svg{fill:#fff}
.pd-cfg-facing-row{margin-top:20px}
.pd-cfg-selection{background:#f4faf6;border:1.5px solid #cdeada;border-radius:8px;margin-top:20px;overflow:hidden}
.pd-cfg-selection-head{display:flex;align-items:center;justify-content:space-between;padding:10px 18px;border-bottom:1px solid #cdeada;font-size:13.5px;font-weight:700;color:#2e7d4f}
.pd-cfg-selection-head span:last-child{font-size:12.5px;font-weight:600}
.pd-cfg-selection-body{display:flex;align-items:center;gap:14px;padding:16px 18px;flex-wrap:wrap}
.pd-cfg-selection-icon{width:36px;height:36px;flex-shrink:0;color:#2e7d4f}
.pd-cfg-selection-icon svg{width:36px;height:36px}
.pd-cfg-selection-text{flex:1;min-width:180px}
.pd-cfg-selection-main{font-size:15px;font-weight:700;color:var(--dark)}
.pd-cfg-selection-sub{font-size:13px;color:#777;font-weight:400;margin-top:2px}
.pd-cfg-selection-price{font-size:16px;font-weight:800;color:var(--dark);white-space:nowrap}
.pd-cfg-cta-row{padding:16px 18px 20px;text-align:center}
.pd-cfg-cta{background:var(--gold);color:#fff;border:none;border-radius:7px;padding:13px 30px;font-size:13.5px;font-weight:700;cursor:pointer}
.pd-cfg-cta:hover{background:#a97426}
@media(max-width:680px){.pd-cfg-controls-row{grid-template-columns:1fr}}

/* PROPERTY INFORMATION (resale units only) */
.pd-propinfo-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px 24px;margin-top:16px}
.pd-propinfo-cell{padding-bottom:12px;border-bottom:1px solid var(--border,#eee)}
.pd-propinfo-label{font-size:13px;color:var(--text2,#888);margin-bottom:4px}
.pd-propinfo-val{font-size:16px;font-weight:700;color:var(--dark);word-break:break-word}
@media(max-width:900px){.pd-propinfo-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.pd-propinfo-grid{grid-template-columns:1fr 1fr;gap:16px}}

/* FURNISHING DETAILS */
.pd-furn-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-top:16px}
.pd-furn-cell{border:1px solid var(--border,#eee);border-radius:10px;padding:16px 10px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px}
.pd-furn-icon{font-size:26px;color:var(--gold)}
.pd-furn-label{font-size:13px;font-weight:600;color:var(--dark)}
.pd-furn-more{background:#fdf3d9;border-color:#f0dfa6;cursor:pointer;justify-content:center;transition:background .15s}
.pd-furn-more:hover{background:#faecc0}
.pd-furn-more-count{font-size:16px;font-weight:700;color:var(--dark)}
.pd-furn-more-label{font-size:13px;font-weight:600;color:var(--dark);display:flex;align-items:center;gap:5px}
.pd-furn-more-label i{font-size:11px;transition:transform .2s}
.pd-furn-more-label i.pd-furn-open{transform:rotate(180deg)}
@media(max-width:900px){.pd-furn-grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:480px){.pd-furn-grid{grid-template-columns:repeat(3,1fr);gap:10px}.pd-furn-cell{padding:12px 6px}}

/* ABOUT PROJECT (resale units) */
.pd-ap-wrap{display:flex;gap:24px;align-items:stretch}
.pd-ap-imgwrap{flex:0 0 300px;border-radius:10px;overflow:hidden;display:block;background:#eee}
.pd-ap-imgwrap img{width:100%;height:100%;object-fit:cover;display:block;min-height:220px}
.pd-ap-right{flex:1;min-width:0;display:flex;flex-direction:column;gap:14px}
.pd-ap-badges{display:flex;gap:12px;flex-wrap:wrap}
.pd-ap-badge{display:inline-flex;align-items:center;gap:8px;border:1.5px solid var(--border);border-radius:8px;padding:10px 16px;font-size:14px;font-weight:700;color:var(--dark);text-decoration:none;background:#fff}
.pd-ap-badge i{color:#888;font-size:14px}
.pd-ap-badge-link{text-decoration:underline}
.pd-ap-infocard{border:1.5px solid var(--border);border-radius:10px;padding:6px 18px;flex:1}
.pd-ap-info-row{display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid #f0f0f0}
.pd-ap-info-row:last-child{border-bottom:none}
.pd-ap-info-row i{font-size:18px;color:var(--dark);width:22px;text-align:center;flex-shrink:0}
.pd-ap-info-label{font-size:13px;color:#888;margin-bottom:3px}
.pd-ap-info-val{font-size:16px;font-weight:700;color:var(--dark)}
.pd-ap-resale-link{display:flex;align-items:center;justify-content:space-between;gap:10px;background:#fdf8ec;border:1.5px solid var(--gold);border-radius:10px;padding:14px 18px;text-decoration:none;transition:background .15s}
.pd-ap-resale-link:hover{background:#faefd0}
.pd-ap-resale-link span{font-size:15px;font-weight:700;color:var(--dark);line-height:1.4}
.pd-ap-resale-link i{color:var(--dark);font-size:15px;flex-shrink:0}
@media(max-width:767px){
  .pd-ap-wrap{flex-direction:column}
  .pd-ap-imgwrap{flex:none;width:100%;height:200px}
}

/* HOTSPOTS IN CITY */
.pd-hotspot-tabs{display:flex;gap:10px;flex-wrap:nowrap;margin-bottom:18px;overflow-x:auto;scrollbar-width:none}
.pd-hotspot-tabs::-webkit-scrollbar{display:none}
.pd-hotspot-tab{border:1.5px solid var(--border);background:#fff;color:var(--dark);font-size:13px;font-weight:600;padding:9px 18px;border-radius:24px;cursor:pointer;white-space:nowrap;flex-shrink:0;transition:all .2s;font-family:inherit}
.pd-hotspot-tab:hover{border-color:var(--gold)}
.pd-hotspot-tab.active{background:var(--dark);border-color:var(--dark);color:#fff}
.pd-hotspot-track{display:flex;gap:26px}
.pd-hotspot-card{flex-shrink:0;width:150px;text-decoration:none;display:flex;flex-direction:column;align-items:center;text-align:center}
.pd-hotspot-img-ring{width:130px;height:130px;border-radius:50%;border:2px solid var(--gold);padding:4px;margin-bottom:12px;flex-shrink:0}
.pd-hotspot-img-ring img{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block;background:#eee}
.pd-hotspot-name{font-size:14px;font-weight:700;color:var(--dark);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.pd-hotspot-loc{font-size:12px;color:#888;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.pd-hotspot-price{font-size:13px;font-weight:700;color:var(--dark);margin-top:6px}
.pd-hotspot-viewall{display:inline-flex;align-items:center;gap:6px;margin-top:20px;font-size:13.5px;font-weight:700;color:var(--gold);text-decoration:none;border:1.5px solid var(--gold);border-radius:24px;padding:10px 20px;transition:all .2s}
.pd-hotspot-viewall:hover{background:var(--gold);color:#fff}
@media(max-width:600px){.pd-hotspot-img-ring{width:100px;height:100px}.pd-hotspot-card{width:120px}}

/* PRICE LIST */
.pd-pricelist-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.pd-pricelist-scroll::-webkit-scrollbar{display:none}
@media(min-width:768px){.pd-pricelist-scroll{overflow-x:visible}}
.pd-pricelist-table{width:100%;border-collapse:collapse;margin-top:4px;white-space:nowrap}
.pd-pricelist-table thead tr{background:#f6f6f6}
.pd-pricelist-table th{padding:10px 15px 15px;font-size:13px;font-weight:500;color:var(--text2);text-align:left;border:1px solid #f6f6f6}
.pd-pricelist-table td{padding:5px 15px;font-size:14px;border:1px solid var(--border);height:45px;vertical-align:middle}
.pd-pricelist-table tbody tr{border-bottom:1px solid var(--border)}
.pd-pricelist-table tbody{border:1px solid #fff}
.pd-pricelist-table .pd-pl-type{font-weight:700;color:var(--dark)}
.pd-pricelist-table .pd-pl-price{font-weight:700;color:var(--dark)}
.pd-pricelist-table .pd-pl-btn{display:inline-block;font-size:13px;font-weight:700;color:var(--dark);text-decoration:underline;cursor:pointer;background:none;border:none;padding:0;font-family:inherit}
.pd-pricelist-table .pd-pl-btn:hover{color:var(--gold)}

/* PROJECT DETAILS TABLE */
.pd-detail-table{width:100%;border-collapse:collapse}
.pd-detail-table tr{border-bottom:1px solid #f5f5f5}
.pd-detail-table tr:last-child{border-bottom:none}
.pd-detail-table td{padding:11px 10px;font-size:13px;vertical-align:top;line-height:22px}
.pd-detail-table td:first-child{color:#888;width:40%;font-weight:500}
.pd-detail-table td:last-child{color:var(--dark);font-weight:600}

/* FLOOR PLAN — tabbed viewer */
.pd-fp-tabs-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}
.pd-fp-tabs-row::-webkit-scrollbar{display:none}
.pd-fp-tab-btn{background:#fff;border:1.5px solid var(--border);border-radius:var(--radius);padding:0 15px;font-size:14px;font-weight:700;color:var(--text2);cursor:pointer;transition:all .15s;height:40px;display:flex;align-items:center;gap:8px;white-space:nowrap}
.pd-fp-tab-btn:hover{border-color:var(--dark)}
.pd-fp-tab-btn.active{background:var(--dark);color:#fff;border-color:var(--dark);pointer-events:none}
.pd-fp-units-bar{display:flex;flex-wrap:wrap;gap:0;border-bottom:2px solid #f0f0f0;margin-bottom:0}
.pd-fp-unit-item{display:flex;flex-direction:column;padding:10px 28px 10px 0;cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-2px}
.pd-fp-unit-item.active{border-bottom-color:#1a1a1a}
.pd-fp-unit-item:not(:last-child){border-right:1px solid #e8e8e8;margin-right:28px}
.pd-fp-sz{font-size:13px;color:#555;margin-bottom:4px}
.pd-fp-pr{font-size:13px;font-weight:700;color:#1a1a1a}
.pd-fp-viewer{text-align:center;padding:28px 0;min-height:200px;background:#fafafa;border-radius:8px;margin-top:20px}
.pd-fp-viewer img{max-width:520px;width:100%;max-height:460px;object-fit:contain;display:inline-block}
.pd-fp-no-img{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px;color:#bbb;font-size:13px;gap:12px}
/* legacy fallback */
.pd-fp-images{display:flex;flex-wrap:wrap;gap:14px;margin-top:16px}
.pd-fp-img-box{border:1px solid var(--border);border-radius:8px;overflow:hidden;cursor:pointer;flex:1;min-width:220px}
.pd-fp-img-box img{width:100%;height:200px;object-fit:contain;background:#f9f9f9;display:block;transition:transform .3s}
.pd-fp-img-box:hover img{transform:scale(1.03)}
.pd-fp-img-label{font-size:12px;color:var(--text2);text-align:center;padding:6px;background:#fafafa;border-top:1px solid var(--border)}
.pd-fp-quote-item{display:none;align-items:center;justify-content:space-between;gap:16px;padding:16px 0 0;margin-top:14px;border-top:1px solid #f0f0f0;flex-wrap:wrap}
.pd-fp-quote-item.active{display:flex}
.pd-fp-quote-info{flex:1;min-width:0}
.pd-fp-quote-title{font-size:15px;font-weight:700;color:var(--dark);margin-bottom:4px}
.pd-fp-quote-price{font-size:13px;color:#555;display:flex;align-items:center;flex-wrap:wrap;gap:4px}
.pd-fp-quote-charges{color:#888;font-size:12px}
.pd-fp-quote-sep{color:#ccc;margin:0 2px}
.pd-fp-quote-btn{display:inline-flex;align-items:center;gap:8px;background:#f5c517;color:#222;font-weight:700;font-size:14px;padding:11px 22px;border-radius:50px;border:none;cursor:pointer;white-space:nowrap;font-family:inherit;flex-shrink:0}

/* AMENITIES */
.pd-amenities-head{display:flex;align-items:center;justify-content:space-between;cursor:pointer;gap:12px}
.pd-amenities-head h2{margin:0;padding:0;border:0}
.pd-amenities-chevron{flex-shrink:0;color:#888;transition:transform .25s}
.pd-amenities-chevron svg{width:20px;height:20px;display:block}
#sec-amenities.collapsed .pd-amenities-chevron,#sec-rera.collapsed .pd-amenities-chevron,#sec-downloads.collapsed .pd-amenities-chevron{transform:rotate(180deg)}
.pd-amenities-body{overflow:hidden;max-height:6000px;transition:max-height .3s ease}
#sec-amenities.collapsed .pd-amenities-body,#sec-rera.collapsed .pd-amenities-body,#sec-downloads.collapsed .pd-amenities-body{max-height:0}
.pd-rera-bldg-icon{width:18px;height:18px;margin-right:7px;color:#444;flex-shrink:0}
.pd-ami-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}
@media(max-width:900px){.pd-ami-grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:600px){.pd-ami-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:420px){.pd-ami-grid{grid-template-columns:repeat(2,1fr)}}
.pd-ami-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;padding:20px 10px;border:1px solid #eee;border-radius:10px;background:#fff;transition:border-color .2s,box-shadow .2s}
.pd-ami-tile:hover{border-color:var(--gold);box-shadow:0 4px 14px rgba(0,0,0,.07)}
.pd-ami-tile.pd-ami-hidden{display:none}
.pd-ami-icon{width:34px;height:34px;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.pd-ami-icon svg{width:34px;height:34px;color:#1a1a1a}
.pd-ami-icon img{width:34px;height:34px;object-fit:contain;filter:grayscale(100%)}
.pd-ami-name{font-size:12.5px;color:#333;line-height:1.3;font-weight:500}
.pd-ami-more-tile{cursor:pointer;background:#fff;border:1px solid #eee;font-family:inherit}
.pd-ami-more-badge{width:42px;height:42px;border-radius:50%;background:#f7ecd9;color:var(--dark);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px}
.pd-ami-more-label{color:var(--gold);text-decoration:underline;font-size:12.5px;font-weight:600}

/* SPECIFICATIONS */
.pd-spec-table{width:100%;border-collapse:collapse}
.pd-spec-category{font-size:13px;font-weight:700;color:var(--dark);background:#f7f7f7;padding:10px 14px;border:1px solid var(--border);border-radius:6px;margin:14px 0 6px;letter-spacing:.3px}
.pd-spec-table tr{border-bottom:1px solid #f5f5f5}
.pd-spec-table tr:nth-child(even){background:#fafafa}
.pd-spec-table td{padding:9px 12px;font-size:13px;vertical-align:top;color:var(--dark);text-align:left}
.pd-spec-table .pd-spec-key{color:#888;width:45%;font-weight:500}

/* DEVELOPER */
.pd-dev-content{font-size:14px;color:#444;line-height:1.8}

/* RERA BADGE */
.pd-rera{display:inline-flex;align-items:center;gap:6px;background:#f0fbf4;border:1px solid #d4edda;border-radius:6px;padding:8px 12px;font-size:12px;color:#333;margin-top:12px}
.pd-rera svg{width:13px;height:13px;fill:#28a745;flex-shrink:0}

/* RERA DETAILS SECTION */
.pd-rera-section{background:#fff;border-radius:14px;padding:28px 32px;margin:28px 0;box-shadow:0 2px 12px rgba(0,0,0,.07)}
#sec-rera .pd-sec-title{font-size:24px}
.pd-rera-intro{font-size:15px;color:#6b7280;line-height:1.7;margin:16px 0 0}
.pd-rera-intro.clamped{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.pd-rera-intro-more{color:#222;text-decoration:underline;cursor:pointer;font-weight:600;white-space:nowrap;display:inline-block;margin-top:2px}
.pd-rera-list{display:flex;flex-direction:column;margin-top:20px}
.pd-rera-card{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:22px 0;border-bottom:1px solid #ececec}
.pd-rera-list .pd-rera-card:last-child{border-bottom:none}
.pd-rera-qr{width:64px;height:64px;flex-shrink:0}
.pd-rera-qr img{width:100%;height:100%;display:block}
.pd-rera-info{flex:1;min-width:0}
.pd-rera-number{font-size:13px;font-weight:700;color:#1a1a2e;margin-bottom:8px;display:flex;align-items:center}
.pd-rera-phase{font-size:14px;color:#666;margin-bottom:8px}
.pd-rera-urlrow{font-size:14px;color:#555}
.pd-rera-urlrow a{color:#1a6eba;text-decoration:none;word-break:break-all}
.pd-rera-urlrow a:hover{text-decoration:underline}
.pd-rera-footer{margin-top:22px;background:#f4f5f7;border-radius:10px;padding:14px 20px;font-size:14px;color:#333;text-align:center}
.pd-rera-footer strong{font-weight:800}
@media(max-width:600px){.pd-rera-card{flex-wrap:wrap;gap:14px}}

/* REVIEWS */
.pd-reviews-wrap{display:flex;gap:24px}
.pd-review-form{flex:1}
.pd-review-list{flex:1.2}
.pd-form-input{width:100%;border:1.5px solid var(--border);border-radius:8px;padding:10px 13px;font-size:13px;color:var(--dark);margin-bottom:10px;outline:none;font-family:inherit;transition:border-color .2s;box-sizing:border-box}
.pd-form-input:focus{border-color:var(--gold)}
.pd-star-wrap{display:flex;gap:6px;font-size:20px;margin-bottom:12px;cursor:pointer}
.pd-star-wrap .fa{color:#ddd;transition:color .15s}.pd-star-wrap .fa.active{color:#f5a623}
.pd-review-submit{width:100%;background:var(--dark);color:#fff;border:none;border-radius:8px;padding:11px;font-size:13px;font-weight:700;cursor:pointer;transition:background .2s}
.pd-review-submit:hover{background:var(--gold)}
.pd-review-item{border:1px solid var(--border);border-radius:8px;padding:14px;margin-bottom:10px}
.pd-review-name{font-size:13px;font-weight:700;color:var(--dark);margin-bottom:4px}
.pd-review-stars{font-size:12px;color:#f5a623;margin-bottom:6px}
.pd-review-comment{font-size:13px;color:#555;line-height:1.6;margin-bottom:5px}
.pd-review-date{font-size:11px;color:#aaa}
@media(max-width:767px){.pd-reviews-wrap{flex-direction:column}}

/* PHOTOS & VIDEOS */
/* Photos slider */
.pd-media-tabs{display:flex;gap:28px;border-bottom:1px solid var(--border);margin-bottom:18px}
.pd-media-tab{background:none;border:none;padding:0 0 12px;font-size:15px;font-weight:600;color:#888;cursor:pointer;font-family:inherit;border-bottom:2px solid transparent;margin-bottom:-1px}
.pd-media-tab.active{color:var(--dark);border-bottom-color:var(--gold)}
.pd-media-tabs{display:flex;gap:28px;border-bottom:1px solid var(--border);margin-bottom:18px}
.pd-media-tab{background:none;border:none;padding:0 0 12px;font-size:15px;font-weight:600;color:#888;cursor:pointer;font-family:inherit;border-bottom:2px solid transparent;margin-bottom:-1px}
.pd-media-tab.active{color:var(--dark);border-bottom-color:var(--gold)}
.pd-photos-slider-wrap{position:relative}
.pd-photos-main-slide{border-radius:10px;overflow:hidden;cursor:pointer}
.pd-photos-main-slide img{width:100%;height:420px;object-fit:cover;display:block;transition:transform .3s}
.pd-photos-main-slide:hover img{transform:scale(1.02)}
.pd-photos-main-slide .pd-phs-counter{position:absolute;bottom:12px;right:14px;background:rgba(0,0,0,.55);color:#fff;font-size:12px;font-weight:600;border-radius:20px;padding:4px 10px;pointer-events:none}
#pdPhotosSlider .splide__arrow{background:#fff;opacity:1;box-shadow:0 2px 8px rgba(0,0,0,.18);width:36px;height:36px}
#pdPhotosSlider .splide__arrow svg{fill:#333;width:14px;height:14px}
#pdPhotosSlider .splide__arrow:hover{background:var(--gold)}
#pdPhotosSlider .splide__arrow:hover svg{fill:#fff}
#pdPhotosSlider .splide__pagination__page{background:#ccc}
#pdPhotosSlider .splide__pagination__page.is-active{background:var(--gold);transform:scale(1.2)}
.pd-photos-thumbs{margin-top:8px}
#pdPhotosThumbs .splide__slide{border-radius:6px;overflow:hidden;opacity:.65;cursor:pointer;border:2px solid transparent;transition:opacity .2s,border-color .2s}
#pdPhotosThumbs .splide__slide.is-active{opacity:1;border-color:var(--gold)}
#pdPhotosThumbs .splide__slide img{width:100%;height:62px;object-fit:cover;display:block}
.pd-video-wrap{margin-top:16px}
.pd-video-wrap h3{font-size:15px;font-weight:700;color:var(--dark);margin:0 0 10px}
.pd-video-frame{position:relative;padding-bottom:56.25%;border-radius:10px;overflow:hidden;background:#000}
.pd-video-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:none}
@media(max-width:767px){.pd-photos-main-slide img{height:260px}}
@media(max-width:480px){.pd-photos-main-slide img{height:210px}}

/* DOWNLOADS HUB */
.pd-dlhub-intro{font-size:15px;color:#6b7280;line-height:1.7;margin:16px 0 0}
.pd-dlhub-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:36px 0 26px}
.pd-dlhub-grid-3{grid-template-columns:repeat(3,1fr)}
.pd-dlhub-card{border:1.5px solid #cfe5da;border-radius:12px;background:#fff;padding:38px 20px 26px;text-align:center;position:relative;margin-top:36px}
.pd-dlhub-card.pd-dlhub-red{border-color:#e8d0cc}
.pd-dlhub-card.pd-dlhub-purple{border-color:#dad4f2}
.pd-dlhub-icon-circle{width:78px;height:78px;border-radius:50%;background:#6fac8d;color:#fff;display:flex;align-items:center;justify-content:center;position:absolute;top:-39px;left:50%;transform:translateX(-50%);box-shadow:0 6px 16px rgba(0,0,0,.12)}
.pd-dlhub-icon-circle svg{width:34px;height:34px}
.pd-dlhub-icon-circle.pd-dlhub-red{background:#bf6f65}
.pd-dlhub-icon-circle.pd-dlhub-purple{background:#7d6fc7}
.pd-dlhub-body{padding-top:20px}
.pd-dlhub-card-title{font-size:19px;font-weight:700;color:#1a1a1a;margin-bottom:8px}
.pd-dlhub-card-sub{font-size:13px;color:#888;margin-bottom:18px;line-height:1.55}
.pd-dlhub-dl-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 22px;border:1.5px solid #ddd;background:#fff;border-radius:8px;font-size:13.5px;font-weight:700;color:#1a1a1a;cursor:pointer;font-family:inherit;transition:background .2s}
.pd-dlhub-dl-btn:hover{background:#f5f5f5}
.pd-dlhub-all-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:15px 40px;background:#1a1a1a;color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;transition:background .2s}
.pd-dlhub-all-btn:hover{background:#333}
@media(max-width:768px){.pd-dlhub-grid-3{grid-template-columns:1fr}}
@media(max-width:600px){.pd-dlhub-grid{grid-template-columns:1fr}}
/* MAP & NEARBY LANDMARKS */
.pd-map-wrap{position:relative;border-radius:10px;overflow:hidden;border:1px solid var(--border);height:260px;background:#e8eaed;margin-bottom:18px}
.pd-map-wrap #nearbyMap,
.pd-map-wrap iframe{width:100%;height:100%;border:none;display:block}
.pd-map-view-btn{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:#1C1C1B;color:#fff;border:none;border-radius:10px;padding:12px 22px;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:8px;font-family:inherit;z-index:10;white-space:nowrap;box-shadow:0 4px 16px rgba(0,0,0,.35)}
.pd-map-view-btn svg{width:16px;height:16px;fill:#fff;flex-shrink:0}
.pd-map-view-btn:hover{background:#333}

/* CHECK TRAVEL TIME */
.pd-tt-row{display:flex;align-items:center;gap:0;margin-bottom:16px}
.pd-tt-search-wrap{position:relative;flex:1;min-width:0}
.pd-tt-input{width:100%;border:1.5px solid var(--border);border-radius:10px;padding:14px 16px;font-size:14px;color:var(--dark);outline:none;font-family:inherit;transition:border-color .2s;box-sizing:border-box}
.pd-tt-input:focus{border-color:var(--dark)}
.pd-tt-suggest{position:absolute;top:calc(100% + 4px);left:0;right:0;background:#fff;border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:50;max-height:280px;overflow-y:auto;display:none}
.pd-tt-suggest.open{display:block}
.pd-tt-suggest-item{padding:12px 16px;font-size:14px;color:var(--dark);cursor:pointer;border-bottom:1px solid #f2f2f2;line-height:1.4}
.pd-tt-suggest-item:last-child{border-bottom:none}
.pd-tt-suggest-item:hover{background:#faf6ea}
.pd-tt-suggest-empty{padding:12px 16px;font-size:13px;color:#999}
.pd-tt-connector{display:flex;align-items:center;gap:2px;padding:0 12px;flex-shrink:0}
.pd-tt-dot{width:10px;height:10px;border-radius:50%;border:2px solid #1c1c1b;flex-shrink:0}
.pd-tt-line{width:22px;height:0;border-top:2px dashed #ccc;flex-shrink:0}
.pd-tt-car{width:40px;height:40px;border-radius:50%;border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pd-tt-car svg{width:18px;height:18px;fill:var(--gold)}
.pd-tt-dest{flex-shrink:0;display:flex;align-items:center;gap:10px;border:1.5px solid var(--border);border-radius:10px;padding:8px 14px 8px 8px;min-width:220px}
.pd-tt-dest img{width:52px;height:44px;object-fit:cover;border-radius:6px;flex-shrink:0;background:#eee}
.pd-tt-dest-name{font-size:13px;font-weight:700;color:var(--dark);line-height:1.3}
.pd-tt-dest-loc{font-size:12px;color:#888;margin-top:2px}
@media(max-width:767px){
  .pd-tt-row{flex-wrap:wrap}
  .pd-tt-search-wrap{flex:1 1 100%;order:1}
  .pd-tt-connector{order:2}
  .pd-tt-dest{order:3;flex:1;min-width:0}
}
.pd-tt-showbtn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;background:#fff;border:1.5px solid var(--border);border-radius:10px;padding:13px;font-size:14px;font-weight:700;color:var(--dark);cursor:pointer;font-family:inherit;transition:border-color .2s}
.pd-tt-showbtn:hover{border-color:var(--dark)}
.pd-tt-showbtn span{font-size:16px;font-weight:400}
.pd-tt-result{margin-top:14px;border:1.5px solid var(--border);border-radius:10px;padding:16px}
.pd-tt-result-addr{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;font-size:14px;font-weight:700;color:var(--dark);margin-bottom:12px}
.pd-tt-result-addr svg{width:16px;height:16px;fill:var(--gold);flex-shrink:0;margin-top:2px}
.pd-tt-result-close{background:none;border:1px solid var(--border);border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;color:#888}
.pd-tt-result-pills{display:flex;gap:10px;flex-wrap:wrap}
.pd-tt-pill{display:flex;align-items:center;gap:8px;background:#f5f5f5;border-radius:20px;padding:8px 16px;font-size:13px;font-weight:600;color:var(--dark)}
.pd-tt-pill svg{width:15px;height:15px;fill:var(--dark)}
.pd-tt-result-loading,.pd-tt-result-error{font-size:13px;color:#888;text-align:center;padding:6px 0}

/* COMPARE */
.pd-compare-wrap{background:#fff;border-radius:var(--radius);padding:22px 24px 24px;margin-bottom:15px}
.pd-compare-wrap .pd-sec-title{margin-bottom:6px}
.pd-compare-sub{font-size:13px;color:#666;line-height:1.6;margin:0 0 20px}
.pd-cmp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid #e8e8e8;border-radius:12px;overflow:hidden}
.pd-cmp-col{display:flex;flex-direction:column;border-right:1px solid #e8e8e8}
.pd-cmp-col:last-child{border-right:none}
.pd-cmp-col--current{background:#fffdf5}
.pd-cmp-head{padding:0;position:relative}
.pd-cmp-img{width:100%;height:170px;object-fit:cover;display:block}
.pd-cmp-badge{position:absolute;top:10px;left:10px;background:#c08830;color:#fff;font-size:10px;font-weight:700;letter-spacing:.6px;padding:4px 8px;border-radius:4px;text-transform:uppercase}
.pd-cmp-info{padding:12px 14px 14px}
.pd-cmp-name{font-size:14px;font-weight:700;color:#1a1a2e;line-height:1.4;margin-bottom:4px}
.pd-cmp-loc{font-size:12px;color:#777;margin-bottom:4px;display:flex;align-items:center;gap:4px}
.pd-cmp-rating{font-size:12px;color:#f5a623;font-weight:600;margin-bottom:10px}
.pd-cmp-enq{width:100%;background:#fff;border:1.5px solid #ddd;border-radius:8px;padding:9px 6px;font-size:13px;font-weight:600;color:#333;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;transition:border-color .2s,color .2s;font-family:inherit}
.pd-cmp-enq:hover{border-color:var(--gold);color:var(--gold)}
.pd-cmp-body{flex:1}
.pd-cmp-field{display:flex;flex-direction:column;padding:10px 14px;border-top:1px solid #f0f0f0}
.pd-cmp-field-label{font-size:11px;color:#888;margin-bottom:3px;letter-spacing:.2px}
.pd-cmp-field-val{font-size:13px;font-weight:700;color:#222;line-height:1.4}
.pd-cmp-field-val.na{font-weight:400;color:#aaa}
.pd-cmp-field-val .pd-cmp-rera-more{font-size:11px;color:var(--gold);font-weight:600;cursor:pointer;background:none;border:none;padding:0;text-decoration:underline;font-family:inherit;vertical-align:middle;margin-left:4px}
.pd-cmp-cta-row{display:flex;align-items:center;gap:12px;margin-top:18px;flex-wrap:wrap}
.pd-cmp-enq-all{flex:1;min-width:160px;background:#fff;border:1.5px solid #333;border-radius:10px;padding:13px 18px;font-size:14px;font-weight:700;color:#333;cursor:pointer;text-align:center;transition:background .2s,color .2s;font-family:inherit}
.pd-cmp-enq-all:hover{background:#333;color:#fff}
.pd-cmp-view-btn{flex:1;min-width:160px;background:#ffd000;color:#000;border:none;border-radius:10px;padding:13px 18px;font-size:14px;font-weight:700;cursor:pointer;text-align:center;transition:background .2s;font-family:inherit}
.pd-cmp-view-btn:hover{background:#e6bb00}
@media(max-width:768px){
  .pd-cmp-grid{grid-template-columns:repeat(2,1fr)}
  .pd-cmp-col:nth-child(3){display:none}
}
@media(max-width:480px){
  .pd-cmp-grid{grid-template-columns:1fr}
  .pd-cmp-col:nth-child(2){display:none}
  .pd-compare-wrap{padding:16px 14px 18px}
}
/* SIMILAR */
.pd-similar-wrap{background:#fff;border-radius:var(--radius);padding:0 18px 18px;margin-bottom:15px}
.pd-sim-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.pd-sim-arrows{display:flex;gap:8px}
.pd-sim-arr{width:34px;height:34px;border-radius:50%;border:1.5px solid var(--border);background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0}
.pd-sim-arr:hover{border-color:var(--gold);background:var(--gold);color:#fff}
.pd-sim-arr svg{width:16px;height:16px;fill:currentColor;pointer-events:none}
.pd-sim-arr:disabled{opacity:.35;cursor:default;pointer-events:none}
/* Desktop: clip viewport, no scroll */
.pd-sim-viewport{overflow:hidden}
.pd-sim-scroll{display:flex;gap:14px;transition:transform .35s cubic-bezier(.4,0,.2,1)}
.pd-sim-card{flex-shrink:0;width:260px;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:#fff;transition:box-shadow .2s}
.pd-sim-card:hover{box-shadow:0 4px 18px rgba(0,0,0,.10)}
.pd-sim-card figure{position:relative;margin:0;height:160px;overflow:hidden}
.pd-sim-card figure img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
.pd-sim-card:hover figure img{transform:scale(1.03)}
/* Mobile: native scroll, hide arrows */
@media(max-width:767px){
  .pd-sim-arrows{display:none}
  .pd-sim-viewport{overflow-x:auto;scrollbar-width:none}
  .pd-sim-viewport::-webkit-scrollbar{display:none}
  .pd-sim-scroll{transition:none}
}
.pd-sim-badge{position:absolute;top:10px;left:10px;background:var(--gold);color:#fff;font-size:10px;font-weight:700;padding:3px 9px;border-radius:4px}
.pd-sim-wish{position:absolute;top:10px;right:10px;width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,.9);border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#888}
.pd-sim-wish svg{width:14px;height:14px}
.pd-sim-wish:hover{color:var(--gold)}
.pd-sim-body{padding:12px}
.pd-sim-name{font-size:13px;font-weight:700;color:var(--dark);margin-bottom:5px;line-height:1.3}
.pd-sim-loc{font-size:12px;color:var(--text2);display:flex;align-items:center;gap:3px;margin-bottom:6px}
.pd-sim-loc svg{width:11px;height:11px;fill:var(--gold);flex-shrink:0}
.pd-sim-price-row{display:flex;align-items:flex-end;justify-content:space-between;gap:8px;margin-bottom:6px}
.pd-sim-price{font-size:13px;font-weight:700;color:var(--gold)}
.pd-sim-price-note{color:var(--text2);font-weight:400}
.pd-sim-possession{font-size:11px;font-weight:700;color:var(--dark);text-align:right;white-space:nowrap}
.pd-sim-possession span{display:block;font-size:9.5px;font-weight:400;color:#999}
.pd-sim-stats-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px;flex-wrap:wrap}
.pd-sim-stats{font-size:11px;color:var(--text2);display:flex;gap:6px}
.pd-sim-rera{display:flex;align-items:center;gap:4px;font-size:10.5px;font-weight:600;color:#1f9d55;white-space:nowrap}
.pd-sim-rera svg{width:12px;height:12px;flex-shrink:0}
.pd-sim-view-btn{display:block;text-align:center;border:1.5px solid var(--gold);color:var(--dark);background:#fffdf6;border-radius:6px;padding:8px;font-size:12.5px;font-weight:700;text-decoration:none !important}
.pd-sim-view-btn:hover{background:var(--gold);color:#fff}

/* PROJECTS BY DEVELOPER filter tabs */
.pd-dp-tabs{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 16px}
.pd-dp-tab{border:1.5px solid var(--border);background:#fff;color:var(--dark);font-size:13px;font-weight:600;padding:9px 18px;border-radius:24px;cursor:pointer;transition:all .2s;font-family:inherit}
.pd-dp-tab:hover{border-color:var(--gold)}
.pd-dp-tab.active{background:var(--dark);border-color:var(--dark);color:#fff}

/* SIDEBAR WHY CONSIDER CARD */
.pd-sidebar-why{background:#fff;border-radius:var(--radius);padding:18px 18px 16px;margin-bottom:15px}
.pd-sidebar-why-title{font-size:15px;font-weight:700;color:var(--dark);margin-bottom:14px;line-height:1.4}
/* Why-Invest: mobile copy sits right after About Project, desktop copy stays in the sidebar */
.pd-why-mobile-copy{display:none}
@media(max-width:991px){
    .pd-why-mobile-copy{display:block}
    .pd-why-desktop-copy{display:none}
}
/* RIGHT PANEL */
.pd-panel{background:var(--bg);border-radius:var(--radius);overflow:hidden}
.pd-panel-why-project{background:#fff;border:1px solid #e8e8e8;border-radius:12px;padding:16px 18px;margin-bottom:15px;display:flex;flex-direction:column;gap:10px}
.pd-wcp-header{display:flex;align-items:flex-start;justify-content:space-between}
.pd-wcp-badge{width:44px;height:47px;flex-shrink:0}
.pd-wcp-badge img{width:100%;height:100%;display:block}
.pd-wcp-dots{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-top:2px}
.pd-wcp-dots span{width:3px;height:3px;border-radius:50%;background:#e3e3e3;display:block}
.pd-wcp-label{font-size:11px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:#888;margin:2px 0 0}
.pd-wcp-accent{color:#2e7d4f}
.pd-wcp-underline{width:28px;height:3px;background:var(--dark);border-radius:2px;margin:8px 0 4px}
.pd-wcp-banner{position:relative;margin-top:2px;border-radius:10px;overflow:hidden;height:150px}
.pd-wcp-banner img{width:100%;height:100%;object-fit:cover;display:block;-webkit-mask-image:linear-gradient(to right,transparent,#000 35%);mask-image:linear-gradient(to right,transparent,#000 35%)}
.pd-wcp-footer{display:flex;align-items:center;justify-content:space-between;gap:6px;margin:6px -18px -16px;padding:14px 8px;background:#f6f6f4;border-top:1px solid #ececec;border-radius:0 0 12px 12px}
.pd-wcp-footer-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;text-align:center;color:#2e7d4f}
.pd-wcp-footer-item svg{width:20px;height:20px}
.pd-wcp-footer-item span{font-size:10px;font-weight:700;color:#444;line-height:1.3}
.pd-wcp-footer-sep{width:1px;height:30px;background:#ddd;flex-shrink:0}
.pd-panel-urgency{display:flex;align-items:center;gap:8px;border:1px solid #f0c040;background:#fffbeb;border-radius:var(--radius);padding:10px 14px;margin-bottom:12px;font-size:13px;font-weight:600;color:#5a3e00}
.pd-panel-urgency-sep{color:#ccc;margin:0 4px}
.pd-panel-urgency-sub{font-weight:400;color:#666}
.pd-panel-card{background:#fff;border-radius:var(--radius);padding:18px 18px 20px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:15px}
.pd-panel-brand{display:flex;align-items:flex-start;gap:12px;margin-bottom:16px}
.pd-panel-logo{width:68px;height:52px;border-radius:6px;overflow:hidden;background:#1c1c1b;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pd-panel-logo img{width:100%;height:100%;object-fit:contain;padding:4px}
.pd-panel-brand-text{flex:1}
.pd-panel-brand-label{font-size:11px;color:#888;margin-bottom:3px}
.pd-panel-brand-title{font-size:14px;font-weight:700;color:var(--dark);line-height:1.35}
.pd-panel-form-fields{display:flex;flex-direction:column;gap:14px;margin-bottom:14px}
.pd-panel-input{width:100%;border:1.5px solid #ddd;border-radius:10px;padding:13px 14px;font-size:14px;color:var(--dark);margin:0;outline:none;font-family:inherit;transition:border-color .2s;box-sizing:border-box;background:#fff}
.pd-panel-input:focus{border-color:#aaa}
.pd-panel-input::placeholder{color:#aaa}
.pd-panel-phone-row{display:flex;gap:0;margin:0;border:1.5px solid #ddd;border-radius:10px;overflow:hidden;transition:border-color .2s}
.pd-panel-phone-row:focus-within{border-color:#aaa}
.pd-panel-phone-prefix{display:flex;align-items:center;gap:5px;padding:0 12px;font-size:14px;font-weight:600;color:var(--dark);background:#fff;border-right:1.5px solid #ddd;white-space:nowrap;cursor:pointer;min-width:72px}
.pd-panel-phone-prefix svg{width:11px;height:11px;fill:#666}
.pd-panel-phone-input{flex:1;border:none;outline:none;padding:13px 12px;font-size:14px;color:var(--dark);font-family:inherit;background:#fff}
.pd-panel-phone-input::placeholder{color:#aaa}
.pd-panel-submit{width:100%;background:#f5c518;color:#1C1C1B;border:none;border-radius:10px;padding:15px;font-size:15px;font-weight:700;cursor:pointer;transition:background .2s;margin-top:2px;letter-spacing:.2px}
.pd-panel-submit:hover{background:#e0b010}
/* Why invest section */
.pd-panel-why{background:#fff;border-radius:12px;padding:18px 18px 14px;box-shadow:0 2px 12px rgba(0,0,0,.07)}
.pd-panel-why-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:16px}
.pd-panel-why-title{font-size:16px;font-weight:700;color:var(--dark);line-height:1.35;flex:1}
.pd-panel-why-emoji{font-size:36px;line-height:1;margin-top:-4px}
.pd-panel-why-item{display:flex;align-items:flex-start;gap:12px;margin-bottom:14px}
.pd-panel-why-icon{width:38px;height:38px;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.pd-panel-why-icon svg{width:32px;height:32px;fill:none;stroke:var(--dark);stroke-width:1.5}
.pd-panel-why-body{}
.pd-panel-why-label{font-size:13px;font-weight:700;color:var(--dark);margin-bottom:2px}
.pd-panel-why-desc{font-size:12px;color:#666;line-height:1.5}

/* LIGHTBOX */
.pd-lightbox-modal{position:fixed;inset:0;z-index:9999;background:#000;display:none;flex-direction:column}
.pd-lightbox-modal.open{display:flex}
.pd-lb-header{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid #222}
.pd-lb-title{font-size:14px;font-weight:600;color:#fff}
.pd-lb-close{background:none;border:none;color:#fff;font-size:22px;cursor:pointer;line-height:1}
.pd-lb-body{flex:1;display:flex;overflow:hidden}
.pd-lb-viewer{flex:1;position:relative;display:flex;align-items:center;justify-content:center}
.pd-lb-main-img{max-width:100%;max-height:100%;object-fit:contain;display:block}
.pd-lb-arr{position:absolute;top:50%;transform:translateY(-50%);background:rgb(192 136 49);border:none;color:#ffffff;font-size:32px;cursor:pointer;padding:8px 14px;border-radius:6px;line-height:1;transition:background .2s}
.pd-lb-arr:hover{background:#a87228}
.pd-lb-arr-prev{left:10px}.pd-lb-arr-next{right:10px}
.pd-lb-counter{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);color:#ccc;font-size:12px;background:rgba(0,0,0,.5);padding:4px 10px;border-radius:12px}
.pd-lb-form-panel{width:300px;border-left:1px solid #222;padding:20px;overflow-y:auto}
.pd-lb-agent{display:flex;align-items:center;gap:10px;margin-bottom:16px}
.pd-lb-agent-avatar{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--gold),#e8a840);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pd-lb-agent-name{font-size:13px;font-weight:600;color:#fff}
.pd-lb-agent-role{font-size:11px;color:#aaa}
.pd-lb-agent-phone{font-size:12px;color:var(--gold);margin-top:2px}
.pd-lb-form input,.pd-lb-form textarea{width:100%;background:#111;border:1px solid #333;border-radius:6px;padding:9px 11px;color:#fff;font-size:12px;margin-bottom:8px;outline:none;font-family:inherit;box-sizing:border-box}
.pd-lb-form input::placeholder,.pd-lb-form textarea::placeholder{color:#666}
.pd-lb-form-btn{width:100%;background:var(--gold);color:#fff;border:none;border-radius:6px;padding:11px;font-size:13px;font-weight:700;cursor:pointer;transition:background .2s}
.pd-lb-form-btn:hover{background:#a67228}
.pd-lb-privacy{font-size:11px;color:#666;margin-top:8px;text-align:center}
.pd-lb-privacy a{color:#aaa}
.pd-lb-thumbs{display:flex;gap:6px;padding:10px 14px;background:#111;overflow-x:auto;scrollbar-width:none}
.pd-lb-thumbs::-webkit-scrollbar{display:none}
.pd-lb-thumb{flex-shrink:0;width:60px;height:45px;border-radius:4px;overflow:hidden;cursor:pointer;border:2px solid transparent;transition:border-color .2s}
.pd-lb-thumb.active,.pd-lb-thumb:hover{border-color:var(--gold)}
.pd-lb-thumb img{width:100%;height:100%;object-fit:cover}
.pd-lb-backdrop{position:fixed;inset:0;z-index:9998;background:rgba(0,0,0,.7);display:none}
.pd-lb-backdrop.open{display:block}
@media(max-width:767px){.pd-lb-form-panel{display:none}}
.pd-vid-sound-btn{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.62);color:#fff;border:1px solid rgba(255,255,255,.35);border-radius:20px;padding:6px 16px;font-size:12px;font-weight:600;cursor:pointer;z-index:10;display:flex;align-items:center;gap:5px;transition:background .2s;white-space:nowrap;pointer-events:all}
.pd-vid-sound-btn:hover{background:rgba(0,0,0,.85)}

/* ===== FIRST FOLD v2 ===== */
.pd-first-fold{background:#fff;margin-bottom:8px;padding:14px 0 8px}
.pd-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-top:14px;margin-bottom:12px;padding:0}
.pd-title-info{flex:1;min-width:0}
.pd-title-h1{font-size:22px;font-weight:700;color:var(--dark);margin:0 0 6px;line-height:1.3;display:inline-block;vertical-align:baseline}
.pd-title-h1-loc{display:inline;font-size:13px;font-weight:400;color:var(--text2)}
.pd-title-h1 .listing-loction{display:block;font-size:14px;font-weight:700;color:var(--text2);line-height:1.3}
.pd-title-h1 strong{display:block;font-size:22px;font-weight:600;color:var(--dark);margin-top:4px}
.pd-title-h1 .listing-id{display:block;font-size:12px;font-weight:400;color:var(--text2);margin-top:4px}
.pd-title-h1-maplink{display:none} /* hidden for now — remove this rule to bring "See on Map" back */
.pd-title-h1-maplink svg{width:13px;height:13px;fill:var(--gold);flex-shrink:0}
.pd-title-h1-maplink:hover{text-decoration:underline}
.pd-title-desc{font-size:13px;color:#555;line-height:1.65;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.pd-title-desc.pd-expanded{-webkit-line-clamp:unset}
.pd-title-desc-toggle{display:none}
.pd-title-mobile-rera{display:none}
.pd-gal-v2{display:grid;grid-template-columns:1fr 360px;gap:8px;height:410px;border-radius:var(--radius);overflow:hidden;margin-top:10px}
.pd-gal-v2.pd-gal-no-imgs{grid-template-columns:1fr}
.pd-gal-no-imgs .pd-gal-main-v2{cursor:default}
.pd-gal-no-imgs .pd-gal-main-v2 img{object-fit:contain;background:#f5f7fa}
.pd-gal-req-btn{position:absolute;bottom:16px;right:16px;display:inline-flex;align-items:center;gap:8px;background:rgba(0,0,0,.65);color:#fff;border:none;border-radius:8px;padding:10px 18px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;backdrop-filter:blur(4px)}
.pd-gal-req-btn:hover{background:rgba(0,0,0,.85)}
.pd-gal-main-v2{position:relative;overflow:hidden;cursor:pointer;border-radius:var(--radius)}
.pd-gal-main-v2 img{width:100%;height:100%;display:block;transition:transform .3s;height:420px;object-fit:contain}
.pd-gal-main-v2:hover img{transform:scale(1.02)}
.pd-gal-cell{position:relative;overflow:hidden;cursor:pointer;border-radius:var(--radius)}
.pd-gal-cell img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}
.pd-gal-cell:hover img{transform:scale(1.04)}
.pd-gal-badges{position:absolute;top:12px;left:12px;display:flex;gap:6px;z-index:2}
.pd-gal-badge-status{background:var(--gold);color:#fff;font-size:11px;font-weight:700;padding:4px 10px;border-radius:4px;letter-spacing:.5px;text-transform:capitalize}
.pd-gal-actions{position:absolute;top:10px;right:10px;display:flex;gap:6px;z-index:2}
.pd-gal-photos-btn{position:absolute;bottom:10px;right:10px;z-index:2;display:flex;align-items:center;gap:6px;background:rgba(255,255,255,.9);border:none;border-radius:6px;padding:8px 14px;font-size:14px;font-weight:700;color:#333;cursor:pointer;transition:background .2s}
.pd-gal-photos-btn:hover{background:#fff}
.pd-gal-photos-btn svg{width:17px;height:17px;fill:currentColor;flex-shrink:0}
.pd-gal-act-btn{display:flex;align-items:center;gap:5px;background:rgba(255,255,255,.9);border:none;border-radius:6px;padding:6px 11px;font-size:12px;font-weight:600;color:#333;cursor:pointer;transition:background .2s}
.pd-gal-act-btn:hover{background:#fff}
.pd-gal-act-btn svg{width:14px;height:14px;fill:currentColor;flex-shrink:0}
.pd-gal-video-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.25);pointer-events:none}
.pd-gal-video-play{width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center}
.pd-gal-video-play svg{width:18px;height:18px;fill:#333;margin-left:3px}
.pd-gal-video-side{display:flex;flex-direction:column;gap:8px;height:100%}
.pd-gal-vid-wrap{flex:1;position:relative;border-radius:var(--radius);overflow:hidden;background:#000}
.pd-gal-vid-wrap.pd-gal-vid-full{flex:1}
.pd-gal-vid-wrap iframe{position:absolute;top:50%;left:0;width:100%;height:177.78%;transform:translateY(-50%);border:none}
.pd-ig-banner-iframe{top:-64px!important;height:calc(100% + 112px)!important}

/* ===== First-fold header redesign (pixel match, 2026-08-20) ===== */
.pd-title-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;flex-wrap:wrap}
.pd-title-head-left{display:flex;align-items:flex-start;gap:12px;min-width:0}
.pd-title-devlogo{width:44px;height:44px;flex-shrink:0;border:1px solid var(--border);border-radius:6px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:4px}
.pd-title-devlogo img{width:100%;height:100%;object-fit:contain}
.pd-title-namewrap{min-width:0}
.pd-title-price{flex-shrink:0;text-align:right}
.pd-title-price-main{font-size:24px;font-weight:800;color:var(--dark);line-height:1.2;white-space:nowrap}
.pd-title-price-onwards{font-size:11px;font-weight:600;color:var(--text2);vertical-align:super}
.pd-title-price-sub{font-size:12px;color:var(--text2);margin-top:3px}
.pd-title-price-sub .pd-ib-price-charges{margin-left:0}
.pd-title-price-rera{margin-top:6px}
.pd-read-more-inline{color:#0a66c2;text-decoration:none;font-weight:600;cursor:pointer;font-size:13px;white-space:nowrap}
.pd-read-more-inline:hover{text-decoration:underline}

/* Trust badges row */
.pd-trust-row{display:flex;align-items:center;flex-wrap:wrap;gap:10px 16px;margin-top:10px;font-size:12.5px}
.pd-trust-item{display:flex;align-items:center;gap:5px;color:#2e7d32;font-weight:600}
.pd-trust-item svg{width:13px;height:13px;flex-shrink:0}
.pd-trust-item.pd-trust-neutral{color:var(--text2);font-weight:500}
.pd-trust-item.pd-trust-link{text-decoration:underline;cursor:pointer}
.pd-trust-sep{color:#ddd}

/* Gallery: two stacked side tiles (pixel-match reference) */
.pd-gal-side-stack{display:flex;flex-direction:column;gap:8px;height:100%;height:408px}
.pd-gal-side-stack .pd-gal-cell{flex:1}
.pd-gal-cell-overlay{position:absolute;inset:0;background:rgba(0,0,0,.4);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:#fff;text-align:center;pointer-events:none}
.pd-gal-cell-overlay svg{width:26px;height:26px;fill:#fff}
.pd-gal-cell-overlay .pd-gal-cell-count{font-size:15px;font-weight:800}
.pd-gal-cell-overlay .pd-gal-cell-caption{font-size:12px;font-weight:600}
.pd-gal-play-circle{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center}
.pd-gal-play-circle svg{width:15px;height:15px;fill:#333;margin-left:2px}

/* Main image dot pagination */
.pd-gal-dots{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);display:flex;gap:5px;z-index:3}
.pd-gal-dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.55);border:none;padding:0;cursor:pointer;transition:background .15s,width .15s}
.pd-gal-dot.active{background:#fff;width:16px;border-radius:3px}

/* Specs grid (2 rows x 5 cols, pixel match) */
.pd-specs-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px 12px}
.pd-specs-item{display:flex;align-items:flex-start;gap:9px;min-width:0}
.pd-specs-icon{width:22px;height:22px;flex-shrink:0;color:#555}
.pd-specs-icon svg{width:100%;height:100%}
.pd-specs-text{min-width:0}
.pd-specs-label{font-size:11.5px;color:var(--text2);line-height:1.3;margin-bottom:2px}
.pd-specs-val{font-size:13px;font-weight:700;color:var(--dark);line-height:1.3;word-break:break-word}
@media(max-width:900px){.pd-specs-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:575px){.pd-specs-grid{grid-template-columns:repeat(2,1fr)}}

.pd-infobar{display:flex;align-items:flex-start;gap:6px;background:transparent;margin-top:8px;margin-bottom:0;padding:0 0 8px}
.pd-ib-left {
    flex: 1;
    min-width: 0;
    padding: 18px 0;
    background: #fff;
    border-radius: var(--radius);
    height: fit-content;
    border: 1px solid #efefef;
    padding: 15px;
}
@media(max-width:900px){.pd-infobar{flex-direction:column;gap:12px}}
/* Price row */
.pd-ib-price-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:16px;border-bottom:1px solid #f0f0f0;margin-bottom:16px}
.pd-ib-price-left{display:flex;align-items:center;gap:12px}
.pd-ib-price-main{font-size:18px;font-weight:800;color:var(--dark);line-height:1.2}
.pd-ib-price-charges{font-size:13px;color:var(--text2);font-weight:400;margin-left:5px}
.pd-ib-price-sqft{font-size:14px;color:var(--text2);margin-top:4px;font-weight:500}
.pd-ib-insight-btn{display:inline-flex;align-items:center;gap:6px;border:1.5px solid var(--gold);background:#fff;color:var(--gold);border-radius:20px;padding:8px 18px;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;flex-shrink:0;transition:background .2s,color .2s;font-family:inherit}
.pd-ib-insight-btn:hover{background:var(--gold);color:#fff}
/* RERA badge */
.pd-ib-rera-badge-wrap{position:relative;display:inline-flex;align-items:center;flex-shrink:0}
.pd-ib-rera-badge{display:inline-flex;align-items:center;border-radius:20px;overflow:hidden;flex-shrink:0}
.pd-ib-rera-badge-main{display:flex;align-items:center;gap:5px;padding:7px 12px;background:#4db6ac;border:none;color:#fff;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap}
.pd-ib-rera-badge-main:hover{background:#3da89e}
.pd-ib-rera-info-wrap{position:relative;display:flex;align-items:center}
.pd-ib-rera-iicon{font-size:12px;opacity:.7;margin-left:4px}
.pd-ib-rera-badge-wrap{position:relative;display:inline-flex;align-items:center;flex-shrink:0}
.pd-ib-rera-tooltip{display:none;position:absolute;top:calc(100% + 10px);left:0;background:#fff;border:1px solid #e0e0e0;border-radius:12px;box-shadow:0 8px 28px rgba(0,0,0,0.12);padding:16px 18px;min-width:240px;max-width:300px;z-index:999;text-align:left}
.pd-ib-rera-tooltip::before{content:'';position:absolute;top:-7px;left:24px;border-left:7px solid transparent;border-right:7px solid transparent;border-bottom:7px solid #e0e0e0}
.pd-ib-rera-tooltip::after{content:'';position:absolute;top:-6px;left:24px;border-left:6px solid transparent;border-right:6px solid transparent;border-bottom:6px solid #fff}
.pd-ib-rera-tooltip-title{font-size:15px;font-weight:800;color:#1a1a2e;margin-bottom:8px}
.pd-ib-rera-tooltip-src{display:flex;align-items:flex-start;gap:6px;font-size:12px;color:#555;margin-bottom:10px;word-break:break-all}
.pd-ib-rera-tooltip-src a{color:#0a66c2;text-decoration:none}
.pd-ib-rera-tooltip-src a:hover{text-decoration:underline}
.pd-ib-rera-tooltip-status{font-size:10px;font-weight:800;color:var(--gold);letter-spacing:1px;text-transform:uppercase;margin-bottom:4px}
.pd-ib-rera-tooltip-phase{font-size:14px;font-weight:700;color:#1a1a2e;margin-bottom:2px}
.pd-ib-rera-tooltip-num{font-size:13px;color:#555}
.pd-ib-rera-badge-wrap:hover .pd-ib-rera-tooltip{display:block}
.pd-ib-why-card{flex:1}
.pd-ib-why-title{font-size:22px;font-weight:800;color:var(--dark);margin:0;line-height:1.22}
.pd-ib-why-list{list-style:none;padding-left:0;margin:4px 0 4px;display:flex;flex-direction:column}
.pd-ib-why-list li{position:relative;display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid #eee}
.pd-ib-why-list li:last-child{border-bottom:none;padding-bottom:2px}
.pd-ib-why-list li:not(:last-child)::after{content:'';position:absolute;right:0;bottom:-4px;width:7px;height:7px;border-radius:50%;background:#ddd}
.pd-ib-why-icon{width:36px;height:36px;border-radius:50%;background:#f2f6f3;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pd-ib-why-icon svg{width:17px;height:17px;fill:none;stroke:#2e7d4f;stroke-width:2}
.pd-ib-why-list li span{font-size:14px;font-weight:700;color:#222;line-height:1.45;padding-top:6px}
.pd-ib-why-more{font-size:12px;color:var(--gold);font-weight:600;cursor:pointer;background:none;border:none;padding:0;text-decoration:underline;font-family:inherit;text-align:left}
.pd-ib-why-para{font-size:14px;color:#444;line-height:1.7;margin:0 0 10px;}
.pd-ib-why-table{width:100%;border-collapse:collapse;font-size:12px;margin-bottom:8px;}
.pd-ib-why-table tr{border-bottom:1px solid #f0f0f0;}
.pd-ib-why-table td{padding:5px 6px;color:#444;}
.pd-ib-why-tbl-k{font-weight:700;color:#1a1a2e;width:44%;}
/* Why modal */
.pd-why-modal{display:none;position:fixed;inset:0;z-index:99999;align-items:flex-end;justify-content:center}
.pd-why-modal.open{display:flex}
.pd-why-overlay{position:absolute;inset:0;background:rgba(0,0,0,.5);animation:pdWOverlay .25s ease}
.pd-why-sheet{position:relative;z-index:1;background:#fff;border-radius:20px 20px 0 0;width:100%;max-width:520px;max-height:85vh;overflow-y:auto;padding:24px 22px 28px;transform:translateY(100%);animation:pdWSlide .35s cubic-bezier(.32,1,.28,1) forwards}
.pd-why-sheet.closing{animation:pdWSlideOut .28s ease forwards}
.pd-why-modal-handle{width:40px;height:4px;background:#ddd;border-radius:4px;margin:0 auto 18px}
.pd-why-modal-title{font-size:16px;font-weight:700;color:var(--dark);margin-bottom:16px;line-height:1.4}
.pd-why-modal-list{list-style:none;padding:0;margin:0 0 20px;display:flex;flex-direction:column;gap:12px}
.pd-why-modal-list li{font-size:14px;color:#444;line-height:1.6;display:flex;gap:10px;align-items:flex-start}
.pd-why-modal-list li::before{content:"•";color:var(--gold);font-size:18px;flex-shrink:0;line-height:1.2}
.pd-why-modal-close{display:block;width:100%;background:var(--dark);color:#fff;border:none;border-radius:10px;padding:14px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;letter-spacing:.3px}
.pd-why-modal-close:hover{background:#333}
@keyframes pdWOverlay{from{opacity:0}to{opacity:1}}
@keyframes pdWSlide{from{transform:translateY(100%)}to{transform:translateY(0)}}
@keyframes pdWSlideOut{from{transform:translateY(0)}to{transform:translateY(100%)}}
.pd-ib-cta{width:100%;background:#ffd000;color:#000;border:none;border-radius:10px;padding:14px 10px;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:background .2s;margin-top:auto;line-height:1.3}
.pd-ib-cta:hover{background:#e6bb00}
@media(max-width:991px){
  .pd-gal-v2{grid-template-columns:1fr;height:280px}
  .pd-gal-side-stack{display:none}
}
@media(max-width:575px){
  .pd-title-h1{font-size:19px}
}

/* MOBILE SLIDER */
.pd-ms{display:none!important}
.pd-ms-tabs{display:none!important}
@media(max-width:767px){
  .pd-first-fold{margin-bottom:0;padding:0}
  .pd-page .container{padding-left:0;padding-right:0}
  .pd-gal-v2{display:none!important}
  .pd-ms{display:block!important}
  .pd-ms-tabs{display:flex!important}
  /* Visual-only reorder for mobile first fold: gallery -> tabs -> title/dev-card -> price/stats.
     No DOM duplication (keeps the single <h1> intact for SEO) -- desktop is untouched since
     .pd-ff-flow only becomes a flex container inside this media query. */
  .pd-ff-flow{display:flex;flex-direction:column}
  .pd-ms{order:1}
  .pd-ms-tabs{order:2}
  .pd-title-row{order:3}
  .pd-infobar{order:4}

  .pd-title-h1{font-size:19px}
  .pd-title-mobile-rera{display:inline-flex;align-items:center;gap:4px;background:none;border:none;padding:2px 0 0;font-size:12px;font-weight:600;color:#1e9e50;cursor:pointer;text-decoration:underline dotted;text-underline-offset:2px}

  /* Read more toggle on the short description */
  .pd-title-desc-toggle{display:inline-flex;font-size:12px;padding:4px 0 0}
  .pd-title-desc-toggle svg{transition:transform .2s}
  .pd-title-desc-toggle.pd-expanded svg{transform:rotate(180deg)}

  /* Boxed-card look for price/status/stats, matching the reference layout */
  .pd-ib-left{border:1px solid #eee;border-radius:12px;padding:14px 14px;margin-top:4px}

  .pd-ms{display:block;position:relative;border-radius:12px;overflow:visible;touch-action:pan-y}
  .pd-ms-viewport{height:330px;overflow:hidden;position:relative;background:#111}
  .pd-ms-track{display:flex;height:100%;transition:transform .38s cubic-bezier(.4,0,.2,1)}
  .pd-ms-slide{flex:0 0 100%;position:relative;height:100%;overflow:hidden;background:#111}
  .pd-ms-slide img{width:100%;height:100%;object-fit:cover;display:block}
  .pd-ms-slide-video .pd-ms-vid-inner{position:absolute;inset:0}
  .pd-ms-slide-video iframe{position:absolute;top:50%;left:0;width:100%;height:177.78%;transform:translateY(-50%);border:none}
  .pd-ms-badge{position:absolute;top:10px;left:10px;background:var(--gold,#c8963e);color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:4px;letter-spacing:.5px;z-index:4;pointer-events:none}
  .pd-ms-navbar{position:absolute;top:0;left:0;right:0;display:flex;align-items:center;gap:10px;padding:12px 12px;z-index:5;background:linear-gradient(rgba(0,0,0,.5),transparent)}
  .pd-ms-nav-back,.pd-ms-nav-icon-btn{background:rgba(0,0,0,.35);border:none;border-radius:50%;width:34px;height:34px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff;cursor:pointer;padding:0;-webkit-tap-highlight-color:transparent}
  .pd-ms-nav-spacer{flex:1}
  .pd-ms-overlay{position:absolute;bottom:0;left:0;right:0;height:68px;background:linear-gradient(transparent,rgba(0,0,0,.55));pointer-events:none;z-index:2;border-radius:0 0 12px 12px}
  .pd-ms-footer{position:absolute;bottom:9px;left:10px;right:10px;display:flex;align-items:center;justify-content:space-between;z-index:3;pointer-events:none}
  .pd-ms-dots{display:flex;gap:4px;align-items:center;pointer-events:all}
  .pd-ms-dot{width:6px;height:6px;border-radius:3px;background:rgba(255,255,255,.45);border:none;padding:0;cursor:pointer;transition:all .25s;flex-shrink:0}
  .pd-ms-dot.active{background:#fff;width:18px}
  .pd-ms-counter{background:rgba(0,0,0,.5);color:#fff;font-size:11px;font-weight:600;padding:2px 8px;border-radius:10px}
  .pd-ms-tabs{display:flex;gap:6px;margin-top:8px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding-bottom:2px}
  .pd-ms-tabs::-webkit-scrollbar{display:none}
  .pd-ms-tab{flex:0 0 76px;border-radius:10px;overflow:hidden;border:2px solid transparent;background:#fff;box-shadow:0 1px 5px rgba(0,0,0,.13);cursor:pointer;padding:0;-webkit-tap-highlight-color:transparent;transition:border-color .2s}
  .pd-ms-tab.active{border-color:var(--gold,#c8963e)}
  .pd-ms-tab img{width:76px;height:54px;object-fit:cover;display:block}
  .pd-ms-tab-label{font-size:10px;font-weight:600;color:#555;padding:3px 4px 4px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center;background:#fff}
  .pd-ms-tab.active .pd-ms-tab-label{color:var(--gold,#c8963e)}
}
/* MOBILE FIXED ACTION BAR */
.pd-mob-bar{display:none}
@media(max-width:991px){
  .pd-mob-bar{
    display:flex;position:fixed;bottom:0;left:0;right:0;z-index:9999;
    background:#fff;border-top:1px solid #e0e0e0;
    box-shadow:0 -2px 12px rgba(0,0,0,.12);
    height:62px;align-items:stretch;
  }
  body{padding-bottom:62px}
  .pd-mob-bar-btn{
    flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:4px;text-decoration:none;border:none;background:none;cursor:pointer;
    font-family:inherit;font-size:11px;font-weight:700;color:#222;
    border-right:1px solid #e8e8e8;padding:0 6px;
    transition:background .15s;
    -webkit-tap-highlight-color:transparent;
  }
  .pd-mob-bar-btn:last-child{border-right:none}
  .pd-mob-bar-btn:active{background:#f5f5f5}
  .pd-mob-bar-btn svg{width:22px;height:22px;flex-shrink:0}
  .pd-mob-bar-btn img{width:36px!important;height:36px!important;flex-shrink:0;object-fit:contain}
  .pd-mob-bar-enquire{
    flex:1.4;background:#c08830;color:#fff;border-right:none;
    font-size:12px;letter-spacing:.2px;
  }
  .pd-mob-bar-enquire:active{background:#a87228}
  .pd-mob-bar-enquire svg{fill:#fff}
  .pd-mob-bar-call svg{fill:#25a244}
  .pd-mob-bar-wa svg{fill:#25D366}
}
/* PRICE LIST SECTION */
.pd-section{background:#fff;border-radius:var(--radius);padding:0 18px 18px;margin-bottom:15px}
/* DEVELOPER SECTION */
.pd-dev-section{background:#fff;border-radius:var(--radius);padding:0 18px 18px;margin-bottom:15px}
.pd-dev-inner{display:flex;gap:24px;align-items:flex-start;margin-top:16px}
.pd-dev-logo-wrap{flex-shrink:0;width:100px;height:100px;border-radius:10px;border:1px solid #e8e8e8;background:transparent;display:flex;align-items:center;justify-content:center;overflow:hidden}
.pd-dev-logo-wrap img{max-width:100%;max-height:100%;object-fit:contain;padding:8px}
.pd-dev-logo-placeholder{width:100px;height:100px;border-radius:10px;border:1px solid #e8e8e8;background:#f5f5f5;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.pd-dev-logo-placeholder svg{width:36px;height:36px;fill:#ccc}
.pd-dev-body{flex:1;min-width:0}
.pd-dev-name{font-size:17px;font-weight:800;color:var(--dark);margin:0 0 4px}
.pd-dev-exp{font-size:12px;color:var(--gold);font-weight:700;margin-bottom:10px;text-transform:uppercase;letter-spacing:.4px}
.pd-dev-about{font-size:13px;color:#555;line-height:1.8}
.pd-dev-about p{margin:0 0 8px}.pd-dev-about p:last-child{margin:0}
.pd-dev-about-wrap{position:relative}
.pd-dev-about-wrap.collapsed .pd-dev-about{overflow:hidden;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical}
.pd-dev-readmore{display:inline-block;margin-top:8px;font-size:12px;font-weight:700;color:var(--gold);cursor:pointer;background:none;border:none;padding:0;font-family:inherit;text-decoration:underline}
@media(max-width:575px){.pd-dev-inner{flex-direction:column;gap:16px}.pd-dev-logo-wrap,.pd-dev-logo-placeholder{width:72px;height:72px}}
/* FAQ SECTION */
.pd-faq-section{background:var(--bg);padding:0 0 32px}
.pd-faq-section h2{font-size:18px;font-weight:700;color:var(--dark);margin:0 0 18px;line-height:1.35}
.pd-faq-list{display:flex;flex-direction:column;gap:0}
.pd-faq-item{border-radius:var(--radius);border:1px solid var(--border);margin-bottom:10px;overflow:hidden}
.pd-faq-item:first-child{border-top:1px solid var(--border)}
.pd-faq-q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;background:none;border:none;padding:0 20px;min-height:52px;text-align:left;cursor:pointer;font-family:inherit;font-size:14px;font-weight:600;color:var(--text2);line-height:1.5;position:relative}
.pd-faq-q:hover{color:var(--dark)}
.pd-faq-q strong{max-width:calc(100% - 40px);color:var(--dark);line-height:22px}
.pd-faq-icon{width:20px;height:20px;flex-shrink:0;fill:#bfbfbf;transition:transform .25s}
.pd-faq-item.open .pd-faq-icon{transform:rotate(45deg)}
.pd-faq-a{display:none;padding:0 20px 15px;font-size:13px;color:var(--text2);line-height:20px}
.pd-faq-item.open .pd-faq-a{display:block}
@media(max-width:575px){.pd-faq-section h2{font-size:16px}.pd-faq-q{font-size:13px}}
