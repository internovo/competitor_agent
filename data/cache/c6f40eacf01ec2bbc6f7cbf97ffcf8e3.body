          <!-- City Picker -->
          <div class="rg-city-picker" id="rgCityPicker">
            <button class="rg-city-btn" id="rgCityBtn" onclick="rgToggleCity(event)">
              <i class="fa-solid fa-location-dot" style="color:#FFD000"></i>
              <span id="rgCityLabel">All India</span>
              <i class="fa-solid fa-chevron-down rg-cicon"></i>
