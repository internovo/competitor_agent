        </button>
        <p class="pd-popup-privacy">By submitting, you agree to our <a href="https://www.rathiglobalrealty.com/privacy-policy">Privacy Policy</a></p>
      </form>
    </div>


  </div>
</div>

<style>
/* ===== ENQUIRY POPUP ===== */
.pd-popup-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:99999;display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;visibility:hidden;transition:opacity .25s,visibility .25s}
.pd-popup-overlay.active{opacity:1;visibility:visible}
.pd-popup{background:#fff;border-radius:16px;width:100%;max-width:365px;max-height:96vh;overflow-y:auto;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.3);transform:translateY(18px) scale(.97);transition:transform .28s ease;padding:15px}
.pd-popup-overlay.active .pd-popup{transform:translateY(0) scale(1)}
.pd-popup-close{position:absolute;top:12px;right:12px;background:#fff;border:1px solid #eee;border-radius:50%;width:30px;height:30px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .15s;z-index:5}
.pd-popup-close:hover{background:#f5f5f5}
.pd-popup-close svg{width:16px;height:16px;fill:#1a1a1a}
.pd-popup-head{display:flex;align-items:center;gap:14px;text-align:left;padding:24px 20px 18px;border-bottom:1px solid #f0f0f0}
.pd-popup-logo{width:54px;height:54px;border-radius:12px;flex-shrink:0;background:#1c1c1b;display:flex;align-items:center;justify-content:center}
.pd-popup-logo img{width:100%;height:100%;object-fit:contain;padding:8px;box-sizing:border-box}
.pd-popup-register-text{font-size:16px;font-weight:600;color:#1a1a1a;text-align:left;margin:0;line-height:1.35}
.pd-popup-register-text span{color:#1a9e4a;display:block}
.pd-popup-field{position:relative;display:flex;align-items:center;margin-bottom:14px}
.pd-popup-field-icon{position:absolute;left:13px;width:18px;height:18px;color:#999;pointer-events:none}
.pd-popup-field input{width:100%;height:48px;border:1px solid #ddd;border-radius:8px;padding:0 14px 0 40px;font-size:14px;color:#1a1a1a;outline:none;font-family:inherit;box-sizing:border-box;transition:border-color .15s;background:#fff}
.pd-popup-field input:focus{border-color:#c08830}
.pd-popup-field input::placeholder{color:#aaa}
.pd-popup-submit{width:100%;background:#F5A623;color:#1a1a1a;border:none;border-radius:8px;padding:14px;font-size:15px;font-weight:800;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:background .2s;font-family:inherit;margin:6px 0 12px;text-transform:uppercase}
.pd-popup-submit:hover{background:#e0951a}
.pd-popup-submit:disabled{background:#ccc;cursor:not-allowed}
.pd-popup-error{background:#fff0f0;border:1px solid #ffcccc;border-radius:7px;padding:9px 12px;font-size:13px;color:#c00;margin-bottom:13px}
.pd-popup-success{background:#f0fff4;border:1px solid #b2f5d4;border-radius:7px;padding:9px 12px;font-size:13px;color:#166534;margin-bottom:13px}
.pd-popup-privacy{font-size:11px;color:#999;text-align:center;margin:0 0 4px}
.pd-popup-privacy a{color:#666;font-weight:600}
@media(max-width:480px){
  .pd-popup{max-width:100%}
}
</style>

<script>
function rgrsOpenEnquiry(propName, propId, imgUrl, city, devName) {
  document.getElementById('rgrsEnqPropId').value        = propId   || '';
  document.getElementById('rgrsEnqPropNameField').value = propName || '';
  document.getElementById('rgrsEnqCityField').value     = city     || (window.rgrsCurrentCity || '');
  document.getElementById('rgrsEnqForm').reset();
  document.getElementById('rgrsEnqError').style.display   = 'none';
  document.getElementById('rgrsEnqSuccess').style.display = 'none';
  document.getElementById('rgrsEnqSubmit').disabled       = false;
  document.getElementById('rgrsEnqSubmitText').textContent = 'GET EARLY BOOKING OFFERS';
  document.getElementById('rgrs-enq-overlay').classList.add('active');
  document.body.style.overflow = 'hidden';
  setTimeout(function(){ document.getElementById('rgrsEnqName').focus(); }, 300);
}
function rgrsCloseEnquiry() {
  document.getElementById('rgrs-enq-overlay').classList.remove('active');
  document.body.style.overflow = '';
}
document.getElementById('rgrs-enq-overlay').addEventListener('click', function(e){
  if (e.target === this) rgrsCloseEnquiry();
});
document.addEventListener('keydown', function(e){
  if (e.key === 'Escape') rgrsCloseEnquiry();
});
function rgrsFireDownload(pending) {
  (pending.masterplans || []).forEach(function(url, i) {
    setTimeout(function() {
      var a = document.createElement('a');
      a.href = url; a.download = ''; a.style.display = 'none';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
    }, i * 300);
  });
}
function rgrsSubmitEnquiry(e) {
  e.preventDefault();
  var btn     = document.getElementById('rgrsEnqSubmit');
  var btnText = document.getElementById('rgrsEnqSubmitText');
  var errBox  = document.getElementById('rgrsEnqError');
  var okBox   = document.getElementById('rgrsEnqSuccess');
  errBox.style.display = 'none';
  okBox.style.display  = 'none';
  btn.disabled = true;
  btnText.textContent = 'Sending…';
  var data = {
    name:          document.getElementById('rgrsEnqName').value,
    mobile:        document.getElementById('rgrsEnqMobile').value,
    email:         document.getElementById('rgrsEnqEmail').value,
    product_id:    document.getElementById('rgrsEnqPropId').value,
    property_name: document.getElementById('rgrsEnqPropNameField').value,
    city:          document.getElementById('rgrsEnqCityField').value
  };
  // Brochure/master-plan downloads (pdOpenBrochureLead, updateddetail.php)
  // stash the file URLs here before opening this same popup. The brochure
  // tab has to be opened synchronously, in direct response to this click,
  // or popup blockers kill it once the async ajax response comes back.
  var pendingDl    = window._rgrsPendingDownload || null;
  var brochureTab  = (pendingDl && pendingDl.brochure) ? window.open('about:blank', '_blank') : null;
  $.ajax({
    url:    window.CI_BASE + 'Home/ajaxEnquiry',
    method: 'POST',
    data:   data,
    success: function(res) {
      var r; try { r = typeof res === 'string' ? JSON.parse(res) : res; } catch(ex){ r={}; }
      if (r.status) {
        // Product detail pages gate their "Pros & Cons" section behind an
        // enquiry submit; this popup is now the only submit path sitewide
        // (2026-07-27 consolidation), so it has to carry that unlock
        // side-effect too. Harmless no-op on any page that doesn't have it.
        try { localStorage.setItem('rgrs_pc_unlocked','1'); } catch(e2){}
        if (typeof pdPcDoUnlock === 'function') { pdPcDoUnlock(); }
        if (pendingDl) {
          window._rgrsPendingDownload = null;
          if (brochureTab && pendingDl.brochure) { brochureTab.location.href = pendingDl.brochure; }
          else if (brochureTab) { brochureTab.close(); }
          rgrsFireDownload(pendingDl);
          rgrsCloseEnquiry();
          if (typeof pdShowToast === 'function') { pdShowToast('Thanks! Your brochure & master plan are downloading.'); }
          btn.disabled = false;
          btnText.textContent = 'GET EARLY BOOKING OFFERS';
          return;
        }
        window.location.href = window.CI_BASE + 'thank-you';
      } else {
        if (brochureTab) brochureTab.close();
        errBox.textContent   = r.error || 'Something went wrong. Please try again.';
        errBox.style.display = 'block';
        btn.disabled         = false;
        btnText.textContent  = 'Get Instant Call Back';
      }
    },
    error: function() {
      if (brochureTab) brochureTab.close();
      errBox.textContent   = 'Network error. Please try again.';
      errBox.style.display = 'block';
      btn.disabled         = false;
      btnText.textContent  = 'Get Instant Call Back';
    }
  });
}
</script>
<!-- ===== END GLOBAL ENQUIRY POPUP ===== -->

   </body>

   <script defer src="https://www.rathiglobalrealty.com/front_assets/assets/psweb/js/primeJs.js"></script>
   <script defer src="https://www.rathiglobalrealty.com/front_assets/assets/psweb/js/toastr.min.js"></script>
      <script defer src="https://www.rathiglobalrealty.com/front_assets/assets/js/splide.min.js"></script>
         <div id="bulk_details"></div>


<script>
/* ===== SEO TABS ===== */
document.querySelectorAll('.rgrs-seo-tab').forEach(function(tab){
  tab.addEventListener('click', function(){
    document.querySelectorAll('.rgrs-seo-tab').forEach(function(t){ t.classList.remove('active'); });
    document.querySelectorAll('.rgrs-seo-content').forEach(function(c){ c.classList.remove('active'); });
    tab.classList.add('active');
    var target = document.getElementById(tab.dataset.tab);
    if(target) target.classList.add('active');
  });
});

function hello() { $("#myModal").removeClass('show'); }
var _cpEl = document.getElementById("closepopup"); if (_cpEl) _cpEl.addEventListener("click", hello);

function sfsdfsdfs(){
  var htmldata = '<s'+'cript src="https://www.rathiglobalrealty.com/front_assets/assets/web/js/notify.min.js"></s'+'cript>';
  document.getElementById('bulk_details').innerHTML = htmldata;
}

$(window).on('load', function(){
  setTimeout(function(){ sfsdfsdfs(); }, 15000);
});

$(document).ready(function(){
  $('.sub-btn').click(function(){ $(this).next('.sub-menu').slideToggle(); $(this).find('.dropdown').toggleClass('rotate'); });
  $('ul.tabs li').click(function(){
    var tab_id = $(this).attr('data-tab');
    $('ul.tabs li').removeClass('current');
    $('.tab-content').removeClass('current');
    $(this).addClass('current');
    $('#'+tab_id).addClass('current');
  });
});

function bannersearch(){ $("#Residential").addClass('active'); $("#buy").addClass('active'); $("#Commercial").removeClass('active'); $("#rent").removeClass('active'); }
function bannersearch2(){ $("#Commercial").addClass('active'); $("#rent").addClass('active'); $("#Residential").removeClass('active'); $("#buy").removeClass('active'); }

function subscribedat(){
  var vl = $("#subscribeid").val();
  $.ajax({
    url: window.CI_BASE + 'Home/subscriber/',
    method:"POST", data:{'vl':vl}, cache:false,
    success:function(data){
      var response = JSON.parse(data);
      if(response.status == true){ $.notify(response.done, "success"); }
      else { $.notify(response.error, "error"); }
    }
  });
}

function getfilterdata(){
  var sortBy = $('#sortBy').val();
  var _ftBase = location.protocol+'//'+location.host+'/';
  $.ajax({ url:_ftBase+"Product/filter", method:"POST", data:{sortBy:sortBy}, dataType:'json', success:function(resp){ $(".listingdata").html(resp.html); }});
}

function popupopen(){ $('#myModal').addClass('popupopen'); }
function searchopen(){ $('.searchtxt').show(); }
function closepopup(){ $('#myModal').removeClass('popupopen'); }

function writeReview(tabName){
  $('.is-active').removeClass('is-active');
  $('#tab-content-7').addClass('is-active'); $('#tabcontent7').addClass('is-active');
  $('#writereviews').addClass('show');
  $('#writereviews').hide().filter('#writereviews').show();
  $('#writereviews').removeAttr("style");
  $('div.bottom').find("input.review").focus();
}

var $star_rating = $('.star-rating .far');
var SetRatingStar = function(){
  return $star_rating.each(function(){
    if(parseInt($star_rating.siblings('input.rating-value').val()) >= parseInt($(this).data('rating'))){ return $(this).removeClass('far fa-star').addClass('fas fa-star'); }
    else { return $(this).removeClass('fas fa-star').addClass('far fa-star'); }
  });
};
$star_rating.on('click', function(){ $star_rating.siblings('input.rating-value').val($(this).data('rating')); return SetRatingStar(); });

$("#submit_review").click(function(){
  var product_id=$('#product_id').val(), reviewer_name=$('#reviewer_name').val(), reviewer_comment=$('#reviewer_comment').val(), starcount=$star_rating.siblings('input.rating-value').val();
  if(starcount){
    $.ajax({ url:location.protocol+'//'+location.host+'/Product/postReview', method:"POST", data:{'starcount':starcount,'product_id':product_id,'reviewer_name':reviewer_name,'reviewer_comment':reviewer_comment}, cache:false,
      success:function(){ $.notify("YOUR FEEDBACK IS UNDER REVIEW. IT WILL BE LIVE WITHIN 24-48 HOURS","success"); setTimeout(function(){ location.reload(); },3000); }
    });
  } else { alert("Please rate and comment"); }
});

$("#submit_comments").click(function(){
  var blog_id=$('#blog_id').val(), reviewer_name=$('#reviewer_name').val(), reviewer_comment=$('#reviewer_comment').val();
  if(reviewer_comment){
    $.ajax({ url:location.protocol+'//'+location.host+'/Blog/postReview', method:"POST", data:{'blog_id':blog_id,'reviewer_name':reviewer_name,'reviewer_comment':reviewer_comment}, cache:false,
      success:function(){ $.notify("YOUR FEEDBACK IS UNDER REVIEW. IT WILL BE LIVE WITHIN 24-48 HOURS","success"); setTimeout(function(){ location.reload(); },3000); }
    });
  } else { alert("Please rate and comment"); }
});
</script>
<script>
if (typeof Splide !== 'undefined' && document.getElementById('primary_slider') && document.getElementById('thumbnail_slider')) {
  var primarySlider = new Splide('#primary_slider',{type:'fade',heightRatio:0.5,pagination:false,arrows:false,cover:true});
  var thumbnailSlider = new Splide('#thumbnail_slider',{rewind:true,fixedWidth:100,fixedHeight:64,isNavigation:true,gap:10,focus:'center',pagination:false,cover:true,breakpoints:{'600':{fixedWidth:66,fixedHeight:40}}}).mount();
  primarySlider.sync(thumbnailSlider).mount();
}
</script>
<script>
$(document).ready(function(){
  $(document).on('click','.typeahead.dropdown-menu li a',function(){ $(this).closest('.typeahead.dropdown-menu').hide(); });
});
</script>
<style>
.searchtxt{display:none;}
.FooterSocialmartop{margin-top:20px;}
.follwus{font-size:18px;font-weight:600;margin-top:20px;}
@media screen and (max-width:600px){
  .searchtxt{display:flex;align-items:center;justify-content:center;margin-top:0;width:94%;position:absolute;z-index:9999;}
  .searchtxt input{display:flex;align-items:center;justify-content:center;margin-top:0;width:100%;position:absolute;z-index:9999;border:2px solid #c49225;height:45px;}
  .searchtxt button{position:absolute;padding:5px;background-color:#c49225;border:5px solid #c49225;font-size:large;color:#fff;transition:.5s linear;height:45px;right:0;z-index:99999;}
  .searchtxt button:hover{color:#000;transition:.5s linear;cursor:pointer;}
}
</style>

<!-- ── Charges Drawer ─────────────────────────────────────── -->
<style>
#rgChargesOverlay{display:none;position:fixed;top:64px;left:0;right:0;bottom:0;background:rgba(0,0,0,.45);z-index:9990}
@media(max-width:992px){#rgChargesOverlay{top:56px}}
#rgChargesDrawer{position:fixed;top:64px;right:0;width:420px;max-width:100vw;height:calc(100vh - 64px);background:#fff;z-index:9991;box-shadow:-4px 0 24px rgba(0,0,0,.18);transform:translateX(100%);transition:transform .32s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;overflow:hidden}
#rgChargesDrawer.open{transform:translateX(0)}
@media(max-width:992px){#rgChargesDrawer{top:56px;height:calc(100vh - 56px)}}
@media(max-width:480px){#rgChargesDrawer{width:100vw}.rgcdr-body{padding:14px}.rgcdr-head{padding:13px 16px 11px}.rgcdr-footer{padding:12px 16px}.rgcdr-list li{font-size:13px}}
.rgcdr-head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px 16px;border-bottom:1px solid #e8e8e8;flex-shrink:0}
.rgcdr-head span{display:block;font-size:20px;font-weight:700;color:#1a1a2e;margin:0}
.rgcdr-close{background:none;border:none;cursor:pointer;width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#555;font-size:20px;line-height:1;transition:background .2s}
.rgcdr-close:hover{background:#f0f0f0}
.rgcdr-body{flex:1;overflow-y:auto;padding:20px}
.rgcdr-subtitle{font-size:13px;color:#888;margin:2px 0 18px}
.rgcdr-section{background:#f7f8fc;border-radius:10px;padding:14px 16px;margin-bottom:14px}
.rgcdr-section-title{font-size:15px;font-weight:700;color:#1a1a2e;margin:0 0 10px}
.rgcdr-list{list-style:none;padding:0;margin:0}
.rgcdr-list li{display:flex;align-items:flex-start;gap:9px;font-size:14px;color:#333;line-height:1.6;padding:6px 0;border-bottom:1px solid #eee}
.rgcdr-list li:last-child{border-bottom:none;padding-bottom:0}
.rgcdr-list li::before{content:'•';color:#c08830;font-size:18px;line-height:1.1;flex-shrink:0;margin-top:1px}
.rgcdr-disclaimer{font-size:11.5px;color:#888;line-height:1.6;margin-top:6px;padding:12px;background:#fafafa;border-radius:8px;border:1px solid #eee}
.rgcdr-footer{padding:16px 20px;border-top:1px solid #e8e8e8;flex-shrink:0}
.rgcdr-cta{width:100%;padding:14px;background:#c08830;color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:700;cursor:pointer;transition:background .2s}
.rgcdr-cta:hover{background:#a87228}
.rg-charges-btn{background:none;border:none;padding:0;color:#c08830;font-size:0.5em;font-weight:600;cursor:pointer;text-decoration:underline dotted;text-underline-offset:2px}
.rg-charges-btn:hover{color:#a87228}
@media(max-width:480px){#rgChargesDrawer{width:100vw}}
</style>
<div id="rgChargesOverlay" onclick="rgCloseCharges()"></div>
<div id="rgChargesDrawer">
  <div class="rgcdr-head">
    <span>Charges</span>
    <button class="rgcdr-close" onclick="rgCloseCharges()" aria-label="Close">&#x2715;</button>
  </div>
  <div class="rgcdr-body" id="rgChargesBody"></div>
  <div class="rgcdr-footer">
    <button class="rgcdr-cta" onclick="rgCloseCharges();if(typeof pdOpenPopup==='function')pdOpenPopup();else if(typeof openEnquiryPopup==='function')openEnquiryPopup();">Get a Callback to Know More</button>
  </div>
</div>
<script>
var _rgCD={
  'gurgaon':      {city:'Gurgaon',     duty:[['For Female','5% in Urban and 3% in Rural'],['For Male','7% in Urban and 5% in Rural'],['For Joint Ownership','6% in Urban and 4% in Rural']],reg:['Rs 50,000']},
  'delhi':        {city:'Delhi',       duty:[['Male Ownership','6%'],['Female Ownership','4%'],['Joint Ownership','5%']],reg:['1% of the transaction value']},
  'noida':        {city:'Noida',       duty:[['6% for Female'],['7% for Male'],['6.5% for Joint Ownership']],reg:['1% Value']},
  'greater noida':{city:'Greater Noida',duty:[['6% for Female'],['7% for Male'],['6.5% for Joint Ownership']],reg:['1% Value']},
  'ghaziabad':    {city:'Ghaziabad',   duty:[['Stamp Duty','7% of property value'],['Women Rebate','Rs 10,000 concession for women buyers']],reg:['1% of property value']},
  'mumbai':       {city:'Mumbai',      duty:[['Mumbai & Navi Mumbai','6% for Males, 5% for Females'],['Thane/Pune/Nagpur/Nashik','7% for Males, 6% for Females'],['Rural/Gram Panchayat Jurisdiction','3% for Males, 2% for Females']],reg:['1% of transaction value or max up to Rs 30,000']},
  'navi mumbai':  {city:'Navi Mumbai', duty:[['Mumbai & Navi Mumbai','6% for Males, 5% for Females'],['Thane/Pune/Nagpur/Nashik','7% for Males, 6% for Females'],['Rural/Gram Panchayat Jurisdiction','3% for Males, 2% for Females']],reg:['1% of transaction value or max up to Rs 30,000']},
  'pune':         {city:'Pune',        duty:[['Mumbai & Navi Mumbai','6% for Males, 5% for Females'],['Thane/Pune/Nagpur/Nashik','7% for Males, 6% for Females'],['Rural/Gram Panchayat Jurisdiction','3% for Males, 2% for Females']],reg:['1% of transaction value or max up to Rs 30,000']},
  'thane':        {city:'Thane',       duty:[['Mumbai & Navi Mumbai','6% for Males, 5% for Females'],['Thane/Pune/Nagpur/Nashik','7% for Males, 6% for Females'],['Rural/Gram Panchayat Jurisdiction','3% for Males, 2% for Females']],reg:['1% of transaction value or max up to Rs 30,000']},
  'nashik':       {city:'Nashik',      duty:[['Mumbai & Navi Mumbai','6% for Males, 5% for Females'],['Thane/Pune/Nagpur/Nashik','7% for Males, 6% for Females'],['Rural/Gram Panchayat Jurisdiction','3% for Males, 2% for Females']],reg:['1% of transaction value or max up to Rs 30,000']},
  'nagpur':       {city:'Nagpur',      duty:[['Mumbai & Navi Mumbai','6% for Males, 5% for Females'],['Thane/Pune/Nagpur/Nashik','7% for Males, 6% for Females'],['Rural/Gram Panchayat Jurisdiction','3% for Males, 2% for Females']],reg:['1% of transaction value or max up to Rs 30,000']},
  'bangalore':    {city:'Bangalore',   additional:[['Floor PLC','upto Rs. 600/sqft']],duty:[['Above Rs 45 Lakh','5% stamp duty'],['Rs 21–45 Lakh','3% stamp duty'],['Up to Rs 20 Lakh','2% stamp duty']],reg:['1% of property value']},
  'hyderabad':    {city:'Hyderabad',   duty:[['Stamp Duty','5% of the value, applicable to both Male and Female']],reg:['2% of Value']},
  'chennai':      {city:'Chennai',     duty:[['Stamp Duty','7% of property value']],reg:['4% of property value']},
  'kolkata':      {city:'Kolkata',     duty:[['5% of value up to Rs 1 crore in Rural areas'],['6% of value up to Rs 1 crore in Urban areas'],['6% above Rs 1 crore in Rural and Urban areas (Rates applicable to both Male and Female)']],reg:['1% of Value']},
  'ahmedabad':    {city:'Ahmedabad',   duty:[['Stamp Duty','4.9% of property value']],reg:['1% of property value']},
  'lucknow':      {city:'Lucknow',     duty:[['Stamp Duty','7% of property value'],['Women Rebate','Rs 10,000 concession for women buyers']],reg:['1% of property value']},
  'default':      {city:'India',       duty:[['Stamp Duty','Varies by state (2%–8% of property value)']],reg:['0.5%–2% of property value (varies by state)']}
};
function rgOpenCharges(city){
  var k=(city||'').toLowerCase().trim();
  var d=_rgCD[k]||_rgCD['default'];
  var dr=d.duty.map(function(r){return '<li>'+(r[1]?r[0]+': <strong>'+r[1]+'</strong>':r[0])+'</li>';}).join('');
  var rr=d.reg.map(function(r){return '<li>'+r+'</li>';}).join('');
  var addHtml='';
  if(d.additional&&d.additional.length){
    var ar=d.additional.map(function(r){return '<li>'+(r[1]?r[0]+': <strong>'+r[1]+'</strong>':r[0])+'</li>';}).join('');
    addHtml='<h3 style="font-size:18px;font-weight:700;color:#1a1a2e;margin:0 0 10px">Additional Charges</h3>'+
      '<div class="rgcdr-section" style="margin-bottom:20px"><ul class="rgcdr-list">'+ar+'</ul></div>';
  }
  document.getElementById('rgChargesBody').innerHTML=
    addHtml+
    '<h3 style="font-size:18px;font-weight:700;color:#1a1a2e;margin:0 0 3px">Government Charges</h3>'+
    '<p class="rgcdr-subtitle">Standard across '+d.city+'</p>'+
    '<div class="rgcdr-section"><p class="rgcdr-section-title">Stamp Duty</p><ul class="rgcdr-list">'+dr+'</ul></div>'+
    '<div class="rgcdr-section"><p class="rgcdr-section-title">Registration Charges</p><ul class="rgcdr-list">'+rr+'</ul></div>'+
    '<p class="rgcdr-disclaimer">Disclaimer: The information above is for general reference based on prevailing government rates. Actual charges may vary. Please verify with the relevant authority before making any decisions.</p>';
  document.getElementById('rgChargesOverlay').style.display='block';
  document.getElementById('rgChargesDrawer').classList.add('open');
  document.body.style.overflow='hidden';
}
function rgCloseCharges(){
  document.getElementById('rgChargesOverlay').style.display='none';
  document.getElementById('rgChargesDrawer').classList.remove('open');
  document.body.style.overflow='';
}
document.addEventListener('keydown',function(e){if(e.key==='Escape')rgCloseCharges();});
</script>
</html>
