<style>
#rgWhyDrawer{position:fixed;top:64px;right:0;width:420px;max-width:100vw;height:calc(100vh - 64px);background:#fff;z-index:9991;box-shadow:-4px 0 24px rgba(0,0,0,.18);transform:translateX(100%);transition:transform .32s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;overflow:hidden}
#rgWhyDrawer.open{transform:translateX(0)}
#rgWhyOverlay{display:none;position:fixed;top:64px;left:0;right:0;bottom:0;background:rgba(0,0,0,.45);z-index:9990}
.rgwd-header{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 20px;background:#fff;box-shadow:0 2px 10px rgba(0,0,0,.08);flex-shrink:0}
.rgwd-title{font-size:16px;font-weight:700;color:#1a1a2e;line-height:1.45;flex:1}
.rgwd-close{background:none;border:none;font-size:22px;cursor:pointer;color:#666;padding:0;line-height:1;flex-shrink:0;margin-top:-2px}
.rgwd-close:hover{color:#1a1a2e}
@media(max-width:992px){#rgWhyDrawer{top:56px;height:calc(100vh - 56px)}}
@media(max-width:480px){#rgWhyDrawer{width:100vw}}
</style>
<script>
function rgOpenWhy(){document.getElementById('rgWhyDrawer').classList.add('open');document.getElementById('rgWhyOverlay').style.display='block';document.body.style.overflow='hidden';}
function rgCloseWhy(){document.getElementById('rgWhyDrawer').classList.remove('open');document.getElementById('rgWhyOverlay').style.display='none';document.body.style.overflow='';}
document.addEventListener('keydown',function(e){if(e.key==='Escape')rgCloseWhy();});
document.addEventListener('DOMContentLoaded', function(){
    // Populate the preview list (#pdSideWhy* in the sticky sidebar) from the
    // drawer's server-rendered content (#rgWhyDrawer*) -- the drawer stays
    // the single source of truth with the full list, this only clones a
    // short preview into view; nothing here is server-rendered twice, so
    // raw page source has each sentence once. (The card's heading is
    // rendered directly server-side since it's just the real project name,
    // not a duplicated sentence.)
    // Deferred to DOMContentLoaded: #pdSideWhy* lives in the sticky sidebar
    // far below this <script> tag in the page, so it doesn't exist in the
    // DOM yet if this runs immediately at parse time.
    var srcList = document.getElementById('rgWhyDrawerList');
    var srcPara = document.getElementById('rgWhyDrawerPara');
    var dstList = document.getElementById('pdSideWhyList');
    var dstPara = document.getElementById('pdSideWhyPara');
    if (dstList && srcList) {
        var items = srcList.querySelectorAll('li');
        for (var i = 0; i < Math.min(3, items.length); i++) {
            var li = document.createElement('li');
            var icon = document.createElement('div');
            icon.className = 'pd-ib-why-icon';
            icon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>';
            var span = document.createElement('span');
            span.textContent = items[i].textContent;
            li.appendChild(icon);
            li.appendChild(span);
            dstList.appendChild(li);
        }
        if (items.length) { dstList.style.display = ''; }
    } else if (dstPara && srcPara) {
        var full = srcPara.textContent.trim();
        var m = full.match(/^(.*?[.!?])(\s|$)/);
        dstPara.textContent = m ? m[1] : full;
        if (full) { dstPara.style.display = ''; }
    }
});
</script>

