                <button class="pd-ms-tab active"
            onclick="var s=document.querySelector('#sec-overview');if(s)s.scrollIntoView({behavior:'smooth'});this.closest('.pd-ms-tabs').querySelectorAll('.pd-ms-tab').forEach(function(t){t.classList.remove('active')});this.classList.add('active')">
            <img src="https://www.rathiglobalrealty.com/front_assets/assets/img/videoimg.webp" alt="Highlights" loading="lazy">
            <span class="pd-ms-tab-label">Highlights</span>
        </button>
            </div>
    <script>
    (function(){
        if(!window.matchMedia('(max-width:767px)').matches) return;
        var track = document.getElementById('pdMsTrack');
        var dotsEl = document.getElementById('pdMsDots');
        var ctrEl  = document.getElementById('pdMsCounter');
        if(!track) return;
        var slides = track.children;
        var total  = slides.length;
        var cur = 0, timer, startX, dragging = false;

        // Build dots (max 10 shown)
        var maxDots = Math.min(total, 10);
        for(var i=0;i<maxDots;i++){
            var d=document.createElement('button');
            d.className='pd-ms-dot'+(i===0?' active':'');
            d.setAttribute('data-i',i);
            d.setAttribute('aria-label','Go to image '+(i+1));
            (function(idx){d.onclick=function(){goTo(idx,true);};})(i);
            dotsEl.appendChild(d);
        }
        ctrEl.textContent='1/'+total;

        function ui(){
            track.style.transform='translateX(-'+(cur*100)+'%)';
            dotsEl.querySelectorAll('.pd-ms-dot').forEach(function(d,i){d.classList.toggle('active',i===cur);});
            ctrEl.textContent=(cur+1)+'/'+total;
        }

        function loadVideo(idx){
            var sl=slides[idx];
            if(!sl||!sl.classList.contains('pd-ms-slide-video')) return;
            var inner=sl.querySelector('.pd-ms-vid-inner');
            if(!inner||inner.querySelector('iframe')) return;
            var ytid=sl.getAttribute('data-ytid');
            var igid=sl.getAttribute('data-igid');
            var fr=document.createElement('iframe');
            fr.allowFullscreen=true;
            fr.allow='autoplay; encrypted-media';
            if(ytid){ fr.id='pdMsYtFrame'; fr.src='https://www.youtube.com/embed/'+ytid+'?rel=0&autoplay=1&mute=1&playsinline=1&enablejsapi=1'; }
            else if(igid){ fr.className='pd-ig-banner-iframe'; fr.src='https://www.instagram.com/reel/'+igid+'/embed/'; fr.scrolling='no'; }
            inner.appendChild(fr);
        }

        function startAuto(){
            clearInterval(timer);
            if(slides[cur]&&slides[cur].classList.contains('pd-ms-slide-video')) return;
            timer=setInterval(function(){ goTo((cur+1>=total)?0:cur+1,false); },4000);
        }

        function goTo(idx,userAction){
            if(idx<0) idx=total-1;
            if(idx>=total) idx=0;
            cur=idx;
            ui();
            loadVideo(cur);
            startAuto();
        }

        // Touch swipe
        var vp=document.getElementById('pdMs');
        vp.addEventListener('touchstart',function(e){startX=e.touches[0].clientX;dragging=true;clearInterval(timer);},{passive:true});
        vp.addEventListener('touchend',function(e){
            if(!dragging) return;
            var dx=startX-e.changedTouches[0].clientX;
            if(Math.abs(dx)>40) goTo(dx>0?cur+1:cur-1,true);
            dragging=false;
            startAuto();
        },{passive:true});

        ui();
        loadVideo(cur);
        startAuto();
    })();
    </script>
    
    <!-- INFO BAR (below gallery) -->
    <div class="pd-infobar">
        <!-- Left: Specs grid (price now lives up in the title head) -->
        <div class="pd-ib-left">

