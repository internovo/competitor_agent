    </a>
    <button class="pd-mob-bar-btn pd-mob-bar-enquire" onclick="pdOpenPopup()">
        <svg viewBox="0 0 24 24" fill="#fff" width="24" height="24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
