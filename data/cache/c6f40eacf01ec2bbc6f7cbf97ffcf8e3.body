    <!-- Form body -->
    <div class="pd-popup-body">
      <form id="rgrsEnqForm" onsubmit="rgrsSubmitEnquiry(event)">
        <input type="hidden" id="rgrsEnqPropId" name="product_id">
        <input type="hidden" id="rgrsEnqPropNameField" name="property_name">
        <input type="hidden" id="rgrsEnqCityField" name="city">
        <input type="hidden" name="country_code" value="+91">

        <div class="pd-popup-field">
          <svg class="pd-popup-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 21v-1a4 4 0 00-4-4H8a4 4 0 00-4 4v1"/><circle cx="12" cy="7" r="4"/></svg>
          <input type="text" name="name" id="rgrsEnqName" placeholder="Enter Your Name" required>
        </div>
        <div class="pd-popup-field">
          <svg class="pd-popup-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.37 1.9.72 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.9.35 1.85.59 2.81.72A2 2 0 0122 16.92z"/></svg>
          <input type="tel" name="mobile" id="rgrsEnqMobile" placeholder="Enter 10-digit mobile number" required>
        </div>
        <div class="pd-popup-field">
          <svg class="pd-popup-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 6l10 7 10-7"/></svg>
          <input type="email" name="email" id="rgrsEnqEmail" placeholder="Enter mail id">
