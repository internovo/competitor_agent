<!-- Mobile anchor: JS moves the breadcrumb block (rendered below the
     header, see top of this file) to here on mobile viewports, so it sits
     above the footer instead -->
<div id="pd-bc-mobile-anchor"></div>
<script>
(function(){
    var bc = document.getElementById('pd-bc');
    var mobileAnchor = document.getElementById('pd-bc-mobile-anchor');
    if (!bc || !mobileAnchor) return;
    var desktopAnchor = document.createElement('div');
    desktopAnchor.style.display = 'none';
    bc.parentNode.insertBefore(desktopAnchor, bc);
    function place() {
        if (window.innerWidth <= 991) {
            if (bc.parentNode !== mobileAnchor.parentNode || bc.previousSibling !== mobileAnchor) {
                mobileAnchor.parentNode.insertBefore(bc, mobileAnchor.nextSibling);
            }
        } else {
            if (bc.previousSibling !== desktopAnchor) {
                desktopAnchor.parentNode.insertBefore(bc, desktopAnchor.nextSibling);
            }
        }
    }
    place();
    window.addEventListener('resize', place);
})();
</script>


