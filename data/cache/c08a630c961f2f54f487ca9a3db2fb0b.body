p","propertyName":"Oberoi Three Sixty West","propertyAddress":"Three Sixty West, Dr Annie Besant Rd, next to Old Passport Office, Cen, Worli, Mumbai, Maharashtra 400018","propertyArea":"Worli","priceRange":"₹45 Cr - 57 Cr","propertyImage":"https://cdn.blox.xyz/builders/thumb/171121062244-Oberoi_Realty.png","rmCardData":{"projectId":4274,"rmId":2677,"name":"Zuveria Shaikh","experience":"","rating":"4.7","reviewCount":"","profileImage":"https://cdn.blox.xyz/users/140426032920-image_cropper_1776160743853.png","headerText":"Our team is here to help you with any questions”","subHeaderText":"One of our RMs will assist you.","contactNumber":"9930635704"},"tags":null,"floorConfigurations":""},"ProjectInfoProps":{"floorPlan":"5 BHK","configLabel":"5 BHK","price":"570000000.00","possession":"30 Jun 2022","tower":"Three Sixty West","towerReraID":"P51900012115","carpetArea":"6651 sq. ft"},"FloorPlanImage":"https://cdn.blox.xyz/properties/oberoi-realty-oberoi-three-sixty-west-5-bhk-bedroom-1704447605.webp","PaymentDetails":{"DeveloperName":"Oberoi Realty","DeveloperAddress":"Commerz, 3rd Floor, International Business Park, Oberoi Garden City, Off Western Express Highway, Goregaon East, Mumbai - 400063. India.","TokenAmount":"100000","BankDetails":{"accountName":"","accountNumber":"","bankName":"","ifsc":""},"OnlinePayment":0},"RMCardData":{"projectId":4274,"rmId":2677,"name":"Zuveria Shaikh","experience":"","rating":"4.7","reviewCount":"","profileImage":"https://cdn.blox.xyz/users/140426032920-image_cropper_1776160743853.png","headerText":"Our team is here to help you with any questions”","subHeaderText":"One of our RMs will assist you.","contactNumber":"9930635704"},"seoDetails":{"title":"Continue booking Oberoi Three Sixty West","url":"","slug":"","canonical":"https://blox.xyz/projects/oberoi-three-sixty-west","description":"Continue booking Oberoi Three Sixty West","imageUrl":"","keyword":"","robots":"noindex, nofollow"},"configId":17067}}},"ReraInfo":{"P51900012115":{"towerName":"Three Sixty West","state":"Maharashtra","label":"MahaRERA (Maharashtra Real Estate Regulatory Authority)","url":"https://maharera.maharashtra.gov.in","reraLink":"https://maharera.maharashtra.gov.in/projects-search-result?certificate_no=P51900012115"}},"BookPropertyEnabled":false,"structuredData":["\n{\n  \"@context\": \"https://schema.org/\",\n  \"@type\": \"BreadcrumbList\",\n  \"itemListElement\": [{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Mumbai\",\"item\":\"https://blox.xyz/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Properties in Mumbai\",\"item\":\"https://blox.xyz/buy/mumbai/1a256\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Properties in Worli\",\"item\":\"https://blox.xyz/buy/mumbai/worli-1a256b7a157\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Oberoi Realty\",\"item\":\"https://blox.xyz/buy/mumbai/worli-oberoi-realty-1a256b7a157b13a31\"},{\"@type\":\"ListItem\",\"position\":5,\"name\":\"Oberoi Three Sixty West\",\"item\":\"https://blox.xyz/projects/oberoi-three-sixty-west\"}]\n}","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\"@type\":\"Question\",\"name\":\"When is the possession date for Oberoi Three Sixty West?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Possession date of Oberoi Three Sixty West is 30 Jun 2022\"}},{\"@type\":\"Question\",\"name\":\"What is the RERA carpet area range of Oberoi Three Sixty West?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The RERA carpet area range for Oberoi Three Sixty West is 5235 - 6651 sqft\"}},{\"@type\":\"Question\",\"name\":\"What is the price range of Oberoi Three Sixty West?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The price range of Oberoi Three Sixty West is ₹45 Cr - 57 Cr\"}},{\"@type\":\"Question\",\"name\":\"Where is Oberoi Three Sixty West located?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oberoi Three Sixty West is located at Three Sixty West, Dr Annie Besant Rd, next to Old Passport Office, Cen, Worli, Mumbai, Maharashtra 400018.\"}},{\"@type\":\"Question\",\"name\":\"What configurations are available in Oberoi Three Sixty West?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Oberoi Three Sixty West has 4 BHK, 5 BHK configurations.\"}},{\"@type\":\"Question\",\"name\":\"What is the status of Oberoi Three Sixty West?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The status of Oberoi Three Sixty West is Ready to move.\"}},{\"@type\":\"Question\",\"name\":\"Which amenities are provided in Oberoi Three Sixty West?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The amenities are Car Parking Space, Gymnasium, Indoor Games, Jogging / Cycle Track, Kids Play Areas / Sand Pits, Landscape Garden, Large Green Area, Multipurpose Hall, Senior citizen Area, Swimming Pool, Walking Area, Well Designed Entrance Lobby, Yoga Area.\"}},{\"@type\":\"Question\",\"name\":\"Who is the developer of Oberoi Three Sixty West?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The developer of Oberoi Three Sixty West is Oberoi Realty.\"}}]\n}\n","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"Oberoi Three Sixty West\",\n  \"image\": \"https://cdn.blox.xyz/builders/thumb/171121062244-Oberoi_Realty.png\",\n  \"description\": \"Oberoi Three Sixty West is a prestigious luxury residential project located in Worli, Mumbai, developed by the renowned Oberoi Realty. This iconic mixed-use development features ultra-spacious 4 \u0026 5 BHK sea-facing homes, offering an unmatched blend of sophistication \u0026 comfort. One of the two towers houses the globally acclaimed Ritz-Carlton Hotel, while the other is home to premium residences managed by The Ritz-Carlton, ensuring the highest standards in hospitality \u0026 lifestyle. Designed for elite living, each residence is positioned to provide panoramic Arabian Sea views, along with maximum privacy \u0026 exclusivity, making it a landmark for luxury living in South Mumbai.\",\n  \"brand\": {\n\t\t\"@type\": \"Brand\",\n\t\t\"name\": \"Oberoi Realty\"\n\t},\n  \"offers\": {\n\t\t\"@type\": \"AggregateOffer\",\n    \"url\": \"https://blox.xyz/projects/oberoi-three-sixty-west\",\n\t\t\"priceCurrency\": \"INR\",\n\t\t\"lowPrice\": \"450000000.00\",\n\t\t\"highPrice\": \"570000000.00\"\n\t}\n}\n","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": [\n      \"SingleFamilyResidence\",\n      \"Product\",\n      \"RealEstateListing\"\n  ],\n  \"@id\": \"https://blox.xyz/projects/oberoi-three-sixty-west\",\n  \"mpn\": \"P51900012115\",\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"@id\": \"https://blox.xyz/buy/mumbai/oberoi-realty-1a256b13a31\",\n    \"name\": \"Oberoi Realty\"\n  },\n  \"url\": \"https://blox.xyz/projects/oberoi-three-sixty-west\",\n  \"containedInPlace\": {\n      \"@type\": \"Place\",\n      \"@id\": \"Oberoi Three Sixty West\",\n      \"url\": \"https://blox.xyz/projects/oberoi-three-sixty-west\",\n      \"name\": \"Oberoi Three Sixty West\",\n      \"address\": {\n          \"@type\": \"PostalAddress\",\n          \"streetAddress\": \"Three Sixty West, Dr Annie Besant Rd, next to Old Passport Office, Cen, Worli, Mumbai, Maharashtra 400018\",\n          \"addressLocality\": \"Worli\",\n          \"addressRegion\": \"Mumbai\",\n          \"postalCode\": \"400018\",\n          \"addressCountry\": \"IN\"\n      }\n  },\n  \"description\": \"Oberoi Three Sixty West is a prestigious luxury residential project located in Worli, Mumbai, developed by the renowned Oberoi Realty. This iconic mixed-use development features ultra-spacious 4 \u0026 5 BHK sea-facing homes, offering an unmatched blend of sophistication \u0026 comfort. One of the two towers houses the globally acclaimed Ritz-Carlton Hotel, while the other is home to premium residences managed by The Ritz-Carlton, ensuring the highest standards in hospitality \u0026 lifestyle. Designed for elite living, each residence is positioned to provide panoramic Arabian Sea views, along with maximum privacy \u0026 exclusivity, making it a landmark for luxury living in South Mumbai.\",\n  \"floorSize\": [\n      {\n          \"@type\": \"QuantitativeValue\",\n          \"unitCode\": \"SQFT\",\n          \"minValue\": \"5235\",\n          \"maxValue\": \"6651\"\n      }\n  ],\n  \"image\": [\n      {\n          \"@type\": \"ImageObject\",\n          \"url\": \"https://cdn.blox.xyz/builders/thumb/171121062244-Oberoi_Realty.png\"\n      }\n  ],\n  \"name\": \"Oberoi Three Sixty West\",\n  \"offers\": {\n      \"@type\": \"Offer\",\n      \"@id\": \"P51900012115\",\n      \"availability\": \"https://schema.org/InStock\",\n      \"name\": \"Sale of Oberoi Three Sixty West Unit\",\n      \"url\": \"https://blox.xyz/projects/oberoi-three-sixty-west\",\n      \"price\": 450000000.00,\n      \"priceCurrency\": \"INR\"\n  }\n}\n"],"aiReviewSummary":{"summary":"Online reviews for Oberoi Three Sixty West in Worli characterize the project as a pinnacle of ultra-luxury living in South Mumbai. Most reviewers emphasize the prestige associated with the Ritz-Carlton branding and the architectural significance of the dual-tower design. While the project receives high praise for its exclusivity and world-class management, some feedback notes the high density of the surrounding Worli area and the extreme entry price point. +1","pros":[{"title":"Brand Association","description":"The partnership with The Ritz-Carlton provides residents with access to global standards of hospitality and concierge services."},{"title":"Panoramic Views","description":"The strategic angling of the towers ensures that almost every residence enjoys unobstructed views of the Arabian Sea and the Bandra-Worli Sea Link."},{"title":"Spacious Layouts","description":"The apartments are noted for their massive floor plans, often exceeding 5,000 square feet, which is rare for South Mumbai."},{"title":"Elite Amenities","description":"The project features a comprehensive suite of luxury facilities including a private spa, salon, home theatre, and extensive sports courts."},{"title":"Strategic Connectivity","description":"The location offers swift access to the Bandra-Worli Sea Link, making commutes to North Mumbai and BKC relatively efficient."},{"title":"High Security","description":"The premises are equipped with advanced multi-tier security systems and 24x7 surveillance for resident privacy."}],"cons":[{"title":"Traffic Congestion","description":"The surrounding roads in Worli, particularly near Dr. Annie Besant Road, experience significant bottlenecks during peak commuting hours."},{"title":"Entry Cost","description":"The exceptionally high price per square foot makes it accessible only to ultra-high-net-worth individuals, limiting the secondary market liquidity."},{"title":"Local Density","description":"Despite the luxury inside the gates, the immediate vicinity is densely populated with commercial and older residential structures."},{"title":"Ongoing Development","description":"Some residents and visitors have mentioned occasional noise and dust from neighboring construction projects in the evolving Worli skyline."}],"verdict":["Symbol of prestige","Ideal for ultra-high-net-worth individuals","Excellent for those seeking privacy","Top-tier hospitality integration","Best-in-class sea views"]},"googleReviews":{"html_attributions":[],"result":{"rating":4.5,"reviews":[{"author_name":"Bhavesh Trivedi","author_url":"https://www.google.com/maps/contrib/108676810819117766794/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a/ACg8ocLwtjzluw7elFSZGWbh3wOlMrSl0I1gU0IaRTy_iEEfJrRcTL0N=s128-c0x00000000-cc-rp-mo-ba3","rating":5,"relative_time_description":"2 months ago","text":"Visited Three Sixty West recently and was extremely impressed by the overall development. The sea views are stunning, the residences are thoughtfully designed, and the quality of construction is exceptional. Every aspect of the project reflects luxury and sophistication.\n\nThe location, amenities, and overall lifestyle offering make it one of Mumbai's most prestigious residential projects. A great option for anyone looking for ultra-luxury living or a long-term investment in South Mumbai.","time":1781349367,"translated":false},{"author_name":"kalpesh patel","author_url":"https://www.google.com/maps/contrib/105963776298576905373/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjXi9JTkYDuSiGT0bmViTX_dQE7k8pdutWMLt18qb4C8dqUOUPglVA=s128-c0x00000000-cc-rp-mo-ba6","rating":5,"relative_time_description":"4 years ago","text":"Nice sky scrapers with 68 floor on Dr.Annie Basent road in worli with nice amenities and excellent sea view of Bandra worli sea link project","time":1651284176,"translated":false},{"author_name":"Rehan Ansari","author_url":"https://www.google.com/maps/contrib/100783098918818499835/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjVHCY1Z438uUH7FRNgTNapuTaCScRhuF-L-I38Lic9fmcB00lO0Cw=s128-c0x00000000-cc-rp-mo-ba5","rating":4,"relative_time_description":"6 years ago","text":"It's still under construction. Have heard many big celebrities like shahid kapoor, virat kohli have their pads in this tower. It's a majestic building with all round view for all apartments. It has a very huge parking lot. This location is becoming one of the most sort after locality for celebrities and well known business tycoons.","time":1595488163,"translated":false},{"author_name":"Sun Jay","author_url":"https://www.google.com/maps/contrib/101203217322316368297/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjWAztKkxQXaWcVxBmYmRQ1MErLo7uaiQ3OXBw2kiRHKcCgo9TVQ=s128-c0x00000000-cc-rp-mo-ba6","rating":5,"relative_time_description":"3 years ago","text":"Three Sixty West is located in the heart of Mumbai's business district, making it an ideal location for those who work in the area. The tower is well-connected to the rest of the city, with easy access to major highways and public transportation. The surrounding area offers a range of dining and entertainment options, as well as parks and recreational areas.\n\nThe apartments offer breathtaking views of the Arabian Sea, the Bandra-Worli Sea Link, and the Mumbai skyline. The tower has been designed by the architectural firm Kohn Pedersen Fox (KPF) Associates, and the interiors have been designed by the world-renowned interior designer Hirsch Bedner Associates (HBA).","time":1682166369,"translated":false},{"author_name":"unique ambeshat","author_url":"https://www.google.com/maps/contrib/102078719891801485800/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjXp_kAvFTnnC4OYYgKjP5pETCefZrUhc4rV9hdhzT1G06ON10av=s128-c0x00000000-cc-rp-mo-ba4","rating":5,"relative_time_description":"8 years ago","text":"Great place to live in\nAnd the tower looks great under construction.\nOnce completed its going to be a new landmark in mumbai's stunning skyline...","time":1513321055,"translated":false}],"url":"https://maps.google.com/?cid=16350943016398451337","user_ratings_total":222},"status":"OK"}},"isMobile":false,"footerData":{"featured":{"kolkata":{"label":"Kolkata","id":14},"mumbai":{"label":"Mumbai","id":256},"navi-mumbai":{"label":"Navi Mumbai","id":261},"pune":{"label":"Pune","id":300},"thane":{"label":"Thane","id":269}},"others":{"alibaug":{"label":"Alibaug","id":1907},"bangalore":{"label":"Bangalore","id":95},"noida":{"label":"Noida","id":84},"palghar":{"label":"Palghar","id":264},"raigad":{"label":"Raigad","id":3323},"telangana":{"label":"Telangana","id":3326}}},"__N_SSP":true},"page":"/projects/[project_name]","query":{"project_name":"oberoi-three-sixty-west"},"buildId":"t4LZHlTlBLViwyNa5GApO","isFallback":false,"gssp":true,"appGip":true,"scriptLoader":[]}</script></body></html>