                <figure class="gallery-item exterior load-gallery"> <img class="img-responsive" src="https://static.squareyards.com/resources/images/mumbai/project-image/kolte-patil-evara-project-amenities-features1-1795.jpg?aio=w-192;h-168;crop;" width="170" height="139" loading="lazy" decoding="async" alt="Kolte Patil Evara Amenities-Features"> </figure>
                
                
