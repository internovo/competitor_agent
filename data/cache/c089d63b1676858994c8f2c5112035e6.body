        NavigationBar_NavButton__JwONn primary" data-testid="blox-button"><div class="Button_ButtonContent__qPyqO Button_ButtonContent-md__1XTQo"><div class="undefined Button_Text-md__R7FDU Button_BtnText__nrjra  primary " data-testid="text-custom">BOOK PROPERTY</div></div></div></div></div><div class="PropertyDetails_RelativeComponentCtn__xJB6K"><div class="PropertyDetails_BodyWrapper__xzEAL"><div class="PropertyDetails_leftSection__nwaCM"><section id="Overview"><div class="Overview_OverviewMain__jK_BF"><div class="Overview_Overview__Bc1p3 false" data-testid="blox-Overview"><h2 class="text_Htitle__vsNcm undefined Overview_HeadingTextOverview__4Xh33"><div class="undefined  text_text-20px__KiVZf" data-testid="text-custom">Overview</div></h2><div class="Overview_OverviewData__cLXua"><div class="TruncatedText_TruncateText__iKHoI text-12 
            undefined
            undefined"><div class="undefined TruncatedText TruncatedText_line-4__CGy8m Overview_OverviewDescriptionTruncText__KLEw7 
                 " data-testid="text-custom">Harshail Hornbill is a premium residential project in Malad West, Mumbai, designed for modern urban living. The project offers spacious 1 BHK homes thoughtfully planned to combine comfort, convenience &amp; lifestyle. Strategically located on Pannalal Ghosh Marg, the development provides excellent connectivity to Mumbai’s best malls, international schools, colleges, a central business district (Mindspace), fine dining restaurants, entertainment zones, sports complexes &amp; the metro railway station. With a picturesque beach in close proximity &amp; vibrant surroundings, Harshail Hornbill Malad West presents an ideal opportunity for homebuyers &amp; property investors seeking premium homes in Mumbai that perfectly balance city life with comfort &amp; convenience.</div></div></div><div class="Overview_OverviewGrid__OKQXI false"><div><div class="Overview_LabelValue__6n8p7"><div class="undefined Overview_OverviewLabel__SqP8W text_text-14px__aPnkg" data-testid="text-custom">Configuration</div><div class="undefined Overview_Value__mQWHK text_text-14px__aPnkg" data-testid="text-custom">1 BHK</div></div></div><div class="Overview_Separator__72rcU"></div><div><div class="Overview_LabelValue__6n8p7"><div class="undefined Overview_OverviewLabel__SqP8W text_text-14px__aPnkg" data-testid="text-custom">Under construction</div><div class="undefined Overview_Value__mQWHK text_text-14px__aPnkg" data-testid="text-custom">Possession in Dec 2026</div></div></div><div class="Overview_Separator__72rcU"></div><div><div class="Overview_LabelValue__6n8p7"><div class="undefined Overview_OverviewLabel__SqP8W text_text-14px__aPnkg" data-testid="text-custom">Avg. Price</div><div class="undefined Overview_Value__mQWHK text_text-14px__aPnkg" data-testid="text-custom">₹28,642/sq.ft</div></div></div><div class="Overview_Separator__72rcU"></div><div><div class="Overview_LabelValue__6n8p7"><div class="undefined Overview_OverviewLabel__SqP8W text_text-14px__aPnkg" data-testid="text-custom">RERA Carpet Area</div><div class="undefined Overview_Value__mQWHK text_text-14px__aPnkg" data-testid="text-custom">335 sqft</div></div></div></div></div><div><div class="Overview_ListContainer__RcPDE "><div class="Overview_highlightHeading__8JSvd">Why consider <span>buying this property</span>?</div><div class="Overview_HighlightsContainer__cYf_c"><ul class="Overview_Squarelist__NXH7D"><li>Premium residential project in Malad West.</li><li>Scenic beach nearby for leisure &amp; recreation.</li><li>Strategically located on Pannalal Ghosh Marg in a prime real estate hub.</li><li>Excellent connectivity to malls, international schools, colleges &amp; Mindspace business district.</li></ul><ul class="Overview_Squarelist__NXH7D"><li>Spacious &amp; thoughtfully designed 1 BHK homes.</li><li>Combines comfort, convenience &amp; a vibrant urban lifestyle.</li><li>Close to fine dining, entertainment zones, sports facilities &amp; the metro railway station.</li></ul></div></div></div></div></section><section id="AIReviewSummary"><div class="AIReviewSummary_Container__cdZ_7 Card_secondary__V9lZX Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="AIReviewSummary_Header__Z33Z1"><div class="AIReviewSummary_TitleWrapper__VrIqs"><div class="AIReviewSummary_TitleRow__RxyFc"><h2 class="text_Htitle__vsNcm AIReviewSummary_Title__r4_AU"><div class="undefined  text_desktop-heading-3__6qV5j" data-testid="text-custom">Google AI Summary</div></h2><span class="AIReviewSummary_Sparkle__4AIGg">✦</span></div><div class="AIReviewSummary_AiBadge__yHMUt"></div></div></div><div class="AIReviewSummary_ContentWrapper__H1KTG" style="max-height:380px"><div class="undefined AIReviewSummary_SummaryText__LoG_f text_desktop-body__tJn8c" data-testid="text-custom">General Satisfaction: The majority of buyers and residents praise the project for delivering modern, well-designed spaces that optimize carpet area effectively. Connectivity Advantage: Reviewers highlight the convenient location due to its close proximity to major transport hubs, essential services, and popular leisure spots. Infrastructure Realities: Multiple online inputs shed light on regular issues relating to heavy traffic jams and excessive noise in the immediate neighborhood.</div><div class="AIReviewSummary_Grid__9zT79"><div class="AIReviewSummary_PointsCard__WtPbt  Card_secondary__V9lZX Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="AIReviewSummary_CardHeader__W5nac"><img alt="up-thumb" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class="AIReviewSummary_CardIcon__x8doc" style="color:transparent" src="/assets/icons/up-thumb.svg"/><h3 class="text_Htitle__vsNcm AIReviewSummary_CardTitle__3bBl_"><div class="undefined  text_desktop-heading-5__YAUk5" data-testid="text-custom">The good things</div></h3></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Metro Connectivity</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">The property is located less than one kilometer away from the Malad West Metro Station, making daily transit highly efficient.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Lifestyle Convenience</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Major shopping landmarks like Infiniti Mall and multiple educational institutions are situated within walking distance or a short drive.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Functional Architecture</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">The units feature zero space wastage layouts designed in accordance with Vastu principles to optimize utility.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Modern Amenities</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Residents have access to unique terrace facilities including a rooftop yoga deck, reflexology pathways, and a children play area.</div></div></div></div><div class="AIReviewSummary_PointsCard__WtPbt  Card_secondary__V9lZX Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="AIReviewSummary_CardHeader__W5nac"><img alt="down-thumb" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class="AIReviewSummary_CardIcon__x8doc" style="color:transparent" src="/assets/icons/down-thumb.svg"/><h3 class="text_Htitle__vsNcm AIReviewSummary_CardTitle__3bBl_"><div class="undefined  text_desktop-heading-5__YAUk5" data-testid="text-custom">Needs improvement</div></h3></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Traffic Congestion</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">The surrounding roads, particularly during peak hours, are prone to heavy traffic and bottlenecking.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Sound and Air Pollution</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Due to the high population density and constant movement of vehicles, noise and pollution levels remain elevated.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Space Constraints</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">The plot size spans less than half an acre, resulting in limited open green spaces on the ground level.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Parking Bottlenecks</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Scarcity of dedicated open visitor parking inside or directly outside the premises causes frequent inconveniences.</div></div></div></div></div><div><hr class="AIReviewSummary_Divider__md7XZ"/><div class="undefined AIReviewSummary_VerdictLabel__jEfM0 text_desktop-heading-5__YAUk5" data-testid="text-custom">The Verdict</div><div class="AIReviewSummary_VerdictTags___OivB"><span class="AIReviewSummary_VerdictTag__XMXZK"><div class="undefined  text_desktop-body-sm__qq5_7" data-testid="text-custom">Good value for money</div></span><span class="AIReviewSummary_VerdictTag__XMXZK"><div class="undefined  text_desktop-body-sm__qq5_7" data-testid="text-custom">Great for working professionals near Mindspace</div></span><span class="AIReviewSummary_VerdictTag__XMXZK"><div class="undefined  text_desktop-body-sm__qq5_7" data-testid="text-custom">Avoid if you prefer large open green townships</div></span></div></div><div class="AIReviewSummary_FadeOverlay__CFpBd" style="opacity:1"></div></div><div class="AIReviewSummary_ToggleContainer__OfGS6 "><button class="AIReviewSummary_ViewMoreBtn__LXBrc"><div class="undefined AIReviewSummary_BtnText__a2mA5 text_mobile-cta__98PCA" data-testid="text-custom">REVEAL FULL SUMMARY</div><span class="AIReviewSummary_BtnIcon__HS5CT">✦</span><div class="AIReviewSummary_Shimmer__D9tsE"></div></button></div></div></section><section id="Amenities"><div class="Amenities_Amenities__Idw7g" data-testid="blox-Amenities"><div class="Amenities_AmmCard__Gu2e5 Card_secondary__V9lZX Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="Amenities_AmenitiesHeadingTxt__bxyH0 squarebx rightPos"><h2 class="text_Htitle__vsNcm "><div class="undefined  text_text-20px__KiVZf" data-testid="text-custom">Amenities</div></h2></div><div class="Amenities_amenitiesDesktop__NRcWU"><div class="Amenities_TagGrid__rI9__"><div class="Amenities_IconLabel__WOGsG"><img alt="amenities/cctv-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class="" style="color:transparent" src="/assets/icons/amenities/cctv-secondary.svg"/><div>CCTV / Video Surveillance</div></div><div class="Amenities_IconLabel__WOGsG"><img alt="amenities/gym-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class="" style="color:transparent" src="/assets/icons/amenities/gym-secondary.svg"/><div>Gymnasium</div></div><div class="Amenities_IconLabel__WOGsG"><img alt="amenities/indoor-games-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class="" style="color:transparent" src="/assets/icons/amenities/indoor-games-secondary.svg"/><div>Indoor Games</div></div><div class="Amenities_IconLabel__WOGsG"><img alt="a