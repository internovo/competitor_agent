\":[{\"type\":0,\"value\":\"We couldn't process your submission. Please try again or email us directly.\"}],\"txTQYk\":[{\"type\":0,\"value\":\"If you have any questions about these Terms of Use, please contact us at:\"}],\"tyvp+j\":[{\"type\":0,\"value\":\"Week-by-week framework from lease signing to full operations that eliminates chaos\"}],\"tzMNF3\":[{\"type\":0,\"value\":\"Status\"}],\"tzYXru\":[{\"type\":0,\"value\":\"Explore LINK Location\"}],\"u/Jwyz\":[{\"type\":0,\"value\":\"Manages all leasing activities at LINK, from initial inquiry through lease signing and move-in coordination. Deep knowledge of the Geneva office market and LINK's unique capabilities supports matching tenants with optimal spaces.\"}],\"u0+84z\":[{\"type\":0,\"value\":\"Press releases and media resources\"}],\"u0g6XO\":[{\"type\":0,\"value\":\"Position Filled\"}],\"u2K47F\":[{\"type\":0,\"value\":\"LINK Geneva is a 33,000 sqm, Minergie-certified office building designed for companies that need more than square meters—they need a strategic asset.\"}],\"u3RbWO\":[{\"type\":0,\"value\":\"Why Work at LINK?\"}],\"u4NOrg\":[{\"type\":0,\"value\":\"For CFOs \u0026 Finance\"}],\"u5R/Dv\":[{\"type\":0,\"value\":\"Role: Country Manager / CEO | Focus: Trust, Speed, Credibility\"}],\"u61c83\":[{\"type\":0,\"value\":\"Expected attendees\"}],\"u8Mu9n\":[{\"type\":0,\"value\":\"Challenge what you've heard about the area, timelines, and landlord promises—with data you can verify\"}],\"u8a4Qw\":[{\"type\":0,\"value\":\"From design partners to project management, LINK provides the ecosystem to deliver your space on time and on budget.\"}],\"u8emcK\":[{\"type\":0,\"value\":\"Test the Commute Yourself\"}],\"u8oqR0\":[{\"type\":0,\"value\":\"Access Control\"}],\"u9iaoM\":[{\"type\":1,\"value\":\"spots\"},{\"type\":0,\"value\":\" spots remaining\"}],\"uAM2YT\":[{\"type\":0,\"value\":\"Moderate Changes (3-4 weeks)\"}],\"uGpb9p\":[{\"type\":0,\"value\":\"Wellness Programs\"}],\"uHQDwN\":[{\"type\":0,\"value\":