],\"4Y0sWv\":[{\"type\":0,\"value\":\"The CFO math was simple: avoided relocation costs paid for the premium on flexible terms within the first expansion.\"}],\"4Y4QS0\":[{\"type\":0,\"value\":\"Underground Parking\"}],\"4YCb8u\":[{\"type\":0,\"value\":\"Major layout modifications, new ceiling systems, enhanced HVAC zones, structural changes.\"}],\"4YpxJr\":[{\"type\":0,\"value\":\"The Decision to Stay\"}],\"4amBqR\":[{\"type\":0,\"value\":\"Download Floor Plans\"}],\"4ciLYH\":[{\"type\":0,\"value\":\"• Suite A: Coming Q2 2025\"}],\"4coDk9\":[{\"type\":1,\"value\":\"percent\"},{\"type\":0,\"value\":\"% ready\"}],\"4cp7lF\":[{\"type\":0,\"value\":\"Behind the Scenes\"}],\"4deWI/\":[{\"type\":0,\"value\":\"Full Floor\"}],\"4eHIX+\":[{\"type\":0,\"value\":\"150+ international destinations\"}],\"4f/sNc\":[{\"type\":0,\"value\":\"Fitted Suites \u0026 Turnkey Offices\"}],\"4fQdQy\":[{\"type\":0,\"value\":\"Floor 6\"}],\"4fiBxq\":[{\"type\":0,\"value\":\"Business \u0026 Events\"}],\"4hvwbp\":[{\"type\":0,\"value\":\"Every Transport Option, One Location\"}],\"4izqMr\":[{\"type\":0,\"value\":\"\\\"Modern\\\" is about how it's operated, not when it was built.\"}],\"4jIH6r\":[{\"type\":0,\"value\":\"Deep dives into transport connections, local amenities, and everything you need to evaluate LINK's location for your team.\"}],\"4ji/XC\":[{\"type\":0,\"value\":\"Evaluate landlord responsiveness—it matters more in hybrid environments\"}],\"4jjx+F\":[{\"type\":0,\"value\":\"Highest available floor with 360-degree views of the Alps and the Jura mountains. High quality fit-out, ready to move in, ideal as a showroom or for VIP client experience\"}],\"4jrvFG\":[{\"type\":0,\"value\":\"Success stories from tenants\"}],\"4k+7aa\":[{\"type\":0,\"value\":\"Leadership / Board Pack\"}],\"4kovEb\":[{\"type\":0,\"value\":\"To Geneva's Multimodal Hub\"}],\"4lmy6t\":[{\"type\":0,\"value\":\"Tenant requests\"}],\"4mv+wc\":[{\"type\":0,\"value\":\"Industries Represented\"}],\"4nrlrg\":[{\"type\":0