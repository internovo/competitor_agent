    <style>
        /* 3-column layout for desktop */
.amenities-list {
    list-style: none;
    padding-left: 0;
    column-count: 3;
    column-gap: 30px;
    margin-bottom: 0; /* remove default bottom margin */
}

.amenities-list li {
    break-inside: avoid;
    padding: 4px 0;
}

/* Wrapper that gets collapsed */
.amenities-wrapper {
    overflow: hidden;
    transition: max-height 0.4s ease-in-out;
}

/* Initial collapsed state – shows only ~3 rows (9 items) */
.amenities-wrapper.collapsed {
    max-height: 200px; /* adjust based on your line height and padding */
}

/* When expanded, remove max-height restriction */
.amenities-wrapper.expanded {
    max-height: none;
}

/* Mobile: single column */
@media (max-width: 767.98px) {
    .amenities-list {
        column-count: 1;
    }
    /* On mobile, collapsed height might need adjustment */
    .amenities-wrapper.collapsed {
        max-height: 300px; /* show a bit more on mobile */
    }
}

/* Toggle button styling */
.toggle-amenities-btn {
    font-weight: 500;
    padding: 6px 20px;
    border-radius: 30px;
    transition: all 0.3s;
}
.toggle-amenities-btn:hover {
    background: #198754;
    color: #fff;
}
.toggle-amenities-btn .bi {
    transition: transform 0.3s;
}
.toggle-amenities-btn[data-expanded="true"] .bi {
    transform: rotate(180deg);
}
/* Location list - 2 columns on desktop */
.location-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px 20px;
    margin-bottom: 0;
}
.location-list p {
    margin-bottom: 0;
    padding: 4px 0;
}

/* Collapsible wrapper */
.location-wrapper {
    overflow: hidden;
    transition: max-height 0.4s ease-in-out;
}
.location-wrapper.collapsed {
    max-height: 200px; /* adjust to show ~6 items (3 rows x 2 cols) */
}
.location-wrapper.expanded {
    max-height: none;
}

/* Mobile: single column */
@media (max-width: 767.98px) {
    .location-list {
        grid-template-columns: 1fr;
    }
    .location-wrapper.collapsed {
        max-height: 300px; /* show a bit more on mobile */
    }
}

/* Toggle button styling (reuse similar to amenities) */
.toggle-location-btn {
    font-weight: 500;
    padding: 6px 20px;
    border-radius: 30px;
    transition: all 0.3s;
}
.toggle-location-btn:hover {
    background: #0d6efd;
    color: #fff;
}
.toggle-location-btn .bi {
    transition: transform 0.3s;
}
.toggle-location-btn[data-expanded="true"] .bi {
    transform: rotate(180deg);
}
