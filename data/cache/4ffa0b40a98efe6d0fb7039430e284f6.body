    function CC_validateForm2() {
        if (document.news.email.value === "Enter your e-mail address" || document.news.email.value === "") {
            alert("Please Enter email id");
            document.news.email.focus();
            return false;
        }
        if (!/^([\w-]+(?:\.[\w-]+)*)@((?:[\w-]+\.)*\w[\w-]{0,66})\.([a-z]{2,6}(?:\.[a-z]{2})?)$/i.test(document.news.email.value)) {
