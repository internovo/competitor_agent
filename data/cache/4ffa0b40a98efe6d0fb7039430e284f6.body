    <script>
        // JavaScript functions (unchanged)
        function whenjQueryReady(callback){if(typeof jQuery!=='undefined'&&typeof $!=='undefined'){callback();}else{var checkInterval=setInterval(function(){if(typeof jQuery!=='undefined'&&typeof $!=='undefined'){clearInterval(checkInterval);callback();}},100);setTimeout(function(){clearInterval(checkInterval);console.error('jQuery failed to load');},5000);}}
        whenjQueryReady(function(){$(document).ready(function(){var stickyNavTop=$('header').offset().top;$(window).scroll(function(){$('header').toggleClass('sticky',$(window).scrollTop()>stickyNavTop);});$('#navToggle').on('click',function(){var expanded=$(this).attr('aria-expanded')==='true';$(this).attr('aria-expanded',!expanded);});$('#enqModal').on('show.bs.modal',function(){$(this).removeAttr('aria-hidden').attr('aria-hidden','false');var $first=$(this).find('input, button, [tabindex]').first();setTimeout(function(){$first.focus();},100);});$('#enqModal').on('hidden.bs.modal',function(){$(this).attr('aria-hidden','true');});$('.enqModal').on('click',function(){var form=$(this).data('form');var title=$(this).data('title');var btn=$(this).data('btn');var enquiry=$(this).data('enquiry');$('.modal-title-secondary').text(title);$('.micro-form-btn').text(btn);$('#enquireName').val(enquiry);if(form=='sm'){$('.form-md').hide();}else{$('.form-md').show();}});});});
        document.addEventListener('DOMContentLoaded',function(){if('IntersectionObserver'in window){const lazyImages=[].slice.call(document.querySelectorAll("img.lazyload"));let lazyImageObserver=new IntersectionObserver(function(entries,observer){entries.forEach(function(entry){if(entry.isIntersecting){let lazyImage=entry.target;lazyImage.src=lazyImage.dataset.src||lazyImage.src;lazyImage.classList.remove("lazyload");lazyImage.classList.add("lazyloaded");lazyImageObserver.unobserve(lazyImage);}});});lazyImages.forEach(function(lazyImage){lazyImageObserver.observe(lazyImage);});}
        document.querySelectorAll('a[href^="#"]').forEach(anchor=>{anchor.addEventListener('click',function(e){e.preventDefault();const targetId=this.getAttribute('href');if(targetId==='#')return;const targetElement=document.querySelector(targetId);if(targetElement){window.scrollTo({top:targetElement.offsetTop-100,behavior:'smooth'});}});});
        if(document.fonts){Promise.all([document.fonts.load('400 16px Poppins'),document.fonts.load('600 16px Montserrat'),document.fonts.load('normal 16px bootstrap-icons')]).then(function(){document.documentElement.classList.add('fonts-loaded');});}setTimeout(function(){document.documentElement.classList.add('fonts-loaded');},3000);
        const criticalCSS=`.blog-title{font-family:'Montserrat','Arial',sans-serif;font-size:2.5rem;line-height:1.2;min-height:3rem;}.blog-meta{min-height:1.5rem;}.detail-card i{min-width:2rem;min-height:2rem;display:inline-block;}`;const style=document.createElement('style');style.textContent=criticalCSS;document.head.appendChild(style);
        if(document.fonts){document.fonts.ready.then(function(){document.documentElement.classList.add('fonts-loaded');document.querySelectorAll('.detail-card i.bi').forEach(function(el){const match=el.className.match(/bi-([a-z-]+)/);if(match)el.parentElement.setAttribute('data-icon',String.fromCharCode({'geo-alt':'F3C8','building':'F1C7','tag':'F48B','house-door':'F333'}[match[1]]||''));});});}else{document.documentElement.classList.add('fonts-loaded');}});
        function onSubmitCaaptchValidation(token){whenjQueryReady(function(){let x=document.forms["caaptchvalidation"]["name"].value;if(x==""){$("#caaptchvalidationerrorname").html("This field is required.");return false;}else{$("#caaptchvalidationerrorname").html("");}
        x=document.forms["caaptchvalidation"]["mobile"].value;var p=/^\d{10}$/;if(x.length!=10){$("#caaptchvalidationerrormobile").html("Please enter 10 digits only.");return false;}else{if(x.match(p)){$("#caaptchvalidationerrormobile").html("");}else{$("#caaptchvalidationerrormobile").html("Invalid format.");return false;}}
        x=document.forms["caaptchvalidation"]["enquiry"].value;if(x!='Immediate Call Back'){x=document.forms["caaptchvalidation"]["email"].value;var validRegex=/^\S+@\S+\.\S+$/;if(x.match(validRegex)){$("#caaptchvalidationerroremail").html("");}else{$("#caaptchvalidationerroremail").html("Invalid email address.");return false;}}
        document.getElementById("caaptchvalidation").submit();setTimeout(function(){window.location.href="https://newprojectsonline.com/thanks";},5000);});}
        function setCookie(name,value,days=7){const date=new Date();date.setTime(date.getTime()+(days*24*60*60*1000));const expires="expires="+date.toUTCString();document.cookie=name+"="+value+";"+expires+";path=/";}
        document.addEventListener('DOMContentLoaded',function(){document.getElementById('form_load_time').value=Math.floor(Date.now()/1000);});
        document.querySelectorAll('.blog-section ul:not(.two-column-list)').forEach(ul=>{if(ul.children.length>5)ul.classList.add('two-column-list');});
        document.addEventListener('DOMContentLoaded', function() {
    const btn = document.getElementById('toggleAmenitiesBtn');
    if (!btn) return;
    const wrapper = document.getElementById('amenitiesWrapper');

    btn.addEventListener('click', function() {
        const isExpanded = this.dataset.expanded === 'true';
        if (isExpanded) {
            // Collapse
            wrapper.classList.remove('expanded');
            wrapper.classList.add('collapsed');
            this.dataset.expanded = 'false';
            this.innerHTML = 'Show All Amenities <i class="bi bi-chevron-down"></i>';
        } else {
            // Expand
            wrapper.classList.remove('collapsed');
            wrapper.classList.add('expanded');
            this.dataset.expanded = 'true';
            this.innerHTML = 'Show Less <i class="bi bi-chevron-up"></i>';
        }
    });
});
// Location toggle
const locBtn = document.getElementById('toggleLocationBtn');
if (locBtn) {
    const locWrapper = document.getElementById('locationWrapper');
    locBtn.addEventListener('click', function() {
        const isExpanded = this.dataset.expanded === 'true';
        if (isExpanded) {
            locWrapper.classList.remove('expanded');
            locWrapper.classList.add('collapsed');
            this.dataset.expanded = 'false';
            this.innerHTML = 'Show All Location Highlights <i class="bi bi-chevron-down"></i>';
        } else {
            locWrapper.classList.remove('collapsed');
            locWrapper.classList.add('expanded');
            this.dataset.expanded = 'true';
            this.innerHTML = 'Show Less <i class="bi bi-chevron-up"></i>';
        }
    });
}
    </script>
