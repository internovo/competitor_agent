<link rel="stylesheet" href="https://www.dhanbhumi.com/assets/css/ai-animation.css?v=359f1c004442d930">
<link rel="stylesheet" href="https://www.dhanbhumi.com/assets/css/ai-welcome.css?v=359f1c004442d930">
<link rel="stylesheet" href="https://www.dhanbhumi.com/assets/css/ai.css?v=359f1c004442d930">
<link rel="stylesheet" href="https://www.dhanbhumi.com/assets/css/ai-responsive.css?v=359f1c004442d930">
<script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>



<div id="ask-ai-modal"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label="DhanBhumi Ask AI workspace"
    data-ai-avatar-url="https://www.dhanbhumi.com/assets/images/golden-lotus.png"
    data-property-fallback-url="https://www.dhanbhumi.com/assets/images/hero-banner.webp"
    style="display: none;">

    
    <button type="button" id="ask-ai-backdrop" aria-label="Close Ask AI workspace"></button>

    
    <div id="ask-ai-container">

        <div id="ask-ai-workspace"
            class="tw-relative tw-flex tw-flex-1 tw-w-full tw-h-full tw-overflow-hidden">

            

            <aside id="ask-ai-left-sidebar"
                aria-label="Ask AI sidebar"
                class="ai-sidebar tw-w-[22%] tw-bg-white tw-border-r tw-border-[#E7DFC9] tw-flex tw-flex-col tw-justify-between tw-flex-shrink-0">

                <div
    class="ai-sidebar-shell tw-p-5 tw-flex tw-flex-col tw-justify-between tw-h-full tw-bg-[#FAF8F5]/50 tw-border-r tw-border-[#E7DFC9]/0">

    <div class="ai-sidebar-main tw-flex tw-flex-col tw-gap-6 tw-flex-1">
        <button
            type="button"
            id="ai-sidebar-toggle"
            class="ai-sidebar-toggle"
            onclick="toggleAiSidebar()"
            aria-label="Expand sidebar">

            <svg
                class="ai-sidebar-toggle-icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6" />
            </svg>
        </button>

        <div class="ai-sidebar-brand tw-flex tw-items-center tw-justify-start tw-py-2">
            <img
                src="https://www.dhanbhumi.com/assets/images/dhanbhumi-logo.png"
                alt="DhanBhumi Logo"
                class="tw-h-7 tw-w-auto tw-object-contain">

            <button
                type="button"
                class="ai-sidebar-dismiss"
                onclick="closeAiMobileSidebar()"
                aria-label="Close AI sidebar">
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.3"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <button
            type="button"
            onclick="resetWorkspaceToWelcome()"
            class="ai-sidebar-new-chat tw-w-full tw-py-3 tw-px-4 tw-mt-2 tw-bg-[#F3F4F1] tw-border tw-border-[#E2DBC8] hover:tw-border-[#1F5A43] tw-rounded-xl tw-text-sm tw-font-semibold tw-text-[#1F5A43] hover:tw-bg-white tw-transition-all tw-cursor-pointer tw-flex tw-items-center tw-justify-center tw-gap-2">

            <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>

            <span class="ai-sidebar-label">New Conversation</span>
        </button>

        <div class="ai-sidebar-search tw-relative">
            <input
                type="text"
                id="ask-ai-sidebar-search-input"
                placeholder="Search conversations..."
                class="tw-w-full tw-pl-10 tw-pr-3 tw-py-2.5 tw-bg-white tw-border tw-border-solid tw-border-[#E2DBC8] focus:tw-border-[#1F5A43] tw-rounded-xl tw-text-xs tw-outline-none tw-transition-all tw-placeholder-[#999999]">

            <span class="tw-absolute tw-left-3.5 tw-top-3.5 tw-text-[#777777] tw-flex tw-items-center">
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
            </span>
        </div>

        <div class="ai-sidebar-content-groups tw-space-y-6">
            <section class="ai-sidebar-panel ai-sidebar-history-panel">
                <div class="ai-sidebar-section-title tw-flex tw-items-center tw-gap-2 tw-mb-2">
                    <span class="tw-text-[9px] tw-font-bold tw-text-[#9B701F] tw-tracking-widest tw-uppercase">
                        Search History
                    </span>
                    <div class="tw-h-[1px] tw-bg-[#E7DFC9]/50 tw-flex-1"></div>
                </div>

                <div id="ask-ai-sidebar-history-scroller" class="ai-sidebar-scroll-region ai-sidebar-history-scroller">
                    <div id="ask-ai-sidebar-history" class="tw-space-y-1"></div>
                </div>

                <p
                    id="ask-ai-sidebar-history-empty"
                    class="tw-hidden tw-m-0 tw-text-[11px] tw-text-[#777777] tw-leading-relaxed">
                    Start a new Ask AI search to build your live conversation history.
                </p>
            </section>

        </div>
    </div>

    <div
        class="ai-sidebar-footer tw-flex tw-flex-col tw-gap-3 tw-pt-4 tw-bg-[#FAF8F5]/50 tw-border-t tw-border-solid tw-border-[#E7DFC9]/0 tw-mt-4">

        <button
            type="button"
            id="ask-ai-liked-properties-toggle"
            class="ai-sidebar-collection-toggle tw-group tw-w-full tw-flex tw-items-center tw-justify-between tw-py-1.5 tw-px-1.5 tw-rounded-lg hover:tw-bg-[#F3F4F1] tw-cursor-pointer tw-transition-colors tw-border-0 tw-bg-transparent">

            <div class="tw-flex tw-items-center tw-gap-2.5 tw-text-[#1F5A43] group-hover:tw-text-[#1F5A43]">
                <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                </svg>

                <span class="ai-sidebar-label tw-text-xs tw-font-bold">
                    Liked Properties
                </span>

                <span
                    id="ask-ai-liked-properties-count"
                    class="ai-sidebar-count-badge tw-hidden tw-min-w-[18px] tw-h-[18px] tw-px-1.5 tw-rounded-full tw-bg-[#1F5A43] tw-text-white tw-text-[10px] tw-font-bold tw-leading-[18px] tw-text-center">
                    0
                </span>
            </div>

            <svg
                id="ask-ai-liked-properties-chevron"
                class="ai-sidebar-chevron tw-transition-transform tw-duration-200"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#1F5A43"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6" />
            </svg>
        </button>

        <button
            type="button"
            id="ask-ai-saved-properties-toggle"
            class="ai-sidebar-collection-toggle tw-group tw-w-full tw-flex tw-items-center tw-justify-between tw-py-1.5 tw-px-1.5 tw-rounded-lg hover:tw-bg-[#F3F4F1] tw-cursor-pointer tw-transition-colors tw-border-0 tw-bg-transparent">

            <div class="tw-flex tw-items-center tw-gap-2.5 tw-text-[#1F5A43] group-hover:tw-text-[#1F5A43]">
