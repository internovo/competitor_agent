      <!-----book a visit form------>
<div class="modal fade" id="propertyInquiryModal" tabindex="-1" aria-labelledby="propertyInquiryLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border: none; border-radius: 20px; overflow: hidden; box-shadow: 0 15px 35px rgba(0,0,0,0.1);">
      
      <!-- Header with gradient -->
      <div class="modal-header" style="background: var(--green-color); border: none; padding: 25px 30px; position: relative;">
        <div class="text-center w-100">
          <h4 class="modal-title text-white mb-2" style="font-weight: 700;">
            Book Your Site Visit of <br> Ruparel Mumbai XL
          </h4>
        </div>
        <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" 
                data-bs-dismiss="modal" aria-label="Close" style="filter: brightness(0) invert(1);"></button>
      </div>

      <!-- Body with enhanced styling -->
      <div class="modal-body" style="padding: 30px; background: linear-gradient(135deg, #ffffff 0%, #f8fffe 100%);">
        
        <!-- Property highlight card -->

        <form id="visitForm" method="POST" action="https://www.dhanbhumi.com/service-quotation">
          <input type="hidden" name="_token" value="l6WkwhENpM4WrSucCUcd1rdiuiCQ2cg8M49FJsVV" autocomplete="off">          <input type="hidden" name="product_id" value="1327">
          <input type="hidden" name="product_name" value="Ruparel Mumbai XL">
          
          <div class="mb-3">
            <label class="form-label" style="color: var(--text-dark); font-weight: 600; margin-bottom: 8px;">
              <i class="fas fa-user me-2" style="color: var(--primary-green);"></i>Full Name
            </label>
            <input type="text" class="form-control" id="visit_name" name="name" 
                   placeholder="Enter your full name" required
                   style="border: 1px solid #9b9b9b; border-radius: 12px; padding: 12px 15px; 
                          background: var(--accent-light); transition: all 0.3s ease;">
            <div class="invalid-feedback" id="visit_name-error"></div>
          </div>

          <div class="mb-3">
            <label class="form-label" style="color: var(--text-dark); font-weight: 600; margin-bottom: 8px;">
              <i class="fas fa-envelope me-2" style="color: var(--primary-green);"></i>Email Address
            </label>
            <input type="email" class="form-control" id="visit_email" name="email" 
                   placeholder="your.email@example.com" required
                   style="border: 1px solid #9b9b9b; border-radius: 12px; padding: 12px 15px; 
                          background: var(--accent-light); transition: all 0.3s ease;">
            <div class="invalid-feedback" id="visit_email-error"></div>
          </div>

          <div class="mb-3">
            <label class="form-label" style="color: var(--text-dark); font-weight: 600; margin-bottom: 8px;">
              <i class="fas fa-phone me-2" style="color: var(--primary-green);"></i>Phone Number
            </label>
            <div class="input-group">
              <span class="input-group-text" style="background: var(--green-color); color: white; border: none; font-weight: 600;">+91</span>
              <input type="tel" class="form-control" id="visit_phone" name="number" 
                     placeholder="Enter 10-digit mobile number" required pattern="[0-9]{10}"
                     style="border: 1px solid #9b9b9b; border-left: none; background: var(--accent-light); 
                            transition: all 0.3s ease;">
            </div>
            <div class="invalid-feedback" id="visit_phone-error"></div>
          </div>

          <div class="mb-4">
            <label class="form-label" style="color: var(--text-dark); font-weight: 600; margin-bottom: 8px;">
              <i class="fas fa-calendar-alt me-2" style="color: var(--primary-green);"></i>Preferred Visit Date
            </label>
            <input type="date" class="form-control" id="visit_date" min="2026-09-08" name="visit_date" required
                   style="border: 1px solid #9b9b9b; border-radius: 12px; padding: 12px 15px; 
                          background: var(--accent-light); transition: all 0.3s ease;">
            <div class="invalid-feedback" id="visit_date-error"></div>
            <small class="text-muted mt-1 d-block">
              <i class="fas fa-info-circle me-1"></i>We'll confirm the appointment within 2 hours
            </small>
          </div>

          <!-- Enhanced submit button -->
          <button type="submit" class="btn w-100" id="visitSubmitBtn"
                  style="background:var(--green-color); 
                         color: white; border: none; padding: 15px 30px; border-radius: 12px; 
                         font-weight: 600; font-size: 16px; letter-spacing: 0.5px; 
                         transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                         box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3); position: relative; overflow: hidden;">
            <i class="fas fa-calendar-check me-2"></i>Schedule My Visit
          </button>

          <!-- Trust indicators -->
          <div class="text-center mt-3">
            <small class="text-muted d-flex align-items-center justify-content-center">
              <i class="fas fa-shield-alt me-2" style="color: var(--primary-green);"></i>
              Your information is secure and confidential
            </small>
          </div>
        </form>
      </div>
    </div>
  </div>
</div> 
    
