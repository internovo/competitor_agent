            .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10.3; /* same visual weight as map */
    background: #f4f4f4;
    border-radius: 10px;
    overflow: hidden;
}

.video-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover; /* fills the box nicely */
    display: block;
}
.media-xl,.property-slider-container,.custom-latest-blog-container,.faq-video-card{
    background-color: white;
    padding: 2%;
    border-radius: 10px;
}
          
