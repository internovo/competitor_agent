                </div>

                <div
                    id="ask-ai-expert-modal"
                    role="dialog"
                    aria-modal="true"
                    aria-hidden="true"
                    aria-labelledby="ask-ai-expert-modal-title"
                    class="ai-expert-modal tw-hidden tw-absolute tw-inset-0 tw-z-[125] tw-flex tw-items-center tw-justify-center tw-p-4 sm:tw-p-6">

                    <button
                        type="button"
                        id="ask-ai-expert-backdrop"
                        class="tw-absolute tw-inset-0 tw-border-0 tw-bg-[rgba(15,23,42,0.24)] tw-backdrop-blur-[3px]"
                        aria-label="Close expert request form">
                    </button>

                    <form
                        id="ask-ai-expert-form"
                        class="ai-expert-dialog tw-relative tw-z-10 tw-w-full tw-max-w-[430px] tw-overflow-hidden tw-rounded-[20px] tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-white tw-shadow-[0_24px_80px_rgba(15,23,42,0.18)]"
                        novalidate>

                        <div class="tw-flex tw-items-start tw-justify-between tw-gap-4 tw-border-b tw-border-solid tw-border-[#F0E8D8] tw-px-5 tw-py-4">
                            <div class="tw-min-w-0">
                                <h3 id="ask-ai-expert-modal-title" class="tw-m-0 tw-mt-1 tw-text-base tw-font-extrabold tw-text-[#B88A2D]">
                                    Request a callback
                                </h3>
                            </div>

                            <button
                                type="button"
                                id="ask-ai-expert-close"
                                class="ai-expert-close tw-inline-flex tw-h-8 tw-w-8 tw-flex-shrink-0 tw-items-center tw-justify-center tw-rounded-lg tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-white tw-text-[#777777] tw-transition-all hover:tw-border-[#B88A2D] hover:tw-text-[#1F5A43]"
                                aria-label="Close expert request form">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>

                        <div class="ai-expert-fields tw-space-y-4 tw-px-5 tw-py-5">
                            <div>
                                <label for="ask-ai-expert-name" class="tw-mb-1.5 tw-block tw-text-[11px] tw-font-bold tw-text-[#555555]">
                                    Name
                                </label>
                                <input
                                    id="ask-ai-expert-name"
                                    name="name"
                                    type="text"
                                    maxlength="80"
                                    autocomplete="name"
                                    placeholder="Enter your full name"
                                    class="ai-expert-input tw-h-11 tw-w-full tw-rounded-xl tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-white tw-px-3.5 tw-text-sm tw-text-[#222222] tw-outline-none"
                                    aria-describedby="ask-ai-expert-name-error">
                                <p id="ask-ai-expert-name-error" class="ai-expert-field-error tw-hidden tw-m-0 tw-mt-1.5 tw-text-[11px] tw-font-semibold tw-text-[#9B3D35]"></p>
                            </div>

                            <div>
                                <label for="ask-ai-expert-phone" class="tw-mb-1.5 tw-block tw-text-[11px] tw-font-bold tw-text-[#555555]">
                                    Contact number
                                </label>
                                <input
                                    id="ask-ai-expert-phone"
                                    name="phone"
                                    type="tel"
                                    inputmode="numeric"
                                    maxlength="14"
                                    autocomplete="tel"
                                    placeholder="Enter 10-digit mobile number"
                                    class="ai-expert-input tw-h-11 tw-w-full tw-rounded-xl tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-white tw-px-3.5 tw-text-sm tw-text-[#222222] tw-outline-none"
                                    aria-describedby="ask-ai-expert-phone-error">
                                <p id="ask-ai-expert-phone-error" class="ai-expert-field-error tw-hidden tw-m-0 tw-mt-1.5 tw-text-[11px] tw-font-semibold tw-text-[#9B3D35]"></p>
                            </div>

                            <div
                                id="ask-ai-expert-form-error"
                                class="tw-hidden tw-rounded-xl tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-[#FFF9F0] tw-px-3.5 tw-py-2.5 tw-text-[11px] tw-font-semibold tw-leading-relaxed tw-text-[#555555]"
                                role="alert"
                                aria-live="polite">
                            </div>
                        </div>

                        <div class="tw-flex tw-justify-end tw-border-t tw-border-solid tw-border-[#F0E8D8] tw-bg-[#FCFBF8] tw-px-5 tw-py-4">
                            <button
                                type="submit"
                                id="ask-ai-expert-submit"
                                class="ai-expert-submit tw-inline-flex tw-h-10 tw-min-w-[132px] tw-items-center tw-justify-center tw-gap-2 tw-rounded-xl tw-border-0 tw-bg-[#1F5A43] tw-px-5 tw-text-xs tw-font-bold tw-text-white tw-transition-all hover:tw-bg-[#174734] disabled:tw-cursor-not-allowed disabled:tw-opacity-60">
                                <span data-ai-expert-submit-label>Request callback</span>
                                <svg data-ai-expert-submit-icon width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h14M13 6l6 6-6 6" />
                                </svg>
                            </button>
                        </div>
                    </form>
                </div>

                <div
                    id="ask-ai-collection-modal"
                    role="dialog"
                    aria-modal="true"
                    aria-hidden="true"
                    aria-labelledby="ask-ai-collection-modal-title"
                    class="tw-hidden tw-absolute tw-inset-0 tw-z-[120] tw-flex tw-items-center tw-justify-center tw-p-4 sm:tw-p-5">

                    <button
                        type="button"
                        id="ask-ai-collection-modal-backdrop"
                        class="tw-absolute tw-inset-0 tw-border-0 tw-bg-[rgba(15,23,42,0.22)] tw-backdrop-blur-[3px]"
                        aria-label="Close property collection modal">
                    </button>

                    <div
                        class="tw-relative tw-z-10 tw-flex tw-w-full tw-max-w-[540px] tw-flex-col tw-overflow-hidden tw-rounded-[24px] tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-white tw-shadow-[0_24px_80px_rgba(15,23,42,0.16)]">

                        <div class="tw-flex tw-items-start tw-justify-between tw-gap-3 tw-border-b tw-border-solid tw-border-[#FAF8F3] tw-bg-[#FAF8F3] tw-px-4 tw-py-4 sm:tw-px-5">
                            <div class="tw-min-w-0">
                                <div class="tw-flex tw-items-center tw-gap-2">
                                    <h3
                                        id="ask-ai-collection-modal-title"
                                        class="tw-m-0 tw-text-sm tw-font-bold tw-text-[#1F5A43]">
                                        Saved Properties
                                    </h3>

                                    <span
                                        id="ask-ai-collection-modal-count"
                                        class="tw-inline-flex tw-min-w-[22px] tw-items-center tw-justify-center tw-rounded-full tw-bg-[#1F5A43] tw-px-2 tw-py-0.5 tw-text-[10px] tw-font-bold tw-text-white">
                                        0
                                    </span>
                                </div>

                                <p
                                    id="ask-ai-collection-modal-subtitle"
                                    class="tw-m-0 tw-mt-1 tw-text-[11px] tw-font-medium tw-text-[#777777]">
                                    Review your saved properties, compare them, or open details.
                                </p>
                            </div>

                            <button
                                type="button"
                                id="ask-ai-collection-modal-close"
                                class="tw-inline-flex tw-h-7 tw-w-7 tw-flex-shrink-0 tw-items-center tw-justify-center tw-text-[#888888] tw-transition-all hover:tw-text-[#555555]"
                                aria-label="Close property collection modal">
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.3"
                                    stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>

                        <div class="tw-p-4 sm:tw-p-5">
                            <div
                                id="ask-ai-collection-modal-list"
                                class="tw-space-y-2 tw-max-h-[min(62vh,460px)] tw-overflow-y-auto tw-pr-1">
                            </div>

                            <p
                                id="ask-ai-collection-modal-empty"
                                class="tw-hidden tw-m-0 tw-rounded-xl tw-border tw-border-dashed tw-border-[#E7DFC9] tw-bg-[#FAF8F3] tw-p-4 tw-text-[12px] tw-leading-relaxed tw-text-[#777777]">
                                No properties available in this collection yet.
                            </p>

                            <div
                                id="ask-ai-collection-modal-actions"
                                class="tw-hidden tw-mt-4 tw-flex tw-justify-end">
                                <button
                                    type="button"
                                    id="ask-ai-collection-modal-compare"
                                    class="tw-inline-flex tw-items-center tw-gap-2 tw-rounded-xl tw-bg-[#1F5A43] tw-px-4 tw-py-2.5 tw-text-xs tw-font-bold tw-text-white tw-transition-all hover:tw-bg-[#174734]">
                                    <svg
                                        width="14"
                                        height="14"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <path d="M16 3h5v5M4 20L20 4M21 16v5h-5M15 15l5 5M4 4l5 5" />
                                    </svg>
                                    <span id="ask-ai-collection-modal-compare-label">Compare Selected</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div
                    id="ask-ai-compare-modal"
                    role="dialog"
                    aria-modal="true"
                    aria-hidden="true"
                    aria-labelledby="ask-ai-compare-modal-title"
                    class="tw-hidden tw-absolute tw-inset-0 tw-z-50 tw-bg-[#FAF8F5]/92 tw-backdrop-blur-sm tw-p-4 sm:tw-p-6">
                    <div class="tw-flex tw-h-full tw-flex-col tw-rounded-[24px] tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-white tw-shadow-[0_24px_80px_rgba(15,23,42,0.12)]">
                        <div class="tw-flex tw-items-center tw-justify-between tw-gap-4 tw-border-b tw-border-solid tw-border-[#E7DFC9]/70 tw-px-5 tw-py-4 sm:tw-px-6">
                            <div>
                                <h3 id="ask-ai-compare-modal-title" class="tw-m-0 tw-text-lg tw-font-bold tw-text-[#1F5A43]">Property Comparison</h3>
                                <p class="tw-m-0 tw-mt-1 tw-text-xs tw-font-medium tw-text-[#777777]">
                                    Compare selected properties with full database-backed details.
                                </p>
                            </div>

                            <button
                                type="button"
                                id="ask-ai-compare-close"
                                class="tw-inline-flex tw-h-10 tw-w-10 tw-items-center tw-justify-center tw-rounded-full tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-white tw-text-[#555555] tw-transition-all hover:tw-border-red-200 hover:tw-text-red-500"
                                aria-label="Close compare panel">
                                <svg class="tw-h-5 tw-w-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>

                        <div class="tw-flex-1 tw-overflow-y-auto tw-p-5 sm:tw-p-6">
                            <div id="ask-ai-compare-modal-content"></div>
                        </div>
                    </div>
                </div>

                
                <div id="ask-ai-bottom-bar"
    class="tw-hidden tw-sticky tw-bottom-0 tw-z-40 tw-p-4 sm:tw-p-5 tw-bg-[#FAF8F5]/85 tw-backdrop-blur-md tw-border-t tw-border-[#E7DFC9]/60 tw-shadow-[0_-5px_20px_rgba(0,0,0,0.02)]">

    <div
        id="ask-ai-compare-tray"
        class="tw-hidden tw-mb-3 tw-rounded-[20px] tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-white tw-p-3 sm:tw-p-4 tw-shadow-[0_10px_30px_rgba(31,90,67,0.06)]">
        <div class="tw-flex tw-flex-col tw-gap-3 lg:tw-flex-row lg:tw-items-center lg:tw-justify-between">
            <div class="tw-min-w-0 tw-flex-1">
                <div class="tw-flex tw-items-center tw-gap-2">
                    <span class="tw-text-[10px] tw-font-bold tw-tracking-[0.14em] tw-uppercase tw-text-[#9B701F]">
                        Compare Properties
                    </span>
                    <span id="ask-ai-compare-count" class="tw-text-[11px] tw-font-bold tw-text-[#1F5A43]">
                        0/2 Selected
                    </span>
                </div>
                <div id="ask-ai-compare-list" class="tw-flex tw-flex-wrap tw-gap-2 tw-mt-2"></div>
            </div>

            <div class="tw-flex tw-items-center tw-gap-2 tw-flex-shrink-0">
                <button
                    type="button"
                    id="ask-ai-compare-clear"
                    class="tw-px-3.5 tw-py-2 tw-rounded-xl tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-white tw-text-[#555555] tw-text-xs tw-font-bold tw-cursor-pointer tw-transition-all hover:tw-border-red-200 hover:tw-text-red-500">
                    Clear
                </button>
                <button
                    type="button"
                    id="ask-ai-compare-open"
                    class="tw-px-4 tw-py-2 tw-rounded-xl tw-border-0 tw-bg-[#1F5A43] tw-text-white tw-text-xs tw-font-bold tw-cursor-pointer tw-transition-all hover:tw-bg-[#174734] disabled:tw-opacity-50 disabled:tw-cursor-not-allowed">
                    Compare Now
                </button>
            </div>
        </div>
    </div>

    <form
        id="ask-ai-chat-form"
        onsubmit="submitChatMessage(event)"
        class="chat-input-container tw-flex tw-items-center tw-gap-3 sm:tw-gap-4 tw-rounded-[20px] tw-px-4 sm:tw-px-5 tw-py-3">

        <button
            type="button"
            id="ask-ai-filter-open"
            class="ai-filter-open-btn tw-group tw-relative tw-w-10 tw-h-10 tw-rounded-xl tw-bg-white tw-text-[#1F5A43] hover:tw-text-[#B88A2D] tw-cursor-pointer tw-flex tw-items-center tw-justify-center tw-transition-all tw-flex-shrink-0"
            title="Tune Filters"
            aria-label="Customize property requirement">
            <svg class="tw-h-4 tw-w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 21v-7" />
                <path d="M4 10V3" />
                <path d="M12 21v-9" />
                <path d="M12 8V3" />
                <path d="M20 21v-5" />
                <path d="M20 12V3" />
                <path d="M2 14h4" />
                <path d="M10 8h4" />
                <path d="M18 16h4" />
            </svg>
            <span class="tw-absolute tw-bottom-full tw-mb-2 tw-left-1/2 -tw-translate-x-1/2 tw-px-2.5 tw-py-1 tw-bg-[#1F5A43] tw-text-white tw-text-[10px] tw-font-bold tw-rounded-md tw-whitespace-nowrap tw-opacity-0 tw-pointer-events-none group-hover:tw-opacity-100 tw-transition-opacity tw-shadow-md tw-z-20">
               Filters
            </span>
        </button>

        <input
            type="text"
            id="ask-ai-chat-input"
            placeholder="Ask follow-up questions or refine search..."
            autocomplete="off"
            class="tw-flex-1 tw-min-w-0 tw-border-0 tw-outline-none tw-bg-transparent tw-text-sm tw-text-[#222222] tw-placeholder-[#999999] tw-p-0">

        <button
            type="submit"
            id="ask-ai-chat-submit"
            class="chat-send-btn send-btn-animate tw-w-10 tw-h-10 tw-rounded-xl tw-bg-[#B88A2D] hover:tw-bg-[#1F5A43] tw-text-white tw-border-0 tw-cursor-pointer tw-flex tw-items-center tw-justify-center tw-shadow-md hover:tw-shadow-lg tw-transition-all tw-flex-shrink-0 tw-relative tw-overflow-hidden"
            aria-label="Send message">

            <div class="tw-flex tw-items-center tw-justify-center">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"
                    stroke-linecap="round" stroke-linejoin="round" class="arrow-svg">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                </svg>

                <span class="sparkle-hover tw-absolute tw-opacity-0 tw-scale-50" style="right:6px;">
                    <svg class="ai-theme-sparkle ai-theme-sparkle--hover" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z" />
                    </svg>
                </span>
            </div>
        </button>
    </form>
</div>

            </div>
        </div>
    </div>

    
    <template id="ask-ai-property-card-template">
    <article
        class="ai-property-card tw-bg-white tw-border tw-border-solid tw-border-[#E7DFC9]/70 tw-rounded-[24px] tw-overflow-hidden hover:tw-shadow-lg tw-transition-all tw-duration-300 tw-group tw-flex tw-flex-col tw-justify-between tw-min-h-[500px]"
        data-property-index="">

        <div class="ai-property-card-media tw-relative tw-h-48 tw-bg-gray-100 tw-overflow-hidden">
            <a data-ai-card-detail href="#" target="_blank" rel="noopener noreferrer" class="tw-block tw-w-full tw-h-full">
                <img
                    data-ai-card-image
                    data-ai-image-fallback
                    data-ai-image-missing="false"
                    src="https://www.dhanbhumi.com/assets/images/hero-banner.webp"
                    alt="Property"
                    loading="lazy"
                    class="tw-w-full tw-h-full tw-object-cover group-hover:tw-scale-105 tw-transition-transform tw-duration-500">
            </a>

            <span class="tw-absolute tw-top-3.5 tw-left-3.5 tw-bg-[#1E4D3A] tw-text-white tw-text-[11px] tw-font-bold tw-px-3 tw-py-1 tw-rounded-full tw-shadow-sm">
                <span data-ai-card-match>90%</span> Match
            </span>

            <button
                type="button"
                class="js-ai-save tw-absolute tw-top-3.5 tw-right-3.5 tw-w-8 tw-h-8 tw-rounded-full tw-bg-black/10 hover:tw-bg-black/30 tw-flex tw-items-center tw-justify-center tw-border-0 tw-cursor-pointer tw-text-white tw-transition-all"
                title="Add to favorites">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                </svg>
            </button>
        </div>

        <div class="ai-property-card-body tw-p-5 tw-flex tw-flex-col tw-justify-between tw-flex-1">
            <div class="tw-space-y-2.5">
                <div>
                    <h4
                        data-ai-card-title
                        class="tw-text-base tw-font-bold tw-text-[#222222] tw-m-0">
                        Property
                    </h4>

                    <div class="tw-flex tw-items-start tw-gap-1.5 tw-mt-1 tw-text-[#888888]">
                        <svg width="13" height="13" class="tw-flex-none tw-mt-[2px] tw-text-[#777777]"
                            style="width:13px;height:13px;min-width:13px;display:block;"
                            viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z" />
                        </svg>

                        <span data-ai-card-location class="tw-text-xs tw-leading-[1.35]">
                            Location not available
                        </span>
                    </div>
                </div>

                <div class="tw-text-xs tw-text-[#666666] tw-font-medium">
                    <span data-ai-card-bhk>Configuration</span>
                    <span class="tw-mx-1.5 tw-text-[#E7DFC9]">&bull;</span>
                    <span data-ai-card-size>Size on request</span>
                </div>

                <div class="ai-property-card-price-row tw-flex tw-items-baseline tw-justify-between tw-pt-1">
                    <span
                        data-ai-card-price
                        class="tw-text-[20px] tw-font-extrabold tw-text-[#222222]">
                        Price on request
                    </span>

                    <span class="tw-text-[11px] tw-text-[#888888] tw-font-medium">
                        All Incl.
                    </span>
                </div>

                <div class="tw-flex tw-flex-wrap tw-gap-1.5 tw-pt-1">
                    <span
                        data-ai-card-status
                        class="tw-bg-[#EAF0ED] tw-text-[#1F5A43] tw-text-[10px] tw-font-bold tw-px-2.5 tw-py-1.5 tw-rounded-lg">
                        Available
                    </span>

                    <span
                        data-ai-card-tag
                        class="tw-bg-[#EAF0ED] tw-text-[#1F5A43] tw-text-[10px] tw-font-bold tw-px-2.5 tw-py-1.5 tw-rounded-lg">
                        Good Location
                    </span>
                </div>

                <p
                    data-ai-card-insight
                    class="tw-m-0 tw-pt-1 tw-text-[11px] tw-font-bold tw-text-[#555555]">
                    Strong match for your search.
                </p>
            </div>

            <div class="ai-property-card-actions tw-flex tw-items-center tw-gap-2 tw-mt-5">
                <a
                    data-ai-card-detail
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tw-flex-1 tw-py-2.5 tw-border tw-border-solid tw-border-[#1F5A43] hover:tw-bg-[#1F5A43] tw-text-[#1F5A43] hover:tw-text-white tw-rounded-xl tw-text-xs tw-font-bold tw-text-center tw-no-underline tw-transition-all tw-duration-200">
                    View Details
                </a>

                <button
                    type="button"
                    class="js-ai-compare tw-flex tw-items-center tw-justify-center tw-gap-1.5 tw-py-2.5 tw-px-3 tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-white hover:tw-border-[#1F5A43] tw-rounded-xl tw-text-xs tw-font-bold tw-text-[#555555] hover:tw-text-[#1F5A43] tw-cursor-pointer tw-transition-all tw-duration-200"
                    title="Compare property">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 3h5v5M4 20L20 4M21 16v5h-5M15 15l5 5M4 4l5 5" />
                    </svg>
                    <span class="ai-property-card-compare-label">Compare</span>
                </button>

                <button
                    type="button"
                    class="js-ai-bookmark tw-w-10 tw-h-10 tw-flex tw-items-center tw-justify-center tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-white hover:tw-border-[#1F5A43] tw-rounded-xl tw-text-[#555555] hover:tw-text-[#1F5A43] tw-cursor-pointer tw-transition-all tw-duration-200"
                    title="Save for later">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                    </svg>
                </button>
            </div>
        </div>
    </article>
</template>

