        <script>
            
function calculateEMI() {
    let principal = parseInt(document.getElementById("loanAmount").value);
    let annualRate = parseFloat(document.getElementById("interestRate").value);
    let years = parseInt(document.getElementById("loanTenure").value);
    
    // Validate inputs
    if (isNaN(principal) || isNaN(annualRate) || isNaN(years) || 
        principal <= 0 || annualRate <= 0 || years <= 0) {
        document.getElementById("emiResult").innerText = "₹0";
        return;
    }
    
    let monthlyRate = annualRate / 12 / 100;
    let months = years * 12;
    
    let emi = (principal * monthlyRate * Math.pow(1 + monthlyRate, months)) /
              (Math.pow(1 + monthlyRate, months) - 1);
    
    document.getElementById("emiResult").innerText = "₹" + Math.round(emi).toLocaleString("en-IN", { maximumFractionDigits: 0 });
    document.getElementById("loanValue").innerText = principal.toLocaleString("en-IN");
}

// Initialize EMI Calculator with Property Price
function initializeEMICalculator() {
    // Get property price from PHP (you'll need to add this)
    const propertyPrice = 20000000;
    const minLoanAmount = 50000;
    const maxLoanAmount = propertyPrice;
    const defaultLoanAmount = Math.max(minLoanAmount, Math.round(propertyPrice * 0.8));
    
    // Update the loan amount slider
    const loanSlider = document.getElementById("loanAmount");
    if (loanSlider) {
        loanSlider.min = minLoanAmount;
        loanSlider.max = maxLoanAmount;
        loanSlider.value = defaultLoanAmount;
        loanSlider.step = Math.max(50000, Math.round(maxLoanAmount / 100)); // Dynamic step size
    }
    
    // Update the display labels
    const maxLabel = document.querySelector('.d-flex.justify-content-between.small.text-muted span:last-child');
    if (maxLabel) {
        if (maxLoanAmount >= 10000000) {
            maxLabel.textContent = '₹' + (maxLoanAmount / 10000000).toFixed(1) + ' Cr';
        } else if (maxLoanAmount >= 100000) {
            maxLabel.textContent = '₹' + (maxLoanAmount / 100000).toFixed(1) + ' Lac';
        } else {
            maxLabel.textContent = '₹' + (maxLoanAmount / 1000).toFixed(0) + 'K';
        }
    }
    
    // Calculate initial EMI
    calculateEMI();
}

// Event listeners for EMI calculator
document.getElementById("loanAmount").addEventListener("input", calculateEMI);
document.getElementById("interestRate").addEventListener("input", calculateEMI);
document.getElementById("loanTenure").addEventListener("change", calculateEMI);

            
            
     // Gallery Slider
 class SlidingGallery {
  constructor() {
    this.slidesWrapper = document.getElementById("slidesWrapper");
    this.thumbnails = document.querySelectorAll(".thumbnail");
    this.indicators = document.querySelectorAll(".indicator");
    this.progressBar = document.getElementById("progressBar");
    this.gallery = document.getElementById("propertyGallery");
    
    this.currentIndex = 0;
    this.totalSlides = this.indicators.length;
    this.interval = null;
    this.progressInterval = null;
    this.autoPlayDuration = 2000;
    this.isTransitioning = false;
    
    this.init();
  }
  
  init() {
    this.cloneFirstSlide();
    this.setupDynamicStyles();
    this.setupEventListeners();
    this.updateSlidePosition(false);
    this.startAutoPlay();
  }
  
  cloneFirstSlide() {
    const slides = this.slidesWrapper.querySelectorAll('.slide');
    if (slides.length > 0) {
      const firstSlideClone = slides[0].cloneNode(true);
      this.slidesWrapper.appendChild(firstSlideClone);
    }
  }
  
  setupDynamicStyles() {
    // totalSlides + 1 clone
    const totalWithClone = this.totalSlides + 1;
    this.slidesWrapper.style.width = `${totalWithClone * 100}%`;
    
    const allSlides = this.slidesWrapper.querySelectorAll('.slide');
    allSlides.forEach(slide => {
      slide.style.flex = `0 0 ${100 / totalWithClone}%`;
      slide.style.width = `${100 / totalWithClone}%`;
    });
  }
  
  setupEventListeners() {
    this.thumbnails.forEach((thumb, index) => {
      thumb.addEventListener("click", () => {
        this.goToSlide(index);
        this.restartAutoPlay();
      });
    });
    
    this.indicators.forEach((indicator, index) => {
      indicator.addEventListener("click", () => {
        this.goToSlide(index);
        this.restartAutoPlay();
      });
    });

    this.gallery.addEventListener("mouseenter", () => {
      this.pauseAutoPlay();
    });
    
    this.gallery.addEventListener("mouseleave", () => {
      this.startAutoPlay();
    });
    
    let startX = 0;
    let endX = 0;
    
    this.slidesWrapper.addEventListener("touchstart", (e) => {
      startX = e.touches[0].clientX;
    });
    
    this.slidesWrapper.addEventListener("touchend", (e) => {
      endX = e.changedTouches[0].clientX;
      this.handleSwipe(startX, endX);
    });
    
    // Handle the seamless loop
    this.slidesWrapper.addEventListener("transitionend", () => {
      if (this.currentIndex === this.totalSlides) {
        // We're at the cloned first slide
        this.slidesWrapper.style.transition = 'none';
        this.currentIndex = 0;
        this.updateSlidePosition(false);
        this.updateActiveStates();
        
        // Re-enable transition after jump
        setTimeout(() => {
          this.slidesWrapper.style.transition = '';
          this.isTransitioning = false;
        }, 50);
      } else {
        this.isTransitioning = false;
      }
    });
  }
  
  handleSwipe(startX, endX) {
    const swipeThreshold = 50;
    const diff = startX - endX;
    
    if (Math.abs(diff) > swipeThreshold) {
      if (diff > 0) {
        this.nextSlide();
      } else {
        this.previousSlide();
      }
      this.restartAutoPlay();
    }
  }
  
  goToSlide(index) {
    if (this.isTransitioning) return;
    this.currentIndex = index;
    this.updateSlidePosition(true);
    this.updateActiveStates();
  }
  
  nextSlide() {
    if (this.isTransitioning) return;
    this.currentIndex++;
    this.updateSlidePosition(true);
    this.updateActiveStates();
  }
  
  previousSlide() {
    if (this.isTransitioning) return;
    
    if (this.currentIndex > 0) {
      this.currentIndex--;
      this.updateSlidePosition(true);
    } else {
      // Jump to last slide
      this.currentIndex = this.totalSlides - 1;
      this.updateSlidePosition(true);
    }
    this.updateActiveStates();
  }
  
  updateSlidePosition(animate = true) {
    if (animate) {
      this.isTransitioning = true;
      this.slidesWrapper.style.transition = 'transform 0.5s ease-in-out';
    } else {
      this.slidesWrapper.style.transition = 'none';
    }
    
    const totalWithClone = this.totalSlides + 1;
    const slideWidth = 100 / totalWithClone;
    const translateX = -this.currentIndex * slideWidth;
    this.slidesWrapper.style.transform = `translateX(${translateX}%)`;
  }
  
  updateActiveStates() {
    // Map to actual slide index
    const activeIndex = this.currentIndex % this.totalSlides;
    
    this.thumbnails.forEach(t => t.classList.remove("active"));
    if (this.thumbnails[activeIndex]) {
      this.thumbnails[activeIndex].classList.add("active");
    }
    
    this.indicators.forEach(i => i.classList.remove("active"));
    if (this.indicators[activeIndex]) {
      this.indicators[activeIndex].classList.add("active");
    }
  }
  
  startAutoPlay() {
    if (this.interval) return;
    
    this.interval = setInterval(() => {
      this.nextSlide();
    }, this.autoPlayDuration);
    
    this.startProgressBar();
  }
  
  pauseAutoPlay() {
    if (this.interval) {
      clearInterval(this.interval);
      this.interval = null;
    }
    this.stopProgressBar();
  }
  
  restartAutoPlay() {
    this.pauseAutoPlay();
    setTimeout(() => {
      this.startAutoPlay();
    }, 100);
  }
  
  startProgressBar() {
    let progress = 0;
    this.progressBar.style.width = '0%';
    
    if (this.progressInterval) {
      clearInterval(this.progressInterval);
    }
    
    this.progressInterval = setInterval(() => {
      progress += (100 / (this.autoPlayDuration / 50));
      this.progressBar.style.width = progress + '%';
      
      if (progress >= 100) {
        progress = 0;
      }
    }, 50);
  }
  
  stopProgressBar() {
    if (this.progressInterval) {
      clearInterval(this.progressInterval);
      this.progressInterval = null;
    }
  }
}

    // Initialize the gallery
    document.addEventListener('DOMContentLoaded', () => {
      new SlidingGallery();
    });           
            
            
    // Gallery Functions
    function changeSlide(index) {
