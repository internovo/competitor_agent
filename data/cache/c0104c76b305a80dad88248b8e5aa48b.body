          .project-by{
            background-color: var(--green-color);
            color: var(--white-color);
            padding: 3% 9%;
                margin-bottom: 7%;
                    text-align: center;
          }  
            
            
            
            /* Gallery Section */
    .property-gallery {
      position: relative;
      margin-bottom: 2rem;
    }

    .gallery-container {
      display: flex;
      gap: 1rem;
      width: 100%;
    }
    .book-visit{
                    margin-left: 52px;
                }

    /* Thumbnail Columns Container */
    .thumbnails-container {
      display: flex;
      gap: 0.5rem;
     
    }
    .btn{
        font-size: 16px;
    }
    .thumbnail-column {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      width: 100px;
    }

    .thumbnail {
      cursor: pointer;
      overflow: hidden;
      border-radius: 8px;
      border: 2px solid transparent;
      transition: all 0.3s ease;
      opacity: 0.7;
    }

    .thumbnail:hover {
      opacity: 1;
      transform: scale(1.05);
    }

    .thumbnail.active {
      border-color: var(--primary-color);
      opacity: 1;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    .thumbnail img {
      width: 100%;
      height: 80px;
      object-fit: cover;
      display: block;
    }

    /* Main Slider */
    .slider-container {
      position: relative;
      flex: 1;
      overflow: hidden;
      border-radius: 12px;
      background: #f5f5f5;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }
    .master-plan-images img{
        min-width:100%;
        max-height:500px;
        width: 100%;
    }
    .slides-wrapper {
      display: flex;
      transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
      height: 500px;
      width: 1500%; /* 100% × 15 slides */
    }

    .slide {
      width: 6.666%; /* 100% / 15 slides */
      height: 100%;
    }

    .slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Slide Indicators */
    .slide-indicators {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 6px;
      z-index: 10;
      max-width: 80%;
      flex-wrap: wrap;
      justify-content: center;
    }

    .indicator {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.5);
      cursor: pointer;
      transition: all 0.3s;
    }

    .indicator.active {
      width: 20px;
      border-radius: 3px;
      background: white;
    }
            
            
            
       .olx{
           margin-top: 3%!important;
       }     
            
            
            
            
            
            
            
            
            
            
            
            
            .navbar-brand { 
                font-weight: 700;
                background: linear-gradient(135deg, var(--primary-green), var(--primary-green-dark));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                transition: transform 0.3s ease;
            }
            
            .navbar-brand:hover {
                transform: scale(1.05);
            }
            
            .nav-link {
                color: var(--text-dark) !important;
                font-weight: 700; 
                position: relative;
                transition: color 0.3s ease;
                font-size: 16px;
            }
            
            .nav-link::after {
                content: '';
                position: absolute;
                width: 0;
                height: 2px;
                bottom: -5px;
                left: 50%;
                background: var(--primary-green);
                transition: all 0.3s ease;
            }
            
            .nav-link:hover::after {
                width: 100%;
                left: 0;
                color: white;
            }
            
            .nav-link:hover {
                color: black !important;
            }
            .nav-link.active {
                color: white !important;
            }
                                    
            /* Main Content Spacing */
            .main-content {
                /*margin-top: 100px;*/
                margin-right: 0;
                max-width: 100%; 
                position: relative;
                z-index: 1;
            }
            
            /* Button Styles */
            .btn-primary-green {
                background: var(--green-color);
                color: white;
                border: none;
                padding: 12px 30px;
                border-radius: 10px;
                font-weight: 600;
                letter-spacing: 0.5px;
                transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                position: relative;
                overflow: hidden; 
            }
            
            .btn-primary-green::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.3);
                transform: translate(-50%, -50%);
                transition: width 0.6s, height 0.6s;
            }
            
            .btn-primary-green:hover::before {
                width: 300px;
                height: 300px;
            }
            
            .btn-primary-green:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 25px rgba(40, 167, 69, 0.4);
                color: var(--green-dark-color);
                border:1px solid var(--green-dark-color);
            }
            
            .btn-outline-green {
                border: 2px solid var(--green-color);
                color: var(--green-color);
                background: transparent;
                padding: 10px 25px;
                border-radius: 10px;
                font-weight: 600;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }
            
            .btn-outline-green::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: var(--green-color);
                transition: left 0.3s ease;
                z-index: -1;
            }
            
            .btn-outline-green:hover::before {
                left: 0;
            }
            
            .btn-outline-green:hover {
                color: white;
                border-color: var(--green-color);
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
            }
            
            /* Property Header Enhanced */
            .property-header {
                background: white;  
                margin-bottom: 25px; 
                position: relative;
                overflow: hidden;
            }
            
            .property-header::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px; 
            }
            
            .price-tag {
                background: #212529;
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent; 
                font-weight: 700;
                font-size: 30px !important;
            }
            .badge{
                font-size:16px;
            }
            /* Badge Enhancements */
            .badge-status {
                background: var(--green-light-color);
                color: var(--green-color);
                padding: 8px 16px;
                border-radius: 10px; 
                font-weight: 600;
                border: 1px solid var(--green-light-color);
                display: inline-flex;
                align-items: center;
                gap: 5px;
                transition: transform 0.3s ease;
            }
            
            .badge-status:hover {
                transform: translateY(-3px) scale(1.05);
            }
            
            .badge-status::before {
                content: '✓';
                font-weight: bold;
            }
            
            /* Gallery Enhancements */
            .gallery-main {
                position: relative;
                border-radius: 20px;
                overflow: hidden;
                box-shadow: var(--shadow-lg);
                max-width: 600px;
                max-height: 400px;
                margin: 0 auto;
            }
            
            .gallery-main .carousel-item img {
                width: 100%;
                height: 350px;
                object-fit: cover;
                border-radius: 20px;
            }
            
            .carousel-item {
                transition: transform 0.6s ease-in-out;
            }
            
            .carousel-control-prev,
            .carousel-control-next {
                width: 40px;
                height: 40px;
                background: rgba(255, 255, 255, 0.9);
                border-radius: 50%;
                top: 50%;
                transform: translateY(-50%);
                margin: 0 15px;
                opacity: 0;
                transition: opacity 0.3s ease;
            }
            
            .gallery-main:hover .carousel-control-prev,
            .gallery-main:hover .carousel-control-next {
                opacity: 1;
            }
            
            .carousel-control-prev-icon,
            .carousel-control-next-icon {
                filter: invert(1);
                width: 20px;
                height: 20px;
            }
            
            .gallery-thumbnails {
                display: flex;
                gap: 10px;
                margin-top: 15px;
                padding: 10px;
                overflow-x: auto;
                scroll-behavior: smooth;
                justify-content: center;
            }
            
            .gallery-thumbnails::-webkit-scrollbar {
                height: 6px;
            }
            
            .gallery-thumbnails::-webkit-scrollbar-track {
                background: var(--accent-light);
                border-radius: 10px;
            }
            
            .gallery-thumbnails::-webkit-scrollbar-thumb {
                background: var(--primary-green);
                border-radius: 10px;
            }
            
            .gallery-thumbnails img {
                width: 100px;
                height: 65px;
                object-fit: cover;
                border-radius: 10px;
                cursor: pointer;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                border: 2px solid transparent;
                flex-shrink: 0;
            }
            
            .gallery-thumbnails img:hover {
                transform: scale(1.08) translateY(-3px);
                border-color: var(--primary-green);
                box-shadow: 0 8px 16px rgba(40, 167, 69, 0.3);
            }
            
            .gallery-thumbnails img.active {
                border-color: var(--primary-green);
                transform: scale(1.05);
            }

            /* Video Section Styles */
.video-section {
    margin-top: 15px;
}

.video-container {
    position: relative;
    width: 100%;
    height: 0; 
    overflow: hidden;
    border-radius: 8px;
    background: #f5f5f5;
}

.video-container .section-header h2{
    margin-left:2%;
}

.video-container iframe,
.video-container video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 8px;
}

.video-caption {
    margin-top: 10px;
    padding: 8px 0;
    border-top: 1px solid var(--border-light);
}

.video-caption p { 
    color: var(--text-light);
    font-weight: 500;
}

.no-video {
    margin-top: 15px;
    background: #f8f9fa;
    border-radius: 8px;
    border: 1px dashed #dee2e6;
}

.no-video i {
    color: #6c757d;
}

.bottom-property-card {
    flex: 1; /* make all cards take equal width */
    background: var(--green-light-color);
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 25px;
    margin-bottom: 25px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    min-width: 0; /* prevents overflow issues */
    min-height: 400px; /* Add this line for fixed height */
    display: flex;
    flex-direction: column;
} 
/* Mobile Responsive */
@media (max-width: 768px) {
    .video-caption p { 
    }
   
}
            
/* Contact Form - Improved Sticky Behavior */
.contact-form-fixed {
    display:none;
    background: white;
    padding: 25px;
    border-radius: 20px;
    box-shadow: var(--shadow-lg);
    position: fixed;
    right: 20px;
    top: 120px;
    width: 400px;
    height:490px;
    border: 1px solid var(--border-light);
    z-index: 1020;
    overflow-y: hidden;
    transition: all 0.3s ease;
}

.contact-form-fixed h4 {
    color: var(--text-dark);
    font-weight: 700;
    margin-bottom: 8px;
    position: relative;
    padding-bottom: 12px; 
}

.contact-form-fixed h4::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 50px;
    height: 3px;
    background: linear-gradient(90deg, var(--primary-green), transparent);
    border-radius: 2px;
}

.contact-form-fixed p.text-muted {
    margin-bottom: 20px; 
    line-height: 1.4;
}

.contact-form-fixed .form-control, 
.contact-form-fixed .form-select {
    border: 2px solid var(--border-light);
    border-radius: 12px;
    padding: 0px 15px;
    transition: all 0.3s ease;
    background: var(--accent-light);
    margin-bottom: 0;
    height: 35px;
}

.contact-form-fixed .form-control:hover, 
.contact-form-fixed .form-select:hover {
    border-color: var(--primary-green-light);
    background: white;
}

.contact-form-fixed .form-control:focus, 
.contact-form-fixed .form-select:focus {
    border-color: var(--primary-green);
    box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.15);
    background: white;
}

.contact-form-fixed textarea.form-control {
    height: auto;
    min-height: 50px;
    resize: vertical;
}

.contact-form-fixed .input-group-text {
    background: var(--green-color);
    color: white;
    border: none;
    font-weight: 600; 
    border-radius: 12px 0 0 12px;
}

.contact-form-fixed .mb-3 {
    margin-bottom: 18px;
}

.contact-form-fixed .btn {
    margin-top: 22px;
    margin-bottom: 0; 
    padding: 8px 25px;
    font-weight: 600;
}

/* Custom scrollbar for form */
.contact-form-fixed::-webkit-scrollbar {
    width: 6px;
}

.contact-form-fixed::-webkit-scrollbar-track {
    background: var(--accent-light);
    border-radius: 10px;
}

.contact-form-fixed::-webkit-scrollbar-thumb {
    background: var(--primary-green);
    border-radius: 10px;
}

.contact-form-fixed::-webkit-scrollbar-thumb:hover {
    background: var(--primary-green-dark);
}

/* Form sticky behavior improvements */
@media (min-width: 993px) {
    .contact-form-fixed {
        /*position: fixed !important;*/
        /*top: 120px !important;*/
        /*right: 20px !important;*/
        /*transform: none !important;*/
        /*max-height: calc(100vh - 140px) !important;*/
        
        position: fixed;
        top: 570px;
        right: 20px;
        transform: none !important;
        max-height: calc(100vh - 140px);
    }
    
    .main-content {
        /* margin-right: 440px; */
        /* max-width: calc(100vw - 460px); */ 
    }
    
    /* Ensure form doesn't get cut off on smaller screens */
    body {
        position: relative;
        min-height: auto;
    }
 
}

@media (max-width: 1200px) {
    .contact-form-fixed {
        width: 360px;
        right: 15px;
        padding: 22px;
    }
    
    .main-content {
        margin-right: 385px;
        /* max-width: calc(100vw - 400px); */
    }
}

@media (max-width: 992px) {
    .contact-form-fixed {
        display: none !important;
    }
    .thumbnails-container {
        display: none;
    } 
    .gallery-container{
        width:100%;
        margin-left: 0%;
    }
    .main-content {
        margin-right: 0 !important;
        max-width: 100% !important;
        margin-top: 80px;
        padding: 0 15px; 
    }
    
    .contact-form-mobile {
        display: block !important;
        background: white;
        padding-left: calc(var(--bs-gutter-x) * .5);
        border-radius: 20px;
        box-shadow: var(--shadow-md);
        margin: 30px 0;
        border: 1px solid #f5f5f5;
    }
     .realestate-wrapper{
                    padding-left: calc(var(--bs-gutter-x) * .5);
                    padding-top: 4%;
            }
            .emi-calculator{
                margin-top:5%;
            }
            
              .olx{
           margin-top: 8%!important;
       }  
}

/* Enhanced mobile behavior */
@media (max-width: 768px) {
    .main-content {
        margin-top: 16px;
        padding: 0 10px;
    }
    
    .contact-form-mobile {
        margin: 20px -10px;
            padding-left: calc(var(--bs-gutter-x) * .5);
        border-radius: 15px;
    }
}
            
            .input-group-text {
                background: var(--green-color);
                color: white;
                border: none;
                font-weight: 600;
            }
            
            /* Section Titles */
            .section-title {
                color: var(--text-dark);
                font-weight: 700;
                font-size: 18px;
                margin-bottom: 25px;
                position: relative;
                padding-bottom: 15px;
            }
            

            
            /* Tab Navigation */
            .tab-navigation { 
                margin-bottom: 30px;
                display: flex;
                gap: 0;
                background: linear-gradient(135deg, var(--accent-light), white); 
                position: relative;
                overflow: hidden;
            }
             
            
            @keyframes gradientShift {
                0%, 100% { background-position: 0% 50%; }
                50% { background-position: 100% 50%; }
            }
            
            .tab-navigation .nav-link {
                color: var(--text-light);
                border: none;
                padding: 15px 30px;
                position: relative;
                font-weight: 700; 
                transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                background: transparent;
                flex: 1;
                text-align: center;
                overflow: hidden;
                z-index: 1;
            }
            
            .tab-navigation .nav-link::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, var(--primary-green-soft), var(--accent-light));
                transition: left 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
                z-index: -1;
            }
            
            .tab-navigation .nav-link::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                width: 0;
                height: 3px;
                background: linear-gradient(90deg, var(--green-color), var(--green-light-color));
                transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                transform: translateX(-50%);
                border-radius: 2px;
            }
            
            .tab-navigation .nav-link:hover {
                color: var(--green-color);
                transform: translateY(-3px) scale(1.05);
                box-shadow: 0 8px 25px rgba(40, 167, 69, 0.15);
            }
            
            .tab-navigation .nav-link:hover::before {
                left: 0;
            }
            
            .tab-navigation .nav-link:hover::after {
                width: 80%;
            }
            
            .tab-navigation .nav-link.active {
                color: white;
                background: var(--green-color); 
            }
            
   
            
            .tab-navigation .nav-link i {
                transition: all 0.3s ease;
                margin-right: 8px;
            }
            
            .tab-navigation .nav-link:hover i {
                transform: rotate(10deg) scale(1.2);
            }
            
            .tab-navigation .nav-link.active i {
                transform: rotate(0deg) scale(1.1);
                animation: iconPulse 2s ease-in-out infinite;
            }
            
            @keyframes iconPulse {
                0%, 100% { transform: rotate(0deg) scale(1.1); }
                50% { transform: rotate(0deg) scale(1.2); }
            }
            
            /* FAQ Section */
            .faq-item {
                background: white;
                border-radius: 12px;
                margin-bottom: 4px;
                overflow: hidden;
                border: 1px solid var(--border-light);
                transition: all 0.3s ease;
            }
            
            .faq-question {
                padding: 15px;
                font-weight: 400;
                cursor: pointer;
                display: flex;
                justify-content: space-between;
                align-items: center; 
                background: #f9f8f8;
            }
            
       .faq-question:hover {
    border-bottom: 1px solid #cfcfcf;
   transition: transition: transform 0.5s ease-in-out;
}
            
            .faq-icon {
                transition: transform 0.3s ease;
                color: var(--primary-green);
            }
            
            .faq-item.active .faq-icon {
                transform: rotate(180deg);
            }
            
            .faq-answer {
                padding: 0 20px;
                max-height: 0;
                overflow: hidden;
                transition: all 0.3s ease;
            }
            
            .faq-item.active .faq-answer {
                padding: 20px;
                max-height: 500px;
            }
            
            /* Location Info */
            .location-info {
                display: flex;
                align-items: center;
                gap: 8px;
                color: var(--text-light);
                margin-bottom: 12px; 
            }
            
            .location-info i {
                color: var(--primary-green);
            }
            
      
            
      
            
            /* Facilities Container */
            .facilities-container {
                padding: 1rem 0;
                background: #f8f9fa;
            }
            
            .facility-card {
                background: white;
                border-radius: 8px;
                padding: 0.75rem;
                text-align: left;
                box-shadow: 0 2px 8px rgba(0,0,0,0.06);
                transition: all 0.3s ease;
                border: 1px solid #e9ecef;
                height: 60px;
                display: flex;
                flex-direction: row;
                justify-content: flex-start;
                align-items: center;
                margin-bottom: 0.75rem;
            }
            
            .facility-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 4px 15px var(--green-light-color);
                border-color: #28a745;
            }
            
            .facility-icon { 
                color: var(--green-color);
                margin-right: 0.75rem;
                margin-bottom: 0;
                display: inline-block;
                flex-shrink: 0;
            }
            
            .facility-name {   
                margin: 0;
                line-height: 1.3;
                flex: 1;
            }
            
            /* Property Slider */
            .property-slider-container {
                position: relative;   
                margin-top: 0px;
            }
            
            .horizontal-property-container {
                display: flex;
                gap: 3.8%;
                overflow-x: hidden;
                scroll-behavior: smooth; 
                position: relative;
            }
            
            .horizontal-property-card {
                min-width: 280px;
                max-width: 280px;
                background: white;
                border-radius: 12px; 
                overflow: hidden;
                transition: all 0.3s ease;
                border: 1px solid #e9ecef;
                text-decoration: none;
                color: inherit;
                flex-shrink: 0;
            }
            
            .horizontal-property-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 8px 30px rgba(40, 167, 69, 0.2);
                text-decoration: none;
                color: inherit;
                border-color: var(--primary-green);
            }
            
            .horizontal-card-image {
                width: 100%;
                height: 180px;
                object-fit: cover;
                transition: transform 0.3s ease;
            }
            
            .horizontal-property-card:hover .horizontal-card-image {
                transform: scale(1.1);
            }
            
            .horizontal-card-body {
                padding: 20px;
            }
            
            .horizontal-card-title {
                font-size: 16px;
                font-weight: 700;
                color: var(--black-color);
                margin-bottom: 10px;
                line-height: 1.4;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden; 
            }
            
            .horizontal-card-location {
                color: #666; 
                margin-bottom: 12px;
                display: flex;
                align-items: center;
                gap: 6px;
            }
            
            .horizontal-card-price {
                font-size: 18px;
                font-weight: 700;
                background: var(--black-color);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                margin-bottom: 10px;
            }
            
            .horizontal-card-details { 
                font-weight: 500;
            }
            
            .slider-arrow {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                width: 50px;
                height: 50px;
                background: rgba(255, 255, 255, 0.95);
                border: 2px solid var(--primary-green);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                z-index: 10;
                transition: all 0.3s ease;
                box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            }
            
            .slider-arrow:hover {
                background: var(--primary-green);
                color: white;
                transform: translateY(-50%) scale(1.1);
            }
            
            .slider-arrow.left {
                left: -25px;
            }
            
            .slider-arrow.right {
                right: -25px;
            }
            
            .slider-arrow i {
                font-size: 18px;
                color: var(--primary-green);
                transition: color 0.3s ease;
            }
            
            .slider-arrow:hover i {
                color: white;
            }
            
            .slider-dots {
                display: flex;
                justify-content: center;
                gap: 8px;
                margin-top: 20px;
            }
            
            .slider-dot {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: #ddd;
                cursor: pointer;
                transition: all 0.3s ease;
            }
            
            .slider-dot.active {
                background: var(--primary-green);
                transform: scale(1.2);
            }
            
            /* Location Cards */
            .location-cards-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 20px;
                align-items: stretch;
            }
            
            .location-card {
                border-radius: 16px;
                display: flex;
                flex-direction: column;
                padding: 25px;
                border: 1px solid #e9ecef;
                position: relative;
                overflow: hidden;
                box-shadow: 0 4px 15px rgba(0,0,0,0.08);
                transition: all 0.3s ease;
                height: 100%;
                min-height: 250px; 
            }
            
            .location-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            }
            
            .location-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
            }
            
            .location-advantages {
                background: linear-gradient(135deg, #f8f9fa, #e9f7ef);
            }
            
            .location-advantages::before {
                background: linear-gradient(90deg, #28a745, #20c997);
            }
            
            .educational-institute {
                background: linear-gradient(135deg, #e3f2fd, #f3e5f5);
            }
            
            .educational-institute::before {
                background: linear-gradient(90deg, #2196f3, #9c27b0);
            }
            
            .commercial-hub {
                background: linear-gradient(135deg, #fff3e0, #fce4ec);
            }
            
            .commercial-hub::before {
                background: linear-gradient(90deg, #ff9800, #e91e63);
            }
            
            .transport-hub {
                background: linear-gradient(135deg, #f1f8e9, #e8eaf6);
            }
            
            .transport-hub::before {
                background: linear-gradient(90deg, #4caf50, #3f51b5);
            }
            
            .location-header {
                display: flex;
                align-items: center;
                margin-bottom: 20px;
                gap: 15px;
                flex-shrink: 0;
            }
            
            .location-icon {
                width: 50px;
                height: 50px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 20px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            }
            
            .advantages-icon {
                background: linear-gradient(135deg, #28a745, #20c997);
            }
            
            .education-icon {
                background: linear-gradient(135deg, #2196f3, #9c27b0);
            }
            
            .commercial-icon {
                background: linear-gradient(135deg, #ff9800, #e91e63);
            }
            
            .transport-icon {
                background: linear-gradient(135deg, #4caf50, #3f51b5);
            }
            
            .location-title {
                font-size: 16px;
                font-weight: 700;
                color: #333;
                margin: 0;
            }
            
            .location-bullet-list {
                flex-grow: 1;
                padding: 0;
            }
            
            .advantage-list {
                margin: 0;
                padding-left: 20px;
                list-style: none;
            }
            
            .advantage-list li {  
                line-height: 1.5;
                margin-bottom: 10px;
                position: relative;
                padding-left: 20px;
            }
            
            .advantage-list li::before {
                content: '•';
                font-weight: bold;
                font-size: 16px;
                position: absolute;
                left: 0;
                top: -1px;
            }
            
            .location-advantages .advantage-list li::before {
                color: #28a745;
            }
            
            .educational-institute .advantage-list li::before {
                color: #2196f3;
            }
            
            .commercial-hub .advantage-list li::before {
                color: #ff9800;
            }
            
            .transport-hub .advantage-list li::before {
                color: #4caf50;
            }
            
            .advantage-list li:last-child {
                margin-bottom: 0;
            }
            
            .location-raw-content { 
                line-height: 1.5;
                color: #555;
            }
            
            .location-raw-content ul, .location-raw-content ol {
                padding-left: 20px;
            }
            
            .location-raw-content li {
                margin-bottom: 8px;
                color: #555;
            }
            

            
            /* Bottom Properties Section */
            .bottom-properties-section { 
                border-radius: 20px;  
            }
            
            .bottom-property-container {
                display: flex;
                gap: 20px; /* space between cards */
            }
            
            .bottom-property-card {
                flex: 1; /* make all cards take equal width */
                background: var(--green-light-color);
                border: 1px solid var(--green-color);
                border-radius: 16px;
                padding: 25px;
                margin-bottom: 15px;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
                min-width: 0; /* prevents overflow issues */
            }
            
            
            .bottom-property-card:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow-md);
                border-color: var(--primary-green-light);
            }

            
            .property-link {
                color: var(--text-light);
                text-decoration: none;
                display: block;
                padding: 12px 0;
                border-bottom: 1px solid var(--border-light);
                transition: all 0.3s ease;
                position: relative;
                padding-left: 20px;
            }
            
            .property-link::before {
                content: '→';
                position: absolute;
                left: 0;
                color: var(--primary-green);
                opacity: 0;
                transition: opacity 0.3s ease;
            }
            
            .property-link:hover {
                color: var(--primary-green);
                background-color: var(--primary-green-soft);
                padding-left: 30px;
                border-radius: 8px;
                margin: 0 -5px;
            }
            
            .property-link:hover::before {
                opacity: 1;
            }
            
            .property-link:last-child {
                border-bottom: none;
            }
            
            .view-more-btn {
                color: var(--primary-green);
                text-decoration: none; 
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                gap: 5px;
                margin-top: 15px;
                transition: all 0.3s ease;
            }
            
            .view-more-btn:hover {
                color: var(--primary-green-dark);
                transform: translateX(5px);
            }
            
            .bottom-section-title { 
                font-weight: 700;
                font-size: 18px;
                margin-bottom: 20px;
                position: relative;
                padding-bottom: 12px;
            }
        
            
            .map-container {
                margin-bottom: 40px;
            }
            
/* ============================================
   PRICING SECTION - REDESIGNED WITH MOBILE OPTIMIZATION
   ============================================ */
 

.pricing-header {
    text-align: center;
    margin-bottom: 2rem;
}

.pricing-header h4 {
    color: var(--text-dark);
    font-weight: 700; 
}

.pricing-header p { 
    color: var(--text-light);
}

 
 

.pricing-table-wrapper table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: transparent;
    border:none;
}

.pricing-table-wrapper thead {
    background: linear-gradient(135deg, var(--primary-green-soft), var(--accent-light));
    position: relative;
}

.pricing-table-wrapper thead th {
    padding: 1rem;
    text-align: center;
    font-weight: 700; 
    border: none; 
}

.pricing-table-wrapper thead th:first-child {
    text-align: left;
    padding-left: 2rem;
    border-radius: 12px 0 0 0;
}

.pricing-table-wrapper thead th:last-child {
    border-radius: 0 12px 0 0;
}

.pricing-table-wrapper tbody tr {
    transition: all 0.3s ease;
    border-bottom: 1px solid #f0f0f0;
    background: white;
}

.pricing-table-wrapper tbody tr:hover {
    background: linear-gradient(135deg, #f8fffe 0%, #f0f9f4 100%);
    transform: translateX(5px);
    box-shadow: -5px 0 15px rgba(40, 167, 69, 0.1);
}

.pricing-table-wrapper tbody tr:last-child {
    border-bottom: none;
}

.pricing-table-wrapper tbody td {
    padding: 0.8rem 1rem;
    vertical-align: middle;
    border: none;
    color: var(--text-dark);
    font-size: 16px;
}
 
 
 

/* Mobile Responsive Design - ENHANCED */
@media (max-width: 768px) {
  
    
    .pricing-header h4 { 
        margin-bottom: 0.5rem;
    }
     
    
    
    .pricing-table-wrapper {
        padding: 0.5rem;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    
    /* Make table scrollable but visible */
    .pricing-table-wrapper table {
        min-width: 100%;
        display: block;
        overflow-x: auto;
        white-space: nowrap; 
    }
    
    .pricing-table-wrapper thead,
    .pricing-table-wrapper tbody {
        display: table;
        width: 100%;
    }
    
    .pricing-table-wrapper thead th {
        padding: 0.75rem 0.5rem; 
        letter-spacing: 0.3px;
        position: sticky;
        top: 0;
        background: linear-gradient(135deg, var(--primary-green-soft), var(--accent-light));
        z-index: 10;
    }
    
    .pricing-table-wrapper thead th:first-child {
        padding-left: 1rem;
    }
    
    .pricing-table-wrapper tbody td {
        padding: 0.75rem 0.5rem; 
    }
    
    .pricing-table-wrapper tbody td:first-child {
        padding-left: 1rem; 
        min-width: 120px;
    }
    
    .pricing-table-wrapper tbody td:first-child::before {
        width: 6px;
        height: 6px;
        left: 0.3rem;
    }
    
    .pricing-table-wrapper tbody td:nth-child(2) { 
        min-width: 100px;
    }
    
    .pricing-table-wrapper tbody td:nth-child(3),
    .pricing-table-wrapper tbody td:last-child {
        min-width: 80px; 
    }
    
    /* Add scroll indicator */
    .price_display_container::after {
        content: '← Scroll for more →';
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(40, 167, 69, 0.9);
        color: white;
        padding: 4px 12px;
        border-radius: 20px; 
        font-weight: 600;
        pointer-events: none;
        animation: fadeInOut 3s ease-in-out infinite;
    }
    
    @keyframes fadeInOut {
        0%, 100% { opacity: 0; }
        50% { opacity: 1; }
    }
    
    /* Remove hover effects on mobile */
    .pricing-table-wrapper tbody tr:hover {
        transform: none;
        box-shadow: none;
    }
}

@media (max-width: 480px) {
    .pricing-table-wrapper {
        padding: 0.25rem;
    }
    
    .pricing-table-wrapper thead th {
        padding: 0.6rem 0.3rem; 
    }
    
    .pricing-table-wrapper tbody td {
        padding: 0.6rem 0.3rem; 
    }
    
    .pricing-table-wrapper tbody td:first-child { 
        min-width: 100px;
    }
    
    .pricing-table-wrapper tbody td:nth-child(2) { 
        min-width: 90px;
    }
}

/* Custom Scrollbar for mobile */
.pricing-table-wrapper::-webkit-scrollbar {
    height: 6px;
}

.pricing-table-wrapper::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
}

.pricing-table-wrapper::-webkit-scrollbar-thumb {
    background: var(--primary-green);
    border-radius: 10px;
}

.pricing-table-wrapper::-webkit-scrollbar-thumb:hover {
    background: var(--primary-green-dark);
}
            
