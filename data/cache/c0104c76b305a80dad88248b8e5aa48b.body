// Blog Slider Functionality
function slideBlog(direction) {
    const container = document.getElementById('blogContainer');
    const scrollAmount = 320; // Adjust based on your card width + gap
    
    if (direction === 'left') {
        container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    } else {
        container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    }
    
    // Update arrow visibility after scroll animation completes
    setTimeout(() => updateBlogArrows(), 300);
}

// Update arrow visibility based on scroll position
function updateBlogArrows() {
    const container = document.getElementById('blogContainer');
    const leftArrow = document.getElementById('blogLeftArrow');
    const rightArrow = document.getElementById('blogRightArrow');
    
    if (!container || !leftArrow || !rightArrow) return;
    
    const scrollLeft = container.scrollLeft;
    const maxScroll = container.scrollWidth - container.clientWidth;
    
    // Hide/show left arrow
    if (scrollLeft <= 0) {
        leftArrow.style.display = 'none';
    } else {
        leftArrow.style.display = 'flex';
    }
    
    // Hide/show right arrow
    if (scrollLeft >= maxScroll - 1) { // -1 for rounding errors
        rightArrow.style.display = 'none';
    } else {
        rightArrow.style.display = 'flex';
    }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    const blogContainer = document.getElementById('blogContainer');
    
    if (blogContainer) {
        // Initial arrow state
        updateBlogArrows();
        
        // Update arrows on scroll
        blogContainer.addEventListener('scroll', updateBlogArrows);
        
        // Update arrows on window resize
        window.addEventListener('resize', updateBlogArrows);
    }
});







    </script>
    </html>