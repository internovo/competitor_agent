    .AboutBuilderP{
                    text-align: justify;
            } 
            .developer-projects {
                margin-top:11%;
                padding: 0rem !important; 
            } 
                        /* Hide mobile contact form on desktop */
            .contact-form-mobile {
                margin-top: 10%;
                 padding: 5% 8%; border: 1px solid #f5f5f5; border-radius: 12px;
                 background-color: white;
            }
            /* For Chrome, Safari, Edge, Opera */
            input[type=range]::-webkit-slider-runnable-track {
              background: #cbc8c8;
            }
            .realestate-wrapper{
                padding-left: 3%;
            }
       
            .text-success {
                color: var(--green-color) !important;
            }
            .bg-success{
                background-color: var(--green-color) !important;
            }
            #contact-container.stop {
                position: absolute;  
            }
            /* Navbar Styling */
            .navbar {
                background: rgba(255, 255, 255, 0.98);
                backdrop-filter: blur(20px);
                box-shadow: 0 1px 20px rgba(0, 0, 0, 0.06);
                transition: all 0.3s ease;
                padding: 1rem 0;
                position: fixed;
                width: 100%;
                top: 0;
                z-index: 1030;
            }
            #contactForm{
                margin-top: 24px;
            }
.emi-calculator{
        margin-top: 10%; 
