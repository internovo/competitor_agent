                                        <button type="button" class="ai-filter-pill" data-value="semi furnished">Semi-Furnished</button>
                                        <button type="button" class="ai-filter-pill" data-value="unfurnished">Unfurnished</button>
                                        <input id="ask-ai-filter-furnishing" type="hidden">
                                    </div>
                                </div>

                                <div class="ai-filter-row ai-filter-row--inputs">
                                    <div class="ai-filter-row-label">Location</div>
                                    <div class="ai-filter-row-control ai-filter-input-grid">
                                        <label class="ai-filter-field">
                                            <span>City</span>
                                            <input id="ask-ai-filter-city" type="text" placeholder="Gurugram">
                                        </label>

                                        <label class="ai-filter-field">
                                            <span>Locality</span>
                                            <input id="ask-ai-filter-locality" type="text" placeholder="Sector 81">
                                        </label>
                                    </div>
                                </div>

                                <div class="ai-filter-row ai-filter-row--inputs">
                                    <div class="ai-filter-row-label">Budget</div>
                                    <div class="ai-filter-row-control ai-filter-input-grid">
                                        <label class="ai-filter-field">
                                            <span>Min Budget</span>
                                            <input id="ask-ai-filter-min-budget" type="number" min="0" step="100000" placeholder="5000000">
                                        </label>

                                        <label class="ai-filter-field">
                                            <span>Max Budget</span>
                                            <input id="ask-ai-filter-max-budget" type="number" min="0" step="100000" placeholder="10000000">
                                        </label>
                                    </div>
                                </div>

                                <div class="ai-filter-row">
                                    <div class="ai-filter-row-label">Amenities</div>
                                    <div class="ai-filter-row-control ai-filter-check-row">
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-metro" type="checkbox">
                                            <span>Metro</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-school" type="checkbox">
                                            <span>Schools</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-highway" type="checkbox">
                                            <span>Highway</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-lift" type="checkbox">
                                            <span>Lift</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-parking" type="checkbox">
                                            <span>Parking</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-power-backup" type="checkbox">
                                            <span>Power Backup</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-gated-society" type="checkbox">
                                            <span>Gated Society</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-club-house" type="checkbox">
                                            <span>Clubhouse</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-water-supply" type="checkbox">
                                            <span>Water Supply</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-park-facing" type="checkbox">
                                            <span>Park Facing</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-air-conditioning" type="checkbox">
                                            <span>AC</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-private-garden" type="checkbox">
                                            <span>Private Garden</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-wifi" type="checkbox">
                                            <span>WiFi</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-security" type="checkbox">
                                            <span>Security</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-housekeeping" type="checkbox">
                                            <span>Housekeeping</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-laundry" type="checkbox">
                                            <span>Laundry</span>
                                        </label>
                                        <label class="ai-filter-check">
                                            <input id="ask-ai-filter-food" type="checkbox">
                                            <span>Food Included</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="ai-filter-modal-footer tw-flex tw-flex-col-reverse sm:tw-flex-row sm:tw-items-center sm:tw-justify-start tw-gap-3 tw-border-t tw-border-solid tw-border-[#F0E8D8] tw-px-4 tw-py-4 sm:tw-px-5">
                            <button
                                type="button"
                                id="ask-ai-filter-clear"
                                class="ai-filter-reset-btn tw-rounded-xl tw-border tw-border-solid tw-border-[#E7DFC9] tw-bg-white tw-px-4 tw-py-2.5 tw-text-xs tw-font-bold tw-text-[#555555] tw-transition-all hover:tw-border-[#B88A2D] hover:tw-text-[#222222]">
                                Reset
                            </button>
                            <button
                                type="submit"
                                class="ai-filter-apply-btn tw-rounded-xl tw-border-0 tw-bg-[#1F5A43] tw-px-5 tw-py-2.5 tw-text-xs tw-font-bold tw-text-white tw-transition-all hover:tw-bg-[#174734]">
                                Apply Filters
