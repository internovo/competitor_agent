// Generic function to handle form submissions
async function handleActionFormSubmission(form, type) {
    let formData = new FormData(form);
    
    // Show loading state
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    submitBtn.innerHTML = `<i class="fas fa-spinner fa-spin me-2"></i>Processing...`;
    submitBtn.disabled = true;

    try {
        let response = await fetch(form.action, {
            method: "POST",
            headers: { 
                "X-CSRF-TOKEN": "l6WkwhENpM4WrSucCUcd1rdiuiCQ2cg8M49FJsVV",
                "Accept": "application/json",
                "X-Requested-With": "XMLHttpRequest"
            },
            body: formData
        });

        let result = await response.json();

        if (response.ok && result.status === "success") {
            showToast("Success!", `${type} request submitted successfully. We'll contact you soon!`, "success");
            form.reset();
            // Close modal
            const modal = bootstrap.Modal.getInstance(form.closest('.modal'));
            modal.hide();
        } else if (response.status === 422) {
            if (result.errors) {
                let firstError = Object.values(result.errors)[0][0];
                showToast("Validation Error", firstError, "error");
            } else {
                showToast("Validation Error", result.message || "Please check your input", "error");
            }
        } else {
            showToast("Error", result.message || "Something went wrong", "error");
        }
    } catch (err) {
        console.error('Ajax Error:', err);
        showToast("Error", "Network error. Please check your connection and try again.", "error");
    } finally {
        // Reset button state
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
    }
}

