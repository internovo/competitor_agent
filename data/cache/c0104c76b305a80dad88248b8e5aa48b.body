                                        <button type="button" class="ai-filter-pill" data-value="residential">Residential</button>
                                        <button type="button" class="ai-filter-pill" data-value="commercial">Commercial</button>
                                        <input id="ask-ai-filter-property-type" type="hidden">
                                    </div>
                                </div>

                                <div class="ai-filter-row">
                                    <div class="ai-filter-row-label">Purpose</div>
                                    <div class="ai-filter-row-control ai-filter-pill-row" data-ai-filter-group="purpose" aria-label="Purpose">
                                        <button type="button" class="ai-filter-pill" data-value="">Any Purpose</button>
                                        <button type="button" class="ai-filter-pill" data-value="buy">Buy</button>
                                        <button type="button" class="ai-filter-pill" data-value="rent">Rent</button>
                                        <button type="button" class="ai-filter-pill" data-value="lease">Lease</button>
