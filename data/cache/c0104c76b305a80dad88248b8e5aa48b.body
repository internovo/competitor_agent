    // Contact Form Handler
    document.getElementById('contactForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        let form = this;
        let formData = new FormData(form);
    
        // Show loading state
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Sending...';
        submitBtn.disabled = true;
    
        try {
            let response = await fetch(form.action, {
                method: "POST",
                headers: { 
                    "X-CSRF-TOKEN": "l6WkwhENpM4WrSucCUcd1rdiuiCQ2cg8M49FJsVV",
                    "Accept": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: formData
            });
    
            let result = await response.json();
    
            if (response.ok && result.status === "success") {
                showToast("Success!", result.message, "success");
                form.reset();
            } else if (response.status === 422) {
                // Validation errors
                if (result.errors) {
                    let firstError = Object.values(result.errors)[0][0];
                    showToast("Validation Error", firstError, "error");
                } else {
                    showToast("Validation Error", result.message || "Please check your input", "error");
                }
            } else {
                showToast("Error", result.message || "Something went wrong", "error");
            }
        } catch (err) {
            console.error('Ajax Error:', err);
            showToast("Error", "Network error. Please check your connection and try again.", "error");
        } finally {
            // Reset button state
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        }
    });
    
    // Mobile Contact Form Handler
    const mobileForm = document.getElementById('contactFormMobile');
    if (mobileForm) {
        mobileForm.addEventListener('submit', function(e) {
            e.preventDefault();
            showToast('Success!', 'Your inquiry has been submitted successfully.', 'success');
            this.reset();
        });
    }
    
    // Share Property Function
    function shareProperty() {
        if (navigator.share) {
            navigator.share({
                title: 'Metrotech Builder Floors',
                text: 'Check out this amazing property in Sector 34, Noida',
                url: window.location.href
            }).then(() => {
                showToast('Shared!', 'Property shared successfully.', 'success');
            }).catch(() => {
                copyToClipboard();
            });
        } else {
            copyToClipboard();
        }
    }
    
    // Copy to Clipboard
    function copyToClipboard() {
        const dummy = document.createElement('input');
        document.body.appendChild(dummy);
        dummy.value = window.location.href;
        dummy.select();
        document.execCommand('copy');
        document.body.removeChild(dummy);
        showToast('Copied!', 'Link copied to clipboard.', 'success');
    }
    
    // Enhanced Toast Notification
    function showToast(title, message, type) {
        const toastHtml = `
            <div class="toast align-items-center text-white bg-${type === 'success' ? 'success' : (type === 'error' ? 'danger' : 'info')} border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        <strong>${title}</strong> ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        `;
        
        const toastContainer = document.querySelector('.toast-container');
        toastContainer.insertAdjacentHTML('beforeend', toastHtml);
        
        const toastElement = toastContainer.lastElementChild;
        const toast = new bootstrap.Toast(toastElement, {
            autohide: true,
            delay: 4000
        });
        toast.show();
        
        toastElement.addEventListener('hidden.bs.toast', () => {
            toastElement.remove();
        });
    }
    
// Property Slider Functions
let currentSlide = 0;
const cardWidth = 260; // Card width from CSS
const gap = 20; // Gap between cards from CSS

function slideProperties(direction) {
    const container = document.getElementById('propertyContainer');
    const totalCards = 3; // Changed from $displayProducts
    
    // Calculate how many cards are visible based on container width
    const containerWidth = container.offsetWidth;
    const visibleCards = Math.floor(containerWidth / (cardWidth + gap));
    const maxSlide = Math.max(0, totalCards - visibleCards);
    
    if (direction === 'left' && currentSlide > 0) {
        currentSlide--;
    } else if (direction === 'right' && currentSlide < maxSlide) {
        currentSlide++;
    }
    
    // Calculate scroll position including gap
    const scrollPosition = currentSlide * (cardWidth + gap);
    container.scrollTo({
        left: scrollPosition,
        behavior: 'smooth'
    });
    
    updateDots();
}

function slideTo(slideIndex) {
    const container = document.getElementById('propertyContainer');
    const totalCards = 3;
    const containerWidth = container.offsetWidth;
    const visibleCards = Math.floor(containerWidth / (cardWidth + gap));
    
    currentSlide = Math.min(slideIndex, Math.max(0, totalCards - visibleCards));
    const scrollPosition = currentSlide * (cardWidth + gap);
    
    container.scrollTo({
        left: scrollPosition,
        behavior: 'smooth'
    });
    
    updateDots();
}

function updateDots() {
    const container = document.getElementById('propertyContainer');
    const containerWidth = container.offsetWidth;
    const visibleCards = Math.floor(containerWidth / (cardWidth + gap));
    
    document.querySelectorAll('.slider-dot').forEach((dot, index) => {
        dot.classList.toggle('active', index === Math.floor(currentSlide / visibleCards));
    });
}

// Auto-hide arrows and handle responsive behavior
document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('propertyContainer');
    const totalCards = 3;
    const leftArrow = document.querySelector('.slider-arrow.left');
    const rightArrow = document.querySelector('.slider-arrow.right');
    
    function updateArrowVisibility() {
        const containerWidth = container.offsetWidth;
        const visibleCards = Math.floor(containerWidth / (cardWidth + gap));
        
        if (totalCards <= visibleCards) {
            leftArrow.style.display = 'none';
            rightArrow.style.display = 'none';
        } else {
            leftArrow.style.display = currentSlide === 0 ? 'none' : 'flex';
            rightArrow.style.display = currentSlide >= (totalCards - visibleCards) ? 'none' : 'flex';
        }
    }
    
    // Update arrow visibility on load and resize
    updateArrowVisibility();
    window.addEventListener('resize', updateArrowVisibility);
    
    // Update arrows after each slide
    const originalSlideProperties = window.slideProperties;
    window.slideProperties = function(direction) {
        originalSlideProperties(direction);
        setTimeout(updateArrowVisibility, 100);
    };
});
    
    // Navbar scroll effect
    window.addEventListener('scroll', () => {
        const navbar = document.querySelector('.navbar');
        if (window.scrollY > 50) {
            navbar.style.boxShadow = '0 4px 20px rgba(0, 0, 0, 0.1)';
        } else {
            navbar.style.boxShadow = '0 1px 20px rgba(0, 0, 0, 0.06)';
        }
    });
    
