                                    <div class="ai-filter-row-control ai-filter-pill-row" data-ai-filter-group="subtype" aria-label="Subtype">
                                        <button type="button" class="ai-filter-pill" data-value="">Any Subtype</button>
                                        <button type="button" class="ai-filter-pill" data-value="flat">Flat</button>
                                        <button type="button" class="ai-filter-pill" data-value="villa">Villa</button>
