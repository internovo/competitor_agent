<!-- Auto OTP Verification Script - Loaded once for all forms -->
<script src="https://www.dhanbhumi.com/assets/js/auto-otp-verification.js"></script><script>
    document.addEventListener('DOMContentLoaded', function() {
        // DOM Elements
        const purposeTabs = document.querySelectorAll('[data-purpose]');
        const purposeInput = document.getElementById('purpose');
        const mainTypeInput = document.getElementById('main_type');
        const propertyTypeBoxes = document.querySelectorAll('.common-box[data-type]');
        const propertyTypeSelect = document.querySelector('.banner--box .form-select');
        const locationSearch = document.getElementById('location-search');
        const searchForm = document.getElementById('property-search-form');
        const micButton = document.getElementById('mic-button');

        // Function to show all property types
        function showAllPropertyTypes() {
            propertyTypeBoxes.forEach(box => {
                box.style.display = 'block';
                //box.classList.remove('show');
            });
            document.querySelector('.common-box[data-type="residential"]').classList.add('show');
        }

        // Initialize with all property types showing and Residential active
        showAllPropertyTypes();

        // Purpose Tabs (Sale/Rent/PG)
        purposeTabs.forEach(tab => {
            tab.addEventListener('click', function() {
                purposeTabs.forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                purposeInput.value = this.getAttribute('data-purpose');
                showAllPropertyTypes();
                updatePropertyTypeSelect();
            });
        });
		
		 // Update Property Type Select Text
        function updatePropertyTypeSelect() {
            const selectedTypes = [];
            let currentMainType = 'residential'; // Default to residential

            // Check which property types are selected
            propertyTypeBoxes.forEach(box => {
                const type = box.getAttribute('data-type');
                const checkboxes = box.querySelectorAll('input[type="radio"]:checked');

                if (checkboxes.length > 0) {
                    currentMainType = type; // Update main type based on selected checkboxes
                    checkboxes.forEach(checkbox => {
                        selectedTypes.push(checkbox.value);
                        checkbox.closest('.inner-box-input').classList.add('checked');
                    });
                }

                // Remove checked class from unchecked boxes
                box.querySelectorAll('input[type="radio"]:not(:checked)').forEach(checkbox => {
                    checkbox.closest('.inner-box-input').classList.remove('checked');
                });
            });

            // Update the hidden input
            mainTypeInput.value = currentMainType;
            propertyTypeSelect.textContent = selectedTypes.length > 0 ? selectedTypes.join(', ') : 'Property Type';

        }
		
	

        // Residential Type Checkboxes
        document.querySelectorAll('input[name="residential_types[]"]').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                const isPlotSelected = document.querySelector('input[name="residential_types[]"][value="Plot"]:checked');

                if (isPlotSelected) {
                    document.getElementById('bhk-options').style.display = 'none';
                    document.getElementById('residential-super-area').style.display = 'block';
                    document.querySelectorAll('input[name="bedrooms[]"]').forEach(bhk => {
                        bhk.checked = false;
                        bhk.closest('.inner-box-input').classList.remove('checked');
                    });
                } else {
                    document.getElementById('bhk-options').style.display = 'block';
                    document.getElementById('residential-super-area').style.display = 'none';
                }
                updatePropertyTypeSelect();
            });
        });

        // Other Type Checkboxes
        document.querySelectorAll('input[name="commercial_types[]"], input[name="land_types[]"], input[name="other_types[]"]').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                const type = this.closest('.common-box').getAttribute('data-type');
                const hasChecked = document.querySelector(`.common-box[data-type="${type}"] input[type="checkbox"]:checked`);
                document.getElementById(`${type}-super-area`).style.display = hasChecked ? 'block' : 'none';
                updatePropertyTypeSelect();
            });
        });

        // BHK Checkboxes
        document.querySelectorAll('input[name="bedrooms[]"]').forEach(checkbox => {
            checkbox.addEventListener('change', updatePropertyTypeSelect);
        });
		
		 // BHK Checkboxes
        document.querySelectorAll('input[name="category"]').forEach(checkbox => {
            checkbox.addEventListener('change', updatePropertyTypeSelect);
        });

        // Budget Handling
        const priceMinInput = document.querySelector('input[name="price_min"]');
        const priceMaxInput = document.querySelector('input[name="price_max"]');
		var budgetbx = document.querySelector('.search_form-in .search_form__content .banner_form__flex .banner--box.form_box.border--right');
		
        function updateBudgetSelect() {
            const min = priceMinInput.value;
            const max = priceMaxInput.value;
            const budgetSelect = document.querySelector('.banner--box.border--right .form-select');

            if (min || max) {
                budgetSelect.textContent = `${min ? 'Min: ₹' + formatNumber(min) : ''}${min && max ? ' - ' : ''}${max ? 'Max: ₹' + formatNumber(max) : ''}`;
				
            } else {
                budgetSelect.textContent = 'Budget';
				
            }
        }

        function formatNumber(num) {
            num = parseInt(num);
            if (num >= 10000000) return (num / 10000000).toFixed(1) + ' Cr';
            if (num >= 100000) return (num / 100000).toFixed(1) + ' Lac';
            return num.toLocaleString();
        }

        // Budget Suggestions
        /*document.querySelectorAll('.budget-suggestion').forEach(suggestion => {
            suggestion.addEventListener('click', function() {
				 var budgetdrp = document.querySelector('.search_form-in .search_form__content .banner_form__flex .banner--box.form_box.border--right .common-box');
				 budgetdrp.classList.add('show1');
			
                const value = this.getAttribute('data-value');
                if (!priceMinInput.value) {
                    priceMinInput.value = value;
                } else {
                    priceMaxInput.value = value;
                }
                updateBudgetSelect();
            });
			
        }); */
		
var minlf = document.querySelector('.budget-min'); 
		var minrf = document.querySelector('.budget-max'); 
		document.querySelectorAll('.budget-min span.budget-suggestion').forEach( minbudgeTtab => {
			minbudgeTtab.addEventListener('click', () => {				
				minlf.style.display = 'none';
				minrf.style.display = 'block';
			})
		})		
		
		document.querySelectorAll('.budget-min .budget-suggestion').forEach(mnsuggestion => {
            mnsuggestion.addEventListener('click', function() {	
				var budgetdrp = document.querySelector('.search_form-in .search_form__content .banner_form__flex .banner--box.form_box.border--right .common-box');
				 budgetdrp.classList.add('show1');
                const value = this.getAttribute('data-value');              
                priceMinInput.value = value;                
                updateBudgetSelect();
            });			
        });
		
		var budgetbx2 = document.querySelector('.search_form-in .search_form__content .banner_form__flex .banner--box.form_box.border--right .banner--box-input');
		document.querySelectorAll('.budget-max .budget-suggestion').forEach(mxsuggestion => {					
            mxsuggestion.addEventListener('click', function() {
				var budgetdrp = document.querySelector('.search_form-in .search_form__content .banner_form__flex .banner--box.form_box.border--right .common-box');
				budgetdrp.classList.add('show1');
                const value = this.getAttribute('data-value');              
                priceMaxInput.value = value;                
                updateBudgetSelect();
				budgetbx2.classList.add('hd-none');
				minlf.style.display = 'block';
				minrf.style.display = 'none';
            });			
        });		
		
		document.querySelectorAll('.Property-Type h6').forEach(propertyTpye => {
			propertyTpye.addEventListener('click', () => {
				var budgetdrp = document.querySelector('.search_form-in .search_form__content .banner_form__flex .banner--box.form_box.border--right .common-box');
				budgetdrp.classList.add('show1');
			});
		});
		
		
		var budgetbx3out = document.querySelector('.search_form-in .search_form__content .banner_form__flex .banner--box.form_box.border--right');
		budgetbx3out.addEventListener('mouseover', function() { 
			budgetbx2.classList.remove('hd-none');
		
		});	
		
		document.querySelectorAll('.budget-max span.budget-suggestion').forEach( maxbudgeTtab => {
			var budgetbx1 = document.querySelector('.search_form-in .search_form__content .banner_form__flex .banner--box.form_box.border--right .banner--box-input');
			budgetbx.addEventListener('click', () => {				
				
				//minlf.style.display = 'block';
				//minrf.style.display = 'none';
				//budgetbx1.classList.toggle = 'bxhide';
			})
			
			var budgetfselect = document.querySelector('.search_form-in .search_form__content .banner_form__flex .banner--box.form_box.border--right .form-select');
		
			budgetfselect.addEventListener('click', () => {
				//budgetbx1.style.display = 'block';
				minlf.style.display = 'block';
				minrf.style.display = 'none';
			});
			
			priceMinInput.addEventListener('click', () => {								
				minlf.style.display = 'block';
				minrf.style.display = 'none';
			})
			priceMaxInput.addEventListener('click', () => {								
				minlf.style.display = 'none';
				minrf.style.display = 'block';
			})
		})
		
		

         // Super Area Suggestions
            const superAreaSuggestions = [100, 200, 300, 400, 500, 1000, 1500, 2000, 3000, 4000, 5000, 10000, 25000, 50000];

            document.querySelectorAll('input[name="super_area_min"], input[name="super_area_max"]').forEach(input => {
                const container = document.createElement('div');
                container.className = 'autocomplete-suggestions';
                container.style.display = 'none';

                superAreaSuggestions.forEach(value => {
                    const suggestion = document.createElement('div');
                    suggestion.className = 'suggestion-item';
                    suggestion.textContent = value + ' sq.ft';
                    suggestion.addEventListener('mousedown', (e) => {
                        e.preventDefault();
                        input.value = value;
                        container.style.display = 'none';
                    });
                    container.appendChild(suggestion);
                });

                input.parentNode.insertBefore(container, input.nextSibling);

                input.addEventListener('focus', () => container.style.display = 'block');
                input.addEventListener('blur', () => setTimeout(() => container.style.display = 'none', 200));
            });

        // Form Submission
        searchForm.addEventListener('submit', function(e) {
            // Disable unchecked checkboxes and empty inputs
            document.querySelectorAll('input, select').forEach(input => {
                if ((input.type === 'checkbox' || input.type === 'radio') && !input.checked) {
                    input.disabled = true;
                } else if (input.value === '' || input.value === null) {
                    input.disabled = true;
                }
            });
        });


        // Initialize checked classes
        updatePropertyTypeSelect();
    });
</script>
