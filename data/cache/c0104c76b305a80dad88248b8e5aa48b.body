<style>

    /*
    |--------------------------------------------------------------------------
    | Main Widget
    |--------------------------------------------------------------------------
    */

    .app-download-widget {

        position: fixed;

        top: 110px;

        right: 0;

        z-index: 999999;

        width: 124px;

        height: 116px;

        display: flex;

        background: #ffffff;

        border: 1px solid #e2e2e2;

        border-right: 0;

        border-radius: 14px 0 0 14px;

        overflow: hidden;

        box-shadow:
            0 6px 24px rgba(0, 0, 0, 0.22),
            0 2px 8px rgba(0, 0, 0, 0.10);

        transition:
            width 0.25s ease,
            box-shadow 0.2s ease;

    }


    /*
    |--------------------------------------------------------------------------
    | QR + Label Area
    |--------------------------------------------------------------------------
    */

    .app-download-widget__content {

        flex: 1;

        min-width: 0;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        padding:
            7px
            2px
            6px
            7px;

        opacity: 1;

        transition:
            opacity 0.15s ease;

    }


    /*
    |--------------------------------------------------------------------------
    | QR Code
    |--------------------------------------------------------------------------
    */

    .app-download-widget__qr {

        width: 84px;

        height: 84px;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #ffffff;

    }


    .app-download-widget__qr svg {

        width: 84px;

        height: 84px;

        display: block;

    }


    /*
    |--------------------------------------------------------------------------
    | DOWNLOAD APP Label
    |--------------------------------------------------------------------------
    */

    .app-download-widget__label {

        margin-top: 4px;

        width: 100%;

        text-align: center;

        white-space: nowrap;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: 8px;

        line-height: 10px;

        font-weight: 700;

        letter-spacing: 0.9px;

        color: #333333;

    }


    /*
    |--------------------------------------------------------------------------
    | Arrow Button
    |--------------------------------------------------------------------------
    */

    .app-download-widget__arrow {

        width: 30px;

        height: 100%;

        padding: 0;

        margin: 0;

        flex-shrink: 0;

        display: flex;

        align-items: center;

        justify-content: center;

        border: 0;

        border-left:
            1px solid #e5e5e5;

        background: #f7f7f7;

        color: #333333;

        cursor: pointer;

        transition:
            background 0.2s ease,
            transform 0.25s ease;

    }


    /*
    |--------------------------------------------------------------------------
    | Arrow Hover
    |--------------------------------------------------------------------------
    */

    .app-download-widget__arrow:hover {

        background: #eeeeee;

    }


    /*
    |--------------------------------------------------------------------------
    | Collapsed State
    |--------------------------------------------------------------------------
    */

    .app-download-widget.is-collapsed {

        width: 30px;

        box-shadow:
            0 5px 18px rgba(0, 0, 0, 0.20);

    }


    .app-download-widget.is-collapsed
    .app-download-widget__content {

        opacity: 0;

        pointer-events: none;

    }


    .app-download-widget.is-collapsed
    .app-download-widget__arrow svg {

        transform: rotate(180deg);

    }


    /*
    |--------------------------------------------------------------------------
    | Mobile
    |--------------------------------------------------------------------------
    */

    @media (max-width: 768px) {

        .app-download-widget {

            display: none !important;

        }

    }

</style>


<script>

    document.addEventListener('DOMContentLoaded', function () {

        const widget =
            document.getElementById('appDownloadWidget');

        const toggle =
            document.getElementById('appDownloadToggle');

        if (!widget || !toggle) {
            return;
        }


        toggle.addEventListener('click', function () {

            const collapsed =
                widget.classList.toggle('is-collapsed');


            toggle.setAttribute(
                'aria-expanded',
                collapsed ? 'false' : 'true'
            );


            toggle.setAttribute(
                'aria-label',
                collapsed
                    ? 'Show QR code'
                    : 'Hide QR code'
            );

        });

    });

</script>
