not-allowed disabled:hover:bg-transparent disabled:active:bg-transparent [&amp;.loading]:bg-transparent [&amp;.loading]:text-primary-solid [&amp;.loading]:border-primary-solid [&amp;.loading]:hover:bg-transparent [&amp;.loading]:active:bg-transparent bgWhite capText" aria-disabled="false" aria-busy="false" type="button"><div class="flex items-center gap-2 pointer-events-none"><span class="pointer-events-none"><span class="makeFlex hrtlCenter"><span>View All</span><span class="makeFlex hrtlCenter appendBottom2"><span class="appendLeft4"> <!-- -->(</span><span class="appendTop1">11</span><span>)</span></span></span></span></div></button></div></div></div></div></span><div class="cardHldr appendTop16"><div class="ovrlRating "><span itemProp="worstRating" content="1"></span><div class="ovrlRating__rating blueBg" itemProp="ratingValue">3.8</div><span itemProp="bestRating" content="5"></span><div class="ovrlRating__desc"><div><span class="ovrlRating__title">Very Good</span><span class="lowText appendLeft5">(395 RATINGS)</span></div></div><button class="textBtn appendLeft10" style="color:#008CFF">All Reviews</button></div><div class="hrLine appendTop16 appendBottom16" style="background:#D8D8D8"></div><div class="locCard pointer"><div class="locCard__row"><img src="https://imgak.mmtcdn.com/pwa_v3/pwa_hotel_assets/map-icon-dtls.png" alt="Dabagardens" class="locCard__icon"><div class="locCard__desc"><p class="label-large-w3 locCard__title text-highEmphasis">Dabagardens</p><p class="label-small-w1 locCard__subTitle">2.7 km drive to Ramakrishna Beach</p></div><button class="textBtn appendLeft10" style="color:#008CFF">See on Map</button></div></div></div><div class="appendTop16 hdrContainer__rightOneCircle"></div></div></div></div></div><div style="display:none"><div class="prptModal__container"><div class="prptModal"><span class="prptModal__close"></span><div class="prptModal__header"><h3 class="latoBlack font28 blackText appendBottom10">AGARWAL RESIDENCY Recently Renovated </h3><h4 class="latoBold font16 lineHight18"><b>Located in the heart of the Visakhapatnam, Hotel Saaket Residency offers you a home-like stay through its comfortable amenities and blissful surroundings.</b></h4></div><div class="prptModal__content"><div class="prptModal__contentSection" id="1595858708660"><div class="prptModal__titleContainer"><h4>Property Highlights</h4></div><ul class="prptModal__list"><li class="remove-empty-li"><span><span>The hotel is fully air-conditioned and has an uninterrupted Wi-fi connection throughout.</span></span></li><li class="remove-empty-li"><span><span>With a reception, the guests can have direct correspondence at the property regarding their needs and requirements.</span></span></li><li class="remove-empty-li"><span><span>The retreat also has a bellboy service at the beck and call of the guests.</span></span></li><li class="remove-empty-li"><span><span>Ensuring the well-being and security of the guests, the retreat is under CCTV surveillance and has security and fire extinguishers.</span></span></li><li class="remove-empty-li"><span><span>A seating area is provided for the convenience of the waiting guests.</span></span></li><li class="remove-empty-li"><span><span>The residence sets up 3 designs of rooms. </span></span></li><li class="remove-empty-li"><span><span>Royal Darbar occupies an area of 266 sq ft and offers king-size beds. </span></span></li><li class="remove-empty-li"><span><span>Royal and Luxury rooms occupy an area of 252 sq ft &amp; 216 sq ft respectively and offer a king-size or 2 twin beds.</span></span></li><li class="remove-empty-li"><span><span>Each room can house 3 guests and extends pillows, cushions, blankets, couch, sofa, clothes rack with hangers, cupboards with lock, ceiling fan, air conditioning centre table, dining, seating &amp; living areas, Wi-Fi, telephone, TV, study room, newspapers, electrical sockets, dustbins, ironing board, electric kettle, laundry, dry cleaning services, 24-hour room service and daily housekeeping. </span></span></li><li class="remove-empty-li"><span><span>The attached bathrooms come hot/cold water, mirror, towels and shower. </span></span></li></ul><div class="prptModal__imgList"><div class="slick-slider slick-initialized"><div class="slick-list"><div class="slick-track" style="width:100%;left:0%"><div data-index="0" class="slick-slide slick-active slick-current" tabindex="-1" aria-hidden="false" style="outline:none;width:50%"><div><div class="prptModal__imgList-itm" tabindex="-1" style="width:100%;display:inline-block"><img src="https://r2imghtlak.mmtcdn.com/r2-mmt-htl-image/htl-imgs/201909261247524085-fe1a1758e99d11e98cff0242ac110002.jpg" alt=""></div></div></div><div data-index="1" class="slick-slide slick-active" tabindex="-1" aria-hidden="false" style="outline:none;width:50%"><div><div class="prptModal__imgList-itm" tabindex="-1" style="width:100%;display:inline-block"><img src="https://r2imghtlak.mmtcdn.com/r2-mmt-htl-image/htl-imgs/201909261247524085-40a709de1eee11ea97e60242ac110005.jpg" alt=""></div></div></div></div></div></div></div></div><div class="prptModal__contentSection" id="1595858717150"><div class="prptModal__titleContainer"><h4>Activities &amp; Nearby Attractions</h4></div><ul class="prptModal__list"><li class="remove-empty-li"><span><span>Dr Y S Rajasekhara Reddy Central Park, 2.1 km apart can be visited for a fun frolic picnic day out. </span></span></li><li class="remove-empty-li"><span><span>Matsya Darshini, 2.9 km away displays a diverse variety of marine plants and creatures.</span></span></li><li class="remove-empty-li"><span><span>Visakha Museum, 4.8 km expounds an array of artefacts insinuating the development of the city and the naval history.</span></span></li></ul></div><div class="prptModal__contentSection" id="1595858719770"><div class="prptModal__titleContainer"><h4>How to Reach the Property</h4></div><p><span><span>The hotel is 1.8 km from Vishakapatnam train station, 4.1 km from Maddilapalem bus depot and 10.5 km from Visakhapatnam International Airport.</span></span></p></div></div></div><div class="prptModal__backdrop"></div></div></div></section><section id="altAccoSpecificSection"></section><div data-seo-priceid="data-seo-priceid-2"><div class="flexiChkin appendTop16"><div class="flexiChkin__hdr"><div class="flexOne"><p class="makeFlex hrtlCenter"><span class="font18 latoBlack blackText">Are you flexible with travel dates?</span> </p><p class="appendTop3">Find Alternate Prices with Flexi Dates</p></div><button class="primaryBtn appBtn outline large">MODIFY DATES</button></div></div></div><section id="roomSection" class="tabPageSection" data-seo-priceid="data-seo-priceid-3"><div class="paperCont appendTop16"><div id="packageroomcontainer"><div class="rmSelect__packageRoom appendBottom30"><div class="sprPkgPersuasion" style="background:linear-gradient(5deg, #D3E7FF, #FFFFFF, #FFFFFF)"><span class="sprPkgPersuasion__tag"><img src="https://promos.makemytrip.com/Growth/Images/B2C/Upgrade_Stay_Logo.png" alt="super package"></span><div class="makeFlex hrtlCenter"><span class="sprPkgPersuasion__text" data-testid="sprPkgPersuasion__text">Upgrade to a <b>4.2 rated</b> stay with a <b>larger room</b> for just <b>₹232</b> more!</span></div></div><div class="rmSelect__card--wrapRowDtlNew" id="room0"><div class="rmSelect__card--leftDtlNew"><div class="rmTypeDtlNew "><div class="makeRelative"><div class="rmPhotos appendBottom16 "><div class="slick-slider slick-initialized"><div class="slick-list"><div class="slick-track" style="width:0%;left:NaN%"></div></div></div></div></div><div class="makeFlex hrtlCenter spaceBetween"><h2 class="rmType__roomName rmType__roomNameDtlNew" data-testid="rmType__roomName">Royal AC Room</h2><p class="maxPaxCountText">Max<!-- --> &nbsp;<!-- -->3<!-- -->&nbsp;<!-- -->Guests<!-- --> </p></div><div class="font16 lineHight20 formTypeListDtlNew appendTop3 appendBottom3"><ul class="rmTypeList vertical appendTop10 "><li class="rmTypeList__item"><span cla