/* Seasonal Data Block Styles - MMT Desktop */
.seasonal__data {
    border-radius: 4px;
    background-color: #fff;
}

.seasonal__table {
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    margin-top: 16px;
    overflow: hidden;
}

.seasonal__table-content {
    display: flex;
    flex-direction: column;
    overflow-x: auto;
    overflow-y: hidden;
    min-width: 100%;
    background-color: #fff;
    position: relative;
}

.seasonal__table-content .seasonal__header,
.seasonal__table-content .seasonal__row {
    min-width: 800px; /* Ensure minimum width for proper scrolling */
}

.seasonal__header {
    display: flex;
    background-color: #f2f2f2;
    font-weight: 700;
    border-bottom: 1px solid #d8d8d8;
}

.seasonal__header-cell {
    flex: 1;
    padding: 16px;
    border-right: 1px solid #d8d8d8;
    font-size: 16px;
    font-weight: 700;
    color: #000;
    text-align: center;
    min-width: 120px;
}

.seasonal__header-cell:last-child {
    border-right: none;
}

.seasonal__header-cell--month {
    flex: 0 0 120px;
    position: sticky;
    left: 0;
    background-color: #f2f2f2;
    z-index: 3;
}

.seasonal__header-cell--temp {
    flex: 0 0 120px;
}

.seasonal__header-cell--season {
    flex: 1.5;
}

.seasonal__header-cell--activities {
    flex: 2;
}

.seasonal__header-cell--hotels {
    flex: 2;
}

.seasonal__row {
    display: flex;
    border-bottom: 1px solid #e6e6e6;
    align-items: stretch;
}

.seasonal__row:last-child {
    border-bottom: none;
}

.seasonal__row--hidden {
    display: none !important;
}

.seasonal__cell {
    flex: 1;
    padding: 16px;
    border-right: 1px solid #e6e6e6;
    font-size: 14px;
    line-height: 17px;
    color: #4a4a4a;
    vertical-align: top;
    min-width: 120px;
}

.seasonal__cell:last-child {
    border-right: none;
}

.seasonal__cell--month {
    flex: 0 0 120px;
    font-weight: 700;
    color: #000;
    text-align: center;
    position: sticky;
    left: 0;
    background-color: #fff;
    z-index: 2;
}

.seasonal__cell--temp {
    flex: 0 0 120px;
    text-align: center;
    font-weight: 600;
    color: #0C58B4;
}

.seasonal__cell--season {
    flex: 1.5;
}

.seasonal__cell--activities {
    flex: 2;
}

.seasonal__cell--hotels {
    flex: 2;
    position: relative;
}

.seasonal__hotels-summary,
.seasonal__activities-summary {
    display: inline;
}

.seasonal__hotels-full,
.seasonal__activities-full {
    display: none;
}

.seasonal__hotels-content,
.seasonal__activities-content {
    color: #4a4a4a;
}


/* Mobile responsive overrides for seasonal table */
@media (max-width: 768px) {
    .seasonal__table-content .seasonal__header,
    .seasonal__table-content .seasonal__row {
