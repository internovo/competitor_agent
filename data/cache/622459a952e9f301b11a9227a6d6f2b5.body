    display: inline-flex;
    flex-direction: row;
    flex-shrink: 0;
}
.mmtRating{
    display: inline-flex;
    align-items: center;
}
.mmtRating__text{
    font-size: 16px;
    line-height: 19px;
    color: #0C58B4;
    font-weight: 900;
    margin-right: 9px;
}
.mmtRating__tag{
    width: 32px;
    height: 20px;
    background-color: #0C58B4;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    line-height: 17px;
    font-weight: 900;
    color: #fff;
}
.sRating__row {
    font-size: 0;
    display: flex;
    flex-wrap: nowrap;
    overflow: hidden;
}
.sRating__row > img {
    vertical-align: top;
    margin-right: 1px;
}

.hotel-detail-wrapper{
    border-radius: 16px;
}

.nearBy.home-grid.products-grid{
margin: 10px;
}

.paddingLR16{
