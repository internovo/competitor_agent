.seasonal__gi-table {
    display: flex;
    flex-direction: column;
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    overflow: hidden;
    margin-top: 16px;
}

.seasonal__gi-header {
    display: flex;
    background-color: #f2f2f2;
    font-weight: 700;
}

.seasonal__gi-header-cell {
    flex: 1;
    padding: 12px 16px;
    border-right: 1px solid #d8d8d8;
    font-size: 14px;
    font-weight: 700;
    color: #000;
}

.seasonal__gi-header-cell:last-child {
    border-right: none;
}

.seasonal__gi-row {
    display: flex;
    border-bottom: 1px solid #e6e6e6;
}

.seasonal__gi-row:last-child {
    border-bottom: none;
}

.seasonal__gi-cell {
    flex: 1;
    padding: 12px 16px;
    border-right: 1px solid #e6e6e6;
    font-size: 14px;
    line-height: 17px;
    color: #4a4a4a;
}

.seasonal__gi-cell:last-child {
    border-right: none;
