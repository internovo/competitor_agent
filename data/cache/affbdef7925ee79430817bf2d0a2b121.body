<div data-cmp-type="react" data-component="OfferLoginModal" data-component-data="{&#34;mobileNumberSupportText&#34;:&#34;An OTP will be sent to this number for verification&#34;,&#34;pincodeLabelText&#34;:&#34;PIN Code&#34;,&#34;submitBtnText&#34;:&#34;Get OTP&#34;,&#34;salaryInvalidText&#34;:&#34;Please enter monthly salary amount&#34;,&#34;:type&#34;:&#34;bajajfinserv-web/components/content/login&#34;,&#34;fullNameSupportText&#34;:&#34;Enter your name&#34;,&#34;nonsalariedbuttonValue&#34;:&#34;Self Employed&#34;,&#34;formMobileNumberLabelText&#34;:&#34;Mobile Number&#34;,&#34;mobileNumberEmptyText&#34;:&#34;This field cannot be left blank&#34;,&#34;formSubmitBtnText&#34;:&#34;GET OTP&#34;,&#34;mobileNumberInvalidText&#34;:&#34;Please enter a valid 10-digit mobile number&#34;,&#34;scriptErrorPopupTitleText&#34;:&#34;The Server is down, Please try again after sometime.&#34;,&#34;lastNameInvalidText&#34;:&#34;Please enter your last name as per your PAN Card&#34;,&#34;fullNameInvalidText&#34;:&#34;Enter valid name&#34;,&#34;firstNameLabelText&#34;:&#34;First Name&#34;,&#34;lastNameEmptyText&#34;:&#34;Please enter your last name as per your PAN Card&#34;,&#34;formMobileNumberSupportText&#34;:&#34;Enter your 10-digit mobile number&#34;,&#34;pincodeSupportText&#34;:&#34;Enter your 6-digit residential PIN Code&#34;,&#34;subHeadingText&#34;:&#34;Check pre-approved offers &amp; eligibility | Start investing | Buy insurance | Manage account&#34;,&#34;salariedbuttonText&#34;:&#34;Salaried&#34;,&#34;formSubHeadingText&#34;:&#34;Please share a few details to start your application&#34;,&#34;scriptErrorPopupCtaText&#34;:&#34;Got It&#34;,&#34;firstNameEmptyText&#34;:&#34;Please enter your first name as per your PAN Card&#34;,&#34;mobileNumberLabelText&#34;:&#34;Mobile number&#34;,&#34;lastNameLabelText&#34;:&#34;Last Name&#34;,&#34;proceedBtnText&#34;:&#34;Proceed&#34;,&#34;showOnWeb&#34;:&#34;false&#34;,&#34;isCommonSsoLogin&#34;:&#34;true&#34;,&#34;firstNameSupportText&#34;:&#34;Enter your first name as it appears on your PAN Card&#34;,&#34;formHeadingText&#34;:&#34;Get started&#34;,&#34;employmentTypeSupportText&#34;:&#34;Please select your type of employment&#34;,&#34;pincodeEmptyText&#34;:&#34;Please enter your 6-digit current residential PIN Code&#34;,&#34;minimumSalaryAmount&#34;:&#34;0&#34;,&#34;fullNameEmptyText&#34;:&#34;Please enter your name&#34;,&#34;nonsalariedbuttonText&#34;:&#34;Self-employed&#34;,&#34;salaryLabelText&#34;:&#34;Monthly Income&#34;,&#34;currencySymbol&#34;:&#34;Rs.&#34;,&#34;showOnApp&#34;:&#34;false&#34;,&#34;pincodeInvalidText&#34;:&#34;Please enter a valid 6-digit current residential PIN Code&#34;,&#34;fullNameLabelText&#34;:&#34;Full Name&#34;,&#34;firstNameInvalidText&#34;:&#34;Please enter your first name as per your PAN Card&#34;,&#34;headingText&#34;:&#34;Get started&#34;,&#34;commonSsoScriptUrl&#34;:&#34;https://www.bajajfinserv.in/3in1web/onboarding-web/prod/bfl-login-wc-v1.js&#34;,&#34;componentPath&#34;:&#34;/content/experience-fragments/bajajfinserv/web/in/en/sso-login/master/_jcr_content/root/login&#34;,&#34;employmentLabelText&#34;:&#34;Employment type&#34;,&#34;salariedbuttonValue&#34;:&#34;Salaried&#34;,&#34;hideFirstName&#34;:&#34;true&#34;,&#34;salaryEmptyText&#34;:&#34;Please enter monthly salary amount&#34;,&#34;enableIpp&#34;:&#34;false&#34;,&#34;lastNameSupportText&#34;:&#34;Enter your last name as it appears on your PAN Card&#34;}"></div>


    
</div>
<div class="suspiciousmodal componentseo aem-GridColumn aem-GridColumn--default--12">
<div data-cmp-type="react" data-component="SuspiciousModal" data-component-data="{&#34;imageAltText&#34;:&#34;account blocked&#34;,&#34;image&#34;:&#34;https://cms-assets.bajajfinserv.in/is/image/bajajfinance/suspicious-2?scl=1&amp;fmt=png-alpha&#34;,&#34;helpText&#34;:&#34;Need help?&#34;,&#34;ctaText&#34;:&#34;GOT IT&#34;,&#34;heading&#34;:&#34;Suspicious Activity Detected &#34;,&#34;textIsRich&#34;:[&#34;true&#34;,&#34;true&#34;,&#34;true&#34;,&#34;true&#34;,&#34;true&#34;,&#34;true&#34;,&#34;true&#34;,&#34;true&#34;,&#34;true&#34;,&#34;true&#34;,&#34;true&#34;],&#34;description&#34;:&#34;Your account login has been declined as we have noticed some suspicious activity on your mobile number. Please download Bajaj Finserv app to raised a request.&#34;,&#34;showOnApp&#34;:&#34;false&#34;,&#34;cardsList&#34;:{&#34;item0&#34;:{&#34;title&#34;:&#34;Why is &#39;My Account&#39; blocked?&#34;,&#34;faqAnswer&#34;:&#34;&lt;p&gt;Your account may be blocked due to the following reasons:&lt;\/p&gt;\r\n&lt;ul&gt;\r\n&lt;li&gt;You may have entered an incorrect OTP multiple times.&lt;\/li&gt;\r\n&lt;li&gt;You may have more than one customer ID registered on your mobile number&lt;\/li&gt;\r\n&lt;li&gt;You may have ended the session abruptly&lt;\/li&gt;\r\n&lt;li&gt;You may have entered an incorrect date of birth/PAN multiple times&lt;\/li&gt;\r\n&lt;\/ul&gt;\r\n&#34;},&#34;item2&#34;:{&#34;title&#34;:&#34;Which mobile number should I use to log in?&#34;,&#34;faqAnswer&#34;:&#34;&lt;ul&gt;\r\n&lt;li&gt;If you are an existing customer with Bajaj Finance, log in with the registered number.&lt;\/li&gt;\r\n&lt;li&gt;If you are a new customer of Bajaj Finance, you should choose the number you would like to receive updates for all future financial transactions and communications from us&lt;\/li&gt;\r\n&lt;\/ul&gt;\r\n&#34;},&#34;item1&#34;:{&#34;title&#34;:&#34;Why is &#39;My Account&#39; temporarily locked?&#34;,&#34;faqAnswer&#34;:&#34;&lt;p&gt;You may receive this error message if:&lt;\/p&gt;\r\n&lt;ul&gt;\r\n&lt;li&gt;You have entered an incorrect OTP multiple times&lt;\/li&gt;\r\n&lt;li&gt;You have ended the session abruptly&lt;\/li&gt;\r\n&lt;li&gt;You have entered an incorrect date of birth/PAN multiple times&lt;\/li&gt;\r\n&lt;\/ul&gt;\r\n&#34;},&#34;item8&#34;:{&#34;title&#34;:&#34;Why can&#39;t I log in with my date of birth?&#34;,&#34;faqAnswer&#34;:&#34;&lt;p&gt;This may be because you are entering an incorrect DOB which is not registered with us. You can only log in with your registered DOB.&lt;\/p&gt;\r\n&#34;},&#34;item7&#34;:{&#34;title&#34;:&#34;How can I log in with my e-mail ID?&#34;,&#34;faqAnswer&#34;:&#34;&lt;p&gt;You can only use your e-mail ID for logging in only if you are an NRI or non-individual (corporate) customer with us.&lt;\/p&gt;\r\n&#34;},&#34;item9&#34;:{&#34;title&#34;:&#34;Why can&#39;t I log in through my Permanent Account Number (PAN)?&#34;,&#34;faqAnswer&#34;:&#34;&lt;p&gt;This may be because you are entering an incorrect PAN which is not registered with us. You can only log in with your registered PAN.&lt;\/p&gt;\r\n&#34;},&#34;item4&#34;:{&#34;title&#34;:&#34;How can I log in to \u2018My Account\u2019 without sharing my mobile number?&#34;,&#34;faqAnswer&#34;:&#34;&lt;p&gt;If you are an &#39;individual&#39; (non-corporate), you can only access &#39;My Account&#39; details by validating your registered mobile number.&lt;\/p&gt;\r\n&lt;p&gt;If you are a &#39;non-individual&#39; (corporate) or an NRI customer; you can log in to &#39;My Account&#39; either by validating your registered mobile number or your registered e-mail ID.&lt;\/p&gt;\r\n&#34;},&#34;item3&#34;:{&#34;title&#34;:&#34;How do I login if my mobile number is changed?&#34;,&#34;faqAnswer&#34;:&#34;&lt;p&gt;If you are an existing customer, you can connect with our alternative service channel to change your mobile number as below:&lt;\/p&gt;\r\n&lt;ul&gt;\r\n&lt;li&gt;You can visit our nearest branch or click &lt;a href=\&#34;/branch-locator\&#34; target=\&#34;_self\&#34;&gt;branch locator&lt;\/a&gt; to check the branch close to you&lt;\/li&gt;\r\n&lt;li&gt;You can choose to call us on 8698010101 to connect with our customer service, verify your identity, and follow the recommended process.&lt;\/li&gt;\r\n&lt;\/ul&gt;\r\n&lt;p&gt;If you are a new customer, you can continue to log in with your new/changed mobile number.&lt;br&gt;\r\n&lt;\/p&gt;\r\n&#34;},&#34;item10&#34;:{&#34;title&#34;:&#34;Why can&#39;t I log in as an &#39;individual&#39; customer?&#34;,&#34;faqAnswer&#34;:&#34;&lt;p&gt;This may be because of either of the following reasons:&lt;\/p&gt;\r\n&lt;ul&gt;\r\n&lt;li&gt;You are trying to log in with a number that is not registered with us.&lt;\/li&gt;\r\n&lt;li&gt;You are registered as a &#39;non-individual&#39; (corporate) or an NRI customer.&lt;br&gt;\r\n&lt;\/li&gt;\r\n&lt;\/ul&gt;\r\n&lt;p&gt;Please check and try again with the correct details.&lt;\/p&gt;\r\n&#34;},&#34;item6&#34;:{&#34;title&#34;:&#34;Why can&#39;t I log in using my customer ID?&#34;,&#34;faqAnswer&#34;:&#34;&lt;p&gt;We have done away with the customer ID logins to enhance the safety of our customers and their personal information.&lt;\/p&gt;\r\n&lt;p&gt;With &#39;My Account&#39;, you can only log in with your registered mobile number (individual), e-mail ID, and mobile number (only for non-individual and NRI customers).&lt;\/p&gt;\r\n&#34;},&#34;item5&#34;:{&#34;title&#34;:&#34;Suspicious Activity Detected: Your account login has been declined as we have noticed some suspicious activity on your mobile number.&#34;,&#34;faqAnswer&#34;:&#34;&lt;p&gt;Please raise a request through app or the self-service channels under the &#39;Reach Us&#39; section on &lt;a href=\&#34;https://www.bajajfinserv.in/\&#34; target=\&#34;_self\&#34;&gt;www.bajajfinserv.in.&lt;\/a&gt; Upon receipt of your request, we will investigate the same internally and shall respond to you on your registered email ID or mobile number.&lt;\/p&gt;\r\n&#34;}},&#34;showOnWeb&#34;:&#34;false&#34;,&#34;:type&#34;:&#34;bajajfinserv-web/components/content/suspiciousmodal&#34;,&#34;componentPath&#34;:&#34;/content/experience-fragments/bajajfinserv/web/in/en/sso-login/master/_jcr_content/root/suspiciousmodal&#34;,&#34;faqTitle&#34;:&#34;Frequently Asked Questions&#34;,&#34;enableIpp&#34;:&#34;false&#34;}"></div>
</div>
<div class="otp componentseo aem-GridColumn aem-GridColumn--default--12">
<div data-cmp-type="react" data-component="OfferOTPModal" data-component-data="{&#34;changeMobileText&#34;:&#34;Change&#34;,&#34;textIsRich&#34;:&#34;true&#34;,&#34;resendOTPTime&#34;:&#34;60&#34;,&#34;submitBtnText&#34;:&#34;Submit&#34;,&#34;showOnApp&#34;:&#34;false&#34;,&#34;termsErrorText&#34;:&#34;Please accept our Privacy Policy and Terms of Use&#34;,&#34;OTPTitleText&#34;:&#34;Enter One Time Password (OTP)&#34;,&#34;resendOtpText&#34;:&#34;Resend OTP&#34;,&#34;offersRedirectURL&#34;:&#34;#&#34;,&#34;imgURL&#34;:&#34;https://cms-assets.bajajfinserv.in/is/image/bajajfinance/otp-lock-secure?scl=1&amp;fmt=png-alpha&#34;,&#34;tcText&#34;:&#34;&lt;p>I have read, understood, and hereby accept the &lt;a href=\&#34;/privacy-policy\&#34; target=\&#34;_self\&#34;>Privacy Policy&lt;\/a> and &lt;a href=\&#34;/terms-of-use\&#34; target=\&#34;_self\&#34;>Terms of Use&lt;\/a>. I expressly allow Bajaj Finance Ltd to store and process my information for sending personalised offers on suitable products and services.&lt;\/p>\r\n&#34;,&#34;showOnWeb&#34;:&#34;false&#34;,&#34;errorMessages&#34;:[{&#34;message&#34;:&#34;Success&#34;,&#34;statusCode&#34;:&#34;90&#34;},{&#34;message&#34;:&#34;Fail&#34;,&#34;statusCode&#34;:&#34;91&#34;}],&#34;OTPDescriptionText&#34;:&#34;An OTP has been sent to&#34;,&#34;oTPTitleText&#34;:&#34;OTP&#34;,&#34;attemptsText&#34;:&#34;attempt remaining&#34;,&#34;tcNewTab&#34;:&#34;true&#34;,&#34;oTPDescriptionText&#34;:&#34;An OTP has been sent on your mobile number&#34;,&#34;secText&#34;:&#34;Secs&#34;,&#34;enableIpp&#34;:&#34;false&#34;}"></div>


    
