<link rel="stylesheet" href="/etc.clientlibs/bajajfinserv-frontend/clientlibs/clientlib-adp_bfl.min.03ba47007c8d31a6825afe4833a8bdba.css" type="text/css">








<!-- 
   Shared New Relic custom-attributes helper.
   Included from customheaderlibs.html; 
   reads meta[name="tag-1"], meta[name="tag-2"] and meta[name="tag-3"] (if present) and forwards them to New Relic. 
-->
<script type="text/javascript">
    (function () {
        'use strict';

        function sendMetaTagsToNewRelic() {
            try {
                if (typeof window.newrelic === 'undefined' || typeof window.newrelic.setCustomAttribute !== 'function') {
                    return;
                }

                const tag1Meta = document.querySelector('meta[name="tag-1"]');
                if (tag1Meta) {
                    const tag1Value = tag1Meta.getAttribute('content');
                    if (tag1Value && tag1Value.trim() !== '') {
                        window.newrelic.setCustomAttribute('metaTag1', tag1Value);
                    }
                }

                const tag2Meta = document.querySelector('meta[name="tag-2"]');
                if (tag2Meta) {
                    const tag2Value = tag2Meta.getAttribute('content');
                    if (tag2Value && tag2Value.trim() !== '') {
                        window.newrelic.setCustomAttribute('metaTag2', tag2Value);
                    }
                }

                const tag3Meta = document.querySelector('meta[name="tag-3"]');
                if (tag3Meta) {
                    const tag3Value = tag3Meta.getAttribute('content');
                    if (tag3Value && tag3Value.trim() !== '') {
                        window.newrelic.setCustomAttribute('metaTag3', tag3Value);
                    }
                }

            } catch (error) {
                if (window.newrelic && typeof window.newrelic.noticeError === 'function') {
                    window.newrelic.noticeError(error);
                }
            }
        }

        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            sendMetaTagsToNewRelic();
        } else {
            document.addEventListener('DOMContentLoaded', sendMetaTagsToNewRelic);
        }
    })();
</script>

    <script type="text/javascript">const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent); if (isSafari) { function t() { document.addEventListener("mouseover", t => { let { target: e } = t; "A" === e.tagName && e.setAttribute("target", "_self"), e.closest("a")?.setAttribute("target", "_self") }) } setTimeout(t, 0) }
    </script>


    <script type="text/javascript">
        function getPageName() {
            const tag1 = document.querySelector('meta[name="tag-1"]')?.content || '';
            const tag2 = document.querySelector('meta[name="tag-2"]')?.content || '';
            const tag3 = document.querySelector('meta[name="tag-3"]')?.content || '';
            const dataLayerObject = {
                page_type: tag1,
                product_category: tag2,
                product_name: tag3
            };
            let pageName = '';
            if (dataLayerObject.product_name && dataLayerObject.product_name.trim() !== '') {
                pageName = dataLayerObject.product_name + " " + dataLayerObject.page_type;
            } else if (dataLayerObject.product_category && dataLayerObject.product_category.trim() !== '') {
                pageName = dataLayerObject.product_category;
            }
            return pageName?.replace(/-/g, " ")?.toUpperCase();
        }
        try {
            if (window.location.href.includes("/app-v") && !window.location.href.includes("author-")) {
                var tag7Content = document.querySelector('meta[name="tag-7"]').getAttribute('content');
                if (tag7Content) {
                    window.prompt("triggerCTEvent://" + JSON.stringify({ eventName: tag7Content, props: { page_url: document.URL, EP_LOAD_TYPE: "INITIAL LOADED", EP_PAGE_NAME: getPageName() } }));
                }
            }
        } catch (e) { }
    </script>

  
    
    

    

    
    
    



    

