tomText&#34;:&#34;&lt;p>Click on CONTINUE to share your details for auto login. If you choose to skip it, you will be asked to log in by entering your credentials on Bajaj Mall.&lt;\/p>\r\n&#34;,&#34;modalContentUpperText&#34;:&#34;&lt;p>To provide you with a seamless personalized shopping experience and amazing offers, your name and mobile number will be shared to help you in instant login at Bajaj Mall.&lt;\/p>\r\n&#34;,&#34;partnerName&#34;:&#34;BFDL&#34;,&#34;cmfConsentCategory&#34;:&#34;BFL Entity&#34;,&#34;partnerId&#34;:&#34;999&#34;,&#34;cmfProduct&#34;:&#34;bajajmall&#34;,&#34;secondaryCtaText&#34;:&#34;Skip&#34;,&#34;modalContentBlueBgText&#34;:&#34;&lt;p>Note:&lt;\/p>\r\n&lt;ul>\r\n&lt;li>The usage of your information is governed basis the terms and conditions (T&amp;amp;C) of Bajaj Mall.&lt;\/li>\r\n&lt;\/ul>\r\n&lt;ul>\r\n&lt;li>Bajaj Mall will display your basic relationship(s) details.&lt;\/li>\r\n&lt;\/ul>\r\n&#34;},&#34;item2&#34;:{&#34;primaryCtaText&#34;:&#34;Continue&#34;,&#34;redirectionUrlWebPartners&#34;:&#34;/web-partners-beyoung&#34;,&#34;partnerModalTitle&#34;:&#34;Beyoung&#34;,&#34;partnerName&#34;:&#34;BY&#34;,&#34;partnerLogo&#34;:&#34;https://cms-assets.bajajfinserv.in/is/image/bajajfinance/beyoung-10?scl=1&amp;fmt=png-alpha&#34;,&#34;cmfConsentCategory&#34;:&#34;External Partner&#34;,&#34;partnerId&#34;:&#34;136&#34;,&#34;cmfProduct&#34;:&#34;webpartners&#34;,&#34;partnerLogoAltText&#34;:&#34;Beyoung&#34;},&#34;item1&#34;:{&#34;primaryCtaText&#34;:&#34;CONTINUE&#34;,&#34;modalTitle&#34;:&#34;Redirecting you to CARS24&#34;,&#34;partnerName&#34;:&#34;Cars24&#34;,&#34;cmfConsentCategory&#34;:&#34;BFL Entity&#34;,&#34;partnerId&#34;:&#34;219&#34;,&#34;cmfProduct&#34;:&#34;Cars24&#34;,&#34;secondaryCtaText&#34;:&#34;SKIP&#34;,&#34;modalContentBlueBgText&#34;:&#34;&lt;p>Click on CONTINUE to be redirected to CARS24 (our used car partner website). By proceeding, you will be governed by the Terms and Conditions, Terms of Use, and Privacy Policy