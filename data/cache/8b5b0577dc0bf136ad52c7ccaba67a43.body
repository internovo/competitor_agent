             class="img-fluid hover-scale" style="max-height: 350px; width: auto; object-fit: cover; border-radius: 10px; box-shadow: 10px 10px 25px rgba(0, 6, 14, 0.87);">
      </div>
      <a href="#" class="btn_comon btn_theme mt-3" data-bs-toggle="modal" data-bs-target="#DownloadBrochure">Download Brochure</a>
