      <span class="divied"></span>
</div>
 
</div>

<!-- SINGLE BOX with left accent, border, rounded edges -->
<div class="row mt-4">
<div class="col-12">
  <div class="project_card p-4 shadow-sm d-flex flex-wrap position-relative"
       style="background: #fff; border: 2px solid #000; border-radius: 15px; overflow: hidden;">

    <!-- Left Accent Bar -->
    <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background-color: #503201;"></div>

    <!-- Left Side: Text -->
    <div class="col-lg-6 col-md-12 mb-4 mb-lg-0" style="padding-left: 20px;">
      <h3 style="color:#503201; margin-bottom:20px;">Secure Your Apartment Today</h3>
      <ul style="padding-left: 20px; color:#333; line-height:1.8;">
        <li><strong>Register Interest:</strong> Sign up with our sales team for priority updates.</li>
        <li><strong>Visit the Site:</strong> Explore the location and project details in person.</li>
        <li><strong>Select a Home:</strong> Choose from a variety of 1, 2 and 3 BHK layouts.</li>
        <li><strong>Get Pricing Details:</strong> We'll share the complete price list and payment plan.</li>
        <li><strong>Fill Application:</strong> Complete the booking application form.</li>
        <li><strong>Submit Documents:</strong> Provide the required KYC and identification documents.</li>
        <li><strong>Make Payment:</strong> Pay the booking amount to block your unit.</li>
        <li><strong>Receive Allotment:</strong> Get your official allotment letter from Sanghvi Realty.</li>
      </ul>
    </div>

    <!-- Right Side: Image -->
    <div class="col-lg-6 col-md-12 text-center">
      <div class="project_image" style="border-radius:10px; overflow:hidden; display:inline-block; max-width:100%; height:auto;">
