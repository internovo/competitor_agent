n Idli\",\"highlightType\":\"Restaurant\"},{\"distance\":\"1.3\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"Bharat Oil Store\",\"highlightType\":\"Petrol Pump\"},{\"distance\":\"1.8\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"Hindustan Petroleum Corporation Limited\",\"highlightType\":\"Petrol Pump\"},{\"distance\":\"1.9\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"IndianOil\",\"highlightType\":\"Petrol Pump\"},{\"distance\":\"2.2\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"IndianOil Petrol Pump (Kandivali West)\",\"highlightType\":\"Petrol Pump\"},{\"distance\":\"0.2\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"St. Dominic Educational Trust Ground\",\"highlightType\":\"Park\"},{\"distance\":\"0.9\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"Mumbai Signs\",\"highlightType\":\"Park\"},{\"distance\":\"1.9\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"bablu\",\"highlightType\":\"Park\"},{\"distance\":\"1.3\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"S p sandeep\",\"highlightType\":\"Park\"},{\"distance\":\"1.3\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"Disha house\",\"highlightType\":\"Park\"},{\"distance\":\"0.3\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"Shree Vettri Vinayak Temple\",\"highlightType\":\"Temple / Religious Places\"},{\"distance\":\"0.4\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"રામદેવપીર મંદિર\",\"highlightType\":\"Temple / Religious Places\"},{\"distance\":\"0.3\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"Shree Devi Karumariamman Temple\",\"highlightType\":\"Temple / Religious Places\"},{\"distance\":\"0.3\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"Kesariya Hanuman\",\"highlightType\":\"Temple / Religious Places\"},{\"distance\":\"1.2\",\"isCustom\":false,\"latitude\":null,\"longitude\":null,\"placeName\":\"Sheshvanshi Kshatriya Bhandari Samaj Shri Shivling Hanuman Mandir\",\"highlightType\":\"Temple / Religious Places\"}],\"towersNum\":2,\"description\":\"Shreeji Atlantis is a premium residential high rise located in Malad West, Mumbai, developed by Shreeji Group of Companies. The project features a 45 storey tower offering thoughtfully designed 2 BHK, 3 BHK, and some larger configurations with typical sizes ranging from approx. 734–980 sq. ft. and prices around ₹1.6 Cr–₹2.5 Cr+ depending on unit type and size—making it suited to families seeking modern urban living.  Spread across several acres within the larger Shreeji SuperNest community, Atlantis provides 30+ lifestyle amenities including an infinity pool, gymnasium, banquet hall, multipurpose court, kids’ play area, landscaped gardens, and multilevel parking with EV charging provisions to support a contemporary lifestyle.  Strategically located, the project is well connected to Malad Railway Station, Western Express Highway, Dahanukar Wadi Metro, Infinity Mall, schools, hospitals, and business hubs, ensuring convenience and strong neighbourhood appeal for both residents and investors\",\"projectArea\":11374.9,\"projectAreaUnit\":\"SQM\",\"views\":96,\"isOwner\":false,\"approvalStatus\":\"APPROVED\",\"isActive\":true,\"isDisabled\":false,\"disabledAt\":null,\"disabledById\":null,\"risingStars\":false,\"metaData\":{\"lift\":true,\"steps\":{\"phases\":true,\"towers\":true,\"variants\":true,\"configurations\":true},\"parking\":true,\"pendingReraIds\":[\"P51800004400\",\"P51800047335\"],\"brochureManifest\":{\"pages\":[{\"n\":1,\"full\":\"https://assets.nobrokerage.com/brochures/cmmkb5u5q00r0sa1fycfjsfn1/v1/page_1_full.webp\"},{\"n\":2,\"full\":\"https://assets.nobrokerage.com/brochures/cmmkb5u5q00r0sa1fycfjsfn1/v1/page_2_full.webp\"},{\"n\":3,\"full\":\"https://assets.nobrokerage.com/brochures/cmmkb5u5q00r0sa1fycfjsfn1/v1/page_3_full.webp\"},{\"n\":4,\"full\":\"https://assets.nobrokerage.com/brochures/cmmkb5u5q00r0sa1fycfjsfn1/v1/page_4_full.webp\"},{\"n\":5,\"full\":\"https://assets.nobrokerage.com/brochures/cmmkb5u5q00r0sa1fycfjsfn1/v1/page_5_full.webp\"},{\"n\":6,\"full\":\"https://assets.nobrokerage.com/brochures/cmmkb5u5q00r0sa1fycfjsfn1/v1/page_6_full.webp\"},{\"n\":7,\"full\":\"https://assets.nobrokerage.com/brochures/cmmkb5u5q00r0sa1fycfjsfn1/v1/page_7_full.webp\"},{\"n\":8,\"full\":\"https://assets.nobrokerage.com/brochures/cmmkb5u5q00r0sa1fycfjsfn1/v1/page_8_full.webp\"},{\"n\":9,\"full\":\"https://assets.nobrokerage.com/brochures/cmmkb5u5q00r0sa1fycfjsfn1/v1/page_9_full.webp\"},{\"n\":10,\"full\":\"https://assets.nobrokerage.com/brochures/cmmkb5u5q00r0sa1fycfjsfn1/v1/page_10_full.webp\"}],\"status\":\"ready\",\"version\":1,\"numPages\":10,\"updatedAt\":\"2026-09-01T10:00:42.034Z\"},\"constructionStatus\":\"UNDER_CONSTRUCTION\"},\"logoBg\":\"#fff2e9\",\"displayContact\":false,\"isAuthorizedByBuilder\":false,\"projectStory\":null,\"minPrice\":22000000,\"maxPrice\":29400000,\"priceOnRequest\":false,\"isPriceOnRequest\":false,\"pricing\":{\"min\":22000000,\"max\":29400000,\"priceOnRequest\":false},\"storyUrl\":null,\"storyS3Link\":null,\"isFavorite\":false,\"lastUpdated\":\"2026-09-07T12:58:22.086Z\",\"operatingCityCount\":1,\"builderLogo\":\"https://assets.nobrokerage.com/production/2026/05/15/IMAGE/shreeji-group-logo-png-2-b4076f.png\",\"builderLogoJpg\":\"https://assets.nobrokerage.com/production/2026/05/15/IMAGE/shreeji-group-logo-jpg-2-f9fab2.jpg\",\"builderLogoPng\":\"https://assets.nobrokerage.com/production/2026/05/15/IMAGE/shreeji-group-logo-png-2-b4076f.png\",\"builderId\":\"cmirbs1ys00c6sa5k0hbbzj2w\",\"builderName\":\"Shreeji Group\",\"bannerImage\":\"1773985457330-a7a40f40e537a8f9.webp\",\"constructionStatus\":\"UNDER_CONSTRUCTION\",\"reraId\":\"P51800047335\",\"reraQR\":\"1773985457329-b626814a1e25f093.webp\",\"totalUnits\":0,\"city\":\"Mumbai\",\"locality\":\"Malad West\",\"aboutLocality\":{\"description\":\"Malad West is a lively and self-sufficient Mumbai suburb known for its busy commercial and shopping scene, including major malls and corporate parks. This dynamic area offers a diverse real estate market, from affordable homes to luxury residences. With plenty of dining and entertainment options, and great connectivity through Link Road and SV Road, it provides a lifestyle of ultimate convenience. An investment here guarantees a complete city experience where work and leisure are perfectly balanced in a thriving, well-connected community.\"},\"subLocality\":\"Orlem\",\"media\":[{\"mediaType\":\"IMAGE\",\"mediaUrl\":\"https://assets.nobrokerage.com/1773985457330-a7a40f40e537a8f9.webp\",\"name\":\"logo\",\"mediaFormat\":\"webp\",\"isActive\":true},{\"mediaType\":\"DOCUMENT\",\"mediaUrl\":\"https://assets.nobrokerage.com/1773985457330-e18d5c6b2c5aacdb.pdf\",\"name\":\"brochure\",\"mediaFormat\":\"pdf\",\"isActive\":true},{\"mediaType\":\"IMAGE\",\"mediaUrl\":\"https://assets.nobrokerage.com/1773985457329-b626814a1e25f093.webp\",\"name\":\"rera-qr:P51800047335\",\"mediaFormat\":\"webp\",\"isActive\":true},{\"mediaType\":\"IMAGE\",\"mediaUrl\":\"https://assets.nobrokerage.com/production/project/rera/shreeji-atlantis/rera-qr-codes-optional-1-uploaded-shreeji-atlantis-mumbai-p51800004400-rera-scanner-jpgjpg-517cd8.jpeg\",\"name\":\"rera-qr:P51800004400\",\"mediaFormat\":\"jpeg\",\"isActive\":true},{\"mediaType\":\"IMAGE\",\"mediaUrl\":\"https://assets.nobrokerage.com/1773985457331-3baa4d3543bd9290.webp\",\"name\":\"project-banners-1\",\"mediaFormat\":\"webp\",\"isActive\":true},{\"mediaType\":\"IMAGE\",\"mediaUrl\":\"https://assets.nobrokerage.com/production/project/builder-logos/shreeji-atlantis/builderlogos-shreeji-group-logo-png-bed749.png\",\"name\":\"builder-logos-1\",\"mediaFormat\":\"png\",\"isActive\":true},{\"mediaType\":\"IMAGE\",\"mediaUrl\":\"https://assets.nobrokerage.c