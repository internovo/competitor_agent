}
</script>



<script>
// Desktop Menu Toggle
const desktopMenuBtn = document.getElementById('desktopMenuBtn');
const desktopDropdown = document.getElementById('desktopDropdown');

// Mobile Menu Toggle
const mobileMenuBtn = document.getElementById('mobileMenuBtn');
const mobileDropdown = document.getElementById('mobileDropdown');

desktopMenuBtn?.addEventListener('click', function(e) {
    e.stopPropagation();
    desktopDropdown.classList.toggle('hidden');
});

mobileMenuBtn?.addEventListener('click', function(e) {
    e.stopPropagation();
    mobileDropdown.classList.toggle('hidden');
});

// Close dropdown when clicking outside
document.addEventListener('click', function(e) {
    if (desktopDropdown && !desktopDropdown.contains(e.target) && e.target !== desktopMenuBtn) {
        desktopDropdown.classList.add('hidden');
    }
    if (mobileDropdown && !mobileDropdown.contains(e.target) && e.target !== mobileMenuBtn) {
        mobileDropdown.classList.add('hidden');
    }
});

function closeDropdown() {
    desktopDropdown?.classList.add('hidden');
}

function closeMobileDropdown() {
    mobileDropdown?.classList.add('hidden');
}

// Navbar scroll effect
let lastScroll = 0;
const navbar = document.getElementById('navbar');

window.addEventListener('scroll', function() {
    const currentScroll = window.pageYOffset;
    
    if (currentScroll > 80) {
        navbar.classList.add('shadow-md');
    } else {
        navbar.classList.remove('shadow-md');
    }
    
    lastScroll = currentScroll;
});

// Property Modal Functions
const propertyModal = document.getElementById('propertyModal');
const propertyForm = document.getElementById('frmContact3');

function openPropertyModal() {
    propertyModal.classList.remove('hidden');
    propertyModal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    closeMobileDropdown();
    closeDropdown();
}

function closePropertyModal() {
    propertyModal.classList.add('hidden');
    propertyModal.classList.remove('flex');
    document.body.style.overflow = 'auto';
    propertyForm.reset();
}

// Requirement Modal Functions
const requirementModal = document.getElementById('requirementModal');
const requirementForm = document.getElementById('frmContact4');

function openRequirementModal() {
    requirementModal.classList.remove('hidden');
    requirementModal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    closeMobileDropdown();
    closeDropdown();
}

function closeRequirementModal() {
    requirementModal.classList.add('hidden');
    requirementModal.classList.remove('flex');
    document.body.style.overflow = 'auto';
    requirementForm.reset();
}

// Close modals on backdrop click
propertyModal?.addEventListener('click', function(e) {
    if (e.target === propertyModal) {
        closePropertyModal();
    }
});

requirementModal?.addEventListener('click', function(e) {
    if (e.target === requirementModal) {
        closeRequirementModal();
    }
});

// Close modals on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closePropertyModal();
        closeRequirementModal();
    }
});

// Form Submissions
/*propertyForm?.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(propertyForm);
    const data = Object.fromEntries(formData);
    
    // TODO: Replace with your actual form submission logic
    console.log('Property Form Data:', data);
    
    // Show success message
    alert('Thank you! Your property details have been submitted. Our team will contact you shortly.');
    
    closePropertyModal();
});

requirementForm?.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(requirementForm);
    const data = Object.fromEntries(formData);
    
    // TODO: Replace with your actual form submission logic
    console.log('Requirement Form Data:', data);
    
    // Show success message
    alert('Thank you! Your requirement has been submitted. We will get back to you with matching properties soon.');
    
    closeRequirementModal();
});*/
    
// FAQ Accordion
document.querySelectorAll('.faq-question').forEach(button => {
    button.addEventListener('click', () => {
        const faqItem = button.closest('.faq-item');
        const answer = faqItem.querySelector('.faq-answer');
        const icon = button.querySelector('.faq-icon');
        
        // Close all other FAQs
        document.querySelectorAll('.faq-item').forEach(item => {
            if (item !== faqItem) {
                item.querySelector('.faq-answer').classList.add('hidden');
                item.querySelector('.faq-icon').style.transform = 'rotate(0deg)';
            }
        });
        
        // Toggle current FAQ
        answer.classList.toggle('hidden');
        if (answer.classList.contains('hidden')) {
            icon.style.transform = 'rotate(0deg)';
        } else {
            icon.style.transform = 'rotate(180deg)';
        }
    });
});
</script>

<!-- Load GSAP and other libraries asynchronously -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" defer></script>


<script>
(function(){
    /* === Lazy-load reCAPTCHA when user scrolls near forms === */
    var rcLoaded=false;
    function loadRecaptcha(){
        if(rcLoaded)return;rcLoaded=true;
        var s=document.createElement('script');
        s.src='https://www.google.com/recaptcha/api.js';
        s.async=true;s.defer=true;
        document.head.appendChild(s);
    }
    if('IntersectionObserver' in window){
        var io=new IntersectionObserver(function(entries){
            entries.forEach(function(e){if(e.isIntersecting){loadRecaptcha();io.disconnect()}});
        },{rootMargin:'400px'});
        document.querySelectorAll('.g-recaptcha').forEach(function(el){io.observe(el)});
    }else{loadRecaptcha()}

    /* === Form submission — vanilla JS, no jQuery === */
    window.submitContact=function(form,suffix){
        var n=form.name.value.trim(),
            e=form.email.value.trim(),
            m=form.mobile.value.trim(),
            errEl=document.querySelector('.qc-errmsg'+suffix);

        if(!n){alert('Please Enter Name.');form.name.focus();return false}
        if(!m){alert('Please Enter Contact Number.');form.mobile.focus();return false}
        if(!e||!/^[\w.-]+@[\w.-]+\.\w{2,6}$/i.test(e)){alert('Please enter a valid Email address!');form.email.focus();return false}

        var btn=form.querySelector('button[type="submit"]');
        btn.disabled=true;btn.textContent='Submitting...';

        var fd=new FormData(form);
        fetch('postemailusqc.php',{method:'POST',body:fd})
        .then(function(r){return r.text()})
        .then(function(d){
            if(d.trim()==='true'){
                if(errEl){errEl.style.display='none';errEl.innerHTML=''}
                window.location='thankyou.html';
            }else{
                if(errEl){errEl.innerHTML=d;errEl.style.display='block'}
                btn.disabled=false;btn.textContent='Submit Enquiry';
            }
        })
        .catch(function(){
            alert('An error occurred. Please try again.');
            btn.disabled=false;btn.textContent='Submit Enquiry';
        });
        return false;
    };
})();
</script>

