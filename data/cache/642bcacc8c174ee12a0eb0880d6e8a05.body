<!-- Projects Section -->
<section id="projects" class="bg-slate-50 py-16 md:py-24">

  <div class="max-w-7xl mx-auto px-6 md:px-8">
    <div class="text-center mb-16">
      <h2 class="section-title font-playfair font-bold text-2xl md:text-4xl text-slate-800 mb-6">
        Featured New Projects in Goregaon West
      </h2>
      <div class="w-24 h-1 bg-accent-gold mx-auto"></div>

      <p class="text-lg text-gray-700 leading-relaxed text-center mt-6 max-w-4xl mx-auto">
        Goregaon West has emerged as one of Mumbai's fastest-growing residential and investment destinations, driven by excellent connectivity, commercial hubs, premium social infrastructure, and ongoing redevelopment. With strong demand for quality housing, new projects in Goregaon West continue to attract homebuyers, investors, and NRIs alike.
      </p>
    </div>
    
    <div class="projects-grid grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="group bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 border border-slate-200 hover:border-accent-gold/30">
    <div class="relative h-48 overflow-hidden">
        <img src="/photos/th_th34.jpg" alt="Arkade Evoke" width="400" height="300" loading="lazy" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
    </div>
    <div class="relative p-6">
        <h3 class="text-xl font-playfair font-semibold text-slate-800 mb-2">Arkade Evoke</h3>
        <p class="text-gray-600 mb-4 text-sm">By Arkade Group • 2 & 3 BHK Premium Apartments</p>
        <div class="flex items-baseline mb-4">
