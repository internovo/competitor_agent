<!-- Property Modal -->
<div id="propertyModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
  <div class="bg-white rounded-xl p-6 md:p-8 m-4 max-w-lg w-full shadow-2xl max-h-[90vh] overflow-y-auto">
      <!-- Header -->
      <div class="flex justify-between items-center mb-6">
      <h3 class="text-2xl md:text-3xl font-playfair text-slate-900 font-semibold">List Your Property</h3>
      <button onclick="closePropertyModal()" class="text-slate-400 hover:text-slate-900 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      </div>
      
      <!-- Form -->
      <form class="space-y-5" method="post" action="" role="form" id="frmContact3" name="frmContact3" onsubmit="return submitContact(this,3);">
      <p class="qc-errmsg3 text-red-500 text-sm" style="display:none;">&nbsp;</p>
      
      <!-- I am dropdown -->
      <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">I am</label>
          <select id="user_type" name="user_type" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent-gold focus:border-accent-gold transition-all" required>
          <option value="">Select</option>
          <option value="owner">Property Owner</option>
          <option value="builder">Builder/Developer</option>
          <option value="agent">Real Estate Agent</option>
          </select>
      </div>
      
      <!-- Name input -->
      <input type="text" id="name" name="name" placeholder="Your Name" 
          class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent-gold focus:border-accent-gold transition-all" required>
      
      <!-- Mobile input -->
      <input type="tel" id="mobile" name="mobile" placeholder="Mobile Number" 
          class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent-gold focus:border-accent-gold transition-all" required>
      
      <!-- Email input -->
      <input type="email" id="email" name="email" placeholder="Email Address" 
          class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent-gold focus:border-accent-gold transition-all" required>
      
      <!-- Property Type -->
      <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Property Type</label>
          <select id="property_type" name="property_type" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-gray-800 focus:outline-none focus:border-teal-500 focus:bg-white transition-colors" required>
          <option value="">Select Property Type</option>
          <option value="1bhk">1 BHK</option>
          <option value="2bhk">2 BHK</option>
          <option value="3bhk">3 BHK</option>
          <option value="4bhk">4 BHK+</option>
          <option value="commercial">Commercial</option>
          </select>
      </div>
      
      <!-- Location -->
      <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Location</label>
          <select id="location" name="location" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg text-gray-800 focus:outline-none focus:border-teal-500 focus:bg-white transition-colors" required>
          <option value="">Select Location</option>
          <option value="goregaon-west">Goregaon West</option>
          <option value="goregaon-east">Goregaon East</option>
          <option value="nearby">Nearby Areas</option>
          </select>
      </div>
      
      <!-- Property Name -->
      <input type="text" id="property_name" name="property_name" placeholder="Property Name/Project" 
          class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent-gold focus:border-accent-gold transition-all" required>
      
      <!-- Budget -->
      <input type="text" id="budget" name="budget" placeholder="Expected Price" 
          class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent-gold focus:border-accent-gold transition-all" required>
      
      <!-- Description -->
      <textarea id="description" name="description" placeholder="Additional Details (Optional)" rows="3" 
          class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent-gold focus:border-accent-gold transition-all resize-none"></textarea>
      
      <!-- reCAPTCHA -->
      <div class="g-recaptcha w-full mt-6" data-sitekey="6LfP1PUZAAAAAKF5AMWcn2QGUiUmjz_wB8p2rzYY"></div>
      
      <input type="hidden" name="regarding" value="PostProperty">
      
      <!-- Submit Button -->
      <button type="submit" class="w-full bg-accent-gold text-slate-900 px-6 py-4 rounded-lg font-bold text-lg hover:bg-accent-gold-hover transition-all duration-300 shadow-lg hover:shadow-xl">
          Submit Property Details
      </button>
      </form>
  </div>
</div>

<!-- Requirement Modal -->
<div id="requirementModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
  <div class="bg-white rounded-xl p-6 md:p-8 m-4 max-w-lg w-full shadow-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-6">
