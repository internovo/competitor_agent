          class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent-gold focus:border-accent-gold transition-all" required>
      
      <!-- Possession Timeline -->
      <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Possession Timeline</label>
          <select id="possession" name="possession" class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent-gold focus:border-accent-gold transition-all" required>
          <option value="">Select Timeline</option>
          <option value="immediate">Ready to Move</option>
          <option value="6months">Within 6 Months</option>
          <option value="1year">Within 1 Year</option>
          <option value="2years">Within 2 Years</option>
          </select>
      </div>
      
      <!-- Specific Requirements -->
      <textarea id="description2" name="description" placeholder="Specific Requirements (Optional)" rows="3" 
