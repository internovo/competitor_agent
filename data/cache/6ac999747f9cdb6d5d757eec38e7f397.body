ial"},"AmenitiesProps":{"AmenitiesData":[{"icon":"gym","id":49,"name":"Gymnasium"},{"icon":"indoor-games","id":38,"name":"Indoor Games"},{"icon":"jogging","id":57,"name":"Jogging / Cycle Track"},{"icon":"kids-play-areas","id":54,"name":"Kids Play Areas / Sand Pits"},{"icon":"large-green-area","id":34,"name":"Large Green Area"},{"icon":"Senior-Citizen-Sitout","id":88,"name":"Senior citizen Area"},{"icon":"swimming-pool","id":50,"name":"Swimming Pool"},{"icon":"walking-area","id":100,"name":"Walking Area"},{"icon":"yoga-areas","id":56,"name":"Yoga Area"}]},"BrochureProps":{"brochure_url":""},"PaymentPlanDataProps":{"payment_plans":null},"PriceRange":{"Price":""},"BookProperty":{"Banner_id":0,"Banner_image_url":""},"DeveloperInfoProps":{"name":"RNA Corp","logo_url":"https://cdn.blox.xyz/builders/thumb/170223113747-newproject-38.webp","description":"RNA Corp, formerly recognized as RNA Builders (A.A.), stands as a distinguished and accomplished property developer in India, with a rich legacy spanning over three decades. Throughout its journey, the company has delivered superior real estate solutions to both individual and corporate clients, establishing a reputation for excellence. At the heart of RNA Corp's mission is the dedication to fulfilling the diverse needs of its customers. This commitment is reflected in their consistent delivery of projects characterized by exceptional quality, adherence to budgetary constraints, and timely completion. With a proud history of successfully completed residential projects across the Mumbai Metropolitan Region, RNA Developers takes immense pride in its extensive portfolio. This portfolio not only showcases the company's expertise and attention to detail but also underlines its ability to meet the high standards of its clientele. Moreover, RNA Corp remains forward-focused, with several new projects in the pipeline. This forward-thinking approach demonstrates the company's dedication to continuous growth and innovation within the dynamic real estate sector, ensuring a promising future in the industry.","propertyName":"RNA Palazzo"},"PriceFloorPlanProps":{"FloorPlanData":null},"LocalityProps":{"mapProps":{"lat":19.21100653453436,"lng":72.83157519679195,"zoomLevel":15,"markerList":[{"lat":19.21100653453436,"lng":72.83157519679195,"name":"RNA Palazzo","address":"","markerAddress":"RNA Palazzo, Ahead of Dahanukar Wadi, Off M.G.Road, Kandivali West, Mumbai, Maharashtra 400067"}]},"placeTypes":[{"type":"bank","places":[{"name":"SBI Branch Hindustan Naka Kandivli West","numRatings":"","rating":"","distance":"0.1 km","iconName":"","propertyMarker":{"lat":19.21029,"lng":72.83051999999999,"name":"SBI Branch Hindustan Naka Kandivli West","address":"ROCK ENCLAVE, next to Hindustan Naka, opp. Joy Icecream, Kandivali, Sai Nagar, Kandivali West, Mumbai"}},{"name":"SBI Branch Sme Kandivali","numRatings":"","rating":"","distance":"0.5 km","iconName":"","propertyMarker":{"lat":19.2073333,"lng":72.8346396,"name":"SBI Branch Sme Kandivali","address":"Govt Industrial Estate, Plot No 11 AB, Kandivali, Maharashtra Nagar, Kandivali West, Mumbai"}},{"name":"Bank of Baroda ATM","numRatings":"","rating":"","distance":"0.8 km","iconName":"","propertyMarker":{"lat":19.2151653,"lng":72.8256213,"name":"Bank of Baroda ATM","address":"Chamunda Co Op Hsg Soc, Plot 265, Jivdeep CHS, Sec I, Irdp 4, Mumbai"}},{"name":"HDFC Bank","numRatings":"","rating":"","distance":"0.8 km","iconName":"","propertyMarker":{"lat":19.2153011,"lng":72.82596880000001,"name":"HDFC Bank","address":"Shop No 45 to 48, Kesar Residency, next to Bhagwati Restaurant, Jivdeep CHS, Charkop Market, Kandivali West, Mumbai"}},{"name":"Kotak Mahindra Bank","numRatings":"","rating":"","distance":"0.8 km","iconName":"","propertyMarker":{"lat":19.2064608,"lng":72.8379424,"name":"Kotak Mahindra Bank","address":"Shop No.1 Partly, Arkade Bhoomi Heights, Shop No, 2 \u0026 3, Mahatma Gandhi Rd, Dhanukarwadi, Kandivali West, Mumbai"}},{"name":"Kotak Mahindra Bank ATM","n