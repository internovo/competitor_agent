	<script type="text/javascript">
	document.addEventListener("DOMContentLoaded", function () {
        jQuery.getScript("https://js.waybeo.com/v0.1-beta2/waybeo.min.js", function () {
			var trackid = jQuery(".projecttrackid").text();
			if (typeof trackid !== 'undefined' && trackid !== '') {
				Waybeo.DNI.Init({
					"trackid": trackid,
					
				}, waybeoCallBack);
			}	
			else{
				Waybeo.DNI.Init({
                "trackid": '5ebb8be047458',                
				}, waybeoCallBack);
			}
            function waybeoCallBack(trackingNumber) {
                jQuery("#call-loader").hide();
                var mobiletaptocall = "";
                mobiletaptocall = '<span class="call wbCall">Call : ' + trackingNumber + '</span>';
                if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
                    mobiletaptocall = '<div class="tap-to-call-mobile">' +
                            '<span class="call-option">OR CALL</span>' +
                            '<label class="mob-tc-select">Select</label>' +
                            '<div class="num-sel">' +
                            '<a href="tel:' + trackingNumber + '" class="mob-tc-link">' + trackingNumber + '</a>' +
                            '<ul class="add2callmobile" style="display:none;">' +
                            '<li data-value="' + trackingNumber + '" id="call-india"><em>INDIA </em>' + trackingNumber + '</li>' +
                            '</ul>' +
                            '</div>';
                }
                trackingNumber = trackingNumber.replace(/ /g, '');
                //jQuery('.trackid').html('Call : ' + trackingNumber);
				//jQuery('#call').html('<a href="tel:' + trackingNumber + '">Call</a>);
				jQuery('#call').html('<a href="tel:' + trackingNumber + '" class="wcall"> Call </a>');
				if (trackingNumber != "") {
				jQuery('.callsticky').html('<a href="tel:' + trackingNumber + '" class="wcall" onclick="callclick()"> <img src="/themes/lodhanew/images/svg/call.svg" alt="Call" class="img-fluid"> Call </a>');
				}
                if (trackingNumber != "") {
                    jQuery('.mb-wbCall').attr('href', 'tel:' + trackingNumber);
                    //jQuery('a.mb-wbCall').text('Call Us ' + trackingNumber); 
                }

            }
        });
    });
	</script>	
