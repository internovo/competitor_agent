const existingPriceTitle=priceContainer.querySelector('.pForTitle');const existingPriceValue=priceContainer.querySelector('.mainPrice');if(existingPriceTitle){priceContainer.removeChild(existingPriceTitle);}
if(existingPriceValue){priceContainer.removeChild(existingPriceValue);}
