$("#saleDetails").html(flatSales);}else{flatSales+='<div class="col-lg-12 text-center"><p class="flatConfig flatTransactionConfig noRecords"> No Records </p></div>'
$("#saleDetails").html(flatSales);}}else if(listingType=='rent'){$("#rentDetails").html('');if(unitData.hasOwnProperty("flat_transactions_rental")&&unitData.flat_transactions_rental.length>0){unitData.flat_transactions_rental.sort(function compare(a,b){var dateA=new Date(a.registration_date);var dateB=new Date(b.registration_date);return dateB-dateA;});for(let i=0;i<unitData.flat_transactions_rental.length;i++){if(unitData.flat_transactions_rental[i].total_consideration>0){flatSales+=' <div class="d-flex justify-content-between align-items-start pb-3"><h6>Date <br /> <p>'+moment(unitData.flat_transactions_rental[i].registration_date).format('Do MMM YYYY')+'</p></h6><h6>Monthly Rent <p class="revampAgreeValue">'+convertAmount(unitData.flat_transactions_rental[i].total_consideration)+'</p><span class="perSq">Security Deposit '+convertAmount(unitData.flat_transactions_rental[i].ready_reckoner_value)+'</p> </h6></div>';}}
$("#rentDetails").html(flatSales);}else{flatSales+='<div class="col-lg-12 text-center"><p class="flatConfig flatTransactionConfig noRecords"> No Records... </p></div>'
$("#rentDetails").html(flatSales);}}
