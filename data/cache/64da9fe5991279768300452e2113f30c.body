function bankList(index){if(operationType!='rent'){$('.iplLoader').css("visibility","visible");$.ajax({url:'/properties/ajax/fetch-bank-lists',type:'GET',dataType:'json',data:{buidling_id:getStackBuildingId(complex.data[index])},success:function(response){let bankCard=`<div class="bankCardApplyNow bankCard">
<div class="">
<img src="/images/home/Home Loan.svg" alt="Icon">
<h2>Home Loan</h2>
<p>Contact us to get quotes from multiple banks <br /> & choose the one with best interest rate.</p>
<a href="/services/home-loan-deals">Apply now</a>
</div>
</div>`;let finalHTML='';if(response.data.length>0){let bankList='';for(let i=0;i<response.data.length;i++){let imgName=response.data[i].bank_name.toLowerCase().replace(/\s+/g,'_');;bankList+=`<div class="bankCard">
<h5 title="`+response.data[i].bank_name+`" >`+response.data[i].bank_name+`</h5>
<div class="bankCardImg">
<img src="/images/bank_logos/`+imgName+`.jpg" alt="`+response.data[i].bank_name+`" class="img-fluid">
</div>
<h4>`+response.data[i].cnt+`</h4>
<span>Home Loans Disbursed</span>
</div>`;}
if(response.data.length>2){finalHTML='<div class="bankLogoPageMain bankLogoPageMainFlex"><div class="bankLogoPageMainFlexL">'+bankList+'</div>'+bankCard+'</div>';}else if(response.data.length===2){finalHTML='<div class="bankLogoPageMain bankLogoPageMainTwo">'+bankList+''+bankCard+'</div>';}else if(response.data.length===1){finalHTML='<div class="bankLogoPageMain">'+bankList+''+bankCard+'</div>';}else{finalHTML='<div class="bankLogoPageMain">'+bankCard+'</div>';}}else{finalHTML='<div class="onlyApplyNoeCard">'+bankCard+'</div>';}
$('#bankListDiv').html(finalHTML);$('.iplLoader').css("visibility","hidden");},error:function(xhr,status,error){console.log(error);}});}}
function getComplexDetails(index){var rera='';var date='';var startDate='';var startMonth='';var startYear='';var eDate='';var endDate='';var endMonth='';var endYear='';for(let i=0;i<complexData.data[index].rera.length;i++){rera+=" "+"<span class=reraCont><a href='https://maharerait.mahaonline.gov.in/searchlist/search?CertficateNo="+complexData.data[index].rera[i]+"' target='_blank' style='color:#D83A4E;'>"+complexData.data[index].rera[i]+"</a></span><br/>";}
if(typeof(complexData.data[index].rera[0])!="undefined"&&complexData.data[index].rera[0]!=''){$(".revamp_reraCode").show();$("#rera").html(rera);}else{$(".revamp_reraCode").hide();$(".reraCodeWithBuyRentOpt").html('');}
date=typeof(complexData.data[index].launch_date['$date']['$numberLong'])!="undefined"&&complexData.data[index].launch_date['$date']['$numberLong']>0?new Date(Number(complexData.data[index].launch_date['$date']['$numberLong'])):0;$("#startDate").html(date>0?moment(date).format('Do MMM YYYY'):'--');$("#storey").html(complexData.data[index].total_levels);edate=typeof(complexData.data[index].completion_date['$date']['$numberLong'])!="undefined"&&complexData.data[index].completion_date['$date']['$numberLong']>0?new Date(Number(complexData.data[index].completion_date['$date']['$numberLong'])):0;$("#completionDate").html(edate>0?moment(edate).format('Do MMM YYYY'):'--');}
var city='Mumbai';var urlType='sale';var e_type='sales';var urlTo='https://www.indextap.com/search/index?';$.ajax({url:'/properties/ajax/fetch-building-name',type:'GET',data:{buildingIDs:buildingIDs,type:e_type},success:function(response){var buildingNamesArray=response.split(',').map(name=>name.trim());var searchParams=new URLSearchParams();searchParams.append('SearchForm[city]',city);searchParams.append('SearchForm[locality]','');buildingNamesArray.forEach((name,index)=>{searchParams.append('SearchForm[building_name][]',name);});searchParams.append('SearchForm[type]',urlType);searchParams.append('SearchForm[screener]','home_iq_screener');searchParams.append('SearchForm[start_date]','');searchParams.append('SearchForm[end_date]','');searchParams.append('SearchForm[start_area]','');searchParams.append('SearchForm[end_area]','');var searchUrl=urlTo+searchParams.toString();var decodedSearchUrl=decodeURIComponent(encodeURI(searchUrl));var transactionLink='<a href="'+decodedSearchUrl+'" target="_blank">View Transactions </a>';$("#transaction_list_page").attr('href',decodedSearchUrl);},error:function(xhr,status,error){console.log(error);}});}catch(error){console.error(error);}});});
});</script>
<script type="text/javascript">
function openNav(){
document.getElementById("mySidepanel").style.width = "250px";
}
function closeNav() {
document.getElementById("mySidepanel").style.width = "0";
}
</script> </body>
<script>
// $(".openAside").click(function() {
// $(".fixedAside").addClass("show");
// })
$(document).ready(function() {
$(".openAside").click(function(e) {
e.stopPropagation(); // Prevent click event propagation to the document
$(".fixedAside").addClass("show");
});
$("body").click(function(e) {
if (!$(e.target).closest(".fixedAside").length && !$(e.target).hasClass("openAside")) {
$(".fixedAside").removeClass("show");
}
});
});
$(".closeAside").click(function() {
$(".fixedAside").removeClass("show");
})
</script>
