    <style>
        /* Detail Hero */
        .detail-hero { background: var(--gradient); padding: 96px 0 50px; position: relative; overflow: hidden; }
        .detail-hero::before { content:''; position:absolute; inset:0; background:url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=1600&q=60') center/cover no-repeat; opacity:0.12; }
        .detail-hero .container { position: relative; z-index: 2; }
        .proj-title-hero { font-size: clamp(1.6rem,3.5vw,2.4rem); font-weight: 800; color: var(--white); margin-bottom: 8px; }
        .proj-loc-hero { color: rgba(255,255,255,0.72); font-size: 0.92rem; margin-bottom: 18px; display:flex;align-items:center;gap:6px; }
        .proj-loc-hero i { color: var(--accent); }
        .hero-badge-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
        .hbadge { padding: 5px 14px; border-radius: 50px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; }
        .hbadge-green { background: rgba(16,185,129,0.2); border: 1px solid rgba(16,185,129,0.5); color: #6ee7b7; }
        .hbadge-blue { background: rgba(99,102,241,0.2); border: 1px solid rgba(99,102,241,0.5); color: #a5b4fc; }
        .hbadge-gold { background: rgba(232,160,32,0.2); border: 1px solid rgba(232,160,32,0.5); color: #fcd34d; }
        .detail-stat-row { display: flex; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--radius); padding: 16px 24px; gap: 0; flex-wrap: wrap; margin-top: 22px; }
        .dstat { padding: 8px 24px; border-right: 1px solid rgba(255,255,255,0.15); min-width: 120px; }
        .dstat:last-child { border-right: none; }
        .dstat-val { font-size: 1.1rem; font-weight: 800; color: var(--accent); display: block; }
        .dstat-lbl { font-size: 0.68rem; color: rgba(255,255,255,0.58); text-transform: uppercase; letter-spacing: 0.6px; margin-top: 2px; }
        .detail-cta-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }

        /* Sticky Tab Nav */
        .proj-tab-nav { background: var(--white); border-bottom: 2px solid var(--border); position: sticky; top: 66px; z-index: 200; }
        .proj-tab-nav .container { display: flex; gap: 0; overflow-x: auto; scrollbar-width: none; }
        .proj-tab-nav::-webkit-scrollbar { display: none; }
        .ptab { padding: 14px 22px; font-size: 0.82rem; font-weight: 600; color: var(--text-light); border-bottom: 2px solid transparent; cursor: pointer; white-space: nowrap; transition: var(--transition); font-family: 'Poppins',sans-serif; background: none; border-top: none; border-left: none; border-right: none; }
        .ptab:hover { color: var(--primary); }
        .ptab.active { color: var(--primary); border-bottom-color: var(--primary); }

        /* Sections */
        .detail-section { padding: 52px 0; border-bottom: 1px solid var(--border-light); }
        .detail-section:last-child { border-bottom: none; }
        .sec-tag { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--primary-light); background: rgba(26,60,110,0.07); padding: 4px 12px; border-radius: 50px; display: inline-block; margin-bottom: 10px; }

        /* Highlight Cards */
        .highlight-card { background: var(--bg-light); border-radius: var(--radius); padding: 20px; text-align: center; transition: var(--transition); border: 1.5px solid transparent; }
        .highlight-card:hover { border-color: var(--primary-light); background: var(--white); box-shadow: var(--shadow); }
        .highlight-icon { width: 52px; height: 52px; background: linear-gradient(135deg,var(--primary),var(--primary-light)); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; color: var(--white); margin: 0 auto 12px; }
        .highlight-card h6 { font-size: 0.84rem; font-weight: 700; color: var(--dark); margin-bottom: 4px; }
        .highlight-card p { font-size: 0.76rem; color: var(--text-light); margin: 0; line-height: 1.5; }

        /* Price Table */
        .price-tab-btn { padding: 8px 20px; border-radius: 50px; border: 1.5px solid var(--border); background: var(--white); color: var(--text); font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: var(--transition); font-family: 'Poppins',sans-serif; }
        .price-tab-btn.active { background: var(--primary); color: var(--white); border-color: var(--primary); }
        .price-table { width: 100%; border-collapse: collapse; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
        .price-table th { background: var(--primary); color: var(--white); font-weight: 600; font-size: 0.82rem; padding: 13px 16px; text-align: left; }
        .price-table td { font-size: 0.82rem; padding: 12px 16px; vertical-align: middle; color: var(--text); border-bottom: 1px solid var(--border-light); }
        .price-table tr:last-child td { border-bottom: none; }
        .price-table tr:hover td { background: rgba(26,60,110,0.025); }
        .price-tag { font-weight: 700; color: var(--primary); }
        .price-table-note { font-size: 0.75rem; color: var(--text-muted); margin-top: 10px; }

        /* Floor Plan */
        .fp-tab { padding: 8px 18px; border-radius: 50px; border: 1.5px solid var(--border); font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: var(--transition); font-family: 'Poppins',sans-serif; background: var(--white); color: var(--text); }
        .fp-tab.active { background: var(--accent); color: var(--white); border-color: var(--accent); }
        .fp-panel { display: none; }
        .fp-panel.active { display: block; }
        .fp-img-wrap { background: var(--bg-light); border-radius: var(--radius); padding: 24px; text-align: center; border: 1.5px dashed var(--border); }
        .fp-img-wrap img { max-height: 320px; object-fit: contain; margin: 0 auto; }
        .fp-info { background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 20px; }
        .fp-info-row { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid var(--border-light); font-size: 0.83rem; }
        .fp-info-row:last-child { border-bottom: none; }
        .fp-info-row span:first-child { color: var(--text-light); }
        .fp-info-row span:last-child { font-weight: 700; color: var(--dark); }

        /* Amenities */
        .amenity-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
        .amenity-item { display: flex; align-items: center; gap: 10px; background: var(--bg-light); border-radius: 10px; padding: 12px 14px; font-size: 0.8rem; font-weight: 500; color: var(--dark); transition: var(--transition); border: 1.5px solid transparent; }
        .amenity-item:hover { background: var(--white); border-color: var(--primary-light); box-shadow: var(--shadow); }
        .amenity-item i { color: var(--accent); width: 18px; text-align: center; font-size: 1rem; flex-shrink: 0; }

        /* Location */
        .location-table td { font-size: 0.82rem; padding: 10px 14px; border-bottom: 1px solid var(--border-light); }
        .location-table td:first-child { color: var(--text-light); width: 55%; }
        .location-table td:last-child { font-weight: 600; color: var(--dark); }
        .map-placeholder { background: var(--bg-light); border-radius: var(--radius); height: 280px; display: flex; align-items: center; justify-content: center; border: 1.5px dashed var(--border); color: var(--text-muted); flex-direction: column; gap: 10px; }
        .map-placeholder i { font-size: 2rem; color: var(--accent); }

        /* Gallery */
        .gallery-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 200px 200px; gap: 8px; border-radius: var(--radius); overflow: hidden; }
        .gal-main { grid-row: 1 / 3; }
        .gal-item { overflow: hidden; position: relative; cursor: pointer; }
        .gal-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .gal-item:hover img { transform: scale(1.07); }
        .gal-item .gal-overlay { position: absolute; inset: 0; background: rgba(13,27,42,0); transition: var(--transition); display: flex; align-items: center; justify-content: center; }
        .gal-item:hover .gal-overlay { background: rgba(13,27,42,0.4); }
        .gal-more { position: absolute; inset: 0; background: rgba(13,27,42,0.7); display: flex; align-items: center; justify-content: center; color: var(--white); font-size: 1.2rem; font-weight: 700; }

        /* Investment */
        .invest-stat { background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 20px; text-align: center; transition: var(--transition); }
        .invest-stat:hover { border-color: var(--accent); box-shadow: var(--shadow); }
        .invest-stat strong { display: block; font-size: 1.5rem; font-weight: 800; color: var(--accent); margin-bottom: 4px; }
        .invest-stat span { font-size: 0.76rem; color: var(--text-light); }

        /* Sticky Enquiry Sidebar */
        .sticky-form { position: sticky; top: 120px; }

        @media(max-width:991px){ .gallery-grid{grid-template-columns:1fr 1fr;grid-template-rows:repeat(3,180px);} .gal-main{grid-row:auto;} .sticky-form{position:static;} .detail-stat-row{flex-direction:column;gap:10px;} .dstat{border-right:none;padding:6px 0;} }
        @media(max-width:600px){ .gallery-grid{grid-template-columns:1fr 1fr;grid-template-rows:repeat(3,150px);} .amenity-grid{grid-template-columns:1fr 1fr;} }
    </style>
