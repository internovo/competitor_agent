<script src="/js/bootstrap.bundle.min.js"></script>
<script src="/js/jquery-3.6.4.min.js"></script>
<script src="/js/swiper-bundle.min.js"></script>
<script src="/js/script.js"></script>
<script>
/* Tab Navigation */
$('.ptab').on('click', function () {
    $('.ptab').removeClass('active');
    $(this).addClass('active');
    var target = '#' + $(this).data('target');
    if ($(target).length) {
        $('html,body').animate({ scrollTop: $(target).offset().top - 120 }, 400);
    }
});
/* Scroll spy */
$(window).on('scroll', function () {
    var pos = $(this).scrollTop() + 130;
    $('.detail-section').each(function () {
        if ($(this).offset().top <= pos && $(this).offset().top + $(this).outerHeight() > pos) {
            var id = $(this).attr('id');
            if (id) { $('.ptab').removeClass('active'); $('[data-target="'+id+'"]').addClass('active'); }
        }
    });
});
/* Floor Plans */
function showFP(id, btn) {
    $('.fp-panel').removeClass('active'); $('#'+id).addClass('active');
    $('.fp-tab').removeClass('active'); $(btn).addClass('active');
}
/* Price Tabs */
function showPriceTab(type, btn) {
    $('.price-tab-btn').removeClass('active'); $(btn).addClass('active');
}
</script>
