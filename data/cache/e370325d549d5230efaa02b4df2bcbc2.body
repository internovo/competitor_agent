<script type="text/rocketlazyloadscript">
	(function () {
		'use strict';

		document.addEventListener('click', function (event) {

			var adLink = event.target.closest('.sobha-blog-ad-track');

			if (!adLink) {
				return;
			}

			var isMobile = window.matchMedia('(max-width: 767px)').matches;

			var currentImage = isMobile
				? adLink.dataset.adMobileImage
				: adLink.dataset.adDesktopImage;

			var eventData = {
				ad_position: adLink.dataset.adPosition || '',
				ad_source: adLink.dataset.adSource || '',
				ad_image_url: currentImage || '',
				ad_destination_url: adLink.href || '',
				blog_post_id: adLink.dataset.postId || '',
				blog_post_title: adLink.dataset.postTitle || ''
			};

			console.log('Ad clicked:', eventData);

			if (typeof window.gtag === 'function') {
				window.gtag('event', 'blog_ad_click', eventData);

				console.log(
					'GA4 blog_ad_click event sent:',
					eventData
				);
			} else {
				console.warn(
					'Google tag is not available. Event was not sent.',
					eventData
				);
			}
		});
	})();
</script>
