		<script type="text/rocketlazyloadscript">
	document.addEventListener('DOMContentLoaded', function () {
    var openButton = document.querySelector('.js-sbh-search-popup-open');
    var closeButtons = document.querySelectorAll('.js-sbh-search-popup-close');
    var popup = document.getElementById('sbh-search-popup');

    if (!openButton || !popup) {
        return;
    }

    function openPopup(event) {
        event.preventDefault();

        popup.classList.add('is-open');
        popup.setAttribute('aria-hidden', 'false');
        document.body.classList.add('is-sbh-search-popup-open');

        setTimeout(function () {
            var input = popup.querySelector('.js-sobha-blog-search-input');

            if (input) {
                input.focus();
            }
        }, 100);
    }

    function closePopup(event) {
        if (event) {
            event.preventDefault();
        }

        popup.classList.remove('is-open');
        popup.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('is-sbh-search-popup-open');
    }

    openButton.addEventListener('click', openPopup);

    Array.prototype.forEach.call(closeButtons, function (button) {
        button.addEventListener('click', closePopup);
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && popup.classList.contains('is-open')) {
            closePopup(event);
        }
    });

    var searchFields = document.querySelectorAll('.sobha-blog-search-form__field');

    Array.prototype.forEach.call(searchFields, function (field) {
        var input = field.querySelector('.js-sobha-blog-search-input');
        var placeholder = field.querySelector('.js-sobha-search-placeholder');

        if (!input || !placeholder) {
            return;
        }

        function updatePlaceholderState() {
            if (input.value.trim().length > 0) {
                placeholder.classList.add('is-hidden');
            } else {
                placeholder.classList.remove('is-hidden');
            }
        }

        input.addEventListener('input', updatePlaceholderState);
        input.addEventListener('keyup', updatePlaceholderState);
        input.addEventListener('change', updatePlaceholderState);
        input.addEventListener('blur', updatePlaceholderState);

        placeholder.addEventListener('click', function () {
            input.focus();
        });

        updatePlaceholderState();
    });

    var searchChips = document.querySelectorAll('.js-sobha-blog-search-chip');

    Array.prototype.forEach.call(searchChips, function (chip) {
        chip.addEventListener('click', function () {
            var keyword = chip.getAttribute('data-keyword');
            var searchUrl = chip.getAttribute('data-search-url');

            if (!keyword || !searchUrl) {
                return;
            }

            window.location.href = searchUrl + '?blog_keyword=' + encodeURIComponent(keyword);
        });
    });
});
