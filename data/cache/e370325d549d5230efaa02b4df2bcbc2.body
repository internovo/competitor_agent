<style id="wpr-usedcss">.sbh-header{top:0;left:0;width:100%;height:70px!important;background:#fff;transition:all .3s ease;z-index:999;padding:0 40px}.sbh-header.hide{transform:translateY(-100%)}.sbh-header.show{transform:translateY(0);position:fixed;background-color:rgba(19,36,36,.68)}.sbh-header.show .menu-label,.sbh-header.show .sbh-menu-toggle span,.sbh-header.show img{filter:brightness(0) invert(1)}.sbh-header-wrap{max-width:1180px;margin:0 auto;height:100%;display:flex;align-items:center;justify-content:space-between;position:relative}.sbh-menu-col{display:flex;align-items:center;justify-content:center;gap:6px}.sbh-menu-col>span{color:#000;font-size:15px;cursor:pointer}.sbh-menu-toggle{flex-direction:column;justify-content:center;border:none;background:0 0;padding:0}.sbh-menu-toggle span{width:18px;height:2px;background:#000;display:block}.sbh-logo-col,.sbh-menu-col,.sbh-search-col{display:flex;align-items:center}.sbh-logo-col{text-align:center;position:absolute;left:50%;transform:translateX(-50%)}.sbh-search-col{text-align:right}.sbh-logo-col img{max-width:120px}.sbh-menu-toggle{background:0 0;border:0;cursor:pointer;padding:0}.sbh-menu-toggle span{display:block;width:26px;height:2px;background:#000;margin:6px 0}.sbh-side-menu{position:fixed;top:0;left:-350px;width:350px;height:100vh;background:#111;z-index:1001;transition:all .4s ease}.second-navigation{position:fixed;left:380px;top:0;width:380px;height:100vh;background:#000;transform:translateX(100%);opacity:0;transition:all .9s ease;pointer-events:none}.second-navigation.active{transform:translateX(0);opacity:1;pointer-events:auto;display:block}.sbh-side-menu{background:#efefef}.second-navigation{background:#000;color:#fff}.second-navigation a{color:#ccc;font-size:15px}.second-navigation a:hover{color:#fff}.sbh-menu-toggle span:first-child{width:17px}.sbh-menu-toggle span:nth-child(2){width:30px}.sbh-menu-toggle span:nth-child(3){width:15px;margin-left:auto;margin-bottom:0}.sbh-arrow{transition:transform .3