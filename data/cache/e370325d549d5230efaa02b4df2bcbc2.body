<style></style>
<script type="text/rocketlazyloadscript">
    document.addEventListener('DOMContentLoaded', function () {
    var sliders = document.querySelectorAll('.js-sobha-single-related-slider');

    Array.prototype.forEach.call(sliders, function (slider) {
        var track = slider.querySelector('.sobha-single-related-slider__track');
        var cards = slider.querySelectorAll('.sobha-single-related-card');
        var prevButton = slider.querySelector('.sobha-single-related-slider__arrow--prev');
        var nextButton = slider.querySelector('.sobha-single-related-slider__arrow--next');
        var dotsContainer = slider.querySelector('.sobha-single-related-slider__dots');

        if (!track || cards.length === 0 || !dotsContainer) {
            return;
        }

        var currentIndex = 0;

        function isMobile() {
            return window.innerWidth <= 767;
        }

        function getMaxIndex() {
            var maxIndex = cards.length - 1;

            if (maxIndex < 0) {
                maxIndex = 0;
            }

            return maxIndex;
        }

        function updateArrowState() {
            var maxIndex = getMaxIndex();

            if (!isMobile()) {
                return;
            }

            if (prevButton) {
                if (currentIndex <= 0 || maxIndex <= 0) {
                    prevButton.disabled = true;
                    prevButton.classList.add('is-disabled');
                } else {
                    prevButton.disabled = false;
                    prevButton.classList.remove('is-disabled');
                }
            }

            if (nextButton) {
                if (currentIndex >= maxIndex || maxIndex <= 0) {
                    nextButton.disabled = true;
                    nextButton.classList.add('is-disabled');
                } else {
                    nextButton.disabled = false;
                    nextButton.classList.remove('is-disabled');
                }
            }
        }

        function buildDots() {
            var maxIndex = getMaxIndex();
            var dotIndex;

            dotsContainer.innerHTML = '';

            if (!isMobile()) {
                return;
            }

            for (dotIndex = 0; dotIndex <= maxIndex; dotIndex++) {
                var dot = document.createElement('button');
                dot.type = 'button';
                dot.className = 'sobha-single-related-slider__dot';
                dot.setAttribute('aria-label', 'Go to related post ' + (dotIndex + 1));

                (function (index) {
                    dot.addEventListener('click', function () {
                        currentIndex = index;
                        updateSlider();
                    });
                })(dotIndex);

                dotsContainer.appendChild(dot);
            }
        }

        function updateDots() {
            var dots = dotsContainer.querySelectorAll('.sobha-single-related-slider__dot');

            Array.prototype.forEach.call(dots, function (dot, index) {
                if (index === currentIndex) {
                    dot.classList.add('is-active');
                } else {
                    dot.classList.remove('is-active');
                }
            });
        }

        function updateSlider() {
            if (!isMobile()) {
                currentIndex = 0;
                track.style.transform = '';
                dotsContainer.innerHTML = '';

                if (prevButton) {
                    prevButton.disabled = false;
                    prevButton.classList.remove('is-disabled');
                }

                if (nextButton) {
                    nextButton.disabled = false;
                    nextButton.classList.remove('is-disabled');
                }

                return;
            }

            if (currentIndex > getMaxIndex()) {
                currentIndex = getMaxIndex();
            }

            if (currentIndex < 0) {
                currentIndex = 0;
            }

            track.style.transform = 'translateX(-' + cards[currentIndex].offsetLeft + 'px)';

            updateDots();
            updateArrowState();
        }

        function goToNextSlide() {
            if (!isMobile()) {
                return;
            }

            if (currentIndex >= getMaxIndex()) {
                return;
            }

            currentIndex++;
            updateSlider();
        }

        function goToPrevSlide() {
            if (!isMobile()) {
                return;
            }

            if (currentIndex <= 0) {
                return;
            }

            currentIndex--;
            updateSlider();
        }

        if (nextButton) {
            nextButton.addEventListener('click', goToNextSlide);
        }

        if (prevButton) {
            prevButton.addEventListener('click', goToPrevSlide);
        }

        window.addEventListener('resize', function () {
            buildDots();
            updateSlider();
        });

        buildDots();
        updateSlider();
    });
});
</script>
                    </article>

                    
