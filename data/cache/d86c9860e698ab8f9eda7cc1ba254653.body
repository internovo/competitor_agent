le="height:auto;width:100%" data-testid="blox-card"><div class="CardHeader_CardHeaderCtn__mGuOf CardHeader_Card-Text-20__QQqX5 FAQCard_cardHeadingCls__4XVWK  squarebx rightPos" data-testid="card-header"><div class="CardHeader_CardHeaderTitle__GzXgr CardHeader_CardHeaderTitlePrimary__vjpXN gheader"><h2 class="text_Htitle__vsNcm CardHeader_Card-Text-20__QQqX5 FAQCard_cardHeading__Y4AcV"><div class="undefined  " data-testid="text-custom">Frequently Asked Questions</div></h2></div></div><div class="Accordian_accordion__RA0cu FAQCard_faqaccordian__mHVRX"><div class="Accordian_accordionTitle__aUov_ FAQCard_title__Dcjuh Accordian_accordionBorderWeb__oM0ZX  FAQCard_closedAcc__v_xws"><div class="Accordian_titleWrapper__y5bxu"><h3 class="text_Htitle__vsNcm FAQCard_FAQTextDesktop__fUtXz"><div class="undefined  text_text-16px__yyDjQ" data-testid="text-custom">When is the possession date for Satra One?</div></h3></div><div class="Accordian_imageWrapper__BrwaT FAQCard_iconbackground__NBD3A Accordian_LightWrapper__Pja0h "><img alt="arrow-down-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="16" height="16" data-nimg="1" class="" style="color:transparent" src="/assets/icons/arrow-down-secondary.svg"/></div></div><div class="Accordian_accordionContent__lzyb_ FAQCard_accordianContent__ZY7na undefined"><div class="FAQCard_FAQTextDesktop__fUtXz">Possession date of Satra One is 31 Dec 2024</div></div></div><div class="Accordian_accordion__RA0cu FAQCard_faqaccordian__mHVRX"><div class="Accordian_accordionTitle__aUov_ FAQCard_title__Dcjuh Accordian_accordionBorderWeb__oM0ZX  FAQCard_closedAcc__v_xws"><div class="Accordian_titleWrapper__y5bxu"><h3 class="text_Htitle__vsNcm FAQCard_FAQTextDesktop__fUtXz"><div class="undefined  text_text-16px__yyDjQ" data-testid="text-custom">What is the RERA carpet area range of Satra One?</div></h3></div><div class="Accordian_imageWrapper__BrwaT FAQCard_iconbackground__NBD3A Accordian_LightWrapper__Pja0h "><img alt="arrow-down-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="16" height="16" data-nimg="1" class="" style="color:transparent" src="/assets/icons/arrow-down-secondary.svg"/></div></div><div class="Accordian_accordionContent__lzyb_ FAQCard_accordianContent__ZY7na undefined"><div class="FAQCard_FAQTextDesktop__fUtXz">The RERA carpet area range for Satra One is 445 - 701 sqft</div></div></div><div class="Accordian_accordion__RA0cu FAQCard_faqaccordian__mHVRX"><div class="Accordian_accordionTitle__aUov_ FAQCard_title__Dcjuh Accordian_accordionBorderWeb__oM0ZX  FAQCard_closedAcc__v_xws"><div class="Accordian_titleWrapper__y5bxu"><h3 class="text_Htitle__vsNcm FAQCard_FAQTextDesktop__fUtXz"><div class="undefined  text_text-16px__yyDjQ" data-testid="text-custom">What is the price range of Satra One?</div></h3></div><div class="Accordian_imageWrapper__BrwaT FAQCard_iconbackground__NBD3A Accordian_LightWrapper__Pja0h "><img alt="arrow-down-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="16" height="16" data-nimg="1" class="" style="color:transparent" src="/assets/icons/arrow-down-secondary.svg"/></div></div><div class="Accordian_accordionContent__lzyb_ FAQCard_accordianContent__ZY7na undefined"><div class="FAQCard_FAQTextDesktop__fUtXz">The price range of Satra One is ₹98 Lacs - 1.54 Cr</div></div></div><div class="Accordian_accordion__RA0cu FAQCard_faqaccordian__mHVRX"><div class="Accordian_accordionTitle__aUov_ FAQCard_title__Dcjuh Accordian_accordionBorderWeb__oM0ZX  FAQCard_closedAcc__v_xws"><div class="Accordian_titleWrapper__y5bxu"><h3 class="text_Htitle__vsNcm FAQCard_FAQTextDesktop__fUtXz"><div class="undefined  text_text-16px__yyDjQ" data-testid="text-custom">Where is Satra One located?</div></h3></div><div class="Accordian_imageWrapper__BrwaT FAQCard_iconbackground__NBD3A Accordian_LightWrapper__Pja0h "><img alt="arrow-down-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="16" height="16" data-nimg="1" class="" style="color:transparent" src="/assets/icons/arrow-down-secondary.svg"/></div></div><div class="Accordian_accordionContent__lzyb_ FAQCard_accordianContent__ZY7na undefined"><div class="FAQCard_FAQTextDesktop__fUtXz">Satra One is located at Satra One, Road Number 2, New, opp. Guru Nanak Park, Shastri Nagar, Goregaon West, Mumbai, Maharashtra 400104.</div></div></div><div class="Accordian_accordion__RA0cu FAQCard_faqaccordian__mHVRX"><div class="Accordian_accordionTitle__aUov_ FAQCard_title__Dcjuh Accordian_accordionBorderWeb__oM0ZX  FAQCard_closedAcc__v_xws"><div class="Accordian_titleWrapper__y5bxu"><h3 class="text_Htitle__vsNcm FAQCard_FAQTextDesktop__fUtXz"><div class="undefined  text_text-16px__yyDjQ" data-testid="text-custom">What configurations are available in Satra One?</div></h3></div><div class="Accordian_imageWrapper__BrwaT FAQCard_iconbackground__NBD3A Accordian_LightWrapper__Pja0h "><img alt="arrow-down-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="16" height="16" data-nimg="1" class="" style="color:transparent" src="/assets/icons/arrow-down-secondary.svg"/></div></div><div class="Accordian_accordionContent__lzyb_ FAQCard_accordianContent__ZY7na undefined"><div class="FAQCard_FAQTextDesktop__fUtXz">Satra One has 1 BHK, 2 BHK configurations.</div></div></div><div class="Accordian_accordion__RA0cu FAQCard_faqaccordian__mHVRX"><div class="Accordian_accordionTitle__aUov_ FAQCard_title__Dcjuh Accordian_accordionBorderWeb__oM0ZX  FAQCard_closedAcc__v_xws"><div class="Accordian_titleWrapper__y5bxu"><h3 class="text_Htitle__vsNcm FAQCard_FAQTextDesktop__fUtXz"><div class="undefined  text_text-16px__yyDjQ" data-testid="text-custom">What is the status of Satra One?</div></h3></div><div class="Accordian_imageWrapper__BrwaT FAQCard_iconbackground__NBD3A Accordian_LightWrapper__Pja0h "><img alt="arrow-down-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="16" height="16" data-nimg="1" class="" style="color:transparent" src="/assets/icons/arrow-down-secondary.svg"/></div></div><div class="Accordian_accordionContent__lzyb_ FAQCard_accordianContent__ZY7na undefined"><div class="FAQCard_FAQTextDesktop__fUtXz">The status of Satra One is Ready to move.</div></div></div><div class="Accordian_accordion__RA0cu FAQCard_faqaccordian__mHVRX"><div class="Accordian_accordionTitle__aUov_ FAQCard_title__Dcjuh Accordian_accordionBorderWeb__oM0ZX  FAQCard_closedAcc__v_xws"><div class="Accordian_titleWrapper__y5bxu"><h3 class="text_Htitle__vsNcm FAQCard_FAQTextDesktop__fUtXz"><div class="undefined  text_text-16px__yyDjQ" data-testid="text-custom">Which amenities are provided in Satra One?</div></h3></div><div class="Accordian_imageWrapper__BrwaT FAQCard_iconbackground__NBD3A Accordian_LightWrapper__Pja0h "><img alt="arrow-down-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="16" height="16" data-nimg="1" class="" style="color:transparent" src="/assets/icons/arrow-down-secondary.svg"/></div></div><div class="Accordian_accordionContent__lzyb_ FAQCard_accordianContent__ZY7na undefined"><div class="FAQCard_FAQTextDesktop__fUtXz">The amenities are Car Parking Space, Entrance Lobby, Gymnasium, Indoor Games, Intercom Facility, Jogging / Cycle Track, Kids Play Areas / Sand Pits, Large Green Area, Luxurious Clubhouse, Party Lawn, Senior citizen Area, Swimming Pool, Walking Area.</div></div></div><div class="Accordian_accordion__RA0cu FAQCard_faqaccordian__mHVRX"><div class="Accordian_accordionTitle__aUov_ FAQCard_title__Dcjuh Accordian_accordionBorderWeb__oM0ZX  FAQCard_closedAcc__v_xws"><div class="Accordian_titleWrapper__y5bxu"><h3 class="text_Htitle__vsNcm FAQCard_FAQTextDesktop__fUtXz"><div class="undefined  text_text-16px__yyDjQ" data-testid="text-custom">Who is the developer of Satra One?</div></h3></div><div class="Accordian_imageWrapper__BrwaT FAQCard_iconbackground__NBD3A Accordian_LightWrapper__Pja0h "><img alt="arrow-down-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="16" height="16" data-nimg="1" class="" style="color:transparent" src="/assets/icons/arrow-down-secondary.svg"/></div></div><div class="Accordian_accordionContent__lzyb_ FAQCard_accordianContent__ZY7na undefined"><div class="FAQCard_FAQTextDesktop__fUtXz">The developer of Satra One is Satra Group.</div></div></div></div></section><section id="Developer"><div class="DeveloperInfo_DevInfo__z4GBW DeveloperInfo_Darktheme__ON7C5" data-testid="blox-DeveloperInfo"><h2 class="text_Htitle__vsNcm DeveloperInfo_cardHeading__SkJEX squarebx"><div class="undefined  text_desktop-heading-3__6qV5j" data-testid="text-custom">About The Developer</div></h2><div class="GridCont_gridCont__rn4P3  GridCont_row__HRG7b GridCont_center__7YNM7" style="grid-gap:20px;justify-content:flex-start"><div class="DeveloperInfo_DevlogoBox__pRcPe"><img alt="Developer for Satra One:Satra Group" loading="lazy" width="50" height="50" decoding="async" data-nimg="1" class="DeveloperInfo_DevLogo__mXnC6" style="color:transparent" src="https://cdn.blox.xyz/builders/thumb/270422102015-satra.png"/></div><h2 class="text_Htitle__vsNcm DeveloperInfo_cardHeading__SkJEX"><div class="undefined  text_desktop-heading-4__YAMBJ" data-testid="text-custom">Satra Group</div></h2></div><div class="undefined DeveloperInfo_DevText__0bBIr text_text-14px__aPnkg" data-testid="text-custom">Satra Group is a construction company based in Mumbai city. The builder has been building flats with 2BHK and 3BHK units that are well-ventilated. The team has been growing under the guidance of Mr. Praful Satra. Satra Group aims to achieve excellence and growth by creating world-class infrastructure. They have been building homes with the highest standard of professionalism, quality customer service. Some of the developed flats are Satra Mahavir Ville, Satra Juhu Residency, Satra Rehana Heights, Satra Harmony.</div></div></section><div data-testid="same-area-prop-ctn"><div class="SameAreaProperties_SameAreaPropertiesCtn__qfNU_ Card_primary__IiLET Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="CardHeader_CardHeaderCtn__mGuOf CardHeader_Card-Text-20__QQqX5 SameAreaProperties_CardHeader__EDw78" data-testid="card-header"><div class="CardHeader_CardHeaderTitle__GzXgr CardHeader_CardHeaderTitleSecondary__w6GWM gheader"><h2 class="text_Htitle__vsNcm CardHeader_Card-Text-20__QQqX5 "><div class="undefined  " data-testid="text-custom">Properties In The Same Area</div></h2></div><div class="CardHeader_CardIconCtn__IwxSE "><img alt="bloxsquare" decoding="async" data-testid="next-image-ctn" loading="lazy" width="16" height="16" data-nimg="1" class="" style="color:transparent" src="/assets/icons/bloxsquare.svg"/></div></div><div><div class="swiper Swiper_SwiperCtn__bi0fK SameAreaProperties_SwiperClass__tmPO8"><div class="swiper-wrapper"><div class="swiper-slide Swiper_SwiperSlide__BWsJ2 SameAreaProperties_SwiperSliderClassName__IpLlP"><div class=" PropertyCard_PropertyCardCtn__yVyLN " data-testid="propertycard-ctn" style="width:296px;height:480px"><a class="HiddenLinksSEO" href="/projects/narang-valora"></a><img alt="Property-Image" decoding="async" data-testid="next-image-ctn" loading="lazy" data-nimg="fill" class=" PropertyCard_PropertyCardImage__9Zvsn" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://cdn.blox.xyz/projects-2x/narang-realty-narang-valora-elevation-1785928992.webp"/><div class="PropertyCard_PropertyDataCtn__eihK5 PropertyCard_PropertyDataCtnLg__4_AmE  " style="width:296px;height:480px"><div class="PropertyCard_PropertyImageCtn__V1lpj"><div class="PropertyCard_PropertyImageInnerCtn__NAVvP"><img alt="Narang Valora" decoding="async" data-testid="next-image-ctn" loading="lazy" width="64" height="64" data-nimg="1" class="PropertyCard_PropertyImage__9K7gM" style="color:transparent" src="https://cdn.blox.xyz/builders/thumb/050826044134-logo-dvk