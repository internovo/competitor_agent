pe\":\"ListItem\",\"position\":1,\"name\":\"Mumbai\",\"item\":\"https://blox.xyz/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Properties in Mumbai\",\"item\":\"https://blox.xyz/buy/mumbai/1a256\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Properties in Goregaon West\",\"item\":\"https://blox.xyz/buy/mumbai/goregaon-west-1a256b7a58\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Satra Group\",\"item\":\"https://blox.xyz/buy/mumbai/goregaon-west-satra-group-1a256b7a58b13a365\"},{\"@type\":\"ListItem\",\"position\":5,\"name\":\"Satra One\",\"item\":\"https://blox.xyz/projects/satra-one\"}]\n}","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\"@type\":\"Question\",\"name\":\"When is the possession date for Satra One?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Possession date of Satra One is 31 Dec 2024\"}},{\"@type\":\"Question\",\"name\":\"What is the RERA carpet area range of Satra One?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The RERA carpet area range for Satra One is 445 - 701 sqft\"}},{\"@type\":\"Question\",\"name\":\"What is the price range of Satra One?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The price range of Satra One is ₹98 Lacs - 1.54 Cr\"}},{\"@type\":\"Question\",\"name\":\"Where is Satra One located?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Satra One is located at Satra One, Road Number 2, New, opp. Guru Nanak Park, Shastri Nagar, Goregaon West, Mumbai, Maharashtra 400104.\"}},{\"@type\":\"Question\",\"name\":\"What configurations are available in Satra One?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Satra One has 1 BHK, 2 BHK configurations.\"}},{\"@type\":\"Question\",\"name\":\"What is the status of Satra One?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The status of Satra One is Ready to move.\"}},{\"@type\":\"Question\",\"name\":\"Which amenities are provided in Satra One?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The amenities are Car Parking Space, Entrance Lobby, Gymnasium, Indoor Games, Intercom Facility, Jogging / Cycle Track, Kids Play Areas / Sand Pits, Large Green Area, Luxurious Clubhouse, Party Lawn, Senior citizen Area, Swimming Pool, Walking Area.\"}},{\"@type\":\"Question\",\"name\":\"Who is the developer of Satra One?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The developer of Satra One is Satra Group.\"}}]\n}\n","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"Satra One\",\n  \"image\": \"https://cdn.blox.xyz/builders/thumb/270422102015-satra.png\",\n  \"description\": \"Satra One is a premium residential project by Satra Group, located in the lively suburb of Goregaon West, Mumbai. It offers thoughtfully designed 1 and 2 BHK garden-facing homes with private balconies, allowing you to enjoy sunlit mornings and refreshing evenings. Nestled close to nature yet centrally connected, this project blends the tranquility of green surroundings with lifestyle-enhancing features. Whether it’s relaxing in landscaped gardens or accessing modern amenities, Satra One creates the perfect environment for your family’s future.\",\n  \"brand\": {\n\t\t\"@type\": \"Brand\",\n\t\t\"name\": \"Satra Group\"\n\t},\n  \"offers\": {\n\t\t\"@type\": \"AggregateOffer\",\n    \"url\": \"https://blox.xyz/projects/satra-one\",\n\t\t\"priceCurrency\": \"INR\",\n\t\t\"lowPrice\": \"9799790.00\",\n\t\t\"highPrice\": \"15437422.00\"\n\t}\n}\n","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": [\n      \"SingleFamilyResidence\",\n      \"Product\",\n      \"RealEstateListing\"\n  ],\n  \"@id\": \"https://blox.xyz/projects/satra-one\",\n  \"mpn\": \"P51800032891\",\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"@id\": \"https://blox.xyz/buy/mumbai/satra-group-1a256b13a365\",\n    \"name\": \"Satra Group\"\n  },\n  \"url\": \"https://blox.xyz/projects/satra-one\",\n  \"containedInPlace\": {\n      \"@type\": \"Place\",\