    	const closeButton = document.getElementById('close-popup');

    // Intersection Observer to detect when the target area is in view
    	const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
	if (entry.isIntersecting) {
		var nocheck=localStorage.getItem("popCloseVastu");
		if(nocheck!=2){
			popup.style.display = 'block'
		};
            }
        });
    }, {
        root: null, // Uses the viewport as the root
        threshold: 0.5 // Trigger when 50% of the target is visible
    });

    observer.observe(targetArea);

    // Close popup functionality
    closeButton.addEventListener('click', () => {
    localStorage.setItem("popCloseVastu",2);
    popup.style.display = 'none';
    var popCloseVastu = localStorage.getItem("popCloseVastu");
   
    location.reload();
    });

    // Event listeners for buttons (customize as needed)
    document.getElementById('btn1').addEventListener('click', () => {

    	localStorage.setItem("show_vastu",2);
	
   	 setCookie('popCloseVastu','2', 30);
	setSessionInLaravel('2');		
		
  	  mobileLogin();

	 popup.style.display = 'none';
       
    });

    document.getElementById('btn2').addEventListener('click', () => {
     
