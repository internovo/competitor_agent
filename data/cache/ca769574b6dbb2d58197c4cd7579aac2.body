    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;

    /* Style the X */
    font-size: 40px;
    font-weight: 300;
    color: #333;
    background: transparent;
    transition: all 0.2s ease;
}

.pop-mod-close:hover {
    background-color: rgba(0, 0, 0, 0.05); /* Light gray circle on hover */
