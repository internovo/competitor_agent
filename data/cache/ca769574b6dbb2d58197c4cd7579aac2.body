//gst attachment
$('#gst_attachment').on('change', function () {
  const file = this.files[0];
  const errorSpan = $('#gst_attachment-error');

  errorSpan.hide().text(''); 

  const allowedTypes = ['image/jpeg', 'image/png', 'image/jpg', 'application/pdf'];
  const maxSize = 5 * 1024 * 1024;

  if (!allowedTypes.includes(file.type)) {
    errorSpan.text('* Only JPG, PNG, and PDF files are allowed.').show();
    $(this).val('');
    return;
  }

  if (file.size > maxSize) {
    errorSpan.text('* File must be smaller than 5MB.').show();
    $(this).val('');
    return;
  }

  // File is valid
  console.log('Selected file:', file.name);
});
