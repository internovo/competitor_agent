     Auto-plays muted on page load Â· fixed bottom-right
     Does NOT block page content
     ============================================================ -->
<div class="cvw" id="cvw" aria-label="Video tour widget">

  <!-- The video card -->
  <div class="cvw-card" id="cvwCard">

    <!-- Close Ã— -->
    <button class="cvw-close" id="cvwClose" aria-label="Close video">&#10005;</button>

    <!-- 9:16 iframe â€” injected on Click (Lazy Load) -->
    <div class="cvw-frame" id="cvwFrame">
        <img id="cvwThumb" src="https://i.ytimg.com/vi/Fl7Nom1hrKY/hqdefault.jpg" style="position: absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; cursor:pointer;" alt="Video Thumbnail">
        <div id="cvwPlayBtn" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); cursor:pointer; background: rgba(0,0,0,0.7); border-radius: 50%; width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; z-index: 2;">
             <svg viewBox="0 0 10 10" width="20" height="20" style="margin-left: 3px;"><path d="M2 1l7 4-7 4V1z" fill="#fff"/></svg>
        </div>
    </div>

    <!-- Bottom bar: mute + badge -->
    <div class="cvw-bar">
      <button class="cvw-mute" id="cvwMute" aria-label="Toggle sound">
        <!-- Muted (default) -->
        <svg class="ic-m" viewBox="0 0 24 24">
          <path d="M11 5L6 9H2v6h4l5 4V5z"/>
          <line x1="23" y1="9" x2="17" y2="15"/>
          <line x1="17" y1="9" x2="23" y2="15"/>
        </svg>
        <!-- Sound on -->
        <svg class="ic-s" viewBox="0 0 24 24">
          <path d="M11 5L6 9H2v6h4l5 4V5z"/>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
        </svg>
        <span id="cvwMuteLabel">🔇 Unmute</span>
      </button>
      <span class="cvw-badge">Video Tour</span>
    </div>

  </div>

  <!-- Reopen pill â€” shown after user closes the widget -->
  <button class="cvw-reopen" id="cvwReopen" aria-label="Reopen video">
    <span class="play-dot">
      <svg viewBox="0 0 10 10"><path d="M2 1l7 4-7 4V1z" fill="#1f2937"/></svg>
    </span>
    Watch Tour
  </button>

</div>

