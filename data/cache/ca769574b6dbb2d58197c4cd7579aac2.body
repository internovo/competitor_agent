                },

                body: JSON.stringify({
                    "_token": "EhjEWquIJf6A7d44WIYVJPJS8fzPpDV03a3ve0Vl",
                    request_type: 'user_auth',
                    credential: response.credential
                }),

            })

            .then(response => response.json())

            .then(resp => {

                console.log(resp);

                if (resp.data.token) {

                    localStorage.setItem("bearer", resp.data.token);

                    localStorage.setItem("user_id", resp.data.user_details.id);

                    localStorage.setItem("userData", JSON.stringify(resp.data.user_details));

                    let packageName = localStorage.getItem('package-name');
                    if(packageName != null && packageName != 'undefined'){
                    window.location.href= "https://huntvastuhomes.com/b2b-signup";
                    }
                    else{
                    window.location.reload();
                    }

                }
                else{
                    $('#MobileOtpSend button[type=button], #loginuser button[type=button]').html(`Send OTP`);
                }

            })

            .catch(console.error);

    }


    function openModal(type) {

        if (type == 'login') {
            $('#mobileLogin').modal('hide');
            $('#login').modal('show');

            $('#register').modal('hide');
            $('#register').css('opacity', 'none');

        }

        if (type == 'register') {
            $('#mobileLogin').modal('hide');
            $('#register').modal('show');

            $('#login').modal('hide');
            $('#login').css('opacity', 'none');

        }

    }

    function mobileLogin(name,price){   
    let dealerUrl = window.location.href;
    if(dealerUrl == "https://huntvastuhomes.com/bulkpackages"){
        localStorage.setItem('package-name', name);
        localStorage.setItem('package-price', price);
    }
        $('#login').modal('hide');
        $('#mobileLogin').modal('show');
    }
</script>







<script>
    // /253701014442340

    window.fbAsyncInit = function() {

        // FB JavaScript SDK configuration and setup

        FB.init({

            appId: "1652584445480403", // FB App ID

            cookie: true, // enable cookies to allow the server to access the session

            xfbml: true, // parse social plugins on this page

            version: 'v19.0' // use graph api version 2.8

        });

    };



    // Load the JavaScript SDK asynchronously

    (function(d, s, id) {

        var js, fjs = d.getElementsByTagName(s)[0];

        if (d.getElementById(id)) return;

        js = d.createElement(s);

        js.id = id;

        js.src = "//connect.facebook.net/en_US/sdk.js";

        fjs.parentNode.insertBefore(js, fjs);

    }(document, 'script', 'facebook-jssdk'));



    // Facebook login with JavaScript SDK

    function fbLogin() {
        $('#MobileOtpSend button[type=button], #loginuser button[type=button]').html(`<img class="submittingMessage" src="https://huntvastuhomes.com/img/ZZ5H.gif" alt="Loading..." width="20" style="vertical-align: middle;">
    Processing...`);

        FB.login(function(response) {

            console.log(response);

            if (response.authResponse) {

                // Get and display the user profile data

                getFbUserData();

            } else {
                 $('#MobileOtpSend button[type=button], #loginuser button[type=button]').html(`Send OTP`);

                document.getElementById('status').innerHTML =

                    'User cancelled login or did not fully authorize.';

            }

        }, {

            scope: 'email'

        });

    }



    // Fetch the user profile data from facebook

    function getFbUserData() {

        FB.api('/me', {

                locale: 'en_US',

                fields: 'id,first_name,last_name,email,link,gender,locale,picture'

            },

            function(response) {

                console.log(response);

                var csrfToken = $('meta[name="csrf-token"]').attr('content');

                var data = {

                    "_token": csrfToken,

                    facebook_id: response.id,

                    first_name: response.first_name,

                    last_name: response.last_name,

                    email: response.email,

                    phone: response.phone,

                    social_type: 'facebook',

                    picture: response.picture,

                    gender: response.gender

                };

                $.ajax({

                    type: 'POST',

                    url: "https://huntvastuhomes.com/login/facebook",

                    contentType: 'application/json',

                    data: JSON.stringify(data),

                    success: function(resp) {

                        if (resp.data.token) {

                            let packageName = localStorage.getItem('package-name');
                            if(packageName != null && packageName != 'undefined'){
                            window.location.href= "https://huntvastuhomes.com/b2b-signup";
                            }
                            else{
                            window.location.reload();
                            }

                        }

                    },

                    error: function(error) {


                    }

                });

            });

    }
</script>
<script>
    $(document).ready(function() {

        $('.logoutButton').click(function() {

            var currentPageUrl = window.location.href; // Get the current page URL

            // alert(currentPageUrl);

            $.ajax({

                url: 'https://huntvastuhomes.com/logout',
                type: 'GET',

                data: {
                    current_page: currentPageUrl
                }, // Include the current page URL as a parameter

                success: function(response) {

                    // alert('Logout successful');
                    window.location.reload() // Redirect back to current page

                },

                error: function(xhr, status, error) {
                    alert('Logout failed: ' + xhr.responseText);

                }

            });

        });

    });

    var apiUrl = "https://api.huntvastuhomes.com";
    var baseUrl = window.location.origin;
    var debounceTimer;
    var searchResultsVisible = false;

    $(document).ready(function() {
        var searchInput = $('#searchInput');
        var searchResults = $('#searchResults');

        function performSearch() {
            var searchQuery = searchInput.val().trim();
            if (searchQuery === '') {
                hideSearchResults();
                return;
            }

            $.ajax({
                url: apiUrl + '/api/search',
                method: 'GET',
                data: {
                    location: searchQuery
                },
                success: function(data) {
                    displaySearchResults(data.properties);
                    searchResultsVisible = true;
                },
                error: function(error) {
                    console.error('Error fetching data:', error);
                    hideSearchResults();
                }
            });
        }

        function hideSearchResults() {
            searchResults.empty();
            searchResultsVisible = false;
        }

        function displaySearchResults(data) {
            searchResults.empty();
            var hasResults = false;
            for (var category in data) {
                if (data[category].length > 0) {
                    data[category].forEach(function(item) {
                        var url;
                        if (category === 'cities') {
                            url = baseUrl +
                                `/${item.slug}-${item.state_slug}-ct${item.id}-st${item.state_id}`;
                        } else if (category === 'localities') {
                            url = baseUrl +
                                `/${item.slug}-${item.city_slug}-lct${item.id}-ct${item.city_id}`;
                        } else {
                            url = baseUrl + '/searchprojects/' + item.name;
                        }
                        searchResults.append(
                            '<a class="d-flex justify-content-between place_category align-items-baseline" href="' +
                            url + '"><p>' + item + '</p><h4>' + category.charAt(0)
                            .toUpperCase() + category.slice(1) + '</h4></a>');
                        hasResults = true;
                    });
                }
            }
            if (!hasResults) {
                searchResults.append('<p class="px-3">No matching results found.</p>');
            }
        }

        searchInput.on('keyup', function(event) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(performSearch, 300);
        });

        $('.btn_icon').on('click', function() {
            performSearch();
        });

        $(document).on('click', function(event) {
            if (!$(event.target).closest('.full-search-2, #searchInput').length) {
                hideSearchResults();
            }
        });

        searchInput.on('keypress', function(event) {
            if (event.which === 13) {
                clearTimeout(debounceTimer);
                performSearch();
            }
        });
    });

