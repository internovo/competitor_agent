document.addEventListener("DOMContentLoaded", function () {
    let targetDiv = document.getElementById("cl0"); // The div to collapse
    let collapseLink = document.querySelector('[data-bs-target="#cl0"]'); // The link controlling it

    let observed = false; // To track if it has already collapsed
     const bsCollapse = new bootstrap.Collapse(targetDiv, { toggle: false });

    window.addEventListener("scroll", function () {
        if (!observed && targetDiv) {
            let rect = targetDiv.getBoundingClientRect();

            if (rect.top <= window.innerHeight / 2) { // When div reaches middle of screen
                      bsCollapse.hide(); // Collapse panel
                observed=true;
            }
        }
    });
});


