    //   }
    //   document.getElementById("countDown1").innerHTML = "";
    //   document.getElementById("countDown1").innerHTML = minutes + "m " + seconds + "s ";
    //   if (distance < 0) {
    //     clearInterval(x);
    //     document.getElementById("countDown1").innerHTML = "EXPIRED";
    //     document.getElementById("countDown1").classList.add("expired");
    //   }
    // }, 1000);


    function timer(id) {
    // Clear any previous interval if it exists
    if (typeof window.timerInterval !== 'undefined') {
        clearInterval(window.timerInterval);
    }
//  alert(id);
    var countDownDate = new Date().getTime() + (2 * 60 * 1000); // Milliseconds for 5 minutes
    
    window.timerInterval = setInterval(function() {
        var now = new Date().getTime();
        var distance = countDownDate - now;
        var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        var seconds = Math.floor((distance % (1000 * 60)) / 1000);
        const element = document.getElementById(id);
        
        if (element) {
            element.textContent = "";  // Clear existing content
            element.textContent = minutes + "m " + seconds + "s ";  // Update with timer value
        } else {
            console.error("Element with ID", id, "not found.");
        }

        if (distance < 0) {
            clearInterval(window.timerInterval);
            if (element) {
                element.textContent = "EXPIRED";
                element.classList.add("expired");
            }
        }
    }, 1000);
}
  </script>

  <script>
document.addEventListener('DOMContentLoaded', function() {
    const inputs = document.querySelectorAll('.otp-field input');
    inputs[0].removeAttribute('disabled');

    inputs.forEach((input, index) => {
        input.addEventListener('input', () => {
            if (input.value.length > 1) {
                input.value = input.value.slice(0, 1);
            }
            if (input.value !== '' && index < inputs.length - 1) {
                inputs[index + 1].removeAttribute('disabled');
                inputs[index + 1].focus();
            }
        });
    });

    document.getElementById('verifyCode').addEventListener('submit', function(event) {
        event.preventDefault();
        $('#verifyCode button[type=submit]').html(`<img class="submittingMessage" src="https://huntvastuhomes.com/img/ZZ5H.gif" alt="Loading..." width="20" style="vertical-align: middle;">
    Verifying...`);
        document.querySelector('.error-message').style.display = 'none';
        const otp = Array.from(inputs).map(input => input.value).join('');

        fetch('/verify-otp', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
            },
            body: JSON.stringify({ otp })
        })
        .then(response => response.json())
        .then(data => {
	const errorMessage = document.querySelector('.error-message');
	//alert(data.message);
	    if (data) {
		    if(data.message == "Invalid OTP."){
                $('#verifyCode button[type=submit]').html(`Verify`);
		    $("#mobile_error_msg").removeClass('d-none');
                    errorMessage.removeClass('d-none');
                    errorMessage.style.display = 'block';
                    return ;
		    }
		    if(data.message =='usernotexist'){

		      	$('#verifyCodeForm').hide();
                     	$('#verifyCodeForm').addClass('d-none');
			$('#userRegister').show();
			 // window.location.reload();

		}
                if (data.data.token) {
                        let packageName = localStorage.getItem('package-name');
                        if(packageName != null && packageName != 'undefined'){
                            window.location.href= "https://huntvastuhomes.com/b2b-signup";
                        }
                        else{

				let urlredirect = localStorage.getItem("unitredicturl");
                        if (urlredirect) {
                                        localStorage.removeItem("unitredicturl");
                                        window.location.href = urlredirect;

                                } else {
                                        window.location.reload();
                                }
				
                          //  window.location.reload();
                        }
                }
            } else {
                errorMessage.classList.remove('d-none');
                errorMessage.style.display = 'block';
            }
        })
        .catch(error => {
            console.log(error);
            console.error('Error:', error);
        });
    });

/******************************************************************************/

