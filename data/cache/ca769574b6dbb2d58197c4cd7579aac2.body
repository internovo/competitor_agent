}

    document.addEventListener('DOMContentLoaded', function() {

        var cookieValue = getCookie('laravel_cookie_consent');

        if (cookieValue) {

            $(".overlay").hide();

        } else {

            $(".overlay").show();

        }

        function getCookie(name) {

            var cookieArr = document.cookie.split(';');

            for (var i = 0; i < cookieArr.length; i++) {

                var cookiePair = cookieArr[i].split('=');

                if (name == cookiePair[0].trim()) {

                    return decodeURIComponent(cookiePair[1]);

                }

            }

            return null;

        }

    });



    $(document).ready(function() {

        // Event listener for button click

        $('.js-cookie-consent-agree').click(function() {

            $(".overlay").hide();

        });

    });



    function loginUser() {

        // Get user input

        var apiUrl = "https://api.huntvastuhomes.com";

        var email = $("#login_email").val();

        var password = $("#login_password").val();



        // Construct the data to be sent

        var data = {

            "_token": "EhjEWquIJf6A7d44WIYVJPJS8fzPpDV03a3ve0Vl",

            email: email,

            password: password

        };

        $(".Login_ac_btn button").html('<i class="fa-solid fa-spinner fa-spin"></i> Processing...');

        // Perform AJAX request

        $.ajax({

            type: 'POST',

            url: "login",

            contentType: 'application/json',

            data: JSON.stringify(data),

            success: function(response) {
                if (response.data.token) {

                    window.location.reload();

                }

            },

            error: function(error) {
                console.log(error);
                if(error.responseJSON.message == 'verify_otp'){
                    timer('countDown1');
                    $('#login').modal('hide');
                    $('#registerMobileOtp').modal('show');
                    $('#verifyCodeForm').show();
                   $('#verifyCodeForm').removeClass('d-none');
                }

                if (error.responseJSON && error.responseJSON.errors) {

                    var errors = error.responseJSON.errors;

                    $.each(errors, function(field, messages) {

                        $("#login_" + field + "_error").html('<div class="text-danger">' + messages
                            .join("<br>") + '</div>');

                    });

                } else {

                    $("#fail").html(
                        '<div class="alert alert-danger text-center" id="success_Message">Your credentials do not match.</div>'
                    );

                    $("#loginuser")[0].reset();

                }

            },

            complete: function() {

                $(".Login_ac_btn button").html('Login<i class="fa-solid fa-arrow-right-long ms-2"></i>');

            }

        });

    }



    function registerUser() {
        var formData = {

            "_token": "EhjEWquIJf6A7d44WIYVJPJS8fzPpDV03a3ve0Vl",

            email: $("#register_email").val(),

            password: $("#register_password").val(),

            name: $("#register_name").val(),

            phone: $("#register_phone").val(),

           
        };


        var email = $('#register_email').val();

        if (!isValidEmail(email)) {

            $('#email_error').html('<div class="text-danger">Please enter a valid email address</div>');

            return; // Stop further execution

        } else {

            $('#email_error').html(''); // Clear error message

        }

        $(".Create_ac_btn button").html('<i class="fa-solid fa-spinner fa-spin"></i> Processing...');

        // Perform AJAX request

        $.ajax({

            type: 'POST',

            url: "register",

            contentType: 'application/json',

            data: JSON.stringify(formData),

            success: function(response) {

                if (response.data) {
                    timer('countDown1');
                    $('#register').modal('hide');
                    $('#registerMobileOtp').modal('show');
                    $('#verifyCodeForm').show();
                   $('#verifyCodeForm').removeClass('d-none');

                    // window.location.reload();

                }

            },

            error: function(error) {

                if (error.responseJSON && error.responseJSON.errors) {

                    var errors = error.responseJSON.errors;
                    console.log(error.responseJSON);
                    if (error.responseJSON && error.responseJSON.errors && error.responseJSON.errors.phone) {
            var phoneErrors = error.responseJSON.errors.phone;

            if (phoneErrors.length > 1 && phoneErrors[0] === 'The phone number is already exist.') {
                $("#phone_error").html('<div class="text-danger">' + phoneErrors[0] + '</div>');
                return;
            } else {
                // Handle other phone-related errors
                console.error('Phone error:', phoneErrors);
            }
            if (phoneErrors.length > 1 && phoneErrors[1] === 'The phone number is not verified.') {
                timer('countDown1');
                $('#register').modal('hide');
                $('#registerMobileOtp').modal('show');
                $('#verifyCodeForm').show();
                $('#verifyCodeForm').removeClass('d-none');
            } else {
                // Handle other phone-related errors
                console.error('Phone error:', phoneErrors);
            }
        } else {
            // Handle other validation errors
            console.error('Validation errors:', error.responseJSON.errors);
        }
                   

                    $.each(errors, function(field, messages) {

                        $("#" + field + "_error").html('<div class="text-danger">' + messages.join(
                            "<br>") + '</div>');

                    });

                } else {

                    $("#fail").html(
                        '<div class="alert alert-danger text-center" id="success_Message">Your credentials do not match.</div>'
                    );

                    $("#loginuser")[0].reset();

                }

            },

            complete: function() {

                $(".Create_ac_btn button").html('Login<i class="fa-solid fa-arrow-right-long ms-2"></i>');

            }

        });

    }

    function isValidEmail(email) {
        var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return emailRegex.test(email);
    }

    function handleCredentialResponse(response) {

        // Post JWT token to server-side
        $('#MobileOtpSend button[type=button], #loginuser button[type=button]').html(`<img class="submittingMessage" src="https://huntvastuhomes.com/img/ZZ5H.gif" alt="Loading..." width="20" style="vertical-align: middle;">
    Processing...`);

        fetch("https://huntvastuhomes.com/login/google", {

                method: "POST",

