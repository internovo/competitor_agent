<!-- ============================================================
     â˜…â˜…â˜… MODIFIED CODE â€” CORNER VIDEO WIDGET JS (START) â˜…â˜…â˜…
     â€¢ iframe injected on DOMContentLoaded â€” video starts
       immediately as page loads (autoplay + mute=1)
     â€¢ Uses youtube-nocookie.com (privacy-enhanced)
     â€¢ Mute/unmute via YouTube postMessage API
     â€¢ Close hides widget â†’ reopen pill appears
     â€¢ Reopen pill restores & resumes the video
     â€¢ No overlay, no scroll lock â€” page stays fully usable
     ============================================================ -->
<script>
(function () {
  'use strict';

  var VIDEO_ID = 'Fl7Nom1hrKY';
  var SRC = 'https://www.youtube-nocookie.com/embed/' + VIDEO_ID
          + '?autoplay=1&mute=1&controls=1&playsinline=1'
          + '&rel=0&modestbranding=1&loop=1&playlist=' + VIDEO_ID
          + '&iv_load_policy=3&enablejsapi=1'; /* â˜… MODIFIED: iv_load_policy=3 disables annotations */
          + '&iv_load_policy=3&enablejsapi=1'; /* ★ MODIFIED: iv_load_policy=3 disables annotations */

  var widget     = document.getElementById('cvw');
  var card       = document.getElementById('cvwCard');
  var frameWrap  = document.getElementById('cvwFrame');
  var closeBtn   = document.getElementById('cvwClose');
  var muteBtn    = document.getElementById('cvwMute');
  var muteLabel  = document.getElementById('cvwMuteLabel');
  var reopenBtn  = document.getElementById('cvwReopen');

  var iframe  = null;
  var isMuted = true;
  var isVideoPlaying = true; // when lazy loaded, it autoplays first

  /* — Build & inject iframe — */
  function buildIframe() {
    if (iframe) return;
    
    // Hide thumbnail and play button whenever iframe is built
    var thumb = document.getElementById('cvwThumb');
    var playBtn = document.getElementById('cvwPlayBtn');
    if(thumb) thumb.style.display = 'none';
    if(playBtn) playBtn.style.display = 'none';

    iframe = document.createElement('iframe');
    iframe.src   = SRC;
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('title', 'Hunt Vastu Homes Video Tour');
    frameWrap.appendChild(iframe);

    // Restore the shield to block YouTube native UI from showing on hover
    var shield = document.createElement('div');
    shield.className = 'cvw-shield';
    frameWrap.appendChild(shield);

    // Custom Click-to-Pause/Play logic via YouTube API
    shield.addEventListener('click', function() {
        if (!iframe || !iframe.contentWindow) return;
        var cmd = isVideoPlaying ? 'pauseVideo' : 'playVideo';
        iframe.contentWindow.postMessage(
            JSON.stringify({ event: 'command', func: cmd, args: [] }), '*'
        );
        isVideoPlaying = !isVideoPlaying;
    });
  }

  document.getElementById('cvwFrame').addEventListener('click', function(e) {
      // If iframe doesn't exist yet, build it (thumbnail click)
      if(!iframe) {
          buildIframe();
      }
  });
document.addEventListener('DOMContentLoaded', function () {

    const videoClosed = localStorage.getItem('cvwClosedprj');

    if (videoClosed === 'yes') {
        card.style.display = 'none';
        reopenBtn.style.display = 'flex';
    } else {
        card.style.display = 'block';
        reopenBtn.style.display = 'none';
        // buildIframe() is intentionally NOT called here to prevent Main Thread blocking.
        // It will be called when the user clicks the thumbnail.
    }
 localStorage.setItem('cvwClosedprj', 'yes');
});


 function showCard() {
    card.style.display = 'block';
    reopenBtn.style.display = 'none';
    localStorage.removeItem('cvwClosedprj');
    buildIframe();

    if (iframe) {
        iframe.contentWindow.postMessage(
            JSON.stringify({
                event: 'command',
                func: 'playVideo',
                args: []
            }),
            '*'
        );
    }
}

function hideCard() {

    card.style.display = 'none';
    reopenBtn.style.display = 'flex';

    localStorage.setItem('cvwClosedprj', 'yes');

    if (iframe) {
        iframe.contentWindow.postMessage(
            JSON.stringify({
                event: 'command',
                func: 'pauseVideo',
                args: []
            }),
            '*'
        );
    }
} 
  /* â€” Toggle mute â€” */
  function toggleMute() {
    if (!iframe) return;
    if (isMuted) {
      iframe.contentWindow.postMessage(
        JSON.stringify({ event: 'command', func: 'unMute', args: [] }), '*'
      );
      isMuted = false;
      muteBtn.classList.add('on');
      muteLabel.textContent = 'ðŸ”Š Mute';
    } else {
      iframe.contentWindow.postMessage(
        JSON.stringify({ event: 'command', func: 'mute', args: [] }), '*'
      );
      isMuted = true;
      muteBtn.classList.remove('on');
      muteLabel.textContent = 'ðŸ”‡ Unmute';
    }
  }

  /* â€” Wire events â€” */
  closeBtn.addEventListener('click',  hideCard);
  reopenBtn.addEventListener('click', showCard);
  muteBtn.addEventListener('click',   toggleMute);

  /* Auto-start removed for lazy loading */

}());
</script>
