	<script>
    $(document).ready(function(){
    $('.dropdown').mouseenter(function(){
        $(this).find('.dropdown-menu').addClass('show').addClass('absolute');
    });

    $('.dropdown').mouseleave(function(){
        $(this).find('.dropdown-menu').removeClass('show').removeClass('absolute');
    });

    $(document).click(function(e) {
        if (!$(e.target).closest('.dropdown').length) {
            $('.dropdown-menu').removeClass('show').removeClass('absolute');
        }
    });
});
</script>	
		 
		
