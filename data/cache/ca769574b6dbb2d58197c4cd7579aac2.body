  <script>
$(document).ready(function() {
 $('#verifyOTPCode').submit(function(event) {
    event.preventDefault();
    var otpCode = $('input[name="otp[]"]').map(function() {
        return $(this).val();
      }).get().join('');
    $.ajax({
      url: '/verify-otp', // Replace with your actual route URL
      type: 'POST',
      dataType: 'json',
      data: {
        _token: $('meta[name="csrf-token"]').attr('content'),
        otp: otpCode,
      },
      success: function(response) {
        if (response.data.token) {
        //   console.log('OTP code verified successfully!');
          window.location.reload();
	} else {

            // alert("HEllo");
		// OTP code verification failed
	
          $('#otpCodeError').text(response.message);
        //   $('#otpCodeInput').val('');
        }
      },
      error: function(jqXHR, textStatus, errorThrown) {
        console.log(jqXHR);
        // Handle errors (e.g., network issues, server errors)
        $('input[name="otp[]"]').val();
        $('#otpCodeError').text(jqXHR.responseJSON.message);
      }
    });
  });


