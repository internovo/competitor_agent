/* ============================================================
   â˜…â˜…â˜… MODIFIED CODE â€” CORNER VIDEO WIDGET STYLES (START) â˜…â˜…â˜…
   Auto-plays on page load Â· muted Â· bottom-right corner
   Does NOT cover page content Â· mobile-perfect
   ============================================================ */

/* Widget container â€” fixed bottom-right */
.cvw {
  position: fixed;
  bottom: 20px;
  right: 20px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0;
  /* Slide-in from bottom-right on load */
  animation: cvw-enter .5s cubic-bezier(.34,1.2,.64,1) .8s both;
}
@keyframes  cvw-enter {
  from { opacity: 0; transform: translateY(24px) scale(.94); }
  to   { opacity: 1; transform: translateY(0)   scale(1);    }
}

/* The video card itself */
.cvw-card {
  position: relative;
  width: 180px;           /* compact but watchable on all screens */
  border-radius: 14px;
  overflow: hidden;
  background: #000;
  box-shadow:
    0 8px 32px rgba(0,0,0,.45),
    0 0 0 1.5px rgba(255,255,255,.10);
  transition: width .28s ease, box-shadow .28s ease;
}
/* Slightly larger on hover (desktop) */
.cvw-card:hover {
  width: 200px;
  box-shadow: 0 14px 44px rgba(0,0,0,.55), 0 0 0 1.5px rgba(255,255,255,.16);
}

/* 9:16 ratio wrapper */
.cvw-frame {
  position: relative;
  width: 100%;
  padding-top: 177.78%;   /* 9:16 for YouTube Shorts */
}
.cvw-frame iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: none;
  display: block;
  pointer-events: auto;
}
/* â˜… MODIFIED: Transparent shield sits above the iframe â€”
   absorbs mouse hover so YouTube never receives mouseenter
   and never shows its title bar / logo overlay.
   Buttons (.cvw-close, .cvw-bar) are z-index:10, above this. */
.cvw-shield {
  position: absolute;
  inset: 0;
  z-index: 2;
  cursor: default;
}

/* Top-right close button */
.cvw-close {
  position: absolute;
  top: 7px;
  right: 7px;
  z-index: 10;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: rgba(0,0,0,.65);
  border: 1px solid rgba(255,255,255,.22);
  color: #fff;
  font-size: 13px;
  line-height: 1;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: background .18s, transform .18s;
}
.cvw-close:hover {
  background: rgba(200,30,30,.8);
  transform: scale(1.12);
}

/* Bottom bar: mute toggle */
.cvw-bar {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  z-index: 10;
  padding: 7px 8px;
  background: linear-gradient(to top, rgba(0,0,0,.72) 0%, transparent 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}
.cvw-mute {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: rgba(255,255,255,.14);
  border: 1px solid rgba(255,255,255,.28);
  color: #fff;
  font-family: inherit;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .04em;
  padding: 4px 8px;
  border-radius: 50px;
  cursor: pointer;
  transition: background .18s;
  white-space: nowrap;
}
.cvw-mute:hover { background: rgba(255,255,255,.26); }
.cvw-mute svg {
  width: 12px; height: 12px;
  fill: none;
  stroke: #fff;
  stroke-width: 2.2;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex-shrink: 0;
}
.cvw-mute .ic-m { display: block; }
.cvw-mute .ic-s { display: none;  }
.cvw-mute.on .ic-m { display: none;  }
.cvw-mute.on .ic-s { display: block; }

/* Gold label badge */
.cvw-badge {
  background: rgba(242,176,28,.9);
  color: #1f2937;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 3px 7px;
  border-radius: 50px;
  white-space: nowrap;
}

/* Minimise pill shown after close */
.cvw-reopen {
  display: none;           /* hidden until widget is dismissed */
  align-items: center;
  gap: 7px;
  background: #1f2937;
  border: 1.5px solid rgba(242,176,28,.55);
  color: #fff;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  padding: 8px 14px;
  border-radius: 50px;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(0,0,0,.35);
  transition: background .2s, transform .2s;
  animation: cvw-enter .35s ease both;
}
.cvw-reopen:hover { background: #374151; transform: translateY(-2px); }
.cvw-reopen .play-dot {
  width: 22px; height: 22px;
  border-radius: 50%;
  background: linear-gradient(135deg,#f2b01c,#f4cf9a);
  display: grid;
  place-items: center;
  flex-shrink: 0;
}
.cvw-reopen .play-dot svg {
  width: 8px; height: 8px;
  fill: #1f2937;
  margin-left: 1px;
}

/* Mobile: smaller widget */
@media (max-width: 480px) {
  .cvw { bottom: 14px; right: 14px; }
  .cvw-card { width: 140px; }
  .cvw-card:hover { width: 156px; }
}

/* ============================================================
   ★★★ MODIFIED CODE — CORNER VIDEO WIDGET STYLES (END) ★★★
