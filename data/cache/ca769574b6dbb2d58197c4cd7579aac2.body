<script>
/**
 * Modal popup rules:
 * - Only for NOT logged-in users
 * - Shows after 10 seconds
 * - Shows only once per page per browser session
 * - If closed, never shows again for that page in the same session
 * - Can still show on other pages in same session
 *
 * Requirements:
 * - Bootstrap 5 modal markup present with id="popup"
 * - Bootstrap JS loaded (Modal API)
 */

 var MAX_SHOW_COUNT = 10;
// ---- CONFIG ----
//var POPUP_DELAY_MS = 7000; // 7 seconds
var POPUP_DELAY_MS = 10000; // 10 seconds

/**
 * Your server should print a reliable logged-in flag.
 * Replace the value below with your actual login check.
 *
 * Examples:
 *   var HVH_IS_LOGGED_IN = false;
 *   var HVH_IS_LOGGED_IN = false;
 */
var HVH_IS_LOGGED_IN = false; // <-- REPLACE with real value

/**
 * Identify which of the 3 pages this is.
 * Set one of these on each page template:
 *   <body data-page-type="home">
 *   <body data-page-type="city">
 *   <body data-page-type="project">
 */
function getPageType() {

  var body = document.body;
  var t = body ? body.getAttribute("data-page-type") : "";
  return (t || "unknown").toLowerCase();
}

// ---- IMPLEMENTATION ----
(function () {
  // Do nothing if logged in
 if (HVH_IS_LOGGED_IN) return;

  // Ensure modal exists
  var modalEl = document.getElementById("popupfree");
  if (!modalEl) return;

  var pageType = getPageType();
  

  if (pageType !== "home" && pageType !== "city" && pageType !== "project" && pageType !== "locality" ) {

    // If you want to allow other page types, remove this guard.
    return;
  }

  // Session key ensures: once per page per session
  var sessionKey = "hvh_popup_shown_" + pageType;

  // If already shown in this session for this page type, do not show again
  if (sessionStorage.getItem(sessionKey) === "1") return;

  // Show after delay
  var timerId = setTimeout(function () {
    // Mark as shown BEFORE opening to prevent re-show on fast reload / navigation
    sessionStorage.setItem(sessionKey, "1");

    // Bootstrap 5 modal show
    try {
      var modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl, {
        backdrop: true,
        keyboard: true
      });
      modalInstance.show();
    } catch (e) {
      // If bootstrap isn't available, fail silently
      // console.log(e);
    }
  }, POPUP_DELAY_MS);

  // If user closes before timer fires, cancel timer and still mark as shown for this page
  // (Optional safeguard if you trigger close without showing; harmless otherwise)
  function markShownAndClearTimer() {
    sessionStorage.setItem(sessionKey, "1");
    clearTimeout(timerId);
  }

  // When modal is closed, ensure it won't reappear on this page in this session
  modalEl.addEventListener("hidden.bs.modal", function () {
    sessionStorage.setItem(sessionKey, "1");
  });

  // Also cover your close element clicks (in case modal hides in a custom way)
  // It is okay if these elements do not exist.
  document.addEventListener("click", function (ev) {
    var target = ev.target;
    if (!target) return;

    // Any element that dismisses the modal
    var dismiss = target.closest('[data-bs-dismiss="modal"]');
    if (dismiss && dismiss.closest("#popupfree")) {
      markShownAndClearTimer();
    }
  });
})();

function closeModal() {
    const modalEl = document.getElementById('popupfree');
    bootstrap.Modal.getInstance(modalEl).hide();
    //	openModal('mobile') 

mobileLogin();
}

</script>

      <script type="text/javascript">
  //
 $("#login_email, #login_password").keyup(function(){
    $("#login_email_error").hide();	
    $("#login_password_error").hide();
 });
 //
function loginWithoutOtp(event){
    event.preventDefault();
    
    var useremail = ($('#loginWithoutOtp input[name="email"]').val() || '').trim();
    var password = ($('#loginWithoutOtp input[name="password"]').val() || '');
    var isValid = true;

    $("#login_email_error").hide();	
    $("#login_password_error").hide();
    $("#login_email").focusout();	
    $("#login_password").focusout();

    // Useremail validation
    if(!ValidateEmail(useremail)){
        $("#login_email_error").text("Please enter valid email").show();	
        $("#login_email").focus();	
        isValid = false;
        return false;
    }
    // Password validation
    if (password.trim() === '' || password.length < 6) {
        $("#login_password_error").text("Please enter valid password").show();	
        $("#login_password").focus();	
        isValid = false;
        return false;
    } 

    if(isValid){
        var formData = $('#loginWithoutOtp').serialize();
        $.ajax({
            type: 'POST',
            url: '/login',
            data: formData,
            success: function(response) {
                // $('#response').html('<p>Success: ' + response + '</p>');
                // console.log('Success:', response);
                location.reload();
            },
            error: function(xhr, status, error) {
                var emailError = xhr.responseJSON ? xhr.responseJSON.email_error : null;
                var passwordError = xhr.responseJSON ? xhr.responseJSON.password_error : null;
                if(emailError){
                    $("#login_email_error").text(emailError).show();	
                } else if(passwordError){
                    $("#login_password_error").text(passwordError).show();	
                } else {
                    $("#login_email_error").text("An error occurred. Please try again.").show();
                }
                // $('#response').html('<p>Error: ' + error + '</p>');
                // console.error('Error:', status, error);
            }
        });
    }

}
