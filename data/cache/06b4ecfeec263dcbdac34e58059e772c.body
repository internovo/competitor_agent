/* ============================================
   SEARCH PAGE — DESIGN REFRESH
   Tokens: navy #011E48 · gold #FAB70A
   Display: Fraunces (already loaded site-wide)
   Body/UI: Poppins
   ============================================ */
:root {
    --kre-navy: #011E48;
    --kre-gold: #FAB70A;
    --kre-paper: #F5F6F8;
    --kre-ink: #16233D;
    --kre-muted: #6B7280;
    --kre-line: #E3E6EC;
}

.searchpage {
    background: var(--kre-paper);
}

/* --- Filter sidebar: reads like a spec sheet, not a card stack --- */
#filters_col {
    background: #fff;
    border: 1px solid var(--kre-line);
    padding: 22px 20px 8px;
}
#filters_col > a {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: var(--kre-navy);
    letter-spacing: 0.01em;
    display: block;
    margin-bottom: 4px;
}
.filter_type {
    border-top: 1px solid var(--kre-line);
    padding: 16px 0;
}
.filter_type:first-of-type {
    border-top: none;
    padding-top: 8px;
}
.filter_type h6 {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--kre-muted);
    margin-bottom: 10px;
}
.filter_type ul {
    list-style: none;
    margin: 0;
    padding: 0;
}
.filter_type ul li {
    margin-bottom: 2px;
}
.filter_type label.container_check {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px 7px 12px;
    font-size: 14px;
    color: var(--kre-ink);
    cursor: pointer;
    border-left: 2px solid transparent;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
}
.filter_type label.container_check:hover {
    background: var(--kre-paper);
}
.filter_type label.container_check.active_color {
    border-left-color: var(--kre-gold);
    background: var(--kre-paper);
    color: var(--kre-navy);
    font-weight: 600;
}
.filter_type label.container_check input[type="checkbox"] {
    margin: 0;
    accent-color: var(--kre-navy);
}
.filter_type label.container_check .checkmark {
    display: none; /* using native checkbox appearance instead of the custom span */
}

/* --- Breadcrumb: quiet, editorial --- */
.searchpage .breadcrumb {
    background: transparent;
    padding: 0 0 10px;
    font-size: 13px;
    color: var(--kre-muted);
}
.searchpage .breadcrumb a {
    color: var(--kre-muted);
    text-decoration: none;
}
.searchpage .breadcrumb a:hover {
    color: var(--kre-navy);
}
.searchpage .breadcrumb .active {
    color: var(--kre-ink);
}

/* --- Results header: count + sort --- */
.searchpage p.showing {
    font-size: 13px;
    color: var(--kre-muted);
    margin-bottom: 4px;
}
.searchpage p.showing strong {
    color: var(--kre-navy);
}
.searchpage #sort_by_value {
    float: right;
    max-width: 220px;
    border: 1px solid var(--kre-line);
    border-radius: 0;
    font-size: 13px;
    color: var(--kre-ink);
    background: #fff;
}
.searchpage h1 {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    color: var(--kre-navy);
    clear: both;
    padding-top: 8px;
}
.searchpage p.para {
    color: var(--kre-muted);
    font-size: 14px;
    line-height: 1.6;
}
.searchpage p.para .readmore,
.searchpage p.para .readless {
    color: var(--kre-navy);
    font-weight: 600;
}
</style>

