<script>
function sort_by() {
    document.getElementById('sort').value = document.getElementById('sort_by_value').value;
    document.getElementById('categoryFilter').submit();
}
document.getElementById('city_select').addEventListener('change', function(){
    document.getElementById('city').value = this.value;
    document.getElementById('categoryFilter').submit();
});

// Generic toggle for array filters. Bound to the checkbox's `change` event
// (not the label's `click`), because a <label> wrapping an <input> makes the
// browser fire a click on both the label AND a synthetic click forwarded to
// the checkbox, which bubbles back through the label — so a single real
// click used to call this function TWICE and cancel itself out. `change`
// fires exactly once per actual state change, regardless of whether the
// click originated on the label text or the checkbox itself.
//
// Because this now runs on `change` (after the browser has already applied
// the new checked state), checkbox.checked already IS the new state —
// unlike the old `onclick` version, this does NOT need to be inverted.
function toggleSearchFilter(fieldName, value, el){

    let form = document.getElementById('categoryFilter');
    let checkbox = el.querySelector('input[type="checkbox"]');

    let willBeChecked = checkbox.checked;

    let existingInputs = Array.from(form.querySelectorAll('input[name="'+fieldName+'[]"]'));
    existingInputs.forEach(input => {
        if(input.value == value){
            input.remove();
        }
    });

    if(willBeChecked){
        let input = document.createElement('input');
        input.type = 'hidden';
        input.name = fieldName+'[]';
        input.value = value;
        form.appendChild(input);
    }

    form.submit();
}

function setConfig(id, el) {
    toggleSearchFilter('config', id, el);
}
function setPropertyType(val, el) {
    toggleSearchFilter('property_type', val, el);
}
function setPossession(val, el) {
    toggleSearchFilter('possession', val, el);
}
function setPyear(val, el) {
    toggleSearchFilter('possession_year', val, el);
}
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {

    document.querySelectorAll(".readmore").forEach(btn => {
        btn.addEventListener("click", function () {
            let parent = this.closest(".para");

            parent.querySelector(".short-text").classList.add("d-none");
            parent.querySelector(".full-text").classList.remove("d-none");

            this.classList.add("d-none");
            parent.querySelector(".readless").classList.remove("d-none");
        });
    });

    document.querySelectorAll(".readless").forEach(btn => {
        btn.addEventListener("click", function () {
            let parent = this.closest(".para");

            parent.querySelector(".short-text").classList.remove("d-none");
            parent.querySelector(".full-text").classList.add("d-none");

            this.classList.add("d-none");
            parent.querySelector(".readmore").classList.remove("d-none");
        });
    });

});
</script>
<script>
function toggleDesc(id, btn){

    let el = document.getElementById('desc-' + id);

    el.classList.toggle('expanded');

    if(el.classList.contains('expanded')){
        btn.innerText = 'Show Less';
    }else{
        btn.innerText = 'Read More';
    }
}
</script>
                       
     
