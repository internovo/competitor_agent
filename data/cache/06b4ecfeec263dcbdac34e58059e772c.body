                                    <div id="data-wrapper">
                        <style>
/* =========================================================
   KEYSTONE PROPERTY SEARCH CARD
   UPDATED COMPACT DESIGN
   ========================================================= */

:root {
    --ks-navy: #06224d;
    --ks-navy-dark: #041a3b;
    --ks-text: #182338;
    --ks-muted: #687386;
    --ks-border: #e1e6ed;
    --ks-gold: #f4b400;
    --ks-whatsapp: #25d366;
    --ks-green-bg: #f0f5e8;
}


/* =========================================================
   MAIN CARD
   ========================================================= */

.ks-property-card {
    width: 100%;
    height: 274px;
    min-height: 274px;

    display: grid;

    grid-template-columns: 34% 66%;
    grid-template-rows: 200px 62px;

    background: #fff;

    border: 1px solid var(--ks-border);
    border-radius: 15px;

    overflow: hidden;

    margin-bottom: 16px;

    box-shadow: 0 2px 8px rgba(6,34,77,.04);

    transition:
        box-shadow .2s ease,
        border-color .2s ease;
}

.ks-property-card:hover {
    border-color: #ccd5e0;
    box-shadow: 0 6px 20px rgba(6,34,77,.08);
}


/* =========================================================
   IMAGE
   ========================================================= */

.ks-property-image {
    grid-column: 1;
    grid-row: 1 / 3;

    position: relative;

    width: 100%;
    height: 274px;

    overflow: hidden;

    background: #edf1f5;
}

.ks-property-image figure,
.ks-property-image a {
    width: 100%;
    height: 100%;

    display: block;

    margin: 0;
}

.ks-property-image img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    transition: transform .3s ease;
}

.ks-property-card:hover .ks-property-image img {
    transform: scale(1.015);
}


/* =========================================================
   IMAGE BADGES
   ========================================================= */

.ks-image-badges {
    position: absolute;

    z-index: 5;

    top: 14px;
    left: 14px;
    right: 14px;

    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 8px;
}

.ks-status-badge,
.ks-rera-badge {

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 24px;

    padding: 0 12px;

    border-radius: 7px;

    font-size: 11px;
    font-weight: 700;

    line-height: 1;

    white-space: nowrap;
}

.ks-status-badge {
    background: rgba(255,255,255,.96);

    color: var(--ks-navy);

    box-shadow: 0 2px 6px rgba(0,0,0,.05);
}

.ks-rera-badge {
    gap: 6px;

    background: var(--ks-navy);

    color: #fff;
}

.ks-rera-badge svg {
    width: 13px;
    height: 13px;
}


/* =========================================================
   MIDDLE CONTENT
   ========================================================= */

.ks-property-content {

    grid-column: 2;
    grid-row: 1;

    position: relative;

    width: 100%;
    height: 214px;

    padding: 15px 20px 0;

    overflow: hidden;
}


/* =========================================================
   TITLE
   ========================================================= */

.ks-property-title {

    width: calc(100% - 170px);

    margin: 0 0 2px;

    color: var(--ks-navy);

    font-family: 'Poppins', sans-serif;

    font-size: 20px;
    font-weight: 600;

    line-height: 28px;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}

.ks-property-title a {
    color: inherit;
    text-decoration: none;
}


/* =========================================================
   DEVELOPER
   ========================================================= */

.ks-property-developer {

    margin: 0 0 2px;

    color: var(--ks-muted);

    font-size: 12px;

    line-height: 1.3;
}

.ks-property-developer strong {
    color: var(--ks-navy);
    font-weight: 600;
        font-size: 14px;
}


/* =========================================================
   LOCATION
   ========================================================= */

.ks-property-location {

    margin: 0;

    color: #0b1a29;

    font-size: 13px;
    font-weight: 400px;

    line-height: 24px;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}


/* =========================================================
   TOP RIGHT RATING
   ========================================================= */

.ks-top-rating {

    position: absolute;

    top: 18px;
    right: 20px;

    min-width: 138px;
    height: 38px;

    padding: 0 12px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 6px;

    border-radius: 7px;

    background: var(--ks-green-bg);

    color: #607f00;

    font-size: 11px;
    font-weight: 600;

    white-space: nowrap;
}

.ks-top-rating i {
    font-size: 13px;
    color: #638000;
}


/* =========================================================
   SPECIFICATIONS
   ========================================================= */

.ks-spec-grid,
.ks-spec-row-2 {

    width: 100%;

    display: grid;

    border-top: 1px solid var(--ks-border);
}


/* FIRST ROW */

.ks-spec-grid {

    margin-top: 0px;

    grid-template-columns:
        1fr
        1fr
        1fr;

    border-bottom: 1px solid var(--ks-border);
}


/* SECOND ROW */

.ks-spec-row-2 {

    grid-template-columns:
        1.5fr
        1fr
        .7fr;

    border-bottom: 1px solid var(--ks-border);
}


/* =========================================================
   SPEC ITEM
   ========================================================= */

.ks-spec-item,
.ks-possession-item,
.ks-rating-item {

    min-width: 0;

    height: 53px;

    padding: 8px 10px;

    display: flex;

    align-items: center;

    gap: 9px;

    overflow: hidden;
}


/* DIVIDERS */

.ks-spec-item + .ks-spec-item,
.ks-possession-item,
.ks-rating-item {

    border-left: 1px solid var(--ks-border);
}


/* FIRST COLUMN */

.ks-spec-grid .ks-spec-item:first-child,
.ks-spec-row-2 .ks-spec-item:first-child {

    border-left: 0;
}


/* =========================================================
   ICON
   ========================================================= */

.ks-spec-icon,
.ks-possession-icon {

    width: 17px;
    height: 17px;

    flex: 0 0 17px;

    stroke: var(--ks-navy);
}


/* =========================================================
   SPEC TEXT
   ========================================================= */

.ks-spec-copy {

    min-width: 0;

    width: 100%;
}

.ks-spec-label {

    display: block;

    margin-bottom: 3px;

    color: var(--ks-muted);

    font-size: 10px;
    font-weight: 600;

    line-height: 1;

    letter-spacing: .08em;

    text-transform: uppercase;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}

.ks-spec-value,
.ks-possession-value {

    display: block;

    width: 100%;

    color: var(--ks-text);

    font-size: 13px;
    font-weight: 600;

    line-height: 1.2;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}


/* =========================================================
   HIDE OLD RATING IN SECOND ROW
   ========================================================= */

.ks-spec-row-2 .ks-rating-item {
    display: none;
}


/* =========================================================
   BOTTOM ACTION AREA
   ========================================================= */

.ks-property-action {

    grid-column: 2;
    grid-row: 2;

    width: 100%;
       height: 72px;
    padding: 8px 20px 15px;
    display: grid;

    grid-template-columns:
        1.1fr
        1fr
        1fr
        1fr;

    align-items: center;

    gap: 10px;

    border-top: 0;

    background: #fff;
}


/* =========================================================
   PRICE
   ========================================================= */

.ks-price-label {

    margin-bottom: 1px;

    color: var(--ks-muted);

    font-size: 8px;
    font-weight: 600;

    line-height: 1;

    letter-spacing: .08em;

    text-transform: uppercase;
}

.ks-price {

    color: var(--ks-navy);

    font-family: 'Poppins', sans-serif;

    font-size: 18px;
    font-weight: 700;

    line-height: 1.1;

    white-space: nowrap;
}

.ks-price-psf {

    display: block;

    margin-top: 2px;

    color: var(--ks-muted);

    font-size: 9px;

    line-height: 1.1;
}


/* =========================================================
   RERA NUMBER
   ========================================================= */

.ks-rera-info {

    min-width: 0;

    padding-left: 15px;

    border-left: 1px solid var(--ks-border);
}

.ks-rera-label {

    margin-bottom: 3px;

    color: var(--ks-muted);

    font-size: 8px;
    font-weight: 600;

    line-height: 1;

    letter-spacing: .08em;

    text-transform: uppercase;
}

.ks-rera-value {

    color: var(--ks-text);

    font-size: 11px;
    font-weight: 600;

    line-height: 1.2;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}


/* =========================================================
   CTA
   ========================================================= */

.ks-cta-area {

    display: contents;
}

.ks-enquire-btn,
.ks-whatsapp-btn {

    width: 100%;
    height: 45px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 7px;

    font-size: 11.5px;
    font-weight: 600;

    cursor: pointer;

    transition: all .2s ease;
}


/* ENQUIRE */

.ks-enquire-btn {

    padding: 8px 10px;

    background: #fff;

    border: 1px solid var(--ks-navy);

    color: var(--ks-navy);
}

.ks-enquire-btn:hover {

    background: var(--ks-navy);

    color: #fff;
}


/* WHATSAPP */

.ks-whatsapp-btn {

    padding: 8px 10px;

    gap: 7px;

    background: var(--ks-navy);

    border: 1px solid var(--ks-navy);

    color: #fff;
}

.ks-whatsapp-btn:hover {

    background: var(--ks-navy-dark);
}

.ks-whatsapp-btn i {

    color: var(--ks-whatsapp);

    font-size: 15px;
}


/* =========================================================
   PRICE ON REQUEST
   ========================================================= */

.ks-price-request {

    color: var(--ks-navy);

    font-size: 12px;
    font-weight: 600;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 991px) {

    .ks-property-card {

        height: auto;
        min-height: 0;

        display: block;

        border-radius: 12px;
    }


    /* IMAGE */

    .ks-property-image {

        width: 100%;
        height: 220px;
    }


    /* CONTENT */

    .ks-property-content {

        width: 100%;
        height: auto;

        padding: 15px 15px 0;
    }


    .ks-property-title {

        width: calc(100% - 130px);

        font-size: 20px;
            line-height: 20px;
    }


    .ks-top-rating {

       top: 14px;
        right: 13px;
        min-width: 100px;
        height: 20px;
        padding: 0 8px;
        font-size: 8px;
    }


    .ks-spec-grid {

        margin-top: 8px;
    }


    .ks-spec-item,
    .ks-possession-item {

        height: 50px;

        padding: 7px;

        gap: 6px;
    }


    .ks-spec-icon,
    .ks-possession-icon {

        width: 15px;
        height: 15px;

        flex-basis: 15px;
    }


    .ks-spec-label {

        font-size: 7px;
    }


    .ks-spec-value,
    .ks-possession-value {

        font-size: 10px;
    }


    /* ACTION */

    .ks-property-action {

        width: 100%;
        height: auto;

        padding: 10px 15px 13px;

        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 8px;

        border-top: 1px solid var(--ks-border);
    }


    .ks-rera-info {

        grid-column: 1 / -1;

        padding: 0;

        border: 0;
    }


    .ks-price {

        font-size: 21px;
    }


    .ks-enquire-btn,
    .ks-whatsapp-btn {

        height: 42px;
    }
}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

/* =========================================================
   MOBILE ONLY
   DESKTOP REMAINS UNCHANGED
   ========================================================= */

@media (max-width: 991px) {

    .ks-property-card {
        width: 100%;
        height: auto;
        min-height: 0;

        display: block;

        border-radius: 12px;
        overflow: hidden;
    }


    /* =====================================================
       IMAGE
       ===================================================== */

    .ks-property-image {
        width: 100%;
        height: 220px;

        grid-column: auto;
        grid-row: auto;
    }


    /* =====================================================
       CONTENT
       ===================================================== */

    .ks-property-content {
        width: 100%;
        height: auto;

        padding: 15px 15px 0;

        overflow: visible;
    }


    /* =====================================================
       TITLE
       ===================================================== */

    .ks-property-title {
        width: 100%;

        padding-right: 125px;

        margin: 0 0 2px;

        font-size: 20px;
        line-height: 24px;
    }


    /* =====================================================
       TOP RATING
       ===================================================== */

    .ks-top-rating {
        top: 14px;
        right: 13px;

        min-width: 112px;
        height: 32px;

        padding: 0 8px;

        font-size: 9px;
    }

    .ks-top-rating i {
        font-size: 12px;
    }


    /* =====================================================
       DEVELOPER
       ===================================================== */

    .ks-property-developer {
        margin-bottom: 3px;

        font-size: 10px;
        line-height: 13px;
    }

    .ks-property-developer strong {
        font-size: 11px;
        font-weight: 600;
    }


    /* =====================================================
       LOCATION
       ===================================================== */

    .ks-property-location {
        margin: 0;

        font-size: 11px;
        line-height: 16px;
    }


    /* =====================================================
       SPECIFICATION ROWS
       ===================================================== */

    .ks-spec-grid,
    .ks-spec-row-2 {
        width: 100%;

        grid-template-columns:
            minmax(0, 1fr)
            minmax(0, 1fr)
            minmax(0, 1fr);
    }


    .ks-spec-grid {
        margin-top: 7px;
    }


    /* =====================================================
       SPEC ITEMS
       ===================================================== */

    .ks-spec-item,
    .ks-possession-item,
    .ks-rating-item {

        min-width: 0;

        height: 48px;

        padding: 6px 6px;

        gap: 5px;

        overflow: hidden;
    }


    /* =====================================================
       ICONS
       ===================================================== */

    .ks-spec-icon,
    .ks-possession-icon {

        width: 13px;
        height: 13px;

        flex: 0 0 13px;
    }


    /* =====================================================
       LABEL
       ===================================================== */

    .ks-spec-label {
        margin-bottom: 3px;

        font-size: 7px;

        line-height: 1;

        letter-spacing: .06em;
    }


    /* =====================================================
       VALUE
       ===================================================== */

    .ks-spec-value,
    .ks-possession-value {

        font-size: 10.5px;

        line-height: 1.15;
    }


    /* =====================================================
       HIDE OLD RATING COLUMN
       ===================================================== */

    .ks-spec-row-2 .ks-rating-item {
        display: none;
    }


    /* =====================================================
       BOTTOM ACTION AREA
       FIXED MOBILE STRUCTURE

       ROW 1:
       PRICE

       ROW 2:
       ENQUIRE | WHATSAPP
       ===================================================== */

    .ks-property-action {

        width: 100%;
        height: auto;

        padding: 10px 15px 12px;

        display: grid;

        grid-template-columns: 1fr 1fr;

        grid-template-rows: auto 42px;

        column-gap: 8px;
        row-gap: 8px;

        border-top: 1px solid var(--ks-border);

        background: #fff;
    }


    /* =====================================================
       PRICE
       FULL WIDTH
       ===================================================== */

    .ks-property-action > div:first-child {

        grid-column: 1 / -1;
        grid-row: 1;

        min-width: 0;

        display: flex;

        align-items: baseline;

        gap: 8px;
    }


    .ks-price-label {

        flex: 0 0 auto;

        margin: 0;

        font-size: 8px;

        line-height: 1;
    }


    .ks-price {

        font-size: 20px;

        line-height: 1.1;

        white-space: nowrap;
    }


    .ks-price-psf {

        display: inline;

        margin: 0;

        font-size: 9px;

        white-space: nowrap;
    }


    /* =====================================================
       PRICE ON REQUEST
       ===================================================== */

    .ks-price-request {

        font-size: 13px;

        line-height: 1.1;
    }


    /* =====================================================
       RERA INFO
       HIDDEN ON MOBILE
       ===================================================== */

    .ks-rera-info {
        display: none;
    }


    /* =====================================================
       ENQUIRE BUTTON
       ===================================================== */

    .ks-enquire-btn {

        grid-column: 1;
        grid-row: 2;

        width: 100%;
        height: 42px;

        margin: 0;

        padding: 8px 6px;

        font-size: 11.5px;

        border-radius: 7px;
    }


    /* =====================================================
       WHATSAPP BUTTON
       ===================================================== */

    .ks-whatsapp-btn {

        grid-column: 2;
        grid-row: 2;

        width: 100%;
        height: 42px;

        margin: 0;

        padding: 8px 6px;

        gap: 6px;

        font-size: 11.5px;

        border-radius: 7px;
    }


    .ks-whatsapp-btn i {
        font-size: 15px;
    }
}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 600px) {

    /* IMAGE */

    .ks-property-image {
        height: 190px;
    }


    /* CONTENT */

    .ks-property-content {
        padding: 13px 13px 0;
    }


    /* TITLE */

    .ks-property-title {
        padding-right: 120px;

        font-size: 18px;
        line-height: 22px;
    }


    /* RATING */

    .ks-top-rating {
        top: 14px;
        right: 13px;

        min-width: 112px;
        height: 32px;

        padding: 0 8px;

        font-size: 9px;
    }


    /* DEVELOPER */

    .ks-property-developer {
        font-size: 10px;
        line-height: 13px;
    }

    .ks-property-developer strong {
        font-size: 11px;
    }


    /* LOCATION */

    .ks-property-location {
        font-size: 11px;
        line-height: 16px;
    }


    /* SPEC ROWS */

    .ks-spec-grid,
    .ks-spec-row-2 {
        grid-template-columns:
            minmax(0, 1fr)
            minmax(0, 1fr)
            minmax(0, 1fr);
    }


    .ks-spec-item,
    .ks-possession-item {

        height: 48px;

        padding: 6px 5px;

        gap: 6px;
    }


    .ks-spec-icon,
    .ks-possession-icon {

        width: 13px;
        height: 13px;

        flex-basis: 13px;
    }


    .ks-spec-label {
        font-size: 7px;
    }


    .ks-spec-value,
    .ks-possession-value {
        font-size: 10.5px;
    }


    /* =====================================================
       BOTTOM SECTION
       ===================================================== */

    .ks-property-action {

        padding: 10px 13px 12px;

        grid-template-columns: 1fr 1fr;

        grid-template-rows: auto 42px;

        column-gap: 8px;
        row-gap: 8px;
    }


    /* PRICE */

    .ks-property-action > div:first-child {

        grid-column: 1 / -1;
        grid-row: 1;

        display: flex;

        align-items: baseline;

        gap: 7px;
    }


    .ks-price-label {
        font-size: 8px;
    }


    .ks-price {
        font-size: 18px;
    }


    .ks-price-psf {
        font-size: 9px;
    }


    /* BUTTONS */

    .ks-enquire-btn,
    .ks-whatsapp-btn {

        height: 42px;

        min-height: 42px;

        margin: 0;

        padding: 8px 6px;

        font-size: 11px;

        border-radius: 7px;
    }
}


/* =========================================================
   VERY SMALL MOBILE
   ========================================================= */

@media (max-width: 380px) {

    .ks-property-image {
        height: 180px;
    }


    .ks-property-content {
        padding-left: 11px;
        padding-right: 11px;
    }


    .ks-property-title {
        padding-right: 112px;

        font-size: 17px;
    }


    .ks-top-rating {
        right: 11px;

        min-width: 105px;

        font-size: 8.5px;
    }


    .ks-spec-item,
    .ks-possession-item {

        padding-left: 4px;
        padding-right: 4px;

        gap: 8px;
    }


    .ks-spec-label {
        font-size:8.5px;
    }


    .ks-spec-value,
    .ks-possession-value {
        font-size: 11px;
    }


    .ks-property-action {

        padding-left: 11px;
        padding-right: 11px;

        column-gap: 6px;
    }


    .ks-enquire-btn,
    .ks-whatsapp-btn {

        font-size: 10px;
    }
}
</style>





