    <!-- PREFILL TAGS FROM URL -->
    <script>
    document.addEventListener("DOMContentLoaded", function () {
    
        let params = new URLSearchParams(window.location.search);
        let existingTags = params.getAll('str[]');
        
        // fallback for old format
        if(existingTags.length === 0 && params.get('str')){
            existingTags = [params.get('str')];
        }
        
        if (existingTags.length > 0) {
            tags = existingTags;
            renderTags();
        }
    
    });
    </script>
