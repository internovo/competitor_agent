	<script>
    /* =========================
       GLOBAL SAFE GUARDS (NO JS CRASH)
    ========================= */
    
    // Prevent undefined function errors
    window.safeCall = function(fn, fallback = function(){}) {
        try {
            if (typeof fn === "function") return fn();
            return fallback();
        } catch (e) {
            console.error("SafeCall Error:", e);
            return fallback();
        }
    };
    
    // Prevent "undefined variable" crashes
    window.getVal = function(selector) {
        let el = document.querySelector(selector);
        return el ? el.value : '';
    };
    </script>
    <script>
    $(document).ready(function () {
    
        $(document).on('click', '.btn-submit', function (e) {
            e.preventDefault();
    
            var btn = $(this);
            var form = btn.closest('form');
            var modal = btn.closest('.modal');
    
            btn.prepend('<i class="fa fa-spinner fa-spin"></i>');
            btn.attr("disabled", true);
    
            $.ajax({
                url: "https://keystonerealestateadvisory.com/my-form",
                type: "POST",
                data: form.serialize(),
                success: function (data) {
    
                    btn.find(".fa-spinner").remove();
                    btn.removeAttr("disabled");
    
                    if ($.isEmptyObject(data.error)) {
                        printSuccessMsg(data.success, form, modal);
                    } else {
                        printErrorMsg(data.error, form);
                    }
                }
            });
        });
    
        function printSuccessMsg(msg, form, modal) {
            var successBox = modal.find(".print-success-msg");
    
            successBox.find("ul").html('');
            successBox.show().find("ul")
                .append('<li>Our Sales team will get back to you shortly!</li>');
    
            setTimeout(function () {
                successBox.hide();
                modal.modal('hide');
                form[0].reset();
            }, 3000);
        }
    
        function printErrorMsg(msg, form) {
            var errorBox = form.closest('.modal').find(".print-error-msg");
    
            errorBox.find("ul").html('');
            errorBox.show();
    
            $.each(msg, function (key, value) {
                errorBox.find("ul").append('<li>' + value + '</li>');
            });
    
            setTimeout(function () {
                errorBox.hide();
            }, 3000);
        }
    
    });
    </script>
    
	
	<script>
    let tags = [];
    
    // Ensure element exists before binding
    $(document).ready(function () {
    
        if ($('#search_input').length) {
    
            $('#search_input').on('keypress', function(e){
                if(e.which === 13){
                    e.preventDefault();
    
                    let val = $(this).val().trim();
    
                    if(val !== '' && !tags.includes(val)){
                        tags.push(val);
                        renderTags();
                    }
    
                    $(this).val('');
                }
            });
    
        }
    
    });
    
    // Render tags safely
    function renderTags(){
        if(!$('#tag-container').length) return;
    
        $('#tag-container').html('');
    
        tags.forEach((tag, index) => {
            $('#tag-container').append(`
                <div class="tag">
                    ${tag} <span onclick="removeTag(${index})">×</span>
                </div>
            `);
        });
    }
    
    // Remove tag safely
    function removeTag(index){
        if(index > -1){
            tags.splice(index, 1);
            renderTags();
        }
    }
    
    // MAIN SEARCH FUNCTION (SAFE)
    function funSearch(){
    
        // 1. Try dropdown
        let city = $('#city_select').length ? $('#city_select').val() : '';
    
        // 2. Fallback → hidden field (search page)
        if(!city){
            city = $('#city').length ? $('#city').val() : '';
        }
    
        // 3. Fallback → URL (important for detail page)
        if(!city){
            let params = new URLSearchParams(window.location.search);
            city = params.get('city');
        }
    
        if(!city){
            city = 'mumbai'; // default
        }
    
        let query = tags.map(t => "str[]=" + encodeURIComponent(t)).join("&");
    
        let url = "/buy/search?city=" + encodeURIComponent(city);
    
        if(query){
            url += "&" + query;
        }
    
        window.location.href = url;
    }
	function applyMobileFilters(){

    let form = document.getElementById('categoryFilterMobile');

    // Add search tags
    form.querySelectorAll('input[name="str[]"]').forEach(el => el.remove());

    mobileTags.forEach(tag => {
        let input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'str[]';
        input.value = tag;
        form.appendChild(input);
    });

    // City (from hidden field)
    let city = document.getElementById('mobile_city_select')?.value || 'mumbai';
        document.getElementById('city').value = city;

    form.submit();
}
	</script>
	
    	
	
   <script>
	$(document).ready(function() {
			$('input.deletable').wrap('<span class="deleteicon"></span>').after($('<span>x</span>').click(function() {
				$(this).prev('input').val('').trigger('change').focus();
			}));
		});
	</script>
	<script>
	$('#tag-wrapper').on('click', function(){
        $('#search_input').focus();
    });
    $('#search_input').on('keypress', function(e){

        if(e.which === 13 || e.which === 44){ // Enter OR comma
            e.preventDefault();
    
            let val = $(this).val().trim();
    
            if(val !== '' && !tags.includes(val)){
                tags.push(val);
                renderTags();
            }
    
            $(this).val('');
        }
    
    });
	</script>
	<script>
function openFilter() {
    document.getElementById('mobileFilter').classList.add('active');
}

function closeFilter() {
    document.getElementById('mobileFilter').classList.remove('active');
}
document.querySelectorAll('.filter-menu div').forEach((tab, index) => {

    tab.addEventListener('click', function () {

        // remove active from all
        document.querySelectorAll('.filter-menu div').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.filter-content > div').forEach(c => c.style.display = 'none');

        // activate clicked
        this.classList.add('active');

        // show corresponding content
        document.querySelectorAll('.filter-content > div')[index].style.display = 'block';
    });

});
let mobileTags = [];

document.getElementById('mobile_search_input')?.addEventListener('keydown', function(e){

    if(e.key === 'Enter'){
        e.preventDefault();

        let val = this.value.trim();
        if(!val) return;

        mobileTags.push(val);
        renderMobileTags();

        this.value = '';
    }
});

function renderMobileTags(){
    let container = document.getElementById('mobile-tag-container');
    container.innerHTML = '';

    mobileTags.forEach((tag, index)=>{
        container.innerHTML += `
            <div class="tag">
                ${tag}
                <span onclick="removeMobileTag(${index})">×</span>
            </div>
        `;
    });
}

function removeMobileTag(i){
    mobileTags.splice(i,1);
    renderMobileTags();
}

function handleBack(e) {
    if (window.history.length > 1) {
        e.preventDefault();
        window.history.back();
    }
}
</script>
	
