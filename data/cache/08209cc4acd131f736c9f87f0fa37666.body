      <div class="tab-content price-trends active" role="tabpanel" aria-labelledby="tab-price-trends" id="panel-price-trends" hidden>
        <h3 class="sr-only">Price Trends</h3>
        
        <p class="tab-description">Chandak Gokarna&#39;s average asking price is rising quarter-on-quarter, compared with Borivali West.</p>
        
        
        <div class="price-trend-box dataPriceInsightsWrapper" id="priceTrendArticle">
            <dl class="price-asking">
              
              <div>
                <dt class="sr-only">Current asking price</dt>
                <dd> <strong>₹ 34,350<small>/sq.ft.</small></strong> </dd>
              </div>
              
              
              <div>
                <dt class="sr-only">Quarter over quarter price change</dt>
                <dd class="badge up">+8.0% QoQ</dd>
              </div>
              
            </dl>
            <p class="price-trend-date"> <span class="icon icon-calendar-o" aria-hidden="true"></span>
              <time>Sep 2025 — Jun 2026</time>
            </p>
          <div class="chart price-trend-graph" id="dataPriceTrendWaveContainer" data-child-name="Chandak Gokarna" data-parent-name="Borivali West" data-has-parent="true">
            <table style="display:none;">
              <thead>
                <tr>
                  <th>Quarter</th>
                  <th>Chandak Gokarna</th>
                  
                  <th>Borivali West</th>
                  
                </tr>
              </thead>
              <tbody>
                
                <tr>
                  <td>Jun 2026</td>
                  <td>34350</td>
                  
                  <td>30750</td>
                  
                </tr>
                
                <tr>
                  <td>Mar 2026</td>
                  <td>31800</td>
                  
                  <td>31300</td>
                  
                </tr>
                
                <tr>
                  <td>Dec 2025</td>
                  <td>30550</td>
                  
                  <td>30300</td>
                  
                </tr>
                
                <tr>
                  <td>Sep 2025</td>
                  <td>0</td>
                  
                  <td>30350</td>
                  
                </tr>
                
              </tbody>
