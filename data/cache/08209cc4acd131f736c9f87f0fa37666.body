        </div>
      </div>
    
    
      <div class="tab-content comparable-projects " role="tabpanel" aria-labelledby="tab-comparable-projects" id="panel-comparable-projects" hidden>
        <h3 class="sr-only">Comparable Projects</h3>
        
        <p class="tab-description">Chandak Gokarna avg. price is ₹ 34.4 K/Sq.Ft. compared to Borivali West at ₹ 30.8 K/Sq.Ft.</p>
        
          <div class="table-box table-responsive scrollbar-hide">
          <table width="100%" border="1" cellspacing="0" cellpadding="5">
            <thead>
