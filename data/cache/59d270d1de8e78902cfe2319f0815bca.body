$(document).ready(function() {
  
        
    $('.floor_plan_Ajax').on('click',function(){
        
        var value = $(this).attr('data-id');
        var property_value = $(this).attr('data-property-id');
       var url = "https://www.onlynew.in/floor_plan_Ajax";
       
        $('.floor_plan_Ajax .tab').removeClass('active');  // Remove active class from all
    $(this).find('.tab').addClass('active');  // Add active class to the clicked tab
    
    
        $.ajax({
                url: url,
                type: 'POST',
                data: {
                   "_token": "QBgatzkxv4AITOJHioSbx07o9dbHdg12uCcp0zL9",
                    value: value,
                     property_value: property_value,
                },
                 beforeSend : function(){
                    $('#loader').show();
                },
                success: function (res) {

                    $('.floor_plan_replace_ajax_data').html(res);
                    $('#loader').hide();
                       
                }
            });
        
    });
    
    
});


$(document).ready(function() {
    // Event listener for the click event on each .box element
    $('.box_interior').on('click', function() {
        
        // Remove active class from all boxes and add to the clicked one
        $('.box').removeClass('active');
        $(this).addClass('active');

        // Get the floor plan ID from the clicked element
        var floorPlanId = $(this).data('id');
var property_value = $(this).attr('data-property-id');
        // AJAX request to fetch floor plan details
        $.ajax({
            url: 'https://www.onlynew.in/interior_design_Ajax', // Replace with your Laravel route
            method: 'post', // You can use 'POST' if required
            data: {
                 "_token": "QBgatzkxv4AITOJHioSbx07o9dbHdg12uCcp0zL9",
                id: floorPlanId,
                property_value:property_value
            },
             beforeSend : function(){
                    $('#loader').show();
                },
            success: function(response) {
                // Update the DOM with the response data (e.g., floor plan details)
                $('.interior_design_ajax_replace').html(response);
                $('#loader').hide();
            },
        });
    });
});

$('.scrollToTarget').click(function (e) {
    e.preventDefault();
    var targetId = '#contact_us_scroll'; // Change this to the ID you want to scroll to
    var $target = $(targetId);
    
    // Determine the offset based on the window width
    var offset = $(window).width() > 768 ? 50 : 990; // Adjust the breakpoint as needed

    setTimeout(function () {
        $('html, body').stop().animate({
            'scrollTop': $target.offset().top + offset // Use the determined offset
        }, 4000, 'swing');
    }, 1);
});

