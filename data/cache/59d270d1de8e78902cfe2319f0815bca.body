                <div class="cal_group">
                    <div class="cal_loan_1">

                        
                        <h1>Loan Calculator</h1>

                        <!-- Loan Amount -->
                        <div class="form-group">
                            <div class="Amount_flex">
                                <label for="property_price">Loan Amount (₹):</label>
                                <input type="text" class="form-control" id="property_price" 
                                       value="5040000" 
                                       data-max="6720000" 
                                       oninput="syncRange('property_price')" 
                                       style="color:#0d263c;">
                            </div>
                            <input type="range" class="range-input" id="property_price_range" 
                                   min="0" 
                                   step="10000" 
                                   value="5040000" 
                                   max="8400000"
                                   oninput="syncInput('property_price')">
                        </div>

                        <input type="hidden" id="display_price" value="67.2 L">

                        <!-- Interest Rate -->
                        <div class="form-group">
                            <div class="Amount_flex">
                                <label for="interest_rate">Interest Rate (%):</label>
                                <input type="number" step="0.01" class="form-control" id="interest_rate" 
                                       value="7.50" 
                                       oninput="syncRange('interest_rate')" readonly>
                            </div>
                            <input type="range" class="range-input" id="interest_rate_range" 
                                   min="0" max="15" step="0.10" 
                                   value="7.50" 
                                   oninput="syncInput('interest_rate')">
                        </div>

                        <!-- Loan Term -->
                        <div class="form-group">
                            <div class="Amount_flex">
                                <label for="loan_term_years">Amortization (Years):</label>
                                <input type="number" class="form-control" id="loan_term_years" 
                                       value="20" 
                                       oninput="syncRange('loan_term_years')" readonly>
                            </div>
                            <input type="range" class="range-input" id="loan_term_years_range" 
                                   min="5" max="30" step="1" 
                                   value="20" 
                                   oninput="syncInput('loan_term_years')">
                        </div>
                    </div>

                    <!-- Results -->
                    <div class="cal_loan_2">
                        <div>
                            <h2><span class="emi">Monthly EMI</span><br>
                                <span id="monthly_payment">₹40,000</span>
                            </h2>
                            <div class="total_amount">
                                <p>
                                    <span class="title">Total Interest Payable </span>
                                    <span id="total_interest_paid">₹4,560,000</span>
                                </p>
                                <p><span class="title">Total Payment</br><span style="font-size:14px;">(Principal + Interest)</span> </span>
                                    <span id="total_mortgage_paid">₹9,600,000</span>
                                </p>
                            </div>
                        </div>
                    </div>

                </div> <!-- /.cal_group -->
            </div>
        </div>
    </div>
</section>
