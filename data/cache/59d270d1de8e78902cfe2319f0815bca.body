   <script>
   
   // Add to Wishlist
    $('.heart, .heart_add').on('click', function() {
    var product_id = $(this).attr('data-id');
    var $this = $(this); // Store reference to the current clicked element

    $.ajax({
        url: "https://www.onlynew.in/wish_list_store",
        type: 'post',
        data: {
            _token: 'QBgatzkxv4AITOJHioSbx07o9dbHdg12uCcp0zL9',
            product_id: product_id,
        },
        success: function(res) {
         
            swal({
                text: res['message'],
                icon: "success",
                timer: 3000
            }).then(function() {
                // Check if wishlist count is 1 or greater, then show or hide the div accordingly
                if(res['wishlist_count'] >= 1){
                    $('.remove-heart1').show(); // Show the wishlist counter div
                    $('#Wish-List-Counter').text(res['wishlist_count']); // Update the counter
                } else {
                    $('.remove-heart1').hide(); // Hide the wishlist counter div
                }

                // Update the heart icon for the clicked product
                $this.removeClass('heart').addClass('remove-heart');
                $this.removeClass('heart').addClass('remove-heart_del');
                $this.html("<img src='https://www.onlynew.in/assets/images/fill-heart.png' class='orange' alt=''>");
            });
        }
    });
});



    // Remove from Wishlist
    $('.remove-heart, .remove-heart_del').on('click', function() {
    var product_id = $(this).attr('data-id');
    var $this = $(this); // Store reference to the current clicked element

    $.ajax({
        url: "https://www.onlynew.in/remove_wish_list",
        type: 'post',
        data: {
            _token: 'QBgatzkxv4AITOJHioSbx07o9dbHdg12uCcp0zL9',
            product_id: product_id,
        },
        success: function (res) {
            swal({
                text: res['message'],
                icon: "success",
                timer: 3000
            }).then(function () {
                // Check if wishlist count is 1 or greater, then show or hide the div accordingly
                if(res['wishlist_count'] >= 1){
                    $('.remove-heart1').show(); // Show the wishlist counter div
                } else {
                    $('.remove-heart1').hide(); // Hide the wishlist counter div
                }

                // Safely update the wishlist counter if the element exists
                var wishlistCounter = document.getElementById('Wish-List-Counter');
                if (wishlistCounter) {
                    wishlistCounter.textContent = res['wishlist_count'];
                }

                // Change the heart icon back to empty for the clicked product
                $this.removeClass('remove-heart').addClass('heart');
                $this.removeClass('remove-heart_del').addClass('heart_add');
                $this.html("<img src='https://www.onlynew.in/assets/images/orange_heart.png' class='white' alt=''>");
            });
        }
    });
});


   
   </script>
   
   


