            border:none;
        }
        .estimate table th, table td {
            padding: 23px 33px;
        }
        .estimate th, td {
            text-align: left;
            padding: 8px;
        }
        .estimate .table-m{
       overflow: auto;
    box-shadow: rgb(255 255 255 / 15%) 0px 5px 15px;
    border-radius: 26px;
    border: 10px solid #fff;
    height: 275px;
        }
        .estimate tr:hover{
            background-color: #687b8bfc;
        }
        .estimate tr:first-child:hover{
            background-color: transparent;
        }
        .estimate table th{
               color: #ec6325 !important;
    font-weight: 800;
    font-size: 15px;
        }
        .estimate table td {
            color:#fff !important;
        }
        @media(max-width:1200px) {
            .estimate .table-m{
                    margin-bottom: 30px;
                       overflow: visible;
                        height: auto;
            }
            .estimate_row{
                display: block;
            }
        }
