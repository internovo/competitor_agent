    .tag_m {
        max-height: 250px;
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;

        /* Firefox */
        scrollbar-width: thin;
        scrollbar-color: #f76421 #f5f5f5;
    }

    /* Android Chrome / Desktop Chrome */
    .tag_m::-webkit-scrollbar {
        width: 6px;
    }

    .tag_m::-webkit-scrollbar-track {
        background: #f5f5f5;
        border-radius: 10px;
    }

    .tag_m::-webkit-scrollbar-thumb {
        background: #f76421;
        border-radius: 10px;
    }

    .tag_m::-webkit-scrollbar-thumb:hover {
        background: #f76421;
    }

    /* Visual scroll indicator for iOS */
    .tag_m {
        position: relative;
    }

    .tag_m::after {
        content: '';
        position: sticky;
        bottom: 0;
        display: block;
        height: 20px;
        background: linear-gradient(
            to bottom,
            rgba(13, 38, 60, 0),
            rgba(247, 100, 33, 0.35)
        );
        pointer-events: none;
    }
}

