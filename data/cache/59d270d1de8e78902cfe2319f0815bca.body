        .share-button .dropdown.open .dropdown-menu {
            opacity: 1;
            visibility: visible;
        }

        .share-button ul li .dropdown-menu {
            position: absolute;
            background: #02222e;
            left: auto !important;
            right: -10px;
            margin-top: 10px;
            border-radius: 20px;
            padding: 5px 10px !important;
            opacity: 0;
            visibility: hidden;
            display: flex;
            -webkit-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            border: 0;
            min-width: auto;
            -webkit-box-shadow: 6.428px 7.66px 7.5px rgba(0, 0, 0, .1);
            -khtml-box-shadow: 6.428px 7.66px 7.5px rgba(0, 0, 0, .1);
            -moz-box-shadow: 6.428px 7.66px 7.5px rgba(0, 0, 0, .1);
            -ms-box-shadow: 6.428px 7.66px 7.5px rgba(0, 0, 0, .1);
            -o-box-shadow: 6.428px 7.66px 7.5px rgba(0, 0, 0, .1);
            box-shadow: 6.428px 7.66px 7.5px rgba(0, 0, 0, .1);
        }

        .share-button ul li .dropdown-menu:after {
            position: absolute;
            content: "";
            left: auto;
            right: 21px;
            top: -7px;
            width: 0;
            height: 0;
            border-left: 7px solid transparent;
            border-right: 7px solid transparent;
            border-bottom: 7px solid #022330;
            margin: auto;
        }

        .share-button ul li .dropdown-menu li {
            display: inline-block;
            margin-top: 0;
            line-height: 100%;
            padding: 0;
        }

        .share-button ul li .dropdown-menu li a {
            font-size: 14px;
            color: #02222e;
            font-weight: 600;
            height: 24px;
            width: 24px;
            line-height: 24px;
            text-align: center;
            background: #ffffff;
            border-radius: 100%;
            padding: 0;
        }

        .share-button ul li .dropdown-menu li a i {
            vertical-align: -2px;
        }

        @media(min-width:1200px) {
            .share-button ul li .dropdown-menu li a:hover {
                background: #dc1b30;
                color: #ffffff;
            }
        }

        .share-button .dropdown-toggle {
            font-size: 14px;
            font-weight: 600;
            color: #ffffff;
        }

        /*for header*/

        #fixed-header {
            background:#0d263c !important;
            width: 100%;
            height: 91px;
            position: fixed;
            top: 0;
            left: 0;
            transition: all 0.3s ease 0s;
            transform: translateY(-80px);
            z-index: 100;
        }
        #inner-header {
            z-index:111;
            width: 100%;
            /*height: 80px;*/
        }
        .detail .fixed.main-header{
            display: none;
            padding: 4px 0;
        }
        @media (max-width:1200px) {
            #fixed-header{
                transform:translateY(0px) !important;
            }
            .detail_page header nav{
                gap: 21px;
            }
            .detail_page header nav ul{
                gap: 12px;
            }
            .detail_page header nav .primary_btn{
                padding: 6px 38px;
            }
        }
        @media (max-width:468px) {
            .detail_page header nav{
                display: block;
            }
            #fixed-header{
                transform:translateY(-80px) !important;
            }
            .body_heart.remove-heart1 img, body_heart .heart img {
                max-width: 22px;
            }
        }

        /*header css start*/

        .detail_page header {
            position: fixed;
            width: 100%;
            background:#ffffff54 ;
            height: 50px;
            display: flex;
            align-items: center;
            z-index: 999;
        }
        .detail_page header .logo img {
            max-width: 200px;
            width: 200px;
        }
        .detail_page header .logo a {
            color: #f97794;
            text-decoration: none;
        }
        .detail_page header input {
            display: none;
        }
        .detail .menu>ul>.dropdown>a:after{
            right: 13px;
        }
        .detail_page header label {
            position: absolute;
            top: 0;
            right: 0;
            display: flex;
            margin-right: 2em;
            align-items: center;
            justify-content: center;
            height: 100%;
            background: #ec6325;
            height: 34px;
            width: 42px;
            margin-top: 10px;
            border-radius: 5px;
        }
        .detail_page header input, header label {
            display:none !important;
        }
        .detail_page header label span,
        .detail_page header label span:before,
        .detail_page header label span:after {
            position: relative;
            height: 2px;
            width: 1.3em;
            background: #fff;
            display: block;
        }
        .detail_page header label span:before,
        .detail_page header label span:after {
            content: "";
            position: absolute;
        }
        .detail_page header nav ul li:last-child {
            border-bottom:none;
        }
        .detail_page header label span:before {
            top: 7px;
        }
        .detail_page header label span:after {
            bottom: 7px;
        }
        .detail_page header nav {
            position: absolute;
            width: 100%;
            top: 100%;
            text-align: center;
            transform: scale(1, 0);
            transition: transform 500ms ease;
            transform-origin: top;
                display: flex;
    align-items: center;
    justify-content: space-between;
        }
        .detail_page header nav .primary_btn{
            margin-top: 0px;
        }
        .detail_page header nav ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .detail_page header nav ul li {
            padding: 10px;
            margin: 0px 12px;
        }
        .detail_page header nav ul li a {
            color: #fff;
            text-decoration: none;
            font-size: 17px;
            opacity: 0;
            transition: opacity 150ms ease-in-out;
        }
        .detail_page header nav ul li.active {
            transition: 1s ease-in 500ms;

        }
        .detail_page header nav ul li.active a {
            color: #ec6325;
        }
        .detail_page header nav ul li a:hover {
            color: #f36c39;
        }
        .detail_page header input:checked ~ nav {
            transform: scale(1, 1);
        }
        .detail_page header input:checked ~ nav a {
            opacity: 1;
            transition: opacity 150ms ease-in-out 250ms;
        }
        @media(max-width: 468px){
            .detail_page header input, header label {
    display: flex !important;
}
            .detail_page header .logo img{
                max-width: 150px;
                width: 175px;
            }
            .detail_page header{
                height: 71px;
                padding: 0px 15px;
                background: #0d263c;
            }
            .detail_page header nav ul li{
                border-bottom: 1px solid #ffffff4d;
            }
           .detail_page header label{
                top: 18px;
                right: 24px;
                margin: 0px;
               
            }
            .detail_page header nav{
                width: 90%;
                background: transparent;
                display: block !important;
            }
            .detail_page header nav ul{
                background: #0d263cf5;
                border-radius: 18px;
            }
        }
        @media (max-width:768px) {

            .detail_page header nav ul li a{
                font-size: 12px;
            }
        }
        @media (min-width:768px) {

            .detail_page header input, header label {
                display:none;
            }
            .detail_page header {
                display:grid;
                grid-template-columns:11px 255px 1fr 50px;
                align-content:center;
                height:85px;
            }
            .detail_page header .logo {
                grid-column:2/3;
                margin:0;
            }
            .detail_page header nav {
                position:static;
                transform:none;
                transition:none;
                grid-column:3/4;
            }
            .detail_page header nav ul {
                margin:0;
                padding:0;
                display:flex;
                justify-content:space-between;
                gap: 27px;
            }
            .detail_page header nav ul li {
                margin:0;
                padding:0;
            }
            .detail_page header nav ul li a {
                opacity:1;
            }
            .detail_page header nav ul li.active {
                background:none;
                transition:none;
            }
        }
        @media (min-width:992px) {

            .detail_page header {
                grid-gap:40px;
            }
        }

        @media (min-width:1200px) {

            .detail_page header  {
                grid-template-columns: 58px 285px 1fr 68px;
                grid-gap: 59px;
            }
        }
       
        /*header css end */
        
        
