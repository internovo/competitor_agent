<script>

var sitekey = $('.capphitcha').attr('data-sitekey');

// Execute reCAPTCHA v3
    grecaptcha.ready(function() {
        grecaptcha.execute(sitekey, { action: 'contact_store' }).then(function(token) {
            // Set the token value to the hidden input field
            document.getElementById('recaptcha_token').value = token;
           
        });
    });
    
   $(".agent-details-form").on('click', function (e) {
    e.preventDefault(); // Prevent default form submission

    var form = $('#sale_leads_form_popup');
    var button = $(this);

    // Trigger JsValidator validation manually
    form.validate().form();

    if (form.valid()) { // Ensure JsValidator validation passes
        button.prop('disabled', true); // Disable button to prevent multiple clicks
        button.css('pointer-events', 'none'); 

        form.submit(); // Submit form after validation
    }
});
    
</script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var content = document.getElementById('content_data');
        var button = document.getElementById('toggleButton');
        var isContentExpanded = false;

        // Check if the content exceeds the maximum height initially
        if (content.scrollHeight > parseInt(window.getComputedStyle(content).maxHeight)) {
            button.classList.add('show');
            content.classList.add('show');
        }

        function toggleContent() {
            // Toggle the 'show' class on content
            content.classList.toggle('show', isContentExpanded);

            // Toggle the 'show' class on content based on isContentExpanded
            if (!isContentExpanded) {
                // If content is expanded (Show Less clicked)
                content.style.maxHeight = content.scrollHeight + 'px';
            } else {
                // If content is collapsed (Show More clicked)
                content.style.maxHeight = null;
            }

            // Toggle the text content of the button
            button.textContent = isContentExpanded ? 'Show More' : 'Show Less';

            // Toggle the state
            isContentExpanded = !isContentExpanded;
        }

        // Attach the click event to the button
        button.addEventListener('click', toggleContent);
    });
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // Function to handle the first popup acceptance
    function acceptDisclaimer() {
        // Set a flag in local storage to remember acceptance
        localStorage.setItem('disclaimerAccepted', 'true');
        // Hide the first popup
        document.getElementById('userDisclimar').style.display = 'none';
        // Show the second popup after 10 seconds
       
    }

    // Function to handle the second popup acceptance
    function acceptPreferences() {
        // Set a flag in local storage to remember acceptance
        localStorage.setItem('preferencesAccepted', 'true');
        // Hide the second popup
        document.getElementById('userPreferencesBanner').style.display = 'none';
    }

    // Check if the user has already accepted the first popup
    if (!localStorage.getItem('disclaimerAccepted')) {
        // Show the first popup
        setTimeout(function () {
            document.getElementById('userDisclimar').style.display = 'block';
        }, 3000); // 10 seconds delay
    } 

    // Attach the functions to the respective buttons
    window.acceptDisclaimer = acceptDisclaimer;
    // window.acceptPreferences = acceptPreferences;
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
       
      let modalShown = false;

        // Open modal after 30 seconds if not already shown
        if (!modalShown) {
            setTimeout(function () {
                // Change title only for this timeout scenario
                const modalTitle = document.getElementById('exampleModalLabel');
                modalTitle.textContent = 'Receive a call back';

                // Show the modal
                $('#exampleModal').modal('show');

                // Set the value of the hidden input
                $('#cookie_pop_val').val('1');

                // Reset the title back to the default after the modal closes
                $('#exampleModal').on('hidden.bs.modal', function () {
                    modalTitle.textContent = 'Download Brochure';
                });

                // Update the flag to prevent multiple calls
                modalShown = true;
            }, 30000); // 30000 milliseconds = 30 seconds
        }
        
    });
    
    
    $('#inquiry_now').on('click',function(){
       
       const modalTitle = document.getElementById('exampleModalLabel');
                modalTitle.textContent = 'Get More Information';

                // Show the modal
                $('#exampleModal').modal('show');
       
    });
    
//    $('#accept_cookie_disclimar').on('click',function(){
//        $('#userDisclimar').hide();
//    })
</script>

<script>

        
        $(".agent-details-form").on('click', function(){
    
    $(this).css('pointer-events', 'none');
    setTimeout(function(){
     $(".primary_button").removeAttr('style');
 }, 1500);
