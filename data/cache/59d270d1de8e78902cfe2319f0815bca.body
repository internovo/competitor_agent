   /* ===== NEW PROJECT MENU ===== */

/* New Project trigger button */
.new-project-menu > a {
    border: 2px solid #4c5e6e;
    font-size: 15px;
    text-transform: capitalize;
    font-weight: 600;
    text-decoration: none;
    position: relative;
    font-family: "Jost", sans-serif;
    padding: 10px 32px 9px 23px;
    background: linear-gradient(90deg, rgb(249 50 50) 0%, rgba(247, 100, 33, 1) 38%);
    border-radius: 22px;
    color: #fff !important;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.new-project-menu > a:hover {
    opacity: 0.9;
    text-decoration: none;
    color: #fff !important;
}

/* Icomoon arrow */
.new-project-menu > a::after {
    display: inline-block !important;
    margin-left: 5px;
    position: absolute;
    content: "\e909" !important;
    top: 16px;
    right: 12px;
    font-family: icomoon !important;
    font-size: 12px;
    font-weight: 600;
    line-height: 100%;
    color: #fff;
}

.new-project-menu > a::before {
    display: none !important;
}

.new-project-menu > a .caret {
    display: none !important;
}

/* ===== DROPDOWN CONTAINER - WIDER ===== */
.new-project-menu .new-project-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    margin-top: 0px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    background: #fff !important;
    border: none !important;
    border-radius: 20px !important;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15) !important;
    padding: 16px 18px !important;
    min-width: auto !important;
width: fit-content !important;
max-width: 850px !important;
    list-style: none;
    flex-direction: row;
    gap: 0;
    justify-content: flex-start;
    animation: dropdownFadeIn 0.2s ease-in-out;
}

/* Invisible bridge */
.new-project-menu .new-project-dropdown::before {
    content: "";
    position: absolute;
    top: -18px;
    left: 0;
    right: 0;
    height: 18px;
    background: transparent;
}

@keyframes  dropdownFadeIn {
    from {
        opacity: 0;
        transform: translateX(-50%) translateY(-6px);
    }
    to {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }
}

/* Show on hover */
.new-project-menu:hover .new-project-dropdown,
.new-project-menu .new-project-dropdown:hover {
    display: flex !important;
}

/* ===== CITY COLUMNS - wider ===== */
.new-project-dropdown .menu-column {
    list-style: none;
     flex: 0 0 120px;                      /* equal width columns */
    min-width: 120px;               /* wider each column */
    padding: 0 12px 0 0;
    margin: 0 12px 0 0;
    border-right: 1px solid #f0f0f0;
    text-align: left;
}

.new-project-dropdown .menu-column:last-child {
    border-right: none;
    padding-right: 0;
    margin-right: 0;
}

/* ===== CITY HEADING ===== */
.new-project-dropdown .column-heading {
    font-size: 14px !important;
    font-weight: 700 !important;
    color: #000 !important;
    background: none !important;
    border-radius: 0 !important;
    border: none !important;
    margin: 0 0 6px 0 !important;
    padding: 0 0 6px 0 !important;
    border-bottom: 2px solid #f0f0f0 !important;
    display: block !important;
    box-shadow: none !important;
    text-transform: none !important;
}

.new-project-dropdown .column-heading a {
    font-size: 15px !important;
    font-weight: 700 !important;
    color: #e85d26 !important;
    background: none !important;
    border-radius: 0 !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: block !important;
    box-shadow: none !important;
    text-decoration: none !important;
    line-height: normal !important;
    font-family: "Jost", sans-serif !important;
    letter-spacing: 0.3px;
}

.new-project-dropdown .column-heading a:hover {
    color: #e85d26 !important;
}

/* ===== COLUMN LIST ===== */
.new-project-dropdown .column-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
}

.new-project-dropdown .column-list li {
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
    float: none !important;
    color: #0d263c !important;
    display: list-item !important;
    position: relative !important;
    list-style: none !important;
    background: none !important;
    border-radius: 8px !important;
    border: none !important;
    box-shadow: none !important;
    transition: background 0.2s ease;
}

.new-project-dropdown .column-list li:hover {
    background: #fff5f2 !important;
    border-radius: 8px !important;
}

/* ===== LINKS - more space for project names ===== */
.new-project-dropdown .column-list li a {
    position: relative !important;
    padding: 8px 5px 8px 0px !important;   /* more vertical padding */
    border-radius: 8px !important;
    transition: transform 0.3s ease-in-out, color 0.2s ease !important;
    background: transparent !important;
    border: none !important;
    display: flex !important;
    align-items: center !important;
    font-size: 14px !important;             /* slightly smaller for long names */
    font-weight: 600 !important;
    line-height: 140% !important;
    color: #0d263c !important;
    text-transform: capitalize !important;
    text-decoration: none !important;
    font-family: "Jost", sans-serif !important;
    box-shadow: none !important;
    width: 100% !important;
    text-align: left !important;
    white-space: nowrap;                    /* prevent wrapping */
}

/* Arrow on hover */
.new-project-dropdown .column-list li a::before {
    content: "›";
    position: absolute;
    left: -12px;
    color: #e85d26;
    font-size: 18px;
    line-height: 1;
    opacity: 0;
    transition: opacity 0.2s ease;
}

.new-project-dropdown .column-list li a:hover::before {
    opacity: 1;
}

.new-project-dropdown .column-list li a:hover {
    color: #e85d26 !important;
    background: transparent !important;
    text-decoration: none !important;
    transform: translateX(4px);
}
/* =========================================
   VIEW MORE STYLE
========================================= */

.new-project-dropdown .view-more-btn{
    margin-top: 10px !important;
    text-align: left !important;
}

.new-project-dropdown .view-more-btn:hover{
    background: transparent !important;
}

.new-project-dropdown .view-more-btn a{
    display: inline-block !important;

    padding: 0 !important;
    margin: 0 !important;

    background: transparent !important;
    border: none !important;
    box-shadow: none !important;

    color: #e85d26 !important;

    font-size: 14px !important;
    font-weight: 600 !important;

    text-decoration: none !important;

    border-radius: 0 !important;

    width: auto !important;

    transform: none !important;
}

.new-project-dropdown .view-more-btn a::before,
.new-project-dropdown .view-more-btn a::after{
    display: none !important;
}

.new-project-dropdown .view-more-btn a:hover{
    color: #ff5a1f !important;
    text-decoration: underline !important;

    background: transparent !important;
    box-shadow: none !important;
    transform: none !important;
}
