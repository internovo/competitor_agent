            /*overflow: hidden;*/
            font-family: "Jost", sans-serif;
            /*z-index: 99;*/
        }
        .detail_page:before{
            content: "";
            background-image: url(../assets/images/pattern-bg.png);
            background-position: center center;
            background-repeat: no-repeat;
            background-size: cover;
            opacity: 0.06;
            transition: background 0.3s, border-radius 0.3s, opacity 0.3s;
            position: absolute;
            height: 100%;
            width: 100%;
            z-index: -1;
        }
        .detail_page header {
            position: fixed;
            width: 100%;
            background:#ffffff54 ;
            height: 50px;
            display: flex;
            align-items: center;
            z-index: 999;
        }
        .detail_page header .logo img {
            max-width: 200px;
            width: 200px;
        }
        .detail_page header .logo a {
            color: #f97794;
            text-decoration: none;
        }
        .detail_page header input {
            display: none;
        }
       .detail .menu>ul>.dropdown>a:after{
                    right: 13px;
        }
        header label {
            position: absolute;
            top: 0;
            right: 0;
            display: flex;
            margin-right: 2em;
            align-items: center;
            justify-content: center;
            height: 100%;
            background: #ec6325;
            height: 34px;
            width: 42px;
            margin-top: 10px;
            border-radius: 5px;
        }
        .detail_page header label span,
        .detail_page header label span:before,
        .detail_page header label span:after {
            position: relative;
            height: 2px;
            width: 1.3em;
            background: #fff;
            display: block;
        }
        .detail_page header label span:before,
        .detail_page header label span:after {
            content: "";
            position: absolute;
        }
        .detail_page header nav ul li:last-child {
            border-bottom:none;
        }
        .detail_page header label span:before {
            top: 7px;
        }
        .detail_page header label span:after {
            bottom: 7px;
        }
        .detail_page header nav {
            position: absolute;
            width: 100%;
            top: 100%;
            text-align: center;
            transform: scale(1, 0);
            transition: transform 500ms ease;
            transform-origin: top;
                display: flex;
    align-items: center;
    justify-content: space-between;
        }
        .detail_page header nav .primary_btn{
            margin-top: 0px;
        }
        .detail_page header nav ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .detail_page header nav ul li {
            padding: 10px;
            margin: 0px 12px;
        }
        .detail_page header nav ul li a {
            color: #fff;
            text-decoration: none;
            font-size: 17px;
            opacity: 0;
            transition: opacity 150ms ease-in-out;
        }
        .detail_page header nav ul li.active {
            transition: 1s ease-in 500ms;

        }
        .detail_page header nav ul li.active a {
            color: #ec6325;
        }
        .detail_page header nav ul li a:hover {
            color: #f36c39;
        }
        .detail_page header input:checked ~ nav {
            transform: scale(1, 1);
        }
        .detail_page header input:checked ~ nav a {
            opacity: 1;
            transition: opacity 150ms ease-in-out 250ms;
        }
        @media(max-width: 468px){
            .detail_page header .logo img{
                max-width: 150px;
                width: 175px;
            }
