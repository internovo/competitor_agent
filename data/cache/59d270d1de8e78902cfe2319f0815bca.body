<style>
    /* Sample Houses - same floating button structure as Call */

.youtube-video-popup {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999999;
    align-items: center;
    justify-content: center;
}

.youtube-video-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
}

.youtube-video-content {
    position: relative;
    z-index: 2;
    width: 90%;
    max-width: 400px;
}

.youtube-video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
}

.youtube-video-wrapper iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
}

.youtube-video-close {
    position: absolute;
    top: -12px;
    right: -12px;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #ec6325;
    color: #fff;
    font-size: 24px;
    font-weight: 400;
    line-height: 30px;
    text-align: center;
    cursor: pointer;
    z-index: 9999;

    display: flex;
    align-items: center;
    justify-content: center;

    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.3);
}
.youtube-video-close:hover {
    background: #0d263c;
    color: #fff;
}

.youtube-video-close span {
    display: block;
    line-height: 1;
    transform: translateY(-1px);
}
@media (max-width: 767px) {
    .youtube-video-content {
        width: 85%;
        max-width: 360px;
    }

    .youtube-video-close {
        right: -5px;
        top: -45px;
    }
}
body #sample-houses_detail i {
    right: 0;
    bottom: 114px;
    width: 38px;
    height: 38px;
    color: #fff;
    border-radius: 50%;
    background-color: #ec6325;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: rgb(255 255 255 / 35%) 0px 5px 15px;
    font-size: 22px;
    font-weight: 900;
    transition: all 0.3s ease;
    box-sizing: border-box;
}

body #sample-houses_detail i img {
    width: 40px;
    height: 40px;
    object-fit: contain;
    display: block;
}

body #sample-houses_detail i:hover {
    background-color: #0d263c;
    transform: scale(1.05);
}

body #sample-houses_detail i {
    animation: sampleHouseBlink 1.2s infinite;
}

 .sample-house-video {
    position: relative;
    display: inline-block;
    animation: sampleHousePulse 3s infinite;
    border-radius: 50%;
}

.sample-house-video img {
    display: block;
    width: 46px;
    height: 46px;
    object-fit: contain;
    border-radius: 50%;
    transition: transform 0.3s ease;
}

.sample-house-video:hover {
    animation-play-state: paused;
}

.sample-house-video:hover img {
    transform: scale(1.1);
}

@keyframes  sampleHousePulse {
    0% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.2);
    }

    70% {
        transform: scale(1.05);
        box-shadow: 0 0 0 15px rgba(255, 255, 255, 0);
    }

    100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
    }
}
/* Mobile */
@media (max-width: 767px) {

    body #sample-houses_detail {
        right: 18px;
        bottom: 110px !important;
    }

  

   
}
