            }
            .estimate table tr td img{
                display:none;
            }
             .estimate table th:last-child{
                display: none;
            }
             .estimate .table-m{
                    overflow: visible;
                        height: auto;
            }
        }
        
        
        /* .estimate tr:nth-child(even){
        background-color: #f2f2f2
        }*/
        .estimate  table td:nth-child(1), table th:nth-child(1){
            border-right: none;
        }
         .estimate table td{
            text-align: center;
        }
        .estimate table td a{
            background: #fff;
            color: #0d263c;
            padding: 9px 5px;
            border-radius: 8px;
            border:2px solid #fff;
            box-shadow: rgb(255 255 255 / 33%) 0px 2px 5px -1px, rgb(255 255 255) 0px 1px 3px -1px;
        }
        .estimate table td a:hover{
            border:2px solid #fff;
            background-color: transparent;
            color: #fff;
        }
        table tbody tr:last-child {
            border-bottom: none;
        }
        .estimate .gallery-slider .gallery-img{
            border-radius: 24px;
            height: auto;
            overflow: hidden;
            box-shadow: rgb(255 255 255 / 11%) 0px 5px 15px;
            border: 2px solid #fff;
        }
        .estimate .gallery-slider .gallery-img .thumbnail_container{
                padding-bottom: 60%;
        }
        .estimate .row .col-md-6{
            overflow: hidden;
        }
       
        .estimate h2{
            margin: 3px 0px 20px 0px;
            text-align: center;
            color: #f36c39;
            font-size: 30px;
        }
       
        .gallery-slider.owl-carousel .owl-stage-outer{
            margin-bottom: 30px;
        }
        .gallery-slider.owl-carousel .owl-prev {
            left: 31%;
        }
        .gallery-slider.owl-carousel .owl-next {
            right: 31%;
        }
        .estimate .gallery-slider .gallery-img a:hover:before {
            opacity: .85;
        }
        .estimate .gallery-slider .gallery-img a:before {
            content: "";
            position: absolute;
            z-index: 1;
            width: 100%;
            height: 100%;
            bottom: 0;
            left: 0;
            top: 0;
            right: 0;
            background-color: #f36c39;
            opacity: 0;
            border-radius: 24px;
            transition: 375ms cubic-bezier(0.7, 0, 0.3, 1);
        }
        .estimate .gallery-slider .gallery-img a:hover:after {
            opacity: 1;
            transform: scale(1);
        }
        .estimate .gallery-slider .gallery-img a:after {
            content: '';
            /*background-color:#fff;*/
            position: absolute;
            width: 40px;
            height: 40px;
            left: 0;
            bottom: 0;
            top: 0;
            right: 0;
            margin: auto;
            background-image: url( ../assets/images/eye.png);
            background-repeat: no-repeat;
            background-size: 100%;
            background-position: center center;
            opacity: 0;
            transition: all 0.3s linear 0s;
            z-index: 1;
            transform: scale(0.2);
            transition-delay: .15s;
        }
        .estimate .gallery-slider .gallery-img a:hover img {
            transform: scale(1.15);
        }

        .estimate .gallery-slider .gallery-img a img {
            transform: scale(1.01);
            transition:375ms cubic-bezier(0.7, 0, 0.3, 1);
        }
        .estimate .desc{
            color: #ffffff;
            text-align: center;
