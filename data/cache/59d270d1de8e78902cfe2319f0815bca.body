<script>
    function syncInput(id) {
        const range = document.getElementById(`${id}_range`);
        const input = document.getElementById(id);
        input.value = range.value;
        calculate();
    }

    function syncRange(id) {
        const range = document.getElementById(`${id}_range`);
        const input = document.getElementById(id);
        range.value = input.value;
        calculate();
    }

    function roundToNearest10000(value) {
        return Math.round(value / 10000) * 10000;
    }

    function formatINR(value) {
        return '₹' + value.toLocaleString('en-IN');
    }

    function calculate() {
        let propertyInput = document.getElementById('property_price');
        let rangeInput = document.getElementById('property_price_range');

        let loanAmount = parseFloat(propertyInput.value);
        loanAmount = roundToNearest10000(loanAmount);

        let baseAmount = parseFloat(propertyInput.getAttribute('data-max'));
         let displayprice = document.getElementById('display_price');
        
        // MAX_LOAN_AMOUNT logic based on PHP
       let MAX_LOAN_AMOUNT = (displayprice.value.trim().toLowerCase() === 'price on request')  ? baseAmount : baseAmount + (baseAmount * 0.25);

        // Dynamically update range max to reflect 25% added or 2 Cr
        rangeInput.max = MAX_LOAN_AMOUNT;

        if (loanAmount > MAX_LOAN_AMOUNT) {
            loanAmount = MAX_LOAN_AMOUNT;
            propertyInput.value = loanAmount;
            rangeInput.value = loanAmount;
        }

        let interestRate = parseFloat(document.getElementById('interest_rate').value);
        let loanTermYears = parseFloat(document.getElementById('loan_term_years').value);

        let monthlyInterestRate = interestRate / 12 / 100;
        let numberOfPayments = loanTermYears * 12;

        let monthlyPayment = 0;
        let totalMortgagePaid = 0;
        let totalInterestPaid = 0;

        if (!isNaN(loanAmount) && !isNaN(interestRate) && !isNaN(loanTermYears)) {
            if (numberOfPayments !== 0 && monthlyInterestRate !== 0) {
                monthlyPayment = (loanAmount * monthlyInterestRate) / 
                    (1 - Math.pow(1 + monthlyInterestRate, -numberOfPayments));
                totalMortgagePaid = monthlyPayment * numberOfPayments;
                totalInterestPaid = totalMortgagePaid - loanAmount;
            }
        }

        document.getElementById('monthly_payment').innerText = '₹' +Math.max(0, Math.floor(monthlyPayment)).toLocaleString();
        document.getElementById('total_interest_paid').innerText = '₹' +Math.max(0, Math.floor(totalInterestPaid)).toLocaleString();
        document.getElementById('total_mortgage_paid').innerText = '₹' +Math.max(0, Math.floor(totalMortgagePaid)).toLocaleString();
    }

    window.onload = function () {
        calculate();
    };
    
    
    
    function updateRangeColor(slider) {
    const val = (slider.value - slider.min) / (slider.max - slider.min) * 100;

    slider.style.background = `linear-gradient(to right, #ff6600 0%, #ff6600 ${val}%, #ddd ${val}%, #ddd 100%)`;
}

// Initialize all sliders
const sliders = document.querySelectorAll('input[type="range"]');
sliders.forEach(slider => {
    updateRangeColor(slider); // initial set
    slider.addEventListener('input', () => updateRangeColor(slider));
});

</script>
<script>
$(document).on('click', '.sample-house-video', function () {

    let videoUrl = $(this).attr('data-video');

    if (!videoUrl) {
        return;
    }

    let videoId = '';

    // YouTube Shorts
    if (videoUrl.includes('/shorts/')) {
        videoId = videoUrl.split('/shorts/')[1].split(/[?&]/)[0];
    }

    // YouTube watch URL
    else if (videoUrl.includes('watch?v=')) {
        videoId = new URL(videoUrl).searchParams.get('v');
    }

    // YouTube short URL
    else if (videoUrl.includes('youtu.be/')) {
        videoId = videoUrl.split('youtu.be/')[1].split(/[?&]/)[0];
    }

    if (!videoId) {
        return;
    }

    // LOAD VIDEO ONLY AFTER CLICK
    $('#youtubeVideoFrame').attr(
        'src',
        'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0'
    );

    $('#youtubeVideoPopup').css('display', 'flex');

    $('body').css('overflow', 'hidden');
});


function closeYoutubePopup() {

    // Remove iframe source to STOP and unload video
    $('#youtubeVideoFrame').attr('src', '');

    $('#youtubeVideoPopup').hide();

    $('body').css('overflow', '');
}


$(document).on('click', '.youtube-video-close, .youtube-video-overlay', function () {
    closeYoutubePopup();
});


$(document).on('keydown', function (e) {
    if (e.key === 'Escape') {
        closeYoutubePopup();
    }
});
</script>

        
