		function BackButton(){
			let cur_url = window.location.href;
			if(typeof cur_url !=='undefined') {
				let flag_back = 1;
				if (cur_url.includes('#')) flag_back = 0;
				
				if (flag_back === 1) {
					var ref_url = document.referrer;
					var ref_domain = ref_url.replace('http://', '').replace('https://', '').split(/[/?#]/)[0];
					var hostname = window.location.hostname;
					var referrerCheck = hostname=='www.magicbricks.com' ? (ref_domain == "www.google.com" || ref_domain == "www.google.co.in") : true
					
					if (window.history && window.history.pushState && referrerCheck) {
						document.cookie = "fromPsmid=5047652";
					    document.cookie = "fromPsmCityName=Mumbai";
						window.history.pushState('oneStepAheadGoogleSrp', null, null);
						window.history.pushState('forward', null, null);
						window.onpopstate = function(event) {
							console.log(window.location.href);
							var currUrl=window.location.href;
							if(!currUrl.includes("#") && event.state=='oneStepAheadGoogleSrp'){
								window.location.replace('https://www.magicbricks.com/new-projects-Mumbai');
								history.pushState(null, null, ref_url);
							}	
						}
					}
				}
			}
		}

    </script>
	
	
	
