tom Hilton\u003C\u002Fa\u003E, \u003Ca href='https:\u002F\u002Fwww.magicbricks.com\u002Fsumit-kmr-param-borivali-west-mumbai-pdpid-4d4235343234303535' target='_blank'\u003ESumit KMR Param\u003C\u002Fa\u003E, \u003Ca href='https:\u002F\u002Fwww.magicbricks.com\u002Fnicco-vanashri-borivali-west-mumbai-pdpid-4d4235343236343639' target='_blank'\u003ENicco Vanashri\u003C\u002Fa\u003E, \u003Ca href='https:\u002F\u002Fwww.magicbricks.com\u002Fkalpataru-advay-borivali-west-mumbai-pdpid-4d4235343232383333' target='_blank'\u003EKalpataru Advay\u003C\u002Fa\u003E and \u003Ca href='https:\u002F\u002Fwww.magicbricks.com\u002Fim-the-crimson-borivali-west-mumbai-pdpid-4d4235343433373835' target='_blank'\u003EIM The Crimson\u003C\u002Fa\u003E are other popular residential projects near Neev Horizon.\r\n"},{"Which is nearest bus stop to Neev Horizon?":"Poisar Depot Bus Stop is located near to the Neev Horizon. It is the only nearest bus stop & is located at a distance of 2.3 Kms."},{"How many towers in Neev Horizon?":"Neev Horizon has a total of 1 towers in different unit configurations."},{"Where can I download the brochure PDF of Neev Horizon from?\r\n":"You can \u003Ca class='srp_qna_list' href='https:\u002F\u002Fwww.magicbricks.com\u002Fneev-horizon-borivali-west-mumbai-pdpid-4d4235303437363532#nav-overview' target='_blank'\u003Edownload the brochure of Neev Horizon\u003C\u002Fa\u003E visiting the Project page. "},{"What is the area pin code of Neev Horizon?":"The pin code for Neev Horizon in Borivali West, Mumbai is 400092."},{"Which is nearest metro station to Neev Horizon?":"The nearest metro station to Neev Horizon is Borivali (West) Metro Station. It is 1.6 Kms away from Neev Horizon."}],"qaListNoSchema":[]},"projectReviews":{"resultList":[],"count":"0","pageCount":null,"starWiseRatingMap":{}},"localityDetailsBean":{"localityDetailDTO":{"locName":"Borivali West","cityName":"Mumbai","locRank":"133","totalLoc":"3015","cityId":"4320","locId":"78844","reviewCount":"376","locIntroduction":"Situated in the northern part of Mumbai, Borivali West is a developed residential suburb that majorly caters to the upper-mid segment. The locality is located along the Western line of the Mumbai Suburban Railway and majorly hosts multi-storey apartments spread across various completed and under-construction projects. Also, there are several co-operative housing societies situated here. Prominent residential projects in the locality are Satra Park, Ajmera Pristine, and Paradigm Ananda Residency.","locPhysicalInfra":"The locality shares widespread connectivity through the SV Road, Link Road and Western Express Highway. Also, the area is directly connected through Borivali Railway Station placed on the western line of the Mumbai suburban railway network. Besides, there is sufficient availability of BEST buses and auto rickshaws in the locality. Moreover, the under-construction metro Line 2 (Dahisar-Mandale) is expected to boost connectivity with the rest of the city and is scheduled to be completed by 2020.","locSocialInfra":"In terms of social infrastructure, Borivali West comprises of several schools, hospitals, shopping malls, market complexes and banks. Some of the prominent schools in the neighbourhood are Don Bosco High School, Swami Vivekanand International School and St. Xavier's High School. Besides, major hospitals include Karuna Hospital, Apex Superspeciality Hospitals and Lotus Multispeciality Hospital. Also, popular shopping avenues here are Zoom Plaza Mall, Moksh Plaza Mall, Raghuleela Mega Mall, and Reliance Mall.","locNearbyHubs":"The locality has connectivity with the prominent job hubs situated across the areas of Malad, Goregaon and Andheri, which are accessible through the SV Road, Link Road and Western Express Highway. These include Infinity IT Park, Express Zone, Mindspace Malad, NESCO IT Park and Blue Rose Industrial Estate, among others.Source : Magicbricks Research","pros1":"Police patrolling during nights enhances security","pros2":"Ample presence of schools, hospitals, shopping centres, malls and banks, within the neighbourhood offers ease of living to its residents and makes it a preferred residential locality.","pros3":"Extensively connected with prominent areas of Mumbai and key employment centres through road and western suburban railway line. Upcoming metro Line 2 to further improve connectivity in the region.","locAvgNew":4.2,"ratingUsersCount":342,"quarterPrice":{"currentQuarterPrice":25003,"prevQuarterPrice":24363},"percentageQuarterGrowth":2.6,"localityFactoidBean":[{"catId":"19202","catDesc":"Educational Institute","name":["St Francis Institute of Technology","Orchids the International School","St. Francis Institute of Technology","MKVV","Swami Vivekanand International School"],"priority":1,"eachCategoryFactoidList":[{"distanceFromProject":"2.1","latitude":"19.2435526","name":"St Francis Institute of Technology","longitude":"72.8557971"},{"distanceFromProject":"2.0","latitude":"19.2436","name":"St. Francis Institute of Technology","longitude":"72.8554"},{"distanceFromProject":"1.4","latitude":"19.2273979","name":"MKVV","longitude":"72.8509626"},{"distanceFromProject":"1.1","latitude":"19.2269614","name":"Swami Vivekanand International School","longitude":"72.830823"}]},{"catId":"19210","catDesc":"Transportation Hub","name":["Poisar Depot Bus Stop","Borivali (West) Metro Station"],"priority":2,"eachCategoryFactoidList":[{"distanceFromProject":"2.5","latitude":"19.2137","name":"Poisar Depot Bus Stop","longitude":"72.8508"},{"distanceFromProject":"0.3","latitude":"19.23137984","name":"Borivali (West) Metro Station","longitude":"72.84085863"}]},{"catId":"19206","catDesc":"Shopping Centre","name":["Moksh Plaza Mall","Maxus Cinemas","Zoom Plaza Mall","N-MORE"],"priority":3,"eachCategoryFactoidList":[{"distanceFromProject":"1.9","latitude":"19.224943","name":"Moksh Plaza Mall","longitude":"72.8543519999999"},{"distanceFromProject":"1.1","latitude":"19.2320295","name":"Zoom Plaza Mall","longitude":"72.828846"},{"distanceFromProject":"1.3","latitude":"19.23574389","name":"N-MORE","longitude":"72.85138735"}]},{"catId":null,"catDesc":"Nearby Localities","name":["Devidas Road, Mumbai","Shivaji Nagar Vazira, Mumbai","New MHB Colony, Mumbai","Koliwada Vazira, Mumbai","Maharashtra Nagar Borivali West, Mumbai","Kastur Park, Mumbai"],"priority":4,"eachCategoryFactoidList":[{"distanceFromProject":"1.2","latitude":"19.238403","name":"Devidas Road, Mumbai","longitude":"72.84907"},{"distanceFromProject":"1.1","latitude":"19.22493","name":"Shivaji Nagar Vazira, Mumbai","longitude":"72.84338"},{"distanceFromProject":"0.7","latitude":"19.227144","name":"New MHB Colony, Mumbai","longitude":"72.83932"},{"distanceFromProject":"0.7","latitude":"19.227896","name":"Koliwada Vazira, Mumbai","longitude":"72.84271"},{"distanceFromProject":"1.4","latitude":"19.229965","name":"Maharashtra Nagar Borivali West, Mumbai","longitude":"72.85154"},{"distanceFromProject":"1.4","latitude":"19.22279","name":"Kastur Park, Mumbai","longitude":"72.8463"}]},{"catId":"19203","catDesc":"Hospital","name":["Karuna General And Maternity Hospital"],"priority":6,"eachCategoryFactoidList":[{"distanceFromProject":"1.7","latitude":"19.2415037","name":"Karuna General And Maternity Hospital","longitude":"72.8531175"}]},{"catId":"19201","catDesc":"Commercial Hub","name":["Water Kingdom"],"priority":8,"eachCategoryFactoidList":[{"distanceFromProject":"3.3","latitude":"19.23177313","name":"Water Kingdom","longitude":"72.80822307"}]}],"seoname":"Borivali West","videoUrls":"https:\u002F\u002Fwww.youtube.com\u002Fembed\u002FJPRCHeKcsfY","roadRating":4.2,"neighbourRating":4.2,"safetyRating":4.3,"cleanRating":4.2,"transportRating":4.3,"parkingRating":4,"connectivityRating":4.3,"trafficRating":3.3,"schoolRating":4.3,"restuarantRating":4.3,"hospitalRating":4.3,"marketRating":4.3,"environment":4.2,"commuting":4,"placeOfInterest":4.3,"images":{"$localityName":"2026\u002FAug\u002F26\u002FPhoto_h600_w900\u002F78844