        beaconSent = true;
        try {
          var IDLE = 30 * 60 * 1000;
          var stored = null;
          try { stored = JSON.parse(localStorage.getItem('sqy_pulse_session') || 'null'); } catch (e) {}
          var fresh = !(stored && stored.id && (Date.now() - (stored.last_ts || 0) <= IDLE));
          if (fresh) {
            
            
            stored = { id: uuidv4(), start_ts: Date.now(), last_ts: Date.now(), seq: 0, stub: true };
            try { localStorage.setItem('sqy_pulse_session', JSON.stringify(stored)); } catch (e) {}
          }
          var evs = [];
          
          if (fresh) evs.push({ event: 'session_start', ts: Date.now(), seq: 0, props: { early: true } });
          evs.push({ event: 'page_view', ts: Date.now(), seq: 0, props: { early: true, entry: fresh } });
          
          try { sessionStorage.setItem('sqy_pulse_early_pv', location.pathname + location.search); } catch (e) {}
          fetch('/sy-pulse/events', {
            method: 'POST', keepalive: true, credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
