<style id="wp-custom-css">
body.thank-you,
body.thank-you-main,
body.thank-you-tour {
	header {
		background-color: #000;
	}
}

.sticky-btn {
	position: fixed;
	bottom: -10rem;
	right: 1rem;
	display: block;
	width: 3rem;
	height: 3rem;
	background: #c7b07b;
	padding: 0.5rem;
	border-top-right-radius: 3px;
	border-top-left-radius: 3px;
	z-index: 999;
	box-shadow: 0 -1px 5px 1px rgba(0,0,0,0.3);
	transition: all 0.5s ease-in-out;
}

.sticky-btn.show {
	bottom: 0;
}

.gfield_captcha_container {
	display: flex;
	flex-flow: row wrap;
	gap: 0 1rem;
}

.gfield--type-captcha {
	text-align: left;
}

.post-password-form {
	padding: 10rem 0;
	max-width: 800px;
	margin: 0 auto;
}

.top-bar .top-bar-right .menu .menu-residences {
	margin-right: 0 !important;
}

body.home .marquee p,
body.home-updates .marquee p{
	max-width: 750PX !important;
}
</style>
