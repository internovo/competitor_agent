      <div class="top-bar-left show-for-large">
                  <a class="brand" href="https://blackrockestatesut.com/" title="Black Rock Estates">
            <img src="/wp-content/uploads/2024/06/logo-2.svg" alt="">
          </a>
              </div>
      <div class="top-bar-right">
        <ul id="menu-main-navigation" class="menu"><li class="menu-item menu-location"><a href="https://blackrockestatesut.com/location/">Location</a></li>
<li class="active menu-item menu-amenities"><a href="https://blackrockestatesut.com/amenities/" aria-current="page">Amenities</a></li>
<li class="menu-item menu-residences"><a href="https://blackrockestatesut.com/residences/">Residences</a></li>
