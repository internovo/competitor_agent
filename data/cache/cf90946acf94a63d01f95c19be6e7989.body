extContent = galleryData[idx].desc; lb.classList.add('open'); document.body.style.overflow = 'hidden'; } function closeLightbox() { document.getElementById('lightbox').classList.remove('open'); document.body.style.overflow = ''; } function navLightbox(dir) { lbIdx = (lbIdx + dir + galleryData.length) % galleryData.length; document.getElementById('lightbox-img').src = galleryData[lbIdx].url; document.getElementById('lightbox-caption').textContent = galleryData[lbIdx].desc; } document.getElementById('lightbox').addEventListener( 'click', e => { if (e.target.id === 'lightbox') closeLightbox(); }); document.addEventListener('keydown', e => { if (!document.getElementById('lightbox') .classList.contains('open')) return; if (e.key === 'Escape') closeLightbox(); if (e.key === 'ArrowLeft') navLightbox(-1); if (e.key === 'ArrowRight') navLightbox(1); }); /* ── Formatters ─────────────────────────────── */ function fmtINR(n) { if (n >= 10000000) return '₹' + (n / 10000000).toFixed(2) + ' Cr'; if (n >= 100000) return '₹' + (n / 100000).toFixed(2) + ' L'; return '₹' + n.toLocaleString('en-IN'); } /* ── EMI Calculator ─────────────────────────── */ function calcEMI() { const P = parseFloat(document.getElementById('emi-price').value) || 0; const dp = parseFloat(document.getElementById('emi-down').value) || 0; const r = parseFloat(document.getElementById('emi-rate').value) || 0; const n = parseInt(document.getElementById('emi-years').value) || 0; const loan = P * (1 - dp / 100); const mr = r / 12 / 100; const months = n * 12; if (P <= 0 || months <= 0) { document.getElementById('emi-value').textContent = 'Enter a property price'; document.getElementById('emi-loan').textContent = '—'; document.getElementById('emi-interest').textContent = '—'; return 0; } let emi = 0; if (mr > 0 && months > 0) { emi = loan * mr * Math.pow(1 + mr, months) / (Math.pow(1 + mr, months) - 1); } else if (months > 0) { emi = loan / months; } const totalInt = emi * months - loan; document.getElementById('emi-value').textContent = fmtINR(Math.round(emi)); document.getElementById('emi-loan').textContent = fmtINR(Math.round(loan)); document.getElementById('emi-interest').textContent = fmtINR(Math.round(totalInt)); return emi; } document.querySelectorAll('#emi-price,#emi-down,#emi-rate,#emi-years') .forEach(el => el.addEventListener('input', calcEMI)); calcEMI(); /* ── Rent vs Buy ───────────────────────────── */ function calcRVB() { const P = parseFloat(document.getElementById('rvb-price').value) || 0; const rent = parseFloat(document.getElementById('rvb-rent').value) || 0; const appr = parseFloat(document.getElementById('rvb-appr').value) || 0; const v = document.getElementById('rvb-verdict'); if (P <= 0 || rent <= 0) { document.getElementById('rvb-rent-cost').textContent = '—'; document.getElementById('rvb-buy-cost').textContent = '—'; v.textContent = 'Enter a supported property price and comparable monthly rent to calculate.'; v.style.background = '#f8fafc'; v.style.borderColor = '#cbd5e1'; return; } const loan = P * 0.8; const mr = 8.5 / 12 / 100; const months = 240; let emi = 0; if (mr > 0) emi = loan * mr * Math.pow(1 + mr, months) / (Math.pow(1 + mr, months) - 1); const monthlyAppr = P * appr / 100 / 12; const netBuy = Math.round(emi - monthlyAppr); document.getElementById('rvb-rent-cost').textContent = fmtINR(rent); document.getElementById('rvb-buy-cost').textContent = fmtINR(Math.max(0, netBuy)); if (rent < netBuy) { v.innerHTML = '🏠 <strong>Renting is cheaper</strong> by ' + fmtINR(netBuy - rent) + '/mo — but you don\'t build equity.'; v.style.background = '#fef3c7'; v.style.borderColor = '#fcd34d'; } else { v.innerHTML = '🏢 <strong>Buying makes more sense</strong> — EMI net of appreciation is ' + fmtINR(rent - netBuy) + '/mo less than rent.'; v.style.background = '#d1fae5'; v.style.borderColor = '#6ee7b7'; } } document.querySelectorAll('#rvb-price,#rvb-rent,#rvb-appr') .forEach(el => el.addEventListener('input', calcRVB)); calcRVB(); /* ── Property Tab Switcher ──────────────────── */ function switchPropTab(btn, panelId) { document.querySelectorAll('.prop-mini-tab').forEach(t => t.classList.remove('active')); document.querySelectorAll('.prop-mini-panel').forEach(p => p.classList.remove('active')); btn.classList.add('active'); const panel = document.getElementById(panelId); if (panel) panel.classList.add('active'); } /* ── Lazy-load market data via AJAX ─────────── */ let marketLoaded = false; const loc = 'Borivali West'; const locSlug = loc.toLowerCase().replace(/\s+/g, '-'); function loadMarketData() { if (marketLoaded) return; marketLoaded = true; fetch('/api/project-market/' + encodeURIComponent(loc)) .then(r => r.json()) .then(d => { const grid = document.getElementById('rate-grid'); const loading = document.getElementById('rates-loading'); if (loading) loading.remove(); let rateHtml = ''; const fmtR = n => '₹' + Number(n).toLocaleString('en-IN'); if (d.prop_rates) { const r = d.prop_rates; if (r.sector) rateHtml += `<div class="rate-card" style="grid-column:1/-1;background:var(--navy-50)"><div class="rate-lbl" style="font-weight:700;color:var(--navy-900)">${r.location} · ${r.sector}</div></div>`; if (r.res_outright_min > 0) rateHtml += `<div class="rate-card"><div class="rate-val">${fmtR(r.res_outright_min)} — ${fmtR(r.res_outright_max)}</div><div class="rate-lbl">Residential Rate (₹/sqft)</div></div>`; if (r.res_lease_1bhk_min > 0) rateHtml += `<div class="rate-card"><div class="rate-val">${fmtR(r.res_lease_1bhk_min)} — ${fmtR(r.res_lease_1bhk_max)}</div><div class="rate-lbl">1 BHK Rent/mo</div></div>`; if (r.res_lease_2bhk_min > 0) rateHtml += `<div class="rate-card"><div class="rate-val">${fmtR(r.res_lease_2bhk_min)} — ${fmtR(r.res_lease_2bhk_max)}</div><div class="rate-lbl">2 BHK Rent/mo</div></div>`; if (r.res_lease_3bhk_min > 0) rateHtml += `<div class="rate-card"><div class="rate-val">${fmtR(r.res_lease_3bhk_min)} — ${fmtR(r.res_lease_3bhk_max)}</div><div class="rate-lbl">3 BHK Rent/mo</div></div>`; if (r.res_lease_4bhk_min > 0) rateHtml += `<div class="rate-card"><div class="rate-val">${fmtR(r.res_lease_4bhk_min)} — ${fmtR(r.res_lease_4bhk_max)}</div><div class="rate-lbl">4 BHK Rent/mo</div></div>`; if (r.comm_outright_min > 0) rateHtml += `<div class="rate-card"><div class="rate-val">${fmtR(r.comm_outright_min)} — ${fmtR(r.comm_outright_max)}</div><div class="rate-lbl">Commercial Rate (₹/sqft)</div></div>`; if (r.comm_lease_min > 0) rateHtml += `<div class="rate-card"><div class="rate-val">${fmtR(r.comm_lease_min)} — ${fmtR(r.comm_lease_max)}</div><div class="rate-lbl">Commercial Lease (₹/sqft/mo)</div></div>`; } else { if (d.avg_rent && d.avg_rent.cnt > 0) { rateHtml += `<div class="rate-card"><div class="rate-val">${fmtR(d.avg_rent.avg_val)}</div><div class="rate-lbl">Avg Monthly Rent</div><div class="rate-range">${fmtR(d.avg_rent.min_val)} — ${fmtR(d.avg_rent.max_val)}</div></div>`; rateHtml += `<div class="rate-card"><div class="rate-val">${Number(d.avg_rent.cnt).toLocaleString('en-IN')}</div><div class="rate-lbl">Rental Listings</div></div>`; } if (d.avg_sale && d.avg_sale.cnt > 0) { rateHtml += `<div class="rate-card"><div class="rate-val">${fmtR(d.avg_sale.avg_val)}</div><div class="rate-lbl">Avg Sale Price</div><div class="rate-range">${fmtR(d.avg_sale.min_val)} — ${fmtR(d.avg_sale.max_val)}</div></div>`; rateHtml += `<div class="rate-card"><div class="rate-val">${Number(d.avg_sale.cnt).toLocaleString('en-IN')}</div><div class="rate-lbl">Sale Listings</div></div>`; } } grid.insertAdjacentHTML('beforeend', rateHtml); const container = document.getElementById('props-container'); const imgCdn = 'https://www.mumbaipropertyexchange.com/img/building-properties/'; function propCard(p) { const href = '/property/' + p.id; const bed = p.bedrooms ? ((/^\d/.test(String(p.bedrooms)) && !/bhk|rk/i.test(p.bedrooms)) ? p.bedrooms + ' BHK' : p.bedrooms) : ''; const imgUrl = p.img || (p.building_id ? imgCdn + p.building_id + '/Main.jpg?width=400&height=300&mode=crop' : ''); const imgFb1 = p.building_id ? 'https://www.mumbaipropertyexchange.com/img/projects/' + p.building_id + '/' + p.building_id + '-main.webp' : ''; const imgFb2 = p.building_id ? 'https://www.mumbaipropertyexchange.com/img/buildingImages/' + p.building_id + '/Main.jpg' : ''; const placeholder = `<div style="width:100%;height:140px;background:linear-gradient(135deg,#1a1a2e,#16213e);border-radius:8px 8px 0 0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:rgba(212,175,55,.7);font-size:.85rem;font-weight:600;padding:10px;text-align:center;gap:6px">${p.building || '🏠'}</div>`; const imgTag = imgUrl ? `<img src="${imgUrl}" alt="${p.building}" loading="lazy" data-fb1="${imgFb1}" data-fb2="${imgFb2}" style="width:100%;height:140px;object-fit:cover;border-radius:8px 8px 0 0" onerror="if(this.dataset.fb1){var f=this.dataset.fb1;delete this.dataset.fb1;this.setAttribute('src',f)}else if(this.dataset.fb2){var f=this.dataset.fb2;delete this.dataset.fb2;this.setAttribute('src',f)}else{this.outerHTML=this.dataset.ph}" data-ph='${placeholder.replace(/'/g, "&#39;")}'>` : placeholder; return `<a href="${href}" class="property-card" style="text-decoration:none"> ${imgTag} <div class="property-card-body"><div class="property-type">${p.condition}</div><div class="property-title">${bed ? bed + ' ' : ''}${p.building}</div><div class="property-location">${p.location}</div><div class="property-footer"><div><div class="property-price">${p.price || 'Price on Request'}</div> ${p.area ? '<div class="property-price-sub">' + p.area + ' sq.ft.</div>' : ''} </div></div></div></a>`; } const rental = d.rental || []; const sale = d.sale || []; const commercial = d.commercial || []; let tabs = '<div class="prop-mini-tabs">'; let panels = ''; let first = true; if (rental.length) { tabs += `<button class="prop-mini-tab${first ? ' active' : ''}" onclick="switchPropTab(this,'panel-rental')">🏠 Rent (${rental.length})</button>`; panels += `<div class="prop-mini-panel${first ? ' active' : ''}" id="panel-rental"><div class="prop-mini-grid">${rental.map(p => propCard(p)).join('')}</div><div style="text-align:center;margin-top:1rem"><a href="${'/apartments-flats-house/rent/'+locSlug}" class="btn btn-outline">View All Rentals →</a></div></div>`; first = false; } if (sale.length) { tabs += `<button class="prop-mini-tab${first ? ' active' : ''}" onclick="switchPropTab(this,'panel-sale')">🏢 Sale (${sale.length})</button>`; panels += `<div class="prop-mini-panel${first ? ' active' : ''}" id="panel-sale"><div class="prop-mini-grid">${sale.map(p => propCard(p)).join('')}</div><div style="text-align:center;margin-top:1rem"><a href="${'/apartments-flats-house/sale/'+locSlug}" class="btn btn-outline">View All Sales →</a></div></div>`; first = false; } if (commercial.length) { tabs += `<button class="prop-mini-tab${first ? ' active' : ''}" onclick="switchPropTab(this,'panel-commercial')">🏬 Commercial (${commercial.length})</button>`; panels += `<div class="prop-mini-panel${first ? ' active' : ''}" id="panel-commercial"><div class="prop-mini-grid">${commercial.map(p => propCard(p)).join('')}</div><div style="text-align:center;margin-top:1rem"><a href="${'/commercial-office-premises/rent/'+locSlug}" class="btn btn-outline">View All Commercial →</a></div></div>`; } tabs += '</div>'; if (rental.length || sale.length || commercial.length) { container.innerHTML = tabs + panels; } else { container.innerHTML = '<div style="color:var(--text-muted);padding:20px;text-align:center">No properties found in this area.</div>'; } }) .catch(() => { const loading = document.getElementById('rates-loading'); if (loading) loading.innerHTML = '<div style="color:var(--text-muted);font-size:.85rem">Could not load market data.</div>'; document.getElementById('props-container').innerHTML = '<div style="color:var(--text-muted);padding:20px;text-align:center">Could not load properties.</div>'; }); } const observer = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) { loadMarketData(); observer.disconnect(); } }); }, { rootMargin: '200px' }); observer.observe(document.getElementById('market-rates-section'));</script><style>@media (max-width:767px){body{padding-bottom:76px !important}}</style><script>(function () { var e = document.getElementById('tb-email'); if (e) { e.textContent = 'ssadh' + '@' + 'mumbaipropertyexchange' + '.com'; } })();</script><div class="cookie-banner" id="cookieBanner"><div class="cookie-inner"><div class="cookie-text"><p>We use cookies to improve your experience.</p></div><div class="cookie-actions"><button class="cookie-btn cookie-accept" onclick="acceptCookies()">Accept</button><button class="cookie-btn cookie-decline" onclick="declineCookies()">Decline</button></div></div></div><style>.cookie-banner{position:fixed;bottom:80px;left:0;right:0;z-index:9980;display:none;padding:0 1rem;animation:cookieSlideUp .4s ease}@media (min-width:769px){.cookie-banner{bottom:20px}.cookie-inner{margin:0 auto}}@keyframes cookieSlideUp{from{transform:translateY(100%);opacity:0}to{transform:translateY(0);opacity:1}}.cookie-inner{max-width:720px;margin:0 64px 0 0;display:flex;align-items:center;gap:10px;padding:8px 12px;background:rgba(10,22,40,.95);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.08);border-radius:10px;box-shadow:0 8px 32px rgba(0,0,0,.3)}.cookie-text{display:flex;align-items:center;gap:10px;flex:1}.cookie-text p{margin:0;font-size:.72rem;color:rgba(255,255,255,.75);line-height:1.4}.cookie-text strong{color:#fff}.cookie-actions{display:flex;gap:8px;flex-shrink:0}.cookie-btn{padding:6px 14px;border-radius:8px;font-size:.75rem;font-weight:700;cursor:pointer;border:none;transition:transform .15s,box-shadow .2s}.cookie-btn:hover{transform:translateY(-1px)}.cookie-accept{background:linear-gradient(135deg,var(--gold-500),var(--gold-600));color:#fff}.cookie-accept:hover{box-shadow:0 4px 14px rgba(212,175,55,.4)}.cookie-decline{background:rgba(255,255,255,.08);color:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.12)}.cookie-decline:hover{background:rgba(255,255,255,.12);color:#fff}@media (max-width:480px){.cookie-inner{padding:7px 10px;gap:8px}.cookie-btn{padding:6px 12px}}</style><script>(function () { var consent = localStorage.getItem('cookie_consent'); if (!consent) { setTimeout(function () { document.getElementById('cookieBanner').style.display = 'block'; }, 2000); } })(); function acceptCookies() { localStorage.setItem('cookie_consent', 'accepted'); document.getElementById('cookieBanner').style.display = 'none'; loadGA4(); } function declineCookies() { localStorage.setItem('cookie_consent', 'declined'); document.getElementById('cookieBanner').style.display = 'none'; }</script><style id="mpe-concierge">.mc-bubble{position:fixed;bottom:16px;right:16px;z-index:9998;width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#d4af37,#b8962e);color:#fff;border:none;cursor:pointer;box-shadow:0 4px 20px rgba(212,175,55,.4);display:flex;align-items:center;justify-content:center;font-size:24px;transition:all .3s;animation:mc-breathe 3s ease-in-out infinite}.mc-bubble:hover{transform:scale(1.1);box-shadow:0 6px 28px rgba(212,175,55,.5)}@keyframes mc-breathe{0%,100%{box-shadow:0 4px 20px rgba(212,175,55,.4)}50%{box-shadow:0 4px 30px rgba(212,175,55,.6)}}.mc-nudge{position:fixed;bottom:80px;right:16px;z-index:9998;background:#1a1a2e;border-radius:16px 16px 4px 16px;padding:12px 16px;max-width:280px;box-shadow:0 4px 20px rgba(0,0,0,.3);font-size:.82rem;color:#e2e8f0;line-height:1.5;display:none;animation:mc-slide .4s ease;border:1px solid rgba(212,175,55,.2);cursor:pointer}.mc-nudge::after{content:'';position:absolute;bottom:-6px;right:24px;width:12px;height:12px;background:#1a1a2e;transform:rotate(45deg);border-right:1px solid rgba(212,175,55,.2);border-bottom:1px solid rgba(212,175,55,.2)}@keyframes mc-slide{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}.mc-nudge-close{position:absolute;top:4px;right:8px;background:none;border:none;color:#a8a29e;cursor:pointer;font-size:.7rem}.mc-panel{position:fixed;bottom:16px;right:16px;z-index:9999;width:370px;max-width:calc(100vw - 32px);height:520px;max-height:calc(100vh - 100px);background:#0f0f1a;border-radius:20px;box-shadow:0 10px 40px rgba(0,0,0,.4);display:none;flex-direction:column;overflow:hidden;animation:mc-open .3s ease;border:1px solid rgba(212,175,55,.15)}@keyframes mc-open{from{opacity:0;transform:translateY(20px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}@media(max-width:768px){.mc-panel{width:calc(100vw - 16px);right:8px;bottom:8px;height:calc(100vh - 80px);border-radius:16px}.mc-bubble{bottom:80px}.mc-nudge{bottom:144px}button[onclick="viewShortlist()"]{bottom:136px !important}}.mc-header{background:linear-gradient(135deg,#d4af37,#b8962e);color:#fff;padding:16px 18px;display:flex;align-items:center;gap:10px}.mc-avatar{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:18px}.mc-name{font-weight:600;font-size:.95rem}.mc-status{font-size:.72rem;opacity:.85}.mc-close{margin-left:auto;background:none;border:none;color:#fff;font-size:20px;cursor:pointer;opacity:.8}.mc-close:hover{opacity:1}.mc-messages{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px}.mc-msg{max-width:85%;padding:10px 14px;border-radius:14px;font-size:.85rem;line-height:1.5;animation:mc-slide .3s ease}.mc-msg.bot{background:#1e1e30;color:#e2e8f0;align-self:flex-start;border-bottom-left-radius:4px}.mc-msg.user{background:linear-gradient(135deg,#d4af37,#b8962e);color:#fff;align-self:flex-end;border-bottom-right-radius:4px}.mc-qr{display:flex;flex-wrap:wrap;gap:6px;padding:0 16px 12px}.mc-qr-btn{background:rgba(212,175,55,.12);color:#d4af37;border:1px solid rgba(212,175,55,.25);border-radius:20px;padding:7px 14px;font-size:.78rem;cursor:pointer;transition:all .2s;white-space:nowrap}.mc-qr-btn:hover{background:rgba(212,175,55,.25);transform:translateY(-1px)}.mc-input-row{padding:10px 14px;border-top:1px solid rgba(255,255,255,.06);display:flex;gap:8px}.mc-input{flex:1;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:8px 14px;color:#e2e8f0;font-size:.85rem;outline:none}.mc-input::placeholder{color:rgba(255,255,255,.3)}.mc-send{background:linear-gradient(135deg,#d4af37,#b8962e);color:#fff;border:none;border-radius:50%;width:36px;height:36px;cursor:pointer;font-size:16px}</style><div class="mc-nudge" id="mc-nudge" onclick="openMC()"><button class="mc-nudge-close" onclick="event.stopPropagation();document.getElementById('mc-nudge').style.display='none'">&times;</button>
 👋 Looking for the right project? Let me help you find it!
</div><button class="mc-bubble" id="mc-bubble" onclick="toggleMC()" aria-label="Project concierge"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></button><div class="mc-panel" id="mc-panel"><div class="mc-header"><div class="mc-avatar">🏗️</div><div><div class="mc-name">MPE Project Advisor</div><div class="mc-status">● Online now</div></div><button class="mc-close" onclick="closeMC()">&times;</button></div><div class="mc-messages" id="mc-messages"></div><div class="mc-qr" id="mc-qr"></div><div class="mc-input-row"><input class="mc-input" id="mc-input" placeholder="Type a message..." onkeydown="if(event.key==='Enter')sendMCMsg()"><button class="mc-send" onclick="sendMCMsg()">➤</button></div></div><script>(function(){ var panel=document.getElementById('mc-panel'), bubble=document.getElementById('mc-bubble'), nudge=document.getElementById('mc-nudge'), msgs=document.getElementById('mc-messages'), qr=document.getElementById('mc-qr'), inp=document.getElementById('mc-input'), open=false; window._bjData = window._bjData || {}; setTimeout(function(){ nudge.style.display='block'; }, 5000); setTimeout(function(){ nudge.style.display='none'; }, 18000); window.toggleMC=function(){open?closeMC():openMC()}; window.openMC=function(){ panel.style.display='flex';bubble.style.display='none';nudge.style.display='none';open=true; if(!msgs.children.length) showWelcome(); }; window.closeMC=function(){panel.style.display='none';bubble.style.display='flex';open=false;}; function addMsg(text,isUser){ var d=document.createElement('div'); d.className='mc-msg '+(isUser?'user':'bot'); d.innerHTML=text;msgs.appendChild(d);msgs.scrollTop=msgs.scrollHeight; } function setQR(btns){ qr.innerHTML=''; btns.forEach(function(b){ var btn=document.createElement('button'); btn.className='mc-qr-btn';btn.textContent=b.label; btn.onclick=function(){handleQuick(b.action,b.label);}; qr.appendChild(btn); }); } function showWelcome(){ addMsg("Welcome to <b>Mumbai Property Exchange</b>! 🏗️\n\nI can help you discover the perfect project.",false); setTimeout(function(){ addMsg("What would you like to do?",false); setQR([ {label:'🏠 Find My Home', action:'bj_start'}, {label:'🔍 Search Projects', action:'search'}, {label:'🧭 Project Compass', action:'compass'}, {label:'💬 Talk to Expert', action:'whatsapp'}, ]); },400); } window.sendMCMsg=function(){ var t=inp.value.trim();if(!t)return; addMsg(t,true);inp.value=''; setTimeout(function(){ addMsg("Let me connect you with our project advisor for that. 📞",false); setQR([ {label:'📞 Call Now', action:'whatsapp'}, {label:'🏠 Find My Home', action:'bj_start'}, ]); },500); }; function handleQuick(action,label){ if(label)addMsg(label,true);qr.innerHTML=''; switch(action){ case 'search': addMsg("You can search by location, builder, or project name right from the search bar above! 🔍",false); setQR([{label:'🏠 Find My Home',action:'bj_start'},{label:'🧭 Project Compass',action:'compass'}]); break; case 'compass': window.location='/project-compass'; break; case 'whatsapp': window.open('https://wa.me/919820067525?text=Hi%2C+I+am+looking+for+a+new+project+in+Mumbai','_blank'); break; case 'bj_start': addMsg("Let\'s find your perfect project! 🎯 I\'ll ask a few quick questions.",false); setTimeout(function(){ addMsg("What brings you here today?",false); setQR([ {label:'🏠 First Home',action:'bj_i_first'}, {label:'⬆️ Upgrade',action:'bj_i_upgrade'}, {label:'💰 Investment',action:'bj_i_invest'}, {label:'🔑 Rental',action:'bj_i_rental'}, ]); },500); break; case 'bj_i_first':case 'bj_i_upgrade':case 'bj_i_invest':case 'bj_i_rental': var iMap={bj_i_first:'first_home',bj_i_upgrade:'upgrade',bj_i_invest:'investment',bj_i_rental:'rental'}; window._bjData={buyer_intent:iMap[action]}; addMsg("What\'s your budget range?",false); if(action==='bj_i_rental'){ setQR([{label:'Under ₹50K',action:'bj_b_50k'},{label:'₹50K-1L',action:'bj_b_1l'},{label:'₹1-2L',action:'bj_b_2l'},{label:'₹2L+',action:'bj_b_2lp'}]); } else { setQR([{label:'Under ₹1Cr',action:'bj_b_1cr'},{label:'₹1-2Cr',action:'bj_b_2cr'},{label:'₹2-4Cr',action:'bj_b_4cr'},{label:'₹4Cr+',action:'bj_b_4crp'}]); } break; case 'bj_b_50k':case 'bj_b_1l':case 'bj_b_2l':case 'bj_b_2lp': case 'bj_b_1cr':case 'bj_b_2cr':case 'bj_b_4cr':case 'bj_b_4crp': var bM={bj_b_50k:[0,50000],bj_b_1l:[50000,100000],bj_b_2l:[100000,200000],bj_b_2lp:[200000,999999],bj_b_1cr:[0,10000000],bj_b_2cr:[10000000,20000000],bj_b_4cr:[20000000,40000000],bj_b_4crp:[40000000,999999999]}; var r=bM[action]||[0,0];window._bjData.budget_min=r[0];window._bjData.budget_max=r[1]; addMsg("When are you looking to move?",false); setQR([{label:'🏃 Now',action:'bj_t_now'},{label:'📅 3 Months',action:'bj_t_3m'},{label:'🏗️ 1-2 Years',action:'bj_t_12y'},{label:'🔮 Exploring',action:'bj_t_exp'}]); break; case 'bj_t_now':case 'bj_t_3m':case 'bj_t_12y':case 'bj_t_exp': var tM={bj_t_now:'immediate',bj_t_3m:'3_months',bj_t_12y:'1_2_years',bj_t_exp:'exploring'}; window._bjData.timeline=tM[action]; addMsg("Which area interests you?",false); setQR([{label:'Bandra',action:'bj_a_bandra'},{label:'Worli',action:'bj_a_worli'},{label:'Andheri',action:'bj_a_andheri'},{label:'Powai',action:'bj_a_powai'},{label:'🧭 Project Compass',action:'compass'}]); break; case 'bj_a_bandra':case 'bj_a_worli':case 'bj_a_andheri':case 'bj_a_powai': var aM={bj_a_bandra:'Bandra West',bj_a_worli:'Worli',bj_a_andheri:'Andheri West',bj_a_powai:'Powai'}; window._bjData.preferred_locations=aM[action]; addMsg("What configuration?",false); setQR([{label:'1 BHK',action:'bj_c_1'},{label:'2 BHK',action:'bj_c_2'},{label:'3 BHK',action:'bj_c_3'},{label:'4+ BHK',action:'bj_c_4'}]); break; case 'bj_c_1':case 'bj_c_2':case 'bj_c_3':case 'bj_c_4': window._bjData.bedrooms=action.replace('bj_c_',''); window._bjData.profile_complete=true; window._bjData.source='website_mpe'; addMsg("Saving your profile...",false); fetch('/api/buyer-profile',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(window._bjData)}) .then(function(r){return r.json()}) .then(function(d){ if(msgs.lastChild)msgs.removeChild(msgs.lastChild); addMsg("✅ <b>Profile saved!</b> Our team will call you with the best matching projects.\n\n📞 Office: +91 98200 30685\n📞 Pooja: +91 98198 67813",false); setQR([{label:'🧭 Project Compass',action:'compass'},{label:'🔍 Browse Projects',action:'search'}]); }).catch(function(){addMsg("Profile noted! Our team will reach out. 📞",false);}); break; default: addMsg("Let me help you with that!",false); setQR([{label:'🏠 Find My Home',action:'bj_start'},{label:'💬 Talk to Expert',action:'whatsapp'}]); } } })();</script><script>(function(){ var WA_DEFAULT_TEXT = 'Hi'; function mpeWaRef(a){ try{ var u = new URL(a.getAttribute('href'), location.origin); if(!/(^|\.)wa\.me$/.test(u.hostname) && !/whatsapp\.com$/.test(u.hostname)) return; var to = (u.pathname || '').replace(/[^0-9]/g, '') || (u.searchParams.get('phone') || '').replace(/[^0-9]/g, ''); if(to.length < 10) return; var t = u.searchParams.get('text') || ''; if(t.indexOf('(ref:') > -1) return; if(!t) t = WA_DEFAULT_TEXT; var p = (location.pathname || '/').slice(0, 110); u.searchParams.set('text', t + '\n\n(ref: ' + p + ')'); a.setAttribute('href', u.toString()); }catch(e){} } document.addEventListener('click', function(e){ var a = e.target && e.target.closest ? e.target.closest('a') : null; if(!a) return; var h = a.getAttribute('href') || ''; if(/wa\.me|whatsapp/i.test(h)) mpeWaRef(a); }, true); })();</script></body></html>