 </div></section><div class="tab-panel" id="panel-compass"><section class="proj-section"><h2>🧭 Building Compass</h2><p style="color:var(--text-muted);margin-bottom:20px">
 How far is <b>Garden Grove </b> from your daily life?
 Add your anchors to see commute times.
 </p><style>.pc-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}@media(max-width:768px){.pc-grid{grid-template-columns:1fr}}.pc-anchor{background:var(--bg-card,#1a1a2e);border:1px solid rgba(212,175,55,.15);border-radius:14px;padding:16px}.pc-anchor label{display:block;font-size:.8rem;font-weight:600;color:var(--gold-400,#d4af37);margin-bottom:6px;text-transform:uppercase;letter-spacing:.04em}.pc-anchor input{width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:10px 14px;color:var(--text-primary,#e2e8f0);font-size:.9rem;outline:none}.pc-anchor input::placeholder{color:rgba(255,255,255,.3)}.pc-anchor input:focus{border-color:rgba(212,175,55,.4)}.pc-calc-btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#d4af37,#b8962e);color:#fff;border:none;border-radius:10px;padding:12px 28px;font-size:.9rem;font-weight:600;cursor:pointer;transition:all .2s}.pc-calc-btn:hover{box-shadow:0 4px 16px rgba(212,175,55,.4);transform:translateY(-1px)}.pc-results{margin-top:20px;display:none}.pc-result-card{background:var(--bg-card,#1a1a2e);border:1px solid rgba(212,175,55,.1);border-radius:14px;padding:16px;margin-bottom:12px;display:flex;align-items:center;gap:16px}.pc-result-icon{font-size:1.5rem;width:44px;height:44px;border-radius:12px;background:rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0}.pc-result-name{font-weight:600;font-size:.95rem;color:var(--text-primary,#e2e8f0)}.pc-result-dist{font-size:.82rem;color:var(--text-muted,#a8a29e)}.pc-result-time{margin-left:auto;text-align:right}.pc-result-mins{font-size:1.4rem;font-weight:700;color:#d4af37}.pc-result-label{font-size:.7rem;color:var(--text-muted,#a8a29e);text-transform:uppercase}.pc-verdict{margin-top:20px;padding:16px;border-radius:14px;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.2);text-align:center}.pc-verdict-title{font-size:1.1rem;font-weight:700;color:#d4af37;margin-bottom:4px}.pc-verdict-text{font-size:.85rem;color:var(--text-muted,#a8a29e)}</style><div class="pc-grid"><div class="pc-anchor"><label>🏢 Your Office</label><input type="text" id="pc-office" placeholder="e.g. Lower Parel, BKC, Andheri"></div><div class="pc-anchor"><label>🏫 Kids' School</label><input type="text" id="pc-school" placeholder="e.g. Bandra, Juhu (or skip)"></div><div class="pc-anchor"><label>🏋️ Gym / Club</label><input type="text" id="pc-gym" placeholder="e.g. Worli, Powai (or skip)"></div><div class="pc-anchor"><label>👨‍👩‍👧 Family Visits</label><input type="text" id="pc-family" placeholder="e.g. Dadar, Chembur (or skip)"></div></div><button class="pc-calc-btn" onclick="calcCompass()">🧭 Calculate Commute</button><div class="pc-results" id="pc-results"></div></section></div><script>/* Project Compass — Commute Calculator */ (function(){ /* Mumbai location geocodes (approximate centers) */ var LOCS = { 'colaba':[18.9067,72.8147],'cuffe parade':[18.8917,72.8175],'churchgate':[18.9322,72.8264], 'fort':[18.9346,72.8358],'marine drive':[18.9438,72.8234],'nariman point':[18.9256,72.8242], 'malabar hill':[18.9545,72.8018],'nepean sea road':[18.9592,72.7987], 'breach candy':[18.9684,72.7972],'pedder road':[18.9632,72.8042], 'worli':[19.0176,72.8153],'lower parel':[18.9932,72.8278],'prabhadevi':[19.0064,72.8282], 'dadar':[19.0178,72.8478],'parel':[18.9928,72.8362],'matunga':[19.0275,72.8543], 'bkc':[19.0654,72.8687],'bandra kurla complex':[19.0654,72.8687], 'bandra':[19.0596,72.8295],'bandra west':[19.0596,72.8295],'bandra east':[19.0596,72.8587], 'khar':[19.0726,72.8362],'khar west':[19.0726,72.8362], 'santacruz':[19.0831,72.8412],'santacruz west':[19.0831,72.8412], 'juhu':[19.1045,72.8267],'andheri':[19.1197,72.8468],'andheri west':[19.1197,72.8468], 'andheri east':[19.1197,72.8696],'versova':[19.1311,72.8122], 'goregaon':[19.1623,72.8497],'goregaon east':[19.1623,72.8697], 'malad':[19.1874,72.8484],'malad west':[19.1874,72.8484], 'kandivali':[19.2047,72.8567],'borivali':[19.2307,72.8567], 'powai':[19.1176,72.9060],'chandivali':[19.1032,72.8936], 'chembur':[19.0522,72.8943],'ghatkopar':[19.0863,72.9076], 'mulund':[19.1726,72.9563],'thane':[19.2183,72.9781], 'navi mumbai':[19.0330,73.0297],'panvel':[18.9894,73.1175], 'wadala':[19.0177,72.8651],'sion':[19.0425,72.8620], 'vikhroli':[19.1098,72.9275],'bhandup':[19.1478,72.9387], }; var PROJECT_LOC = 'borivali west'.trim(); var projCoord = LOCS[PROJECT_LOC] || LOCS['shimpoli road, off link road, kanti park'] || null; function dist(a,b){ var R=6371,dLat=(b[0]-a[0])*Math.PI/180,dLon=(b[1]-a[1])*Math.PI/180; var x=Math.sin(dLat/2)*Math.sin(dLat/2)+Math.cos(a[0]*Math.PI/180)*Math.cos(b[0]*Math.PI/180)*Math.sin(dLon/2)*Math.sin(dLon/2); return R*2*Math.atan2(Math.sqrt(x),Math.sqrt(1-x)); } function driveMin(km){return Math.round(km/15*60);} function lookup(name){ var n=name.toLowerCase().trim(); return LOCS[n]||LOCS[n.replace(/\s+(west|east)$/,'')]||null; } window.calcCompass = function(){ if(!projCoord){ alert('Location coordinates not available for this project. Try a different project.'); return; } var anchors=[]; var fields=[ {id:'pc-office',icon:'🏢',label:'Office'}, {id:'pc-school',icon:'🏫',label:'School'}, {id:'pc-gym',icon:'🏋️',label:'Gym/Club'}, {id:'pc-family',icon:'👨‍👩‍👧',label:'Family'} ]; fields.forEach(function(f){ var v=document.getElementById(f.id).value.trim(); if(v && v.toLowerCase()!=='skip'){ var coord=lookup(v); if(coord){ var km=dist(projCoord,coord); anchors.push({icon:f.icon,label:f.label,place:v,km:km,mins:driveMin(km)}); } else { anchors.push({icon:f.icon,label:f.label,place:v,km:null,mins:null}); } } }); if(!anchors.length){alert('Please enter at least one location');return;} var box=document.getElementById('pc-results'); var html=''; var totalMin=0,count=0; anchors.forEach(function(a){ if(a.mins!==null){ totalMin+=a.mins;count++; html+='<div class="pc-result-card">' +'<div class="pc-result-icon">'+a.icon+'</div>' +'<div><div class="pc-result-name">'+a.label+': '+a.place+'</div>' +'<div class="pc-result-dist">'+a.km.toFixed(1)+' km from Garden Grove </div></div>' +'<div class="pc-result-time"><div class="pc-result-mins">'+a.mins+'</div>' +'<div class="pc-result-label">min drive</div></div></div>'; } else { html+='<div class="pc-result-card">' +'<div class="pc-result-icon">'+a.icon+'</div>' +'<div><div class="pc-result-name">'+a.label+': '+a.place+'</div>' +'<div class="pc-result-dist">Location not found — contact us for exact commute</div></div></div>'; } }); if(count>0){ var avg=Math.round(totalMin/count); var verdict=avg<=15?'Excellent':'Perfect'; var emoji=avg<=10?'🟢':avg<=20?'🟡':avg<=35?'🟠':'🔴'; var desc=avg<=15?'This project is extremely well-connected to your daily life!' :avg<=25?'Great connectivity — most of your daily trips are short.' :avg<=40?'Decent location — some commutes may be longer.' :'Consider traffic patterns. Our team can help plan your route.'; html+='<div class="pc-verdict">' +'<div class="pc-verdict-title">'+emoji+' Average Commute: '+avg+' min</div>' +'<div class="pc-verdict-text">'+desc+'</div></div>'; } box.innerHTML=html; box.style.display='block'; }; })();</script><section class="pdp-section"><h2>🧮 Financial Tools</h2><div class="calc-row"><div class="calc-card"><h3>💰 EMI Calculator</h3><div class="calc-input-group"><label class="calc-label" for="emi-price">Property Price (₹)</label><input type="number" class="calc-input" id="emi-price"
 value="" placeholder="Enter supported property price"></div><div class="calc-input-group"><label class="calc-label" for="emi-down">Down Payment (%)</label><input type="number" class="calc-input" id="emi-down" value="20" min="0"
 max="80"></div><div class="calc-input-group"><label class="calc-label" for="emi-rate">Interest Rate (% p.a.)</label><input type="number" class="calc-input" id="emi-rate" value="8.5" step="0.1"></div><div class="calc-input-group"><label class="calc-label" for="emi-years">Loan Tenure (years)</label><input type="number" class="calc-input" id="emi-years" value="20" min="1"
 max="30"></div><div class="calc-result" id="emi-result"><div class="calc-result-value" id="emi-value">—</div><div class="calc-result-label">Monthly EMI</div><div class="calc-breakdown"><div class="calc-bd-item"><div class="calc-bd-val" id="emi-loan">—</div><div class="calc-bd-lbl">Loan Amount</div></div><div class="calc-bd-item"><div class="calc-bd-val" id="emi-interest">—</div><div class="calc-bd-lbl">Total Interest</div></div></div></div></div><div class="calc-card"><h3>🔄 Rent vs Buy</h3><p style="font-size:.85rem;color:var(--text-muted);margin-bottom:16px">
