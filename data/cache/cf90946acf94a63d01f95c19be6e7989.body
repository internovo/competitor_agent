a-col="possession_pref" data-val="Ready">Ready to move</button><button type="button" class="lq-chip" data-col="possession_pref" data-val="Under Construction">Under construction</button><button type="button" class="lq-chip" data-col="possession_pref" data-val="Any">Either works</button></div></div><div class="lq-step" data-step="4" style="display:none"><div class="lq-q">👀 Seen other options already?</div><div class="lq-opts"><button type="button" class="lq-chip" data-col="seen_options" data-val="Shortlisted">Shortlisted a few</button><button type="button" class="lq-chip" data-col="seen_options" data-val="Just started">Just started</button><button type="button" class="lq-chip" data-col="seen_options" data-val="Only this one">Only this one</button></div></div><div class="lq-step" data-step="5" style="display:none"><div class="lq-q">Selling an existing property to fund this?</div><div class="lq-opts"><button type="button" class="lq-chip" data-col="sell_existing" data-val="1">Yes, selling</button><button type="button" class="lq-chip" data-col="sell_existing" data-val="0">No</button></div></div><div class="lq-step" data-step="6" style="display:none"><div class="lq-q">✅ Perfect — our advisor has what they need.</div></div></div><button class="lead-submit" onclick="closeLeadModal()" style="margin-top:12px">Close</button></div></div><style>.lq-q{font-size:14px;font-weight:700;color:#0f172a;margin-bottom:8px}.lq-opts{display:flex;flex-wrap:wrap;gap:8px}.lq-chip{border:1px solid #cbd5e1;background:#fff;color:#0f172a;border-radius:999px;padding:8px 14px;font-size:13px;cursor:pointer;transition:all .15s ease}.lq-chip:hover{border-color:#2563eb;color:#2563eb;background:#eff6ff}.cta-bar{position:fixed;bottom:0;left:0;right:0;display:flex;gap:0;z-index:9990;background:rgba(10,22,40,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid rgba(255,255,255,.08);padding:0;transition:transform .3s ease}.cta-bar.hidden{transform:translateY(100%)}.cta-btn{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px 10px;color:white;text-decoration:none;font-size:.85rem;font-weight:600;border:none;cursor:pointer;transition:background .2s;background:transparent}.cta-call{border-right:1px solid rgba(255,255,255,.08)}.cta-call:hover{background:rgba(59,130,246,.15)}.cta-wa{border-right:1px solid rgba(255,255,255,.08)}.cta-wa:hover{background:rgba(37,211,102,.15)}.cta-wa svg{color:#25D366}.cta-send:hover{background:rgba(212,175,55,.15)}.cta-send svg{color:var(--gold-400)}.lead-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);backdrop-filter:blur(4px);z-index:9995}.lead-overlay.open{display:block}.lead-modal{display:none;position:fixed;bottom:0;left:0;right:0;background:var(--bg-card);border-radius:20px 20px 0 0;padding:24px 20px 32px;z-index:9999;max-height:85vh;overflow-y:auto;box-shadow:0 -8px 40px rgba(0,0,0,.2);transform:translateY(100%);transition:transform .35s cubic-bezier(.22,1,.36,1)}.lead-modal.open{display:block;transform:translateY(0)}.lead-close{position:absolute;top:14px;right:18px;background:none;border:none;font-size:1.2rem;color:var(--text-muted);cursor:pointer;padding:4px}.lead-header{text-align:center;margin-bottom:1.2rem}.lead-icon{font-size:2rem;margin-bottom:4px}.lead-header h3{font-family:var(--font-display);font-size:1.2rem;font-weight:800;color:var(--navy-900);margin:0}.lead-header p{font-size:.85rem;color:var(--text-muted);margin:4px 0 0}.lead-field{margin-bottom:14px}.lead-field label{display:block;font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--text-muted);margin-bottom:4px}.lead-field input,.lead-field textarea{width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:8px;font-size:.9rem;background:var(--bg-body);color:var(--navy-900);transition:border-color .2s;box-sizing:border-box}.lead-field input:focus,.lead-field textarea:focus{border-color:var(--gold-500);outline:none}.lead-phone-wrap{display:flex;align-items:center;border:1.5px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg-body);transition:border-color .2s}.lead-phone-wrap:focus-within{border-color:var(--gold-500)}.lead-prefix{padding:10px 12px;font-size:.9rem;font-weight:600;color:var(--text-muted);background:var(--bg-body);border-right:1px solid var(--border);user-select:none}.lead-phone-wrap input{border:none;border-radius:0;background:transparent}.lead-phone-wrap input:focus{border-color:transparent}.lead-submit{width:100%;padding:13px;background:linear-gradient(135deg,#0f2240,#0a1628);color:white;border:none;border-radius:10px;font-size:.95rem;font-weight:700;cursor:pointer;transition:transform .15s,box-shadow .2s;letter-spacing:.02em}.lead-remark{margin-top:10px;padding:10px 12px;background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;font-size:.75rem;color:#92400e;line-height:1.5;text-align:center}.lead-submit:hover{transform:translateY(-1px);box-shadow:0 4px 14px rgba(0,0,0,.3)}.lead-submit:disabled{opacity:.6;cursor:not-allowed;transform:none}.lead-note{text-align:center;font-size:.72rem;color:var(--text-muted);margin-top:10px}.lead-success{text-align:center;padding:2rem 1rem}.lead-success-icon{font-size:3rem;margin-bottom:8px}.lead-success h3{font-family:var(--font-display);font-size:1.3rem;font-weight:800;color:var(--navy-900)}.lead-success p{color:var(--text-muted);font-size:.9rem}@media (min-width:769px){.cta-bar{bottom:50%;transform:translateY(50%);left:auto;right:0;flex-direction:column;width:auto;border-radius:12px 0 0 12px;border-top:none;border-left:1px solid rgba(255,255,255,.08);padding:4px 0}.cta-bar.hidden{transform:translate(100%,50%)}.cta-btn{padding:14px 16px;flex-direction:column;gap:4px;font-size:.7rem}.cta-call,.cta-wa{border-right:none;border-bottom:1px solid rgba(255,255,255,.08)}.lead-modal{left:auto;right:20px;bottom:20px;width:380px;border-radius:16px;max-height:80vh}}body{padding-bottom:56px}@media (min-width:769px){body{padding-bottom:0}}</style><script>(function () { function initCarousel(el) { var track = el.querySelector('.img-carousel-track'); if (!track) return; var dots = el.querySelectorAll('.img-carousel-dot'); var counter = el.querySelector('.img-carousel-counter'); var total = el.querySelectorAll('.img-carousel-slide').length; var autoMs = parseInt(el.dataset.autoplay) || 0; var timer = null; function updateUI() { var idx = Math.round(track.scrollLeft / track.offsetWidth); dots.forEach(function (d, i) { d.classList.toggle('active', i === idx) }); if (counter) counter.textContent = (idx + 1) + '/' + total; } track.addEventListener('scroll', updateUI, { passive: true }); dots.forEach(function (d) { d.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); track.scrollTo({ left: parseInt(d.dataset.idx) * track.offsetWidth, behavior: 'smooth' }); }); }); if (autoMs > 0) { function autoScroll() { var idx = Math.round(track.scrollLeft / track.offsetWidth); var next = (idx + 1) % total; track.scrollTo({ left: next * track.offsetWidth, behavior: 'smooth' }); } timer = setInterval(autoScroll, autoMs); el.addEventListener('touchstart', function () { clearInterval(timer) }, { passive: true }); el.addEventListener('touchend', function () { timer = setInterval(autoScroll, autoMs) }, { passive: true }); } } document.addEventListener('DOMContentLoaded', function () { document.querySelectorAll('.img-carousel').forEach(initCarousel); }); window.initCarousel = initCarousel; })();</script><script src="/static/js/search.js?v=20260620mfix" defer></script><script>var SL_KEY = 'mpe_shortlist'; function _getSL() { return JSON.parse(localStorage.getItem(SL_KEY) || '{}'); } function _saveSL(sl) { localStorage.setItem(SL_KEY, JSON.stringify(sl)); _updateBadge(); } function _updateBadge() { var sl = _getSL(); var n = Object.keys(sl).length; var b = document.getElementById('shortlistBadge'); if (!b) return; b.textContent = n; b.parentElement.style.display = n > 0 ? 'flex' : 'none'; } function toggleShortlist(btn, pid, title, price, beds, loc) { var sl = _getSL(); if (sl[pid]) { delete sl[pid]; btn.classList.remove('liked') } else { sl[pid] = { title: title, price: price, beds: beds, loc: loc, ts: Date.now() }; btn.classList.add('liked') } _saveSL(sl); btn.classList.add('pop'); setTimeout(function () { btn.classList.remove('pop') }, 300); } function shareProperty(pid, title, price) { var url = location.origin + '/property/' + pid; var text = title + ' — ' + price + '\n' + url; if (navigator.share) { navigator.share({ title: title, text: text, url: url }).catch(function () { }); } else { navigator.clipboard.writeText(text).then(function () { alert('Link copied!') }); } } function forwardProperty(pid, title, price) { var url = location.origin + '/property/' + pid; var msg = 'Check out this property: ' + title + ' — ' + price + '\n' + url; window.open('https://wa.me/?text=' + encodeURIComponent(msg), '_blank'); } function viewShortlist() { var sl = _getSL(); var ids = Object.keys(sl); if (!ids.length) { alert('No properties shortlisted yet!'); return; } var lines = ['🏠 My Shortlisted Properties\n']; ids.forEach(function (id) { var p = sl[id]; lines.push('• ' + p.title + ' — ' + p.price); lines.push(' ' + location.origin + '/property/' + id + '\n'); }); if (confirm('You have ' + ids.length + ' shortlisted properties.\n\nShare via WhatsApp?')) { window.open('https://wa.me/?text=' + encodeURIComponent(lines.join('\n')), '_blank'); } } document.addEventListener('DOMContentLoaded', function () { var sl = _getSL(); document.querySelectorAll('.card-engage-btn[onclick*="toggleShortlist"]').forEach(function (btn) { var m = btn.getAttribute('onclick').match(/'(\d+)'/); if (m && sl[m[1]]) btn.classList.add('liked'); }); _updateBadge(); });</script><script>(function () { var ctx = ''; var h1 = document.querySelector('h1'); if (h1) ctx = h1.textContent.trim(); if (!ctx) ctx = document.title.split('|')[0].split('—')[0].trim(); if (ctx && ctx.length > 5) { var waBtn = document.getElementById('ctaWhatsApp'); if (waBtn) { var msg = 'Hi, I am interested in ' + ctx; waBtn.href = 'https://wa.me/919820067525?text=' + encodeURIComponent(msg); } var msgField = document.getElementById('leadMsg'); if (msgField && !msgField.value) { msgField.placeholder = 'I am interested in ' + ctx; } } })(); var _lqLeadId = null; function startLeadQualify(leadId) { _lqLeadId = leadId || null; var wrap = document.getElementById('leadQualify'); if (!wrap) return; if (!_lqLeadId) { wrap.style.display = 'none'; return; } wrap.style.display = ''; wrap.querySelectorAll('.lq-step').forEach(function (s, i) { s.style.display = i === 0 ? '' : 'none'; }); } function _lqAdvance(from) { var wrap = document.getElementById('leadQualify'); var cur = wrap.querySelector('.lq-step[data-step="' + from + '"]'); var nxt = wrap.querySelector('.lq-step[data-step="' + (from + 1) + '"]'); if (cur) cur.style.display = 'none'; if (nxt) nxt.style.display = ''; } document.addEventListener('click', function (e) { var chip = e.target.closest && e.target.closest('.lq-chip'); if (!chip || !_lqLeadId) return; var col = chip.getAttribute('data-col'); var val = chip.getAttribute('data-val'); var step = parseInt(chip.closest('.lq-step').getAttribute('data-step'), 10); var body = {}; if (!(col === 'sell_existing' && val === '0')) { body[col] = val; fetch('/api/leads/' + _lqLeadId + '/qualify', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).catch(function () { /* enrichment is best-effort */ }); } _lqAdvance(step); }); function openLeadModal() { mpeTrack('lead_form_open', { lead_source: 'website' }); document.getElementById('leadOverlay').classList.add('open'); var m = document.getElementById('leadModal'); m.classList.add('open'); m.offsetHeight; document.getElementById('leadForm').style.display = ''; document.getElementById('leadSuccess').style.display = 'none'; document.getElementById('leadName').focus(); } function openLeadModalWithContext(msg) { var msgField = document.getElementById('leadMsg'); if (msgField && msg) { msgField.value = msg; } openLeadModal(); } function closeLeadModal() { document.getElementById('leadOverlay').classList.remove('open'); document.getElementById('leadModal').classList.remove('open'); } function submitLead(e) { e.preventDefault(); var btn = document.getElementById('leadSubmitBtn'); btn.disabled = true; btn.textContent = 'Sending...'; var name = document.getElementById('leadName').value.trim(); var phone = document.getElementById('leadPhone').value.trim(); var msg = document.getElementById('leadMsg').value.trim(); var projId = null, propId = null, source = 'website'; var path = window.location.pathname; if (path.startsWith('/project/')) { source = 'project_page'; var idMatch = path.match(/\/(\d+)$/); if (idMatch) projId = idMatch[1]; } else if (path.startsWith('/property/') || path.startsWith('/properties')) { source = 'property_page'; var pidMatch = path.match(/\/(\d+)$/); if (pidMatch) propId = pidMatch[1]; } else if (path.startsWith('/maharera-project/')) { source = 'rera_page'; var reraMatch = path.match(/\/(\d+)$/); if (reraMatch) projId = reraMatch[1]; } else if (path.startsWith('/shortlist/')) { source = 'shortlist_page'; } else if (path.startsWith('/projects') || path.startsWith('/builders') || path === '/') { source = 'listing_page'; } if (!projId && !propId && window._leadProjectId) { projId = window._leadProjectId; source = 'project_card'; } if (!projId && !propId && window._leadPropertyId) { propId = window._leadPropertyId; source = 'property_card'; } fetch('/api/leads', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: name, phone: '+91' + phone, project_id: projId, property_id: propId, source: source, message: msg || ('Enquiry from ' + document.title.split('|')[0].trim()), page_url: window.location.href }) }) .then(function (r) { return r.json(); }) .then(function (data) { if (data.ok) { mpeTrack('generate_lead', { lead_source: source, page_path: window.location.pathname }); document.getElementById('leadForm').style.display = 'none'; document.getElementById('leadSuccess').style.display = ''; startLeadQualify(data.lead_id); } else { alert(data.error || 'Something went wrong. Please try again.'); btn.disabled = false; btn.textContent = 'Send Details'; } }) .catch(function () { alert('Network error. Please try again.'); btn.disabled = false; btn.textContent = 'Send Details'; }); } function mpeTrack(eventName, params) { if (typeof window.gtag !== 'function') return; window.gtag('event', eventName, params || {}); } function mpePageRef() { var m = window.location.pathname.match(/^\/project\/[^/]+\/(\d+)/); if (m) return { type: 'project', id: m[1] }; m = window.location.pathname.match(/^\/property\/(\d+)/); if (m) return { type: 'property', id: m[1] }; return null; } document.addEventListener('click', function (event) { var link = event.target.closest('a[href]'); if (!link) return; var href = link.getAttribute('href') || ''; var ref = mpePageRef(); if (href.indexOf('wa.me/') !== -1 || href.indexOf('api.whatsapp.com/') !== -1) { if (ref && href.indexOf('wa.me/9') !== -1) { try { var u = new URL(href); var t = u.searchParams.get('text') || ''; if (!/Project Id|Property Id|RERA|Ref:/i.test(t)) { var tag = (ref.type === 'project' ? 'Project Id - ' : 'Property Id - ') + ref.id; u.searchParams.set('text', t ? t + ' | Ref: ' + tag : 'Hi MPE, enquiry. Ref: ' + tag); link.setAttribute('href', u.toString()); } } catch (e) { /* leave href untouched */ } } var wp = { method: 'whatsapp', page_path: window.location.pathname }; if (ref) wp[ref.type + '_id'] = ref.id; mpeTrack('contact', wp); } else if (href.indexOf('tel:') === 0) { var pp = { method: 'phone', page_path: window.location.pathname }; if (ref) pp[ref.type + '_id'] = ref.id; mpeTrack('contact', pp); } });</script><script type="application/ld+json">{
