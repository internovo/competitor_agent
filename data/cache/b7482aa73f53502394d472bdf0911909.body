e},{"@type":"LocationFeatureSpecification","name":"Kids' Pool","value":true},{"@type":"LocationFeatureSpecification","name":"Badminton Court(s)","value":true},{"@type":"LocationFeatureSpecification","name":"Squash Court","value":true},{"@type":"LocationFeatureSpecification","name":"Cricket","value":true},{"@type":"LocationFeatureSpecification","name":"Kids' Play Areas / Sand Pits","value":true},{"@type":"LocationFeatureSpecification","name":"Yoga Areas","value":true},{"@type":"LocationFeatureSpecification","name":"Jogging / Cycle Track","value":true},{"@type":"LocationFeatureSpecification","name":"Table Tennis","value":true},{"@type":"LocationFeatureSpecification","name":"Snooker/Pool/Billiards","value":true},{"@type":"LocationFeatureSpecification","name":"Power Backup","value":true},{"@type":"LocationFeatureSpecification","name":"Treated Water Supply","value":true},{"@type":"LocationFeatureSpecification","name":"Pet Area","value":true},{"@type":"LocationFeatureSpecification","name":"24*7 Water Supply","value":true},{"@type":"LocationFeatureSpecification","name":"Lift","value":true},{"@type":"LocationFeatureSpecification","name":"Party Lawn","value":true},{"@type":"LocationFeatureSpecification","name":"24 x 7 Security","value":true},{"@type":"LocationFeatureSpecification","name":"CCTV / Video Surveillance","value":true},{"@type":"LocationFeatureSpecification","name":"Cafe / Coffee Bar","value":true},{"@type":"LocationFeatureSpecification","name":"Dance Room","value":true},{"@type":"LocationFeatureSpecification","name":"Reading Room/Library","value":true},{"@type":"LocationFeatureSpecification","name":"Clubhouse","value":true},{"@type":"LocationFeatureSpecification","name":"Amphitheater","value":true},{"@type":"LocationFeatureSpecification","name":"Indoor Games","value":true},{"@type":"LocationFeatureSpecification","name":"Conference Room","value":true},{"@type":"LocationFeatureSpecification","name":"Normal Park / Central Green","value":true}],"aggregateRating":{"@type":"AggregateRating","ratingValue":4,"bestRating":5,"worstRating":1,"ratingCount":1,"reviewCount":1},"review":[{"@type":"Review","author":{"@type":"Person","name":"Akhelsh Jain"},"datePublished":"2026-06-30","reviewBody":null,"reviewRating":{"@type":"Rating","ratingValue":4,"bestRating":5,"worstRating":1}}],"subjectOf":[{"@id":"https://www.squareyards.com/eldeco-terra-and-sol-sector-80-gurgaon-npd-344020#video-1"}]},{"@type":"FAQPage","@id":"https://www.squareyards.com/eldeco-terra-and-sol-sector-80-gurgaon-npd-344020#faq","isPartOf":{"@id":"https://www.squareyards.com/eldeco-terra-and-sol-sector-80-gurgaon-npd-344020#webpage"},"mainEntity":[{"@type":"Question","name":"Where exactly is Eldeco Terra And Sol located?","acceptedAnswer":{"@type":"Answer","text":"Eldeco Terra And Sol is in Sector 80, Gurgaon, within the New Gurgaon belt. The location gives residents access to NH 8, keeping commutes to business districts and daily errands predictable without lengthy detours. Ompee Global School, IMT Manesar, Medeor Hospital, IMT Manesar, Hyatt regency gurgaon, Sector 36A, Vatika Town Square-INXT, Sector 82A, Cyberwalk, IMT Manesar are within reach, and the area carries a connectivity index of 3.9, a measurable indicator of how the location actually performs on a regular working day."}},{"@type":"Question","name":"What is the starting price of Eldeco Terra And Sol?","acceptedAnswer":{"@type":"Answer","text":"Eldeco Terra And Sol is priced from ₹ 3.23 Cr, with the upper range reaching ₹ 3.67 Cr depending on the configuration and floor selected. The entry point covers the smallest available unit, while larger 3 BHK Flats are priced at higher levels. Unit sizes run from 2150 Sq.Ft. to 2450 Sq.Ft.."}},{"@type":"Question","name":"Who is the developer of Eldeco Terra And Sol?","acceptedAnswer":{"@type":"Answer","text":"Eldeco Terra And Sol is developed by Eldeco, a real estate company with 35 years in the industry and 92 projects completed across multiple cities. For buyers committing funds ahead of possession, a developer's execution track record carries more practical weight than marketing material. Eldeco's delivery history and project scale give buyers a reasonable basis for evaluating construction quality and timeline credibility."}},{"@type":"Question","name":"What configurations and unit sizes are available in Eldeco Terra And Sol?","acceptedAnswer":{"@type":"Answer","text":"Eldeco Terra And Sol offers 3 BHK Flats with unit sizes ranging from 2150 Sq.Ft. to 2450 Sq.Ft.. This range covers compact layouts suited to individuals and couples as well as larger floor plans designed for families of four or more. Each configuration is planned with ventilation, natural light access and practical room separation in mind. Detailed 2D and 3D floor plans for every unit type are available in the floor plans section on this page."}},{"@type":"Question","name":"Is Eldeco Terra And Sol RERA registered?","acceptedAnswer":{"@type":"Answer","text":"Yes. Eldeco Terra And Sol is registered under the Real Estate (Regulation and Development) Act with RERA number GGM/1048/780/2026/20. This registration places the project's construction timeline, fund utilisation and possession date on public record with the state RERA authority. Buyers can verify the status and track construction progress directly on the state RERA portal using this number."}},{"@type":"Question","name":"When is the possession date for Eldeco Terra And Sol?","acceptedAnswer":{"@type":"Answer","text":"Eldeco Terra And Sol is currently New Launch, with Jan 2031 registered as the possession date. This is a legally documented timeline filed with the state RERA authority under registration number GGM/1048/780/2026/20, not an advisory estimate. Buyers paying in advance of completion can verify construction progress against the registered milestones on the RERA portal at any point before taking possession."}},{"@type":"Question","name":"What amenities are available at Eldeco Terra And Sol?","acceptedAnswer":{"@type":"Answer","text":"Eldeco Terra And Sol includes Gymnasium, Swimming Pool, Power Backup, Treated Water Supply, 24 x 7 Security, CCTV / Video Surveillance, Cafe / Coffee Bar, Dance Room, Normal Park / Central Green for regular resident use. The facilities are distributed across the development rather than concentrated in a single building, which keeps them accessible and practical during peak hours. Spaces cover multiple age groups and daily needs, from fitness and sports infrastructure to leisure zones and quieter areas for senior residents."}},{"@type":"Question","name":"How well connected is Eldeco Terra And Sol to the rest of Gurgaon?","acceptedAnswer":{"@type":"Answer","text":"Eldeco Terra And Sol at Sector 80 Gurgaon sits close to NH 8, which handles most commute routes to employment hubs and commercial areas in Gurgaon. Ompee Global School, IMT Manesar, Medeor Hospital, IMT Manesar, Hyatt regency gurgaon, Sector 36A, Vatika Town Square-INXT, Sector 82A, Cyberwalk, IMT Manesar are within a reasonable distance, and the area holds a connectivity index of 3.9."}},{"@type":"Question","name":"What schools and banks are near Eldeco Terra And Sol?","acceptedAnswer":{"@type":"Answer","text":"Ompee Global School, Bal Bharati Public School, SOIL School Of Business Design, Goverment Primary School, StXaviers High School are close to Eldeco Terra And Sol, which makes the project practical for families managing school runs alongside work commutes. Hdfc Bank, Andhra Bank, Icici Bank, Axis Bank, HDFC Bank IMT Manesar are also nearby for routine financial needs, removing two of the more common location compromises families make when shortlisting areas. The locality's education and health index of 3.9 gives buyers a measurable read on the available social infrastructure before making a commitment."}},{"@type":"Question","name":"Is Eldeco Terra And Sol a good investment?","acceptedAnswer":{"@type":"Answer","text":"Eldeco Terra And Sol sits in Sector 80, Gurgaon, an area with a livability index of 4.2. The project is backed by Eldeco's 35 years of delivery experience across 92 completed projects, which supports confidence in on-time possession."}},{"@type":"Question","name":"How many homes are there in Eldeco Terra And Sol and how large is the project?","acceptedAnswer":{"@type":"Answer","text":"Eldeco Terra And Sol has 224 homes at Sector 80 Gurgaon. Unit sizes run from 2150 Sq.Ft. to 2450 Sq.Ft. across 3 BHK Flats. The scale of the development means shared amenities, open spaces and community infrastructure are distributed across the layout rather than compressed into a single corner, which directly affects how accessible and usable the facilities are for residents on a day-to-day basis."}}]},{"@type":"VideoObject","@id":"https://www.squareyards.com/eldeco-terra-and-sol-sector-80-gurgaon-npd-344020#video-1","name":"Eldeco Terra And Sol, Sector 80, Gurgaon | Project Video","description":"Project video of Eldeco Terra And Sol, a 3 BHK BHK residential development by Eldeco in Sector 80, Gurgaon, showing the towers, amenities and layout.","thumbnailUrl":"https://static.squareyards.com/resources/images/gurgaon/project-image/eldeco-terra-and-sol-project-project-large-image1-3046-opt-310cf38d-d7d7-499f-b7f3-2518578defbf.jpg","uploadDate":"2026-08-19T00:00:00+05:30","contentUrl":["https://img.squareyards.com/rcheck/projectvideos/344020-projectvideo.mp4","https://img.squareyards.com/rcheck/projectvideos/344020-builder-Eldeco-Terra-Sol-Sector-80-Gurugram-Walkthrough-20260720142504.mp4"],"url":"https://www.squareyards.com/eldeco-terra-and-sol-sector-80-gurgaon-npd-344020","publisher":{"@id":"https://www.squareyards.com/#organization"},"about":{"@id":"https://www.squareyards.com/eldeco-terra-and-sol-sector-80-gurgaon-npd-344020#project"}}]}</script>

