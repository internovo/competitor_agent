          <h2 class="section-title" id="about-developer-heading">Kalpataru Track Record</h2>
          <div class="about-developer-header">
            
            <div class="developer-logo"><img src="https://static.squareyards.com/resources/images/developerlogo/kalpataru-532-5000.jpg?aio=w-300;h-300;fill;" alt="Kalpataru logo" class="img-responsive" width="300" height="300" loading="lazy" decoding="async"> </div>
            
            
