              </div>
              
            </div>
            
              
            
              <aside class="media-gallery-grid three">
                
                <figure class="gallery-item exterior load-gallery"> <img class="img-responsive" src="https://static.squareyards.com/resources/images/mumbai/project-image/kalpataru-advay-project-tower-view1-8288.jpg?aio=w-192;h-168;crop;" width="170" height="139" loading="lazy" decoding="async" alt="Kalpataru Advay Tower View"> </figure>
                
                
                <figure class="gallery-item more-images load-gallery"> <img class="img-responsive" src="https://static.squareyards.com/resources/images/mumbai/project-image/kalpataru-advay-project-apartment-exteriors1-6068.jpg?aio=w-192;h-168;crop;" width="170" height="139" loading="lazy" decoding="async" alt="Kalpataru Advay Apartment Exteriors">
