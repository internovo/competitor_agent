fy-content:center;align-items:center;border:1px solid transparent;font-size:14px;line-height:normal;border-radius:var(--radius);height:42px}.btn-default{background:var(--white);color:var(--gray-500);border-color:var(--border)}.btn-default:hover{border-color:var(--darkgrey)}.btn-primary{background:var(--darkyellow);color:var(--gray-500);border-color:var(--darkyellow);font-weight:700}.btn-primary:hover{background:var(--darkyellow);border-color:var(--darkyellow)}.btn-secondary{background:var(--darkgrey);color:var(--white);border-color:var(--darkgrey)}.btn-whatsapp{background:linear-gradient(227deg,#4cc75b 6.33%,#30b845 96.81%);border-color:none;color:var(--white);font-weight:700}.btn-whatsapp-fill{background:linear-gradient(227deg,#4cc75b 6.33%,#30b845 96.81%);color:var(--white);border-color:none;font-weight:700}.btn-link{border-radius:0;padding:0;height:auto;background:0;border:0;color:var(--gray-500);border-bottom:1px solid var(--darkgrey);cursor:pointer}.btn-link:hover{border-color:transparent}.btn-lg{height:48px}.scrollbar-hide{-webkit-scrollbar-width:none;-moz-scrollbar-width:none;-ms-scrollbar-width:none;scrollbar-width:none}.scrollbar-hide::-webkit-scrollbar{display:none}.scrollbar::-webkit-scrollbar{width:8px;height:8px;background-color:rgba(0,0,0,0.1);border-radius:20px;position:absolute;z-index:10000}.scrollbar::-webkit-scrollbar-thumb{background-color:#bfbfbf;border-radius:20px}.scrollbar::-moz-scrollbar{width:8px;height:8px;background-color:rgba(255,255,255,0.1);position:absolute;z-index:10000;right:0}.scrollbar::-moz-scrollbar-thumb{background-color:#bfbfbf;border-radius:20px}.modal,.modal-overlay,.globalOverflow,.globalModal,.global-modal,.ui-helper-hidden-accessible,.shotlist-popup{display:none}.bxslider{display:flex;gap:15px;overflow:hidden; overflow-x:auto}.hide{display:none!important;}
.description-content-box{padding-bottom:28px;margin-top:8px;overflow:hidden;max-height:60px;position:relative;font-size:14px;line-height:20px}.description-content-box
p{font-size:14px;line-height:22px;color:var(--gray-400)}.description-content-box p +
br{display:none}.description-content-box p ~ p{margin-top:10px}.description-content-box
.desc-text{text-align:left;font-size:14px;line-height:22px;color:var(--gray-400)}.description-content-box
.desc-text ul,.description-content-box .desc-text ol{margin:10px 0 0;padding-left:18px}.description-content-box
.desc-text ul
li{display:list-item;list-style:disc;line-height:22px;color:var(--gray-400);margin-bottom:8px}.description-content-box
.desc-text ol
li{display:list-item;list-style:decimal;line-height:22px;color:var(--gray-400);margin-bottom:8px}.description-content-box.active{max-height:none}.description-content-box.about-project-content{max-height:170px;margin-bottom:0}.description-content-box.about-project-content.active{max-height:none}.description-content-box
.read-more-button-box{height:28px;background:linear-gradient(180deg,#fff0 0%,#ffffffe6 46.63%,#FFF
100%);position:absolute;left:0;bottom:0;width:100%;display:flex;align-items:flex-end}.description-content-box
.read-more-button-box
.read-more-button{padding-right:10px;color:var(--gray-500);text-decoration:underline;border:0;cursor:pointer;line-height:normal;font-size:14px;background:#fff}.description-content-box
.read-more-button-box
.read-more-button:hover{text-decoration:none}.project-first-fold-description{margin-top:8px}.white-box-body
.description-content-box{margin:0 0 15px}

.description-content-box h3{ margin-top:15px;color:var(--gray-500); font-size:16px;font-weight:700; }
.description-content-box .table-responsive{ margin:10px 0 15px; overflow:hidden;border:#e1e1e1 solid 1px;border-radius:8px;overflow-x:auto}
.description-content-box .table-responsive table{border: 0;
    border-collapse: collapse;
    white-space: nowrap;width: 100%;}

.description-content-box .table-responsive table thead{border:#f6f6f6 solid 15px;border-top:#f6f6f6 solid 10px;border-bottom:var(--white) solid 15px;background:#f6f6f6}
.description-content-box .table-responsive table thead td,.description-content-box .table-responsive table thead th{padding:5px 15px;border:#f6f6f6 solid 1px;color:var(--gray-400);font-size:14px}
.description-content-box .table-responsive table tbody{border:var(--white) solid 15px}
.description-content-box .table-responsive table tbody td{padding:5px 15px;border:var(--border) solid 1px;height:45px;font-size:14px;color:var(--gray-400);text-align:left}
/* common css  */
.heading{font-size:32px;line-height:37px;display:block;color:var(--gray-500);font-weight:700}
.sub-heading{margin-top:6px;font-size:16px;line-height:normal;display:block;color:var(--gray-500);font-weight:400}
.small-heading{font-size:18px;line-height:23px;color:var(--gray-500);display:block;font-weight:700}

/* banner section css */    
.floorplan-banner-section{padding:5px 0 40px;margin-top:48px;position:relative;overflow:hidden;}
.floorplan-banner-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.floorplan-banner-section .newBreadcrumbBox ul li span a,.newBreadcrumbBox ul li span{color:var(--gray-200)}
.floorplan-banner-section .newBreadcrumbBox{position:relative;z-index: 1;}
.floorplan-banner-inner{padding:40px 0 0;position:relative;z-index:2;display:flex;align-items:flex-end;justify-content:space-between;gap:20px}
.floorplan-banner-inner .floorplan-banner-left{display:flex;align-items:center;gap:20px;flex:1;}
.floorplan-banner-section p{margin-top:20px;color:var(--white);position:relative;line-height:21px;}
.floorplan-banner-left .project-img{width:145px;height:145px;border-radius:15px;overflow:hidden;flex-shrink:0;border:1px solid var(--yellow-500)}
.floorplan-banner-left .project-img img{width:100%;height:100%;object-fit:cover}
.floorplan-banner-left .floorplan-banner-details .project-name{font-size:28px;font-weight:700;color:var(--white);display:block;line-height:28px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.floorplan-banner-left .floorplan-banner-details .project-name span{color:var(--yellow-500)}
.floorplan-banner-left .floorplan-banner-details .project-location{margin-top:10px;display:inline-flex;align-items:center;gap:7px;font-size:14px;color:var(--white);line-height:21px}
.floorplan-banner-left .floorplan-banner-details .project-location em{font-size:14px;width:14px;height:14px}
.floorplan-banner-details .floorplan-banner-meta-row{margin-top:12px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.floorplan-banner-left .banner-meta-chip{padding:11px 19px;display:flex;align-items:center;gap:12px;background:#0000007d;border:1px solid #ffffff26;border-radius:8px;min-width:160px}
.floorplan-banner-left .banner-meta-chip em{font-size:22px;width:24px;height:24px;color:var(--white);flex-shrink:0}
.floorplan-banner-left .banner-meta-chip .meta-chip-text{display:flex;flex-direction:column;gap:6px}
.floorplan-banner-left .banner-meta-chip .meta-chip-label{font-size:12px;text-transform:uppercase;color:var(--gray-200);line-height:normal}
.floorplan-banner-left .banner-meta-chip .meta-chip-value{font-size:14px;font-weight:700;color:var(--white);line-height:22px;white-space:nowrap}
.floorplan-btn-box{display:flex;align-items:center;gap:10px;flex-shrink:0}
.floorplan-btn-box .btn em{font-weight:700;width:14px;height:14px}

/* configuration section css */
.interior-primary-btn{padding:0 30px; background:#EB5976;color:var(--white);font-weight:bold;}
.configuration-section{padding:32px 0 48px;background:var(--white)}
.configuration-section .tab-box{margin-top:30px;padding:10px;border:1px solid var(--gray-200);border-radius:60px}
.configuration-section .tab-box li{border-radius:38px;}
.configuration-box{border-bottom:1px solid var(--yellow-700);}
.configuration-box .container{margin-bottom:-9px;}
.bhk-type-tabbox{padding-bottom:8px; margin-top:20px;display:flex;overflow: auto;}
.bhk-type-tab{margin-bottom:8px;padding:15px;padding-bottom:60px;width:273px !important;border-radius:15px;border:1px solid var(--gray-200);box-shadow:0 2px 12px 0 rgba(0,0,0,0.08);background:var(--white);position:relative;cursor:pointer;}
.bhk-type-tab + .bhk-type-tab{margin-left:15px;}
.bhk-type-tab.fp-bhk-hidden{display:none;}
.bx-viewport{overflow-y:visible !important;}
.bhk-type-tab.selected{margin-bottom:0;position: relative;border-radius:15px 15px 0 0;border-color:var(--yellow-700);border-bottom:none;box-shadow:none}
.bhk-type-tab.selected::after{position:absolute;content:'';left:0;right:0;height:5px;background:var(--white);bottom:0 ;}
.bhk-type-tab .bhk-tab-header{padding-right:70px;padding-bottom:15px;display:flex;align-items:center;gap:10px;}
.bhk-type-tab .bhk-tab-header em{padding:3px;width:20px;height:20px;border-radius:50%;border:1px solid var(--gray-300);display:flex;align-items:center;justify-content:center;transition:border-color .18s;background:var(--white);color:var(--white);font-size:11px;flex:none;}
.bhk-type-tab.selected .bhk-tab-header em{border-color:var(--gray-500);background:var(--gray-500)}
.bhk-tab-header .bhk-card-pricebox{display:flex;flex-direction:column;gap:5px;}
.bhk-tab-header .card-name{font-size:16px;font-weight:700;color:var(--gray-700);display:block;line-height:21px;}
.bhk-tab-header .card-facing{display:flex;align-items:center;font-size:12px;color:var(--gray-400);display:block;line-height:normal;}
.bhk-tab-header .card-facing span{padding-right:5px;margin-right:5px;position:relative;line-height:normal;}
.bhk-tab-header .card-facing span + span::after{position:absolute;content:'';width:2px;height:2px;background:var(--gray-300);border-radius:10px;left:-5px;top:calc(50% - 2px);}
.bhk-tab-badge{padding:6px 8px;border-radius:20px 0 0 20px;position:absolute;content:'';right:0;top:16px;display:flex;align-items:center;justify-content:center;color:var(--gray-500);font-size:14px;font-weight:700;background:#FFECA2;white-space:nowrap;line-height:normal;}
.bhk-tab-badge.price-on-request{padding:4px 13px; font-size:12px;top:0;right:0;border-radius:0 0 0 20px;}
.fp-card-area-row{padding-top:15px;margin-bottom:12px;border-top:1px solid var(--gray-200);display:flex;gap:20px;justify-content:space-between;}
.fp-card-area-row .fp-card-area-item{display:flex;flex-direction:column;}
.fp-card-area-row .fp-card-area-item .fp-card-area-label{font-size:12px;font-weight:400;text-transform:uppercase;color:var(--gray-400);line-height:17px}
.fp-card-area-row .fp-card-area-value{font-size:14px;font-weight:700;color:var(--gray-500);line-height:21px}
.bhk-type-tab .btn{position:absolute;content:'';bottom:15px;left:15px;right:15px;}
.bhk-type-tab .fp-compare-btn.added{background:var(--gray-500);color:var(--white)}
.bhk-type-tab .btn em{width:15px;height:15px; font-size:14px}
.section-badge{margin:0 0 12px;padding:0 16px;height:23px;display:flex;align-items:center;justify-content:center;font-size:13px;line-height:normal;background:var(--yellow-100);color:var(--gray-500);border:1px solid var(--yellow-500);border-radius:6px;width:fit-content;font-weight:500}
.panel-detail-box{padding-top:52px;display:flex;gap:62px;align-items:flex-start}
.panel-left-box{flex:1;width:calc(100% - 537px);}
.panel-left-box .panel-description{margin-top:12px;font-size:14px;color:var(--gray-400);line-height:21px;}
.panel-left-box .detail-price-row{margin-top:22px;padding:10px 0 14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;border-top:1px solid var(--gray-200);}
.panel-left-box .detail-price-row .detail-price{font-size:18px;font-weight:700;color:var(--gray-500);line-height:27px;}
.panel-left-box .detail-price-row .change-btn{font-size:12px;color:var(--gray-400);text-decoration:underline;cursor:pointer}
.panel-left-box .detail-price-row .change-btn:hover{text-decoration:none;}
.panel-left-box .detail-price-row .detail-emi{padding-left:15px;font-size:12px;color:var(--gray-400);position:relative;}
.panel-left-box .detail-price-row .detail-emi::after{position:absolute;content:'';width:4px;height:4px;background:var(--gray-400);border-radius:50%;left:0;top:calc(50% - 2px);}

.property-bhk-container{margin-top:40px; display:flex;gap:70px;align-items:flex-start;}

.aminity-card-box{width:553px;display:grid;grid-template-columns:repeat(3,1fr);gap:15px;}
.aminity-card{padding:12px 20px;border:1px solid var(--gray-200);border-radius:8px;display:flex;align-items:center;gap:8px}
.aminity-card-box .aminity-card:only-child{grid-column:1 / -1;width:100%;}
.aminity-card em{width:25px;height:25px;font-size:23px;color:var(--gray-500);flex-shrink:0}
.aminity-card-content{display:flex;flex-direction:column;gap:6px}
.aminity-card-content .label{font-size:12px;font-weight:400;text-transform:uppercase;color:var(--gray-400);line-height:normal}
.aminity-card-content .value{font-size:14px;font-weight:700;color:var(--gray-500);line-height:17px}

.allkeys-bhk{width:calc(100% - 605px);}
.highlights-list{margin-top:15px;display:flex;flex-direction:column;gap:7px;}
.highlights-list li{padding-left:20px;line-height:22px;color:var(--gray-400);position:relative;}
.highlights-list li::before{position:absolute;content:'\e92a';left:0;top:calc(50% - 7px);font-family:'icomoon';color:var(--gray-400);font-weight:600;flex-shrink:0;width:16px;height:16px;font-size:12px;line-height:normal;}
.panel-left-box .cta-btn{margin-top:22px;padding:0 30px;}
.bhk-type-tab .bhk-tab-header{padding-bottom:12px;}
.panel-right-box{flex-shrink:0;width:517px;border-radius:15px;overflow:hidden;}
.fp-unit-video{height:517px;background:var(--gray-200);border-radius:15px}
.media-caption{margin-top:-10px; padding:15px 20px 30px;background:var(--gray-500);}
.media-caption .media-tag{margin-bottom:7px;color:var(--darkyellow);font-size:12px;line-height:normal;text-transform:uppercase;display:block;}
.media-caption .media-title{font-size:18px;line-height:23px;color:var(--white);display:block;}
.media-caption .media-desc{margin-top:8px;font-size:14px;color:var(--gray-200);line-height:19px;display:block;}

.property-video-box{padding:50px 0;background:var(--white)}
.video-container{margin-top:30px;border-radius:15px;overflow:hidden;}
.property-video-box .video-heading{font-size:22px;line-height:27px;display: block;color: var(--gray-500);font-weight: 700;}
@media screen and (max-width:1024px){
/* banner section css */
.floorplan-banner-left .floorplan-banner-details .project-name{font-size:18px}
.banner-meta-chip{min-width:140px}

/* configuration section css */
.bhk-type-tab{flex:0 0 calc(33.33% - 8px)}
.panel-right-box{width:340px}
}
@media screen and (max-width:768px){
/* common css */
.heading{font-size:20px;line-height:24px;}
.sub-heading{font-size:14px;line-height:19px;}

/* banner section css */
.floorplan-banner-left .banner-meta-chip .meta-chip-value{font-size:14px;}
.floorplan-banner-inner{padding:20px 0 0 0;flex-direction:column;align-items: flex-start;gap:16px;}
.floorplan-banner-left .project-img{width:72px;height:72px}
.floorplan-banner-inner .floorplan-banner-left{padding-bottom:64px;gap:18px;position: relative;width:100%}
.floorplan-banner-details .floorplan-banner-meta-row{position:absolute;content:''; gap:8px;left:0;bottom:0;display:flex;gap:0;flex-wrap:nowrap;width:100%}
.floorplan-banner-left .banner-meta-chip{padding:0;padding-right:18px; width:50%;min-width:50%;background:inherit;border:none;border-radius:0;gap:10px;}
.floorplan-banner-left .banner-meta-chip + .banner-meta-chip{position: relative;left:-10px; padding-right:0; padding-left:18px;border-left: 1px solid rgba(255, 255, 255, 0.21);}
.floorplan-banner-left .floorplan-banner-details .project-name{font-size:16px;line-height:22px;white-space:normal}
.floorplan-banner-left .banner-meta-chip{flex:1}
.floorplan-btn-box{width:100%;flex-direction:row-reverse;}
.floorplan-btn-box .btn{width:100%;white-space:nowrap;}
.floorplan-banner-left .floorplan-banner-details .project-location{margin-top:5px;line-height:normal;}
.floorplan-banner-left .banner-meta-chip .meta-chip-text{gap:2px;}
.floorplan-banner-left .banner-meta-chip em{font-size:20px;}
.floorplan-banner-left .banner-meta-chip .meta-chip-label{font-size:10px;line-height:normal;}

/* configuration section css */
.configuration-section{padding:18px 0 24px;}
.configuration-section .tab-box{padding:0 18px;border:none;}
.configuration-section .tab-box li{border-radius:8px;}
.panel-detail-box{padding-top:30px;}
.panel-left-box{width:100%;}
.panel-left-box .panel-description{margin-top:12px;font-size:14px;line-height:19px;}
.panel-right-box{margin-top:12px;width:100%}
.fp-unit-video{height:226px;}
.media-caption{padding:10px 15px;}
.media-caption .media-title{font-size:16px;line-height:19px;}
.panel-left-box .detail-price-row .detail-price{line-height:21px;}
.aminity-card-box{width:100%;display: flex;flex-wrap: wrap;}
.aminity-card-box .aminity-card{padding: 10px;width: calc(50% - 8px);}
.bhk-type-tabbox{padding:0 15px 8px; margin:20px -15px 0px}
.bhk-type-tab{flex:0 0 calc(75vw - 28px);min-width:0}
.bhk-tab-header .card-name{font-size:14px;line-height:21px;}
.panel-left-box .cta-btn{width:100%;}
.aminity-card em{ width: 20px; height: 20px; font-size: 18px;}
.highlights-list li{line-height:19px;}

.property-bhk-container{margin-top:25px; flex-direction:column;gap:20px;}
.allkeys-bhk{width:100%;}

.property-video-box{padding:20px 0; border-top:6px solid #e4e0e0}
.bhk-tab-badge{top:8px}
.video-container{margin-top:25px}
}


