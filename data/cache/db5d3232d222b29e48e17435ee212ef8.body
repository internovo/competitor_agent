        NavigationBar_NavButton__JwONn primary" data-testid="blox-button"><div class="Button_ButtonContent__qPyqO Button_ButtonContent-md__1XTQo"><div class="undefined Button_Text-md__R7FDU Button_BtnText__nrjra  primary " data-testid="text-custom">BOOK PROPERTY</div></div></div></div></div><div class="PropertyDetails_RelativeComponentCtn__xJB6K"><div class="PropertyDetails_BodyWrapper__xzEAL"><div class="PropertyDetails_leftSection__nwaCM"><section id="Overview"><div class="Overview_OverviewMain__jK_BF"><div class="Overview_Overview__Bc1p3 false" data-testid="blox-Overview"><h2 class="text_Htitle__vsNcm undefined Overview_HeadingTextOverview__4Xh33"><div class="undefined  text_text-20px__KiVZf" data-testid="text-custom">Overview</div></h2><div class="Overview_OverviewData__cLXua"><div class="TruncatedText_TruncateText__iKHoI text-12 
            undefined
            undefined"><div class="undefined TruncatedText TruncatedText_line-4__CGy8m Overview_OverviewDescriptionTruncText__KLEw7 
                 " data-testid="text-custom">Rustomjee Reserve is a premium residential project in Dahisar, Mumbai, situated within the well-established Rustomjee Acres township. This elegant multi-storeyed tower offers beautifully designed 2 &amp; 3 BHK homes in Mumbai, surrounded by 50,000 sq. ft. of open green spaces &amp; children’s play areas. Thoughtfully planned to provide serene views, refreshing westerly breezes &amp; tranquil sunsets, Rustomjee Reserve Dahisar blends modern living with the charm of nature. With sophisticated design, contemporary amenities &amp; a prime location, it is an ideal choice for families and investors seeking luxury homes in Dahisar &amp; promising real estate opportunities in Mumbai.</div></div></div><div class="Overview_OverviewGrid__OKQXI false"><div><div class="Overview_LabelValue__6n8p7"><div class="undefined Overview_OverviewLabel__SqP8W text_text-14px__aPnkg" data-testid="text-custom">Configuration</div><div class="undefined Overview_Value__mQWHK text_text-14px__aPnkg" data-testid="text-custom">2 BHK, 3 BHK</div></div></div><div class="Overview_Separator__72rcU"></div><div><div class="Overview_LabelValue__6n8p7"><div class="undefined Overview_OverviewLabel__SqP8W text_text-14px__aPnkg" data-testid="text-custom">Ready to move</div><div class="undefined Overview_Value__mQWHK text_text-14px__aPnkg" data-testid="text-custom">Completed in Dec 2025</div></div></div><div class="Overview_Separator__72rcU"></div><div><div class="Overview_LabelValue__6n8p7"><div class="undefined Overview_OverviewLabel__SqP8W text_text-14px__aPnkg" data-testid="text-custom">Avg. Price</div><div class="undefined Overview_Value__mQWHK text_text-14px__aPnkg" data-testid="text-custom">₹34,720/sq.ft</div></div></div><div class="Overview_Separator__72rcU"></div><div><div class="Overview_LabelValue__6n8p7"><div class="undefined Overview_OverviewLabel__SqP8W text_text-14px__aPnkg" data-testid="text-custom">RERA Carpet Area</div><div class="undefined Overview_Value__mQWHK text_text-14px__aPnkg" data-testid="text-custom">769 - 1273 sqft</div></div></div></div></div><div><div class="Overview_ListContainer__RcPDE "><div class="Overview_highlightHeading__8JSvd">Why consider <span>buying this property</span>?</div><div class="Overview_HighlightsContainer__cYf_c"><ul class="Overview_Squarelist__NXH7D"><li>Experience the tranquility of Dahisar, a peaceful and scenic locale.</li><li>Join a well-established residential neighborhood that fosters community and connection.</li><li>Enjoy breathtaking views of 50,000 sq. ft. of beautifully landscaped green open spaces.</li><li>Reside in a premium standalone multi-storey tower within the esteemed Rustomjee Acres community.</li></ul><ul class="Overview_Squarelist__NXH7D"><li>Discover elegantly designed 2 and 3 BHK homes that redefine modern living.</li><li>Indulge in luxury lifestyle amenities complemented by spacious layouts for ultimate comfort.</li><li>Benefit from natural ventilation in your home, along with stunning sunset views and a gentle westerly breeze.</li></ul></div></div></div></div></section><section id="AIReviewSummary"><div class="AIReviewSummary_Container__cdZ_7 Card_secondary__V9lZX Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="AIReviewSummary_Header__Z33Z1"><div class="AIReviewSummary_TitleWrapper__VrIqs"><div class="AIReviewSummary_TitleRow__RxyFc"><h2 class="text_Htitle__vsNcm AIReviewSummary_Title__r4_AU"><div class="undefined  text_desktop-heading-3__6qV5j" data-testid="text-custom">Google AI Summary</div></h2><span class="AIReviewSummary_Sparkle__4AIGg">✦</span></div><div class="AIReviewSummary_AiBadge__yHMUt"></div></div></div><div class="AIReviewSummary_ContentWrapper__H1KTG" style="max-height:380px"><div class="AIReviewSummary_Grid__9zT79"><div class="AIReviewSummary_PointsCard__WtPbt  Card_secondary__V9lZX Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="AIReviewSummary_CardHeader__W5nac"><img alt="up-thumb" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class="AIReviewSummary_CardIcon__x8doc" style="color:transparent" src="/assets/icons/up-thumb.svg"/><h3 class="text_Htitle__vsNcm AIReviewSummary_CardTitle__3bBl_"><div class="undefined  text_desktop-heading-5__YAUk5" data-testid="text-custom">The good things</div></h3></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Connectivity</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">The project is located within 2 kilometers of both Dahisar and Borivali railway stations and is close to the upcoming metro lines.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Established Neighborhood</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Being part of Rustomjee Acres ensures a well-maintained environment with existing infrastructure like Rustomjee International School nearby.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Luxury Amenities</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Features such as the rooftop cabana, open-sky gymnasium, and co-working spaces are highly rated for modern urban living.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Design and Layout</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">The apartments are noted for being spacious with large windows that provide ample natural light and cross-ventilation.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Reputed Developer</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Reviewers express high trust in the Rustomjee brand for its track record of delivery and construction standards.</div></div></div></div><div class="AIReviewSummary_PointsCard__WtPbt  Card_secondary__V9lZX Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="AIReviewSummary_CardHeader__W5nac"><img alt="down-thumb" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class="AIReviewSummary_CardIcon__x8doc" style="color:transparent" src="/assets/icons/down-thumb.svg"/><h3 class="text_Htitle__vsNcm AIReviewSummary_CardTitle__3bBl_"><div class="undefined  text_desktop-heading-5__YAUk5" data-testid="text-custom">Needs improvement</div></h3></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Local Traffic</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">The Rustom Irani Marg and nearby access roads often face heavy congestion during peak office hours.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Waterlogging Issues</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Some residents have mentioned that low-lying areas in Dahisar West are prone to minor waterlogging during heavy monsoons.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Parking Space</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">Visitor parking is limited, which can be a challenge for residents hosting guests.</div></div></div><div class="AIReviewSummary_Item__1e62m"><span class="AIReviewSummary_Bullet__YwiF8"></span><div><div class="undefined AIReviewSummary_ItemTitle__lg3YU text_desktop-body__tJn8c" data-testid="text-custom">Premium Pricing</div><div class="undefined AIReviewSummary_ItemDesc__VLroL text_desktop-body-sm__qq5_7" data-testid="text-custom">The project carries a significant price premium compared to other standalone buildings in the Dahisar West locality.</div></div></div></div></div><div><hr class="AIReviewSummary_Divider__md7XZ"/><div class="undefined AIReviewSummary_VerdictLabel__jEfM0 text_desktop-heading-5__YAUk5" data-testid="text-custom">The Verdict</div><div class="AIReviewSummary_VerdictTags___OivB"><span class="AIReviewSummary_VerdictTag__XMXZK"><div class="undefined  text_desktop-body-sm__qq5_7" data-testid="text-custom">Great for families</div></span><span class="AIReviewSummary_VerdictTag__XMXZK"><div class="undefined  text_desktop-body-sm__qq5_7" data-testid="text-custom">Excellent for remote workers</div></span><span class="AIReviewSummary_VerdictTag__XMXZK"><div class="undefined  text_desktop-body-sm__qq5_7" data-testid="text-custom">High investment potential</div></span><span class="AIReviewSummary_VerdictTag__XMXZK"><div class="undefined  text_desktop-body-sm__qq5_7" data-testid="text-custom">Ideal for station commuters</div></span><span class="AIReviewSummary_VerdictTag__XMXZK"><div class="undefined  text_desktop-body-sm__qq5_7" data-testid="text-custom">Premium lifestyle choice</div></span></div></div><div class="AIReviewSummary_FadeOverlay__CFpBd" style="opacity:1"></div></div><div class="AIReviewSummary_ToggleContainer__OfGS6 "><button class="AIReviewSummary_ViewMoreBtn__LXBrc"><div class="undefined AIReviewSummary_BtnText__a2mA5 text_mobile-cta__98PCA" data-testid="text-custom">REVEAL FULL SUMMARY</div><span class="AIReviewSummary_BtnIcon__HS5CT">✦</span><div class="AIReviewSummary_Shimmer__D9tsE"></div></button></div></div></section><section id="Amenities"><div class="Amenities_Amenities__Idw7g" data-testid="blox-Amenities"><div class="Amenities_AmmCard__Gu2e5 Card_secondary__V9lZX Card_BloxCard__LQ6Yv" style="height:auto;width:auto" data-testid="blox-card"><div class="Amenities_AmenitiesHeadingTxt__bxyH0 squarebx rightPos"><h2 class="text_Htitle__vsNcm "><div class="undefined  text_text-20px__KiVZf" data-testid="text-custom">Amenities</div></h2></div><div class="Amenities_amenitiesDesktop__NRcWU"><div class="Amenities_TagGrid__rI9__"><div class="Amenities_IconLabel__WOGsG"><img alt="amenities/gym-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class="" style="color:transparent" src="/assets/icons/amenities/gym-secondary.svg"/><div>Gymnasium</div></div><div class="Amenities_IconLabel__WOGsG"><img alt="amenities/indoor-games-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" height="24" data-nimg="1" class="" style="color:transparent" src="/assets/icons/amenities/indoor-games-secondary.svg"/><div>Indoor Games</div></div><div class="Amenities_IconLabel__WOGsG"><img alt="amenities/Intercom-Facility-secondary" decoding="async" data-testid="next-image-ctn" loading="lazy" width="24" heig