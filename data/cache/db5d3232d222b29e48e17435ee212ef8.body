ority)","url":"https://maharera.maharashtra.gov.in","reraLink":"https://maharera.maharashtra.gov.in/projects-search-result?certificate_no=P51800028564"}},"BookPropertyEnabled":false,"structuredData":["\n{\n  \"@context\": \"https://schema.org/\",\n  \"@type\": \"BreadcrumbList\",\n  \"itemListElement\": [{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Mumbai\",\"item\":\"https://blox.xyz/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Properties in Mumbai\",\"item\":\"https://blox.xyz/buy/mumbai/1a256\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Properties in Dahisar West\",\"item\":\"https://blox.xyz/buy/mumbai/dahisar-west-1a256b7a43\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Rustomjee Builders\",\"item\":\"https://blox.xyz/buy/mumbai/dahisar-west-rustomjee-builders-1a256b7a43b13a8\"},{\"@type\":\"ListItem\",\"position\":5,\"name\":\"Rustomjee Reserve\",\"item\":\"https://blox.xyz/projects/rustomjee-reserve\"}]\n}","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\"@type\":\"Question\",\"name\":\"When is the possession date for Rustomjee Reserve?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Possession date of Rustomjee Reserve is 30 Jun 2025\"}},{\"@type\":\"Question\",\"name\":\"What is the RERA carpet area range of Rustomjee Reserve?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The RERA carpet area range for Rustomjee Reserve is 769 - 1273 sqft\"}},{\"@type\":\"Question\",\"name\":\"What is the price range of Rustomjee Reserve?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The price range of Rustomjee Reserve is ₹2.67 Cr - 4.42 Cr\"}},{\"@type\":\"Question\",\"name\":\"Where is Rustomjee Reserve located?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Rustomjee Reserve is located at Rustomjee Reserve, Rangnath Keskar Marg, Jaywant Sawant Marg, next to BMC Building, Dahisar West, Mumbai, Maharashtra 400068.\"}},{\"@type\":\"Question\",\"name\":\"What configurations are available in Rustomjee Reserve?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Rustomjee Reserve has 2 BHK, 3 BHK configurations.\"}},{\"@type\":\"Question\",\"name\":\"What is the status of Rustomjee Reserve?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The status of Rustomjee Reserve is Ready to move.\"}},{\"@type\":\"Question\",\"name\":\"Which amenities are provided in Rustomjee Reserve?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The amenities are Gymnasium, Indoor Games, Intercom Facility, Jogging / Cycle Track, Kids Play Areas / Sand Pits, Large Green Area, Multipurpose Hall, Senior citizen Area, Swimming Pool, Walking Area, Yoga Area.\"}},{\"@type\":\"Question\",\"name\":\"Who is the developer of Rustomjee Reserve?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The developer of Rustomjee Reserve is Rustomjee Builders.\"}}]\n}\n","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"Rustomjee Reserve\",\n  \"image\": \"https://cdn.blox.xyz/builders/thumb/031121044517-download.jpeg\",\n  \"description\": \"Rustomjee Reserve is a premium residential project in Dahisar, Mumbai, situated within the well-established Rustomjee Acres township. This elegant multi-storeyed tower offers beautifully designed 2 \u0026 3 BHK homes in Mumbai, surrounded by 50,000 sq. ft. of open green spaces \u0026 children’s play areas. Thoughtfully planned to provide serene views, refreshing westerly breezes \u0026 tranquil sunsets, Rustomjee Reserve Dahisar blends modern living with the charm of nature. With sophisticated design, contemporary amenities \u0026 a prime location, it is an ideal choice for families and investors seeking luxury homes in Dahisar \u0026 promising real estate opportunities in Mumbai.\",\n  \"brand\": {\n\t\t\"@type\": \"Brand\",\n\t\t\"name\": \"Rustomjee Builders\"\n\t},\n  \"offers\": {\n\t\t\"@type\": \"AggregateOffer\",\n    \"url\": \"https://blox.xyz/projects/rustomjee-reserve\",\n\t\t\"priceCurrency\": \"INR\",\n\t\t\"lowPrice\": \"26700000.00\",\n\t\t\"highPrice\": \"44198560.00\"\n\t}\n}\n","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": [\n      \"SingleFamilyResidence\",\n      \"Product\",\n      \"RealEstateListing\"\n  ],\n  \"@id\": \"https://blox.xyz/projects/rustomjee-reserve\",\n  \"mpn\": \"P51800028564\",\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"@id\": \"https://blox.xyz/buy/mumbai/rustomjee-builders-1a256b13a8\",\n    \"name\": \"Rustomjee Builders\"\n  },\n  \"url\": \"https://blox.xyz/projects/rustomjee-reserve\",\n  \"containedInPlace\": {\n      \"@type\": \"Place\",\n      \"@id\": \"Rustomjee Reserve\",\n      \"url\": \"https://blox.xyz/projects/rustomjee-reserve\",\n      \"name\": \"Rustomjee Reserve\",\n      \"address\": {\n          \"@type\": \"PostalAddress\",\n          \"streetAddress\": \"Rustomjee Reserve, Rangnath Keskar Marg, Jaywant Sawant Marg, next to BMC Building, Dahisar West, Mumbai, Maharashtra 400068\",\n          \"addressLocality\": \"Dahisar West\",\n          \"addressRegion\": \"Mumbai\",\n          \"postalCode\": \"400068\",\n          \"addressCountry\": \"IN\"\n      }\n  },\n  \"description\": \"Rustomjee Reserve is a premium residential project in Dahisar, Mumbai, situated within the well-established Rustomjee Acres township. This elegant multi-storeyed tower offers beautifully designed 2 \u0026 3 BHK homes in Mumbai, surrounded by 50,000 sq. ft. of open green spaces \u0026 children’s play areas. Thoughtfully planned to provide serene views, refreshing westerly breezes \u0026 tranquil sunsets, Rustomjee Reserve Dahisar blends modern living with the charm of nature. With sophisticated design, contemporary amenities \u0026 a prime location, it is an ideal choice for families and investors seeking luxury homes in Dahisar \u0026 promising real estate opportunities in Mumbai.\",\n  \"floorSize\": [\n      {\n          \"@type\": \"QuantitativeValue\",\n          \"unitCode\": \"SQFT\",\n          \"minValue\": \"769\",\n          \"maxValue\": \"1273\"\n      }\n  ],\n  \"image\": [\n      {\n          \"@type\": \"ImageObject\",\n          \"url\": \"https://cdn.blox.xyz/builders/thumb/031121044517-download.jpeg\"\n      }\n  ],\n  \"name\": \"Rustomjee Reserve\",\n  \"offers\": {\n      \"@type\": \"Offer\",\n      \"@id\": \"P51800028564\",\n      \"availability\": \"https://schema.org/InStock\",\n      \"name\": \"Sale of Rustomjee Reserve Unit\",\n      \"url\": \"https://blox.xyz/projects/rustomjee-reserve\",\n      \"price\": 26700000.00,\n      \"priceCurrency\": \"INR\"\n  }\n}\n"],"aiReviewSummary":{"pros":[{"title":"Connectivity","description":"The project is located within 2 kilometers of both Dahisar and Borivali railway stations and is close to the upcoming metro lines."},{"title":"Established Neighborhood","description":"Being part of Rustomjee Acres ensures a well-maintained environment with existing infrastructure like Rustomjee International School nearby."},{"title":"Luxury Amenities","description":"Features such as the rooftop cabana, open-sky gymnasium, and co-working spaces are highly rated for modern urban living."},{"title":"Design and Layout","description":"The apartments are noted for being spacious with large windows that provide ample natural light and cross-ventilation."},{"title":"Reputed Developer","description":"Reviewers express high trust in the Rustomjee brand for its track record of delivery and construction standards."}],"cons":[{"title":"Local Traffic","description":"The Rustom Irani Marg and nearby access roads often face heavy congestion during peak office hours."},{"title":"Waterlogging Issues","description":"Some residents have mentioned that low-lying areas in Dahisar West are prone to minor waterlogging during heavy monsoons."},{"title":"Parking Space","description":"Visitor parking is limited, which can be a challenge for residents hosting guests."},{"title":"Premium Pricing","description":"The project carries a significant price premium compared to other standalone buildings in the Dahisar West locality."}],"verdict":["Great for families","Excellent for remote workers","High investment potential","Ideal for station commuters","Premium lifestyle choice"]},"googleReviews":{"html_attributions":[],"result":{"rating":4.6,"reviews":[{"author_name":"Bharat Desai","author_url":"https://www.google.com/maps/contrib/103898025697164032831/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjX4MxI-TyS7BajeU9s6bqB6uuNiRotfR_fG6GA6-b5i_lYFFcL2pA=s128-c0x00000000-cc-rp-mo","rating":5,"relative_time_description":"5 months ago","text":"\"I had an exceptional experience working with Rohan Hajare, the NRI Portfolio Manager for Rustomjee. Finding a residential apartment in Mumbai while being overseas can be daunting, but Rohan made the entire process seamless and stress-free. He truly understands the specific needs of NRI clients and provided expert guidance at every step.\n\nA special shout-out to his assistant in Dahisar, Hardik, who was incredibly helpful, proactive, and patient with all our queries during the site visits. The professionalism and dedication shown by both Rohan and Hardik are commendable. If you are looking for a home in Mumbai, I highly recommend reaching out to them!\"","time":1772816628,"translated":false},{"author_name":"Aditya Mondkar","author_url":"https://www.google.com/maps/contrib/117880410060311315948/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjXzZvggR5U-K1uxDtVDqllloEBZgIns8zuxA0mc9fjXki6zoCoV=s128-c0x00000000-cc-rp-mo","rating":5,"relative_time_description":"2 months ago","text":"Best building in Dahisar","time":1781609726,"translated":false},{"author_name":"Devesh Parihar","author_url":"https://www.google.com/maps/contrib/104285099584467636256/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjUei4CYG0FNwmnOM7XAxsKA2y3z1CR5ucV495MPJTycX5g2lOyH=s128-c0x00000000-cc-rp-mo-ba2","rating":5,"relative_time_description":"3 years ago","text":"Clean Locality very nearby to Borivali and Dahisar Station. Spacious flats.","time":1690356689,"translated":false},{"author_name":"Janmesh E","author_url":"https://www.google.com/maps/contrib/113377279552742648363/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjXeGw4WjejJ48zziG9k8bcS2ber799eZCYkYMcQJMxMEhaYxbWy=s128-c0x00000000-cc-rp-mo-ba4","rating":4,"relative_time_description":"a year ago","text":"Luxury living ✅💯","time":1735957075,"translated":false},{"author_name":"Ankita chaudhari","author_url":"https://www.google.com/maps/contrib/104837759970980803435/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a/ACg8ocLuWM9rkRU4TEFdY5GPOmSiAJg7rmjbbRhCGocblPiogXlEisIX=s128-c0x00000000-cc-rp-mo","rating":5,"relative_time_description":"a year ago","text":"Best place","time":1725437943,"translated":false}],"url":"https://maps.google.com/?cid=3598495066893850531","user_ratings_total":19},"status":"OK"}},"isMobile":false,"footerData":{"featured":{"kolkata":{"label":"Kolkata","id":14},"mumbai":{"label":"Mumbai","id":256},"navi-mumbai":{"label":"Navi Mumbai","id":261},"pune":{"label":"Pune","id":300},"thane":{"label":"Thane","id":269}},"others":{"alibaug":{"label":"Alibaug","id":1907},"bangalore":{"label":"Bangalore","id":95},"noida":{"label":"Noida","id":84},"palghar":{"label":"Palghar","id":264},"raigad":{"label":"Raigad","id":3323},"telangana":{"label":"Telangana","id":3326}}},"__N_SSP":true},"page":"/projects/[project_name]","query":{"project_name":"rustomjee-reserve"},"buildId":"t4LZHlTlBLViwyNa5GApO","isFallback":false,"gssp":true,"appGip":true,"scriptLoader":[]}</script></body></html>