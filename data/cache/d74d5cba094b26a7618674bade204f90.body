          <div class="master-plan-container">
            
            <div class="master-plan-section master-images">
              
              
              <div id="master-plan-panel-1" class="master-plan-content active" role="tabpanel" aria-labelledby="master-plan-tab-1" tabindex="0">
                <figure class="master-plan-image load-gallery master-images"> <img class="img-responsive" src="https://static.squareyards.com/resources/images/mumbai/project-image/shraddha-paradise-project-master-plan-image1-7487.jpg?aio=w-370;h-366;crop;" width="370" height="366" loading="lazy" decoding="async" alt="Shraddha-Paradise_a collage of photos of a building"> </figure>
              </div>
              
            </div>
            
              
            
              <aside class="media-gallery-grid three">
                
                <figure class="gallery-item exterior load-gallery"> <img class="img-responsive" src="https://static.squareyards.com/resources/images/mumbai/project-image/shraddha-paradise-project-floor-plans1-9130.jpg?aio=w-192;h-168;crop;" width="170" height="139" loading="lazy" decoding="async" alt="Shraddha Paradise Floor Plans"> </figure>
                
                
                <figure class="gallery-item more-images load-gallery"> <img class="img-responsive" src="https://static.squareyards.com/resources/images/mumbai/project-image/shraddha-paradise-project-entrance-view1-8778.jpg?aio=w-192;h-168;crop;" width="170" height="139" loading="lazy" decoding="async" alt="Shraddha Paradise Entrance View">
