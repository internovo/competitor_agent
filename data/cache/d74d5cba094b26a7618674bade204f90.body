                </figure>
                
                
                <figure class="gallery-item video-item video load-gallery"> <img class="img-responsive" src="https://static.squareyards.com/resources/images/mumbai/tn-projectflagship/tn-shraddha-paradise-project-flagship.jpg?aio=w-192;h-168;crop;" width="353" height="215" loading="lazy" decoding="async" alt="Shraddha Paradise Video">
