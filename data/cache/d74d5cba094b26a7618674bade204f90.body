      document.addEventListener('click', (event) => {
        if (event.target.closest('#gblCityBtn')) {
          event.stopImmediatePropagation();
          const removeNodes = document.querySelectorAll(".bottomnavigation nav,.navOverlay,#nav-toggle");
          const toggleNodes = document.querySelectorAll("body,.gblOverflow,#gblCityBtn,#gblCityBox,#dev_headercitypopup_container");
          const showNodes   = document.querySelectorAll(".allCitiesBoxx,li.headercityli,#dev_headeroverlay");
          requestAnimationFrame(() => {
            for (let i = 0; i < removeNodes.length; i++) removeNodes[i].classList.remove('active');
            for (let i = 0; i < toggleNodes.length; i++) toggleNodes[i].classList.toggle('active');
            for (let i = 0; i < showNodes.length; i++)   showNodes[i].style.display = 'block';
          });
        }
      }, true);
      window.addEventListener('load', function(){
        document.querySelector('#loaderBox').style.display = 'none';
      });
      
      
        if(document.querySelectorAll('.megaMenuData .megaDropDownLinks').length){
          document.querySelectorAll('.megaMenuData .megaDropDownLinks').forEach(function(element, index) {
            let targetTab = element.getAttribute('data-tab');
            if(targetTab){
              document.querySelector(`.desktopNav li .megaDropDownLinks[data-tab="${targetTab}"]`).innerHTML = element.innerHTML;
            }
            element.remove();
          });
          document.querySelector('.megaMenuData').remove();	
        }
      
      
      
