<style id="wp-custom-css">
.collapse.in {
    display: block;
    border-style: solid !important;
    border-width: 1px !important;
    border-color: #ffc64c !important;
    box-shadow: 1px 4px  !important;
	border-radius:10px !important;
}

.property-panel .panel-heading {
    background-color: #f0fd85 !important;
    background-image: none;
    padding: 30px 30px 15px 30px;
    border-radius: 7px;
    border-style: dotted !important;
    border-color: #ebd350 !important;
    border-width: 2px !important;
}
.wpestate_property_description {
    background-color: #fff;
    padding: 30px;
    display: inline-block;
    width: 100%;
    min-height: 1px;
    line-height: 1.6em;
    margin-bottom: 30px;
    border-style: solid !important;
    border-width: 1px !important;
    border-color: #ffc64c !important;
    box-shadow: 1px 4px !important;
}

.agent_content, .wpestate_agent_details_wrapper {
    padding: 30px;
    background-color: #fff;
    float: left;
    width: 100%;
    position: relative;
    z-index: 90;
    border-width: 1px !important;
    border-color: #ffc64c !important;
    box-shadow: 1px 4px !important;
}

.property-panel {
    margin-bottom: 30px;
    width: 100%;
    min-height: 1px;
    display: inline-block;
    line-height: 1.65em;
