          <div class="about-developer-header">
            
            <div class="developer-logo"><img src="https://static.squareyards.com/resources/images/developerlogo/arvind-426-4561.jpg?aio=w-300;h-300;fill;" alt="Arvind logo" class="img-responsive" width="300" height="300" loading="lazy" decoding="async"> </div>
            
            
