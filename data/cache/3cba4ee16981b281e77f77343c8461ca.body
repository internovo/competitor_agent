    <style>
        /* Ensures the sticky footer doesn't overlap content, similar to body { padding-bottom: 100px; } */
         /* Default styles for desktop */
body {
    font-family: initial; /* or whatever default you want */
    padding-bottom: 0;
}

/* Mobile styles */
@media (max-width: 768px) {  /* Adjust breakpoint as needed */
    body {
        padding-bottom: 4rem;
        font-family: 'Inter', sans-serif;
    }
}

        /* Custom Styles to fine-tune the look */
        .sticky-contact {
            /* 100% width, fixed at the bottom, centered */
            height: 4rem;
            /* 80px */
            /* Tailwind classes for positioning: fixed bottom-0 left-0 right-0 z-50 */
        }

        .sticky-btn {
            transition: transform 0.15s ease-in-out;
            border-radius: 0;
            /* Ensures square edges for the full-width look */
        }

        /* Call Button Style (White/Light Grey BG, Black Text) */
        .sticky-btn.call {
            background-color: #f3f4f6;
            /* A very light gray to suggest separation */
            color: #1f2937;
            /* Dark text */
        }

        /* WhatsApp Button Style (Solid Bright Green BG, White Text) */
        .sticky-btn.whatsapp {
            background-color: #25d366;
            color: #ffffff;
        }

        /* Optional: Adding a subtle shadow/lift on hover for better UX */
        .sticky-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            z-index: 51;
        }
    </style>


    <script>
        // Swiper Initialization
        var swiper = new Swiper(".myGallery", {
            effect: "coverflow",
            grabCursor: true,
            centeredSlides: true,
            slidesPerView: "auto",
            loop: true,
            spaceBetween: 30,
            coverflowEffect: {
                rotate: 0,
                stretch: 0,
                depth: 100,
                modifier: 1,
                slideShadows: false, // Clean look
            },
            autoplay: {
                delay: 2500,
                disableOnInteraction: false,
            },
            pagination: {
                el: ".swiper-pagination",
                clickable: true,
            },
        });

        // Form Submission Logic
        document.getElementById('leadForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const submitBtn = this.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerText;

            // Validation: Mobile Length
            const mobile = this.querySelector('input[name="phone"]').value;
            if (mobile.length !== 10) {
                alert('Please enter a valid 10-digit mobile number.');
                return;
            }

            // Show Loading State
            submitBtn.innerText = 'Processing...';
            submitBtn.disabled = true;

            const formData = new FormData(this);

            fetch('submit_lead_general', {
                method: 'POST',
                body: formData
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = 'thank-you.html';
                    } else {
                        alert('Error: ' + data.message);
                        submitBtn.innerText = originalText;
                        submitBtn.disabled = false;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Something went wrong. Please try again.');
                    submitBtn.innerText = originalText;
                    submitBtn.disabled = false;
                });
        });

        // Modal form submission
        const modalForm = document.getElementById('leadFormModal');
        if (modalForm) {
            modalForm.addEventListener('submit', function (e) {
                e.preventDefault();
                const submitBtn = this.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerText;
                const mobile = this.querySelector('input[name="phone"]').value;
                if (mobile.length !== 10) {
                    alert('Please enter a valid 10-digit mobile number.');
                    return;
                }
                submitBtn.innerText = 'Processing...';
                submitBtn.disabled = true;
                const formData = new FormData(this);
                fetch('submit_lead_general', {
                    method: 'POST',
                    body: formData
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            window.location.href = 'thank-you.html';
                        } else {
                            alert('Error: ' + data.message);
                            submitBtn.innerText = originalText;
                            submitBtn.disabled = false;
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Something went wrong. Please try again.');
                        submitBtn.innerText = originalText;
                        submitBtn.disabled = false;
                    });
            });
        }
    </script>


