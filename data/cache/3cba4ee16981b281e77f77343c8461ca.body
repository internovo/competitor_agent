   <!DOCTYPE html>
<html lang="en">
<head>
    <!--<meta charset="UTF-8">-->
    <!--<meta name="viewport" content="width=device-width, initial-scale=1.0">-->
    <!--<title>Premium Home Loan EMI Calculator | Calculate Monthly Interest & Principal</title>-->
    <!--<meta name="description" content="Calculate your monthly home loan EMI, total interest payable, and amortization schedule with our premium home loan calculator.">-->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        // 'theme-green02': '#10b981', // Adjust this hex code to match your specific theme-green
                        // 'accent-bg': '#f0fdf4',   // Adjust this hex code to match your specific accent-bg
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #fcfcfd; }
        .slider {
            -webkit-appearance: none;
            width: 100%;
            height: 6px;
            background: #e5e7eb;
            border-radius: 10px;
            outline: none;
        }
        .slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 24px;
            height: 24px;
            background: #1e40af;
            cursor: pointer;
            border-radius: 50%;
            border: 4px solid white;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        }
        .blur-gate {
            filter: blur(8px);
            pointer-events: none;
            user-select: none;
        }
        .premium-gradient {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        }
        details > summary { list-style: none; }
        details > summary::-webkit-details-marker { display: none; }
    </style>
</head>
<body class="p-4 md:p-12 text-slate-900">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <header class="text-center mb-12">
            <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 mb-4">Home Loan EMI Calculator</h1>
            <p class="text-slate-500 text-lg max-w-2xl mx-auto">Plan your future home with precision. Get instant breakdowns of your monthly payments and interest costs.</p>
        </header>

        <div class="bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden mb-16">
            <div class="grid grid-cols-1 lg:grid-cols-12">
                
                <!-- Inputs Section -->
                <div class="lg:col-span-7 p-8 md:p-12 space-y-10">
                    <!-- Loan Amount -->
                    <div>
                        <div class="flex justify-between items-center mb-4">
                            <label class="font-bold text-slate-700">Loan Amount</label>
                            <div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-4 py-2">
                                <span class="text-slate-400 font-medium mr-2">₹</span>
                                <input type="number" id="amountInput" value="5000000" class="bg-transparent font-bold text-blue-700 w-32 focus:outline-none">
                            </div>
                        </div>
                        <input type="range" id="amountSlider" min="100000" max="100000000" step="100000" value="5000000" class="slider">
                        <div class="flex justify-between text-xs font-semibold text-slate-400 mt-3">
                            <span>₹1 Lakh</span>
                            <span>₹10 Crore</span>
                        </div>
                    </div>

                    <!-- Interest Rate -->
                    <div>
                        <div class="flex justify-between items-center mb-4">
                            <label class="font-bold text-slate-700">Interest Rate (P.A.)</label>
                            <div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-4 py-2">
                                <input type="number" id="rateInput" value="8.5" step="0.1" class="bg-transparent font-bold text-blue-700 w-16 text-right focus:outline-none">
                                <span class="text-slate-400 font-medium ml-1">%</span>
                            </div>
                        </div>
                        <input type="range" id="rateSlider" min="5" max="20" step="0.1" value="8.5" class="slider">
                        <div class="flex justify-between text-xs font-semibold text-slate-400 mt-3">
                            <span>5%</span>
                            <span>20%</span>
                        </div>
                    </div>

                    <!-- Tenure -->
                    <div>
                        <div class="flex justify-between items-center mb-4">
                            <label class="font-bold text-slate-700">Tenure (Years)</label>
                            <div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-4 py-2">
                                <input type="number" id="tenureInput" value="20" class="bg-transparent font-bold text-blue-700 w-16 text-right focus:outline-none">
                                <span class="text-slate-400 font-medium ml-1">Yrs</span>
                            </div>
                        </div>
                        <input type="range" id="tenureSlider" min="1" max="30" step="1" value="20" class="slider">
                        <div class="flex justify-between text-xs font-semibold text-slate-400 mt-3">
                            <span>1 Year</span>
                            <span>30 Years</span>
                        </div>
                    </div>
                </div>

                <!-- Summary Section -->
                <div class="lg:col-span-5 premium-gradient p-8 md:p-12 text-white flex flex-col justify-between">
                    <div>
                        <h2 class="text-xl font-bold opacity-90 mb-8">Loan Summary</h2>
                        <div class="space-y-6">
                            <div class="flex flex-col">
                                <span class="text-sm opacity-70 uppercase tracking-widest font-semibold mb-1">Monthly EMI</span>
                                <span class="text-5xl font-black" id="monthlyEmiDisplay">₹0</span>
                            </div>
                            <div class="grid grid-cols-2 gap-6 pt-6 border-t border-white/20">
                                <div>
                                    <span class="text-xs opacity-70 uppercase font-bold block mb-1">Total Interest</span>
                                    <span class="text-xl font-bold" id="totalInterestDisplay">₹0</span>
                                </div>
                                <div>
                                    <span class="text-xs opacity-70 uppercase font-bold block mb-1">Total Amount</span>
                                    <span class="text-xl font-bold" id="totalAmountDisplay">₹0</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-10 bg-white/10 rounded-2xl p-6 backdrop-blur-md h-48">
                        <canvas id="emiChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Amortization Section with Gated Content -->
        <div class="relative mb-20">
            <h3 class="text-2xl font-bold text-slate-800 mb-6">Amortization Schedule</h3>
            
            <!-- Blurred Table Background -->
            <div id="scheduleContainer" class="overflow-x-auto rounded-2xl border border-slate-200 blur-gate">
                <table class="w-full text-left border-collapse bg-white">
                    <thead class="bg-slate-50">
                        <tr class="text-slate-500 text-sm">
                            <th class="p-4 font-bold border-b">Year</th>
                            <th class="p-4 font-bold border-b text-right">Opening Balance</th>
                            <th class="p-4 font-bold border-b text-right">Interest Paid</th>
                            <th class="p-4 font-bold border-b text-right">Principal Paid</th>
                            <th class="p-4 font-bold border-b text-right">Closing Balance</th>
                        </tr>
                    </thead>
                    <tbody id="scheduleBody" class="text-slate-700">
                        <!-- Rows injected by JS -->
                    </tbody>
                </table>
            </div>

            <!-- Unlock CTA Overlay -->
            <div id="ctaOverlay" class="absolute inset-0 flex items-center justify-center bg-slate-50/40 backdrop-blur-[2px] rounded-2xl">
                <div class="bg-white p-8 rounded-3xl shadow-2xl border border-slate-200 max-w-md w-full text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full mb-6">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                    <h4 class="text-xl font-bold mb-2">Detailed Amortization</h4>
                    <p class="text-slate-500 mb-6 text-sm">View the full year-by-year principal and interest breakdown to plan your repayment strategy.</p>
                    
                    <button onclick="openLeadModal()"
                        class="inline-flex items-center justify-center px-6 py-3 border border-theme-green text-sm font-bold uppercase tracking-widest rounded-lg text-theme-green bg-accent-bg hover:bg-theme-green hover:text-white transition duration-300">
                        View Full Schedule
                    </button>
                </div>
            </div>
        </div>

        <!-- FAQ Section -->
        <section class="max-w-4xl mx-auto mb-20">
            <h3 class="text-3xl font-extrabold text-center mb-10">Frequently Asked Questions</h3>
            <div class="space-y-4">
                <details class="group bg-white border border-slate-200 rounded-2xl overflow-hidden" open>
                    <summary class="flex justify-between items-center p-6 cursor-pointer font-bold text-slate-800">
                        What is a Home Loan EMI?
                        <span class="group-open:rotate-180 transition-transform">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </span>
                    </summary>
                    <div class="px-6 pb-6 text-slate-600 leading-relaxed">
                        EMI stands for Equated Monthly Installment. It is a fixed amount paid by a borrower to a lender at a specified date each month. EMIs are applied to both interest and principal each month so that over a specified number of years, the loan is paid off in full.
                    </div>
                </details>
                
                <details class="group bg-white border border-slate-200 rounded-2xl overflow-hidden">
                    <summary class="flex justify-between items-center p-6 cursor-pointer font-bold text-slate-800">
                        How is Home Loan EMI calculated?
                        <span class="group-open:rotate-180 transition-transform">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </span>
                    </summary>
                    <div class="px-6 pb-6 text-slate-600 leading-relaxed">
                        The mathematical formula for calculating EMI is: $E = P \times r \times \frac{(1+r)^n}{(1+r)^n - 1}$, where $E$ is EMI, $P$ is Principal Loan Amount, $r$ is monthly interest rate, and $n$ is loan duration in months.
                    </div>
                </details>
            </div>
        </section>
    </div>

    <script>
        const amountSlider = document.getElementById('amountSlider');
        const amountInput = document.getElementById('amountInput');
        const rateSlider = document.getElementById('rateSlider');
        const rateInput = document.getElementById('rateInput');
        const tenureSlider = document.getElementById('tenureSlider');
        const tenureInput = document.getElementById('tenureInput');

        const monthlyEmiDisplay = document.getElementById('monthlyEmiDisplay');
        const totalInterestDisplay = document.getElementById('totalInterestDisplay');
        const totalAmountDisplay = document.getElementById('totalAmountDisplay');
        const scheduleBody = document.getElementById('scheduleBody');
        
        const ctaOverlay = document.getElementById('ctaOverlay');
        const scheduleContainer = document.getElementById('scheduleContainer');

        let emiChart;

        function formatINR(number) {
            return new Intl.NumberFormat('en-IN', {
                style: 'currency',
                currency: 'INR',
                maximumFractionDigits: 0
            }).format(number);
        }

        function initChart() {
            const ctx = document.getElementById('emiChart').getContext('2d');
            emiChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Principal', 'Interest'],
                    datasets: [{
                        data: [5000000, 1500000],
                        backgroundColor: ['rgba(255,255,255,0.9)', 'rgba(255,255,255,0.4)'],
                        borderColor: 'transparent',
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { 
                            position: 'bottom',
                            labels: { color: 'white', font: { weight: 'bold', size: 10 } }
                        }
                    }
                }
            });
        }

        function calculateEMI() {
            const p = parseFloat(amountInput.value);
            const r = parseFloat(rateInput.value) / 12 / 100;
            const n = parseFloat(tenureInput.value) * 12;

            if (p > 0 && r > 0 && n > 0) {
                const emi = p * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1);
                const totalAmount = emi * n;
                const totalInterest = totalAmount - p;

                monthlyEmiDisplay.innerText = formatINR(emi);
                totalInterestDisplay.innerText = formatINR(totalInterest);
                totalAmountDisplay.innerText = formatINR(totalAmount);

                updateChart(p, totalInterest);
                generateSchedule(p, r, emi, n);
            }
        }

        function updateChart(p, interest) {
            if (emiChart) {
                emiChart.data.datasets[0].data = [p, interest];
                emiChart.update();
            }
        }

        function generateSchedule(p, r, emi, n) {
            let balance = p;
            let html = '';
            const yearsToShow = Math.ceil(n / 12);
            
            for (let i = 1; i <= yearsToShow; i++) {
                let yearlyInterest = 0;
                let yearlyPrincipal = 0;
                let opening = balance;

                for (let m = 1; m <= 12; m++) {
                    if (balance <= 0) break;
                    let interest = balance * r;
                    let principal = emi - interest;
                    yearlyInterest += interest;
                    yearlyPrincipal += principal;
                    balance -= principal;
                }

                html += `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="p-4 border-b font-medium text-slate-500">Year ${i}</td>
                        <td class="p-4 border-b text-right font-semibold">${formatINR(opening)}</td>
                        <td class="p-4 border-b text-right text-red-500 font-medium">${formatINR(yearlyInterest)}</td>
                        <td class="p-4 border-b text-right text-green-600 font-medium">${formatINR(yearlyPrincipal)}</td>
                        <td class="p-4 border-b text-right font-bold">${formatINR(Math.max(0, balance))}</td>
                    </tr>
                `;
            }
            scheduleBody.innerHTML = html;
        }

        function sync(source, target) {
            target.value = source.value;
            calculateEMI();
        }

        function openLeadModal() {
            // Function triggered by the CTA button
            // Unlocks the UI and removes the blur
            ctaOverlay.classList.add('hidden');
            scheduleContainer.classList.remove('blur-gate');
        }

        amountSlider.oninput = () => sync(amountSlider, amountInput);
        amountInput.oninput = () => sync(amountInput, amountSlider);
        rateSlider.oninput = () => sync(rateSlider, rateInput);
        rateInput.oninput = () => sync(rateInput, rateSlider);
        tenureSlider.oninput = () => sync(tenureSlider, tenureInput);
        tenureInput.oninput = () => sync(tenureInput, tenureSlider);

        window.onload = () => {
            initChart();
            calculateEMI();
        };
    </script>
</body>
</html>

<!-- MahaRERA Section -->
<section id="rera" class="bg-white py-20 border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="text-accent-gold font-bold tracking-widest uppercase text-xs">Transparency & Trust</span>
        <h2 class="text-3xl md:text-4xl font-serif text-theme-green mt-2 mb-12">MahaRERA Registration</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 justify-center">
                        <div class="bg-gray-50 p-8 border-b-4 border-accent-gold flex flex-col items-center">
                <div class="mb-6">
                    <img src="https://soboxpert.in/PropertiesImages/lodha-malabar-hill/maharera/1777715036_Lodha_Malabar_RERA_Number.png" 
                         alt="RERA QR for Lodha Malabar RERA Number" 
                         class="w-32 h-32 object-contain bg-white p-2 shadow-sm"
                         onerror="this.src='https://placehold.co/150x150?text=RERA+QR'">
                </div>
                <h4 class="text-theme-green font-serif text-xl mb-1">Lodha Malabar RERA Number</h4>
                <p class="text-accent-gold font-bold tracking-wider text-sm">P51900034949</p>
            </div>
                    </div>
        
        <p class="mt-12 text-gray-400 text-xs italic">
            Details available on the website <a href="https://maharera.maharashtra.gov.in" target="_blank" class="underline hover:text-accent-gold">maharera.maharashtra.gov.in</a> under registered projects.
        </p>
    </div>
</section>

      

    </main>
    
       
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxury Properties Showcase</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
    
    <style>
        h1, h2, h3, h4 { font-family: 'Cormorant Garamond', serif; }
        :root { --accent-gold: #BBA15B; --text-dark: #1a1a1a; --bg: #f7f7f7; --primary-white: #fff; }
        body { font-family: 'Montserrat', sans-serif; background: var(--bg); color: var(--text-dark); overflow-x: hidden; }
        
        /* Single Row Scrollable Container */
        .horizontal-scroll-container {
            display: flex;
            overflow-x: auto;
            gap: 1.5rem;
            padding: 1rem 0.5rem 2.5rem;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
        }
        
        .horizontal-scroll-container::-webkit-scrollbar {
            height: 6px;
        }
        .horizontal-scroll-container::-webkit-scrollbar-track {
            background: #eee;
            border-radius: 10px;
        }
        .horizontal-scroll-container::-webkit-scrollbar-thumb {
            background: var(--accent-gold);
            border-radius: 10px;
        }

        .property-card { 
            flex: 0 0 320px; /* Fixed width for horizontal scroll */
            border: 1px solid rgba(187, 161, 91, 0.12); 
            border-radius: 0; 
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); 
            background: white; 
        }
        @media (min-width: 768px) {
            .property-card { flex: 0 0 380px; }
        }

        .property-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.08); }
        
        .card-badge { position: absolute; font-size: 0.65rem; padding: 4px 10px; border-radius: 9999px; display: flex; gap: 6px; align-items: center; box-shadow: 0 2px 6px rgba(0,0,0,0.12); z-index: 10; font-weight: 600; text-transform: uppercase; }
        .status-badge { top: 0.8rem; left: 0.8rem; background: var(--accent-gold); color: white; }
