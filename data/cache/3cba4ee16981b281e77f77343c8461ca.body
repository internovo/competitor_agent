<script>
function openEnquire(project, loc){
    document.getElementById('enquireModal').classList.remove('hidden');
    document.getElementById('modal_project_title').innerText = project;
    document.getElementById('project_name_input').value = project;
    document.getElementById('project_location_input').value = loc;
    document.getElementById('page_url_input').value = window.location.href;
    document.body.style.overflow = 'hidden';
}
function closeModal(){
    document.getElementById('enquireModal').classList.add('hidden');
    document.body.style.overflow = 'auto';
}
</script>
