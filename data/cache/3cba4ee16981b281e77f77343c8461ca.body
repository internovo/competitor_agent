                        onclick="document.getElementById('faq-ans-5').classList.toggle('hidden'); this.querySelector('span.icon').classList.toggle('rotate-180')">
                    <span class="text-lg font-serif text-theme-green pr-8">Q. Is this project RERA approved? </span>
