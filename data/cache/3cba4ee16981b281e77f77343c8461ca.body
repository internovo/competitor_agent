<!-- Auto Scroll + iOS Momentum -->
<style>
    .floor-plans-slider {
        -webkit-overflow-scrolling: touch;
    }
</style>

<script>
    const slider = document.getElementById("floorPlansSlider");
    let autoScroll;
    let isPaused = false;

    function startAutoScroll() {
        autoScroll = setInterval(() => {
            if (isPaused) return;

            slider.scrollBy({
                left: slider.clientWidth * 0.9,
                behavior: "smooth"
            });

            if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 5) {
                slider.scrollTo({ left: 0, behavior: "smooth" });
            }
        }, 1200); // 1.2 seconds
    }

    function pauseAutoScroll() {
        isPaused = true;
        clearInterval(autoScroll);
    }

    function resumeAutoScroll() {
        isPaused = false;
        startAutoScroll();
    }

    if (slider) {
        startAutoScroll();

        // Pause on interaction
        slider.addEventListener("mouseenter", pauseAutoScroll);
        slider.addEventListener("mouseleave", resumeAutoScroll);
        slider.addEventListener("touchstart", pauseAutoScroll, { passive: true });
        slider.addEventListener("wheel", pauseAutoScroll);
    }
</script>


