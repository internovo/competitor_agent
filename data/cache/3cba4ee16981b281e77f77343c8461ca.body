<script>
function lxsShowModal(name, loc) {
    document.getElementById('lxsProj').innerText = name;
    document.getElementById('lxsInpProj').value = name;
    document.getElementById('lxsInpLoc').value = loc;
    document.getElementById('lxsModal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
}

function lxsHideModal(e) {
    if(!e || e.target.id === 'lxsModal' || e.type === 'click') {
        document.getElementById('lxsModal').style.display = 'none';
        document.body.style.overflow = 'auto';
    }
}

document.getElementById('lxsForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const btn = document.getElementById('lxsSubmit');
    btn.disabled = true; btn.innerText = "SENDING...";
    
    fetch('submit_lead_Master', { method: 'POST', body: new FormData(this) })
    .then(r => r.json())
    .then(data => {
        if(data.success) window.location.href = 'thank-you.html';
        else alert(data.message || "Error submitting form.");
    })
    .catch(() => { window.location.href = 'thank-you.html'; });
});
</script>
