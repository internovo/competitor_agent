    <!-- Lead Modal -->
    <div id="leadModal" class="fixed inset-0 bg-black/60 hidden z-50 items-center justify-center p-4">
        <div class="bg-white w-full max-w-md rounded-lg p-6 relative">
            <button id="closeLeadModal" class="absolute top-3 right-3 text-gray-600">✕</button>
            <h3 class="text-xl font-bold mb-2">Enquire Now</h3>
            <p class="text-sm text-gray-600 mb-4">Fill the form to get floorplans and pricing.</p>
            <form id="leadFormModal" class="space-y-4">
                <input type="hidden" name="project_name" value="Lodha Malabar">
                <input type="hidden" name="location" value="Malabar Hill">
                <input type="hidden" name="country_code" value="+91">
                <input type="hidden" name="country_name" value="India">
                <input type="hidden" name="cta_source" value="Modal Form">
                <input type="hidden" name="page_url" value="/lodha-malabar-hill">

                <!-- UTM Tracking Fields -->
                <input type="hidden" name="utm_source" value="">
                <input type="hidden" name="utm_medium" value="">
                <input type="hidden" name="utm_campaign" value="">
                <input type="hidden" name="utm_term" value="">
                <input type="hidden" name="utm_content" value="">
                <input type="hidden" name="gclid" value="">
                <input type="hidden" name="gbraid" value="">
                <input type="hidden" name="gad_source" value="">

                <div><input type="text" name="name" placeholder="Your Name" required
                        class="w-full border-b border-gray-300 py-3"></div>
                <div><input type="tel" name="phone" id="mobileModal" placeholder="Mobile Number (+91)"
                        pattern="[0-9]{10}" required class="w-full border-b border-gray-300 py-3" maxlength="10"></div>
                <div><input type="email" name="email" placeholder="Email Address" required
                        class="w-full border-b border-gray-300 py-3"></div>
                <div class="flex items-start space-x-2"><input type="checkbox" id="consentModal" name="consent" required
                        class="mt-1"><label for="consentModal" class="text-sm text-gray-600">I agree to Terms of Service
                        & Privacy Policy</label></div>
                <button type="submit"
                    class="w-full bg-theme-green text-white py-4 mt-4 font-bold uppercase tracking-widest">Submit
                    Enquiry</button>
            </form>
        </div>
    </div>

    <script>
    (function(){
      const leadModal = document.getElementById('leadModal');
      const closeBtn = document.getElementById('closeLeadModal');
      
      function openLeadModal(source = 'General Enquiry') {
        if (!leadModal) return;
        
        // Update cta_source in the modal form
        const ctaInput = leadModal.querySelector('input[name="cta_source"]');
        if (ctaInput) {
            ctaInput.value = source;
        }

        leadModal.classList.remove('hidden');
        leadModal.classList.add('flex');
        const firstInput = leadModal.querySelector('input[name="name"], input[name="phone"], input[name="email"]');
        if (firstInput) firstInput.focus();
      }

      function closeLeadModal() {
        if (!leadModal) return;
        leadModal.classList.remove('flex');
        leadModal.classList.add('hidden');
      }

      // Updated openButtons listener to use data-cta attribute if present
      document.body.addEventListener('click', function(e) {
        const target = e.target.closest('[onclick^="openLeadModal"]');
        if (target && !target.getAttribute('onclick').includes("'")) {
             // If it's a generic call from HTML but we want to intercept
        }
      });

      if (closeBtn) closeBtn.addEventListener('click', closeLeadModal);
      if (leadModal) {
        leadModal.addEventListener('click', function(e){ if (e.target === leadModal) closeLeadModal(); });
      }
      document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeLeadModal(); });

      window.openLeadModal = openLeadModal;
      window.closeLeadModal = closeLeadModal;
    })();
    </script>

