              <aside class="media-gallery-grid three">
                
                <figure class="gallery-item exterior load-gallery"> <img class="img-responsive" src="https://static.squareyards.com/resources/images/mumbai/project-image/veena-celestia-project-apartment-interiors1-6186-opt-06d392f9-9eae-4e8e-b0bc-b354e9f45ae0.jpg?aio=w-192;h-168;crop;" width="170" height="139" loading="lazy" decoding="async" alt="Veena Celestia Apartment Interiors"> </figure>
                
                
