@keyframes siteLoader {
    100% {
        transform: translateY(-100vh);
    }
}
#SITE_CONTAINER #main_MF#main_MF .css-editing-scope .wixui-loader-overlay{
    margin-top: 0vh; /* bring loader into viewport */
    animation: siteLoader 1s forwards cubic-bezier(0.950, 0.050, 0.795, 0.035); /* animation properties of loader leaving viewport */
    animation-delay: 4s; /* time until the animation of the loader leaving viewport starts */
}</style>



