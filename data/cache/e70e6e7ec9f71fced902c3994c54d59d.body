ze":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"Cancel"}]},"accessibility":{"label":"Cancel"},"trackingParams":"CMwCEPBbIhMIuI_9hffelgMVqQaDAx0zXiTP"}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0,"trackingParams":"CL8CEM2rARgBIhMIuI_9hffelgMVqQaDAx0zXiTP"}},"showMoreText":{"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"trackingParams":"CL8CEM2rARgBIhMIuI_9hffelgMVqQaDAx0zXiTP","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CL8CEM2rARgBIhMIuI_9hffelgMVqQaDAx0zXiTPygEEaFyElA==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CL8CEM2rARgBIhMIuI_9hffelgMVqQaDAx0zXiTPygEEaFyElA==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CL8CEM2rARgBIhMIuI_9hffelgMVqQaDAx0zXiTPygEEaFyElA==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CL8CEM2rARgBIhMIuI_9hffelgMVqQaDAx0zXiTPygEEaFyElA==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"Touring Veena Developers' new launch in Kandivali West — 2BHK homes near WEH \u0026 Metro! 🏡🚇 Honest review covering layouts, finishes, pricing \u0026 connectivity. Watch before you invest in 2026. \n\nDownload E-Brochure \u0026 PriceSheet : https://housiey.co/45yoF6d\n\nProject Timeline - \n00:00 Intro\n01:05 Project Overview\n01:14 Location\n01:34 Amenities\n02:22 Carpet Area\n02:30 Booking Process \n\nFor more Project details like - \n✅Pros \u0026 Cons\n✅Unboxing / Sample Flat Videos\n✅3D Viewing\n✅Payment Schedule etc…\n\nVisit Project Housiey Page - https://housiey.com/projects/veena-bl...\n\nVeena Kandivali West Project overview -\nProject will be constructed on 1 acres of land parcel consisting of 1 tower with Ground+ 38 Storey residential floors having luxury 2 bhk  of residential apartments\n\nVeena Developers Kandivali Location-\nProject is located of Mathuradas Road Kandivali West, Mumbai\nDahanukarwadi  metro - 3 mins \nWestern Express Highway - 4.2 km \nKandivali railway station-  5 mins \n\nVeena Kandivali New Launch Amenities-  \nProject has basic 20 +amenities\nKids Play Area\nGym\nBanquet hall \nJogging track \n\nVeena Developers Kandivali West Carpet Area\nProject has 2bhk  premium Residencies with - \ncarpet area of\n2bhk 552-768 SQFT\n\nVeena Kandivali Booking Process -\nProject booking window is open, Client can come \u0026 visit the site, Our sales team will\n1) Explain the complete project details\n2) Will share the pricing \u0026 payment schemes\n3) Will show the actual location of project\n\u0026 then if the client likes the project, they can book by a EOI amount.\nEOI 2bhk 2 lakhs\n\nSo everyone, this was the Teaser of Veena Developers newly launch Project located in Kandivali West, Mumbai\n\nFor more details, like pricing, brochures, plans or want to do site visit, you can click on the link mentioned in the description, Our NRI clients from US, UK, UAE, Europe can also click on the same link\nAt last to watch more such new launch teaser, Subscribe to our channel Housiey\n\n💬 𝗙𝗼𝗹𝗹𝗼𝘄 \u0026 𝗖𝗵𝗮𝘁 𝘄𝗶𝘁𝗵 𝘂𝘀:\n Instagram ➜    / https://www.instagram.com/housiey/?ig...\nFacebook ➜    /   / housiey  \nLinkedIn ➜    /   / housiey  \nYoutube ➜ /   / @housiey  \n\nMusic by: DayFox Club - https://dayfox.club/\n.\n.\n#veenadevelopers #kandivaliwest #kandivali #weh #metroconnectivity #2bhkmumbai #newlaunch #mumbairealestate #realestatereview2026 #mumbaiproperty","commandRuns":[{"startIndex":227,"length":26,"onTap":{"innertubeCommand":{"clickTrackingParams":"CL8CEM2rARgBIhMIuI_9hffelgMVqQaDAx0zXiTPSNbps-mC7tiEqgHKAQRoXISU","commandMetadata":{"webCommandMetadata":{"url":"https