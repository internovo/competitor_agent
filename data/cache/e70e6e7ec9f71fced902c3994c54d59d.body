Index":2228,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2229,"length":4,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2233,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2234,"length":18,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2252,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2253,"length":11,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2264,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2265,"length":10,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2275,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2276,"length":17,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2293,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2294,"length":21,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2315,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2316,"length":15,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293981695,"raisedBackground":4293981695,"additiveBackground":558200009,"textPrimary":4278851894,"textSecondary":4282010734,"invertedBackground":4279845519,"overlayBackground":3423213878},"darkThemeColorPalette":{"baseBackground":4278323996,"raisedBackground":4278851894,"additiveBackground":725972169,"textPrimary":4292930042,"textSecondary":4289510877,"invertedBackground":4286357987,"overlayBackground":3423213878},"colorSampledDescriptionBodyText":{"content":"Touring Veena Developers' new launch in Kandivali West — 2BHK homes near WEH \u0026 Metro! 🏡🚇 Honest review covering layouts, finishes, pricing \u0026 connectivity. Watch before you invest in 2026. \n\nDownload E-Brochure \u0026 PriceSheet : https://housiey.co/45yoF6d\n\nProject Timeline - \n00:00 Intro\n01:05 Project Overview\n01:14 Location\n01:34 Amenities\n02:22 Carpet Area\n02:30 Booking Process \n\nFor more Project details like - \n✅Pros \u0026 Cons\n✅Unboxing / Sample Flat Videos\n✅3D Viewing\n✅Payment Schedule etc…\n\nVisit Project Housiey Page - https://housiey.com/projects/veena-bl...\n\nVeena Kandivali West Project overview -\nProject will be constructed on 1 acres of land parcel consisting of 1 tower with Ground+ 38 Storey residential floors having luxury 2 bhk  of residential apartments\n\nVeena Developers Kandivali Location-\nProject is located of Mathuradas Road Kandivali West, Mumbai\nDahanukarwadi  metro - 3 mins \nWestern Express Highway - 4.2 km \nKandivali railway station-  5 mins \n\nVeena Kandivali New Launch Amenities-  \nProject has basic 20 +amenities\nKids Play Area\nGym\nBanquet hall \nJogging track \n\nVeena Developers Kandivali West Carpet Area\nProject has 2bhk  premium Residencies with - \ncarpet area of\n2bhk 552-768 SQFT\n\nVeena Kandivali Booking Process -\nProject booking window is open, Client can come \u0026 visit the site, Our sales team will\n1) Explain the complete project details\n2) Will share the pricing \u0026 payment schemes\n3) Will show the actual location of project\n\u0026 then if the client likes the project, they can book by a EOI amount.\nEOI 2bhk 2 lakhs\n\nSo everyone, this was the Teaser of Veena Developers newly launch Project located in Kandivali West, Mumbai\n\nFor more details, like pricing, brochures, plans or want to do site visit, you can click on the link mentioned in the description, Our NRI clients from US, UK, UAE, Europe can also click on the same link\nAt last to watch more such new launch teaser, Subscribe to our channel Housiey\n\n💬 𝗙𝗼𝗹𝗹𝗼𝘄 \u0026 𝗖𝗵𝗮𝘁 𝘄𝗶𝘁𝗵 𝘂𝘀:\n Instagram ➜    / https://www.instagram.com/housiey/?ig...\nFacebook ➜    /   / housiey  \nLinkedIn ➜    /   / housiey  \nYoutube ➜ /   / @housiey  \n\nMusic by: DayFox Club - https://dayfox.club/\n.\n.\n#veenadevelopers #kandivaliwest #kandivali #weh #metroconnectivity #2bhkmumbai #newlaunch #mumbairealestate #realestatereview2026 #mumbaiproperty","commandRuns":[{"startIndex":227,"length":26,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBsQ040EGAciEwi4j_2F996WAxWpBoMDHTNeJM9I1umz6YLu2ISqAcoBBGhchJQ=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUXY5SDhoVnFzRk9RbDFvQ2EwOXJKMnxBTl9pYzRjaWlvMTVkU2t5V1ZXTUluaFNjckt5aTdQVUpZNl9NdTBxRXFoSEtyTGdadFEzd28xa2xOT0xRUnhsLWdYQ05SVi1aSS1JV2lZZHBDam5SWVZPWThyRFYydnpnTUNB\u0026q=https%3A%2F%2Fhousiey.co%2F45yoF6d\u0026v=qgljcC0s9NY","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUXY5SDhoVnFzRk9RbDFvQ2EwOXJKMnxBTl9pYzRjaWlvMTVkU2t5V1ZXTUluaFNjckt5aTdQVUpZNl9NdTBxRXFoSEtyTGdadFEzd28xa2xOT0xRUnhsLWdYQ05SVi1aSS1JV2lZZHBDam5SWVZPWThyRFYydnpnTUNB\u0026q=https%3A%2F%2Fhousiey.co%2F45yoF6d\u0026v=qgljcC0s9NY","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":275,"length":5,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBsQ040EGAciEwi4j_2F996WAxWpBoMDHTNeJM_KAQRoXISU","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=qgljcC0s9NY","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"qgljcC0s9NY","continuePlayback":true,"startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr1---sn-ca51xoxu-5hql.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026olis=1\u0026ofpcc=1\u0026msp=1\u0026odepv=1\u0026id=aa0963702d2cf4d6\u0026ip=103.54.188.234\u0026initcwndbps=154