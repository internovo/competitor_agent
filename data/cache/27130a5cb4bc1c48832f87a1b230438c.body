/* Contact Form 7 ke auto <p> aur <br> ko reset karein */
.wpcf7 form.wpcf7-form p {
    margin: 0 !important;
    padding: 0 !important;
    display: contents; /* Yeh <p> tag ki physical layout wrapping khatam kar dega */
}

.wpcf7 form.wpcf7-form br {
    display: none !important; /* Button ke andar wale <br> tags remove karne ke liye */
}

/* Main Form Row Container */
.form-row {
    display: flex;
    align-items: center;
    max-width: 520px;
    width: 100%;
    background: #ffffff;
    padding: 6px;
    border-radius: 50px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
    font-family: 'Outfit', sans-serif;
}

/* Input Group Wrapper */
.form-row .form-group {
    flex: 1;
    margin: 0;
    padding: 0;
    display: flex;
}

/* Email Input Field */
.form-row .form-control {
    width: 100%;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 12px 20px;
    font-size: 15px;
    font-family: 'Outfit', sans-serif;
    color: #333333;
    background: transparent;
    border-radius: 50px;
    box-sizing: border-box;
    height: 48px;
}

.form-row .form-control::placeholder {
    color: #9ca3af;
    font-size: 14px;
}

/* Submit Button Wrapper */
.form-row .form-button {
    margin: 0;
    padding: 0;
}

/* Submit Button */
.form-row .btn-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #F05A28;
    color: #ffffff;
    font-family: 'Outfit', sans-serif;
    font-size: 15px;
    font-weight: 500;
    border: none;
    border-radius: 50px;
    padding: 0 24px;
    height: 48px;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
    white-space: nowrap;
    line-height: normal;
}

/* Button Hover */
.form-row .btn-submit:hover {
    background: #d84819;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(240, 90, 40, 0.3);
}

/* Button Icon */
.form-row .btn-submit .icon {
    width: 16px;
    height: 16px;
    display: inline-block;
    filter: brightness(0) invert(1);
    transition: transform 0.3s ease;
    margin: 0;
}

.form-row .btn-submit:hover .icon {
    transform: translateX(3px);
}

/* Mobile Responsive */
@media (max-width: 576px) {
    .form-row {
        flex-direction: column;
        background: transparent;
        border: none;
        box-shadow: none;
        padding: 0;
        gap: 10px;
    }

    .form-row .form-group,
    .form-row .form-button,
    .form-row .btn-submit {
        width: 100%;
    }

    .form-row .form-control {
        background: #ffffff;
        border: 1px solid #e5e7eb !important;
        text-align: center;
    }
}/* End custom CSS */</style>		<div data-elementor-type="wp-post" data-elementor-id="45" class="elementor elementor-45">
