				<div class="elementor-element elementor-element-d89433a elementor-widget__width-initial elementor-invisible elementor-widget elementor-widget-html" data-id="d89433a" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeInRight&quot;}" data-widget_type="html.default">
					<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Team Card</title>
  <!-- FONT AWESOME LINK -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .team-container {
      display: flex;
      justify-content: center;
      gap: 20px;
      background-color: #ffeae6;
      padding: 0px 0px;
      flex-wrap: wrap;
    }

    .team-card {
      width: 100%;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
      position: relative;
      background-color: #fff;
    }

    .team-card img {
      width: 100%;
      height: 500px;
      object-fit: cover;
      object-position: top center;
      display: block;
    }

    .team-info {
      position: absolute;
      bottom: 0;
      width: 100%;
      background: rgba(0, 0, 0, 0.8);
      color: white;
      padding: 15px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-radius: 0 0 20px 20px;
    }

    .team-info .text {
      line-height: 1.2;
    }

    .team-info .text h3 {
      margin: 0;
      font-size: 16px;
      font-weight: 600;
    }

    .team-info .text p {
      margin: 2px 0 0;
      font-size: 14px;
      font-weight: 400;
    }

    .call-icon {
      background-color: #f97316;
      color: white;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 16px;
    }

    /* MOBILE RESPONSIVE */
    @media screen and (max-width: 768px) {
      .team-card {
        width: 100%;
      }
    }
  </style>
</head>
<body>

  <div class="team-container">
    <div class="team-card">
      <img decoding="async" src="https://sutlejdevelopments.com/wp-content/uploads/2025/09/WhatsApp-Image-2025-08-29-at-23.05.37_8dd4324e.jpg" alt="CEO Image">
      <div class="team-info">
        <div class="text">
          <h3>Mian Khurram Jehangir Wattoo</h3>
          <p>Chief Executive Officer (CEO)</p>
        </div>
        <div class="call-icon">
          <i class="fas fa-phone"></i>
        </div>
      </div>
    </div>
  </div>

</body>
</html>
