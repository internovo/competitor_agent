				<div class="elementor-element elementor-element-0fc723f elementor-widget elementor-widget-html" data-id="0fc723f" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
					<script>
    jQuery(document).ready(function($) {
    const tabsContainer = $('.e-n-tabs-content');
    const tabContents = $('.e-n-tabs-content > div[role="tabpanel"]');
    const tabButtons = $('.e-n-tab-title');
    let currentIndex = 0;
    let autoplayInterval;

    // Set up tabs container for sliding
    tabsContainer.css({
        'display': 'flex',
        'flex-wrap': 'nowrap',
        'overflow-x': 'hidden',
        'position': 'relative',
        'width': '100%',
        'scroll-behavior': 'smooth'
    });

    // Ensure all tab contents are visible and properly sized
    tabContents.each(function(index) {
        $(this).css({
            'flex': '0 0 100%',
            'width': '100%',
            'display': index === 0 ? 'flex' : 'none', // Only first tab visible initially
            'transition': 'transform 0.5s ease'
        });
    });

    // Create navigation buttons
    const prevButton = $('<button>←</button>').css({
        'position': 'absolute',
        'bottom': '20px',
        'left': '20px',
        'z-index': '10',
        'padding': '10px 20px',
        'background': 'rgba(0, 0, 0, 0.5)',
        'color': 'white',
        'border': 'none',
        'border-radius': '5px',
        'cursor': 'pointer'
    });

    const nextButton = $('<button>→</button>').css({
        'position': 'absolute',
        'bottom': '20px',
        'right': '20px',
        'z-index': '10',
        'padding': '10px 20px',
        'background': 'rgba(0, 0, 0, 0.5)',
        'color': 'white',
        'border': 'none',
        'border-radius': '5px',
        'cursor': 'pointer'
    });

    // Append buttons to the tabs container
    tabsContainer.append(prevButton, nextButton);

    // Function to update tab visibility and button states
    function updateTabs(index) {
        // Update visibility for all tab contents
        tabContents.each(function(i) {
            $(this).css({
                'display': i === index ? 'flex' : 'none',
                'transform': 'translateX(0)' // Reset transform to avoid offset issues
            });
            $(this).toggleClass('e-active', i === index);
        });

        // Update active tab button
        tabButtons.each(function(i) {
            $(this).attr('aria-selected', i === index ? 'true' : 'false');
            $(this).attr('tabindex', i === index ? '0' : '-1');
            const span = $(this).find('.e-n-tab-title-text span');
            if (span.length) {
                span.css('background-color', i === index ? 'orange' : 'black');
            }
        });

        // Update button states
        prevButton.prop('disabled', index === 0);
        nextButton.prop('disabled', index === tabContents.length - 1);

        currentIndex = index;
    }

    // Navigation button event listeners
    prevButton.on('click', function() {
        if (currentIndex > 0) {
            updateTabs(currentIndex - 1);
            // resetAutoplay();
        }
    });

    nextButton.on('click', function() {
        if (currentIndex < tabContents.length - 1) {
            updateTabs(currentIndex + 1);
            // resetAutoplay();
        }
    });

    // Tab button click handlers
    tabButtons.each(function(index) {
        $(this).on('click', function() {
            updateTabs(index);
            // resetAutoplay();
        });
    });

    // Autoplay functionality
    function startAutoplay() {
        autoplayInterval = setInterval(function() {
            if (currentIndex < tabContents.length - 1) {
                updateTabs(currentIndex + 1);
            } else {
                updateTabs(0); // Loop back to the first tab
            }
        }, 5000);
    }

    function resetAutoplay() {
        clearInterval(autoplayInterval);
        // startAutoplay();
    }

    // Initialize
    updateTabs(0);
    // startAutoplay();

    // Pause autoplay on hover
    tabsContainer.on('mouseenter', function() {
        clearInterval(autoplayInterval);
    }).on('mouseleave', function() {
        // startAutoplay();
    });
});
</script>				</div>
				</div>
