            <script>
                (function () {
                    function initMobTimeline() {
                        const stickWrapper = document.querySelector('.stickWrapper');
                        const progressBar = document.querySelector('.custom-progressMob');
                        const progressTrack = document.querySelector('.custom-progressBarMob');
                        const dots = [...document.querySelectorAll('.custom-dotMob')];
                        const dotContentTexts = [...document.querySelectorAll('.dotContentTextMob')];

                        if (!stickWrapper || !progressBar || !progressTrack || !dots.length) return;

                        // The first .stickDivi is the heading/arrow block — the four that
                        // follow are the panels the four dots correspond to.
                        const panels = [...stickWrapper.querySelectorAll('.stickDivi')]
                            .filter(p => !p.classList.contains('arrowDiv'));
                        if (!panels.length) return;

                        progressBar.style.width = '0%';

                        // Measured fresh on every update: the section is display:none on
                        // desktop and its images settle after load, so anything cached at
                        // DOMContentLoaded is either zero or stale.
                        function measure() {
                            const total = stickWrapper.scrollWidth - stickWrapper.clientWidth;
                            if (total <= 0) return null;                      // hidden / not laid out yet

                            const wrapLeft = stickWrapper.getBoundingClientRect().left;
                            const trackWidth = progressTrack.clientWidth;
                            if (!trackWidth) return null;

                            return {
                                total,
                                // scrollLeft at which each panel reaches the left edge
                                starts: panels.map(p =>
                                    Math.min(total, Math.max(0,
                                        p.getBoundingClientRect().left - wrapLeft + stickWrapper.scrollLeft))),
                                // where each dot actually sits on the track, as a %
                                dotPercents: dots.map(d =>
                                    ((d.offsetLeft + d.offsetWidth / 2) / trackWidth) * 100)
                            };
                        }

                        function updateProgressBar() {
                            const m = measure();
                            if (!m) return;

                            const scrollLeft = stickWrapper.scrollLeft;

                            // Active panel = the last one whose start has been reached by
                            // the middle of the viewport.
                            const probe = scrollLeft + stickWrapper.clientWidth / 2;
                            let idx = 0;
                            for (let i = 0; i < m.starts.length; i++) {
                                if (probe >= m.starts[i]) idx = i;
                            }
                            idx = Math.min(idx, dots.length - 1);

                            // Interpolate between this dot and the next so the bar lands
                            // exactly on each dot instead of drifting past it.
                            const from = m.starts[idx];
                            const to = idx + 1 < m.starts.length ? m.starts[idx + 1] : m.total;
                            const span = to - from;
                            const f = span > 0 ? Math.min(1, Math.max(0, (scrollLeft - from) / span)) : 0;

                            const pFrom = m.dotPercents[idx];
                            const pTo = idx + 1 < m.dotPercents.length ? m.dotPercents[idx + 1] : 100;
                            let pos = pFrom + f * (pTo - pFrom);

                            // Before the first panel, ramp up from 0 to the first dot.
                            if (scrollLeft < m.starts[0] && m.starts[0] > 0) {
                                pos = (scrollLeft / m.starts[0]) * m.dotPercents[0];
                            }
                            if (scrollLeft >= m.total - 1) pos = 100;

                            progressBar.style.width = Math.min(100, Math.max(0, pos)) + '%';

                            // Exactly one active, everything before it passed.
                            dots.forEach((dot, i) => {
                                dot.classList.toggle('active', i === idx);
                                dot.classList.toggle('passed', i < idx);
                            });
                            dotContentTexts.forEach((text, i) => {
                                text.classList.toggle('active', i === idx);
                            });
                        }

                        let ticking = false;
                        function onScroll() {
                            if (ticking) return;
                            ticking = true;
                            requestAnimationFrame(() => { ticking = false; updateProgressBar(); });
                        }

                        stickWrapper.addEventListener('scroll', onScroll, { passive: true });
                        window.addEventListener('resize', onScroll);
                        window.addEventListener('orientationchange', onScroll);
                        window.addEventListener('load', onScroll);
                        window.addEventListener('focus', onScroll);
                        document.addEventListener('visibilitychange', () => {
                            if (!document.hidden) onScroll();
                        });

                        // Late-loading images change scrollWidth, so re-measure as they land.
                        stickWrapper.querySelectorAll('img').forEach(img => {
                            if (!img.complete) img.addEventListener('load', onScroll, { once: true });
                        });

                        // Jump to the matching panel on dot click.
                        dots.forEach((dot, index) => {
                            dot.addEventListener('click', () => {
                                const m = measure();
                                if (!m || typeof m.starts[index] !== 'number') return;
                                stickWrapper.scrollTo({ left: m.starts[index], behavior: 'smooth' });
                            });
                        });

                        updateProgressBar();
                    }

                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', initMobTimeline);
                    } else {
                        initMobTimeline();
                    }
                })();
            </script>

