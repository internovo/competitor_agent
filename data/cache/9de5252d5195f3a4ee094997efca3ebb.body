                                    <script>
                                        (function () {
                                            var outClassSwiper = null;

                                            var outClassSwiperConfig = {
                                                spaceBetween: 15,
                                                observer: true,
                                                observeParents: true,
                                                watchOverflow: true,
                                                navigation: {
                                                    nextEl: ".pgpIndiaSwiper-Next",
                                                    prevEl: ".pgpIndiaSwiper-Prev",
                                                },
                                                breakpoints: {
                                                    0: {
                                                        slidesPerView: 1.1,
                                                        freeMode: true,
                                                        autoplay: false,
                                                        speed: 400,
                                                    },
                                                    768: {
                                                        slidesPerView: 1,
                                                        freeMode: true,
                                                        autoplay: false,
                                                        speed: 400,
                                                    },
                                                },
                                            };

                                            function isVisible(el) {
                                                return !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);
                                            }

                                            // This slider only exists on mobile (`.outClassMobile` is
                                            // display:none above 767px). Building Swiper while the container is
                                            // hidden sizes every slide to 0px, so only init it once it is on
                                            // screen and tear it down again when we cross back to desktop.
                                            function syncOutClassSwiper() {
                                                var el = document.querySelector(".pgpIndiaSwiper");
                                                if (!el || typeof Swiper === "undefined") return;

                                                if (isVisible(el)) {
                                                    if (!outClassSwiper) {
                                                        outClassSwiper = new Swiper(el, outClassSwiperConfig);
                                                    } else {
                                                        outClassSwiper.update();
                                                    }
                                                } else if (outClassSwiper) {
                                                    outClassSwiper.destroy(true, true);
                                                    outClassSwiper = null;
                                                }
                                            }

                                            var outClassSwiperTimer;
                                            window.addEventListener("resize", function () {
                                                clearTimeout(outClassSwiperTimer);
                                                outClassSwiperTimer = setTimeout(syncOutClassSwiper, 150);
                                            });

                                            if (document.readyState === "loading") {
                                                document.addEventListener("DOMContentLoaded", syncOutClassSwiper);
                                            } else {
                                                syncOutClassSwiper();
                                            }
                                            window.addEventListener("load", syncOutClassSwiper);
                                        })();
                                    </script>
                                </div>
