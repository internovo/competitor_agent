                        <script>
                            document.addEventListener("DOMContentLoaded", function () {
                                const wrapper = document.getElementById("inclassAccordion");
                                if (!wrapper) return;

                                const boxes = wrapper.querySelectorAll(".inclassAccBoxi");

                                function syncBody(box) {
                                    const body = box.querySelector(".inclassAccBody");
                                    if (!body) return;
                                    body.style.maxHeight = box.classList.contains("active")
                                        ? body.scrollHeight + "px"
                                        : "0px";
                                }

                                boxes.forEach(box => {
                                    const head = box.querySelector(".inclassAccHead");
                                    if (!head) return;

                                    syncBody(box);

                                    head.addEventListener("click", function () {
                                        const willOpen = !box.classList.contains("active");

                                        // single-open accordion, matching the design's default state
                                        boxes.forEach(other => {
                                            other.classList.remove("active");
                                            const otherHead = other.querySelector(".inclassAccHead");
                                            if (otherHead) otherHead.setAttribute("aria-expanded", "false");
                                            syncBody(other);
                                        });

                                        if (willOpen) {
                                            box.classList.add("active");
                                            head.setAttribute("aria-expanded", "true");
                                            syncBody(box);
                                        }
                                    });
                                });

                                let resizeTimer;
                                window.addEventListener("resize", function () {
                                    clearTimeout(resizeTimer);
                                    resizeTimer = setTimeout(() => boxes.forEach(syncBody), 150);
                                });
                            });
                        </script>

                        <div class="cautionWrapper hide">
