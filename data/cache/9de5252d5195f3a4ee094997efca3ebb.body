                                                                        ${student?.email ? `<a href="https://mail.google.com/mail/?view=cm&fs=1&to=${student.email}" target="_blank"> <img  src="https://images.mastersunion.link/uploads/19052025/v1/gmail.svg" alt="email_icon" /></a>` : ''}
