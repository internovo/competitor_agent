<style>
    .indiaMaskOverlay {
        position: fixed;

        inset: 0;
        z-index: 99999;
        pointer-events: none;
        overflow: hidden;
    }


    .indiaMaskOverlay__backdrop {
        position: absolute;
        inset: 0;
        background: #000;
        opacity: 1;
        transition: opacity 0.55s ease 0.1s;
    }

    .indiaMaskOverlay.is-open .indiaMaskOverlay__backdrop {
        opacity: 0;
    }


    .heroSection,
    .heroSection .video-container,
    .heroSection .mobvideoHeight {
        background-color: #000;
    }


    .indiaMaskOverlay__cover {
        position: absolute;
        inset: -20%;
        transform: scale(0.75);
        transform-origin: 50% 50%;
        backface-visibility: hidden;
        will-change: transform, opacity;
        /* slot 1 — 0-800ms */
        transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.05s,
            opacity 0.4s ease;
    }

    /* Entrance — the cut-out grows to full size as the backdrop fades off */
    .indiaMaskOverlay.is-open .indiaMaskOverlay__cover {
        transform: scale(1);
    }


    .indiaMaskOverlay.is-expanded .indiaMaskOverlay__cover {
        opacity: 0;
        transform: scale(10);
        /* slot 3 — 1800-3050ms */
        transition: transform 1.15s cubic-bezier(0.65, 0, 0.35, 1),
            opacity 0.4s ease 0.8s;
    }

    .indiaMaskOverlay__sheet {
        display: block;
        width: 100%;
        height: 100%;
    }

    .indiaMaskOverlay__map--sm {
        display: none;
    }

    /* Copy that rises into the map cut-out */
    .indiaMaskOverlay__text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-70%, -60%) scale(0.9);
        width: min(32vh, 84vw);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        color: #fff;
        text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);

        visibility: hidden;
        transition: opacity 0.5s ease, transform 0.9s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .indiaMaskOverlay.is-open .indiaMaskOverlay__text {
        visibility: visible;
    }

    .indiaMaskOverlay__line {
        display: block;
        padding: 0 0.06em;
        white-space: nowrap;
    }

    .indiaMaskOverlay__word {
        display: block;
        white-space: nowrap;
        font-size: clamp(60px, 6.6vh, 74px);
        line-height: 120%;
        font-weight: 400;
        letter-spacing: -3.3px;
        opacity: 0;
        /* starts "far away" — small and soft — and comes forward to the
           viewer instead of sliding in from the side */
        transform: scale(0.55);
        filter: blur(8px);
        will-change: transform, opacity, filter;
        /* slot 2 — 800-1770ms */
        transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
            opacity 0.5s ease,
            filter 0.55s ease;
        font-family: "Instrument Serif";
    }


    @media (min-width: 1024px) and (max-width: 1280px) {
        .indiaMaskOverlay__word {
            position: relative;
            left: 14px;
        }
    }

    .indiaMaskOverlay__word--sm {
        font-size: clamp(18px, 3.9vh, 40px);
        color: var(--white);
        font-family: var(--go-regular);
        text-transform: uppercase;
        line-height: 120%;
        letter-spacing: 0.5px;
    }

    /* Step 1 — words stagger up, one line after another */
    .indiaMaskOverlay.is-text-in .indiaMaskOverlay__word {
        opacity: 1;
        transform: scale(1);
        filter: blur(0);
    }

    .indiaMaskOverlay.is-text-in .indiaMaskOverlay__word--sm {
        opacity: 0.85;
    }

    .indiaMaskOverlay.is-text-in .indiaMaskOverlay__line:nth-child(1) .indiaMaskOverlay__word {
        transition-delay: 0s;
    }

    .indiaMaskOverlay.is-text-in .indiaMaskOverlay__line:nth-child(2) .indiaMaskOverlay__word {
        transition-delay: 0.09s;
    }

    .indiaMaskOverlay.is-text-in .indiaMaskOverlay__line:nth-child(3) .indiaMaskOverlay__word {
        transition-delay: 0.18s;
    }

    .indiaMaskOverlay.is-text-in .indiaMaskOverlay__line:nth-child(4) .indiaMaskOverlay__word {
        transition-delay: 0.27s;
    }

    .indiaMaskOverlay.is-expanded .indiaMaskOverlay__text {
        opacity: 0;
        transform: translate(-70%, -60%) scale(1.35);
    }

    /* Page is frozen for the duration of the intro. `overflow: hidden` on both
       elements is the whole lock — no `touch-action: none`, which makes the
       compositor swallow the gesture before the page ever sees it (no
       movement, no rubber-band, nothing), so a loader still waiting on the CDN
       reads as a hung page rather than a busy one. Letting the drag reach JS
       is what makes the skip below possible. */
    html.indiaIntroLock,
    html.indiaIntroLock body {
        overflow: hidden !important;
        height: 100%;
        overscroll-behavior: none;
    }


    html.indiaIntroLock:not(.indiaIntroReveal) .heroSectionContent {
        opacity: 0 !important;
        visibility: hidden !important;
        translate: 0 40px !important;
        transition: none !important;
    }

    .heroSectionContent {
        /* slot 3 — rises alongside the map scale-out */
        transition: opacity 0.7s ease 0.1s,
            translate 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
    }


    html.indiaIntroLock:not(.indiaIntroReveal) header.topHeader,
    html.indiaIntroLock:not(.indiaIntroReveal) .mobileMenu .mobileHeader {
        opacity: 0 !important;
        visibility: hidden !important;
        translate: 0 -14px !important;
        pointer-events: none !important;
        transition: none !important;
    }


    html.indiaIntroReveal header.topHeader,
    html.indiaIntroReveal .mobileMenu .mobileHeader {
        will-change: opacity, translate;
        transition: opacity 0.7s ease 0.1s,
            translate 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
    }

    @media (max-width: 768px) {

        /* 130% instead of 140% (and 0.82 entrance, so it still covers at its
           smallest): 140% of a tall handset at DPR 3-4 is past the texture
           size some phone GPUs will rasterise in one piece. */
        .indiaMaskOverlay__cover {
            inset: -15%;
            transform: scale(0.82);
        }

        .indiaMaskOverlay__map--lg {
            display: none;
        }

        .indiaMaskOverlay__map--sm {
            display: block;
        }

        .indiaMaskOverlay__text {
            width: 54vw;
        }

        .indiaMaskOverlay__word {
            font-size: clamp(24px, 6.6vw, 44px);
            letter-spacing: 1px;
        }

        .indiaMaskOverlay__word--sm {
            font-size: clamp(15px, 4vw, 28px);
        }
    }

    /* Nothing to animate for someone who has asked for stillness — the script
       hands the page straight back, and this keeps the black sheet from
       flashing up in the meantime. */
    @media (prefers-reduced-motion: reduce) {
        .indiaMaskOverlay {
            display: none !important;
        }
    }
</style>

<div class="indiaMaskOverlay" id="indiaMaskOverlay" aria-hidden="true">
    <div class="indiaMaskOverlay__backdrop"></div>
    <div class="indiaMaskOverlay__cover">

        <svg class="indiaMaskOverlay__sheet" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink">
            <defs>
                <mask id="indiaMaskHole" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
                    <rect x="0" y="0" width="100%" height="100%" fill="#fff" />
                    <image class="indiaMaskOverlay__map indiaMaskOverlay__map--lg" x="14%" y="16.07%" width="72%"
                        height="67.86%" preserveAspectRatio="xMidYMid meet"
                        href="https://cdn.unionstack.in/uploads/10082026/v1/endia.webp"
                        xlink:href="https://cdn.unionstack.in/uploads/10082026/v1/endia.webp" />
                    <image class="indiaMaskOverlay__map indiaMaskOverlay__map--sm" x="12.31%" y="0" width="75.38%"
                        height="100%" preserveAspectRatio="xMidYMid meet"
                        href="https://cdn.unionstack.in/uploads/10082026/v1/endia.webp"
                        xlink:href="https://cdn.unionstack.in/uploads/10082026/v1/endia.webp" />
                </mask>
            </defs>
            <rect x="0" y="0" width="100%" height="100%" fill="#000" mask="url(#indiaMaskHole)" />
        </svg>
    </div>

    <div class="indiaMaskOverlay__text">
        <span class="indiaMaskOverlay__line"><span class="indiaMaskOverlay__word indiaMaskOverlay__word--sm">THIS IS
                <br></span></span>
        <span class="indiaMaskOverlay__line"><span
                class="indiaMaskOverlay__word indiaMaskOverlay__word--sm"></span></span>
        <span class="indiaMaskOverlay__line"><span class="indiaMaskOverlay__word">PGP BHARAT</span></span>
    </div>
</div>

<script>
    (function () {
        var overlay = document.getElementById('indiaMaskOverlay');
        if (!overlay) return;

        var root = document.documentElement;
        var MAP_SRC = 'https://cdn.unionstack.in/uploads/10082026/v1/endia.webp';

        function mq(query) {
            return !!(window.matchMedia && window.matchMedia(query).matches);
        }


        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        root.classList.add('indiaIntroLock');
        window.scrollTo(0, 0);

        var SKIP_EVENTS = ['wheel', 'touchmove', 'keydown'];
        var released = false;
        var timers = [];

        function release() {
            if (released) return;
            released = true;

            root.classList.remove('indiaIntroLock');
            root.classList.remove('indiaIntroReveal');
            try {
                for (var i = 0; i < timers.length; i++) clearTimeout(timers[i]);
                for (var j = 0; j < SKIP_EVENTS.length; j++) {
                    window.removeEventListener(SKIP_EVENTS[j], skipIntro);
                }
                overlay.style.display = 'none';
                startHeroVideo();
                if (window.ScrollTrigger) window.ScrollTrigger.refresh();
            } catch (err) { }
        }


        setTimeout(release, 10000);

        function at(ms, fn) { timers.push(setTimeout(fn, ms)); }


        function heroVideo() {
            return mq('(max-width: 768px)')
                ? document.getElementById('safariChromeAutoPlayVideo')
                : document.querySelector('.heroSection .video-container video');
        }

        var videoStarted = false;

        function startHeroVideo() {
            if (videoStarted) return;
            var video = heroVideo();

            if (!video) return;
            videoStarted = true;
            try {
                // muted + playsinline is what makes an un-gestured play() legal
                video.muted = true;
                video.playsInline = true;
                video.currentTime = 0;
                var p = video.play();
                if (p && p.catch) p.catch(function () { });
            } catch (err) { }
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (released || overlay.classList.contains('is-open')) startHeroVideo();
        });


        function skipIntro() {
            release();
        }

        for (var k = 0; k < SKIP_EVENTS.length; k++) {
            window.addEventListener(SKIP_EVENTS[k], skipIntro, { passive: true });
        }


        var IS_PHONE = mq('(max-width: 768px)');

        var T_TEXT = IS_PHONE ? 1050 : 800;    // "PGP BHARAT" staggers up
        var T_SCALE = IS_PHONE ? 2050 : 1800;  // map scales out; hero copy + header come in
        var T_DONE = IS_PHONE ? 3300 : 3050;   // page handed back

        function play() {
            if (released) return;

            startHeroVideo();


            void overlay.offsetWidth;
            overlay.classList.add('is-open');

            at(T_TEXT, function () { overlay.classList.add('is-text-in'); });
            at(T_SCALE, function () {
                overlay.classList.add('is-expanded');
                root.classList.add('indiaIntroReveal');
            });
            at(T_DONE, release);
        }


        var MAP_CEILING = 4000;

        function whenMapReady(cb) {
            var settled = false;
            function finish(ok) {
                if (settled) return;
                settled = true;
                cb(ok);
            }

            var img = new Image();
            img.onload = function () {
                if (img.decode) {
                    // decode() rejects on some browsers for images that will
                    // still paint fine — either way onload said it is here.
                    img.decode().then(function () { finish(true); }, function () { finish(true); });
                } else {
                    finish(true);
                }
            };
            img.onerror = function () { finish(false); };
            img.src = MAP_SRC;
            if (img.complete && img.naturalWidth) finish(true);

            // Dead CDN or a stalled fetch — the visitor must still get through.
            setTimeout(function () { finish(false); }, MAP_CEILING);
        }

        // Wrapped end to end: a throw here used to abort before release()
        // could run, which left the page locked.
        try {
            if (mq('(prefers-reduced-motion: reduce)')) {
                release();
            } else {
                whenMapReady(function (ok) {
                    if (released) return;
                    // No artwork means no hole to reveal through, so there is
                    // no intro to play — hand the page straight back rather
                    // than staging the copy on a solid black screen.
                    if (!ok) {
                        release();
                        return;
                    }
                    play();
                });
            }
        } catch (err) {
            release();
        }
    })();
</script>


