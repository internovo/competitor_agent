    </section>

    <style>
        :root {
            --subnav-ease: cubic-bezier(0.32, 0.72, 0, 1);
            --subnav-dur: 420ms;
        }

        .stickymenu.bharatSubNav {
            background: transparent;
            border-block: 0;
            padding: 12px 0;
        }


        .stickymenu.bharatSubNav {
            transition: transform 0.35s ease, opacity 0.35s ease;
            will-change: transform;
        }

        .stickymenu.bharatSubNav.subNavHidden {
            /* clears its own height plus the sticky top offset, so nothing peeks out */
            transform: translateY(calc(-100% - 3rem));
            opacity: 0;
            pointer-events: none;
        }

        /* the floating pill that holds the tabs + apply button */
        .bharatSubNav .secondnavgroup {
            width: fit-content;
            max-width: 100%;
            margin: 0 auto;
            gap: 8px;
            padding: 8px;
            border: 1px solid #737373;
            border-radius: 174px;
            background: rgba(41, 41, 41, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .bharatSubNav .seondtabs {
            margin: 0;
            padding: 0;
            gap: 8px !important;
            align-items: center;
            justify-content: flex-start;
            overflow: visible;
            text-transform: none;
        }

        .bharatSubNav .seondtabs .list {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 48px;
            padding: 12px 28px;
            border-radius: 109px;
            background: #3b3b3b;
            color: #e5e5e5;
            font-family: var(--go-medium);
            font-size: 16px;
            font-weight: 500;
            line-height: 1.2;
            text-align: center;
            text-transform: none;
            white-space: nowrap;
            transition: background 0.3s ease-in-out, color 0.3s ease-in-out;
            /* undo the gradient-text treatment inherited from mains.css */
            background-clip: border-box;
            -webkit-background-clip: border-box;
            -webkit-text-fill-color: currentColor;
        }

        .bharatSubNav .seondtabs .list:hover {
            background: #4a4a4a;
            color: #ffffff;
        }

        .bharatSubNav .seondtabs .list.active {
            padding: 12px 16px;
            background: #e38330;
            color: #ffffff;
            font-family: var(--go-semibold);
            font-weight: 600;
            background-clip: border-box;
            -webkit-background-clip: border-box;
            -webkit-text-fill-color: #ffffff;
        }

        /* only the selected tab carries its icon — inactive icons leave the flow
       so the pills hug their label the way the design does */
        .bharatSubNav .seondtabs .list img {
            display: none;
        }

        .bharatSubNav .seondtabs .list.active img {
            display: block;
            width: 20px;
            height: 20px;
            max-width: 20px;
            flex-shrink: 0;
            opacity: 1;
            /* the shipped tab icons are gradient-filled; the design wants them white on orange */
            filter: brightness(0) invert(1);
        }

        /* apply button, with the hairline divider that separates it from the tabs */
        .bharatSubNav #secontnavApplyBtn {
            position: relative;
            display: flex;
            align-items: center;
            max-width: 260px;
            margin-left: 8px;
        }

        .bharatSubNav #secontnavApplyBtn::before {
            content: "";
            position: absolute;
            left: -8px;
            top: 50%;
            width: 1px;
            height: 25px;
            transform: translateY(-50%);
            background: #a3a3a3;
        }

        .bharatSubNav #secontnavApplyBtn .button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 48px;
            padding: 12px 28px;
            border: 0;
            border-radius: 107px;
            background: #ffffff;
            color: #090909;
            font-family: var(--go-medium);
            font-size: 16px;
            font-weight: 500;
            line-height: 1.2;
            white-space: nowrap;
            cursor: pointer;
            transition: background 0.3s ease-in-out, color 0.3s ease-in-out;
        }

        .bharatSubNav #secontnavApplyBtn .button svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        .bharatSubNav #secontnavApplyBtn .button svg path {
            fill: #090909;
            transition: fill 0.3s ease-in-out;
        }

        /* Panels crossfade in instead of popping. .pgpcourse toggles display, which
       can't transition at all, so the fade is an animation switchToTab restarts
       on every change. Opacity only - these panels hold position:sticky children
       and a transform (or filter) here would break them while it ran. */
        .pgpcourse.subNavFadeIn {
            animation: subNavFadeIn 320ms var(--subnav-ease) both;
        }

        @keyframes subNavFadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @media (max-width: 1280px) {
            .bharatSubNav .seondtabs .list {
                padding: 12px 8px;
                font-size: 15px;
            }

            .bharatSubNav #secontnavApplyBtn .button {
                padding: 12px 20px;
                font-size: 15px;
            }
        }

        /* tablet + mobile: full-width pill, tabs scroll horizontally with the
       apply button pinned to the right of the track */
        @media (max-width: 1023px) {
            .stickymenu.bharatSubNav {
                padding: 10px 0;
            }

            .bharatSubNav .secondnavgroup {
                width: 100%;
                gap: 0;
                padding: 8px;
                border-radius: 100px;
            }

            .bharatSubNav .seondtabs {
                /* flex-basis 0 + min-width 0 lets the track give up room to the
               button instead of pushing it off the pill */
                flex: 1 1 0;
                min-width: 0;
                width: auto;
                gap: 6px !important;
                overflow-x: auto;
                scrollbar-width: none;
                -ms-overflow-style: none;
                padding: 6px;
            }

            .bharatSubNav #secontnavApplyBtn {
                flex: 0 0 auto;
                max-width: 200px;
            }

            .bharatSubNav #secontnavApplyBtn .button {
                min-height: 40px;
                padding: 10px 18px;
                font-size: 14px;
            }

            .bharatSubNav .seondtabs::-webkit-scrollbar {
                display: none;
            }

            .bharatSubNav .seondtabs .list {
                min-height: 40px;
                min-width: max-content;
                padding: 10px 8px;
                font-size: 14px;
                font-weight: 500;
            }

            .bharatSubNav .seondtabs .list.active {
                padding: 10px 14px;
                font-weight: 600;
            }

            .bharatSubNav .seondtabs .list.active img {
                width: 18px;
                height: 18px;
                max-width: 18px;
            }
        }
    </style>

    <style>
        @media (max-width: 767px) {
            .stickymenu.bharatSubNav {
                padding: 10px 0;
            }

            /* the bar stays put on phones. the scroll handler already skips hiding
           here; this also covers a rotate/resize that lands on mobile while the
           class is still on the element and no scroll follows to clear it. */
            .stickymenu.bharatSubNav.subNavHidden {
                transform: none;
                opacity: 1;
                pointer-events: auto;
            }

            .bharatSubNav .secondnavgroup {
                width: 100%;
                gap: 0;
                padding: 6px;
                border-radius: 174px;
            }

            .bharatSubNav .seondtabs {
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex: 1 1 0;
                min-width: 0;
                width: auto;
                min-height: 48px;
                gap: 6px !important;
                overflow-x: auto;
                overscroll-behavior-x: contain;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: none;
                -ms-overflow-style: none;
                /* the centring pass below writes scrollLeft frame by frame, so the
               track must not smooth-scroll each write on top of that */
                scroll-behavior: auto;
            }

            .bharatSubNav .seondtabs::-webkit-scrollbar {
                display: none;
            }

            .bharatSubNav .seondtabs .list {
                flex: 0 0 auto;
                gap: 0;
                width: auto;
                border-radius: 109px;
                background: transparent;
                color: #ffffff;
                font-family: var(--go-semibold);
                font-size: 14px;
                font-weight: 600;
                line-height: 1.2;
                transition: background-color var(--subnav-dur) var(--subnav-ease),
                    padding var(--subnav-dur) var(--subnav-ease),
                    border-radius var(--subnav-dur) var(--subnav-ease);
                -webkit-tap-highlight-color: transparent;
            }

            /* no hover fill on touch - it would stick to the tab after a tap.
           kept above .active so the orange pill still wins while pressed */
            .bharatSubNav .seondtabs .list:hover {
                background: transparent;
                color: #ffffff;
            }

            .bharatSubNav .seondtabs .list.active {
                padding: 8px 12px;
                border-radius: 79px;
                background: #e38330;
                color: #ffffff;
            }

            /* on mobile every tab shows its icon, white on both states */
            .bharatSubNav .seondtabs .list img,
            .bharatSubNav .seondtabs .list.active img {
                display: block;
                width: 20px;
                height: 20px;
                max-width: 20px;
                flex-shrink: 0;
                opacity: 1;
                filter: brightness(0) invert(1);
            }

            /* the collapsing label. max-width is what animates - the text is nowrap,
           so clipping it to 0 is what tucks the label back behind the icon.
           The outgoing label drops out fast and unelastically, so it has cleared
           before its pill finishes shrinking; the incoming one waits a beat for
           its own pill to open up underneath it. Without that offset the two
           labels are on screen together and the row visibly jostles. */
            .bharatSubNav .seondtabs .list .subNavLabel {
                display: block;
                max-width: 0;
                margin-left: 0;
                opacity: 0;
                overflow: hidden;
                white-space: nowrap;
                transform: translateX(-4px);
                transition: max-width var(--subnav-dur) var(--subnav-ease),
                    margin-left var(--subnav-dur) var(--subnav-ease),
                    transform var(--subnav-dur) var(--subnav-ease),
                    opacity 130ms linear;
            }

            /* --subnav-label-w is measured per tab by the script below. Animating to
           the label's own width rather than a blanket 240px cap keeps the pill
           opening at an even rate right up to its resting size - under the cap a
           short label hit full width a third of the way in and then sat still,
           which is what made the shorter tabs feel like they snapped. */
            .bharatSubNav .seondtabs .list.active .subNavLabel {
                max-width: var(--subnav-label-w, 240px);
                margin-left: 8px;
                opacity: 1;
                transform: none;
                transition: max-width var(--subnav-dur) var(--subnav-ease),
                    margin-left var(--subnav-dur) var(--subnav-ease),
                    transform var(--subnav-dur) var(--subnav-ease),
                    opacity 240ms var(--subnav-ease) 110ms;
            }

            /* phone: the button keeps its label but gives up the arrow and most of
           its padding, so the tab track keeps as much of the row as possible */
            .bharatSubNav #secontnavApplyBtn {
                flex: 0 0 auto;
                max-width: 140px;
                margin-left: 6px;
            }

            .bharatSubNav #secontnavApplyBtn::before {
                left: -3px;
                height: 20px;
            }

            .bharatSubNav #secontnavApplyBtn .button {
                gap: 0;
                min-height: 36px;
                padding: 8px 12px;
                font-size: 13px;
            }

            .bharatSubNav #secontnavApplyBtn .button svg {
                display: none;
            }
        }

        /* smallest phones: claw back a little room between the pills */
        @media (max-width: 360px) {
            .bharatSubNav .seondtabs {
                gap: 4px !important;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            .stickymenu.bharatSubNav,
            .bharatSubNav .seondtabs .list,
            .bharatSubNav .seondtabs .list .subNavLabel,
            .bharatSubNav .seondtabs .list.active .subNavLabel {
                transition-duration: 1ms !important;
                transition-delay: 0s !important;
            }

            .pgpcourse.subNavFadeIn {
                animation-duration: 1ms !important;
            }
        }
    </style>

    <script>
        $(document).ready(function () {
            var navHoldTimer = null;

            // -------- CLICK HANDLER (Scroll to #toTop3) --------
            $('.seondtabs li').on('click', function (e) {
                e.preventDefault();

                // Default offset
                var offsetValue = 80;
                // short enough that the page settles alongside the pill and the
                // crossfade rather than a third of a second after them
                var duration = 600;

                // Tapping a tab from above #toTop3 scrolls *down*, which the auto-hide
                // handler below reads as "user is reading on" and slides the sub-nav
                // out from under the tap. Pin it for the length of the scroll.
                window.bharatNavHold = true;
                window.clearTimeout(navHoldTimer);
                navHoldTimer = window.setTimeout(function () {
                    window.bharatNavHold = false;
                }, duration + 150);

                $('html, body').stop(true).animate({
                    scrollTop: $('#toTop3').offset().top - offsetValue
                }, duration);
            });

            // The apply button used to collapse until the bar had stuck to the top.
            // It now rides along with the tabs at every scroll position, so there is
            // no scroll handler for it any more.
        });
    </script>

    <script>

        (function () {
            var nav = document.getElementById("stickyHeader");
            if (!nav) return;

            var HIDE_CLASS = "subNavHidden";
            var DELTA = 6; // ignore sub-pixel jitter and trackpad noise
            // phones keep the bar pinned at every scroll position - the tab track is
            // the only way between sections there, so it must never scroll away
            var MOBILE = "(max-width: 767px)";
            var lastY = window.pageYOffset;
            var ticking = false;

            function isMobile() {
                return window.matchMedia(MOBILE).matches;
            }

            // the `top` the sticky bar parks at, in px (2.9rem on desktop, 0 on mobile)
            function parkedAt() {
                var top = parseFloat(window.getComputedStyle(nav).top);
                return isNaN(top) ? 0 : top;
            }

            function update() {
                ticking = false;

                var y = window.pageYOffset;
                var diff = y - lastY;

                // mobile: never auto-hide. the remove() also un-hides the bar if a
                // desktop->mobile resize (or rotation) caught it mid-tuck.
                if (isMobile()) {
                    lastY = y;
                    nav.classList.remove(HIDE_CLASS);
                    return;
                }

                // a tab switch scrolls the page itself - the bar stays put through it
                if (window.bharatNavHold) {
                    lastY = y;
                    nav.classList.remove(HIDE_CLASS);
                    return;
                }

                if (Math.abs(diff) < DELTA) return;

                // Only start hiding once the bar has actually parked at the top -
                // otherwise it fades out while still sitting in the normal page flow.
                // getBoundingClientRect() already accounts for the hide transform, so
                // this stays true while the bar is tucked away.
                var parked = nav.getBoundingClientRect().top <= parkedAt() + 1;

                if (diff > 0 && parked) {
                    nav.classList.add(HIDE_CLASS);
                } else if (diff < 0) {
                    nav.classList.remove(HIDE_CLASS);
                }

                lastY = y;
            }

            window.addEventListener("scroll", function () {
                if (ticking) return;
                ticking = true;
                window.requestAnimationFrame(update);
            }, { passive: true });
        })();
    </script>

    <script>

        (function () {
            var track = document.querySelector('.bharatSubNav .seondtabs');
            if (!track) return;

            var tabs = track.querySelectorAll('.list');
            if (!tabs.length) return;

            var REDUCED = '(prefers-reduced-motion: reduce)';
            // a little past the pill's own 420ms, so the track is the last thing to settle
            var CENTRE_MS = 480;

            // Pull each tab's bare text node into a span - a text node on its own
            // can't be transitioned, and the markup ships the label unwrapped.
            Array.prototype.forEach.call(tabs, function (tab) {
                if (tab.querySelector('.subNavLabel')) return;

                var text = '';
                Array.prototype.slice.call(tab.childNodes).forEach(function (node) {
                    if (node.nodeType !== 3) return;
                    text += node.nodeValue;
                    tab.removeChild(node);
                });

                text = text.replace(/\s+/g, ' ').trim();
                if (!text) return;

                var label = document.createElement('span');
                label.className = 'subNavLabel';
                label.textContent = text;
                tab.appendChild(label);
            });

            // Park each label's natural width on its own tab for the CSS to grow into.
            // scrollWidth still reports the full text width while max-width clips it,
            // so this reads the same whether the tab is the open one or a collapsed one.
            function measureLabels() {
                Array.prototype.forEach.call(tabs, function (tab) {
                    var label = tab.querySelector('.subNavLabel');
                    if (!label) return;

                    var width = Math.ceil(label.scrollWidth);
                    // +1 keeps sub-pixel text off the clip edge
                    if (width) tab.style.setProperty('--subnav-label-w', (width + 1) + 'px');
                });
            }

            measureLabels();

            // web fonts land after first paint and move every one of those widths
            if (document.fonts && document.fonts.ready) {
                document.fonts.ready.then(measureLabels).catch(function () { });
            }

            function prefersReduced() {
                return window.matchMedia(REDUCED).matches;
            }

            // Where the track has to sit for `tab` to be centred, in content
            // coordinates. Rects rather than offsetLeft, since the sticky ancestor is
            // the offsetParent. null when there is nothing to scroll (desktop).
            //
            // Under 768px the page is zoomed to 85% (html { zoom: 85% } in
            // assets/css/newmains.css), and zoom pulls the two coordinate systems
            // apart: getBoundingClientRect() reports visual px while scrollLeft,
            // scrollWidth and clientWidth stay in layout px. Mixing them straight
            // leaves the pill short of centre by exactly the zoom factor, so the rect
            // deltas get divided back out. Reading the factor off the track itself
            // keeps this right at any zoom, including none.
            function centreFor(tab) {
                var overflow = track.scrollWidth - track.clientWidth;
                if (overflow <= 0) return null;

                var trackRect = track.getBoundingClientRect();
                var scale = track.offsetWidth ? trackRect.width / track.offsetWidth : 1;
                if (!(scale > 0)) return null;

                var tabRect = tab.getBoundingClientRect();
                var tabLeft = (tabRect.left - trackRect.left) / scale - track.clientLeft;
                var tabWidth = tabRect.width / scale;
                var target = track.scrollLeft + tabLeft - (track.clientWidth - tabWidth) / 2;

                return Math.max(0, Math.min(target, overflow));
            }

            var frame = null;

            function stopCentring() {
                if (frame === null) return;
                window.cancelAnimationFrame(frame);
                frame = null;
            }

            // a hand on the track always beats an in-flight centring pass
            ['touchstart', 'wheel'].forEach(function (name) {
                track.addEventListener(name, stopCentring, { passive: true });
            });

            function centreActive(tab, instant) {
                if (!tab) return;
                stopCentring();

                if (instant || prefersReduced()) {
                    var jump = centreFor(tab);
                    if (jump !== null) track.scrollLeft = jump;
                    return;
                }

                var from = 0;
                var started = null;
                var deadline = null;

                function step(now) {
                    if (deadline === null) deadline = now + CENTRE_MS;

                    var to = centreFor(tab);

                    // The outgoing pill is still shrinking and the incoming one still
                    // growing, so on the first frames of a switch the row often has
                    // not started overflowing yet - there is literally nowhere to
                    // scroll. Wait for the room to open up rather than giving up
                    // (which stranded the widest tab half off-screen), but never wait
                    // longer than the morph itself takes.
                    if (to === null) {
                        frame = now < deadline ? window.requestAnimationFrame(step) : null;
                        return;
                    }

                    // clock starts from the first frame that has somewhere to go
                    if (started === null) {
                        started = now;
                        from = track.scrollLeft;
                    }

                    var progress = Math.min(1, (now - started) / CENTRE_MS);
                    // The pill is still widening underneath us, so the destination is
                    // re-read every frame. Easing towards a moving target is the whole
                    // trick: the scroll and the morph finish together, on the same
                    // frame, and land exactly centred.
                    var eased = 1 - Math.pow(1 - progress, 3);
                    track.scrollLeft = from + (to - from) * eased;
                    frame = progress < 1 ? window.requestAnimationFrame(step) : null;
                }

                frame = window.requestAnimationFrame(step);
            }

            // switchToTab (views/layouts/indiaBootcamp.hbs) calls in here instead of
            // running its own scroll animation.
            window.bharatCenterSubNavTab = function (tab) {
                centreActive(tab, false);
            };

            // a deep-linked tab shouldn't slide in from off-screen on first paint
            centreActive(track.querySelector('.list.active'), true);

            // Re-measure on a real width change only. initializeTabContent fires a
            // synthetic resize on every switch, and acting on that would snap the
            // track mid-animation; height-only resizes (the mobile URL bar) are noise
            // for the same reason.
            var resizeTimer = null;
            var lastWidth = window.innerWidth;

            window.addEventListener('resize', function () {
                if (window.innerWidth === lastWidth) return;
                lastWidth = window.innerWidth;

                window.clearTimeout(resizeTimer);
                resizeTimer = window.setTimeout(function () {
                    measureLabels();
                    centreActive(track.querySelector('.list.active'), true);
                }, 150);
            });
        })();
    </script>

