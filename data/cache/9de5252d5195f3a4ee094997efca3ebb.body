        <style>
          /* ── SECTION ── */
          .pgpJourneySwiperSection {
            width: 100%;
            padding: 60px 0;
            background: var(--black);
          }
        
        
        
          /* ── HEADER ── */
          .journeyHeaderWrapper {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
          }
        
          .journeyHeading {
        
            font-size: 30px;
            font-family: var(--go-regular);
            font-weight: 400;
            line-height: 120%;
            color: var(--white);
        
          }
        
          .journeyHeadingItalic {
            font-style: italic;
            font-size: 34px;
            line-height: 120%;
            font-family: "Fraunces 72pt";
            font-weight: 400;
          }
        
          .jouneyActionButtons {
            display: flex;
            gap: 10px;
          }
        
          .navBtn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: 1.5px solid var(--border);
            background: transparent;
            color: var(--text-primary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s, border-color 0.2s, transform 0.15s;
          }
        
          .navBtn:hover {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(255, 255, 255, 0.2);
          }
        
          .navBtn:active {
            transform: scale(0.93);
          }
        
          .navBtn:disabled {
            opacity: 0.3;
            cursor: default;
          }
        
          /* ── SLIDE WRAPPER (viewport) ── */
          .journeySlideWrapper {
            overflow: hidden;
            border-radius: var(--radius);
            width: 100%;
        
          }
        
          .slidesTrack {
            display: flex;
            transition: transform 0.55s cubic-bezier(0.77, 0, 0.18, 1);
            will-change: transform;
            margin-bottom: 24px;
        
          }
        
          /* ── INDIVIDUAL SLIDE ── */
          .slide {
            min-width: 100%;
            width: 100%;
            flex-shrink: 0;
            border-radius: 16px;
            border: 1px solid #404040;
            background: #171717;
            max-height: 382px;
        
          }
        
          .slideInner {
            display: flex;
            gap: 10px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px;
            overflow: hidden;
            height: 100%;
        
          }
        
        
          .cityInfo {
            color: var(--white);
          }
        
          /* ── BENTO CARDS ── */
          .bentoCard {
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            background: var(--card-bg);
          }
        
          /* Text card (left column) */
          .textCard {
            display: flex;
            flex-direction: column;
            padding: 22px 20px 16px;
            gap: 10px;
          }
        
          .cityIcon {
            font-size: 22px;
            line-height: 1;
          }
        
          .cityName {
            font-family: var(--go-regular);
            font-size: 30px;
            font-weight: 400;
            color: var(--white);
            line-height: 120%;
          }
        
          .cityDesc {
            font-size: 13.5px;
            line-height: 1.65;
            color: rgba(240, 237, 232, 0.72);
            flex: 1;
          }
        
          .cityDesc strong {
            color: var(--text-primary);
            font-weight: 600;
          }
        
          .cardImageWrap {
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            height: 180px;
            flex-shrink: 0;
            margin-top: auto;
          }
        
          .cardImg {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.4s ease;
          }
        
          .bentoCard:hover .cardImg {
            transform: scale(1.03);
          }
        
          /* Tall center photo card */
          .photoCard {
            position: relative;
          }
        
          .photoCard.tall {
            grid-row: 1 / 2;
          }
        
          .bentoImg {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.4s ease;
          }
        
          .photoCard:hover .bentoImg {
            transform: scale(1.04);
          }
        
          /* Tag chips */
          .imgTag {
            position: absolute;
            bottom: 12px;
            right: 12px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 600;
            color: #fff;
            letter-spacing: 0.01em;
            backdrop-filter: blur(4px);
            white-space: nowrap;
          }
        
          /* Right column — two stacked halves */
          .bentoRightCol {
            display: flex;
            flex-direction: column;
            gap: 10px;
          }
        
          .photoCard.half {
            flex: 1;
            min-height: 0;
          }
        
          /* ── PAGINATION TIMELINE ── */
          .journeyPaginationDots {
            margin-top: 32px;
            padding: 0 8px;
          }
        
          .timelineTrack {
            position: relative;
            padding-top: 6px;
            /* space so dots aren't clipped */
          }
        
          .timelineLine {
            position: absolute;
            top: 12px;
            /* center of 12px dot */
            left: 0;
            right: 0;
            height: 2px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 2px;
          }
        
          .timelineProgress {
            height: 100%;
            width: 0%;
            background: #e8722a;
            border-radius: 2px;
            transition: width 0.55s cubic-bezier(0.77, 0, 0.18, 1);
          }
        
          .timelineDots {
            position: relative;
            z-index: 1;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
          }
        
          .dotWrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            cursor: pointer;
          }
        
          .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            transition: background 0.3s, transform 0.3s, box-shadow 0.3s;
            flex-shrink: 0;
            margin: 0 !important;
          }
        
          /* ✅ solid fill, no hollow ring */
          .dotWrapper.active .dot {
            background: #e8722a;
            transform: scale(1.4);
            box-shadow: 0 0 0 4px rgba(232, 114, 42, 0.25);
          }
        
          .dotWrapper:hover:not(.active) .dot {
            background: rgba(255, 255, 255, 0.5);
          }
        
          .dotLabel {
            position: absolute;
            top: -32px;
            font-size: 11px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.4);
            white-space: nowrap;
            text-align: center;
            line-height: 1.3;
            transition: color 0.3s;
          }
        
          .dotWrapper:nth-child(3) .dotLabel {
            top: -44px;
            /* extra space for 2-line label */
          }
        
          .dotWrapper.active .dotLabel {
            color: #f0ede8;
            font-weight: 700;
          }
        
        
          /* Past dots — filled orange, smaller than active */
          .dotWrapper.past .dot {
            background: #e8722a;
            transform: scale(1);
          }
        
          /* Active dot — pulsing ring */
          .dotWrapper.active .dot {
            background: #e8722a;
            transform: scale(1.4);
            animation: dotPulse 1.8s ease-out infinite;
          }
        
          @keyframes dotPulse {
            0% {
              box-shadow: 0 0 0 0px rgba(232, 114, 42, 0.5);
            }
        
            60% {
              box-shadow: 0 0 0 7px rgba(232, 114, 42, 0);
            }
        
            100% {
              box-shadow: 0 0 0 0px rgba(232, 114, 42, 0);
            }
          }
        
        
          .dotWrapper:last-child .dotLabel {
            text-align: right;
            transform: translateX(-20%);
          }
        </style>
        
        
        <script>
          (function () {
        
            // ── CONFIG: Add / update city labels to match your 10 slides ──
            const cityLabels = [
              'Delhi',
              'Jalandhar',
              'Mundra &\nAhmedabad',
              'Mumbai',
              'Goa',
              'Bengaluru',
              'Darjeeling',
              'Lucknow',
            ];
        
            // ── STATE ──
            let current = 0;
            const total = cityLabels.length;
        
            // ── DOM REFS ──
            const track = document.querySelector('.slidesTrack');
            const prevBtn = document.querySelector('.prevBtn');
            const nextBtn = document.querySelector('.nextBtn');
            const dotsWrap = document.querySelector('.timelineDots');
            const progressEl = document.querySelector('.timelineProgress');
        
            // ── BUILD TIMELINE DOTS ──
            cityLabels.forEach((label, i) => {
              const wrapper = document.createElement('div');
              wrapper.className = 'dotWrapper' + (i === 0 ? ' active' : '');
              wrapper.innerHTML = `<div class="dot"></div><span class="dotLabel">${label.replace('\n', '<br>')}</span>`;
              wrapper.addEventListener('click', () => goTo(i));
              dotsWrap.appendChild(wrapper);
            });
            //RENDER
            function render() {
              // Move slides
              track.style.transform = `translateX(-${current * 100}%)`;
        
              // Update dots
              dotsWrap.querySelectorAll('.dotWrapper').forEach((el, i) => {
                el.classList.toggle('active', i === current);
                el.classList.toggle('past', i < current);
              });
        
              // ✅ Fill progress only up to active dot center
              const pct = total <= 1 ? 0 : (current / (total - 1)) * 100;
              progressEl.style.width = pct + '%';
        
              prevBtn.disabled = current === 0;
              nextBtn.disabled = current === total - 1;
            }
        
            // ── NAVIGATION ──
            function goTo(index) {
              current = Math.max(0, Math.min(total - 1, index));
              render();
            }
        
            prevBtn.addEventListener('click', () => goTo(current - 1));
            nextBtn.addEventListener('click', () => goTo(current + 1));
        
            // ── KEYBOARD ──
            document.addEventListener('keydown', (e) => {
              if (e.key === 'ArrowLeft') goTo(current - 1);
              if (e.key === 'ArrowRight') goTo(current + 1);
            });
        
            // ── TOUCH / SWIPE ──
            let startX = 0;
            let isDragging = false;
        
            track.addEventListener('touchstart', (e) => {
              startX = e.touches[0].clientX;
              isDragging = true;
            }, { passive: true });
        
            track.addEventListener('touchend', (e) => {
              if (!isDragging) return;
              const diff = startX - e.changedTouches[0].clientX;
              if (Math.abs(diff) > 50) goTo(current + (diff > 0 ? 1 : -1));
              isDragging = false;
            }, { passive: true });
        
            // ── INIT ──
            render();
        
          })();
        </script>
        
        
