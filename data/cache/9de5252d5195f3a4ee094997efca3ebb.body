                <script>
                    (function () {
                        const wrapper = document.getElementById('placeAccordion');
                        if (!wrapper) return;

                        const steps = wrapper.querySelectorAll('.placeStepBox[data-place]');
                        const details = wrapper.querySelectorAll('.plceDetailBox[data-place]');
                        if (!steps.length || !details.length) return;

                        function setActive(place) {
                            steps.forEach(step => {
                                const on = step.dataset.place === place;
                                step.classList.toggle('active', on);
                                step.setAttribute('aria-selected', on ? 'true' : 'false');
                            });

                            details.forEach(detail => {
                                detail.classList.toggle('active', detail.dataset.place === place);
                            });
                        }

                        // Open the first hub by default (falls back to the markup's
                        // pre-set active step if one is already flagged).
                        const preset = wrapper.querySelector('.placeStepBox.active[data-place]');
                        setActive((preset || steps[0]).dataset.place);

                        steps.forEach(step => {
                            step.addEventListener('click', function () {
                                setActive(step.dataset.place);
                            });

                            step.addEventListener('keydown', function (e) {
                                if (e.key === 'Enter' || e.key === ' ') {
                                    e.preventDefault();
                                    setActive(step.dataset.place);
                                }
                            });
                        });
                    })();
                </script>

            </section>
