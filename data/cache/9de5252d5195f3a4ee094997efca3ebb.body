                <script>
                    if (window.innerWidth < 767) {
                        const tabs = document.querySelectorAll('.cityList .termBtn');
                        const container = document.querySelector('.cityList');

                        tabs.forEach(tab => {
                            tab.addEventListener('click', () => {
                                // Remove active class from all tabs
                                tabs.forEach(t => t.classList.remove('active'));
                                tab.classList.add('active');

                                // Calculate the position to center the active tab
                                const containerWidth = container.offsetWidth;
                                const tabWidth = tab.offsetWidth;
                                const tabOffsetLeft = tab.offsetLeft;

                                // Calculate the scroll position to center the tab
                                const scrollPosition = tabOffsetLeft - (containerWidth / 2) + (tabWidth / 2);

                                // Ensure scroll position is within bounds
                                const maxScroll = container.scrollWidth - containerWidth;
                                const finalScrollPosition = Math.max(0, Math.min(scrollPosition, maxScroll));

                                // Smooth scroll to center the tab
                                container.scrollTo({ left: finalScrollPosition, behavior: 'smooth' });
                            });
                        });
                    }
                </script>
            </section>
        </div>

        <div class="custom-pin-spacer mob-hide">

            <section class="custom-container ">
                <!-- TOP -->
                <div class="custom-top">
                    <div class="custom-imgWrapper">
                        <div class="image-container">
                            <img src="https://images.mastersunion.link/uploads/23092025/v1/image442964.webp"
                                alt="Orientation">
                            <img src="https://images.mastersunion.link/uploads/25092025/v1/Frame13213183148.webp"
                                alt="Term 1">
                            <img src="https://images.mastersunion.link/uploads/23092025/v1/Frame13213183133.webp"
                                alt="Term 2">
                            <img src="https://images.mastersunion.link/uploads/23092025/v1/Frame13213183147.webp"
                                alt="Term 3">
                        </div>
                    </div>

                    <div class="custom-content">
                        <div class="custom-slide" data-index="0">
                            <div class="custom-text">
                                <h3 class="bharatHeroHeading"> <span class="bharatBoldHead"> Your Journey </span> <br>
                                    Across <br> PGP Bharat</h3>
                            </div>

                            <div class="custom-text">
                                <h2 class="termHeading">Orientation</h2>
                                <p class="termDescription">Kick off your <span class="boldColor">PGP Bharat
                                        journey</span>
                                    with<br>
                                    skill-building, cultural discovery,<br> <span class="boldColor"> CXO </span>
                                    sessions
                                    and peer bonding.</p>
                            </div>
                        </div>

                        <div class="custom-slide" data-index="1">
                            <div class="custom-text">
                                <p class="termPara">Term 1</p>
                                <h2 class="termHeading">In Class and Dropshipping<br> Challenge</h2>
                                <p class="termDescription">Run a real<span class="boldColor"> dropshipping
                                        venture</span>
                                    while
                                    learning<br> business
                                    frameworks through <span class="boldColor">Out Class workshops</span><br> and <span
                                        class="boldColor">In Class sessions</span>.</p>

                            </div>
                        </div>

                        <div class="custom-slide" data-index="2">


                            <div class="custom-text">
                                <p class="termPara">Term 2</p>
                                <h2 class="termHeading">Travel based Immersions</h2>
                                <p class="termDescription">Explore <span class="boldColor">20+ cities</span> through
                                    <span class="boldColor">25+ business & cultural <br> immersions</span> and
                                    apply your learning through <br> <span class="boldColor">hands-on consultancy
                                        challenges.</span>
                                </p>
                            </div>
                        </div>

                        <div class="custom-slide" data-index="3">
                            <div class="custom-text">
                                <p class="termPara">Term 3</p>
                                <h2 class="termHeading">In Class and<br> Venture Initiation Programme</h2>
                                <p class="termDescription">Students get the opportunity to present their <span
                                        class="boldColor">startup idea</span><br> for
                                    <span class="boldColor">pre-seed funding</span> and parallelly, In class learning
                                    blends<br>
                                    core courses, <span class="boldColor">workshops</span>, and
                                    <span class="boldColor">real-world challenges</span> to<br> build practical business
                                    understanding.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TIMELINE -->
                <div class="custom-timeline">
                    <div class="custom-progressBar">
                        <div class="custom-progress"></div>
                        <div class="custom-dots">
                            <span class="custom-dot" data-text="Orientation"></span>
                            <span class="custom-dot two" data-text="Foundation"></span>
                            <span class="custom-dot three" data-text="Development"></span>
                            <span class="custom-dot" data-text="Mastery"></span>
                        </div>

                        <div class="dotContent">
                            <p class="dotContentText">Orientation</p>
                            <p class="dotContentText">Term 1 <br>(Month 1, 2)</p>
                            <p class="dotContentText">Term 2 <br>(Month 3, 4)</p>
                            <p class="dotContentText">Term 3 <br>(Month 5, 6)</p>
                        </div>
                    </div>
                </div>

                <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollToPlugin.min.js"></script>
                <script src="https://cdn.jsdelivr.net/npm/split-type@0.3.4/umd/index.min.js"></script>
                <script>
                    (function () {
                        gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

                        // Prevent GSAP from "catching up" the elapsed time after the tab
                        // regains focus (rAF is paused in background tabs). Without this,
                        // scrub-based ScrollTriggers jump or break on tab switch.
                        gsap.ticker.lagSmoothing(0);

                        // Everything below is scoped to this block. The mobile stick
                        // section reuses .bharatHeroHeading / .termHeading / .termDescription,
                        // and must not be split or hidden by these animations.
                        const root = document.querySelector('.custom-pin-spacer');
                        if (!root) return;

                        const slideEl = i => root.querySelector('.custom-slide[data-index="' + i + '"]');

                        // ── SplitType — the .line is the static mask, the inner div moves ──
                        const heroSplit = new SplitType(root.querySelector('.bharatHeroHeading'), { types: 'lines' });
                        const termSplits = [...root.querySelectorAll('.termHeading')]
                            .map(el => new SplitType(el, { types: 'lines' }));

                        function wrapLines(lines) {
                            lines.forEach(line => {
                                const inner = document.createElement('div');
                                inner.style.cssText = 'display:block;will-change:transform;';
                                while (line.firstChild) inner.appendChild(line.firstChild);
                                line.appendChild(inner);
                                line.style.display = 'block';
                                line.style.overflow = 'hidden';
                                line.style.paddingBottom = '0.14em';   // room for descenders
                                line.style.marginBottom = '-0.14em';
                            });
                        }
                        wrapLines(heroSplit.lines);
                        termSplits.forEach(st => wrapLines(st.lines));

                        const heroLines = heroSplit.lines.map(l => l.firstChild);

                        function resetText() {
                            gsap.killTweensOf(root.querySelectorAll('.termHeading .line > div, .termPara, .termDescription'));
                            gsap.set(heroLines, { yPercent: 105 });
                            gsap.set(root.querySelectorAll('.termHeading .line > div'), { yPercent: 105 });
                            gsap.set(root.querySelectorAll('.termPara, .termDescription'), { opacity: 0, y: 12 });
                        }
                        resetText();

                        // How long the outgoing slide's text stays put before it leaves, so
                        // it keeps filling the gap while the next slide is already coming in.
                        const OUT_HOLD = 0.75;

                        let slide0Played = false;
                        function playSlide0() {
                            if (slide0Played) return;
                            slide0Played = true;
                            const s0 = slideEl(0);
                            gsap.timeline({ defaults: { ease: 'power3.out' } })
                                .to(heroLines, { yPercent: 0, duration: 1.05, stagger: 0.09 })
                                .to(s0.querySelectorAll('.termHeading .line > div'), {
                                    yPercent: 0, duration: 0.95, stagger: 0.07
                                }, '-=0.7')
                                .to(s0.querySelector('.termDescription'), {
                                    opacity: 1, y: 0, duration: 0.8, ease: 'power2.out'
                                }, '-=0.5');
                        }

                        // ── Quiet mask reveal ──────────────────────────────────
                        function animateSlideIn(index) {
                            const slide = slideEl(index);
                            if (!slide) return;
                            const lines = slide.querySelectorAll('.termHeading .line > div');
                            const para = slide.querySelector('.termPara');
                            const desc = slide.querySelector('.termDescription');
                            // cancel a pending exit if this slide is scrubbed back into view
                            gsap.killTweensOf([...lines, para, desc].filter(Boolean));
                            const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

                            if (para) {
                                gsap.set(para, { opacity: 0, y: 10 });
                                tl.to(para, { opacity: 1, y: 0, duration: 0.6 }, 0);
                            }

                            if (lines.length) {
                                gsap.set(lines, { yPercent: 105 });
                                tl.to(lines, { yPercent: 0, duration: 0.9, stagger: 0.07 }, 0.06);
                            }

                            if (desc) {
                                gsap.set(desc, { opacity: 0, y: 12 });
                                tl.to(desc, { opacity: 1, y: 0, duration: 0.75, ease: 'power2.out' }, 0.24);
                            }
                        }

                        function animateSlideOut(index) {
                            const slide = slideEl(index);
                            if (!slide) return;
                            const lines = slide.querySelectorAll('.termHeading .line > div');
                            const para = slide.querySelector('.termPara');
                            const desc = slide.querySelector('.termDescription');
                            gsap.to([para, desc].filter(Boolean), {
                                opacity: 0, y: -8, duration: 0.5, ease: 'power2.in', delay: OUT_HOLD
                            });
                            gsap.to(lines, {
                                yPercent: -105, duration: 0.55, ease: 'power2.in', stagger: 0.05, delay: OUT_HOLD
                            });
                        }

                        // ── Image transitions — band-mask reveal over a static stack ──
                        // The images sit stacked in the card; the incoming one is revealed
                        // through 3 equal bands that each fill from their right edge
                        // leftwards, while the outgoing one waits underneath. Nothing
                        // moves, so nothing jitters.
                        const images = [...root.querySelectorAll('.image-container img')];
                        let currentImgIndex = 0;

                        function clearReveal(img) {
                            img.classList.remove('is-revealing');
                            img.style.removeProperty('--po');
                        }

                        function resetImages() {
                            gsap.killTweensOf(images);
                            images.forEach(clearReveal);
                            gsap.set(images, { zIndex: 0 });
                            gsap.set(images[0], { zIndex: 2 });
                            currentImgIndex = 0;
                        }

                        function changeImageTo(newIndex) {
                            if (newIndex === currentImgIndex || !images[newIndex]) return;
                            const prev = currentImgIndex;
                            const inImg = images[newIndex];
                            currentImgIndex = newIndex;

                            gsap.killTweensOf(inImg);
                            images.forEach((im, i) => {
                                if (i !== newIndex && i !== prev) { clearReveal(im); gsap.set(im, { zIndex: 0 }); }
                            });

                            clearReveal(images[prev]);
                            gsap.set(images[prev], { zIndex: 1 });

                            inImg.classList.add('is-revealing');
                            inImg.style.setProperty('--po', '0');
                            gsap.set(inImg, { zIndex: 2 });
                            gsap.to(inImg, {
                                '--po': 1,
                                duration: 1.2,
                                ease: 'power3.out',
                                onComplete() {
                                    if (currentImgIndex === newIndex) clearReveal(inImg);
                                }
                            });
                        }

                        // ── Horizontal scroll ──────────────────────────────────
                        let scrollTriggerInstance;

                        function initializeAnimation() {
                            // Kill previous instance if exists
                            if (scrollTriggerInstance) {
                                scrollTriggerInstance.kill();
                                ScrollTrigger.getAll().forEach(st => st.kill());
                            }

                            const slides = gsap.utils.toArray(root.querySelectorAll('.custom-slide'));
                            const progressLine = root.querySelector('.custom-progress');
                            const customDots = root.querySelectorAll('.custom-dot');
                            const dotContentTexts = root.querySelectorAll('.dotContentText');
                            const imageWrapper = root.querySelector('.custom-imgWrapper');
                            const container = root.querySelector('.custom-container');

                            if (!container || slides.length === 0) return;

                            // Reset container styles
                            container.style.visibility = "visible";
                            container.style.display = "flex";

                            // Reset GSAP transforms
                            gsap.set(".custom-content", { clearProps: "all" });

                            // ✅ Function to calculate total scrollable width (fixed)
                            const getMaxScrollWidth = () => {
                                const totalWidth = slides.reduce((sum, slide) => sum + slide.offsetWidth, 0);
                                return totalWidth - window.innerWidth + 200; // ✅ extra scroll allowance
                            };

                            setTimeout(() => imageWrapper?.classList.add("loaded"), 100);

                            resetImages();
                            if (!slide0Played) resetText();

                            if (customDots.length > 0) {
                                customDots.forEach(dot => dot.classList.remove("active", "passed"));
                                dotContentTexts.forEach(text => text.classList.remove("active"));
                                customDots[0].classList.add("active");
                                dotContentTexts[0]?.classList.add("active");
                            }

                            // Slide 0's text waits for the section to scroll into view
                            if (!slide0Played) {
                                ScrollTrigger.create({
                                    trigger: ".custom-container",
                                    start: "top 90%",
                                    onEnter: playSlide0,
                                    once: true
                                });
                            }

                            let currentActiveIndex = 0;

                            // Where the dots actually sit on the track, as a % of its width.
                            // Read from the DOM rather than hardcoded, so the bar tip lands
                            // exactly on a dot when that term becomes active.
                            const progressTrack = root.querySelector(".custom-progressBar");
                            let dotPercents = [];
                            function measureDots() {
                                const w = progressTrack ? progressTrack.clientWidth : 0;
                                if (!w) return;
                                dotPercents = [...customDots].map(
                                    d => ((d.offsetLeft + d.offsetWidth / 2) / w) * 100
                                );
                            }
                            measureDots();

                            // One equal slice of the scroll per term
                            const segment = 1 / customDots.length;

                            // HORIZONTAL SCROLL WITHOUT PIN
                            scrollTriggerInstance = gsap.to(".custom-content", {
                                x: () => `-${getMaxScrollWidth()}`,
                                ease: "none",
                                scrollTrigger: {
                                    trigger: ".custom-container",
                                    start: "top top",
                                    end: () => `+=${getMaxScrollWidth()}`, // ✅ fixed
                                    scrub: 2,
                                    invalidateOnRefresh: true,
                                    onRefresh: measureDots,
                                    onUpdate: self => {
                                        const progress = self.progress;

                                        let activeDotIndex = Math.min(
                                            customDots.length - 1,
                                            Math.floor(progress / segment)
                                        );

                                        if (dotPercents.length) {
                                            // Interpolate from this dot to the next; over the
                                            // final term run all the way out to 100% so the bar
                                            // finishes flush with the end of the track.
                                            const f = Math.min(1, Math.max(0,
                                                (progress - activeDotIndex * segment) / segment));
                                            const from = dotPercents[activeDotIndex];
                                            const to = activeDotIndex + 1 < dotPercents.length
                                                ? dotPercents[activeDotIndex + 1]
                                                : 100;
                                            progressLine.style.width = `${from + f * (to - from)}%`;
                                        }

                                        if (activeDotIndex !== currentActiveIndex && slides[activeDotIndex]) {
                                            if (activeDotIndex > 0) animateSlideOut(currentActiveIndex);
                                            animateSlideIn(activeDotIndex);
                                            changeImageTo(activeDotIndex);

                                            currentActiveIndex = activeDotIndex;
                                            customDots.forEach((dot, j) => {
                                                dot.classList.toggle("active", j === currentActiveIndex);
                                                dot.classList.toggle("passed", j < currentActiveIndex);
                                            });

                                            dotContentTexts.forEach((text, j) => {
                                                text.classList.toggle("active", j === currentActiveIndex);
                                            });
                                        }
                                    }
                                }
                            });
                        }

                        // Initialize once
                        initializeAnimation();

                        // ----------------------
                        // TAB SWITCH HANDLING
                        // ----------------------
                        document.addEventListener('visibilitychange', () => {
                            if (document.hidden) return;
                            // Recalculate ScrollTrigger positions once the tab is visible
                            // again. refresh() preserves the current scroll position, so we
                            // avoid the fragile teardown/rebuild that broke the animation.
                            requestAnimationFrame(() => ScrollTrigger.refresh());
                        });

                        // ----------------------
                        // RESIZE HANDLING
                        // ----------------------
                        let resizeTimeout;
                        window.addEventListener('resize', () => {
                            if (resizeTimeout) clearTimeout(resizeTimeout);
                            resizeTimeout = setTimeout(() => {
                                ScrollTrigger.refresh(true);
                            }, 250);
                        });

                        // ----------------------
                        // MANUAL REFRESH
                        // ----------------------
                        function cleanupAnimation() {
                            if (scrollTriggerInstance) {
                                scrollTriggerInstance.kill();
                                ScrollTrigger.getAll().forEach(st => st.kill());
                                gsap.set(".custom-content", { clearProps: "all" });
                            }
                        }

                        window.addEventListener('unload', cleanupAnimation);

                        window.refreshPGPJourneyAnimation = () => {
                            cleanupAnimation();
                            setTimeout(() => {
                                initializeAnimation();
                                ScrollTrigger.refresh(true);
                            }, 100);
                        };
                    })();
                </script>



                <style>
                    .custom-container {
                        display: flex;
                        flex-direction: column;
                        height: 100vh;
                        padding-bottom: 40px;
                        background: url(https://images.mastersunion.link/uploads/12092025/v1/Vector13514.svg), var(--black);
                        background-repeat: round;
                        object-fit: contain;
                        overflow: hidden !important;

                        position: sticky;
                        top: 0;
                    }

                    .custom-pin-spacer {
                        height: 779vh;
                        background: var(--black);
                    }

                    /* TOP SECTION */
                    .custom-top {
                        flex: 1;
                        display: flex;
                        overflow: hidden;
                        position: relative;
                    }

                    .dotContentText:first-child {
                        position: absolute;
                        top: -40px;
                        left: 17%;
                    }

                    .dotContentText:nth-child(2) {
                        position: absolute;
                        top: -60px;
                        left: 35%;
                    }

                    .dotContentText:nth-child(3) {
                        position: absolute;
                        top: -60px;
                        left: 55%;
                    }

                    .dotContentText:nth-child(4) {
                        position: absolute;
                        top: -60px;
                        left: 77%;
                    }

                    /* IMAGE WRAPPER */
                    .custom-imgWrapper {
                        width: 256px;
                        height: 362px;
                        position: sticky;
                        top: 45%;
                        left: 42%;
                        transform: translateY(-40%);
                        z-index: 10;
                        flex-shrink: 0;
                        opacity: 0;
                        visibility: hidden;
                    }

                    .custom-imgWrapper.loaded {
                        opacity: 1;
                        visibility: visible;
                        transition: opacity 0.3s ease, visibility 0.3s ease;
                    }

                    .dotContentText {
                        font-size: 18px;
                        line-height: 120%;
                        font-family: var(--go-regular);
                        text-align: center;
                        color: var(--grey3);
                        transition: color 0.3s ease;
                    }

                    .dotContentText.active {
                        color: var(--white);
                    }

                    .image-container {
                        position: relative;
                        width: 100%;
                        height: 100%;
                        border-radius: 16px;
                        overflow: hidden;
                        background: #0b0b0b;
                        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
                    }

                    .image-container img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        position: absolute;
                        top: 0;
                        left: 0;
                        z-index: 0;
                    }

                    .image-container img:first-child {
                        z-index: 2;
                    }

                    /* The incoming image is revealed through 3 equal bands that each fill
                   from their right edge leftwards — --po (0 → 1) is what GSAP tweens. */
                    .image-container img.is-revealing {
                        --po: 0;
                        --band: 33.3334%;
                        --segment: calc(var(--po) * var(--band));
                        -webkit-mask-image: repeating-linear-gradient(to left,
                                #000 0, #000 var(--segment),
                                transparent var(--segment), transparent var(--band));
                        mask-image: repeating-linear-gradient(to left,
                                #000 0, #000 var(--segment),
                                transparent var(--segment), transparent var(--band));
                        will-change: mask-image;
                    }

                    /* CONTENT WRAPPER */
                    .custom-content {
                        display: flex;
                        flex-wrap: nowrap;
                        height: 90%;
                        align-items: center;
                        margin-left: 0;
                        will-change: transform;
                    }

                    /* hidden until their slide is animated in (desktop block only) */
                    .custom-pin-spacer .termPara,
                    .custom-pin-spacer .termDescription {
                        opacity: 0;
                    }

                    .custom-slide {
                        flex: 0 0 100vw;
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        transition: opacity 0.4s ease, transform 0.4s ease;
                    }

                    .custom-slide:first-child {
                        flex: 0 0 70vw;
                    }


                    .termPara {
                        font-size: 15px;
                        line-height: 120%;
                        font-family: var(--go-medium);
                        color: var(--white);
                    }

                    .termHeading {
                        font-size: 32px;
                        font-weight: 400;
                        line-height: 120%;
                        color: var(--white);
                        font-family: var(--go-regular);
                        margin-top: 8px;
                    }

                    .custom-slide:nth-child(4) {
                        justify-content: flex-start;
                    }

                    .custom-slide:nth-child(3) {
                        justify-content: flex-start;
                        flex: 0 0 70vw;
                    }

                    .custom-slide:nth-child(2) {
                        justify-content: center;
                        flex: 0 0 105vw;
                    }

                    .termDescription {
                        font-size: 16px;
                        line-height: 150%;
                        font-family: var(--go-regular);
                        color: var(--grey10);
                        margin-top: 16px;

                    }

                    /* TIMELINE */
                    .custom-timeline {
                        width: 100%;
                        background: #000;
                    }

                    .custom-progressBar {
                        width: 100%;
                        height: 2px;
                        background: rgba(255, 255, 255, 0.2);
                        border-radius: 3px;
                        position: relative;
                    }

                    .custom-progress {
                        width: 10%;
                        height: 100%;
                        background: #E38330;
                        border-radius: 3px;
                        position: absolute;
                        left: 0%;
                        top: 0;
                    }

                    .custom-dots {
                        width: 100%;
                        display: flex;
                        justify-content: space-evenly;
                        align-items: center;
                        position: absolute;
                        top: -10px;
                        left: 0;
                    }

                    .custom-dot {
                        width: 12px;
                        height: 12px;
                        background: #404040;
                        border-radius: 50%;
                        cursor: pointer;
                        transform: translateY(20%);
                        transition: background 0.3s, transform 0.3s, width 0.3s, height 0.3s;
                    }

                    .custom-dot.passed {
                        background: #E38330;
                    }

                    .custom-dot.active {
                        background: #E38330;
                        width: 18px;
                        height: 18px;
                        padding: 3px;
                        background-clip: content-box;
                        border: 1px solid #E38330;
                        transform: translateY(15%);
                    }

                    .bharatHeroHeading {
                        font-size: 52px;
                        line-height: 120%;
                        font-family: var(--go-semibold);
                        color: var(--white);
                    }

                    .bharatBoldHead {
                        color: #E38330;
                    }

                    @media (min-width: 1024px) and (max-width: 1280px) {
                        .custom-container {


                            .custom-slide:first-child {
                                flex: 0 0 90vw;
                                margin-left: -100px;

                            }

                            .custom-slide:nth-child(2) {
                                padding-left: 200px;
                            }

                            .custom-slide:nth-child(3) {
                                justify-content: flex-start;
                                flex: 0 0 60vw;
                            }
                        }

                        .gsap-scroll-trigger-pin-spacer {
                            width: 100vw !important;
                            height: 100vh !important;
                        }

                        .custom-container[data-scroll-trigger] {
                            width: 100vw !important;
                            height: 100vh !important;
                        }
                    }

                    @media (min-width: 1900px) {
                        .custom-pin-spacer {
                            height: 660vh !important;
                        }
                    }

                    /* Ensure pin spacer maintains proper document flow */
                    .gsap-scroll-trigger-pin-spacer {
                        height: auto !important;
                        margin: 0 !important;
                        padding: 0 !important;
                        min-height: 100vh !important;
                    }
                </style>
            </section>
        </div>

        <section class="mob-visible stickSection">
            <div class="parentStick">
                <div class="stickWrapper">


                    <div class="stickDivi arrowDiv">
                        <h2 class="bharatHeroHeading"> <span class="bharatBoldHead"> Your Journey </span><br>
                            Across <br> PGP Bharat</h2>

                        <div class="arrow-right-with-line"></div>
                    </div>

                    <div class="stickDivi">

                        <div class="stickImage">
                            <img src="https://images.mastersunion.link/uploads/23092025/v1/image442964.webp"
                                alt="PGP Bharat Journey">
                        </div>

                        <div class="custom-text">
