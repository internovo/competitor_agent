    <div class="pgpcourse  " id="admissionfees">

        <main class="pgpadmissionfees">
            <section class="enrollmentSection">
                <div class="container">
                    <div class="enrollmentWrapper">
                        <h2 class="go-HighlightHeading font-white">Enrollment Checklist <br> <span
                                class=" textGradient">Admissions Criteria</span></h2>

                        <div class="threeCards">
                            <div class="gridCard">
                                <img class="mob-hide"
                                    src="https://images.mastersunion.link/brochures/20092025/v1/admissionCard1.webp"
                                    alt="MU Students Admission">
                                <img class="mob-visible"
                                    src="https://images.mastersunion.link/brochures/20092025/v1/admissionCard1.webp"
                                    alt="MU Students Admission">

                                <img class="gridCardBlack"
                                    src="https://images.mastersunion.link/uploads/16062025/v1/Overlay.webp" alt="Image">

                                <p class="enrollOverlay">
                                    <span class="overlayNumber font-white">01.</span><br class="mob-hide">
                                    <span class="overlayText font-white">Academic Background</span>
                                </p>

                                <div class="onhoverOverlay">

                                    <p class="">
                                        <span class="overlayNumber font-white">01.</span><br>
                                        <span class="overlayText font-white">Academic Background</span>
                                    </p>

                                    <p class=" overlayNumber overlayMob">
                                        We welcome candidates from diverse educational backgrounds. Whether you've
                                        completed
                                        formal education or have gained knowledge through experience, we value a strong
                                        passion for learning and personal growth.
                                    </p>
                                </div>
                            </div>

                            <div class="gridCard">
                                <img class="mob-hide"
                                    src="https://images.mastersunion.link/brochures/20092025/v1/admissionCard2.webp"
                                    alt="Students Entertainment & Fun">
                                <img class="mob-visible"
                                    src="https://images.mastersunion.link/brochures/20092025/v1/admissionCard2.webp"
                                    alt="Students Entertainment & Fun">

                                <img class="gridCardBlack"
                                    src="https://images.mastersunion.link/uploads/16062025/v1/Overlay.webp" alt="Image">

                                <p class="enrollOverlay">
                                    <span class="overlayNumber font-white">02.</span><br class="mob-hide">
                                    <span class="overlayText font-white">Intent to Explore & Engage</span>
                                </p>

                                <div class="onhoverOverlay">

                                    <p class="">
                                        <span class="overlayNumber font-white">02.</span><br>
                                        <span class="overlayText font-white">Intent to Explore & Engage</span>
                                    </p>

                                    <p class=" overlayNumber overlayMob">
                                        Applicants should demonstrate curiosity about how India works — across
                                        industries,
                                        regions, and cultures. This could be shown through past travel, initiatives,
                                        internships, family business exposure, or even questions they ask.

                                    </p>
                                </div>
                            </div>

                            <div class="gridCard">
                                <img class="mob-hide"
                                    src="https://images.mastersunion.link/brochures/20092025/v1/admissionCard3.webp"
                                    alt="Students Entertainment & Fun">
                                <img class="mob-visible"
                                    src="https://images.mastersunion.link/brochures/20092025/v1/admissionCard3.webp"
                                    alt="Students Entertainment & Fun">

                                <img class="gridCardBlack"
                                    src="https://images.mastersunion.link/uploads/16062025/v1/Overlay.webp" alt="Image">

                                <p class="enrollOverlay">
                                    <span class="overlayNumber font-white">03.</span><br class="mob-hide">
                                    <span class="overlayText font-white">Ability to Learn by Doing</span>
                                </p>

                                <div class="onhoverOverlay">

                                    <p class="">
                                        <span class="overlayNumber font-white">03.</span><br>
                                        <span class="overlayText font-white">Ability to Learn by Doing</span>
                                    </p>

                                    <p class=" overlayNumber overlayMob">This is not a passive program. Applicants must
                                        show
                                        readiness to take initiative, solve real-world problems, and work in diverse,
                                        on-ground environments — even with limited structure.</p>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>

            <section class="threeCardSection">
                <div class="container">
                    <div class="threeCardWrapper">
                        <div class="threeCardHeadingWrapper">
                            <h2 class="threeCardHeading">Who Should Apply?</h2>
                            <p class="threeCardSubHeading">This programme is for people who learn best by travelling and
                                doing. You must be able to commit 2 months <br class="mob-hide"> of travel across India
                                and
                                4 months of weekend hybrid classes. Explore the profiles below to find your fit.
                            </p>
                        </div>
                        <div class="cardsWrapper">
                            <div class="threeCardCover tintNeutral">
                                <div class="threeCardGradinetBg"></div>
                                <div class="threeCardGrainEffect"></div>
                                <div class="shadeEffect bgTitanium"></div>
                                <div class="threeCard">
                                    <div class="logo">
                                        <img src="https://images.mastersunion.link/uploads/01102025/v1/logo1.svg"
                                            alt="" />
                                    </div>
                                    <h2 class="threeCardContentHeading">Students & Young Professionals </h2>
                                    <p class="threeCardContentSubheading">Final-year students, recent graduates, and
                                        early
                                        career
                                        professionals (0–2 years of experience) eager to step into the real world of
                                        business
                                        through immersive journeys.
                                    </p>
                                </div>
                            </div>

                            <div class="threeCardCover tintBronze">

                                <div class="threeCardGrainEffect  "></div>
                                <div class="bgGradientShade"></div>
                                <div class="threeCardGradinetBg "></div>
                                <div class="shadeEffect bgBronze "></div>
                                <div class="threeCard">
                                    <div class="logo">
                                        <img src="https://images.mastersunion.link/uploads/01102025/v1/logo2.svg"
                                            alt="" />
                                    </div>
                                    <h2 class="threeCardContentHeading">Experienced Professionals </h2>
                                    <p class="threeCardContentSubheading">Mid and senior-level professionals looking to
                                        gain
                                        a fresh
                                        perspective on India’s dynamic industries and broaden their leadership outlook.
                                    </p>
                                </div>
                            </div>

                            <div class="threeCardCover tintBlue">
                                <div class="threeCardGradinetBg"></div>
                                <div class="threeCardGrainEffect"></div>
                                <div class="shadeEffect bgSilver"></div>
                                <div class="threeCard">
                                    <div class="logo">
                                        <img src="https://images.mastersunion.link/uploads/01102025/v1/logo3.svg"
                                            alt="" />
                                    </div>
                                    <h2 class="threeCardContentHeading">Entrepreneurs & Creators </h2>
                                    <p class="threeCardContentSubheading">
                                        Individuals with the vision to build or scale, startups or content-led brands,
                                        seeking
                                        inspiration, insight, and networks from Bharat’s diverse business and cultural
                                        landscape.
                                    </p>
                                </div>
                            </div>

                            <div class="threeCardCover tintGold">
                                <div class="threeCardGrainEffect  "></div>
                                <div class="bgGradientShade"></div>
                                <div class="threeCardGradinetBg "></div>
                                <div class="shadeEffect bgBronze "></div>
                                <div class="threeCard">
                                    <div class="logo">
                                        <img src="https://images.mastersunion.link/uploads/01102025/v1/logo4.svg"
                                            alt="" />
                                    </div>
                                    <h2 class="threeCardContentHeading">Family Business (All Generations) </h2>
                                    <p class="threeCardContentSubheading">Owners, successors and key contributors in
                                        family-run
                                        enterprises of any age seeking real-world exposure.
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>

