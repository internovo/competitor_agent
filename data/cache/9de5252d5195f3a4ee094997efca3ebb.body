                            <script>
                                $(document).ready(function () {
                                    let isVisible = false;
                            
                                    $('.exploreBtn').click(function (e) {
                                        e.stopPropagation();
                            
                                        if (!isVisible) {
                                            $('.cityWrapper').css({
                                                display: 'block',
                                                opacity: 0
                                            }).animate({
                                                opacity: 1
                                            }, 300);
                                            isVisible = true;
                                        } else {
                                            $('.cityWrapper').animate({
                                                opacity: 0
                                            }, 300, function () {
                                                $(this).css('display', 'none');
                                            });
                                            isVisible = false;
                                        }
                                    });
                            
                                    $(document).click(function () {
                                        if (isVisible) {
                                            $('.cityWrapper').animate({
                                                opacity: 0
                                            }, 300, function () {
                                                $(this).css('display', 'none');
                                                isVisible = false;
                                            });
                                        }
                                    });
                            
                                    $('.cityWrapper').click(function (e) {
                                        e.stopPropagation();
                                    });
                            
                                    $('.exploreBtn').on('click', function () {
                                        $(this).find('.dropdownIcon').toggleClass('rotated');
                                    });
                            
                                    $(".toCohortBox").click(function () {
                                        scrollTab($(this))
                                        let id = $(this).attr('data-rel')
                                        $('#classprofile-menu').addClass('active').siblings().removeClass('active');
                                        $(`#${id}`).addClass('active').siblings().removeClass('active');
                                    });
                                });
                            </script>
                            
                            <script>
                                $(document).ready(function () {
                                    let searchCity = $('#citySearch').val();
                            
                                    const states = [
                                        "All",
                                        "Assam",
                                        "Bihar",
                                        "Chhattisgarh",
                                        "Delhi NCR",
                                        "Gujarat",
                                        "Haryana (excluding Gurugram & Faridabad)",
                                        "Jammu & Kashmir",
                                        "Jharkhand",
                                        "Karnataka",
                                        "Kerala",
                                        "Madhya Pradesh",
                                        "Maharashtra",
                                        "Odisha",
                                        "Punjab",
                                        "Rajasthan",
                                        "Tamil Nadu",
                                        "Telangana",
                                        "Uttar Pradesh (excluding Noida & Ghaziabad)",
                                        "Uttarakhand",
                                        "West Bengal",
                                        "International"
                                    ];
                            
                            
                                    const container = document.getElementById("cityContainer");
                                    const searchInput = document.getElementById('citySearch');
                            
                                    function renderStates(searchValue) {
                                        container.innerHTML = '';
                                        const filteredStates = states.filter(state => state.toLowerCase().includes(searchValue.toLowerCase()));
                            
                                        if (filteredStates.length === 0) {
                                            const noState = document.createElement("p");
                                            noState.textContent = "No State Found"
                                            noState.className = "stateDivi";
                                            container.appendChild(noState)
                                        }
                                        else {
                                            filteredStates.forEach(state => {
                                                const stateDiv = document.createElement("div");
                                                stateDiv.className = "stateDivi";
                                                stateDiv.textContent = state;
                                                stateDiv.onclick = () => handleStateClick(state);
                                                container.appendChild(stateDiv);
                                            });
                                        }
                                    }
                            
                                    searchInput.addEventListener('input', function () {
                                        const searchValue = searchInput.value;
                                        renderStates(searchValue);
                                    });
                            
                                    function handleStateClick(currState) {
                                        let displayState = currState;
                            
                                        if (displayState === "Haryana (excluding Gurugram & Faridabad)") displayState = "Haryana";
                                        if (displayState === "Uttar Pradesh (excluding Noida & Ghaziabad)") displayState = "Uttar Pradesh";
                            
                                        if (displayState === "All") {
                                            state = "";
                                        } else {
                                            state = encodeURIComponent(displayState);
                                        }
                            
                                        $('.exploreBtn').html(`
                                  ${displayState}
                                  <svg xmlns="https://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
                                    <path d="M6.49153 10.4237L10.4359 14.3681C10.5667 14.4988 10.744 14.5722 10.9289 14.5722C11.1139 14.5722 11.2912 14.4988 11.422 14.3681L15.3663 10.4237C15.4971 10.2929 15.5705 10.1156 15.5705 9.93066C15.5705 9.74574 15.4971 9.56838 15.3663 9.43762C15.2356 9.30686 15.0582 9.23347 14.8733 9.23347C14.6884 9.23347 14.511 9.30686 14.3802 9.43762L11.6261 12.1917L10.9289 12.8889L10.2317 12.1917L7.47762 9.43762C7.34686 9.30686 7.1695 9.23347 6.98458 9.23347C6.79965 9.23347 6.6223 9.30686 6.49153 9.43762C6.36077 9.56838 6.28738 9.74574 6.28738 9.93066C6.28738 10.1156 6.36077 10.2929 6.49153 10.4237Z" fill="#090909"/>
                                  </svg>
                              `);
                            
                                        function resetPaginationForActiveCohort() {
                                            if (CURRENT_COHORT === "class2027") {
                                                hasClickedLoadMore = false;
                                                totalPages = 2;
                                                isDataFetching = false;
                                                loadMoreBtn.dataset.page = 1;
                                                loadMoreBtn.classList.remove("hide");
                                                $("#UGProfiles").empty();
                                                showCohortProfile(1);
                                            }
                            
