    </div>

    <style>
        .boxBreather {

            .boxContainerMainWrapper {
                position: relative;
                width: 100%;
                border-radius: 16px;
                padding: 1px;
                /* clips the spinner below to the rounded box; the opaque panel then
                   hides everything except the 1px ring */
                overflow: hidden;
                isolation: isolate;
            }

            /* the travelling line: a static conic gradient on a square that simply
               spins. transform animates on the compositor, so it stays smooth --
               animating the gradient's angle instead repaints the whole box each
               frame and visibly stutters. */
            .boxContainerMainWrapper::before {
                content: "";
                position: absolute;
                top: 50%;
                left: 50%;
                /* square must stay bigger than the box diagonal at every angle;
                   on desktop the box is wide, so drive it off the width */
                width: 170%;
                aspect-ratio: 1;
                background: conic-gradient(from 0deg at 50% 50%,
                        rgba(65, 195, 206, 0) 0deg,
                        rgba(65, 195, 206, 0) 232deg,
                        rgba(60, 165, 134, .35) 268deg,
                        rgba(60, 165, 134, .8) 300deg,
                        #41C3CE 330deg,
                        rgba(65, 195, 206, .55) 344deg,
                        rgba(65, 195, 206, 0) 360deg);
                animation: boxBreatherBorderTravel 6s linear infinite;
                will-change: transform;
                z-index: 0;
            }

            .boxContainerMainWrapper .boxContainer {
                position: relative;
                z-index: 9;
                /* Figma fill is rgba(27,27,27,.63) + 19.1px backdrop blur over the
                   #090909 section; flattened here so the spinner underneath does not
                   bleed through a translucent panel. */
                background: rgb(20, 20, 20);
                backdrop-filter: none;
                border: none;
                border-radius: 15px;
            }

            @media (max-width: 768px) {

                /* stacked box is taller than it is wide -- drive the square off the height */
                .boxContainerMainWrapper::before {
                    width: auto;
                    height: 170%;
                }
            }
        }

        @keyframes boxBreatherBorderTravel {
            from {
                transform: translate(-50%, -50%) rotate(0turn);
            }

            to {
                transform: translate(-50%, -50%) rotate(1turn);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .boxBreather .boxContainerMainWrapper::before {
                animation: none;
            }
        }
    </style>
</section>

