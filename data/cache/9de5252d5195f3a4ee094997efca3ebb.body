                <style>
                    .page-wrapper {
                        max-width: 1240px;
                        width: 100%;
                        padding: 16px 0;
                        position: relative;
                    }

                    .imageBoxi img {
                        transition: opacity 0.3s ease;
                    }

                    /* Holds the hover video, so the card's rounded top corners have to be applied
                   here rather than to the media itself. The -webkit-mask is what makes Safari
                   actually clip the iframe to the radius. */
                    .imageRegion {
                        position: relative;
                        overflow: hidden;
                        border-radius: 12px 12px 0 0;
                        -webkit-mask-image: -webkit-radial-gradient(white, black);

                    }

                    /* The player covers the thumbnail's footprint exactly. YouTube fits the clip
                   inside that box itself, so the whole video stays visible - never cropped. */
                    .imageRegion iframe {
                        position: absolute;
                        inset: 0;
                        width: 100%;
                        height: 100%;
                        border: 0;
                        opacity: 0;
                        transition: opacity 0.3s ease;
                    }

                    /* Showing the clip is pure CSS, so DevTools' "force :hover" reveals it too.
                   video-ready lands once the embed has loaded; is-playing is the tap state. */
                    .imageRegion.video-ready:hover iframe,
                    .imageRegion.video-ready.is-playing iframe {
                        opacity: 1;
                    }

                    .imageRegion.video-ready:hover img,
                    .imageRegion.video-ready.is-playing img {
                        opacity: 0;
                    }



                    /* Wrapper + scroll buttons */
                    .scroll-container {
                        display: flex;
                        align-items: center;
                        position: relative;
                    }

                    .scroll-btn.left {
                        left: 0;
                        opacity: 0.6;
                        transform: rotate(180deg);
                    }

                    .scroll-btn {
                        background: transparent;
                        position: absolute;
                        top: 40%;
                        z-index: 999;
                    }

                    .scroll-btn.right {
                        right: 0;
                        opacity: 0.6;
                    }

                    .scroll-btn.right.active,
                    .scroll-btn.left.active {
                        opacity: 1;
                    }

                    .pgpIndiaSwiper-Prev.swiper-button-disabled,
                    .pgpIndiaSwiper-Next.swiper-button-disabled {
                        opacity: 0.6;
                    }

                    .pgpIndiaSwiper-Prev:not(.swiper-button-disabled),
                    .pgpIndiaSwiper-Next:not(.swiper-button-disabled) {
                        opacity: 1;
                    }

                    /* Main horizontal wrapper */
                    .stateContentWrapper {
                        display: flex;
                        overflow-x: auto;
                        scroll-behavior: smooth;
                        width: 1235px;
                        gap: 20px;
                        /*border-bottom: 1px solid var(--grey3);                                                                           
                    padding-bottom: 40px;*/
                    }

                    .stateContent {
                        display: flex;
                        flex-direction: column;
                        gap: 20px;
                        width: fit-content;
                        /* dynamic width based on cards */
                        flex-shrink: 0;
                    }

                    /* Cards container */
                    .cardsContainer {
                        display: flex;
                        gap: 24px;
                        overflow-x: auto;
                        scroll-behavior: smooth;
                        box-sizing: border-box;
                    }
                </style>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const tabs = document.querySelectorAll(".getpreppedTabs li");
                        const container = document.getElementById("horizontalContainer");
                        const leftBtn = document.querySelector(".scroll-btn.left");
                        const rightBtn = document.querySelector(".scroll-btn.right");
                        const sections = document.querySelectorAll(".stateContent");

                        if (!tabs.length || !container || !leftBtn || !rightBtn) return;

                        let isProgrammaticScroll = false;
                        let scrollEndTimer;

                        function getSectionScrollLeft(section) {
                            return section.offsetLeft - container.offsetLeft;
                        }

                        function updateScrollButtons() {
                            leftBtn.classList.toggle("active", container.scrollLeft > 0);
                            rightBtn.classList.toggle(
                                "active",
                                Math.ceil(container.scrollLeft + container.clientWidth) < container.scrollWidth
                            );
                        }

                        function scrollToSection(sectionId) {
                            const target = document.getElementById(sectionId);
                            if (!target) return;

                            isProgrammaticScroll = true; // disable scroll listener
                            container.scrollTo({ left: getSectionScrollLeft(target), behavior: "smooth" });

                            const cardsContainer = target.querySelector(".cardsContainer");
                            if (cardsContainer) cardsContainer.scrollTo({ left: 0, behavior: "smooth" });

                            // Scroll end detection - wait until scrolling stops
                            clearTimeout(scrollEndTimer);
                            scrollEndTimer = setTimeout(() => {
                                isProgrammaticScroll = false; // enable scroll listener again
                                updateScrollButtons();
                            }, 300); // will reset if scroll keeps happening
                        }

                        tabs.forEach(tab => {
                            tab.addEventListener("click", function () {
                                tabs.forEach(t => t.classList.remove("active"));
                                tab.classList.add("active");
                                scrollToSection(tab.dataset.rel);
                            });
                        });

                        leftBtn.addEventListener("click", function () {
                            container.scrollBy({ left: -550, behavior: "smooth" });
                            setTimeout(updateScrollButtons, 250);
                        });

                        rightBtn.addEventListener("click", function () {
                            container.scrollBy({ left: 550, behavior: "smooth" });
                            setTimeout(updateScrollButtons, 250);
                        });

                        container.addEventListener("scroll", function () {
                            if (isProgrammaticScroll) {
                                // reset scrollEndTimer every time scroll fires
                                clearTimeout(scrollEndTimer);
                                scrollEndTimer = setTimeout(() => {
                                    isProgrammaticScroll = false; // enable scroll listener after scroll really ends
                                    updateScrollButtons();
                                }, 150); // wait until no scroll for 150ms
                                return;
                            }

                            let scrollLeft = container.scrollLeft;
                            let activeSection = null;

                            sections.forEach(section => {
                                const sectionLeft = getSectionScrollLeft(section);
                                // Modified logic: Change tab when scrolling left and reaching 50px from left edge
                                if (scrollLeft >= sectionLeft - 150) {
                                    activeSection = section;
                                }
                            });

                            if (activeSection) {
                                tabs.forEach(t => t.classList.remove("active"));
                                const activeTab = document.querySelector(`.getpreppedTabs li[data-rel="${activeSection.id}"]`);
                                if (activeTab) {
                                    activeTab.classList.add("active");
                                    // Center the newly active tab in viewport on mobile
                                    if (window.innerWidth <= 767) {
                                        activeTab.scrollIntoView({
                                            behavior: "smooth",
                                            inline: "center",
                                            block: "nearest"
                                        });
                                    }
                                }
                            }

                            updateScrollButtons();
                        });

                        let initialTab = document.querySelector(".getpreppedTabs li.active");
                        if (initialTab) {
                            scrollToSection(initialTab.dataset.rel);
                        } else if (tabs.length) {
                            tabs[0].classList.add("active");
                            scrollToSection(tabs[0].dataset.rel);
                        } else {
                            updateScrollButtons();
                        }

                        window.addEventListener("resize", function () {
                            let activeTab = document.querySelector(".getpreppedTabs li.active");
                            if (activeTab) scrollToSection(activeTab.dataset.rel);
                        });
                    });
                </script>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        if (window.innerWidth > 767) return; // Only run on mobile

                        const tabs = document.querySelectorAll('.getpreppedTabs li');
                        const container = document.querySelector('.getpreppedTabs');

                        function scrollActiveIntoView(tab) {
                            // Smoothly scroll active tab into view (centered)
                            tab.scrollIntoView({
                                behavior: "smooth",
                                inline: "center",
                                block: "nearest"
                            });
                        }

                        function centerActiveTab() {
                            // Always center the active tab in viewport
                            const activeTab = document.querySelector('.getpreppedTabs li.active');
                            if (activeTab) {
                                scrollActiveIntoView(activeTab);
                            }
                        }

                        // On click make tab active + scroll it into view
                        tabs.forEach(tab => {
                            tab.addEventListener('click', (e) => {
                                e.preventDefault();
                                e.stopPropagation();

                                // Remove active from all tabs
                                tabs.forEach(t => t.classList.remove('active'));
                                // Add active to clicked tab
                                tab.classList.add('active');

                                // Immediately scroll clicked tab into view
                                scrollActiveIntoView(tab);
                            });
                        });

                        // Watch for scroll events to keep active tab centered
                        let scrollDebounce = null;
                        window.addEventListener('scroll', () => {
                            if (scrollDebounce) clearTimeout(scrollDebounce);

                            scrollDebounce = setTimeout(() => {
                                // Always center the active tab when tabs section is visible
                                if (container) {
                                    const rect = container.getBoundingClientRect();
                                    // Center tab if tabs section is in viewport (even partially)
                                    if (rect.top < window.innerHeight && rect.bottom > 0) {
                                        centerActiveTab();
                                    }
                                }
                            }, 100);
                        });
                    });
                </script>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const hovers = document.querySelectorAll(".videoHover");

                        // Phones have no hover, so a tap plays the clip there and tapping another
                        // card stops the one already running.
                        const isTouch = window.matchMedia("(hover: none)").matches;
                        const cards = [];

                        hovers.forEach(el => {
                            const id = el.dataset.videoId;
                            const box = el.querySelector(".imageBoxi");
                            const hoverArea = el.querySelector(".imageRegion") || box;
                            let iframe, overlay;

                            // Built on the first hover only - 40-odd embeds at page load would be
                            // far too heavy - and then kept in the DOM, so it stays inspectable and
                            // the CSS above can show or hide it without a reload each time.
                            function createIframe() {
                                if (iframe) return;

                                // YouTube embed with NO UI. enablejsapi lets us pause it on leave.
                                const src = `https://www.youtube.com/embed/${id}?autoplay=1&mute=1&loop=1&playlist=${id}&controls=0&modestbranding=1&iv_load_policy=3&rel=0&fs=0&cc_load_policy=0&disablekb=1&enablejsapi=1`;

                                // Ensure the image region is positioned for absolute children
                                hoverArea.style.position = "relative";
                                hoverArea.style.overflow = "hidden";

                                // Create iframe
                                iframe = document.createElement("iframe");
                                iframe.src = src;
                                iframe.allow = "autoplay; fullscreen";
                                iframe.setAttribute("frameborder", "0");
                                iframe.style.zIndex = "0"; // stays behind overlay & content
                                iframe.style.pointerEvents = "none";

                                // Create black overlay
                                overlay = document.createElement("div");
                                overlay.style.position = "absolute";
                                overlay.style.inset = "0";
                                // overlay.style.background = "rgba(0, 0, 0, 0.45)"; // dark overlay
                                overlay.style.zIndex = "1"; // sits above iframe but under content
                                overlay.style.pointerEvents = "none";

                                // only then does the CSS swap the thumbnail out for the player
                                iframe.addEventListener("load", () => {
                                    hoverArea.classList.add("video-ready");
                                });

                                // Insert in correct order: iframe -> overlay -> existing content
                                hoverArea.insertBefore(iframe, hoverArea.firstChild);
                                hoverArea.insertBefore(overlay, hoverArea.firstChild.nextSibling);
                            }

                            function command(func) {
                                if (!iframe || !iframe.contentWindow) return;
                                iframe.contentWindow.postMessage(
                                    JSON.stringify({ event: "command", func: func, args: [] }),
                                    "*"
                                );
                            }

                            function play() {
                                if (!iframe) {
                                    createIframe(); // autoplay=1 covers the first run
                                    return;
                                }
                                command("playVideo");
                            }

                            function stop() {
                                hoverArea.classList.remove("is-playing");
                                command("pauseVideo");
                            }

                            if (isTouch) {
                                hoverArea.addEventListener("click", function () {
                                    if (hoverArea.classList.contains("is-playing")) {
                                        stop();
                                        return;
                                    }
                                    cards.forEach(other => other());
                                    hoverArea.classList.add("is-playing");
                                    play();
                                });
                            } else {
                                hoverArea.addEventListener("mouseenter", play);
                                hoverArea.addEventListener("mouseleave", stop);
                            }

                            cards.push(stop);
                        });
                    });
                </script>
            </section>

            <section class="weeklySection ">
                <div class="container">
                    <div class="weeklyWrapper">
                        <div class="weeklyHeadingWrapper">
                            <h2 class="go-BreatherHeading font-white">What your <br>
                                <span class="font-semibold">Week will look like</span>
                            </h2>

                            <p class="weeklyPara"> Immersion weeks blend learning, projects, networking and reflection.
                            </p>
                        </div>


                        <div class="weeklyImageWrapper">
                            <img src="https://files.mastersunion.link/1240%20(1).png" alt="PGP Bharat weeks Workshop">
                        </div>
                    </div>
