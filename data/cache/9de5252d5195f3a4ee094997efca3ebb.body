                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        const trigger = document.getElementById("dropdownTrigger");
                        const list = document.getElementById("dropdownOptions");
                        const arrow = document.querySelector(".arrowReport"); // 👈 target the arrow

                        // Toggle dropdown on button click
                        trigger.addEventListener("click", () => {
                            const isOpen = list.style.display === "block";
                            list.style.display = isOpen ? "none" : "block";
                            arrow.classList.toggle("rotate", !isOpen); // 👈 rotate arrow
                        });

                        // Handle option click
                        list.addEventListener("click", (e) => {
                            if (e.target.tagName === "LI") {
                                const year = e.target.getAttribute("data-year");
                                let url = "";

                                if (year === "2027") {
                                    url = "https://files.mastersunion.link/brochures/21012025/v1/MeetUGClassof2027.pdf";
                                } else if (year === "2028") {
                                    url = "https://files.mastersunion.link/brochures/03042025/v1/UGClassof2028Report.pdf";
                                } else if (year === "2029") {
                                    url = "https://files.mastersunion.link/brochures/UGClassof2029Report.pdf";
                                }

                                list.style.display = "none";
                                arrow.classList.remove("rotate"); // 👈 reset rotation

                                if (url) {
                                    window.open(url, "_blank");
                                }
                            }
                        });

                        // Close dropdown if clicking outside
                        document.addEventListener("click", function (e) {
                            if (!e.target.closest(".customDropdownWrapper")) {
                                list.style.display = "none";
                                arrow.classList.remove("rotate"); // 👈 reset rotation
                            }
                        });
                    });
                </script>
            </section>

            <section class="insideCohort">
                <div class="container">
                    <div class="insideCohortWrap">
                        <div class="insideCohortHead">
                            <div class="insideCohortHeadLeft">
                                <h2 class="insideCohortTitle">Inside the Cohort</h2>
                                <p class="insideCohortSubTxt">Every PGP Bharat cohort brings together learners from
                                    diverse geographies, industries and experiences creating a classroom that's as
                                    varied
                                    as the country itself.</p>
                            </div>

                            <ul class="cohortPillList faqtabs">
                                <li class="cohortPill active" data-rel="cohortDataOne">Cohort 1</li>
                                <li class="cohortPill" data-rel="cohortDataTwo">Cohort 2</li>
                            </ul>
                        </div>

                        <div class="cohortData active" id="cohortDataOne">
                            <ul class="cohortTabList faqtabs">
                                <li class="cohortTab active" data-rel="cohortCityPanel">City</li>
                                <li class="cohortTab" data-rel="cohortAcademicPanel">Academic Background</li>
                                <li class="cohortTab" data-rel="cohortInstitutePanel">Institutes Represented</li>
                                <li class="cohortTab" data-rel="cohortProfilePanel">Professional Profile</li>
                                <li class="cohortTab" data-rel="cohortExperiencePanel">Work Experience</li>
                                <li class="cohortTab" data-rel="cohortDomainPanel">Domains</li>
                            </ul>

                            <div class="cohortPanelWrap">
                                <div class="cohortPanel active" id="cohortCityPanel">
                                    <div class="cohortPanelLeft">
                                        <img class="cohortMapImg" width="359" height="400"
                                            src="https://images.mastersunion.link/uploads/02092026/v1/Frame2055246418.svg"
                                            alt="Map of India highlighting the cities PGP Bharat learners come from">

                                        <span class="cohortDivider"></span>

                                        <div class="cohortCompassBox">
                                            <div class="cohortCompass">
                                                <img src="https://images.mastersunion.link/uploads/24082026/v1/Frame20552462532.webp"
                                                    alt="Class Diversity">

                                                <p class="cohortCompassNote"><strong>10% Learners</strong> are coming
                                                    from central india</p>
                                            </div>
                                        </div>
                                    </div>

                                    <span class="cohortDivider"></span>

                                    <div class="cohortDiversity">
                                        <p class="cohortDiversityTitle">Class Diversity</p>

                                        <ul class="cohortDiversityList">
                                            <li class="cohortDiversityItem">
                                                <p class="cohortDiversityValue">27+</p>
                                                <p class="cohortDiversityLabel">Cities</p>
                                            </li>
                                            <li class="cohortDiversityItem">
                                                <p class="cohortDiversityValue">13+</p>
                                                <p class="cohortDiversityLabel">States</p>
                                            </li>
                                            <li class="cohortDiversityItem">
                                                <p class="cohortDiversityValue">29%</p>
                                                <p class="cohortDiversityLabel">Female Students</p>
                                            </li>
                                            <li class="cohortDiversityItem">
                                                <p class="cohortDiversityValue">24</p>
                                                <p class="cohortDiversityLabel">Average age</p>
                                            </li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="cohortPanel" id="cohortAcademicPanel">
                                    <div class="cohortAcademic">
                                        <div class="cohortAcademicGrid">
                                            <div class="cohortAcademicCol">
                                                <div class="cohortStat">
                                                    <div class="cohortStatHead">
                                                        <p class="cohortStatName">Management</p>
                                                        <p class="cohortStatValue">40%</p>
                                                    </div>
                                                    <div class="cohortStatTrack">
                                                        <span class="cohortStatFill" style="width: 100%;"></span>
                                                    </div>
                                                </div>

                                                <div class="cohortStat">
                                                    <div class="cohortStatHead">
                                                        <p class="cohortStatName">Engineering</p>
                                                        <p class="cohortStatValue">18%</p>
                                                    </div>
                                                    <div class="cohortStatTrack">
                                                        <span class="cohortStatFill" style="width: 21.88%;"></span>
                                                    </div>
                                                </div>

                                                <div class="cohortStat">
