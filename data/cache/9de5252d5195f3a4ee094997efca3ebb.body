    <script>
      (function () {
        function normalise(value) {
          value = (value || '')
            .split('?')[0]
            .split('#')[0]
            .replace(/^\/+|\/+$/g, '')
            .toLowerCase();

          return value ? '/' + value : '';
        }

        function currentUrl() {
          return normalise(location.pathname) || '/';
        }

        var here = currentUrl();

        // Every Bharat page carries the same <div id="toTop3"> just above the tab
        // panels, so an in-place switch and a real page load can both settle there.
        var ANCHOR_ID = 'toTop3';

        function anchorTop() {
          var target = document.getElementById(ANCHOR_ID);
          if (!target) return null;

          // The sub-nav sticks to the top and would otherwise cover the anchor.
          var nav = document.getElementById('stickyHeader');
          var offset = nav && nav.offsetHeight ? nav.offsetHeight : 80;

          return Math.max(0, target.getBoundingClientRect().top + window.pageYOffset - offset);
        }

        function scrollToAnchor(behavior) {
          var top = anchorTop();
          if (top === null) return false;

          window.scrollTo({ top: top, behavior: behavior || 'smooth' });
          return true;
        }

        // Explore tags
        document.querySelectorAll('.exploreLeftTag').forEach(function (tag) {
          var url = normalise(tag.dataset.url);
          var rel = tag.dataset.rel;

          if (!url) return;

          tag.classList.toggle('active', url === here);

          tag.addEventListener('click', function () {
            var navTab = document.querySelector('.seondtabs li[data-rel="' + rel + '"]');

            // The sub-nav tab already owns a switch end to end - swap the panel,
            // push the URL, settle the page on #toTop3 - so hand the click over
            // instead of running a second, slightly different copy of that here.
            // An explore tag and its sub-nav twin then land on exactly the same
            // spot, including when the tag for the tab already open is tapped.
            if (rel && navTab && document.getElementById(rel) && window.jQuery) {
              window.jQuery(navTab).trigger('click');
              return;
            }

            // Same page, no panel to switch: just take the reader to the tab.
            if (url === currentUrl()) {
              scrollToAnchor('smooth');
              return;
            }

            // Real page load - carry the anchor across so the next page stops
            // on its own #toTop3 instead of opening at the very top.
            location.href = url + '#' + ANCHOR_ID;
          });
        });

        // Landing here with #toTop3 (a cross-page tab jump, or a shared deep link):
        // the browser's native jump ignores the sticky sub-nav and fires before the
        // images settle, so re-seat the page on the anchor once everything is laid out.
        if (location.hash === '#' + ANCHOR_ID) {
          var settleAnchor = function () {
            window.requestAnimationFrame(function () {
              scrollToAnchor('auto');
            });
          };

          if (document.readyState === 'complete') {
            settleAnchor();
          } else {
            window.addEventListener('load', settleAnchor);
          }
        }

        // Sub-nav active state
        document.querySelectorAll('.bharatSubNav .seondtabs .list').forEach(function (item) {
          var url = normalise(item.dataset.url);

          if (url) {
            item.classList.toggle('active', url === here);
          }
        });
      })();
    </script>

   
    <script>
      (function () {
        // Same shape as the sub-nav helper above: strip query, hash and stray slashes
        // so '/pgp-bharat-...-curriculum' and 'pgp-bharat-...-curriculum' compare equal.
        function normalisePath(value) {
          value = (value || '')
            .split('?')[0]
            .split('#')[0]
            .replace(/^\/+|\/+$/g, '')
            .toLowerCase();

          return value ? '/' + value : '';
        }

        // The sub-nav tab whose data-url matches this path, or null for anything else.
        function tabFor(path) {
          var match = null;

          document.querySelectorAll('.bharatSubNav .seondtabs .list').forEach(function (item) {
            if (!match && normalisePath(item.dataset.url) === path) match = item;
          });

          return match;
        }

        // Delegated, so buttons rendered later (sliders, accordions) are covered too.
        document.addEventListener('click', function (e) {
          // Leave modified clicks alone - ctrl/cmd/shift opens a new tab or window.
          if (e.defaultPrevented || e.button !== 0) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

          var link = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!link) return;

          // Global navigation keeps its full page load.
          if (link.closest('header.topHeader') || link.closest('.mobileMenu')) return;

          var href = link.getAttribute('href') || '';
          if (href.charAt(0) === '#') return;                 // same-page anchor
          if (link.target && link.target !== '_self') return; // opens somewhere else
          if (link.hasAttribute('download')) return;
          if (link.protocol !== 'http:' && link.protocol !== 'https:') return; // mailto:, tel:
          if (link.host !== location.host) return;            // off-site

          var navTab = tabFor(normalisePath(link.pathname));
          if (!navTab) return; // not a tab URL - let the browser navigate

          // Panel missing, or jQuery not up yet: a real page load is the safe answer.
          var rel = navTab.dataset.rel;
          if (!rel || !document.getElementById(rel) || !window.jQuery) return;

          e.preventDefault();
          window.jQuery(navTab).trigger('click');
        });
      })();
    </script>

