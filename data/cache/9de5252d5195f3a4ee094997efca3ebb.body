            <section class="immersionDeckSection mob-hide" id="immersionDeckSection">
                <div class="immersionDeckContainer">
                    <div class="immersionDeckScrollWrapper">
                        <div class="immersionDeckSticky">
                            <div class="container">
                                <div class="immersionDeckLayout">

                                    <div class="immersionDeckHeader">
                                        <div class="immersionDeckHeadingLeft">
                                            A <span class="font-semibold">Day</span> in the Immersion
                                        </div>
                                        <div class="immersionDeckHeadingRight">
                                            Additionally, the Major Immersions will feature One-Day Consultancy
                                            Challenges.
