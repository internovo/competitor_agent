            <section class="feeProcess bg-white" id="scrollableSection">
                <div class="container">

                    <div id="growingDiv" style="height: 0px; display: none;"></div>

                    <div class="feeProcessContainer">
                        <div class="leftSection">
                            <div class="listItem">
                                <p class="number">01.</p>
                                <p class="go-BreatherHeading">Complete the <span class="font-semibold "><br>Application
                                    </span>
                                </p>
                            </div>
                        </div>
                        <div class="rightSection">
                            <img src="https://images.mastersunion.link/uploads/15072025/v1/Frame1321318040.svg"
                                class="procedureImg" alt="">
                            <img src="https://images.mastersunion.link/uploads/15072025/v1/Frame1321317786.svg"
                                class="procedureImgGrad" alt="">
                            <div class="feeSectionMOb">
                                <div class="mobHeader">
                                    <p class="number">01.</p>
                                    <p class="go-BreatherHeading">Complete the <br><span
                                            class="font-semibold ">Application
                                        </span>
                                    </p>
                                </div>
                                <div class="body">

                                    <div class="feeBox">
                                        <div class="header hide">
                                            <p>Requirements</p>
                                        </div>
                                        <div class="body">
                                            <div class="detailsList">
                                                <p class="subHeading">Applicants will need to fill out and submit an
                                                    online
                                                    application to be considered for the programme.<br>
                                                    Here are the requirements:
                                                </p>
                                                <ul class="list mt15">
                                                    <li>
                                                        <p>Personal Details</p>
                                                    </li>
                                                    <li>
                                                        <p>Professional Details </p>
                                                    </li>

                                                    <li>
                                                        <p>Programme Related Details </p>
                                                    </li>
                                                    <li>
                                                        <p>Latest Resume
                                                            <a href="https://files.mastersunion.link/media/img/Sample_CV.pdf"
                                                                target="_blank" class="link-red"> Download Sample</a>
                                                        </p>
                                                    </li>

                                                </ul>


                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="feeProcessContainer">
                        <div class="leftSection">
                            <div class="listItem">
                                <p class="number">02.</p>
                                <p class=" go-BreatherHeading">Appear For an <br><span class=" font-semibold ">Online
                                        Interview
                                    </span>
                                </p>
                                <p></p>
                            </div>
                        </div>
                        <div class="rightSection">
                            <img src="https://images.mastersunion.link/uploads/24062025/v1/Frame1321317788.svg"
                                class="procedureImg" alt="">
                            <img src="https://images.mastersunion.link/uploads/24062025/v1/Frame13213177881.svg"
                                class="procedureImgGrad" alt="">
                            <div class="feeSectionMOb">
                                <div class="mobHeader">
                                    <p class="number">02.</p>
                                    <p class=" go-BreatherHeading">Appear For an <br><span
                                            class=" font-semibold ">Online
                                            Interview
                                        </span>
                                    </p>
                                </div>
                                <div class="body">

                                    <div class="feeBox">
                                        <div class="header hide">
                                            <p>Requirements</p>
                                        </div>
                                        <div class="body">

                                            <div class="detailsList">
                                                <p class="subHeading">About the Online Interview</p>

                                                <p class="pgpFeeHeading">If shortlisted, applicants will be invited for
                                                    an
                                                    online interview, which will help us get to know them better, and
                                                    help
                                                    them understand all aspects of the programme.
                                                    <br> The interview panel will consist of our eminent Masters from
                                                    academia and the industry, as well as members of the core team.
                                                </p>

                                            </div>

                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>



                    <div class="feeProcessContainer">
                        <div class="leftSection">
                            <div class="listItem">
                                <p class="number">03.</p>
                                <p class="go-BreatherHeading">Admission <br><span class="font-semibold  ">Decision
                                    </span>
                                </p>

                            </div>
                        </div>
                        <div class="rightSection">
                            <img src="https://images.mastersunion.link/uploads/28072025/v1/Frame13213177923.svg"
                                class="procedureImg" alt="">
                            <img src="https://images.mastersunion.link/uploads/28072025/v1/1.svg"
                                class="procedureImgGrad" alt="">

                            <div class="feeSectionMOb">
                                <div class="mobHeader">
                                    <p class="number">03.</p>
                                    <p class="go-BreatherHeading">Admission <br><span class="font-semibold  ">Decision
                                        </span>
                                    </p>
                                </div>
                                <div class="body">

                                    <div class="feeBox">
                                        <div class="header hide">
                                            <p>Requirements</p>
                                        </div>
                                        <div class="body">

                                            <div class="detailsList">
                                                <p class="subHeading">Status of Evaluation</p>

                                                <p class="pgpFeeHeading">Once the Admissions Office receives feedback
                                                    from
                                                    the panel, the application will be re-evaluated and then presented
                                                    to
                                                    the Admissions Committee, which makes the final decision for each
                                                    candidate. Applicants will be advised of the final decision on their
                                                    application through an email.
                                                </p>

                                                <div class="caution">
                                                    <img src="https://images.mastersunion.link/uploads/30072025/v1/Frame13213179061.svg"
                                                        alt="Icon">
                                                    <p>The entire admissions process, from the Application Deadline, may
                                                        take up to 4 weeks.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
