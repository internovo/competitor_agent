</main>

<script>
    let currentActiveCohort = "1";
    let cohort1ActiveIndex = 9;
    let cohort2ActiveIndex = 9;
    let cohort3ActiveIndex = 9;
    let students = [];
    let students_RiseCohort1 = [];
    let students_RiseCohort2 = [];
    let students_RiseCohort3 = [];

    getPgpRiseStudents();

    const pgpRiseStudentsToKeepInLast = [
        "662f429939437b7d0a2dc7de",
        "662f429939437b7d0a2dc7d1",
        "662f429939437b7d0a2dc7dd",
        "662f429939437b7d0a2dc7ef",
        "662f429939437b7d0a2dc7ee"
    ];

    async function getPgpRiseStudents() {
        const res = await fetch("https://api.mastersunion.org/api/getPgpRiseProfiles");
        students = await res.json();
        students_RiseCohort1 = students.filter(s => s.cohort === "1").sort((a, b) => a.display_index - b.display_index);
        students_RiseCohort2 = students.filter(s => s.cohort === "2").sort((a, b) => a.display_index - b.display_index);
        students_RiseCohort3 = students.filter(s => s.cohort === "3").sort((a, b) => a.display_index - b.display_index);
        bindPGPStudents();
        $("#loadMorePgpDiv").removeClass("hide");


    }

    var device;

    if (window.innerWidth < 767) {
        device = 1800;
    } else if (window.innerWidth > 787) {
        device = 1100;
    } else {
        // Handle other cases if needed
    }


    var device2;

    if (window.innerWidth < 767) {
        device2 = 570;
    } else if (window.innerWidth > 787) {
        device2 = 400;
    } else {
        // Handle other cases if needed
    }



    //menu

    //$(".seondtabs li").click(function () {
    //    let id = $(this).attr('data-rel')
    //    $(this).addClass('active').siblings().removeClass('active');
    //    $(`#${id}`).addClass('active').siblings().removeClass('active');
    //});

    //menu end


    $(".faqtabs li").click(function () {
        let id = $(this).attr('data-rel')
        $(this).addClass('active').siblings().removeClass('active');
        $(`#${id}`).addClass('active').siblings().removeClass('active');

        let cohort = $(this).attr('data-cohort');
        if (cohort) {
            currentActiveCohort = cohort;

            if (cohort === "1") {
                if (cohort1ActiveIndex < students_RiseCohort1.length) {
                    $("#loadMoreCohortBtn").show();
                }
            } else if (cohort === "2") {
                if (cohort2ActiveIndex < students_RiseCohort2.length) {
                    $("#loadMoreCohortBtn").show();
                }
            }
            else if (cohort === "3") {
                if (cohort3ActiveIndex < students_RiseCohort3.length) {
                    $("#loadMoreCohortBtn").show();
                }
            }
        }

    });

    setTimeout(function () {
        if (isCountryCodeFound) {
            $("#faqsTabs li").not('.hideFortheMENA.hide').first().addClass('active').siblings().removeClass('active');
            let activeId = $("#faqsTabs li").not('.hideFortheMENA.hide').first().attr('data-rel');
            $(`#${activeId}`).addClass('active').siblings().removeClass('active');
        }
    }, 2000)


    $(".navigationBox .courseName").click(function () {
        let id = $(this).attr('data-rel')
        $(this).addClass('active').siblings().removeClass('active');
        $(`#${id}`).addClass('active').siblings().removeClass('active');

    });

    $(".menuItem").click(function () {
        let id = $(this).attr('data-rel')
        $(this).addClass('active').siblings().removeClass('active');
        $(`#${id}`).addClass('active').siblings().removeClass('active');

    });

    function openTab(tag, tab) {
        // Get the target element's position
        let scrollTarget = $("#" + tag).offset().top;

        // Adjust for fixed header if needed (assuming header height is 80px)
        scrollTarget = scrollTarget - 80;

        $('html, body').animate({
            scrollTop: scrollTarget
        }, 1000);

        history.pushState(null, "", `/${tab}`);
        updateUrlWithUtm();
    };


    let isShowMore = true;

    $('#loadBtn').click(function (e) {
        e.preventDefault();
        let divName = $('ul.cohortTabs').find('li.active').attr('data-rel')
        let year = divName.substring(6);
        bindStudents(year, !isShowMore);

        //$(window).scrollTop(0)
        if ($('#loadBtn span').text() == 'Load Less') {
            $('#loadBtn span').text('Load All')
        } else {
            $('#loadBtn span').text('Load Less')
        }
        isShowMore = !isShowMore;

    })

    $('ul.cohortTabs li').click(function () {
        let divName = $(this).attr('data-rel')

        bindStudents('2021', true);
        bindStudents('2022', true);
        bindStudents('2023', true);
        bindStudents('2024', true);
        $('#loadBtn span').text('Load All')
        isShowMore = true;
        //$(window).scrollTop(0)
    })
    function bindStudents(year, isLimit) {
        $('#cohort' + year + ' .cohortwrapper').empty();
        let newStudents;
        if (year == '2021') {
            newStudents = students.filter((std) => std.batch !== "2022" && std.batch !== "2023" && std.batch !== "2024" && std.course !== "Product Management");
        } else if (year == '2022' || year == '2023' || year == '2024') {
            newStudents = students2.filter((std) => std.batch == year && std.course !== "Product Management");
        }
        if (isLimit) newStudents = newStudents.splice(0, 12);

        newStudents.forEach((student, index) => {
            var html = `<div class="box2col">
                                    <img   src="${student.studentProfilePic}" alt="std-img">
                                    <div class="box">
                                        <div class="flexbox">
                                            <p>${student.studentName}</p>
                                            <div >`
            if (student.linkedIn != undefined && student.linkedIn != '') {
                html += `<a href="${student.linkedIn}" rel="nofollow noindex" target="_blank"> <img   src="https://files.mastersunion.link/resources/img/cohortlinkedin.webp" alt=""></a>`
            }
            if (student.resume_url != undefined && student.resume_url != '') {
                html += `<a href="${student.resume_url}" rel="nofollow noindex" target="_blank"> <img   src="https://files.mastersunion.link/resources/img/cohortcv.webp" alt=""></a>`
            }

            html += `</div>
                                        </div>
                                        <hr class="lineSpace">
                                        <div class="line-clamp">`
            if (student.role_company != undefined && student.role_company != '') {
                html += `<p class="cohortCompany "><b>${student.role_company}</b></p>`
            }

            html += `<p class="cohortCompany">`
            if (student.campusOrgComingFrom.length > 0) {
                student.campusOrgComingFrom.forEach((campusOrg, i) => {
                    html += `${campusOrg} `
                    if (i < student.campusOrgComingFrom.length - 1) html += `<span class="spnPipe"> / </span>`
                })
            }
            html += `</p>
                </div>
                                    </div>
                                </div>`;
            $('#cohort' + year + ' .cohortwrapper').append(html);
        });
    }

    function getAllStudents() {
        $.ajax({
            url: 'https://api.mastersunion.org/api/studentResume'
        }).done(function (response) {
            if (response.IsSuccess == true) {
                students = response.Data;
                students2 = response.Data;
                bindStudents('2021', true);
                bindStudents('2022', true);
                bindStudents('2023', true);
                bindStudents('2024', true);
            }
        })
    }
    var roasters = [];

    let pgpRiseMasters = [];

    $(document).ready(function () {
        getPgpRiseMasters();
        $(window).scroll(function () {
            var stickyDiv = $('#stickyHeader')
            var scrollValue = $(this).scrollTop();
            var divOffset = stickyDiv.offset().top;
            console.log("scrollValue: ", scrollValue)
            console.log("divOffset: ", divOffset)
            // Check if the sticky div is at the top of the page
            if (scrollValue + 89 >= divOffset) {
                // Call your function when the sticky div gets to the top
                $('#header').addClass('rollup')
                console.log('mastch')
            } else {
                $('#header').removeClass('rollup')

            }
        })
        //open menu section on click

        $('.primary-nav').find('a').each(function () {

            if ($(this).attr('href') == "/course-roster") {
                $(this).addClass('active')
            }
            else {
                $(this).removeClass('active')
            }
        });

        $('.right-ftr-section').find('a').each(function () {

            if ($(this).attr('href') == "/course-roster") {
                $(this).addClass('active')
            }
            else {
                $(this).removeClass('active')
            }
        });

        $('#dropDown').change(function () {
            let filterType = $(this).val()
            //if (filterArray.indexOf(filterType) > -1)
            //   return false;
            filterArray = []
            filterArray.push(filterType)
            bindDrop(filterType, 'concentration')
            filterRoasters(roasters)
        })

        $('#selectTerm').change(function () {
            let filterType = $(this).val()
            //if (filterTermArray.indexOf(filterType) > -1)
            // return false;
            filterTermArray = []
            filterTermArray.push(filterType)
            bindDrop(filterType, 'term')
            filterRoasters(roasters)
        })

        $('#selectType').change(function () {

            let filterType = $(this).val();
            //if (filterTypeArray.indexOf(filterType) > -1)
            // return false;
            filterTypeArray = []
            filterTypeArray.push(filterType)
            bindDrop(filterType, 'type')
            filterRoasters(roasters)
        })

        $('#selectFormat').change(function () {
            let filterType = $(this).val();
            //multiselect hide
            // if (filterFormatArray.indexOf(filterType) > -1)
            //      return false;
            //multiselect hide
            filterFormatArray = []
            filterFormatArray.push(filterType)
            bindDrop(filterType, 'format')
            filterRoasters(roasters)
        })

        $('#selectCohort').change(function () {
            let filterType = $(this).val();
            //if (filterCohortArray.indexOf(filterType) > -1)
            //return false;
            filterCohortArray = []
            filterCohortArray.push(filterType)
            bindDrop(filterType, 'cohort')
            filterRoasters(roasters)
        })

        getroasters();
        function bindDrop(filterType, selectType) {
            let htm;
            if (selectType == "cohort" && filterType != "all") {
                htm = `   <div class="selected-item core-text" data="${filterType}" data-type="${selectType}">
                       <p class="text1">Cohort ${filterType}</p>
                       <img   src = "https://files.mastersunion.link/resources/svg/Close.svg" alt="icon">
                   </div> `
            }
            else {
                htm = `   <div class="selected-item core-text" data="${filterType}" data-type="${selectType}">
                       <p class="text1">${filterType}</p>
                       <img   src = "https://files.mastersunion.link/resources/svg/Close.svg" alt="icon">
                   </div> `
            }

            $('#spnCoreTxt').append(htm);
        }
        function getroasters() {
            $.ajax({

                url: 'https://api.mastersunion.org/api/roaster',

            }).done(function (response) {
                if (response.IsSuccess == true) {

                    roasters = response.Data;

                    filterRoasters(roasters)

                }

            });

        }

        var filterArray = []
        var filterTermArray = []
        var filterFormatArray = []
        //   var filterProfessorArray = []
        var filterTypeArray = []
        var filterCohortArray = []


        function filterRoasters(roasters) {

            $('#tblBodyCore').html('')
            $('#tblBodyIndusry').html('')
            $('#tblBodyMentorship').html('')
            $('#tblBodyBootcamp').html('')
            $('#tblBodyBoard').html('')
            $('#tblBodyAll').html('')

            //console.log(filterArray)
            //console.log(filterTermArray)
            //console.log(filterFormatArray)

            if (filterArray.length > 0 && filterArray.indexOf('all') == -1)
                var roasters = roasters.filter(function (el) {
                    return filterArray.includes(el.Concentration)
                });

            if (filterTermArray.length > 0 && filterTermArray.indexOf('all') == -1)
                roasters = roasters.filter(function (el) {

                    return filterTermArray.includes(el.Term)
                });

            if (filterFormatArray.length > 0 && filterFormatArray.indexOf('all') == -1)
                var roasters = roasters.filter(function (el) {
                    return filterFormatArray.includes(el.Format)
                });

            if (filterCohortArray.length > 0 && filterCohortArray.indexOf('all') == -1)
                var roasters = roasters.filter(function (el) {
                    return filterCohortArray.includes(el.Cohort)
                });

            if (filterTypeArray.length > 0 && filterTypeArray.indexOf('all') == -1)
                var roasters = roasters.filter(function (el) {
                    return filterTypeArray.includes(el.ctype)
                });

            roasters.sort(function (a, b) {
                var keyA = (a.Term),
                    keyB = (b.Term);
                // Compare the 2 dates
                if (keyA < keyB) return -1;
                if (keyA > keyB) return 1;
                return 0;
            });
            roasters.forEach((roast, index) => {

                if (roast.CourseNum == null) roast.CourseNum = "";
                if (roast.CourseName == null) roast.CourseName = ""
                if (roast.ctype == null) roast.ctype = ""
                if (roast.Concentration == null) roast.Concentration = ""
                if (roast.Term == null) roast.Term = ""
                if (roast.Credits == null) roast.Credits = ""
                if (roast.Hours == null) roast.Hours = ""
                if (roast.Format == null) roast.Format = ""
                if (roast.Schedule == null) roast.Schedule = ""
                if (roast.Master == null) roast.Master = ""
                if (roast.AboutMaster == null) roast.AboutMaster = ""
                if (roast.Cohort == null) roast.Cohort = ""

                var html =
                    `
                         <tr>
                               <td>${roast.CourseName}</td>
                                <td>`
                if (roast.Masters.length > 0) {
                    roast.Masters.forEach((master, i) => {
                        html += `
                                        ${master.name}
                                        <p class="text10">${master.designation}</p>
                                        `
                    })
                }
                else {
                    html += `
                                        ${roast.Master}
                                        <p class="text10">${roast.AboutMaster}</p>
                                        `
                }
                html += `</td>
                                <td>
                                    ${roast.Concentration}
                                </td>
                                <td>
                                    ${roast.ctype}
                                </td>
                              
                                <td>
                                    ${roast.Credits} (${roast.Hours} hours)
                                </td>
                              
                           </tr>
                        `;


                $('#tblBodyAll').append(html);


            });

            if (filterArray.indexOf('Core') > -1) {
                //$('#headerUpper').html('Core');
                $('#headerLower').html('Core Concentration');



            }
            if (filterArray.indexOf('Skill') > -1) {
                $('#headerLower').html('Skill');



            }
            if (filterArray.indexOf('Industry') > -1) {
                $('#headerLower').html('Industry Concentration');


            }
            if (filterArray.indexOf('Mentorship') > -1) {

                $('#headerLower').html('Industry Mentorship Programm');
            }
            if (filterArray.indexOf('Bootcamp') > -1) {

                $('#headerLower').html('Bootcamp');

            } if (filterArray.indexOf('Boardmember') > -1) {

                $('#headerLower').html('Board Member Recticals');

            } if (filterArray.indexOf('all') > -1) {

                $('#headerLower').html('Member Recticals');

            }

            var htmlNodatafound = `<tr> 
                <td colspan="9">
                    <p class="alert-txt"> <span class="material-icons"> warning </span> No data found </p>
                </td> 
                </tr>`

            if ($('#tblBodyMentorship').html() == '' || $('#tblBodyMentorship').html() == undefined) $('#tblBodyMentorship').html(htmlNodatafound)
            if ($('#tblBodyBootcamp').html() == '' || $('#tblBodyBootcamp').html() == undefined) $('#tblBodyBootcamp').html(htmlNodatafound)
            if ($('#tblBodyBoard').html() == '' || $('#tblBodyBoard').html() == undefined) $('#tblBodyBoard').html(htmlNodatafound)
            if ($('#tblBodyCore').html() == '' || $('#tblBodyCore').html() == undefined) $('#tblBodyCore').html(htmlNodatafound)
            if ($('#tblBodySkill').html() == '' || $('#tblBodySkill').html() == undefined) $('#tblBodySkill').html(htmlNodatafound)
            if ($('#tblBodyIndusry').html() == '' || $('#tblBodyIndusry').html() == undefined) $('#tblBodyIndusry').html(htmlNodatafound)



        }
        $(document).on("click", ".core-text", function () {
            // console.log($(this).attr('data-type'))
            // console.log($(this).attr('data'))

            $(this).remove()
            if ($(this).attr('data-type') == 'concentration') {

                filterArray.splice(filterArray.indexOf($(this).attr('data')), 1)
                if (filterArray.length == 0)
                    $('#dropDown').val('all')
            }
            if ($(this).attr('data-type') == 'term') {
                filterTermArray.splice(filterTermArray.indexOf($(this).attr('data')), 1)
                if (filterTermArray.length == 0)
                    $('#selectTerm').val('all')
            } if ($(this).attr('data-type') == 'format') {
                filterFormatArray.splice(filterFormatArray.indexOf($(this).attr('data')), 1)
                if (filterFormatArray.length == 0)
                    $('#selectFormat').val('all')
            }
            if ($(this).attr('data-type') == 'cohort') {
                filterCohortArray.splice(filterCohortArray.indexOf($(this).attr('data')), 1)
                if (filterCohortArray.length == 0)
                    $('#selectCohort').val('all')
            }

            if ($(this).attr('data-type') == 'type') {
                filterTypeArray.splice(filterTypeArray.indexOf($(this).attr('data')), 1)
                if (filterTypeArray.length == 0)
                    $('#selectType').val('all')
            }
            filterRoasters(roasters)

            //$('select').selectpicker('refresh');
        });

        $('#selectCohort').val('3');
        $('#selectCohort').trigger('change');


    });


    function bindPGPStudents(cohort = 'all') {
        const cohorts = {
            "1": {
                students: students_RiseCohort1,
                activeIndex: cohort1ActiveIndex,
                container: '#pgpRiseCohort1',
                renderHTML: (student) => `
                <div class="box2col">
                    <img  src="${student.profilePicUrl}" alt="std-img">
                    <div class="box">
                        <div class="flexbox">
                            <p>${student.name}</p>
                            <div>
                                ${student.linkedinURL ? `<a href="${student.linkedinURL}" rel="nofollow noindex" target="_blank">
                                                            <img  src="https://images.mastersunion.link/uploads/28072025/v1/Frame4273217562.svg" alt="">
                                                        </a>` : ''}
                                ${student.resume_url ? `<a href="${student.resume_url}" rel="nofollow noindex" target="_blank">
                                                            <img  src="https://files.mastersunion.link/resources/img/cohortcv.webp" alt="">
                                                        </a>` : ''}
                            </div>
                        </div>
                        <hr class="lineSpace">
                        <div class="line-clamp">
                            <p class="studentDes ">${student.display_role}</p>
                            <p class="cohortCompany" >${student.display_company}</p>
                        </div>
                    </div>
                </div>`
            },
            "2": {
                students: students_RiseCohort2,
                activeIndex: cohort2ActiveIndex,
                container: '#pgpRiseCohort2',
                renderHTML: (student) => `
                <div class="box2col differentDesign">
                    <img  src="${student.profilePicUrl}" alt="std-img">
                    <div class="box">
                        <div class="flexbox">
                            <p>${student.name}</p>
                            <div>
                                ${student.linkedinURL ? `<a href="${student.linkedinURL}" rel="nofollow noindex" target="_blank">
                                                            <img  src="https://images.mastersunion.link/uploads/28072025/v1/Frame4273217562.svg" alt="">
                                                        </a>` : ''}
                                ${student.resume_url ? `<a href="${student.resume_url}" rel="nofollow noindex" target="_blank">
                                                            <img  src="https://files.mastersunion.link/resources/img/cohortcv.webp" alt="">
                                                        </a>` : ''}
                            </div>
                        </div>
                        <hr class="lineSpace">
                        <div class="line-clamp">
                            <p class="studentDes ">${student.display_role}</p>
                            <p class="cohortCompany" >${student.display_company}</p>
                        </div>
                    </div>
                </div>`
            },
            "3": {
                students: students_RiseCohort3,
                activeIndex: cohort3ActiveIndex,
                container: '#pgpRiseCohort3',
                renderHTML: (student) => `
                <div class="box2col differentDesign">
                    <img  src="${student.profilePicUrl}" alt="std-img">
                    <div class="box">
                        <div class="flexbox">
                            <p>${student.name}</p>
                            <div>
                                ${student.linkedinURL ? `<a href="${student.linkedinURL}" rel="nofollow noindex" target="_blank">
                                                            <img  src="https://images.mastersunion.link/uploads/28072025/v1/Frame4273217562.svg" alt="">
                                                        </a>` : ''}
                                ${student.resume_url ? `<a href="${student.resume_url}" rel="nofollow noindex" target="_blank">
                                                            <img  src="https://files.mastersunion.link/resources/img/cohortcv.webp" alt="">
                                                        </a>` : ''}
                            </div>
                        </div>
                        <hr class="lineSpace">
                        <div class="line-clamp">
                            <p class="studentDes ">${student.display_role}</p>
                            <p class="cohortCompany" >${student.display_company}</p>
                        </div>
                    </div>
                </div>`
            }
        };

        const renderCohort = (cohortData) => {
            cohortData.students.slice(0, cohortData.activeIndex).forEach(student => {
                $(cohortData.container).append(cohortData.renderHTML(student));
            });

            if (cohortData.activeIndex >= cohortData.students.length) {
                $("#loadMoreCohortBtn").hide();
            }
        };

        if (cohort === "all") {
            Object.values(cohorts).forEach(renderCohort);
        } else if (cohorts[cohort]) {
            renderCohort(cohorts[cohort]);
        }
    }



    /* Masters Variables */
    let currentPagePGPRise = 1;
    let displayedProfiles = 0;

    async function getPgpRiseMasters() {
        const res = await fetch("https://api.mastersunion.org/api/getPgpRiseMasters")
        const data = await res.json();
        pgpRiseMasters = data.masters;
        if (pgpRiseMasters.length > 0) {
            loadAndBindMastersPGPRise();
        }
    }

    async function loadAndBindMastersPGPRise(page) {
        console.log("Binding Masters");
        try {

            const profilesPerPage = 10;
            let totalProfiles = pgpRiseMasters.length;

            const practitionerMasters = pgpRiseMasters.filter(m => m.isPractitioner === true);
            const residentMasters = pgpRiseMasters.filter(m => m.isResident === true);

            const startIndex = (page - 1) * profilesPerPage;
            const endIndex = Math.min(startIndex + profilesPerPage, totalProfiles);
            const displayedMasters = pgpRiseMasters.slice(startIndex, endIndex);
            const allMastersHTML = pgpRiseMasters.map((item, index) => {
                const masterName = `${item.title ? item.title : ""} ${item.firstName} ${item.lastName}`;

                return `
                    <div class="masterBox">
                        <div class="masterImage">
                            <img   src=${index % 2 === 0 ? item.masterPhotoLight : item.masterPhotoDark} alt="${masterName}">
                           
                        </div>
                        <span class="masterName">${masterName}</span>
                        <p class="masterDesignation">${item.designation}</p><br/>
                        <span class="masterDesignation">${item.companyName}</span>
                        <hr class="lineSpace">
                        <span class="masterExperience">Teaching: ${item.teaching}</span>
                    </div>`;
            }).join('');

            const practitionerMastersHTML = practitionerMasters.map((item, index) => {

                return `
                    <div class="masterBox">
                        <div class="masterImage">
                            <img   src=${index % 2 === 0 ? item.masterPhotoLight : item.masterPhotoDark} alt="Master Profile Picture" onerror="this.onerror=null; this.src='https://i.postimg.cc/YS06QSFT/avatar-fallback.jpg';">
                           
                        </div>
                        <span class="masterName">${item.title ? item.title : ""} ${item.firstName} ${item.lastName}</span>
                        <p class="masterDesignation">${item.designation}</p><br/>
                        <span class="masterDesignation">${item.companyName}</span>
                        <hr class="lineSpace">
                        <span class="masterExperience">Teaching: ${item.teaching}</span>
                    </div>`;
            }).join('');

            const residentMastersHTML = `
             <div class="masterBox">
                                            <div class="masterImage">
                                                <img 
                                                    src="https://files.mastersunion.link/resources/img/NandiniSeth.webp"
                                                    alt="">
                                            </div>
                                            <p class="recruitersName">Dr. Nandini Seth <a
                                                    href='https://www.linkedin.com/in/nandini-seth-iimb/'
                                                    target="_blank"> <img  src="https://files.mastersunion.link/resources/svg/linkedin.svg"
                                                        alt="" ></a></p>
                                            <p class="recruitersName recruitersTeaching">Ph.D, IIM Bangalore </p>
                                            <hr class="lineSpace">
                                            <p class="recruitersName recruitersPrev line-clamp">
                                                Data Analytics</p>
                                            </p>
                                        </div>


                                          <div class="masterBox">
                                            <div class="masterImage">
                                                <img 
                                                    src="https://files.mastersunion.link/resources/img/BhupeshManoharan.webp"
                                                    alt="">
                                            </div>
                                            <p class="recruitersName">Dr. Bhupesh Manoharan <a
                                                    href='https://www.linkedin.com/in/bhupesh-manoharan-44651756/'
                                                    target="_blank"> <img  src="https://files.mastersunion.link/resources/svg/linkedin.svg"
                                                        alt="" ></a></p>
                                            <p class="recruitersName recruitersTeaching">Ph.D, IIM Calcutta </p>
                                            <hr class="lineSpace">
                                            <p class="recruitersName recruitersPrev line-clamp"> Marketing
                                            </p>
                                        </div>


                                           <div class="masterBox">
                                            <div class="masterImage">
                                                <img 
                                                    src="https://files.mastersunion.link/resources/img/ShivaneePethe.webp"
                                                    alt="">
                                            </div>
                                            <p class="recruitersName">Ms. Shivanee Pethe <a
                                                    href='https://www.linkedin.com/in/shivanee-pethe/' target="_blank">
                                                    <img  src="https://files.mastersunion.link/resources/svg/linkedin.svg" alt=""
                                                        ></a></p>
                                            <p class="recruitersName recruitersTeaching"> Ph.D, IIM Calcutta</p>
                                            <hr class="lineSpace">
                                            <p class="recruitersName recruitersPrev line-clamp">
                                                Operations</p>
                                        </div>


                                           <div class="masterBox">
                                            <div class="masterImage">
                                                <img 
                                                    src="https://files.mastersunion.link/resources/img/VipinSreekumar.webp"
                                                    alt="">
                                            </div>
                                            <p class="recruitersName">Dr. Vipin Sreekumar <a
                                                    href='https://www.linkedin.com/in/vipinsreekumar/' target="_blank">
                                                    <img  src="https://files.mastersunion.link/resources/svg/linkedin.svg" alt=""
                                                        ></a></p>
                                            <p class="recruitersName recruitersTeaching"> Ph.D, IIM Calcutta</p>
                                            <hr class="lineSpace">
                                            <p class="recruitersName recruitersPrev line-clamp">
                                                Strategic Mgmt. & Entrepreneurship</p>
                                        </div>

                                         <div class="masterBox">
                                            <div class="masterImage">
                                                <img 
                                                    src="https://files.mastersunion.link/resources/img/AartiSharma.webp"
                                                    alt="">
                                            </div>
                                            <p class="recruitersName">Dr. Aarti Sharma <a
                                                    href='https://www.linkedin.com/in/aartisharma2089/' target="_blank">
                                                    <img  src="https://files.mastersunion.link/resources/svg/linkedin.svg" alt=""
                                                        ></a></p>
                                            <p class="recruitersName recruitersTeaching">Ph.D, Shiv Nadar University
                                            </p>
                                            <hr class="lineSpace">
                                            <p class="recruitersName recruitersPrev line-clamp">
                                                Finance & Acc., MasterCamp</p>
                                        </div>
            `;


            const allMastersElem = document.querySelector('#BindPGPRiseMasters1');
            allMastersElem.innerHTML = allMastersHTML;
            allMastersElem.innerHTML += residentMastersHTML;
            document.querySelector('#BindPGPRiseMasters2').innerHTML = practitionerMastersHTML;
            document.querySelector('#BindPGPRiseMasters3').innerHTML = residentMastersHTML;


            displayedProfiles += displayedMasters.length;
            if (displayedProfiles < totalProfiles) {
                $("#loadmoreMasterPGPRise").show();
            } else {
                $("#loadmoreMasterPGPRise").hide();
            }


        } catch (err) {
            console.log(err);
        }
    }



    $("#loadmoreMasterPGPRise").click(function () {
        if (pgpRiseMasters.length === 0) return;
        currentPagePGPRise++;
        loadAndBindMastersPGPRise(currentPagePGPRise);
    });


    function loadMorePgpStudents() {
        if (currentActiveCohort === "1") {
            cohort1ActiveIndex += 9;
            document.getElementById("pgpRiseCohort1").innerHTML = '';
            bindPGPStudents("1");
        }
        else if (currentActiveCohort === "2") {
            cohort2ActiveIndex += 9;
            document.getElementById("pgpRiseCohort2").innerHTML = '';
            bindPGPStudents("2");
        } else {
            cohort3ActiveIndex += 9;
            document.getElementById("pgpRiseCohort3").innerHTML = '';
            bindPGPStudents("3");
        }
    }

    document.querySelectorAll("#masterTabsUl li").forEach(function (element) {
        element.addEventListener("click", function () {
            document.querySelector("#mastertab1")?.classList?.add("hide");
            document.querySelector("#mastertab2")?.classList?.add("hide");
            document.querySelector("#mastertab3")?.classList?.add("hide");
            let id = this.getAttribute('data-rel');

            let siblings = Array.from(this.parentNode.children).filter(function (child) {
                return child !== this;
            }, this);
            siblings.forEach(function (sibling) {
                sibling.classList.remove('active');
            });

            document.getElementById(id).classList.remove("hide");
            this.classList.add('active');

            // Scroll the active content to top (100px from top of viewport)
            const targetContent = document.getElementById(id);
            if (targetContent) {
                const targetPosition = targetContent.offsetTop - 100;
                window.scrollTo({
                    top: targetPosition,
                    behavior: 'smooth'
                });
            }
        });
    });


</script>
