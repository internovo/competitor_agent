  function scrollTab(active) {
    // The Bharat sub-nav centres its own pill (see views/indiaBootcamp.hbs): it
    // follows the tab while the label expands, so running the jQuery scroll below
    // as well showed the track move twice for a single tap.
    if (typeof window.bharatCenterSubNavTab === 'function' &&
      active.closest('.bharatSubNav').length) {
      window.bharatCenterSubNavTab(active[0]);
      return;
    }

    var activeWidth = active.width() / 2;
    let ancorVar = $(active).find("a").attr("href");
    let parent = active.parent().attr("id");
    var pos = active.position()?.left + activeWidth;
    var currentscroll = active.parent().scrollLeft();
    var divwidth = active.parent().width();

    if (activeWidth > 60) {
      pos = pos + currentscroll - divwidth / 2 + 105;
    } else {
      pos = pos + currentscroll - divwidth / 2 + 80;
    }
    active.parent().animate({
      scrollLeft: pos,
    }, 300);
  }

  function openTab(scrollTo, newUrl) {
    // Update URL without page reload
    if (newUrl) {
      history.pushState({ tab: newUrl }, '', '/' + newUrl);
    }

    // Scroll to element if specified
    if (scrollTo) {
      const element = document.getElementById(scrollTo);
      if (element) {
        element.scrollIntoView({ behavior: 'smooth' });
      }
    }
  }

  function initializeTabContent(tabId) {
    // Reinitialize all Swiper instances in the tab
    if (typeof Swiper !== 'undefined') {
      const $tab = $(`#${tabId}`);
      $tab.find('.swiper').each(function () {
        const $swiper = $(this);
        if ($swiper.length && !$swiper.hasClass('swiper-initialized')) {
          // Get the Swiper instance configuration based on class
          if ($swiper.hasClass('eventheld13')) {
            new Swiper('.eventheld13', swiperConfig);
          } else if ($swiper.hasClass('outclassSwipergm1')) {
            new Swiper('.outclassSwipergm1', outclassConfig);
          }
          // Add more Swiper initializations as needed
        }
      });
    }

    // Reinitialize any other interactive elements
    const $tab = $(`#${tabId}`);

    // Trigger a resize event to fix any layout issues
    window.dispatchEvent(new Event('resize'));
  }

  function switchToTab(tabId) {
    const $content = $(`#${tabId}`);
    if (!$content.length) return;

    // Every panel is already in the DOM, so the switch happens in place - the
    // highlight lands on the click instead of waiting for a page reload.
    $('.pgpcourse').removeClass('active');
    $content.addClass('active');

    // Both navs mark the same five tabs, so keep them in step
    const $tab = $(`.seondtabs li[data-rel="${tabId}"]`);
    $('.seondtabs li').removeClass('active');
    $tab.addClass('active');

    $('.exploreLeftTag').removeClass('active');
    $(`.exploreLeftTag[data-rel="${tabId}"]`).addClass('active');

    // Scroll the tab into view
    if ($tab.length) scrollTab($tab);

    // Initialize the tab content
    initializeTabContent(tabId);
  }

  // Handle tab switching
  $(".seondtabs li").click(function () {
    const $this = $(this);
    const id = $this.attr('data-rel');
    const url = $this.attr('data-url');

    // Switch to the selected tab
    switchToTab(id);

    // Update URL if specified
    if (url) {
      history.pushState({ tab: id }, '', '/' + url);
    }
  });

  // Handle browser back/forward - resolve the tab from the URL rather than from
  // history.state, so the entry the page first loaded on (state === null) works too.
  window.addEventListener('popstate', function () {
    const currentPath = window.location.pathname.substring(1); // Remove leading slash
    const $tab = $(`.seondtabs li[data-url="${currentPath}"]`);
    if ($tab.length) {
      switchToTab($tab.attr('data-rel'));
    }
  });

  // Initialize correct tab on page load
  // Common Swiper configurations
  const swiperConfig = {
    slidesPerView: 1,
    spaceBetween: 25,
    freeMode: true,
    navigation: {
      nextEl: ".eventheld13-Next",
      prevEl: ".eventheld13-Prev",
    },
    breakpoints: {
      0: {
        slidesPerView: 1,
        autoplay: false,
        speed: 1500,
      },
      768: {
        slidesPerView: 1,
        speed: 1500,
      },
      1024: {
        slidesPerView: 2.4,
        slidesPerGroup: 1,
      },
      1366: {
        slidesPerView: 2.4,
        slidesPerGroup: 1,
      },
      1600: {
        slidesPerView: 2.7,
      },
    },
  };

  const outclassConfig = {
    spaceBetween: 15,
    navigation: {
      nextEl: ".outclassSwiperPgp1-Next",
      prevEl: ".outclassSwiperPgp1-Prev",
    },
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
    breakpoints: {
      0: {
        slidesPerView: 1,
        freeMode: true,
        autoplay: false,
        speed: 400,
      },
      768: {
        slidesPerView: 1,
        freeMode: true,
        autoplay: false,
        speed: 400,
      },
      1024: {
        slidesPerView: 2,
        freeMode: false,
        slidesPerGroup: 1,
      },
      1366: {
        slidesPerView: 2,
        freeMode: false,
        slidesPerGroup: 1,
        spaceBetween: 20,
      },
      1440: {
        slidesPerView: 2,
        freeMode: false,
        slidesPerGroup: 1,
        spaceBetween: 20,
      },
      1600: {
        slidesPerView: 2,
        freeMode: false,
        spaceBetween: 20,
      },
      1920: {
        slidesPerView: 2,
        freeMode: false,
        spaceBetween: 20,
      },
    },
  };

  $(document).ready(function () {
    const currentPath = window.location.pathname.substring(1);
    const $tab = $(`.seondtabs li[data-url="${currentPath}"]`);
    if ($tab.length) {
      switchToTab($tab.attr('data-rel'));
    }

    // Initialize all Swiper instances on page load
    initializeTabContent($('.pgpcourse.active').attr('id'));
  });


</script>

