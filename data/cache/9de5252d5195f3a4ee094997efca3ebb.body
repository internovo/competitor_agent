                    <path d="M11 7.5625C11 6.83315 11.2897 6.13368 11.8055 5.61796C12.3212 5.10223 13.0207 4.8125 13.75 4.8125H19.9375V17.1875H13.75C13.0207 17.1875 12.3212 17.4772 11.8055 17.993C11.2897 18.5087 11 19.2082 11 19.9375" stroke="#090909" stroke-width="1.375"
                      stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M2.0625 17.1875H8.25C8.97935 17.1875 9.67882 17.4772 10.1945 17.993C10.7103 18.5087 11 19.2082 11 19.9375V7.5625C11 6.83315 10.7103 6.13368 10.1945 5.61796C9.67882 5.10223 8.97935 4.8125 8.25 4.8125H2.0625V17.1875Z" stroke="#090909" stroke-width="1.375"
