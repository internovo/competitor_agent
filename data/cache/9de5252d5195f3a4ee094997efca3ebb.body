            <style>
                .immersionDeckSection {
                    background-color: black;
                    color: white;
                    padding-bottom: 0;
                }

                .immersionDeckScrollWrapper {
                    height: 200vh;
                    position: relative;
                }

                .immersionDeckSticky {
                    position: sticky;
                    top: 0;
                    height: 100vh;
                    display: flex;
                    align-items: stretch;
                    overflow: hidden;
                    box-sizing: border-box;
                    padding-bottom: 16px;
                }

                .immersionDeckSticky>.container {
                    display: flex;
                    flex-direction: column;
                    height: 100%;
                    width: 100%;
                }

                .immersionDeckLayout {
                    display: flex;
                    flex-direction: column;
                    width: 100%;
                    height: 100%;
                    justify-content: space-between;
                    align-items: stretch;
                    padding: 24px 0 0;
                }

                .immersionDeckHeader {
                    display: flex;
                    justify-content: space-between;
                    align-items: flex-start;
                    opacity: 0;
                    filter: blur(8px);
                    transform: translateY(24px);

                    flex-shrink: 0;
                }

                .immersionDeckHeadingLeft {
                    font-size: 30px;
                }

                .immersionDeckHeadingItalic {
                    font-family: "Fraunces", serif;
                    font-size: 34px;
                    font-style: italic;
                    font-weight: 400;
                    line-height: 120%;
                }

                .immersionDeckHeadingRight {
                    width: 44%;
                    font-size: 16px;
                    color: #d4d4d4;
                }

                .immersionDeckContent {
                    position: relative;
                    height: 700px;
                    flex-shrink: 0;

                }

                .immersionDeckBaseImage {
                    margin: 0 auto;
                    position: absolute;
                    max-width: 820px;
                    width: 100%;
                    bottom: 0;
                    left: 50%;
                    transform: translate(-50%, 0%);
                    z-index: 3;
                }

                .immersionDeckArcSvg {
                    position: absolute;
                    top: 0;
                    left: -44px;
                    width: 100%;
                    height: 100%;
                    z-index: 2;
                    pointer-events: none;
                }

                #immersionDeckArcFill {
                    will-change: stroke-dashoffset;
                }

                .immersionDeckCard {
                    position: absolute;
                    max-width: 240px;
                    width: 100%;
                    z-index: 4;
                    opacity: 0;
                    will-change: opacity;
                }

                .immersionDeckCard::after {
                    content: '';
                    position: absolute;
                    inset: 0;
                    opacity: 0.6;
                    transition: opacity 0.4s ease;
                    border-radius: inherit;
                    pointer-events: none;
                }

                .immersionDeckCard.active::after {
                    opacity: 0;
                }

                .immersionDeckCard1 {
                    bottom: -18px;
                    left: 165px;
                    rotate: -65deg;
                }

                .immersionDeckCard2 {
                    bottom: 168px;
                    left: 348px;
                    rotate: -22deg;
                }

                .immersionDeckCard3 {
                    bottom: 168px;
                    left: 638px;
                    rotate: 20deg;
                }

                .immersionDeckCard4 {
                    bottom: -18px;
                    left: 822px;
                    rotate: 65deg;
                }

                .immersionDeckFlow {
                    z-index: 1;
                    position: absolute;
                    opacity: 0;
                    will-change: opacity;
                }

                .immersionDeckFlow img {
                    filter: grayscale(1);
                    transition: filter 0.4s ease;
                }

                .immersionDeckFlow.active img {
                    filter: grayscale(0);
                }

                .immersionDeckFlow1 {
                    width: 320px;
                    bottom: 0px;
                    left: 135px;
                }

                .immersionDeckFlow2 {
                    width: 320px;
                    bottom: 167px;
                    left: 291px;
                }

                .immersionDeckFlow3 {
                    width: 320px;
                    bottom: 164px;
                    left: 630px;
                }

                .immersionDeckFlow4 {
                    width: 320px;
                    bottom: 0px;
                    left: 782px;
                }

                .immersionDeckCard[data-id="1"].active~.immersionDeckText[data-id="1"] .immersionDeckConnectorSvg,
                .immersionDeckCard[data-id="2"].active~.immersionDeckText[data-id="2"] .immersionDeckConnectorSvg,
                .immersionDeckCard[data-id="3"].active~.immersionDeckText[data-id="3"] .immersionDeckConnectorSvg,
                .immersionDeckCard[data-id="4"].active~.immersionDeckText[data-id="4"] .immersionDeckConnectorSvg {
                    filter: grayscale(0);
                }

                .immersionDeckText {
                    position: absolute;
                    display: flex;
                    flex-direction: column;
                    gap: 8px;
                    opacity: 0;
                    filter: blur(6px);
                    transform: translateY(20px);
                }

                .immersionDeckText1 {
                    bottom: 105px;
                    left: 20px;
                }

                .immersionDeckText2 {
                    bottom: 428px;
                    left: 294px;
                }

                .immersionDeckText3 {
                    bottom: 354px;
                    left: 720px;
                }

                .immersionDeckText4 {
                    bottom: 304px;
                    left: 990px;
                }

                .immersionDeckText4 .immersionDeckTextInner {
                    position: absolute;
                    left: 80px;
                    top: 50px;
                }

                .immersionDeckText3 .immersionDeckTextInner {
                    position: absolute;
                    left: 85px;
                }

                .immersionDeckConnectorSvg {
                    filter: grayscale(1);
                    transition: filter 0.4s ease;
                }

                .immersionDeckConnectorSvg1 {
                    height: 154px;
                    width: 126px;
                }

                .immersionDeckConnectorSvg2 {
                    width: 98px;
                    height: 148px;
                }

                .immersionDeckConnectorSvg4 {
                    width: 82px;
                    height: 167px;
                }

                .immersionDeckTimeLabel {
                    font-size: 12px;
                    font-family: var(--go-semibold);
                    text-transform: uppercase;
                    line-height: 150%;
                    letter-spacing: 1px;
                    color: #E5E5E5;
                }

                .immersionDeckTitle {
                    font-family: var(--go-semibold);
                    font-size: 18px;
                    line-height: 120%;
                    font-weight: 600;
                    color: var(--white);
                    width: 200px;
                    margin: 4px 0;
                }

                .immersionDeckDescription {
                    font-size: 14px;
                    font-family: var(--go-regular);
                    line-height: 120%;
                    color: #E5E5E5;
                    display: block;
                }



                @media (min-width: 1024px) and (max-width: 1280px) {}
            </style>

            <script>
                document.addEventListener('DOMContentLoaded', function () {

                    const section = document.getElementById('immersionDeckSection');
                    const arcFill = document.getElementById('immersionDeckArcFill');
                    const cards = [...document.querySelectorAll('.immersionDeckCard')];
                    const flows = [...document.querySelectorAll('.immersionDeckFlow')];
                    const texts = [...document.querySelectorAll('.immersionDeckText')];
                    const content = document.getElementById('immersionDeckContent');

                    if (!section || !arcFill || typeof gsap === 'undefined') return;

                    gsap.registerPlugin(ScrollTrigger);

                    /* ── Scale content to fit viewport ── */
                    function scaleImmersionDeck() {
                        const viewportH = window.innerHeight;
                        const headerEl = document.querySelector('.immersionDeckHeader');
                        const headerH = headerEl ? headerEl.offsetHeight + 80 : 140;
                        const availableH = viewportH - headerH;
                        const scale = Math.min(1, availableH / 700);
                        const deadSpace = 700 - 700 * scale;

                        content.style.transform = `scale(${scale})`;
                        content.style.transformOrigin = 'bottom center';
                        content.style.marginTop = `-${deadSpace}px`;
                        content.style.marginBottom = '0px';
                    }

                    scaleImmersionDeck();

                    let resizeTimer;
                    window.addEventListener('resize', () => {
                        clearTimeout(resizeTimer);
                        resizeTimer = setTimeout(() => {
                            scaleImmersionDeck();
                            ScrollTrigger.refresh();
                        }, 150);
                    });

                    /* ── Arc setup ── */
                    const arcLen = arcFill.getTotalLength();
                    arcFill.style.strokeDasharray = arcLen;
                    arcFill.style.strokeDashoffset = arcLen;

                    /* ── Reset all to initial hidden state ── */
                    gsap.set('.immersionDeckHeader', { opacity: 0, y: 24, filter: 'blur(8px)' });
                    gsap.set(cards, { opacity: 0 });
                    gsap.set(flows, { opacity: 0 });
                    gsap.set(texts, { opacity: 0, y: 20, filter: 'blur(6px)' });

                    cards.forEach(c => c.classList.remove('active'));
                    flows.forEach(f => f.classList.remove('active'));

                    /* ── Entry animation ── */
                    let entryDone = false;

                    const entryTl = gsap.timeline({
                        scrollTrigger: {
                            trigger: section,
                            start: 'top 50%',
                            once: true,
                        },
                        onComplete: () => { entryDone = true; }
                    });

                    entryTl
                        .to('.immersionDeckHeader', {
                            opacity: 1, y: 0, filter: 'blur(0px)',
                            duration: 1.2, ease: 'power2.out',
                        })
                        .to(cards, {
                            opacity: 1, duration: 0.75, stagger: 0.18, ease: 'power2.out',
                        }, '-=1.1')
                        .to(flows, {
                            opacity: 1, duration: 0.9, stagger: 0.14, ease: 'power2.out',
                        }, '-=0.5')
                        .to(texts, {
                            opacity: 1, y: 0, filter: 'blur(0px)',
                            duration: 0.9, stagger: 0.14, ease: 'power2.out',
                        }, '-=0.4');

                    /* ── Progress applicator ── */
                    let lastOffset = -1;
                    let lastActiveIndex = -2;

                    function applyProgress(p) {
                        p = Math.max(0, Math.min(1, p));

                        /* Only write the SVG offset when it changes by a visible amount */
                        const offset = Math.round(arcLen * (1 - p));
                        if (offset !== lastOffset) {
                            arcFill.style.strokeDashoffset = offset;
                            lastOffset = offset;
                        }

                        /* Only touch the DOM classes when the active card actually changes */
                        const activeIndex = Math.min(Math.floor(p * 4), 3);
                        if (activeIndex !== lastActiveIndex) {
                            lastActiveIndex = activeIndex;
                            cards.forEach((card, i) => card.classList.toggle('active', i <= activeIndex));
                            flows.forEach((flow, i) => flow.classList.toggle('active', i <= activeIndex));
                        }
                    }

                    /* ── Scrub trigger ── */
                    const scrubST = ScrollTrigger.create({
                        trigger: section,
                        start: 'top top',
                        end: 'bottom bottom',
                        scrub: 1,
                        onUpdate: (self) => {
                            applyProgress(self.progress);
                        }
                    });

                    /* ── Recalculate positions once late-loading images change layout ── */
                    function refreshImmersionDeck() {
                        scaleImmersionDeck();
                        ScrollTrigger.refresh();
                    }

                    window.addEventListener('load', refreshImmersionDeck);

                    flows.forEach(flow => {
                        const img = flow.querySelector('img');
                        if (img && !img.complete) {
                            img.addEventListener('load', refreshImmersionDeck, { once: true });
                        }
                    });

                    function restoreImmersionDeckOnTabVisible() {
                        lastOffset = -1;
                        lastActiveIndex = -2;

                        if (entryDone) {
                            gsap.set(cards, { opacity: 1 });
                            gsap.set(flows, { opacity: 1 });
                            gsap.set(texts, { opacity: 1, y: 0, filter: 'blur(0px)' });
                            gsap.set('.immersionDeckHeader', { opacity: 1, y: 0, filter: 'blur(0px)' });
                        }

                        requestAnimationFrame(() => {
                            ScrollTrigger.refresh();
                            applyProgress(scrubST.progress);
                        });
                    }

                    document.addEventListener('visibilitychange', () => {
                        if (document.hidden) return;
                        restoreImmersionDeckOnTabVisible();
                    });

                    window.addEventListener('pageshow', (e) => {
                        if (!e.persisted) return;
                        restoreImmersionDeckOnTabVisible();
                    });

                });
            </script>

            <section class="day-immersion">
                <div class="container">

                    <h2 class="day-immersion__title">A Day in the Immersion</h2>

                    <div class="day-immersion__content" id="slideContent">
                        <img class="day-immersion__icon" id="slideIcon"
                            src="https://images.mastersunion.link/uploads/03062026/v1/newMorning.svg" alt="" />
                        <div class="day-immersion__text">
                            <p class="day-immersion__label" id="slideLabel">Morning</p>
                            <h3 class="day-immersion__heading" id="slideHeading">Business Site Visit</h3>
                            <p class="day-immersion__sub" id="slideSub">Real-world Exposure</p>
                        </div>
                    </div>

                    <div class="day-immersion__wheel">
                        <div class="day-immersion__track" id="wheelTrack"></div>
                    </div>

                </div>
            </section>

            <style>
                .day-immersion {
                    display: none;
                    overflow: hidden;
                    height: 90vh;
                    background-color: var(--black);

                    .day-immersion__title {
                        font-size: 24px;
                        font-weight: 400;
                        line-height: 120%;
                        font-family: var(--go-regular);
                        color: #fff;
                        position: absolute;
                        top: 60px;
                        margin-bottom: auto;
                    }

                    .day-immersion__content {
                        display: flex;
                        align-items: flex-end;
                        gap: 16px;
                        padding: 0 28px;
                        margin-bottom: 10px;
                        position: absolute;
                        bottom: 33%;
                        left: -23%;
                    }

                    .day-immersion__icon {
                        width: 340px;
                        height: 300px;
                        flex-shrink: 0;
                        opacity: 1;
                        transform: none;
                    }

                    .day-immersion__text {
                        display: flex;
                        flex-direction: column;
                        position: absolute;
                        top: 0;
                        left: 50%;
                        width: 500px;
                    }

                    .day-immersion__label {
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 1px;
                        text-transform: uppercase;
                        line-height: 150%;
                        color: #e5e5e5;

                        opacity: 1;
                        transform: none;
                        font-family: var(--go-semibold);

                    }

                    .day-immersion__heading {
                        font-size: 18px;
                        font-weight: 600;
                        line-height: 120%;
                        color: #fff;
                        opacity: 1;
                        transform: none;
                        font-family: var(--go-semibold);
                    }

                    .day-immersion__sub {
                        font-size: 14px;
                        color: #e5e5e5;

                        opacity: 1;
                        transform: none;
                        line-height: 120%;
                    }

                    .day-immersion__wheel {
                        width: 100%;
                        overflow: visible;
                        padding-top: 10px;
                    }

                    .day-immersion__track {
                        position: relative;
                        width: 100%;
                        height: 340px;
                        touch-action: pan-y;
                    }

                    .day-immersion__slide {
                        position: absolute;
                        width: 100%;
                        bottom: 0;
                        transform-origin: center calc(100% + 600px);
                        will-change: transform, filter;
                        cursor: grab;
                        user-select: none;
                    }

                    .day-immersion__slide:active {
                        cursor: grabbing;
                    }

                    .day-immersion__slide img {
                        width: 100%;
                        display: block;
                        pointer-events: none;
                    }
                }

                @media (max-width: 767px) {
                    .day-immersion {
                        display: flex;
                        flex-direction: column;
                        justify-content: flex-end;
                    }
                }
            </style>

            <script>
                const SLIDES_DATA = [
                    {
                        label: 'Morning',
                        heading: 'Business Site Visit',
                        sub: 'Real-world Exposure',
                        icon: 'https://images.mastersunion.link/uploads/03062026/v1/newMorning.svg',
                        img: 'https://cdn.unionstack.link/uploads/23062026/v1/mob1.png'
                    },
                    {
                        label: 'Afternoon',
                        heading: 'On Ground Q&A',
                        sub: 'Interactive Learning',
                        icon: 'https://images.mastersunion.link/uploads/03062026/v1/newAfternoon.svg',
                        img: 'https://cdn.unionstack.link/uploads/23062026/v1/mob2.png'
                    },
                    {
                        label: 'Midday',
                        heading: 'CXO Session',
                        sub: 'Leadership Insights',
                        icon: 'https://images.mastersunion.link/uploads/03062026/v1/newMidday.svg',
                        img: 'https://cdn.unionstack.link/uploads/23062026/v1/mov3.png'
                    },
                    {
                        label: 'Evening',
                        heading: 'Reflection Session',
                        sub: 'Deep Thinking',
                        icon: 'https://images.mastersunion.link/uploads/03062026/v1/newEvening.svg',
                        img: 'https://cdn.unionstack.link/uploads/23062026/v1/mob4.png'
                    }
                ];

                const TOTAL = SLIDES_DATA.length;
                const DEG = 12;
                const TILT = 0.7;
                const VISIBLE = 2;
                const POOL_SIZE = VISIBLE * 2 + 1;

                const labelEl = document.getElementById('slideLabel');
                const headingEl = document.getElementById('slideHeading');
                const subEl = document.getElementById('slideSub');
                const iconEl = document.getElementById('slideIcon');
                const track = document.getElementById('wheelTrack');

                function updateContent(index) {
                    const s = SLIDES_DATA[((index % TOTAL) + TOTAL) % TOTAL];
                    labelEl.textContent = s.label;
                    headingEl.textContent = s.heading;
                    subEl.textContent = s.sub;
                    iconEl.src = s.icon;
                }

                const pool = [];
                for (let i = 0; i < POOL_SIZE; i++) {
                    const card = document.createElement('div');
                    card.className = 'day-immersion__slide';
                    const img = document.createElement('img');
                    img.alt = '';
                    card.appendChild(img);
                    track.appendChild(card);
                    pool.push(card);
                }

                let angleDeg = 0;
                let current = 0;

                function render(angle, instant) {
                    const centreSlot = Math.round(angle / DEG);
                    pool.forEach((card, pi) => {
                        const offset = pi - VISIBLE;
                        const slotIndex = centreSlot + offset;
                        const dataIdx = ((slotIndex % TOTAL) + TOTAL) % TOTAL;
                        const data = SLIDES_DATA[dataIdx];

                        const img = card.querySelector('img');
                        if (img.src !== data.img) img.src = data.img;

                        const rot = slotIndex * DEG - angle;
                        const absRot = Math.abs(rot);
                        const gray = Math.min(absRot / DEG, 1);
                        const brightness = 1 - gray * 0.55;
                        const scale = 1 - gray * 0.05;
                        const lift = absRot * 2.5;
                        const visualRot = rot + rot * TILT;

                        card.style.transition = instant
                            ? 'none'
                            : 'transform 0.45s cubic-bezier(0.25,0.46,0.45,0.94), filter 0.45s ease';
                        card.style.transform = `rotate(${visualRot}deg) translateY(-${lift}px) scale(${scale})`;
                        card.style.filter = `grayscale(${gray}) brightness(${brightness})`;
                        card.style.zIndex = String(50 - Math.round(absRot * 2));
                    });
                }

                function snap(rawAngle) {
                    const nearest = Math.round(rawAngle / DEG);
                    angleDeg = nearest * DEG;
                    current = ((nearest % TOTAL) + TOTAL) % TOTAL;
                    render(angleDeg, false);
                    updateContent(current);
                }

                render(angleDeg, true);
                updateContent(0);

                let startX = 0, startAngle = 0, lastX = 0, dragging = false;

                /* ─── Touch events ───────────────────────────────────────── */
                track.addEventListener('touchstart', e => {
                    if (!e.target.closest('.day-immersion__slide')) return;

                    dragging = true;
                    startX = e.touches[0].clientX;
                    startAngle = angleDeg;
                    lastX = startX;
                    pool.forEach(c => { c.style.transition = 'none'; });
                }, { passive: true });

                track.addEventListener('touchmove', e => {
                    if (!dragging) return;
                    e.preventDefault();
                    const x = e.touches[0].clientX;
                    lastX = x;
                    angleDeg = startAngle - (x - startX) / track.offsetWidth * DEG * 2;
                    render(angleDeg, true);
                }, { passive: false });

                track.addEventListener('touchend', () => {
                    if (!dragging) return;
                    dragging = false;
                    snap(angleDeg);
                });

                /* ─── Mouse events ───────────────────────────────────────── */
                track.addEventListener('mousedown', e => {
                    if (!e.target.closest('.day-immersion__slide')) return;

                    dragging = true;
                    startX = e.clientX;
                    startAngle = angleDeg;
                    lastX = startX;
                    pool.forEach(c => { c.style.transition = 'none'; });
                    e.preventDefault();
                });

                window.addEventListener('mousemove', e => {
                    if (!dragging) return;
                    lastX = e.clientX;
                    angleDeg = startAngle - (e.clientX - startX) / track.offsetWidth * DEG * 2;
                    render(angleDeg, true);
                });

                window.addEventListener('mouseup', () => {
                    if (!dragging) return;
                    dragging = false;
                    snap(angleDeg);
                });
            </script>

