                <script>
                    document.addEventListener("DOMContentLoaded", () => {
                        const screenWidth = window.innerWidth;

                        // For desktop screens (1280px and above)
                        if (screenWidth >= 1280) {
                            const lotties = document.querySelectorAll('dotlottie-player');

                            const isActuallyVisible = (el) => {
                                const rect = el.getBoundingClientRect();
                                const topVisible = rect.top >= 0;
                                const bottomVisible = rect.bottom <= (window.innerHeight || document.documentElement.clientHeight);
                                const heightVisible = rect.height * 0.3; // At least 30% height

                                return rect.top < window.innerHeight &&
                                    rect.bottom > heightVisible; // at least partially visible
                            };

                            const observer = new IntersectionObserver((entries) => {
                                entries.forEach(entry => {
                                    const player = entry.target;

                                    if (entry.isIntersecting && isActuallyVisible(player)) {
                                        player.seek(0); // Reset to start
                                        player.play();  // Play animation
                                    } else {
                                        player.pause(); // Pause if not visible
                                    }
                                });
                            }, {
                                threshold: 0.3,
                            });

                            lotties.forEach(player => {
                                player.pause();
                                observer.observe(player);
                            });

                            // Function to trigger Lottie animations when cards are flipped
                            function triggerLottieOnCardFlip() {
                                const wrappers = document.querySelectorAll(".learnBelowWrapper");

                                wrappers.forEach((card) => {
                                    const rect = card.getBoundingClientRect();
                                    const viewportMid = window.innerHeight / 2;
                                    const isMid = rect.top < viewportMid && rect.bottom > viewportMid;

                                    // Find all Lottie players within this card
                                    const cardLotties = card.querySelectorAll('dotlottie-player');

                                    cardLotties.forEach(player => {
                                        // Check if this player has already started playing for this card flip
                                        const hasStartedPlaying = player.dataset.startedPlaying === 'true';

                                        if (isMid && !hasStartedPlaying) {
                                            // Card is flipped and Lottie hasn't started yet - play Lottie
                                            player.seek(0);
                                            player.play();
                                            player.dataset.startedPlaying = 'true';

                                            // Listen for when the animation completes
                                            player.addEventListener('complete', () => {
                                                // Reset the flag when animation completes
                                                player.dataset.startedPlaying = 'false';
                                            }, { once: true });

                                        } else if (!isMid) {
                                            // Card is not flipped - reset the flag so it can play again when flipped
                                            player.dataset.startedPlaying = 'false';
                                            player.pause();
                                        }
                                    });
                                });
                            }

                            // Call the function on scroll to check for card flips
                            window.addEventListener("scroll", triggerLottieOnCardFlip);
                            window.addEventListener("resize", triggerLottieOnCardFlip);

                            // Initial call
                            triggerLottieOnCardFlip();
                        }

                        // For mobile screens (below 767px)
                        if (screenWidth < 767) {
                            const mobileLotties = document.querySelectorAll('dotlottie-player');

                            const mobileObserver = new IntersectionObserver((entries) => {
                                entries.forEach(entry => {
                                    const player = entry.target;

                                    if (entry.isIntersecting && !player.dataset.played) {
                                        player.seek(0);
                                        player.play();
                                        player.dataset.played = "true"; // mark as played
                                    }

                                    // ❌ Don't pause once it has started playing
                                    // Remove or comment out the pause block
                                    // else if (!entry.isIntersecting) {
                                    //     player.pause();
                                    // }
                                });
                            }, {
                                threshold: 0.1,
                                rootMargin: '50px'
                            });

                            mobileLotties.forEach(player => {
                                player.pause(); // start paused
                                player.dataset.played = ""; // initialize as not played
                                mobileObserver.observe(player);
                            });
                        }


                    });
                </script>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {
                        if (window.innerWidth <= 787) return;

                        const section = document.querySelector(".buildCardSection.new");
                        const wrappers = section.querySelectorAll(".buildCardWrapper");
                        const cards = section.querySelectorAll(".buildCard");
                        const headingWrapper = section.querySelector(".buildHeadingWrapper");
                        const lastCard = cards[cards.length - 1];
                        const stickyThreshold = 260;
                        const scrollDistance = 120;

                        function checkStickyToggle() {
                            const rect = lastCard.getBoundingClientRect();
                            const offset = stickyThreshold - rect.top;

                            if (offset > 0) {
                                const progress = Math.min(offset / scrollDistance, 1);
                                headingWrapper.style.transform = `translateY(-${progress * scrollDistance}px)`;
                                if (progress >= 1) {
                                    headingWrapper.classList.add("unstick");
                                }
                            } else {
                                headingWrapper.style.transform = "translateY(0)";
                                headingWrapper.classList.remove("unstick");
                            }
                        }

                        function checkMidpoints() {
                            wrappers.forEach((card) => {
                                const rect = card.getBoundingClientRect();
                                const viewportMid = window.innerHeight / 2;
                                const isMid = rect.top < viewportMid && rect.bottom > viewportMid;

                                card.classList.toggle("rounded-top", isMid);
                            });
                        }

                        function onScroll() {
                            checkMidpoints();
                            checkStickyToggle();
                        }

                        onScroll();

                        window.addEventListener("scroll", onScroll);
                        window.addEventListener("resize", onScroll);
                    });
                </script>
            </section>

