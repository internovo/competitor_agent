<script>

  $(document).ready(function () {

    $(window).scroll(function () {
      // Get the scrollableSection element and its bounding rectangle
      var section = $('#scrollableSection');
      var growingDiv = $('#growingDiv');
      var rect = section[0].getBoundingClientRect();

      // Check if the section is in the viewport
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        // Calculate the height of the growingDiv relative to scroll position
        var scrollPosition = $(window).scrollTop() + device;
        var sectionTop = section.offset().top; // Distance from top of the document to section
        var sectionHeight = section.height();

        // Calculate the growth based on how far the user has scrolled into the section
        var growth = Math.min(scrollPosition - sectionTop, sectionHeight);

        // Ensure the growth is non-negative and within the section's bounds
        if (growth > 0 && growth <= sectionHeight) {
          growingDiv.height(growth);
          growingDiv.show();
        } else {
          growingDiv.height(0);
          growingDiv.hide();
        }
      }
    });

    $(window).on('scroll', function () {
      // Get the position of the top of the viewport
      var scrollTop = $(window).scrollTop();

      // Iterate over each box
      $('.feeProcessContainer').each(function () {
        // Get the position of the top of the box
        var boxTop = $(this).offset().top - device2;

        // Check if the top of the box is in the viewport
        if (boxTop <= scrollTop) {
          // If it is, add 'active' class to the box
          $(this).addClass('active');
        } else {
          // If it's not, remove 'active' class from the box
          $(this).removeClass('active');
        }
      });
    });
  });

