            <input type="range" class="form-range" id="emiPrice" min="500000" max="50000000" step="100000">
          </div>
          <div class="mb-3">
            <label class="form-label d-flex justify-content-between"><span>Down Payment</span> <span class="fw-semibold" id="emiDownPaymentValue"></span></label>
            <input type="range" class="form-range" id="emiDownPaymentPercent" min="0" max="90" step="5" value="20">
          </div>
          <div class="mb-3">
            <label class="form-label d-flex justify-content-between"><span>Interest Rate</span> <span class="fw-semibold" id="emiRateValue"></span></label>
            <input type="range" class="form-range" id="emiRate" min="6" max="15" step="0.1" value="8.5">
          </div>
          <div class="mb-0">
            <label class="form-label d-flex justify-content-between"><span>Loan Tenure</span> <span class="fw-semibold" id="emiTenureValue"></span></label>
            <input type="range" class="form-range" id="emiTenure" min="1" max="30" step="1" value="20">
          </div>
        </div>
        <div class="col-md-6">
          <div class="bg-light rounded p-3 h-100 d-flex flex-column justify-content-center text-center">
            <div class="text-muted small">Monthly EMI</div>
