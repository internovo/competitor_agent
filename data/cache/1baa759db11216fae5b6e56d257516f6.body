      <script>
         function lightbox(idx) 
         {
            
             var ninjaSldr = document.getElementById("ninja-slider");
             ninjaSldr.parentNode.style.display = "block";
         
             nslider.init(idx);
         
             var fsBtn = document.getElementById("fsBtn");
             fsBtn.click();
         }
         
         function fsIconClick(isFullscreen, ninjaSldr) { 
             
             if (isFullscreen) {
                 ninjaSldr.parentNode.style.display = "none";
             }
         }
         
         function lightboxs(idx) 
         {
            
             // var ninjaSldr = document.getElementById("gallery");
             // ninjaSldr.parentNode.style.display = "block";
         
             // nslider.init(idx);
         
             // var fsBtn = document.getElementById("fsBtn");
             // fsBtn.click();
             $('.gallery').css("display", "block");
             // alert();
         }
         
         
         
         var zoom = 1;
         
         $('.zoom').on('click', function(){
         zoom += 0.1;
         $('.target').css('transform', 'scale(' + zoom + ')');
         });
         $('.zoom-init').on('click', function(){
         zoom = 1;
         $('.target').css('transform', 'scale(' + zoom + ')');
         });
         $('.zoom-out').on('click', function(){
         zoom -= 0.1;
         $('.target').css('transform', 'scale(' + zoom + ')');
         });
         
         function add()
         {
         
         var data=document.getElementById('data');
         var formdata= new FormData(data);
         
         $.ajax({
         type: "POST",
         url: "conatcts",
         data: formdata,
         processData: false,
         contentType: false,
         cache: false,
         success: function (data) 
         {
         
         $('.modal-backdrop').hide();
         $('#first_popup').hide();
         }
         });
         }
         
         
         function adds()
         {
         
         var data=document.getElementById('datas');
         var formdata= new FormData(data);
         
         $.ajax({
         type: "POST",
         url: "conatcts",
         data: formdata,
         processData: false,
         contentType: false,
         cache: false,
         success: function (data) 
         {
         $('#show').show();
         $('.model').hide();
         }
         });
         }
      </script>
