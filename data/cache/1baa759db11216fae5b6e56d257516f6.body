            #first_popup{
            width: 500px;
            /*background: green;*/
            text-align: center;
            box-sizing: border-box;
            /*padding: 10px;*/
            border: 1px solid #333;
            position: fixed;
            top: 25%;
            left: 0;
            right:0;
            display: none;
            z-index: 99;
            margin:0 auto;
            }   
            input.send_btn {
            color: #fff;
            border: none;
            text-transform: uppercase;
            font-size: 13px;
            font-weight: 560;
            width: 150px!important; display: inline-block!important; margin: 0 auto!important; text-align: center!important;
            }
            #first_popup .modal-top, #first_popup .modal-bottom{
            width: 100%;
            position: relative;
            padding:15px;
            }
            #first_popup .modal-top #closeBtn {
            position: absolute;
            top: -15px;
            right: -15px;
            width: 36px;
            border-radius: 50%;
            height: 36px;
            border: 0px;
            padding: 4px 8px;
            z-index: 99;
            cursor: pointer;
            font-size: 21px;
            text-align: center;
            ;
            }
            #first_popup .modal-content {
            height: 340px;
            border-radius: 0px;
            margin-top: 10px;
            border: none;
            }
            #first_popup .modal-bottom #startNowBtn{
            position: absolute;
            top: -40px;
            right: 3px;
            background: rgba(0,0,0,0.3);
            border:0px;
            padding: 7px 15px;
            color: #fff;
            cursor: pointer;
            text-decoration: none;
            font-size: 17px;
            border-radius: 8px;
            }
            #first_popup:hover .modal-bottom #startNowBtn{
            background: green;
            color: #fff;
            }
            #first_popup .modal-content img{
            width: 100%;
            } 
            
            
