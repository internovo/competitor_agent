<script type="text/javascript">

function whatsapp_rohan() {
   var country = document.getElementById("country");
   var input  = document.getElementById("ph_number");
   var resMsg = document.getElementById("whResMsg");
   var errMsg = document.getElementById("whErrMsg");
   var loader = document.getElementById("whLoaderMsg");

   var country_code = country.innerText.trim();
   var phone = input.value.trim();

   // Reset messages
   resMsg.innerText = "";
   errMsg.innerText = "";

   // 🔎 Validation rules
   if (country_code === "" || country_code === "Select") {
       errMsg.innerText = "Please select a country code.";
       return;
   }

   if (phone === "") {
       errMsg.innerText = "Please enter your WhatsApp number.";
       return;
   }

   if (!/^\d{10,15}$/.test(phone)) {
       errMsg.innerText = "Please enter a valid WhatsApp number (10–15 digits only).";
       return;
   }

   // ✅ Show loader
   loader.style.display = "block";
   loader.innerText = "Sending... Please wait";

   var xhttp = new XMLHttpRequest();
   xhttp.onreadystatechange = function () {
        if (this.readyState == 4) {
            loader.style.display = "none"; // hide loader

            if (this.status == 200) {
                resMsg.innerText =
                "Please check your WhatsApp. You will receive a message shortly.";

                // ✅ Reset dropdown + input
                country.innerText = "Select";
                input.value = "";
            } else {
                errMsg.innerText = "Something went wrong. Please try again.";
            }
        }
   };

   xhttp.open("GET", "https://msgapi.rohanbuilders.com/WA.aspx?projectname=Rohan%20Project&countrycode="+country_code+"&recipientno="+phone+"&templatename=auto_trigger_bot_response&attributes=Rohan%20Project&sources=OWN%20WEBSITE&sourdesid=msgapi-WA", true);
   xhttp.send();
}


// ✨ Clear messages & loader on modal close
document.querySelectorAll(".csModalOut--whatsapp, .blackOut").forEach(el => {
  el.addEventListener("click", function() {
     document.getElementById("whResMsg").innerText = "";
     document.getElementById("whErrMsg").innerText = "";
     document.getElementById("whLoaderMsg").style.display = "none";
     document.getElementById("whLoaderMsg").innerText = "";
  });
});



document.addEventListener("DOMContentLoaded", function () {
    const img = document.querySelector(".show-adira-only");

    const allowedPages = [
        "/mumbai-homes/adira/",
        "/pune-homes/abhilasha-4/"
    ];

    if (img && allowedPages.includes(window.location.pathname)) {
        img.style.display = "block";
    }
});

</script>





