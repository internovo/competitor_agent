            let targetTab = element.getAttribute('data-tab');
            if(targetTab){
              document.querySelector(`.desktopNav li .megaDropDownLinks[data-tab="${targetTab}"]`).innerHTML = element.innerHTML;
            }
            element.remove();
          });
          document.querySelector('.megaMenuData').remove();	
        }
      
      
      
