https://myaccount.homebazaar.com/images/home-banner-img.webp","h1":"","title":"Lodha Marquise, Worli Mumbai: 2, 3, 4 BHK Apartments from Rs. 7.47 Cr","description":"Find all details about Lodha Marquise, by Lodha Group. Explore Lodha Marquise in Worli with amenities, photos, street view and brochure. Lodha Marquise, price starts from Rs. 7.47 Cr","priceOnwards":"₹ 7.47 Cr Onwards","keywords":"Lodha Marquise, Lodha Marquise Pandurang Budhkar Marg, Lodha Marquise Worli, Lodha Marquise Price, Lodha Marquise location, Lodha Marquise reviews, Lodha Marquise address, Lodha Marquise Pandurang Budhkar Marg Worli, Lodha Marquise Possession Date","locality":"Worli, Mumbai","propertyName":"Lodha Marquise","property_id":2238,"property_configuration":""},"originalUrl":"https://www.homebazaar.com/lodha-marquise-worli-2238","footerData":{"popular_part":[],"others":[],"real_estate":[]},"message":"success","data":{"overview":{"projectSize":"67 Storeys","floorNumber":"","bathroomCount":"","parkings":"","projectArea":"17  Acres","reraNumber":"P51900001339","charges":"","noOfBalcony":"","monthNotice":"","gatedCommunity":"","datePublished":"2021-03-25","dateModified":"2026-09-02","p_propety_buyorrent":"buy","tower_details":null,"advertiserReraNumber":"A52000000045","projectDescription":"\u003cp\u003eLodha Marquise is a soaring tower inside the vast residential complex of Lodha The Park. Its 2, 3, and 4 BHK air-conditioned flats are spacious in design and equipped with designer marble floors \u0026amp; bath fittings. The property is designed by Woha, a Singaporean architecture firm and includes fabulous amenities such as a private theatre, cafe, library, luxury spa, outdoor gym, \u0026amp; business centre. A fruit orchard, butterfly park, \u0026amp; picnic trail further add serenity to Lodha Marquise. Based at Lower Parel, the property features reputed schools, colleges, healthcare, and malls in its vicinity. These include iconic landmarks such as Siddhivinayak Temple, IKEA, KEM Hospital, \u0026amp; Phoenix Palladium Mall. The Bandra-Worli Sea Link \u0026amp; Eastern Express Highway further provide quick travel times to business hubs across the city. With luxury homes in such a prime location, Marquise at Lodha Park brings an elegant lifestyle in South Mumbai.\u003c/p\u003e","why_title":null,"why_section":"","facings":"","possessionStatus":"Ready Possession","minCarpetArea":1348,"maxCarpetArea":1526,"p_area_type":"Carpet Area","areaUnit":"Sq.ft","emiInstallmentDisplay":"454,076 / month","projectDescription_plainText":"Lodha Marquise is a soaring tower inside the vast residential complex of Lodha The Park. Its 2, 3, and 4 BHK air-conditioned flats are spacious in design and equipped with designer marble floors \u0026 bath fittings. The property is designed by Woha, a Singaporean architecture firm and includes fabulous amenities such as a private theatre, cafe, library, luxury spa, outdoor gym, \u0026 business centre. A fruit orchard, butterfly park, \u0026 picnic trail further add serenity to Lodha Marquise. Based at Lower Parel, the property features reputed schools, colleges, healthcare, and malls in its vicinity. These include iconic landmarks such as Siddhivinayak Temple, IKEA, KEM Hospital, \u0026 Phoenix Palladium Mall. The Bandra-Worli Sea Link \u0026 Eastern Express Highway further provide quick travel times to business hubs across the city. With luxury homes in such a prime location, Marquise at Lodha Park brings an elegant lifestyle in South Mumbai."},"property_link":"https://www.homebazaar.com/lodha-marquise-worli-2238","amenity":{"amenities":[{"name":"Club house","icon":"https://d1uczv4l7tlcpy.cloudfront.net/admin/public/images/amenities_icon/1646132487.webp","filePath":"1646132487.webp","imageName":"club-house","alt":"Lodha Marquise - Club house"},{"name":"Conference Room","icon":"https://d1uczv4l7tlcpy.cloudfront.net/admin/public/images/amenities_icon/1646130668.webp","filePath":"1646130668.webp","imageName":"conference-room","alt":"Lodha Marquise - Conference Room"},{"name":"Jogging Track","icon":"https://d1uczv4l7tlcpy.cloudfront.net/admin/public/images/amenities_icon/1645786601.webp","filePath":"1645786601.webp","imageName":"jogging-track","alt":"Lodha Marquise - Jogging Track"},{"name":"Sports Courts","icon":"https://d1uczv4l7tlcpy.cloudfront.net/admin/public/images/amenities_icon/1646132949.webp","filePath":"1646132949.webp","imageName":"sports-courts","alt":"Lodha Marquise - Sports Courts"},{"name":"Kids Play Area","icon":"https://d1uczv4l7tlcpy.cloudfront.net/admin/public/images/amenities_icon/1646130772.webp","filePath":"1646130772.webp","imageName":"kids-play-area","alt":"Lodha Marquise - Kids Play Area"},{"name":"Swimming Pool","icon":"https://d1uczv4l7tlcpy.cloudfront.net/admin/public/images/amenities_icon/1646130785.webp","filePath":"1646130785.webp","imageName":"swimming-pool","alt":"Lodha Marquise - Swimming Pool"},{"name":"Jacuzzi","icon":"https://d1uczv4l7tlcpy.cloudfront.net/admin/public/images/amenities_icon/1646130823.webp","filePath":"1646130823.webp","imageName":"jacuzzi","alt":"Lodha Marquise - Jacuzzi"},{"name":"Yoga Zone","icon":"https://d1uczv4l7tlcpy.cloudfront.net/admin/public/images/amenities_icon/1646130838.webp","filePath":"1646130838.webp","imageName":"yoga-zone","alt":"Lodha Marquise - Yoga Zone"},{"name":"Gym","icon":"https://d1uczv4l7tlcpy.cloudfront.net/admin/public/images/amenities_icon/1646130931.webp","filePath":"1646130931.webp","imageName":"gym","alt":"Lodha Marquise - Gym"},{"name":"Party Lawn","icon":"https://d1uczv4l7tlcpy.cloudfront.net/admin/public/images/amenities_icon/1646130993.webp","filePath":"1646130993.webp","imageName":"party-lawn","alt":"Lodha Marquise - Party Lawn"},{"name":"Pet Park","icon":"https://d1uczv4l7tlcpy.cloudfront.net/admin/public/images/amenities_icon/1646131068.webp","filePath":"1646131068.webp","imageName":"pet-park","alt":"Lodha Marquise - Pet Park"},{"name":"Amphitheater","icon":"https://d1uczv4l7tlcpy.cloudfront.net/admin/pu