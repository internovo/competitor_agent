:true},{"@type":"LocationFeatureSpecification","name":"Snooker/Pool/Billiards","value":true},{"@type":"LocationFeatureSpecification","name":"Gazebo","value":true},{"@type":"LocationFeatureSpecification","name":"Power Backup","value":true},{"@type":"LocationFeatureSpecification","name":"Treated Water Supply","value":true},{"@type":"LocationFeatureSpecification","name":"24*7 Water Supply","value":true},{"@type":"LocationFeatureSpecification","name":"Multi-level Parking","value":true},{"@type":"LocationFeatureSpecification","name":"Lift","value":true},{"@type":"LocationFeatureSpecification","name":"24 x 7 Security","value":true},{"@type":"LocationFeatureSpecification","name":"CCTV / Video Surveillance","value":true},{"@type":"LocationFeatureSpecification","name":"Intercom Facility","value":true},{"@type":"LocationFeatureSpecification","name":"Cafe / Coffee Bar","value":true},{"@type":"LocationFeatureSpecification","name":"Sauna","value":true},{"@type":"LocationFeatureSpecification","name":"Indoor Games","value":true},{"@type":"LocationFeatureSpecification","name":"Spa","value":true},{"@type":"LocationFeatureSpecification","name":"Jacuzzi","value":true},{"@type":"LocationFeatureSpecification","name":"Senior Citizen Area","value":true},{"@type":"LocationFeatureSpecification","name":"Normal Park / Central Green","value":true}],"subjectOf":[{"@id":"https://www.squareyards.com/mumbai-residential-property/h-rishabraj-phoenix/181152/project#video-1"}]},{"@type":"FAQPage","@id":"https://www.squareyards.com/mumbai-residential-property/h-rishabraj-phoenix/181152/project#faq","isPartOf":{"@id":"https://www.squareyards.com/mumbai-residential-property/h-rishabraj-phoenix/181152/project#webpage"},"mainEntity":[{"@type":"Question","name":"What are the key features of H Rishabraj Phoenix?","acceptedAnswer":{"@type":"Answer","text":"H Rishabraj Phoenix offers amenities such as a swimming pool, power backup, 24 x 7 security, a central green park, and indoor games, ensuring a comfortable and enjoyable living experience."}},{"@type":"Question","name":"Who is responsible for the development of H Rishabraj Phoenix?","acceptedAnswer":{"@type":"Answer","text":"The project is being developed by H Rishabraj Builders and Developers, who have a portfolio of 40 projects."}},{"@type":"Question","name":"Is H Rishabraj Phoenix registered with RERA?","acceptedAnswer":{"@type":"Answer","text":"Yes, H Rishabraj Phoenix is RERA-registered under the registration number P51800033878."}},{"@type":"Question","name":"What is the status of construction at H Rishabraj Phoenix?","acceptedAnswer":{"@type":"Answer","text":"The construction of H Rishabraj Phoenix is currently at the mid-stage."}},{"@type":"Question","name":"How far is H Rishabraj Phoenix from essential services and landmarks?","acceptedAnswer":{"@type":"Answer","text":"H Rishabraj Phoenix is conveniently located near various essential services, with a school just 0.16 km away, a hospital 0.37 km away, and a restaurant only 0.06 km away."}},{"@type":"Question","name":"What types of apartment configurations are available in H Rishabraj Phoenix?","acceptedAnswer":{"@type":"Answer","text":"The project features 3 BHK apartments with sizes ranging from 849 sq. ft. to 1275 sq. ft."}},{"@type":"Question","name":"What is the expected price range for units in H Rishabraj Phoenix?","acceptedAnswer":{"@type":"Answer","text":"The price range for rental units in H Rishabraj Phoenix is between 30,000 to 50,000, while resale units are listed from 3.30 crore to 23.00 crore."}}]},{"@type":"VideoObject","@id":"https://www.squareyards.com/mumbai-residential-property/h-rishabraj-phoenix/181152/project#video-1","name":"H Rishabraj Phoenix, Borivali West, Mumbai | Project Video","description":"Project video of H Rishabraj Phoenix, a 3, 4 BHK BHK residential development by H Rishabraj Builders and Developers in Borivali West, Mumbai, showing the towers, amenities and layout.","thumbnailUrl":"https://static.squareyards.com/resources/images/mumbai/project-image/h-rishabraj-phoenix-project-project-large-image1-1066.jpg","uploadDate":"2026-08-13T00:00:00+05:30","contentUrl":["https://img.squareyards.com/rcheck/projectvideos/181152-h-rishabraj-phoenix-mumbai-20250213093030.mp4","https://img.squareyards.com/rcheck/projectvideos/181152-builder-rishabraj-phoenix-trim-20260813180217.mp4"],"url":"https://www.squareyards.com/mumbai-residential-property/h-rishabraj-phoenix/181152/project","publisher":{"@id":"https://www.squareyards.com/#organization"},"about":{"@id":"https://www.squareyards.com/mumbai-residential-property/h-rishabraj-phoenix/181152/project#project"}}]}</script>

