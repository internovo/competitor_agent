<!-- ===== Core JS: menu + CTA tracking + reveal ===== -->
<script>
window.REM={menu:function(open){document.getElementById('mnav').classList.toggle('open',open);document.getElementById('mnavBack').classList.toggle('open',open);document.body.style.overflow=open?'hidden':''}};
document.addEventListener('keydown',function(e){if(e.key==='Escape')REM.menu(false)});
/* CTA / lead click tracking (preserved from P0) */
(function(){function remWaRef(a){try{var u=new URL(a.getAttribute('href'),location.origin);if(!/(^|\.)wa\.me$/.test(u.hostname)&&!/whatsapp\.com$/.test(u.hostname))return;var t=u.searchParams.get('text')||'';if(t.indexOf('(ref:')>-1)return;/* 2026-08-31: never emit an empty path token. The old line appended the path unconditionally, so on the homepage a CTA with no text of its own shipped a message that was nothing but a greeting and an empty path token. A path only earns a place in the message when it carries information; wabot extract_ref() strips the token either way and every CTA click is separately beaconed to /api/cta-click, so homepage attribution is not lost. A listing id in the URL becomes a reference the customer can actually read. */var p=(location.pathname||'/');if(!t)t="Hi, I'm looking for a property in Mumbai. Please help me with suitable options.";/* 2026-09-07: this took the trailing number off ANY path and called it a Property ID. Project URLs end -project-<id>, so a projects.id shipped as a listing id and the bot answered 'no longer available' about a project the page was advertising. Match the project shape FIRST and name it correctly. */var pm=p.match(/-project-(\d+)\/?$/);var m=pm||p.match(/-(\d{5,})\/?$/)||p.match(/\/property\/(\d+)/);if(m&&t.indexOf('Reference:')<0)t+='\n\nReference: '+(pm?'Project ID ':'Property ID ')+m[1];if(p&&p!=='/')t+='\n\n(ref: '+p.slice(0,110)+')';u.searchParams.set('text',t);a.setAttribute('href',u.toString());}catch(e){}}function track(t,d){try{gtag('event','generate_lead',{event_category:'cta',event_label:t,cta_type:t,page_path:location.pathname,page_title:document.title})}catch(e){}try{navigator.sendBeacon('/api/cta-click',new Blob([JSON.stringify({type:t,page:location.pathname,title:document.title,ref:document.referrer,detail:d||''})],{type:'application/json'}))}catch(e){}}
document.addEventListener('click',function(e){var a=e.target.closest('a');if(!a)return;var h=a.getAttribute('href')||'';var t=null;if(/wa\.me|whatsapp/i.test(h))t='whatsapp';else if(/^tel:/i.test(h))t='call';else if(/^mailto:/i.test(h))t='email';if(t){track(t);if(t==='whatsapp')remWaRef(a)}},true);window.REM_TRACK=track})();
/* reveal on scroll */
(function(){var io=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target)}})},{rootMargin:'0px 0px -8% 0px'});document.querySelectorAll('.reveal').forEach(function(el){io.observe(el)})})();
/* auto-slideshow for image galleries (.pd-track with >1 image) */
(function(){
  function initGal(track){
    var imgs=track.querySelectorAll('img'); if(imgs.length<2) return;
    var gal=track.closest('.pd-gallery');
    var dots=document.createElement('div'); dots.className='pd-dots';
    for(var k=0;k<imgs.length;k++){(function(k){var d=document.createElement('span');if(k===0)d.className='on';d.addEventListener('click',function(){go(k);hold()});dots.appendChild(d)})(k)}
    if(gal) gal.appendChild(dots);
    var i=0,timer=null,paused=false;
    function mark(){var s=dots.children;for(var k=0;k<s.length;k++)s[k].className=(k===i?'on':'')}
    function go(n){i=(n+imgs.length)%imgs.length;track.scrollTo({left:i*track.clientWidth,behavior:'smooth'});mark()}
    function next(){go(i+1)}
    function start(){if(!timer&&!paused)timer=setInterval(next,3800)}
    function stop(){clearInterval(timer);timer=null}
    function hold(){paused=true;stop();clearTimeout(hold._t);hold._t=setTimeout(function(){paused=false;start()},9000)}
    track.addEventListener('pointerdown',hold,{passive:true});
    track.addEventListener('mouseenter',stop); track.addEventListener('mouseleave',start);
    var st;track.addEventListener('scroll',function(){clearTimeout(st);st=setTimeout(function(){var n=Math.round(track.scrollLeft/track.clientWidth);if(n!==i){i=n;mark()}},140)},{passive:true});
    if(!matchMedia('(prefers-reduced-motion: reduce)').matches) start();
  }
  function init(){document.querySelectorAll('.pd-track').forEach(initGal)}
  if(document.readyState!=='loading') init(); else document.addEventListener('DOMContentLoaded',init);
})();
</script>
<script>/* header scroll-state: solid+shadow once scrolled */(function(){function init(){var h=document.querySelector(".site-header");if(!h)return;var on=function(){h.classList.toggle("scrolled",window.scrollY>8)};on();window.addEventListener("scroll",on,{passive:true})}if(document.readyState!=="loading")init();else document.addEventListener("DOMContentLoaded",init)})();</script>

<script>
window.PD={
  lead:function(){document.getElementById('leadModal').classList.add('open');document.getElementById('leadBack').classList.add('open');document.body.style.overflow='hidden';setTimeout(function(){document.getElementById('leadName').focus()},250)},
  close:function(){document.getElementById('leadModal').classList.remove('open');document.getElementById('leadBack').classList.remove('open');document.body.style.overflow=''},
  submit:function(){
    var n=document.getElementById('leadName').value.trim(),p=document.getElementById('leadPhone').value.replace(/[^0-9]/g,'');
    if(n.length<2||p.length<10){document.getElementById('leadErr').style.display='block';return}
    try{fetch('/api/enquiry',{method:'POST',headers:{'Content-Type':'application/json'},keepalive:true,body:JSON.stringify({name:n,phone:p,message:"Laxmi Shrushti"+' — '+"Sane Guruji Nagar Marg, near Police Quarters, Goregaon West",page_url:location.href,source:'REM Website - Project'})});}catch(e){}
    if(window.REM_TRACK)REM_TRACK('whatsapp','project_lead');
    window.open("https://wa.me/919820075868?text=Hi%2C%20I%27m%20interested%20in%20Laxmi%20Shrushti%20in%20Sane%20Guruji%20Nagar%20Marg%2C%20near%20Police%20Quarters%2C%20Goregaon%20West.%20Please%20share%20the%20latest%20pricing%2C%20configurations%20and%20availability.",'_blank');PD.close();
  }
};
document.addEventListener('keydown',function(e){if(e.key==='Escape')PD.close()});
</script>

</body>
</html>