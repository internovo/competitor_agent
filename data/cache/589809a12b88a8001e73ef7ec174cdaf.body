at=auto,w=768,fit=crop/YKb8oDGo96fVJlPX/picture9-mxB2xwN8q0uyzKW0.png 604w,https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1440,fit=crop/YKb8oDGo96fVJlPX/picture9-mxB2xwN8q0uyzKW0.png 1208w" sizes="(min-width: 920px) 604px, 50vw" height="false" width="604" loading="eager" class="image__image--unstyled" data-v-e7628ce9><!--[--><!--]--></div><!--]--><!--[--><div title="Amenities Paradigm Anantaara Borivali West, Paradigm Anantara, Paradigm Shimpoli, Paradigm Anantara Shimpoli" style="--9c00fd5c:49.34640522875817vw;--09ad0563:0vw;--5de16d65:100%;--4beec8a0:auto;" class="image image--zoom image--unstyled" data-selector="data-image" data-animation-role="image" data-v-1fc157e8 data-v-e7628ce9><img alt="Amenities Paradigm Anantaara Borivali West, Paradigm Anantara, Paradigm Shimpoli, Paradigm Anantara Shimpoli" src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,fit=crop/YKb8oDGo96fVJlPX/picture10-mP43X1BNyMCwbNkq.png" srcset="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=375,fit=crop/YKb8oDGo96fVJlPX/picture10-mP43X1BNyMCwbNkq.png 172w,https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=375,fit=crop/YKb8oDGo96fVJlPX/picture10-mP43X1BNyMCwbNkq.png 344w,https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,fit=crop/YKb8oDGo96fVJlPX/picture10-mP43X1BNyMCwbNkq.png 452w,https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,fit=crop/YKb8oDGo96fVJlPX/picture10-mP43X1BNyMCwbNkq.png 516w,https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=768,fit=crop/YKb8oDGo96fVJlPX/picture10-mP43X1BNyMCwbNkq.png 604w,https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1440,fit=crop/YKb8oDGo96fVJlPX/picture10-mP43X1BNyMCwbNkq.png 1208w" sizes="(min-width: 920px) 604px, 50vw" height="false" width="604" loading="eager" class="image__image--unstyled" data-v-e7628ce9><!--[--><!--]--></div><!--]--><!--]--></div><!--]--></div><!--]--></div><!----><!----><!----><!----><!----><!----><!--[--><!--]--><!--]--></div><div class="layout-element layout-element--layout layout-element transition transition--slide" style="--text:left;--align:flex-start;--justify:flex-start;--m-element-margin:0 0 16px 0;--z-index:3;--grid-row:5/6;--grid-column:1/2;--m-grid-row:6/7;--m-grid-column:1/2;--7c3810b2:24px;--36d4e892:24px;" data-v-4edbe80f><!--[--><!----><!----><!----><!----><!----><div class="text-box layout-element__component layout-element__component--GridTextBox" id="zHZa08" data-v-4edbe80f style="--54285089:break-spaces;--6191828b:break-spaces;"><p class="body" dir="auto">*ARTIST IMAGES</p></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!--[--><!--]--><!--]--></div><div class="layout-element layout-element--layout layout-element transition transition--slide" style="--text:justify;--align:flex-start;--justify:flex-start;--m-element-margin:0 0 16px 0;--z-index:4;--grid-row:7/8;--grid-column:1/3;--m-grid-row:8/9;--m-grid-column:1/2;--7c3810b2:226px;--36d4e892:602px;" data-v-4edbe80f><!--[--><!----><!----><!----><!----><!----><div class="text-box layout-element__component layout-element__component--GridTextBox" id="zny8rp" data-v-4edbe80f style="--54285089:normal;--6191828b:normal;"><h5 dir="auto">Location Advantages</h5><p class="body" dir="auto">Strategically located in <strong>Shimpoli, Borivali West</strong>, Paradigm Anantaara ensures smooth connectivity and a well-developed social infrastructure:</p><ul dir="auto"><li><p class="body" dir="auto"><strong>Connectivity:</strong> Easy access to <strong>Western Express Highway</strong>, Link Road, and Borivali Railway &amp; Metro stations.</p></li><li><p class="body" dir="auto"><strong>Education:</strong> Close to reputed schools &amp; colleges like Don Bosco High School, Swami Vivekanand International School, and Rustomjee International.</p></li><li><p class="body" dir="auto"><strong>Healthcare:</strong> Proximity to top hospitals such as Karuna Hospital and Apex Superspeciality Hospital.</p></li><li><p class="body" dir="auto"><strong>Lifestyle:</strong> Quick access to shopping malls, supermarkets, entertainment hubs, and fine dining restaurants.</p></li><li><p class="body" dir="auto"><strong>Recreation:</strong> Located near Sanjay Gandhi National Park and Gorai beach for weekend getaways.</p></li></ul></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!--[--><!--]--><!--]--></div><!--]--><!--]--></div><!----><!----><!----><!----><!----><!----><!----></section><section id="maharera" class="block" style="--rows:9;--width:1224px;--row-gap:0px;--row-size:64px;--column-gap:0px;--block-padding-top:40px;--block-padding:40px 0px 40px 0px;--block-padding-right:0px;--block-padding-bottom:40px;--block-padding-left:0px;--m-block-padding:64px 16px 64px 16px;--grid-gap-history:16px 24px;" data-v-d87a02d1><div class="block-background" data-v-d87a02d1 style="--21fe064a:rgb(255, 255, 255);--38b011f4:50%;--354660b6:0%;--6b53147f:50%;--bf4a5566:center;"><!----><!----><!----></div><div class="block-layout block-layout--layout" style="--m-grid-template-rows:4.444444444444445vw auto 4.444444444444445vw auto 9.166666666666666vw auto 4.444444444444445vw auto 17px;--t-grid-template-rows:minmax(16px, auto) minmax(156px, auto) minmax(16px, auto) minmax(161px, auto) minmax(33px, auto) minmax(24px, auto) minmax(16px, auto) minmax(48px, auto) 1fr;--small-desktop-grid-template-rows:auto 0.7352941176470589vw auto 0.5718954248366013vw auto 1.3071895424836601vw auto 30px;--grid-template-rows:minmax(31px, auto) minmax(9px, auto) minmax(153px, auto) minmax(7px, auto) minmax(24px, auto) minmax(16px, auto) minmax(24px, auto) 1fr;--m-grid-template-columns:50% 50%;--grid-template-columns:12.5% 28.594771241830063% 16.830065359477125% 42.07516339869281%;--m-block-min-height:auto;--t-block-min-height:487px;--small-desktop-block-min-height:auto;--block-min-height:294px;--cf684206:1224px;--1b0ec2ff:360px;--b11075fe:0 4.444444444444445vw;--5a2609c5:0 16px;" data-v-d87a02d1><!--[--><!--[--><div class="layout-element layout-element--layout 