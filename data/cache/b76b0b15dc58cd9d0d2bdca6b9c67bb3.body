ddress":"Shop No 8, Gr. Floor, 103/105, Shreenath Bhawan, Old Hanuman Road, Kalbadevi Road, Mumbai MH 400002 IN","TokenAmount":"100000","BankDetails":{"accountName":"","accountNumber":"","bankName":"","ifsc":""},"OnlinePayment":0},"RMCardData":{"projectId":14180,"rmId":2776,"name":"Aijaz Nalband","experience":"","rating":"4.5","reviewCount":"","profileImage":"https://cdn.blox.xyz/users/080526111634-img-20260113-111125-aijaznalband.webp","headerText":"Our team is here to help you with any questions”","subHeaderText":"One of our RMs will assist you.","contactNumber":"7977272815"},"seoDetails":{"title":"Continue booking Shreeji Eternity","url":"","slug":"","canonical":"https://blox.xyz/projects/shreeji-eternity","description":"Continue booking Shreeji Eternity","imageUrl":"","keyword":"","robots":"noindex, nofollow"},"configId":41774}}},"ReraInfo":{"P51800054233":{"towerName":"Shreeji Eternity Wing - D","state":"Maharashtra","label":"MahaRERA (Maharashtra Real Estate Regulatory Authority)","url":"https://maharera.maharashtra.gov.in","reraLink":"https://maharera.maharashtra.gov.in/projects-search-result?certificate_no=P51800054233"},"P51800054310":{"towerName":"Shreeji Eternity","state":"Maharashtra","label":"MahaRERA (Maharashtra Real Estate Regulatory Authority)","url":"https://maharera.maharashtra.gov.in","reraLink":"https://maharera.maharashtra.gov.in/projects-search-result?certificate_no=P51800054310"}},"BookPropertyEnabled":false,"structuredData":["\n{\n  \"@context\": \"https://schema.org/\",\n  \"@type\": \"BreadcrumbList\",\n  \"itemListElement\": [{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Mumbai\",\"item\":\"https://blox.xyz/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Properties in Mumbai\",\"item\":\"https://blox.xyz/buy/mumbai/1a256\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Properties in Malad West\",\"item\":\"https://blox.xyz/buy/mumbai/malad-west-1a256b7a91\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Shreeji Group\",\"item\":\"https://blox.xyz/buy/mumbai/malad-west-shreeji-group-1a256b7a91b13a199\"},{\"@type\":\"ListItem\",\"position\":5,\"name\":\"Shreeji Eternity\",\"item\":\"https://blox.xyz/projects/shreeji-eternity\"}]\n}","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\"@type\":\"Question\",\"name\":\"When is the possession date for Shreeji Eternity?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Possession date of Shreeji Eternity is 30 Jun 2027\"}},{\"@type\":\"Question\",\"name\":\"What is the RERA carpet area range of Shreeji Eternity?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The RERA carpet area range for Shreeji Eternity is 540 - 1217 sqft\"}},{\"@type\":\"Question\",\"name\":\"What is the price range of Shreeji Eternity?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The price range of Shreeji Eternity is ₹1.68 Cr - 4.03 Cr\"}},{\"@type\":\"Question\",\"name\":\"Where is Shreeji Eternity located?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Shreeji Eternity is located at Shreeji Eternity Experience Centre, Shreeji Eternity, New Link Rd, Near Zenith Hospital, Malad, Orlem, Malad West, Mumbai, Maharashtra-400064.\"}},{\"@type\":\"Question\",\"name\":\"What configurations are available in Shreeji Eternity?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Shreeji Eternity has 2 BHK, 3 BHK configurations.\"}},{\"@type\":\"Question\",\"name\":\"What is the status of Shreeji Eternity?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The status of Shreeji Eternity is Under construction.\"}},{\"@type\":\"Question\",\"name\":\"Which amenities are provided in Shreeji Eternity?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The amenities are CCTV / Video Surveillance, Gymnasium, Indoor Games, Jogging / Cycle Track, Multipurpose Hall, Reflexology, Snooker / Billiards, Spa, Yoga Area.\"}},{\"@type\":\"Question\",\"name\":\"Who is the developer of Shreeji Eternity?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The developer of Shreeji Eternity is Shreeji Group.\"}}]\n}\n","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"Shreeji Eternity\",\n  \"image\": \"https://cdn.blox.xyz/builders/thumb/060722053222-NewProject(93).png\",\n  \"description\": \"Presenting Shreeji Eternity by Shreeji Group, an ultra-modern residential project offering spacious 2 \u0026 3 BHK luxury Homes with private decks, thoughtfully designed for a lifestyle that’s Eternal, Infinite, and Inclusive. Nestled in a prime location, this premium development boasts 4 levels of podium parking and over 30,000+ sq. ft. of world-class lifestyle amenities on the 5th podium level, ensuring you live a life of unmatched grandeur. Every home at Shreeji Eternity is a masterpiece of design and detail, meticulously curated with the finest specifications, refined aesthetics, and unparalleled functionality. From peaceful residential surroundings to excellent connectivity, this address offers proximity to educational institutions, healthcare facilities, shopping centers, and entertainment hubs, making it a perfect blend of convenience and elegance. Whether you're a homebuyer or a real estate investor, Shreeji Eternity promises timeless value and a truly elevated living experience.\",\n  \"brand\": {\n\t\t\"@type\": \"Brand\",\n\t\t\"name\": \"Shreeji Group\"\n\t},\n  \"offers\": {\n\t\t\"@type\": \"AggregateOffer\",\n    \"url\": \"https://blox.xyz/projects/shreeji-eternity\",\n\t\t\"priceCurrency\": \"INR\",\n\t\t\"lowPrice\": \"16769160.00\",\n\t\t\"highPrice\": \"40300000.00\"\n\t}\n}\n","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": [\n      \"SingleFamilyResidence\",\n      \"Product\",\n      \"RealEstateListing\"\n  ],\n  \"@id\": \"https://blox.xyz/projects/shreeji-eternity\",\n  \"mpn\": \"P51800054310,P51800054233\",\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"@id\": \"https://blox.xyz/buy/mumbai/shreeji-group-1a256b13a199\",\n    \"name\": \"Shreeji Group\"\n  },\n  \"url\": \"https://blox.xyz/projects/shreeji-eternity\",\n  \"containedInPlace\": {\n      \"@type\": \"Place\",\n      \"@id\": \"Shreeji Eternity\",\n      \"url\": \"https://blox.xyz/projects/shreeji-eternity\",\n      \"name\": \"Shreeji Eternity\",\n      \"address\": {\n          \"@type\": \"PostalAddress\",\n          \"streetAddress\": \"Shreeji Eternity Experience Centre, Shreeji Eternity, New Link Rd, Near Zenith Hospital, Malad, Orlem, Malad West, Mumbai, Maharashtra-400064\",\n          \"addressLocality\": \"Malad West\",\n          \"addressRegion\": \"Mumbai\",\n          \"postalCode\": \"400064\",\n          \"addressCountry\": \"IN\"\n      }\n  },\n  \"description\": \"Presenting Shreeji Eternity by Shreeji Group, an ultra-modern residential project offering spacious 2 \u0026 3 BHK luxury Homes with private decks, thoughtfully designed for a lifestyle that’s Eternal, Infinite, and Inclusive. Nestled in a prime location, this premium development boasts 4 levels of podium parking and over 30,000+ sq. ft. of world-class lifestyle amenities on the 5th podium level, ensuring you live a life of unmatched grandeur. Every home at Shreeji Eternity is a masterpiece of design and detail, meticulously curated with the finest specifications, refined aesthetics, and unparalleled functionality. From peaceful residential surroundings to excellent connectivity, this address offers proximity to educational institutions, healthcare facilities, shopping centers, and entertainment hubs, making it a perfect blend of convenience and elegance. Whether you're a homebuyer or a real estate investor, Shreeji Eternity promises timeless value and a truly elevated living experience.\",\n  \"floorSize\": [\n      {\n          \"@type\": \"QuantitativeValue\",\n          \"unitCode\": \"SQFT\",\n          \"minValue\": \"540\",\n          \"maxValue\": \"1217\"\n      }\n  ],\n  \"image\": [\n      {\n          \"@type\": \"ImageObject\",\n          \"url\": \"https://cdn.blox.xyz/builders/thumb/060722053222-NewProject(93).png\"\n      }\n  ],\n  \"name\": \"Shreeji Eternity\",\n  \"offers\": {\n      \"@type\": \"Offer\",\n      \"@id\": \"P51800054310,P51800054233\",\n      \"availability\": \"https://schema.org/InStock\",\n      \"name\": \"Sale of Shreeji Eternity Unit\",\n      \"url\": \"https://blox.xyz/projects/shreeji-eternity\",\n      \"price\": 16769160.00,\n      \"priceCurrency\": \"INR\"\n  }\n}\n"],"aiReviewSummary":{"summary":"Shreeji Eternity is generally regarded as a well-located under-construction project that balances modern luxury with urban connectivity. Reviews highlight the project's strategic position near the Valnai-Meeth Chowky Metro Station and the variety of lifestyle amenities planned. However, some feedback mentions concerns regarding the current local environment, such as road quality and the typical density of the Orlem-Link Road area. +1","pros":[{"title":"Strategic Location","description":"The project is situated directly on New Link Road, offering excellent connectivity to the Western Express Highway and SV Road."},{"title":"Metro Connectivity","description":"Residents benefit from being within a 5-minute walking distance of the Valnai-Meeth Chowky Metro Station."},{"title":"Proximity to Social Infrastructure","description":"Leading educational institutions like Ryan International and Billabong High, and major malls like Infiniti and Inorbit, are in the immediate vicinity."},{"title":"Modern Amenities","description":"The development includes over 30,000 sq. ft. of lifestyle facilities, such as a gymnasium, sky-deck balconies, and a dedicated wellness club."},{"title":"Efficient Layouts","description":"Floor plans are frequently described as smartly designed with zero space wastage and Vaastu compliance."},{"title":"Commercial Convenience","description":"The inclusion of a ground-level commercial podium provides residents with seamless access to daily shopping needs."}],"cons":[{"title":"Traffic Congestion","description":"The surrounding New Link Road and Meeth Chowky junction are prone to severe traffic bottlenecks during peak hours."},{"title":"Under-Construction Nuisance","description":"As a developing site, current visitors note road issues like potholes and dust pollution in the immediate surroundings."},{"title":"High Pricing","description":"Some reviewers consider the property prices to be on the higher side or over-hyped compared to the local market average."},{"title":"Limited Open Space","description":"Being a single-tower high-rise on a 0.76-acre plot, there is restricted ground-level open space compared to larger townships."},{"title":"Parking Constraints","description":"Current reviews mention a scarcity of parking spaces in the neighborhood, though the project promises multi-level podium parking upon completion."}],"verdict":["Excellent for commuters","Premium lifestyle choice","High investment potential","Busy urban living","Best for families seeking luxury amenities"]},"googleReviews":{"html_attributions":[],"result":{"rating":4.6,"reviews":[{"author_name":"Radhika Parmar","author_url":"https://www.google.com/maps/contrib/112717736534141404347/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a/ACg8ocLKHcIw1PDLoPTArfqL9x4Qm1FXNRiqebZr4vx2DQ71uAx7nw=s128-c0x00000000-cc-rp-mo","rating":5,"relative_time_description":"10 months ago","text":"If you are planning to buy a property definitely without giving a thought, go for it ✅💯peaceful living,budget friendly homes , great connectivity... And Best Developers in the vicinity","time":1760018970,"translated":false},{"author_name":"ashmimalkan","author_url":"https://www.google.com/maps/contrib/105460701028756355884/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjVqgPnn5SMMvk4ZKVlqnfzP4CM35VSEOVI7qLPkByHgWcWD9WhIRg=s128-c0x00000000-cc-rp-mo","rating":5,"relative_time_description":"10 months ago","text":"We recently visited the Shreeji Eternity site office and were really impressed with the overall experience. The team was professional, the developer’s background gave us a lot of confidence, and you can truly see the attention to detail in every aspect of the project — from the layouts to the amenities. The sample flat beautifully showcases the kind of quality they promise. The best part — they also had some great festive offers going on, which made it even more exciting. Definitely one of the most thoughtfully designed projects we’ve seen in this part of the city.","time":1760089064,"translated":false},{"author_name":"Naina Bhagat","author_url":"https://www.google.com/maps/contrib/111566328894638975532/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjWyaYbk2rBypMosGC5kBofvU8FdFZaxhVqiN9VWwQH2_j_vz8Ks=s128-c0x00000000-cc-rp-mo","rating":5,"relative_time_description":"10 months ago","text":"This housing complex offers a resort-like lifestyle with lush gardens,a banquet and a wide range of sports facilities. They also highlight the family-friendly layout, modern apartments with good quality finishes, and the peaceful environment combined with vibrant community living👍","time":1760062252,"translated":false},{"author_name":"Ishika Singh","author_url":"https://www.google.com/maps/contrib/101811914160787749846/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a/ACg8ocLCwn_BN47JyYEgq-zXQpEFJBKWyz_PVfYG_911xbM-_ApAbw=s128-c0x00000000-cc-rp-mo","rating":5,"relative_time_description":"10 months ago","text":"The project is perfectly located right on the Link Road, offering amazing connectivity. I visited the 3BHK sample flat  what a beautiful layout with zero space wastage! The amenities are top-notch and truly impressive.","time":1760025187,"translated":false},{"author_name":"Rohit Nagrale","author_url":"https://www.google.com/maps/contrib/105968982611188857033/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjXsTlMuBwjA0YAxlk7odIoq-LWQzdYALvDKLeMI0riNkbzOLo4=s128-c0x00000000-cc-rp-mo","rating":5,"relative_time_description":"10 months ago","text":"Shreeji Eternity in Malad West is a premium project offering top-quality construction, spacious flats, and excellent modern amenities. With its prime location and great connectivity, it’s an ideal choice for comfortable living and smart investment.","time":1760075734,"translated":false}],"url":"https://maps.google.com/?cid=4166559507990928629","user_ratings_total":43},"status":"OK"}},"isMobile":false,"footerData":{"featured":{"kolkata":{"label":"Kolkata","id":14},"mumbai":{"label":"Mumbai","id":256},"navi-mumbai":{"label":"Navi Mumbai","id":261},"pune":{"label":"Pune","id":300},"thane":{"label":"Thane","id":269}},"others":{"alibaug":{"label":"Alibaug","id":1907},"bangalore":{"label":"Bangalore","id":95},"noida":{"label":"Noida","id":84},"palghar":{"label":"Palghar","id":264},"raigad":{"label":"Raigad","id":3323},"telangana":{"label":"Telangana","id":3326}}},"__N_SSP":true},"page":"/projects/[project_name]","query":{"project_name":"shreeji-eternity"},"buildId":"t4LZHlTlBLViwyNa5GApO","isFallback":false,"gssp":true,"appGip":true,"scriptLoader":[]}</script></body></html>