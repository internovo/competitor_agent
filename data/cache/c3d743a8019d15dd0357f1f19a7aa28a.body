ic/chunks/1817-cd7bd3182bdc95c5.js\",\"7903\",\"static/chunks/7903-4a5610d50bfe6293.js\",\"6437\",\"static/chunks/6437-9fa51ed60a9e72d8.js\",\"6923\",\"static/chunks/6923-8a825c7cb12529e6.js\",\"6366\",\"static/chunks/6366-86ea8ee9f2b2a0fe.js\",\"1211\",\"static/chunks/1211-6b8fa91d29eab479.js\",\"1134\",\"static/chunks/app/(main)/(effect-navbar)/project/details/%5Bslug%5D/page-386f9c10d4dfae33.js\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"25:T409,"])</script><script>self.__next_f.push([1,"Codename SKYRISE, located on S.V. Road opposite the Kandivali Fire Station in Kandivali\r\nWest, boasts a highly strategic, valuable location. It is perfectly positioned for residents to\r\nshop, socialize, and connect effortlessly within the wider city network. The project\u0026#39;s\r\nexceptional connectivity is a major real estate advantage, with Kandivali Railway Station\r\nonly 0.3 km away and the vital Western Express Highway (WEH) accessible at 2.8 km.\r\nFurthermore, daily conveniences like Dmart, PVR Milaap, and Growels 101 Mall are all well\r\nwithin easy reach. The residential development features thoughtfully planned layouts to\r\nensure superior space utilization and comfort. Residents can look forward to unique amenities\r\nthat cater to a modern lifestyle, including a dedicated Kids Play Area, a Sky Cafe, and a\r\nLearning Center. Unit RERA Carpet Areas are listed at 781 sq. ft. and 1071 sq. ft.. The\r\nproximity to educational institutions and healthcare like ACE Heart Hospital is another key\r\nbenefit. RERA No.: P51800032149."])</script><script>self.__next_f.push([1,"19:[[\"$\",\"$L24\",null,{\"project\":{\"id\":\"cmj11c2ig029bsahfyv3mqrnb\",\"reraBuilderName\":\"Shreeji Construction\",\"reraIds\":[\"P51800032149\"],\"possessionDate\":\"2026-12-31T12:00:00.000Z\",\"projectType\":\"RESIDENTIAL\",\"projectName\":\"Shreeji Skyrise\",\"projectCategory\":\"STANDALONE\",\"slug\":\"shreeji-skyrise-kandivali-west-cmj11c2ig029bsahfyv3mqrnb\",\"marketingT