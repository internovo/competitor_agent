<script>
    (function () {
        document.querySelectorAll('.faq-container .faq-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var item = this.closest('.faq-item');
                var container = this.closest('.faq-container');
                var wasOpen = item.classList.contains('open');
                if (container) {
                    container.querySelectorAll('.faq-item').forEach(function (other) {
                        other.classList.remove('open');
                        var otherBtn = other.querySelector('.faq-toggle');
                        if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                    });
                }
                if (!wasOpen) {
                    item.classList.add('open');
                    this.setAttribute('aria-expanded', 'true');
                }
            });
        });
    })();
</script>

