iants\":0}],[{\"carpet_area\":1025,\"builtup_area\":0,\"price\":41000000,\"down_payment\":6100000,\"parking_type\":1,\"parking\":\"2\",\"availability_status\":\"Available\",\"unit_plan_img\":\"admin/uploads/unit_plans/V_Raheja_La_Serena_3_BHK_1025_sqft_Unit_Plan--1709211654103-img.webp\",\"has_variants\":0},{\"carpet_area\":1150,\"builtup_area\":0,\"price\":45600000,\"down_payment\":6800000,\"parking_type\":1,\"parking\":\"2\",\"availability_status\":\"Available\",\"unit_plan_img\":\"admin/uploads/unit_plans/V_Raheja_La_Serena_3_BHK_1150_sqft_Unit_Plan--1709211654132-img.webp\",\"has_variants\":0}],[{\"carpet_area\":1575,\"builtup_area\":0,\"price\":61600000,\"down_payment\":9200000,\"parking_type\":1,\"parking\":\"2\",\"availability_status\":\"Available\",\"unit_plan_img\":\"admin/uploads/unit_plans/V_Raheja_La_Serena_4_BHK_1575_sqft_Unit_Plan--1709211654170-img.webp\",\"has_variants\":0}]],\"schemes\":[{\"scheme_id\":20,\"scheme_name\":\"CLP ( Construction Link plan)\",\"description\":\"Regular Standard Slabwise Payment  as per construction, Maximum loan possible up to 90%\"}],\"tour_video\":\"https://tours.housiey.com/share/collection/7ZFqK?logo=1\u0026info=0\u0026logosize=143\u0026fs=1\u0026vr=1\u0026sd=1\u0026initload=0\u0026autorotate=0.75\u0026autop=10\u0026autopalt=1\u0026thumbs=1\",\"brocher\":\"admin/uploads/docs/v-raheja-la-serena_brochure.pdf\",\"price_sheet\":\"admin/uploads/docs/v-raheja-la-serena_price_sheet_1785238306404-701077780.pdf\",\"plan_kit\":\"admin/uploads/docs/v-raheja-la-serena_brochure.pdf\",\"payment_schedule\":\"admin/uploads/docs/v-raheja-la-serena_payment_schedule_1762409404972-435634999.pdf\",\"location\":[{\"state\":\"Maharashtra\",\"city\":\"Mumbai\",\"city_id\":15,\"locality\":\"Kandivali West\",\"sub_locality\":\"Patel Nagar\",\"street\":\"Off M.G. road, Patel Nagar, Kandivali West, Mumbai\",\"highlights\":\"Kandivali Railway Station - 1.0km,DMart - 1.5km,Dahanukarwadi Metro Station - 1.6km\",\"link\":\"\",\"lat\":\"19.2061779\",\"lng\":\"72.8435458\"}],\"banks\":[{\"name\":\"HDFC BANK\",\"logo\":\"admin/uploads/banks/1654173060839-img.jpeg\"},{\"name\":\"ICICI Bank\",\"logo\":\"admin/uploads/banks/1647076980347-img.webp\"},{\"name\":\"State Bank Of India\",\"logo\":\"admin/uploads/banks/1647076969275-img.webp\"},{\"name\":\"Axis Bank\",\"logo\":\"admin/uploads/banks/1647076958357-img.webp\"},{\"name\":\"Kotak Mahindra Bank\",\"logo\":\"admin/uploads/banks/1647076944094-img.webp\"},{\"name\":\"Citi Bank\",\"logo\":\"admin/uploads/banks/1647076933858-img.webp\"},{\"name\":\"Bank Of Baroda\",\"logo\":\"admin/uploads/banks/1647076922780-img.webp\"},{\"name\":\"Bank Of India\",\"logo\":\"admin/uploads/banks/1647076911521-img.webp\"},{\"name\":\"Union Bank of India\",\"logo\":\"admin/uploads/banks/1647076899945-img.webp\"},{\"name\":\"Central Bank of India\",\"logo\":\"admin/uploads/banks/1647076883984-img.webp\"}],\"rera_details\":[{\"rera_no\":\"P51800050593\",\"rera_link\":\"https://maharerait.maharashtra.gov.in/public/project/view/44119\",\"rera_qr_image\":\"admin/uploads/RERA-QR-images/P51800050593--1731239324088-img.webp\"}],\"litigation_details\":[],\"legal_doc_records\":[{\"rera_id\":6604,\"rera_no\":\"P51800050593\",\"documents\":[{\"id\":2982,\"doc_id\":\"0\",\"doc_url\":\"admin/uploads/project_legal_docs/1483_1762408401321-801757698.pdf\",\"doc_title\":\"V Raheja La Serena Commencement Certificate\",\"project_name\":\"V Raheja La Serena\",\"doc_category_name\":\"Commencement Certificate\"},{\"id\":2983,\"doc_id\":\"0\",\"doc_url\":\"admin/uploads/project_legal_docs/1483_1762408401465-313456434.pdf\",\"doc_title\":\"V Raheja La Serena Legal Title Report\",\"project_name\":\"V Raheja La Serena\",\"doc_category_name\":\"Legal Title Report\"},{\"id\":2984,\"doc_id\":\"0\",\"doc_url\":\"admin/uploads/project_legal_docs/1483_1762408401679-571443207.pdf\",\"doc_title\":\"V Raheja La Serena Proforma Allotment Letter\",\"project_name\":\"V Raheja La Serena\",\"doc_category_name\":\"Proforma Allotment Letter\"},{\"id\":2985,\"doc_id\":\"0\",\"doc_url\":\"admin/uploads/project_legal_docs/1483_1762408401886-455671992.pdf\",\"doc_title\":\"V Raheja La Serena Proforma Sale Agreement\",\"project_name\":\"V Raheja La Serena\",\"doc_category_name\":\"Proforma Sale Agreement\"}]}],\"interestRate\":7.5}}],[\"$\",\"div\",null,{\"className\":\"md:hidden\",\"children\":[\"$\",\"$L1b\",null,{\"projectName\":\"V Raheja La Serena\",\"localityName\":\"Kandivali West\",\"projectId\":1483}]}],[\"$\",\"$L1c\",null,{\"overviewData\":{\"land_parcel\":2.4,\"project_heading\":\"V Raheja La Serena\",\"area_range_min\":715,\"area_range_max\":1575,\"rera_details\":\"$8:2:props:children:1:props:projectData:rera_details\",\"target_possession\":\"01 December 2027\",\"rera_possession\":\"01 December 2028\",\"no_of_towers\":7,\"no_of_floors\":\"G+5P+17\",\"config\":\"2BHK,3BHK,4BHK\",\"about\":\"$1d\",\"possession_status\":\"Mid Stage (1-2 yrs)\",\"litigation\":\"No\",\"project_city\":\"Mumbai\"},\"faqData\":{\"status\":200,\"success\":true,\"data\":{\"faqs\":[{\"question\":\"Can I visit the sample flat of V Raheja La Serena?\",\"answer\":\"Yes, a sample flat is available for viewing. Currently, the 3BHK show flat is ready and can be visited. Book a free site visit through Housiey and our team will arrange everything.\",\"category\":\"Site Visit\"},{\"question\":\"What is the expected possession date of V Raheja La Serena?\",\"answer\":\"The expected possession date is \u003cb\u003e01 December 2028\u003c/b\u003e as per RERA. Construction is currently \u003cb\u003e65%\u003c/b\u003e complete as of August 6, 2026. Target possession is \u003cb\u003e01 December 2027\u003c/b\u003e.\",\"category\":\"Timeline\"},{\"question\":\"Is V Raheja La Serena RERA registered? What is its RERA number?\",\"answer\":\"Yes, it is RERA registered. The RERA number is \u003cb\u003eP51800050593\u003c/b\u003e.\u003cbr\u003eYou can verify it on the official RERA portal: \u003ca href=\\\"https://maharerait.maharashtra.gov.in/public/project/view/44119\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\" style=\\\"color: #0066cc; text-decoration: underline;\\\"\u003ehttps://maharerait.maharashtra.gov.in/public/project/view/44119\u003c/a\u003e\",\"category\":\"Legal \u0026 Compliance\"},{\"question\":\"Is there any litigation against V Raheja La Serena?\",\"answer\":\"No, it has no pending litigation. All legal documents including the Commencement Certificate and Legal Title Report are available on Housiey for review before booking.\",\"category\":\"Legal \u0026 Compliance\"},{\"question\":\"What legal documents are available for V Raheja La Serena?\",\"answer\":\"The following legal documents are available on Housiey: \u003cb\u003eCommencement Certificate\u003c/b\u003e, \u003cb\u003eLegal Title Report\u003c/b\u003e, \u003cb\u003eProforma Allotment Letter\u003c/b\u003e, \u003cb\u003eProforma Sale Agreement\u003c/b\u003e. You can preview them directly on the project page or verify them independently on the official RERA portal using RERA number \u003cb\u003eP51800050593\u003c/b\u003e.\",\"category\":\"Legal \u0026 Compliance\"},{\"question\":\"What amenities are available in V Raheja La Serena?\",\"answer\":\"This project offers \u003cb\u003e27+\u003c/b\u003e amenities. Key external amenities include Swimming Pool, Fitness Deck, Sun Deck, Walking Track, and Gymnasium.\u003cbr\u003e Internal specifications include Modular Kitchen and Fire Fighting. The complete amenities list is available on Housiey.\",\"category\":\"Amenities\"},{\"question\":\"What are the monthly maintenance charges for V Raheja La Serena?\",\"answer\":\"Monthly maintenance details are available in the price sheet. You can download it from the project page on Housiey.\",\"category\":\"Pricing\"},{\"question\":\"What is the carpet area of a 2BHK in V Raheja La Serena?\",\"answer\":\"In V Raheja La Serena, the 2BHK units are available in the following carpet area options:\u003cbr\u003e• \u003cb\u003e715 sq. ft.\u003c/b\u003e\u003cbr\u003e• \u003cb\u003e725 sq. ft.\u003c/b\u003e\u003cbr\u003e• \u003cb\u003e765 sq. ft.\u003c/b\u003e\u003cbr\u003eEach configuration may differ slightly in layout, balcony size, or orientation. Our team can walk you through floor plans for each option during your consultation or site visit.\",\"category\":\"Configuration\"},{\"question\":\"What is the carpet area of a 3BHK in V Raheja La Serena?\",\"answer\":\"In V Raheja La Serena, the 3BHK units are available in the following carpet area options:\u003cbr\u003e• \u003cb\u003e1025 sq. ft.\u003c/b\u003e\u003cbr\u003e• \u003cb\u003e1150 sq. ft.\u003c/b\u003e\u003cbr\u003eEach configuration may differ slightly in layout, balcony size, or orientation. Our team can walk you through floor plans for each option during your consultation or site visit.\",\"category\":\"Configuration\"},{\"question\":\"What is the carpet area of a 4BHK in V Raheja La Serena?\",\"answer\":\"In V Raheja La Serena, the 4BHK units are available in the following carpet area options:\u003cbr\u003e• \u003cb\u003e1575 sq. ft.\u003c/b\u003e\u003cbr\u003eEach configuration may differ slightly in layout, balcony size, or orientation. Our team can walk you through floor plans for each option during your consultation or site visit.\",\"category\":\"Configuration\"},{\"question\":\"What is the all-inclusive price of a 2BHK in V Raheja La Serena?\",\"answer\":\"The all-inclusive price of a 2BHK in V Raheja La Serena starts from \u003cb\u003e₹2.67 Cr\u003c/b\u003e and varies depending on the carpet area and floor level you choose.\\n\\n\u003cbr\u003e• \u003cb\u003e715 sq. ft.\u003c/b\u003e – ₹2.67 Cr (all-inclusive)\u003cbr\u003e• \u003cb\u003e725 sq. ft.\u003c/b\u003e – ₹2.70 Cr (all-inclusive)\u003cbr\u003e• \u003cb\u003e765 sq. ft.\u003c/b\u003e – ₹2.76 Cr (all-inclusive)\u003cbr\u003eThe price includes the base cost, applicable stamp duty, registration charges, GST, and possession charges. Final pricing may vary based on unit configuration, selected floor, and availability.\",\"category\":\"Pricing\"},{\"question\":\"What is the all-inclusive price of a 3BHK in V Raheja La Serena?\",\"answer\":\"The all-inclusive price of a 3BHK in V Raheja La Serena starts from \u003cb\u003e₹4.10 Cr\u003c/b\u003e and varies depending on the carpet area and floor level you choose.\\n\\n\u003cbr\u003e• \u003cb\u003e1025 sq. ft.\u003c/b\u003e – ₹4.10 Cr (all-inclusive)\u003cbr\u003e• \u003cb\u003e1150 sq. ft.\u003c/b\u003e – ₹4.56 Cr (all-inclusive)\u003cbr\u003eThe price includes the base cost, applicable stamp duty, registration charges, GST, and possession charges. Final pricing may vary based on unit configuration, selected floor, and availability.\",\"category\":\"Pricing\"},{\"question\":\"What is the all-inclusive price of a 4BHK in V Raheja La Serena?\",\"answer\":\"The all-inclusive price of a 4BHK in V Raheja La Serena starts from \u003cb\u003e₹6.16 Cr\u003c/b\u003e and varies depending on the carpet area and floor level you choose.\\n\\n\u003cbr\u003e• \u003cb\u003e1575 sq. ft.\u003c/b\u003e – ₹6.16 Cr (all-inclusive)\u003cbr\u003eThe price includes the base cost, applicable stamp duty, registration charges, GST, and possession charges. Final pricing may vary based on unit configuration, selected floor, and availability.\",\"category\":\"Pricing\"},{\"question\":\"What are the floor plans and configurations available in V Raheja La Serena?\",\"answer\":\"It is built across \u003cb\u003e2.4 acres\u003c/b\u003e with \u003cb\u003e7\u003c/b\u003e towers with \u003cb\u003eG+5P+17\u003c/b\u003e floors. Each floor has \u003cb\u003e4\u003c/b\u003e flats per floor, \u003cb\u003e2\u003c/b\u003e lifts, \u003cb\u003e1\u003c/b\u003e staircases. It is available in \u003cb\u003e2BHK/3BHK/4BHK\u003c/b\u003e configurations with carpet areas ranging from \u003cb\u003e715\u003c/b\u003e to \u003cb\u003e1575 sq. ft.\u003c/b\u003e\",\"category\":\"Configuration\"},{\"question\":\"What type of parking is available in V Raheja La Serena?\",\"answer\":\"V Raheja La Serena provides dedicated car parking facilities for residents. The exact parking type and the number of spaces allotted per unit are mentioned in the Unit Plan, which you can download for free on the V Raheja La Serena project page on Housiey.\",\"category\":\"Configuration\"},{\"question\":\"Where is V Raheja La Serena located? What are the nearby landmarks?\",\"answer\":\"It is located at \u003cb\u003eOff M.G. road, Patel Nagar, Kandivali West, Mumbai\u003c/b\u003e.\u003cbr\u003eNearby landmarks include:\u003cbr\u003e\u003cb\u003e• Kandivali Railway Station - 1.0km \u003c/b\u003e\u003cbr\u003e\u003cb\u003e• DMart - 1.5km \u003c/b\u003e\u003cbr\u003e\u003cb\u003e• Dahanukarwadi Metro Station - 1.6km \u003c/b\u003e\",\"category\":\"Location\"},{\"question\":\"What payment plans are available for V Raheja La Serena?\",\"answer\":\"The following payment plans are available:\u003cbr\u003e• \u003cb\u003eCLP ( Construction Link plan)\u003c/b\u003e - Regular Standard Slabwise Payment  as per construction, Maximum loan possible up to 90%\u003cbr\u003e\u003cbr\u003e\u003cb\u003eNote:\u003c/b\u003e In some cases, payment plan deviations can be considered based on your preferred terms. The final schedule is confirmed after your site visit.\",\"category\":\"Payment\"},{\"question\":\"What is the minimum down payment required for V Raheja La Serena?\",\"answer\":\"The minimum down payment starts from \u003cb\u003e₹40.00 Lacs\u003c/b\u003e, inclusive of all taxes. EMI options are also available. Use the EMI calculator on the project page to check monthly instalments based on your loan amount and tenure.\",\"category\":\"Payment\"},{\"question\":\"Is V Raheja La Serena approved by banks for home loans?\",\"answer\":\"Yes, it is approved by leading banks including \u003cb\u003eCentral Bank of India\u003c/b\u003e, \u003cb\u003eUnion Bank of India\u003c/b\u003e, \u003cb\u003eBank Of India\u003c/b\u003e, \u003cb\u003eBank Of Baroda\u003c/b\u003e, \u003cb\u003eCiti Bank\u003c/b\u003e, \u003cb\u003eKotak Mahindra Bank\u003c/b\u003e, \u003cb\u003eAxis Bank\u003c/b\u003e, \u003cb\u003eState Bank Of India\u003c/b\u003e, \u003cb\u003eICICI Bank\u003c/b\u003e, \u003cb\u003eHDFC BANK\u003c/b\u003e. The complete approved bank list is available in the Banks section on Housiey. Home loan eligibility depends on the bank's lending policy and your profile.\",\"category\":\"Payment\"},{\"question\":\"Is there any brokerage when buying V Raheja La Serena through Housiey?\",\"answer\":\"No - Housiey follows a strict no-brokerage policy. You pay only the builder's official price - no commission, no hidden charges, and no middlemen. This applies to all projects listed on Housiey.\",\"category\":\"Payment\"},{\"question\":\"Who is the developer of V Raheja La Serena?\",\"answer\":\"It is developed by \u003cb\u003eV Raheja Realty\u003c/b\u003e, a trusted real estate brand with over \u003cb\u003e48 years\u003c/b\u003e of experience and more than \u003cb\u003e100 completed projects\u003c/b\u003e across \u003cb\u003eBangalore Rural, Bangalore Urban, Mumbai City and Mumbai suburban\u003c/b\u003e. \",\"category\":\"Developer\"},{\"question\":\"Does V Raheja La Serena have CC and OC approvals?\",\"answer\":\"The Commencement Certificate is available. The \u003cb\u003eOccupancy Certificate (OC)\u003c/b\u003e will be applied for closer to the possession date, as per standard regulatory timelines. All currently available documents are listed in the Documents section on Housiey.\",\"category\":\"Legal \u0026 Compliance\"},{\"question\":\"Can I book a site visit for V Raheja La Serena?\",\"answer\":\"Yes - book a free site visit through Housiey. We arrange a free Ola cab pickup and drop from your location.\u003cbr\u003e\u003cbr\u003eAlternatively, you can schedule an online project presentation directly by the builder from home. Both options are 100% free with no obligation to buy.\",\"category\":\"Site Visit\"},{\"question\":\"Can NRIs buy a flat in V Raheja La Serena?\",\"answer\":\"Yes - NRIs can purchase this project under FEMA regulations. Payment can be made via NRE or NRO accounts. Home loans are available from Indian banks with a co-applicant. Housiey's team assists NRI buyers with documentation and Power of Attorney requirements remotely - 100% free.\",\"category\":\"Buying Process\"},{\"question\":\"Why is V Raheja La Serena considered a good investment?\",\"answer\":\"\u003cb\u003eKandivali West\u003c/b\u003e is one of Mumbai's sought-after micro-markets with consistent property appreciation.\u003cbr\u003e\u003cbr\u003eThis project by \u003cb\u003eV Raheja Realty\u003c/b\u003e - with 48 years of experience - offers 2BHK/3BHK/4BHK at ₹2.67 Cr to ₹6.16 Cr, making it a strong long-term investment opportunity.\",\"category\":\"Investment\"},{\"question\":\"Why should I buy V Raheja La Serena through Housiey instead of directly from the builder?\",\"answer\":\"Buying through Housiey gives you:\u003cbr\u003e(1) No brokerage - you pay the builder's exact price\u003cbr\u003e(2) Free Ola cab site visit\u003cbr\u003e(3) Online project presentation by the builder from home\u003cbr\u003e(4) Free legal consultation via Housiey Legal\u003cbr\u003e(5) Honest Pros \u0026 Cons review on every project\u003cbr\u003eAll services are 100% free with no obligation.\",\"category\":\"Housiey\"},{\"question\":\"How can I download the price sheet or brochure of V Raheja La Serena?\",\"answer\":\"The price sheet and brochure for this project are available for free download on Housiey. Click the \\\"Price Sheet\\\" or \\\"Brochure\\\" button on the project page. No registration is required for instant download.\",\"category\":\"Housiey\"},{\"question\":\"What is Housiey's rating and how many customers have bought homes through Housiey?\",\"answer\":\"Housiey has a \u003cb\u003e4.8 rating\u003c/b\u003e on Google with \u003cb\u003e2,395+ reviews\u003c/b\u003e.\u003cbr\u003e\u003cbr\u003eOver \u003cb\u003e8,500 families\u003c/b\u003e have purchased homes through Housiey across \u003cb\u003e8+ cities\u003c/b\u003e with no brokerage and direct builder pricing. Housiey has conducted \u003cb\u003e1.2 lakh+ free site visits\u003c/b\u003e and facilitated over \u003cb\u003e₹8,000 crore\u003c/b\u003e worth of property transactions.\",\"category\":\"Housiey\"}]},\"timestamp\":\"2026-09-08T11:33:33.613Z\"},\"BuilderData\":{\"id\":658,\"builder_name\":\"V Raheja Realty\",\"builder_name_normalized\":\"vrahejarealty\",\"established_year\":\"1975\",\"experience\":48,\"projects_comp\":100,\"cities\":\"Bangalore Rural,Bangalore Urban,Mumbai City,Mumbai suburban\",\"happy_families\":15000,\"description\":\"Welcome to V Raheja Realty, a leading real estate company founded by Vijay Raheja, an accomplished Architect from the University of Texas, Austin. With his extensive experience in the industry, Vijay Raheja has played a pivotal role in making the Raheja name a staple in the real estate industry.\\r\\nV Raheja Realty has a rich legacy Over 4 Decades, built on the trust and belief of its customers and stakeholders . We are one of Mumbai’s leading real estate Developer \u0026 has constructed several Residential, Commercial and Hotel projects spread across Mumbai \u0026 Bangalore. Some of the land mark projects being Raheja Chambers Nariman Point , Mumbai , J.W. Marriott Juhu Mumbai , S. L. Raheja Hospital Mahim Mumbai , Arya Vidya Mandir School JVPD Mumbai, J. W. Marriott UB City ,Bangalore , Pebble Bay Bangalore and many more.\",\"rating\":5,\"logo\":\"admin/uploads/builders/v-raheja-realty_1740036948558-855282654.webp\",\"status\":1,\"datetime\":\"2024-02-29T01:51:54.000Z\",\"builder_categories\":5,\"created_at\":null,\"created_by\":null,\"updated_at\":\"2025-08-21T13:03:53.000Z\",\"updated_by\":\"shabbir.shaikh@housiey.com\"},\"projectName\":\"V Raheja La Serena\",\"projectId\":1483,\"BanksData\":\"$8:2:props:children:1:props:projectData:banks\",\"ReraData\":\"$8:2:props:children:1:props