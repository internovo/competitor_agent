\":\"01 December 2027\",\"rera_possession\":\"01 December 2028\",\"area_range_min\":715,\"area_range_max\":1575,\"saving_amt\":\"50000\",\"overall_price_range\":\"2.67 Cr - 6.16 Cr\",\"availability_status\":\"Available\",\"offer\":\"\",\"offer_start_date\":\"\",\"offer_end_date\":\"\",\"builder_id\":658,\"seller_id\":\"1044\",\"updated_at\":\"2026-08-06T05:26:54.000Z\",\"created_at\":\"2024-02-29T06:53:23.000Z\",\"builder_name\":\"V Raheja Realty\",\"builder_logo\":\"admin/uploads/builders/v-raheja-realty_1740036948558-855282654.webp\",\"builder_established_year\":\"1975\",\"litigation_exist\":\"No\"}],\"sellerInfo\":[{\"seller_id\":1044,\"name\":\"Shabbir Shaikh\",\"email\":\"shabbir.shaikh@housiey.com\",\"phone\":\"7700914406\",\"profile_photo\":null,\"status\":1,\"datetime\":\"2022-11-27T03:20:42.000Z\",\"replaced_by\":null,\"replaced_by_id\":0,\"suspended\":1,\"suspended_datetime\":null,\"password\":\"$$2b$10$dlH2bQ/j1UnISRMSPRL66Ow4b4pp1/hylkhnD3FyFHwFSJKxH58wq\",\"city_id\":15,\"remark\":null}],\"images\":[{\"type\":1,\"img\":\"admin/uploads/project_images/v-raheja-la-serena_1774335502374-130171662.webp\",\"has_variants\":1},{\"type\":2,\"img\":\"admin/uploads/project_images/v-raheja-la-serena_1774335503715-733698304.webp\",\"has_variants\":1},{\"type\":2,\"img\":\"admin/uploads/project_images/v-raheja-la-serena_1774335505106-760571759.webp\",\"has_variants\":1},{\"type\":2,\"img\":\"admin/uploads/project_images/v-raheja-la-serena_1774335507697-243794236.webp\",\"has_variants\":1},{\"type\":2,\"img\":\"admin/uploads/project_images/v-raheja-la-serena_1774335508826-273106304.webp\",\"has_variants\":1},{\"type\":2,\"img\":\"admin/uploads/project_images/v-raheja-la-serena_1774335511859-961881108.webp\",\"has_variants\":1},{\"type\":2,\"img\":\"admin/uploads/project_images/v-raheja-la-serena_1774335512986-997902906.webp\",\"has_variants\":1},{\"type\":2,\"img\":\"admin/uploads/project_images/v-raheja-la-serena_1774335513323-548823299.webp\",\"has_variants\":1}],\"int_amenities\":[{\"name\":\"Vitrified Tiles\",\"img\":\"admin/uploads/amenities/1652438961711-img.webp\"},{\"name\":\"Granite Kitchen Platform\",\"img\":\"admin/uploads/amenities/granite-kitchen-platform_External_1770712604025-330259421.webp\"},{\"name\":\"Stainless Steel Sink\",\"img\":\"admin/uploads/amenities/1646987626444-img.webp\"},{\"name\":\"Branded Fittings\",\"img\":\"admin/uploads/amenities/branded-fittings_External_1770712154619-248942722.webp\"},{\"name\":\"CCTV Camera\",\"img\":\"admin/uploads/amenities/cctv-camera_External_1770712182845-897978997.webp\"},{\"name\":\"Fire Fighting\",\"img\":\"admin/uploads/amenities/fire-fighting_External_1770712237914-35127023.webp\"},{\"name\":\"Modular Kitchen\",\"img\":\"admin/uploads/amenities/1652443683117-img.webp\"}],\"ext_amenities\":[{\"name\":\"Swimming Pool\",\"img\":\"admin/uploads/amenities/1652447054692-img.webp\"},{\"name\":\"Kids Play Area\",\"img\":\"admin/uploads/amenities/1652446278292-img.webp\"},{\"name\":\"Jogging Track\",\"img\":\"admin/uploads/amenities/jogging-track_External_1770724897454-7779386.webp\"},{\"name\":\"Garden\",\"img\":\"admin/uploads/amenities/garden_External_1770724836898-39687774.webp\"},{\"name\":\"Senior Citizen Area\",\"img\":\"admin/uploads/amenities/1652446899508-img.webp\"},{\"name\":\"Kids Pool\",\"img\":\"admin/uploads/amenities/1652446316261-img.webp\"},{\"name\":\"Seating Area\",\"img\":\"admin/uploads/amenities/seating-area_External_1770882751990-34368358.webp\"},{\"name\":\"Barbeque Deck\",\"img\":\"admin/uploads/amenities/1652445193908-img.webp\"},{\"name\":\"Cycling Track\",\"img\":\"admin/uploads/amenities/cycling-track_External_1770730064819-362083305.webp\"},{\"name\":\"Aroma Garden\",\"img\":\"admin/uploads/amenities/aroma-garden_External_1770879281507-591150397.webp\"},{\"name\":\"BBQ Lawn\",\"img\":\"admin/uploads/amenities/bbq-lawn_External_1770879374850-710973368.webp\"},{\"name\":\"Indoor games\",\"img\":\"admin/uploads/amenities/indoor-games_External_1770730286045-726989382.webp\"},{\"name\":\"party lawn\",\"img\":\"admin/uploads/amenities/party-lawn_External_1770789871561-959473538.webp\"},{\"name\":\"Yoga Deck\",\"img\":\"admin/uploads/amenities/1655643322832-img.webp\"},{\"name\":\"Landscaped Garden\",\"img\":\"admin/uploads/amenities/landscaped-garden_External_1770730353543-838812214.webp\"},{\"name\":\"Gymnasium\",\"img\":\"admin/uploads/amenities/gymnasium_External_1770730220696-33756910.webp\"},{\"name\":\"Walking Track\",\"img\":\"admin/uploads/amenities/walking-track_External_1770892185967-695726456.webp\"},{\"name\":\"Sun Deck\",\"img\":\"admin/uploads/amenities/sun-deck_External_1770892029227-265324265.webp\"},{\"name\":\"Fitness Deck\",\"img\":\"admin/uploads/amenities/fitness-deck_External_1770717977981-642672531.webp\"},{\"name\":\"Swimming Pool\",\"img\":\"admin/uploads/amenities/swimming-pool_External_1746692119462-791657112.webp\"}],\"pros\":[{\"type\":1,\"tag\":\"\u003col\u003e\u003cli\u003eThe project is situated in a prime location near S.V. Road, offering excellent connectivity to Kandivali Railway Station, Dahanukarwadi Metro Station, and nearby malls.\u003c/li\u003e\u003cli\u003eThe project offers generously sized apartments — 2BHK (765 sq. ft.), 3BHK (1150 sq. ft.), and 4BHK (1575 sq. ft.) — which are rare to find in today’s market where most developers focus on compact layouts. If you value spacious living, this project is an ideal choice.\u003c/li\u003e\u003c/ol\u003e\"}],\"cons\":[{\"type\":2,\"tag\":\"\u003col\u003e\u003cli\u003eEven with such large carpet areas, balconies are available only on the higher floors. So, if a deck is your preference, you should consider opting for a higher floor—depending on your budget.\u003c/li\u003e\u003c/ol\u003e\"}],\"address\":\"Kandivali West, Mumbai\",\"project_videos\":[{\"video\":\"mBRzIJsWTCQ\",\"video_description\":\"V Raheja La Serena | Luxury 3BHK Sample Flat Tour at Kandivali West | Price, Location \u0026 Reviews 2025\",\"set_seo_video\":0,\"