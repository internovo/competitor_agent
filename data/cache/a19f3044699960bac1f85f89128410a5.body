  <script>
    (function() {
      var isPWA = window.matchMedia('(display-mode: standalone)').matches
               || window.navigator.standalone === true;
      var appSource = isPWA ? 'pwa' : 'browser';
      // Push to dataLayer for GTM
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ app_source: appSource });
      // Set as GA user property (works if gtag is already initialised or queued)
      window.dataLayer.push(function() {
        if (typeof gtag === 'function') {
          gtag('set', 'user_properties', { app_source: appSource });
        }
      });
    })();
  </script>
  <script>
    (function() {
      var isPWA = window.matchMedia('(display-mode: standalone)').matches
               || window.navigator.standalone === true;
      if (!isPWA) return;

      document.addEventListener('click', function(e) {
        var anchor = e.target.closest && e.target.closest('a[target="_blank"]');
        if (!anchor) return;
        var href = anchor.getAttribute('href');
        if (!href) return;
        try {
          var url = new URL(href, window.location.href);
          if (url.origin !== window.location.origin) return;
        } catch (err) {
          return;
        }
        e.preventDefault();
        if (typeof showPWANavLoader === 'function') showPWANavLoader();
        window.location.href = href;
      }, true);
    })();
  </script>
