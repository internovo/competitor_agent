<style>
  /* Raise header above page content */
  .header { z-index: 200 !important; }

  /* Logo scaling */
  .header .logo { min-width: 160px; overflow: visible; }
  .header .logo img.transformScale { transform: scale(1.1); transform-origin: left center; }

  /* ── Hide Sell/Explore quick-link on mobile — it's in the hamburger menu ── */
  @media (max-width: 991px) {
    .mobile-user-login { display: none !important; }
  }

  /* ── Global city selector pill ── */
  .global-city-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    border: 1.5px solid rgba(7, 31, 76, 0.35);
    border-radius: 22px;
    padding: 6px 14px 6px 10px;
    cursor: pointer;
    white-space: nowrap;
    position: relative;
    user-select: none;
    flex-shrink: 0;
    margin-left: 20px;
    margin-right: auto;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
  }
  .global-city-btn:hover {
    background: #f4f6fb;
    border-color: #071f4c;
    box-shadow: 0 2px 8px rgba(7,31,76,0.12);
  }
  .city-pin-icon { color: #347bbf; font-size: 12px; }
  .city-label-group { display: flex; flex-direction: column; line-height: 1.15; }
  .city-btn-name {
    font-size: 13px;
    color: #071f4c;
    font-family: lato-bold;
  }
  .city-chevron { color: #347bbf; font-size: 9px; margin-left: 1px; }

  /* ── Desktop dropdown — matches search box suggestion style ── */
  .global-city-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    background: #fff;
    border-radius: 2px;
    box-shadow: 0 5px 10px rgba(0,0,0,0.2);
    width: min(440px, calc(100vw - 24px));
    max-width: calc(100vw - 24px);
    z-index: 99999;
    padding: 8px 0 0;
    max-height: calc(90vh - 70px);
    overflow-x: hidden;
    overflow-y: auto;
    border: 1px solid rgba(0,0,0,0.2);
  }
  .global-city-dropdown.open { display: block; }
  .city-dropdown-label {
    font-size: 10px;
    color: #7b7f8a;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    font-family: lato-bold;
    padding: 0 10px 8px;
    border-bottom: 1px solid #f0f0f0;
    margin-bottom: 0;
  }
  /* Three-column grid — each cell is a row-like item */
  .city-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .city-grid-option {
    min-width: 0;
    padding: 6px 10px;
    font-size: 15px;
    line-height: 1.4;
    overflow-wrap: anywhere;
    color: #000;
    cursor: pointer;
    border-bottom: 1px solid #f0f0f0;
    border-right: 1px solid #f0f0f0;
    transition: background 0.12s, color 0.12s;
  }
  .city-grid-option:nth-child(3n + 1) { border-right: none; }
  .city-grid-option:hover { background: #89ae51; color: #fff; }
  .city-grid-option.active { background: #071f4c; color: #fff; font-family: lato-bold; }
  /* "All Cities" spans all columns, sits above the grid */
  .city-grid-option.city-all {
    grid-column: 1 / -1;
    border-right: none;
    color: #000;
  }
  .city-grid-option.city-all:hover { background: #89ae51; color: #fff; }
  .city-grid-option.city-all.active { background: #071f4c; color: #fff; }

  @media (max-width: 991px) {
    .global-city-btn {
      margin-left: auto !important;
      margin-right: 10px !important;
      padding: 5px 12px 5px 9px;
    }
    .city-btn-name { font-size: 13px; }
    .global-city-dropdown {
      display: none;
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      width: min(440px, calc(100vw - 24px));
      max-width: calc(100vw - 24px);
      max-height: 80vh;
      margin: 0;
      transform: none;
    }
    .global-city-dropdown.open { display: block; }

    /* Home page hamburger (no new_bg class) — show it with semi-transparent dark style */
    .navbar-toggler.add-cross.icon_btn:not(.new_bg) {
      display: block !important;
      background-color: rgba(7, 31, 76, 0.75);
      border: 1.5px solid rgba(255, 255, 255, 0.35);
      border-radius: 6px;
      padding: 7px 9px;
    }
    .navbar-toggler.add-cross.icon_btn:not(.new_bg) .navbar-toggler-icon {
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='30' height='30' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(255,255,255,0.9)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
    }
  }

  /* ── Mobile city bottom sheet ── */
  .city-sheet-overlay { display: none; }
  .city-bottom-sheet  { display: none; }

  @media (max-width: 991px) {
    .city-sheet-overlay {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(7, 31, 76, 0.5);
      z-index: 99998;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.28s;
    }
    .city-sheet-overlay.open { opacity: 1; pointer-events: auto; }

    .city-bottom-sheet {
      display: none;
      flex-direction: column;
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: #fff;
      border-radius: 20px 20px 0 0;
      z-index: 99999;
      max-height: 82vh;
      transform: translateY(100%);
      transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
      pointer-events: none;
    }
    .city-bottom-sheet.open { transform: translateY(0); pointer-events: auto; }

    .city-sheet-handle {
      width: 40px; height: 4px;
      background: #d0d5e0;
      border-radius: 2px;
      margin: 14px auto 0;
      flex-shrink: 0;
    }
    .city-sheet-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px 14px;
      border-bottom: 1px solid #e8eaf0;
      flex-shrink: 0;
    }
    .city-sheet-title {
      font-size: 12px;
      font-family: lato-bold;
      color: #7b7f8a;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }
    .city-sheet-close {
      width: 30px; height: 30px;
      display: flex; align-items: center; justify-content: center;
      border: 1.5px solid #071f4c;
      border-radius: 50%;
      cursor: pointer;
      font-size: 20px;
      color: #071f4c;
      line-height: 1;
      flex-shrink: 0;
    }
    .city-sheet-body {
      overflow-x: hidden;
      overflow-y: auto;
      padding: 0 0 36px;
      flex: 1;
      -webkit-overflow-scrolling: touch;
    }
    .city-sheet-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .city-sheet-option {
      min-width: 0;
      padding: 14px 16px;
      font-size: 15px;
      line-height: 1.4;
      overflow-wrap: anywhere;
      color: #000;
      cursor: pointer;
      border-bottom: 1px solid #f0f0f0;
      border-right: 1px solid #f0f0f0;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      transition: background 0.12s;
    }
    .city-sheet-option:nth-child(3n + 1) { border-right: none; }
    .city-sheet-option:active { background: #89ae51; color: #fff; }
    .city-sheet-option.active { background: #071f4c; color: #fff; font-family: lato-bold; }
    .city-sheet-all {
      grid-column: 1 / -1;
      border-right: none;
      color: #000;
    }
    .city-sheet-option.city-sheet-all.active { background: #071f4c; color: #fff; }
  }
</style>

