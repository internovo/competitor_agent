1633714792583.pdf&#34;,&#34;project_1633714792583.pdf&#34;,&#34;project_1633714792588.pdf&#34;],&#34;site_plan&#34;:[&#34;project_1633714791668.pdf&#34;],&#34;brochure&#34;:[&#34;project_1633714793705.pdf&#34;],&#34;price_list&#34;:[],&#34;specification&#34;:[],&#34;other_document&#34;:[],&#34;visitor_parking_spot&#34;:[&#34;Basement&#34;],&#34;space&#34;:[],&#34;retail_floor_type&#34;:[],&#34;retail_type&#34;:[],&#34;retail_additional&#34;:[],&#34;tags&#34;:[],&#34;is_live&#34;:&#34;2&#34;,&#34;_id&#34;:&#34;60d9d5d0fe3ff43d5cf31c02&#34;,&#34;updated&#34;:&#34;2021-06-28T13:59:44.403Z&#34;,&#34;created&#34;:&#34;2021-06-28T13:59:44.403Z&#34;,&#34;name&#34;:&#34;Rivali Park Wintergreen&#34;,&#34;builder&#34;:&#34;CCI Projects Pvt Ltd.&#34;,&#34;authority&#34;:&#34;Municipal Corporation of Greater Mumbai (MCGM)/ BMC&#34;,&#34;rera&#34;:&#34;P51800003067&#34;,&#34;property_type&#34;:&#34;Apartments&#34;,&#34;facing&#34;:&#34;East&#34;,&#34;road_width&#34;:{&#34;width&#34;:null},&#34;project_status&#34;:&#34;Ready To Move&#34;,&#34;expected_completion&#34;:&#34;2021-05-31T18:30:00.000Z&#34;,&#34;township&#34;:&#34;CCI Rivali Park&#34;,&#34;address&#34;:&#34;Western Express Highway,Kandivali,Asha Nagar,Borivali (E),Mumbai&#34;,&#34;pincode&#34;:400066,&#34;state&#34;:&#34;Maharashtra&#34;,&#34;district&#34;:&#34;Mumbai Suburban&#34;,&#34;city&#34;:&#34;Mumbai&#34;,&#34;subcity&#34;:&#34;Mumbai Western Suburbs&#34;,&#34;total_floors&#34;:42,&#34;basement&#34;:false,&#34;visitor_parking&#34;:true,&#34;video_url&#34;:&#34;https://www.youtube.com/embed/Yc-hKr_vqZA&#34;,&#34;description&#34;:&#34;&lt;div style=\&#34;text-align: justify;\&#34;&gt;&lt;span style=\&#34;font-family: Tahoma; color: rgb(0, 0, 0);\&#34;&gt;Rivali Park Wintergreen is a harmonious project by CCI groups and is spread over 22 acres of land. It is located near many schools, college, hospital and supermarket and is well connected to rest of Mumbai through the suburban railway network, BEST buses, auto and taxis. The project features 1, 2 and 3 BHK apartments with various amenities like gymnasium, swimming pool, parks, club house, library, mini-theatre, kids play area, etc.&lt;/span&gt;&lt;/div&gt;&#34;,&#34;location&#34;:{&#34;location&#34;:{&#34;lat&#34;:&#34;19.2160935&#34;,&#34;lng&#34;:&#34;72.8657211&#34;}},&#34;id&#34;:&#34;ztKBDB2&#34;,&#34;url&#34;:&#34;/projects/rivali-park-wintergreen-ztKBDB2&#34;,&#34;__v&#34;:0,&#34;price&#34;:{&#34;zeroTo25Lacs&#34;:0,&#34;twentyfiveTo50Lacs&#34;:0,&#34;fiftyTo1cr&#34;:0,&#34;oneTo5cr&#34;:1,&#34;fiveToabove&#34;:0,&#34;min&#34;:40000000,&#34;max&#34;:40000000},&#34;updatedAt&#34;:&#34;2022-12-01T13:14:43.061Z&#34;,&#34;views&#34;:2708,&#34;total_properties&#34;:1,&#34;authortiy_url&#34;:&#34;/authorities/municipal-corporation-of-greater-mumbai-(mcgm)-bmc-uuonAy3&#34;});">
