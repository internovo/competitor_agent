<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
(function () {
    var DISMISSED_KEY = 'az_pwa_dismissed';
    var INSTALLED_KEY = 'az_pwa_installed';
    var banner = document.getElementById('pwa-install-banner');
    var installBtn = document.getElementById('pwa-install-btn');
    var dismissBtn = document.getElementById('pwa-dismiss-btn');
    var subtitle = document.getElementById('pwa-banner-subtitle');

    if (!banner) return;

    // Already running as installed PWA — never show the install banner
    var isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    if (isStandalone) {
        localStorage.setItem(INSTALLED_KEY, '1');
        banner.style.display = 'none';
        return;
    }

    // Permanently hidden after install
    if (localStorage.getItem(INSTALLED_KEY)) {
        banner.style.display = 'none';
        return;
    }

    function hideBanner() {
        localStorage.setItem(DISMISSED_KEY, '1');
        banner.style.display = 'none';
    }

    function hideAfterInstall() {
        localStorage.setItem(INSTALLED_KEY, '1');
        banner.style.display = 'none';
    }

    function showBanner() {
        banner.style.display = 'block';
    }

    dismissBtn.addEventListener('click', hideBanner);

    var isIos = /iphone|ipad|ipod/i.test(navigator.userAgent);
    var isInStandalone = window.navigator.standalone === true;

    if (isIos) {
        // Already installed as PWA on iOS — hide the banner
        if (isInStandalone) { hideBanner(); return; }
        subtitle.textContent = 'Tap Share, then "Add to Home Screen"';
        showBanner();
        return;
    }

    // Android/Chrome: show Install button when native prompt is available
    function tryShowInstallBtn() {
        if (window._pwaInstallPrompt) {
            installBtn.style.display = 'inline-block';
            showBanner();
        }
    }

    tryShowInstallBtn();
    window.addEventListener('pwa-prompt-ready', tryShowInstallBtn);

    installBtn.addEventListener('click', function () {
        if (!window._pwaInstallPrompt) return;
        window._pwaInstallPrompt.prompt();
        window._pwaInstallPrompt.userChoice.then(function () {
            window._pwaInstallPrompt = null;
            hideBanner();
        });
    });

    window.addEventListener('appinstalled', hideBanner);
}());
</script>

<script>
(function captureUTMAndPWAContext() {
  var params = new URLSearchParams(window.location.search);
  var isPWA = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;

  var utmData = {
    utm_source: params.get("utm_source"),
    utm_medium: params.get("utm_medium"),
    utm_campaign: params.get("utm_campaign"),
    day: params.get("day"),
    isPWA: isPWA
  };

  if (utmData.utm_source === "email" && isPWA) {
    utmData.combined_source = "email+pwa";
    localStorage.setItem("email_utm_data", JSON.stringify(utmData));
    localStorage.setItem("pwa_utm_data", JSON.stringify(utmData));
  } else if (utmData.utm_source === "email") {
    utmData.combined_source = "email";
    localStorage.setItem("email_utm_data", JSON.stringify(utmData));
  } else if (utmData.utm_source === "pwa" || isPWA) {
    utmData.combined_source = "pwa";
    localStorage.setItem("pwa_utm_data", JSON.stringify(utmData));
  }
})();
</script>

