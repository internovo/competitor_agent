<!-- Media galary script -->
<script>
  var popupGallery;
  var pageLoadModal = false;
  $(document)
    .ready(function() {
      $('#moreInfo')
        .on('show.bs.modal', function(e, f) {

          popupGallery = new Swiper('#popupGallery', {
            spaceBetween: 2
            , loop: true
            , lazy: true
            , navigation: {
              nextEl: '.swiper-button-next'
              , prevEl: '.swiper-button-prev'
            , }
            , pagination: {
              el: '.swiper-pagination'
            , }
            , keyboard: {
              enabled: true
            , }
          });

          let relatedTargetId = e.relatedTarget.id;
          if (relatedTargetId === "showVideo") {
            $('#moreInfo a[href="#pills-video"]')
              .tab('show');
          }
        });

      $('.modal')
        .on('show.bs.modal', function(e, f) {
          //Mute video on galary
          var video = $("#video-player-galary")
            .attr("src");
          $("#video-player-galary")
            .attr("src", "");
          $("#video-player-galary")
            .attr("src", video);
        });


      $('#moreInfo')
        .on('shown.bs.modal', function(e) {
          popupGallery.update();
        });

      //Stop playing video on modal close
      $('#moreInfo')
        .on('hidden.bs.modal', function() {
          // console.log("Modal Closed");
          var video = $("#video-player")
            .attr("src");
          $("#video-player")
            .attr("src", "");
          $("#video-player")
            .attr("src", video);

          // Changed the tab image
          $('#moreInfo a[href="#pills-images"]')
            .tab('show');
        })
      //Stop playing video on modal close
      $('a[data-toggle="pill"]')
        .on('shown.bs.tab', function(e) {
          // console.log("Tab changed");
          if (e.relatedTarget.id === "pills-video-tab") {
            var video = $("#video-player")
              .attr("src");
            $("#video-player")
              .attr("src", "");
            $("#video-player")
              .attr("src", video);
          }
        });


      var galleryTop = new Swiper('.gallery-top', {
        slidesPerView: 1
        , loop: true
        , loopedSlides: 50
        , lazy: true
        , lazy: {
          loadPrevNext: false
          , loadOnTransitionStart: true
        }
      , });
      var galleryThumbs = new Swiper('.gallery-thumbs', {
        direction: 'vertical'
        , slidesPerView: 4
        , slideToClickedSlide: true
        , spaceBetween: 10
        , loopedSlides: 50
        , loop: true
        , lazy: true
        , lazy: {
          loadPrevNext: false
          , loadOnTransitionStart: true
        }
      , });
      if (galleryTop.controller){
        galleryTop.controller.control = galleryThumbs;
      }
      if (galleryThumbs.controller){
        galleryThumbs.controller.control = galleryTop;
      }      
    })
</script>


<!-- unitConverter OR COMMOM FUNCTIONS-->
<script>
  function getExpCompDate() {
    var date = new Date('Tue Jun 01 2021 00:00:00 GMT+0530 (India Standard Time)');
    $('#expected_completion')
      .text(date.getFullYear());
  }
  getExpCompDate();

  function unitConverter(areas, currentUnit, idx, changeInto) {
    // console.log('unitConverter called', currentUnit, changeInto)
    var res;
    for (var i = 0; i <= areas.length; i++) {
      val = Number(areas[i].area);
      var landArea = areas[i].land_area;
      var apartment_area = areas[i].apartment_area;

      // Acre
      if (currentUnit == "acre") {
        if (changeInto == "sq ft") {
          res = val;
        } else if (changeInto == "sq ft") {
          res = val * 43560;
          if (landArea) landArea = landArea * 43560;
          if (apartment_area) apartment_area = apartment_area * 43560;

        } else if (changeInto == "sq yards") {
          res = val * 4840;
          if (landArea) landArea = landArea * 4840;
          if (apartment_area) apartment_area = apartment_area * 4840;

        } else if (changeInto == "sq meter") {
          res = val * 4046.856;
          if (landArea) landArea = landArea * 4046.856;
          if (apartment_area) apartment_area = apartment_area * 4046.856;

        }
      }
      // Sq feet
      else if (currentUnit == "sq ft") {
        if (changeInto == "sq ft") {
          res = val;;
        } else if (changeInto == "acre") {
          res = val / 43560;

          if (landArea) landArea = landArea / 43560;
          if (apartment_area) apartment_area = apartment_area / 43560;

        } else if (changeInto == "sq yards") {
          res = val / 9;
          if (landArea) landArea = landArea / 9;
          if (apartment_area) apartment_area = apartment_area / 9;

        } else if (changeInto == "sq meter") {

          res = val / 10.764;
          if (landArea) landArea = landArea / 10.764;;
          if (apartment_area) apartment_area = apartment_area / 10.764;;
        }
      }
      // Sq yards
      else if (currentUnit == "sq yards") {
        if (changeInto == "sq yards") {
          res = val;;
        } else if (changeInto == "acre") {
          res = val / 4840;

          if (landArea) landArea = landArea / 4840;
          if (apartment_area) apartment_area = apartment_area / 4840;

        } else if (changeInto == "sq ft") {
          res = val / 9;
          if (landArea) landArea = landArea / 9;
          if (apartment_area) apartment_area = apartment_area / 9;


        } else if (changeInto == "sq meter") {
          res = val / 1.196;

          if (landArea) landArea = landArea / 1.196;
          if (apartment_area) apartment_area = apartment_area / 1.196;
        }
      }
      // Sq meter
      else if (currentUnit == "sq meter") {
        if (changeInto == "sq meter") {
          res = val;;
        } else if (changeInto == "acre") {
          res = val / 4046.856;
          if (landArea) landArea = landArea / 4046.856;
          if (apartment_area) apartment_area = apartment_area / 4046.856;

        } else if (changeInto == "sq ft") {
          res = val * 10.764;

          if (landArea) landArea = landArea * 10.764;
          if (apartment_area) apartment_area = apartment_area * 10.764;

        } else if (changeInto == "sq yards") {
          res = val * 81.196;

          if (landArea) landArea = landArea * 81.196;
          if (apartment_area) apartment_area = apartment_area * 81.196;

        }
      }
      document.getElementById('area-' + i)
        .innerHTML = res.toFixed(2);

      if (landArea) {
        document.getElementById('land-area-' + i)
          .innerHTML = landArea.toFixed(2);
      }

      if (apartment_area) {
        document.getElementById('apartment_area-' + i)
          .innerHTML = apartment_area.toFixed(2);
      }
    }
  }
</script>
