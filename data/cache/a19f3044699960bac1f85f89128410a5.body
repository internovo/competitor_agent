  /* Booking modal: phone-only fixes */
  @media (max-width: 767px) {
    #booking-modal .modal-dialog {
      margin: 10px !important;
      height: calc(100dvh - 20px) !important;
      max-height: calc(100dvh - 20px) !important;
    }

    #booking-modal .modal-content {
      height: 100% !important;
      overflow: hidden !important;
      border-radius: 12px !important;
    }

    /* Fill available space exactly — no bottom slack */
    #booking-modal .modal-body {
      padding: 16px !important;
      height: 100% !important;
      max-height: none !important;
      overflow-y: auto !important;
      -webkit-overflow-scrolling: touch !important;
    }

    /* Stop vertical centering from creating empty space */
    #booking-modal .modal-dialog.modal-dialog-centered {
      align-items: flex-start !important;
    }

    /* Keep close button reachable */
    #booking-modal .auth-modal-close {
      position: absolute !important;
      top: 10px !important;
      right: 10px !important;
      z-index: 9999 !important;
    }

    /* Inner padding only on phone */
    #booking-modal .fdp-modal-left-content,
    #booking-modal .right-auth-md-content {
      padding: 10px !important;
    }

    /* Remove Bootstrap row negative margins on phone */
    #booking-modal .row {
      margin-left: 0 !important;
      margin-right: 0 !important;
    }
  }
</style>

