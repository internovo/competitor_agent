<script>
  sellPropertyPopupInit = function () {
    $('#SCDSellPropertyModal')
      .on("hidden.bs.modal", function (e) {
        $(this)
          .find("input,textarea,select")
          .val('')
          .end()
      })
    initTypeAHeads();
  }

  // PROJECT FILTER
  function initTypeAHeads() {
    $('#fixture-project-search-submit-property .typeahead')
      .typeahead({
        hint: false
        , highlight: true
        , minLength: 1
        ,
      }, {
        name: 'fixture-project-search-submit-property'
        , display: 'name'
        , source: function (query, syncResults, asyncResults) {
          if (query.length > 0) {
            // console.log("quely", query)
            $.post('/api/project/typeahead', {
              data: query
            }, function (data) {
              asyncResults(data.results);
            });
          }
        }
        , templates: {
          suggestion: function (data) {
            result = '<div>' + data.name
            result += '<p class="entity__type_suggestions"></p>'
            result += '</div>'
            return result
          }
        }
      });

    $('#fixture-builder-search .typeahead')
      .typeahead({
        hint: false
        , highlight: true
        , minLength: 1
        ,
      }, {
        name: 'fixture-builder-search'
        , display: 'name'
        , source: function (query, syncResults, asyncResults) {
          if (query.length > 0) {
            // console.log("quely", query)
            $.post('/api/builder/typeahead', {
              data: query
            }, function (data) {
              asyncResults(data.results);
            });
          }
        }
        , templates: {
          suggestion: function (data) {
            result = '<div>' + data.name
            result += '<p class="entity__type_suggestions"></p>'
            result += '</div>'
            return result
          }
        }
      });

    $('#fixture-locality-search .typeahead')
      .typeahead({
        hint: false
        , highlight: true
        , minLength: 1
        ,
      }, {
        name: 'fixture-locality-search'
        , display: 'name'
        , source: function (query, syncResults, asyncResults) {
          if (query.length > 0) {
            // console.log("quely", query)
            $.post('/api/subcity/typeahead', {
              data: query
            }, function (data) {
              asyncResults(data.results);
            });
          }
        }
        , templates: {
          suggestion: function (data) {
            result = '<div>' + data.name
            result += '<p class="entity__type_suggestions"></p>'
            result += '</div>'
            return result
          }
        }
      });

    $('#fixture-city-search .typeahead')
      .typeahead({
        hint: false
        , highlight: true
        , minLength: 1
        ,
      }, {
        name: 'fixture-city-search'
        , display: 'name'
        , source: function (query, syncResults, asyncResults) {
          if (query.length > 0) {
            // console.log("quely", query)
            $.post('/api/city/typeahead', {
              data: query
            }, function (data) {
              asyncResults(data.results);
            });
          }
        }
        , templates: {
          suggestion: function (data) {
            result = '<div>' + data.name
            result += '<p class="entity__type_suggestions"></p>'
            result += '</div>'
            return result
          }
        }
      });
  }
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var STORAGE_KEY   = 'assetzilla_city';
    var LISTING_PAGES = ['/properties', '/projects', '/builders',
                         '/locations', '/authorities', '/banks'];
    var LISTING_ROOTS = ['/properties', '/projects', '/builders', '/locations', '/authorities', '/banks'];

    function getPageType(pathname) {
      if (LISTING_PAGES.indexOf(pathname) !== -1) return 'listing';
      for (var i = 0; i < LISTING_ROOTS.length; i++) {
        if (pathname.indexOf(LISTING_ROOTS[i] + '/') === 0) return 'detail';
      }
      return 'other';
    }

    var urlCity    = new URLSearchParams(window.location.search).get('city') || '';
    var storedCity = localStorage.getItem(STORAGE_KEY) || '';
    // URL param is the ground truth (set by us on city change); fallback to localStorage
    var activeCity = urlCity || storedCity;

    // Server may embed a city list (only on /new-home).  Other pages fetch lazily.
    var __serverCities = null;

    var citiesCache = __serverCities; // null until fetched on non-home pages
    var fetchInProgress = false;

    // ── Render city options into both containers ──────────────────────────
    function renderCities(names) {
      var desktopGrid = document.getElementById('cityGridDesktop');
      var mobileGrid  = document.getElementById('cityGridMobile');

      [
        { el: desktopGrid, optClass: 'city-grid-option',  allClass: 'city-grid-option city-all' },
        { el: mobileGrid,  optClass: 'city-sheet-option', allClass: 'city-sheet-option city-sheet-all' }
      ].forEach(function (cfg) {
        if (!cfg.el) return;
        cfg.el.innerHTML = '';

        var allBtn = document.createElement('div');
        allBtn.className = cfg.allClass;
        if (!activeCity) allBtn.classList.add('active');
        allBtn.setAttribute('data-city', '');
        allBtn.textContent = 'All Cities';
        cfg.el.appendChild(allBtn);

        names.forEach(function (name) {
          var btn = document.createElement('div');
          btn.className = cfg.optClass;
          if (name === activeCity) btn.classList.add('active');
          btn.setAttribute('data-city', name);
          btn.textContent = name;
          cfg.el.appendChild(btn);
        });

        // Attach click handlers to newly created elements
        cfg.el.querySelectorAll('[data-city]').forEach(function (el) {
          el.addEventListener('click', handleCityClick);
        });
      });
    }

    // Fetch from API (called once, result cached)
    function ensureCities(callback) {
      if (citiesCache) { callback(citiesCache); return; }
      if (fetchInProgress) return;
      fetchInProgress = true;
      fetch('/api/city/')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          fetchInProgress = false;
          if (data.success && data.cities && data.cities.length) {
            citiesCache = data.cities;
            callback(citiesCache);
          }
        })
        .catch(function () { fetchInProgress = false; });
    }

    // ── Pill label ────────────────────────────────────────────────────────
    var label = document.getElementById('globalCityLabel');
    if (label) label.textContent = activeCity || 'All Cities';

    // ── Update Explore dropdown hrefs ─────────────────────────────────────
    if (activeCity) {
      var cq = '?city=' + encodeURIComponent(activeCity);
      document.querySelectorAll('.dropdown-item').forEach(function (a) {
        var href = a.getAttribute('href');
        if (href && LISTING_PAGES.indexOf(href) !== -1) a.setAttribute('href', href + cq);
      });
    }

    // ── City selection handler ────────────────────────────────────────────
    function handleCityClick(e) {
      e.stopPropagation();
      var city = this.getAttribute('data-city');

      // ── Analytics: fire a dataLayer event so GTM/GA4 can track city selection ──
      // Create a GTM Custom Event trigger on event name "city_selector_used", and a
      // GA4 Event tag reading city_name / previous_city to see city-switch usage.
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'city_selector_used',
        city_name: city || 'All Cities',
        previous_city: activeCity || 'All Cities',
        page_path: window.location.pathname
      });

      // Close UI immediately so the page doesn't feel frozen while navigating
      if (dropdown) dropdown.classList.remove('open');
      closeSheet();

      if (city) { localStorage.setItem(STORAGE_KEY, city); } else { localStorage.removeItem(STORAGE_KEY); }
      var pageType = getPageType(window.location.pathname);
      var url = new URL(window.location.href);
      // Sync city to cookie so the home page SSR can read it without a ?city= param
      if (city) {
        document.cookie = 'assetzilla_city=' + encodeURIComponent(city) + '; path=/; max-age=2592000; SameSite=Lax';
      } else {
        document.cookie = 'assetzilla_city=; path=/; max-age=0; SameSite=Lax';
      }
      if (pageType === 'listing') {
        if (city) { url.searchParams.set('city', city); } else { url.searchParams.delete('city'); }
        window.location.href = url.toString();
      } else if (pageType === 'detail') {
        if (city) { url.searchParams.set('city', city); } else { url.searchParams.delete('city'); }
        history.replaceState(null, '', url.toString());
      } else {
        // Home page: put city in URL so analytics can track usage
        if (city) { url.searchParams.set('city', city); } else { url.searchParams.delete('city'); }
        window.location.href = url.toString();
      }
    }

    // ── Open / close helpers ──────────────────────────────────────────────
    var pill       = document.getElementById('globalCityPill');
    var dropdown   = document.getElementById('globalCityDropdown');
    var overlay    = document.getElementById('citySheetOverlay');
    var sheet      = document.getElementById('cityBottomSheet');
    var sheetClose = document.getElementById('citySheetClose');

    function openSheet()  { if (overlay) overlay.classList.add('open');    if (sheet) sheet.classList.add('open'); }
    function closeSheet() {
      if (overlay) overlay.classList.remove('open');
      if (sheet) sheet.classList.remove('open');
      if (dropdown) dropdown.classList.remove('open');
    }

    function openCityUI() {
      ensureCities(function (names) {
        renderCities(names);
        if (window.innerWidth <= 991) {
          if (dropdown) dropdown.classList.add('open');
        } else {
          if (dropdown) dropdown.classList.add('open');
        }
      });
    }

    if (pill) {
      pill.addEventListener('click', function (e) {
        e.stopPropagation();
        if (window.innerWidth <= 991) {
          if (dropdown && dropdown.classList.contains('open')) { closeSheet(); return; }
        } else {
          if (dropdown && dropdown.classList.contains('open')) { dropdown.classList.remove('open'); return; }
        }
        openCityUI();
      });
    }

    document.addEventListener('click', function () {
      closeSheet();
    });

    if (overlay)    overlay.addEventListener('click', closeSheet);
    if (sheetClose) sheetClose.addEventListener('click', function (e) { e.stopPropagation(); closeSheet(); });

    // Pre-render immediately if we already have the city list (new-home SSR data)
    if (citiesCache) renderCities(citiesCache);

  });
</script>
<script>
  function scrollto(divid) {
    const div_in_question = document.querySelector(divid);
    // console.log(div_in_question)
    div_in_question.scrollIntoView({ behavior: "smooth", block: "start", inline: "nearest" })
    // console.log(window.innerHeight, window.innerWidth)
  }
</script>
<script>
  var isPWAMode = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
  if (isPWAMode) { document.body.classList.add('pwa-mode'); }

  // --- PWA LIFO nav-stack -------------------------------------------
  // Runs on every page (navigation.ejs is a universal partial).
  // Pushes the current URL onto a sessionStorage stack so back buttons
  // can always navigate with location.href — never history.back().
  (function () {
    var STACK_KEY = 'pwaNavStack';

    function getStack() {
      try { return JSON.parse(sessionStorage.getItem(STACK_KEY) || '[]'); }
      catch (e) { return []; }
    }
    function saveStack(s) {
      try { sessionStorage.setItem(STACK_KEY, JSON.stringify(s)); } catch (e) {}
    }

    // Push current URL; skip if it's already the top (handles page refresh)
    var stack = getStack();
    var cur = window.location.href;
    if (stack[stack.length - 1] !== cur) {
      stack.push(cur);
      saveStack(stack);
    }

    // Pop current page and navigate to the previous one.
    // fallback is used when the stack is exhausted (e.g. cold PWA launch).
    window.pwaGoBack = function (fallback) {
      var s = getStack();
      s.pop();           // remove current page
      saveStack(s);
      window.location.href = s.length > 0 ? s[s.length - 1] : (fallback || '/');
    };

    // Peek at where pwaGoBack would land without navigating.
    // Used by pages that need to prep state (e.g. scroll restore) before navigating.
    window.pwaGetPrevUrl = function (fallback) {
      var s = getStack();
      return s.length >= 2 ? s[s.length - 2] : (fallback || '/');
    };
  })();
  // --- end PWA LIFO nav-stack ----------------------------------------

  
  if (isPWAMode) {
    document.addEventListener('DOMContentLoaded', function () {
      document.getElementById('loginModal-close-btn').style.display = 'none';
      $('#loginModal').modal({ backdrop: 'static', keyboard: false });
      $('#loginModal').modal('show');
      $('#loginModal').on('hide.bs.modal', function (e) {
        e.preventDefault();
        e.stopImmediatePropagation();
        return false;
      });
    });
  }
  

  function customAlert(message, title) {
    let notification_customAlert_div = document.querySelector('#notification-customAlert-div');
    let notification_customAlert_title = document.querySelector('#notification-customAlert-title');
    let notification_customAlert_body = document.querySelector('#notification-customAlert-body');

    if (title) {
      notification_customAlert_title.innerHTML = `<h4 class="font-family: lato-regular; text-center" style="color:#89ae51; font-weight:bold; padding-top:1rem;">${title}</h4>`
    }
    notification_customAlert_body.innerHTML = message;

    $('#customcustomAlertClick').click()
  }
</script>

