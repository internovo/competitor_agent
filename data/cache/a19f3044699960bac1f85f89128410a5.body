<script>
  function azGoBack() {
    // Peek at destination first so we can prep scroll-restore state before navigating
    var dest = pwaGetPrevUrl('/projects');
    try {
      var savedY = sessionStorage.getItem('az_scroll·' + dest);
      if (savedY !== null) sessionStorage.setItem('az_restore·' + dest, savedY);
    } catch (_) {}
    pwaGoBack('/projects');
  }
</script>

