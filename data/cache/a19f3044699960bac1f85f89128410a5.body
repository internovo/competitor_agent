<head>
  <!-- Hide page instantly if a scroll-restore is pending — must run before first paint -->
  <script>
    (function () {
      try {
        if (sessionStorage.getItem('az_restore·' + window.location.href) !== null) {
          document.documentElement.style.opacity = '0';
        }
      } catch (e) {}
    })();
  </script>
  <script>
    (function () {
      var LISTING_PAGES = ['/properties', '/projects', '/authorities', '/banks'];
      if (LISTING_PAGES.indexOf(window.location.pathname) === -1) return;
      var urlCity = new URLSearchParams(window.location.search).get('city');
      if (urlCity) return;
      var city = localStorage.getItem('assetzilla_city');
      if (!city) return;
      var url = new URL(window.location.href);
      url.searchParams.set('city', city);
      window.location.replace(url.toString());
    })();
  </script>

  <!-- Back-navigation state: save scroll on every leave; restore on return -->
  <script>
    (function () {
      // Take full control of scroll restoration so bfcache doesn't fight us
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

      // 1. Save scroll continuously as user scrolls (debounced 200 ms).
      var _azScrollTimer;
      window.addEventListener('scroll', function () {
        clearTimeout(_azScrollTimer);
        _azScrollTimer = setTimeout(function () {
          try { sessionStorage.setItem('az_scroll·' + window.location.href, window.scrollY); } catch (e) {}
        }, 200);
      }, { passive: true });

      // Also save on pagehide as a final snapshot (belt-and-suspenders)
      window.addEventListener('pagehide', function () {
        try { sessionStorage.setItem('az_scroll·' + window.location.href, window.scrollY); } catch (e) {}
      });

      // 2. Restore scroll when returning from a detail page.
      window.addEventListener('pageshow', function () {
        try {
          var restoreKey = 'az_restore·' + window.location.href;
          var pendingY = sessionStorage.getItem(restoreKey);
          if (pendingY === null) return;
          sessionStorage.removeItem(restoreKey);
          var y = parseInt(pendingY, 10);
          // opacity already set to 0 by the head script before first paint
          requestAnimationFrame(function () {
            window.scrollTo(0, y);
            setTimeout(function () {
              window.scrollTo(0, y);
              // Reveal after scroll has settled
              document.documentElement.style.transition = 'opacity 0.15s ease';
              document.documentElement.style.opacity = '1';
              // Clean up the transition so it doesn't affect anything else
              setTimeout(function () { document.documentElement.style.transition = ''; }, 200);
            }, 150);
          });
        } catch (e) {
          document.documentElement.style.opacity = '1';
        }
      });
    })();
  </script>
  
