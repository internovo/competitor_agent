<!-- Custom CSS for handling scrolling and mobile responsiveness -->
<style>
    .pdf-viewer-container {
        overflow-x: hidden;
        overflow-y: scroll;
        position: relative;
        height: 75vh;
        display: block;
    }

    .pdf-viewer-container canvas {
        margin: 0 auto;
        align-self: center;
        display: block;
    }

    .canvas-wrapper {
        display: block;
        margin: 0 auto 12px auto;
        width: fit-content;
    }



    .pdf-viewer-container,
    .modal-body.embed-wrapper {
        padding-top: 0;
        /* Default padding */
        display: block;
    }

    .modal-dialog-centered {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        /* Full viewport height to ensure it's centered */
        margin: 0 auto;
        /* Center horizontally */
    }

    /* Remove centering margin from canvas elements */
    /* .pdf-viewer-container canvas {
        display: block;
        margin: 0 auto;
    } */

    .zoom-controls {
        margin-bottom: 10px;
        text-align: center;
    }

    /* Fix the modal height to 80vh */
    .modal-fixed-height {
        height: 80vh;
        margin-top: 1.75rem !important;
        max-height: 80vh;
        width: 90vw;
        max-width: 90vw;
        /* margin: auto; */
    }

    /* Ensure the modal content fills the modal dialog */
    .modal-fixed-height .modal-content {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* Ensure the modal body fills the remaining space and is scrollable */
    .modal-fixed-height .modal-body.embed-wrapper {
        flex: 1 1 auto;
        overflow-y: scroll;
        /* Always show vertical scrollbar */
    }

    /* Adjust modal header and zoom controls */
    .modal-fixed-height .modal-header,
    .modal-fixed-height .zoom-controls {
        flex: 0 0 auto;
    }

    /* Ensure the modal background is white */
    .modal-fixed-height .modal-content {
        background-color: white;
    }

    /* PDF Viewer Canvas Styling */
    .modal-fixed-height .modal-body.embed-wrapper canvas {
        display: block;
        margin: 0 auto;
    }

    /* Button List Horizontal Styling */
    .button-list-hor ul {
        list-style: none;
        padding: 0;
        margin: 0 0 10px 0;
        display: flex;
        flex-wrap: wrap;
    }

    .button-list-hor ul li {
        margin: 5px 5px 5px 0;
        /* Adjust margins as needed */
    }

    /* Responsive size for mobile screens */
    @media only screen and (max-width: 768px) {
        .modal-fixed-height {
            height: 60vh !important;
            ;
            margin-top: 1rem !important;
            max-height: 60vh !important;
            ;
            width: 90vw !important;
            ;
            max-width: 90vw !important;
            ;
        }

        .card-collapse {
            max-height: 60vh;
            overflow-y: auto;
        }

        .pdf-viewer-container {
            height: 35vh;
            /* Adjusted height for PDF viewer */
            margin: auto;
        }

        .modal-body.embed-wrapper {
            height: 60vh !important;
            overflow-y: scroll !important;

        }

        .zoom-controls {
            position: relative;
            top: 0;
            z-index: 100;
        }

        .button-list-hor ul {
            justify-content: flex-start;
            /* Align buttons to the left */
        }

        .pdf-overlay {
            margin-top: 10px;
            text-align: center;
        }
    }

    /* Loader for PDF loading */
    .loading-skeleton {
        display: flex;
        justify-content: center;
        /* z-index: 100; */
        align-items: center;
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.8);
        z-index: 1000;
    }

    .loading-skeleton span {
        border: 4px solid rgba(0, 0, 0, 0.1);
        border-left-color: #007bff;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    /* Ensure the loader is hidden by default */
    .loading-skeleton.hidden {
        display: none;
    }
</style>

<script>
    // Debounce function
    function debounce(func, wait) {
        let timeout;
        return function (...args) {
            const context = this;
            clearTimeout(timeout);
            timeout = setTimeout(() => func.apply(context, args), wait);
        };
    }

    const pdfInstances = {};
    const currentPDFIndex = {};
    const baseUrl = window.location.origin;

    // Function to check if the device is mobile
    function isMobileDevice() {
        return window.innerWidth <= 768; // Adjust the width as needed
    }

    // Function to clear container except elements with a given class
    function clearContainerExcept(container, exceptionClass) {
        Array.from(container.children).forEach(child => {
            if (!child.classList.contains(exceptionClass)) {
                container.removeChild(child);
            }
        });
    }

    function showFirstPDF(type, planType, data) {
        const pdfList = data[planType] || [];
        if (pdfList.length > 0) {
            selectPDF(type, 0, pdfList[0]);
        }
    }

    function selectPDF(type, index, pdfFileName) {
        // ── Analytics: fire a dataLayer event so GTM/GA4 can track plan/document views ──
        // Create a GTM Custom Event trigger on event name "plan_viewed", and a GA4 Event
        // tag reading plan_type (floor_plan / site_plan / brochure / specification /
        // other_document) to see which document types get viewed most.
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
            event: 'plan_viewed',
            plan_type: type,
            plan_index: index,
            page_path: window.location.pathname
        });
        // Remove active class from all buttons
        document.querySelectorAll(`.${type}-pdf-btn`).forEach(btn => {
            btn.classList.remove('active-pdf');
            btn.style.backgroundColor = ''; // Reset background color
            btn.style.color = ''; // Reset text color
            btn.style.fontSize = ''; // Reset font size
        });

        // Get the "Click Here to View Full Screen" button's styles
        const fullscreenButton = document.getElementById('fullscreen-button');
        const computedStyles = window.getComputedStyle(fullscreenButton);
        const backgroundColor = computedStyles.backgroundColor;
        const color = computedStyles.color;
        const fontSize = computedStyles.fontSize;

        // Add active class and apply styles to the clicked button
        const activeButton = document.getElementById(`${type}-button-${index}`);
        activeButton.classList.add('active-pdf');
        activeButton.style.backgroundColor = backgroundColor; // Use fullscreen button's background color
        activeButton.style.color = color; // Use fullscreen button's text color
        activeButton.style.fontSize = fontSize; // Use fullscreen button's font size

        currentPDFIndex[type] = index;
        loadPDF(type, pdfFileName, index);
    }

    function loadPDF(type, pdfFileName, index) {
        const url = `${baseUrl}/api/project/document?url=dyn-res/project/doc/${pdfFileName}`;
        const container = document.getElementById(`${type}-pdf-viewer-${index}`);
        const loader = document.getElementById(`${type}-loader-${index}`);

        // Show loader
        loader.classList.remove('hidden');

        // Hide other pdf-viewer-containers
        document.querySelectorAll(`#${type}-pdf-viewer > div.pdf-viewer-container`).forEach(div => {
            div.style.display = 'none';
        });
        container.style.display = 'block';

        // Remove child nodes except the loader
        clearContainerExcept(container, 'loading-skeleton');

        let pdfDoc = null;
        let scale = 1.0;
        let cssScale = 1.0;

        // Initialize pdfInstances[type] if not already
        pdfInstances[type] = pdfInstances[type] || {};

        // Replace the existing 'normal' instance with the new one
        pdfInstances[type]['normal'] = { pdfDoc, scale, container, cssScale };

        pdfjsLib.getDocument(url).promise.then(function (pdfDoc_) {
            pdfInstances[type]['normal'].pdfDoc = pdfDoc_;
            pdfInstances[type]['normal'].totalPages = pdfDoc_.numPages;
            fitToWidth(type, 'normal');

            // Hide the loader after the PDF is rendered
            loader.classList.add('hidden');
        }).catch(error => {
            console.error(`Error loading ${type} PDF: `, error);
            loader.classList.add('hidden'); // Hide loader in case of error
        });
    }
    function fitToWidth(type, mode = 'normal') {
        const instance = pdfInstances[type][mode];
        const pdfDoc = instance.pdfDoc;
        const container = instance.container;

        // Clear any existing canvases
        const oldPages = container.querySelectorAll('canvas, .canvas-wrapper');
        oldPages.forEach(el => el.remove());

        let containerWidth = container.clientWidth - 16;
        const devicePixelRatio = window.devicePixelRatio || 1;
        let maxPageWidth = 0;

        // Step 1: Determine the maximum width among all pages
        const widthPromises = [];
        for (let num = 1; num <= pdfDoc.numPages; num++) {
            const widthPromise = pdfDoc.getPage(num).then(function (page) {
                const viewport = page.getViewport({ scale: 1 });
                if (viewport.width > maxPageWidth) maxPageWidth = viewport.width;
            });
            widthPromises.push(widthPromise);
        }

        // Step 2: Apply scaling and render each page
        Promise.all(widthPromises).then(() => {
            const fitToWidthScale = containerWidth / maxPageWidth;
            instance.scale = fitToWidthScale;
            instance.cssScale = 1;
            instance.lastCssScale = 1;

            // Render each page using the calculated scale
            for (let num = 1; num <= pdfDoc.numPages; num++) {
                pdfDoc.getPage(num).then(function (page) {
                    const adjustedScale = instance.scale * devicePixelRatio;
                    const viewport = page.getViewport({ scale: adjustedScale });

                    // Create a wrapper div for the canvas
                    const canvasWrapper = document.createElement('div');
                    canvasWrapper.classList.add('canvas-wrapper');

                    const canvas = document.createElement('canvas');
                    canvas.setAttribute('data-page-number', num);
                    canvas.width = viewport.width;
                    canvas.height = viewport.height;
                    const baseWidth = viewport.width / devicePixelRatio;
                    const baseHeight = viewport.height / devicePixelRatio;
                    canvas.dataset.baseWidth = String(baseWidth);
                    canvas.dataset.baseHeight = String(baseHeight);
                    canvas.style.width = `${baseWidth}px`;
                    canvas.style.height = `${baseHeight}px`;
                    canvas.style.margin = '0 auto';
                    canvasWrapper.style.width = `${baseWidth}px`;
                    canvasWrapper.style.height = `${baseHeight}px`;

                    const renderContext = {
                        canvasContext: canvas.getContext('2d'),
                        viewport: viewport,
                    };

                    page.render(renderContext).promise.then(() => {
                        canvasWrapper.appendChild(canvas);
                        container.appendChild(canvasWrapper);
                    });
                }).catch(error => console.error(`Error rendering page ${num}:`, error));
            }
        }).catch(error => console.error('Error determining maximum page width:', error));
    }


    // Zoom functions using CSS scaling with debouncing and centered zoom
    function zoomIn(type, mode = 'normal') {
        const instance = pdfInstances[type][mode];
        instance.cssScale = (instance.cssScale || 1) + 0.25;
        if (!instance.applyCssScaleDebounced) {
            instance.applyCssScaleDebounced = debounce(() => applyCssScaleCentered(instance, instance.cssScale), 100);
        }
        instance.applyCssScaleDebounced();
    }

    function zoomOut(type, mode = 'normal') {
        const instance = pdfInstances[type][mode];
        instance.cssScale = (instance.cssScale || 1) - 0.25;
        if (instance.cssScale < 1) instance.cssScale = 1;
        if (!instance.applyCssScaleDebounced) {
            instance.applyCssScaleDebounced = debounce(() => applyCssScaleCentered(instance, instance.cssScale), 100);
        }
        instance.applyCssScaleDebounced();
    }

    function applyCssScaleCentered(instance, scale) {
        const container = instance.container;
        const canvases = container.querySelectorAll('canvas');

        // Calculate the center point before scaling
        const containerRect = container.getBoundingClientRect();
        const containerCenterX = container.scrollLeft + container.clientWidth / 2;
        const containerCenterY = container.scrollTop + container.clientHeight / 2;

        const preZoomCenterX = containerCenterX / (instance.lastCssScale || 1);
        const preZoomCenterY = containerCenterY / (instance.lastCssScale || 1);

        // Apply scale to canvases and their wrappers without using transforms
        canvases.forEach(canvas => {
            const baseWidth = parseFloat(canvas.dataset.baseWidth || canvas.width);
            const baseHeight = parseFloat(canvas.dataset.baseHeight || canvas.height);
            const scaledWidth = baseWidth * scale;
            const scaledHeight = baseHeight * scale;

            canvas.style.width = `${scaledWidth}px`;
            canvas.style.height = `${scaledHeight}px`;

            const wrapper = canvas.closest('.canvas-wrapper');
            if (wrapper) {
                wrapper.style.width = `${scaledWidth}px`;
                wrapper.style.height = `${scaledHeight}px`;
            }
        });

        // Update scroll position to keep the center point
        const newScrollLeft = preZoomCenterX * scale - container.clientWidth / 2;
        const newScrollTop = preZoomCenterY * scale - container.clientHeight / 2;

        container.scrollLeft = newScrollLeft;
        container.scrollTop = newScrollTop;

        // Save the last cssScale
        instance.lastCssScale = scale;

        // Enable x-axis scrollbar
        container.style.overflowX = 'auto';
    }

    function closeModalPDF(type) {
        if (pdfInstances[type] && pdfInstances[type]['modal']) {
            delete pdfInstances[type]['modal'];
        }
    }

    function loadPDFInModal(type) {
        const index = currentPDFIndex[type];
        const pdfFileName = document.getElementById(`${type}-button-${index}`).getAttribute('data-url');
        const url = `${baseUrl}/api/project/document?url=dyn-res/project/doc/${pdfFileName}`;
        const container = document.getElementById(`modal-${type}-pdf-viewer`);
        const loader = document.getElementById(`modal-${type}-loader`);

        // Show the loader while loading the PDF
        loader.classList.remove('hidden');

        // Remove child nodes except the loader
        clearContainerExcept(container, 'loading-skeleton');

        // Initialize pdfInstances[type] if not already
        pdfInstances[type] = pdfInstances[type] || {};

        // Replace the existing 'modal' instance
        pdfInstances[type]['modal'] = {
            pdfDoc: null,
            scale: 1.0,
            container,
            cssScale: 1.0
        };

        pdfjsLib.getDocument(url).promise.then(function (pdfDoc_) {
            pdfInstances[type]['modal'].pdfDoc = pdfDoc_;
            pdfInstances[type]['modal'].totalPages = pdfDoc_.numPages;

            fitToWidth(type, 'modal');

            // Hide the loader after the PDF is rendered
            loader.classList.add('hidden');
        }).catch(error => {
            console.error(`Error loading ${type} PDF in modal: `, error);
            loader.classList.add('hidden'); // Hide loader in case of error
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        const pdfContainers = document.querySelectorAll('.pdf-viewer-container');
        pdfContainers.forEach(container => {
            container.addEventListener('contextmenu', function (event) {
                event.preventDefault();
            });
        });

        const documentTypes = ['floor_plan', 'site_plan', 'brochure', 'specification', 'other_document'];

        if (documentTypes.length > 0 && data[documentTypes[0]] && data[documentTypes[0]].length > 0) {
            showFirstPDF(documentTypes[0], documentTypes[0], data);
        }
    });
</script>

