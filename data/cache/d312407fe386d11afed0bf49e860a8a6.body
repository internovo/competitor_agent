 with Ample Amount of Natural light due to which there is no need to turn on the lights in the entire house until 7pm\n\nWell maintained Flat in a Well Maintained Society in the Best Location of Borivali. \n\nFlat is  350 meters walk to Borivali Metro Station & 450 Meters Walk to Shimpoli Metro Station\n\n1 Open Car Park & Bike Parking is available in the Society Premises","furnishing":"SEMI_FURNISHED","photoAvailable":true,"flooring":"MARBLE_GRANITE","expectedRent":39196.74,"shortUrl":"http:\u002F\u002Fnobr.kr\u002Fsl\u002FV7B13","promoted_b":false,"carpetArea":650,"verifiedByUser":"8aa98adba0098d0601a00ab35efd73f7","title":"2 BHK Flat In Prathamesh Horizon For Sale  In Borivali West","nbLocality":"Borivali","society":"Prathamesh Horizon","ownerName":"pradeep","street":"Sai Lee Hospital ","propertyType":"BUY","secondaryTitle":"Sai Lee Hospital ","aea__":{"REASON_FOR_SELLING":{"value":"Relocation"},"KHATA_CERTIFICATE":{"display_value":"null","value":"NULL"},"ACCURATE_LOCATION":{"display_value":"Accurate","value":"ACCURATE"},"LOAN_AVAILABILITY":{"value":"All Banks"},"UNIQUE_SELLING_POINTS":{"value":"4 sided open, Fully Airy, Breezy & Ventilated Flat,  Fully Vastu Compliant, Prime Location of Borivali West"},"RERA_APPROVED":{"display_value":"null","value":"NULL"},"ACTUAL_BUILDING_AGE":{"value":"20"},"EXPECTED_RENT":{"value":"50000"},"PROPERTY_TAX":{"display_value":"yes","value":"YES"},"PARKING_TYPE":{"value":"NOT_COVERED"},"HOUSE_KEY_WITH":{"display_value":"I will show","value":"I_HAVE_KEYS"},"CURRENT_SITUATION":{"display_value":"Self Occupied","value":"SELF_OCCUPIED"},"KHATA_CERTIFICATE_TYPE":{"display_value":"null","value":"NULL"},"MAX._NEGOTIATED_PRICE":{"value":"100000"},"SALE_DEED":{"display_value":"yes","value":"YES"},"CONVERSION_CERTIFICATE":{"display_value":"null","value":"NULL"},"DIRECTIONS":{"value":"Landmark: Sai Lee Hospital "},"OCCUPATION_CERTIFICATE":{"display_value":"yes","value":"YES"},"ALLOTMENT_LETTER":{"display_value":"Yes","value":"YES"},"SALE_AGRE