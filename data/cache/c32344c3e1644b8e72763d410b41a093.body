            document.addEventListener('DOMContentLoaded', function () {
                setTimeout(function () {
                    $('#blog_detail_modal').modal('show');
                }, 30000); // 30 seconds
            });
             $(document).on('click', '#blog_detail_modal .close', function (e) {
