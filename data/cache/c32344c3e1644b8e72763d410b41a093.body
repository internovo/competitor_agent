<script>
document.addEventListener("DOMContentLoaded", function () {

    var phoneInput = document.querySelector("#exitpopup-phone");
    var form = document.querySelector("#exitpopup_form");

    if (!phoneInput) return;

    var iti = window.intlTelInput(phoneInput, {
        initialCountry: "in",
        separateDialCode: true
    });

    function updateCountryCode() {
        var countryData = iti.getSelectedCountryData();
        document.getElementById("exitpopup-CountryCode").value =
            "+" + countryData.dialCode;
    }

    // Update when country changes
    phoneInput.addEventListener("countrychange", function () {
        updateCountryCode();
    });

    // Update once on load
    updateCountryCode();

    // Force update before submit
    form.addEventListener("submit", function () {
        updateCountryCode();

        // Optional: Send full number
        phoneInput.value = iti.getNumber();
    });

});
</script>

<script src="https://www.google.com/recaptcha/api.js?render=6LfSXHksAAAAAG2SSWUhfVcRnViIWmaBxqUNheqn"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    // ✅ add all form IDs here
    const allowedForms = [
        "exitpopup_form",
        "broch_down_new",
        "property_card_form",
        "footer_sticky_formwhy",
        "commercial-form",
        "connect-formhomeguied",
        "footer_sticky_form",
        "connect-form",
    ];

    allowedForms.forEach(function(formId){

        const form = document.getElementById(formId);

        if (!form) return;

        form.addEventListener("submit", function (e) {

            // already verified
            if (form.dataset.captchaVerified === "true") {
                return;
            }

            e.preventDefault();

            grecaptcha.ready(function () {

                grecaptcha.execute(
                    "6LfSXHksAAAAAG2SSWUhfVcRnViIWmaBxqUNheqn",
                    { action: "submit" }
                ).then(function (token) {

                    console.log("TOKEN ("+formId+"):", token);

                    let input = form.querySelector("input[name='gtoken']");

                    if (!input) {
                        input = document.createElement("input");
                        input.type = "hidden";
                        input.name = "gtoken";
                        form.appendChild(input);
                    }

                    input.value = token;

                    form.dataset.captchaVerified = "true";

                    // small delay for safety
                    setTimeout(function () {
                        form.submit();
                    }, 200);

                });

            });

        }, true);

    });

});
</script>


<script>
if (window.location.hostname === "casagrand.co.in") {
    window.location.href = "https://www.casagrand.co.in" + window.location.pathname;
}

document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("form").forEach(function (form) {
        let input = document.createElement("input");

        input.type = "hidden";
        input.name = "current_page_url";

        // URL only, without GET/query parameters
        let currentUrl = window.location.origin + window.location.pathname;

        // Maximum 255 characters
        input.value = currentUrl.substring(0, 250);

        form.appendChild(input);
    });
});
</script>





