.video-wrapper {
    position: relative;
    cursor: pointer;
}

/* Center play button */
.play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 68px;
    height: 48px;
    background: rgba(0,0,0,0.75);
    border-radius: 14px;
}

.play-button::before {
    content: "";
    position: absolute;
    left: 26px;
    top: 13px;
    width: 0;
    height: 0;
    border-left: 18px solid white;
    border-top: 11px solid transparent;
    border-bottom: 11px solid transparent;
}

/* Button container */
.yt-buttons {
    position: absolute;
    bottom: 18px;
    left: 20px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

/* Individual YouTube-style buttons */
.yt-btn {
    padding: 6px 14px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 18px;
    border: none;
    cursor: pointer;
    color: white;
    background: rgba(0,0,0,0.65);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    gap: 6px;
    transition: 0.2s ease;
}

.yt-btn:hover {
    background: rgba(0,0,0,0.85);
}

/* Watch button (red YouTube style) */
.yt-watch {
    background: #ff0000;
}
.yt-watch:hover { background: #cc0000; }

/* Share button (gray) */
.yt-share { background: rgba(0,0,0,0.65); }

/* Watch Later button (gray/blue style) */
.yt-later { background: #3ea6ff; }
.yt-later:hover { background: #1c8cff; }

/* Save button (gray/green style) */
.yt-save { background: #4caf50; }
.yt-save:hover { background: #388e3c; }

.video-thumb,
.play-button {
    pointer-events: none !important;
}

.yt-buttons {
    z-index: 999 !important;
    pointer-events: auto !important;
}

.yt-btn {
    pointer-events: auto !important;
}
#quoteModal .modal-content {
    padding: 0px;
}
