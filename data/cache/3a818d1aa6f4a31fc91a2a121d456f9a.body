	<script>
    /* =========================
       GLOBAL SAFE GUARDS (NO JS CRASH)
    ========================= */
    
    // Prevent undefined function errors
    window.safeCall = function(fn, fallback = function(){}) {
        try {
            if (typeof fn === "function") return fn();
            return fallback();
        } catch (e) {
            console.error("SafeCall Error:", e);
            return fallback();
        }
    };
    
    // Prevent "undefined variable" crashes
    window.getVal = function(selector) {
        let el = document.querySelector(selector);
        return el ? el.value : '';
    };
    </script>
    <script>
    $(document).ready(function () {
    
        $(document).on('click', '.btn-submit', function (e) {
            e.preventDefault();
    
            var btn = $(this);
            var form = btn.closest('form');
            var modal = btn.closest('.modal');
    
            btn.prepend('<i class="fa fa-spinner fa-spin"></i>');
            btn.attr("disabled", true);
    
            $.ajax({
                url: "https://keystonerealestateadvisory.com/my-form",
                type: "POST",
                data: form.serialize(),
                success: function (data) {
    
                    btn.find(".fa-spinner").remove();
                    btn.removeAttr("disabled");
    
                    if ($.isEmptyObject(data.error)) {
                        printSuccessMsg(data.success, form, modal);
                    } else {
                        printErrorMsg(data.error, form);
                    }
                }
            });
        });
    
        function printSuccessMsg(msg, form, modal) {
            var successBox = modal.find(".print-success-msg");
    
            successBox.find("ul").html('');
            successBox.show().find("ul")
                .append('<li>Our Sales team will get back to you shortly!</li>');
    
            setTimeout(function () {
                successBox.hide();
                modal.modal('hide');
                form[0].reset();
            }, 3000);
        }
    
        function printErrorMsg(msg, form) {
            var errorBox = form.closest('.modal').find(".print-error-msg");
    
            errorBox.find("ul").html('');
            errorBox.show();
    
            $.each(msg, function (key, value) {
                errorBox.find("ul").append('<li>' + value + '</li>');
            });
    
            setTimeout(function () {
                errorBox.hide();
            }, 3000);
        }
    
    });
    </script>
    
	
	<script>
    let tags = [];
    
    // Ensure element exists before binding
    $(document).ready(function () {
    
        if ($('#search_input').length) {
    
            $('#search_input').on('keypress', function(e){
                if(e.which === 13){
                    e.preventDefault();
    
                    let val = $(this).val().trim();
    
                    if(val !== '' && !tags.includes(val)){
                        tags.push(val);
                        renderTags();
                    }
    
                    $(this).val('');
                }
            });
    
        }
    
    });
    
    // Render tags safely
    function renderTags(){
        if(!$('#tag-container').length) return;
    
        $('#tag-container').html('');
    
        tags.forEach((tag, index) => {
            $('#tag-container').append(`
                <div class="tag">
                    ${tag} <span onclick="removeTag(${index})">×</span>
                </div>
            `);
        });
    }
    
    // Remove tag safely
    function removeTag(index){
        if(index > -1){
            tags.splice(index, 1);
            renderTags();
        }
    }
    
    // MAIN SEARCH FUNCTION (SAFE)
    function funSearch(){
    
        // 1. Try dropdown
        let city = $('#city_select').length ? $('#city_select').val() : '';
    
        // 2. Fallback → hidden field (search page)
        if(!city){
            city = $('#city').length ? $('#city').val() : '';
        }
    
        // 3. Fallback → URL (important for detail page)
        if(!city){
            let params = new URLSearchParams(window.location.search);
            city = params.get('city');
        }
    
        if(!city){
            city = 'mumbai'; // default
        }
    
        let query = tags.map(t => "str[]=" + encodeURIComponent(t)).join("&");
    
        let url = "/buy/search?city=" + encodeURIComponent(city);
    
        if(query){
            url += "&" + query;
        }
    
        window.location.href = url;
    }
	function applyMobileFilters(){

    let form = document.getElementById('categoryFilterMobile');

    // Add search tags
    form.querySelectorAll('input[name="str[]"]').forEach(el => el.remove());

    mobileTags.forEach(tag => {
        let input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'str[]';
        input.value = tag;
        form.appendChild(input);
    });

    // City (from hidden field)
    let city = document.getElementById('mobile_city_select')?.value || 'mumbai';
        document.getElementById('city').value = city;

    form.submit();
}
	</script>
	
    	
	<!--<link href="https://cdnjs.cloudflare.com/ajax/libs/owl-carousel/1.3.3/owl.carousel.css" rel="stylesheet">-->
<!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/owl-carousel/1.3.3/owl.carousel.js"></script>-->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    let emiChart; // Declare the chart variable globally

function calculateEMI() {
    let loanAmount = document.getElementById('loan-amount').value;
    let annualRate = document.getElementById('annual-rate').value;
    let loanTenure = document.getElementById('loan-tenure').value;

    if (loanAmount && annualRate && loanTenure) {
        let monthlyRate = annualRate / 12 / 100;
        let totalMonths = loanTenure * 12;

        let emi = (loanAmount * monthlyRate * Math.pow(1 + monthlyRate, totalMonths)) / (Math.pow(1 + monthlyRate, totalMonths) - 1);
        document.getElementById('emi-amount').innerText = formatRupee(emi);

        let totalPayment = emi * totalMonths;
        let totalInterest = totalPayment - loanAmount;

        let emiDetails = `
            <p class="label">Principal Amount <span class="value"> ₹${formatRupee(loanAmount)}</span></p>
             <p class="label">Interest Amount <span class="value"> ₹${formatRupee(totalInterest)}</span></p>
            <p class="label">Total Amount Payable <span class="value"> ₹${formatRupee(totalPayment)}</span></p>
            
        `;
        //  <p><strong>Annual ROI</strong> ${annualRate}%</p>
        //     <p><strong>Loan Tenure</strong> ${loanTenure} years</p>
          
        document.getElementById('emi-details').innerHTML = emiDetails;

        let ctx = document.getElementById('emiChart').getContext('2d');
        
        // Check if the chart already exists and destroy it
        if (emiChart) {
            emiChart.destroy();
        }

        // Create a new chart
        emiChart = new Chart(ctx, {
            type: 'pie',
            data: {
                labels: ['Principal Loan Amount', 'Total Interest'],
                datasets: [{
                    data: [loanAmount, totalInterest],
                    backgroundColor: ['#007BFF', '#FF5733'],
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {   
                        position: 'top',
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                let label = context.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                if (context.parsed !== null) {
                                    label += `₹${formatRupee(context.parsed)}`;
                                }
                                return label;
                            }
                        }
                    }
                }
            }
        });
    } else {
        alert('Please fill in all fields.');
    }
}
calculateEMI();
function setDefaultValue(id, value) {
    document.getElementById(id).value = value;
    calculateEMI();
}

function formatRupee(amount) {
    return new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        minimumFractionDigits: 2
    }).format(amount).replace('₹', '');
}

// Add event listener for Enter key press
document.addEventListener('keypress', function(event) {
    if (event.key === 'Enter') {
        calculateEMI();
    }
});

</script>
