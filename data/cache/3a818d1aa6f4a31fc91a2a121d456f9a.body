}
button.btn.btn-primary.whatbtnd {
  
    margin-top: 8px;
    background: #37b824;
    border: none;
    min-width: calc(100% - 68px);
    font-size: 14px;
    letter-spacing: .01em;
    border-radius: 3px;
    transition: min-width 1s;
    color: #fff;
    min-width: calc(100% - 68p);
