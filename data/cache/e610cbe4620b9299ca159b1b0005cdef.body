OVE","STOVEIND","STROLLERS","STVTOP","SUPCHDCARE","TABLET","TBLGARDS","TELEVISION","TEMCHAP","TENNIS","THSCR","TLPHN","TOILGRAB","TOILPAPER","TOILTRIES","TORCH","TOWELSHEET","TRASST","TRRC","TSCP","TST","TV","TWLS","UMBRELLA","UTNCL","VEHICLERENT","VEHRNTAL","VERANDAH","VGPLAYER","VLTCLNG","VNDMCH","VOLLEY","WAKEUPSRV","WALKIN","WASHMACH","WEIGSCALE","WELCGIFT","WESTTOIL","WHLCH","WOODFLR","WORKDESK","WTRBAG","WTRPRKACS","YOGA","YUKATA","ZIPLIN","CHLDPLYA","KDML","KIDSSAFETY"],"default_icon_url":"https://r2imghtlak.mmtcdn.com/r2-mmt-htl-image/strikeout-amenity-icons/DF.png"}},"quickCommerceData":{"items":[{"name":"BLINKIT","iconUrl":"https://go-assets.ibcdn.com/u/MMT/images/1770097343452-blinkit.png"},{"name":"PIPE","iconUrl":"https://go-assets.ibcdn.com/u/MMT/images/1777447565004-divider_dark.png"},{"name":"INSTAMART","iconUrl":"https://go-assets.ibcdn.com/u/MMT/images/1768803279831-instamart.jpeg"}]},"clmBenefitSuccess":false,"isWishListed":false},"roomInfoMapV2":{"2834":{"name":"Platinum Room"},"4136":{"name":"Gold Room"}},"ugcSummary":{"source":"MMT","availableOTAs":["MMT","BKG","MMT_RATING","EXT","MANUAL"],"cumulativeRating":3.7,"reviewCount":320.0,"ratingCount":786.0,"ratingBreakup":{"1":85.0,"2":52.0,"3":119.0,"4":256.0,"5":274.0},"reviewBreakup":{"1":40.0,"2":23.0,"3":42.0,"4":99.0,"5":116.0},"best":[{"publishDate":"2026-09-07 20:46:29","logo":"","travellerName":"Ayush Jhavery","title":"Average Stay","rating":3.0,"reviewText":"Had a pleasant stay at Hotel Ariana Residency. The staff was polite, courteous, and very helpful throughout our stay. The rooms were a little smaller than they appeared in the pictures, but they were clean, well-maintained, and comfortable.\n\nOverall, the service and cleanliness were good, and the staff made the stay enjoyable. A decent option for a comfortable stay.","id":"01M1Y72DJ0QZEC35TPYWSR0SNP","travelType":"SOLO","crawledData":false,"isUpvoted":false},{"publishDate":"2026-08-30 19:35:33","logo":"","travellerName":"Khushi Dahiya Khushi Dahiya","title":"Good Stay","rating":4.0,"reviewText":"The property I stayed in Mumbai- hotel Ariana residency. I had a delighted stay and experience. The staff could have been more courteous and welcoming. The food and amenities were really well maintained and great.","id":"01M19FTSAC9KT52NPYWSZ3S85Z","travelType":"ALL","crawledData":false,"isUpvoted":false},{"publishDate":"2026-08-28 18:30:57","logo":"","travellerName":"Shashank Uttam Kashyap","title":"Terrible Stay","rating":1.0,"reviewText":"Pathetic stay it was, charged me extra for early check in i.e. ₹1000 and when I asked them for the receipt, they denied and did not provide me. ","id":"01M147B2C1KF776SZ2WHBP9C4T","travelType":"SOLO","crawledData":false,"isUpvoted":false},{"publishDate":"2026-08-27 00:31:13","logo":"","travellerName":"Azad Ansari","title":"Good Stay","rating":4.0,"reviewText":"I had a pleasant stay at the hotel. The room was clean, comfortable, and well-maintained. The staff were friendly and helpful, and the service was prompt. The food was also good, and the overall atmosphere was relaxing.","id":"01M0ZQ4ZG55W9TMC3075A5HPQD","travelType":"BUSINESS","crawledData":false,"isUpvoted":false},{"publishDate":"2026-08-25 13:15:26","logo":"","travellerName":"Parveen Kumar","title":"Terrible Stay","rating":1.0,"reviewText":"hotel manager behaviour is too bad...take extra money nd no any service in hotel...totally bad experince in this hotel...plz dont go","id":"01M0VY2XZZ4JRM80H1KT01G5J9","travelType":"BUSINESS","crawledData":false,"isUpvoted":false},{"publishDate":"2026-08-16 10:15:54","logo":"","travellerName":"Shubham Singh","title":"Rooms were good","rating":5.0,"reviewText":"Overall it was good, rooms were cleaned and hotel was cleaned properly and the receptionist was properly dressed.","id":"01M04E7NTY3FQQJ3G1BGR35D62","travelType":"COUPLE","crawledData":false,"isUpvoted":false},{"publishDate":"2026-08-13 12:53:43","logo":"","travellerName":"Devika Rani","title":"Excellent Stay","rating":5.0,"reviewText":"it was good experience also food was good","id":"01KZX02N8SHVFZ0ZFCWPS56J5Q","travelType":"SOLO","crawledData":false,"isUpvoted":false},{"publishDate":"2026-08-12 21:58:10","logo":"","travellerName":"Jagmeet Singh Bahri","title":"Average Stay","rating":3.0,"reviewText":"I booked this hotel based on the pictures shown for the Platinum Room. Unfortunately, the actual experience was quite different from what was represented .\n\nThe room shown in the booking appeared to be large and luxurious, with a spacious bathroom. In reality, the room was quite average in size and the bathroom was extremely small. More importantly, visitors are not allowed in the rooms, which is a serious concern, particularly for business travellers who may need to meet guests or clients at the hotel.\n\nThe breakfast was also quite average, especially the vegetarian options. Additionally, several basic requests are charged separately. We were also informed only at the time of check-in that drinking in the rooms is not permitted. Such restrictions should be clearly highlighted at the time of booking so that guests can make an informed decision.\n\nThere is also no proper parking facility, which is another inconvenience.\n\nThe location is good, but overall, considering the room, facilities, restrictions and service, I found the hotel to be quite average and not as advertised.","id":"01KZVCS8D2QXQB96GQ1C8MF0NA","travelType":"BUSINESS","crawledData":false,"isUpvoted":false},{"publishDate":"2026-08-08 10:18:22","logo":"","travellerName":"Jitendra Patel","title":"Thank you team for good accommodations and special thank you to Mr Vinayak","rating":5.0,"reviewText":"Best stay and special thanks to Mr Vinayak from reception area for good accommodation he was very helpful","id":"01KZFV6EBB7GRH13SP1T7A3845","travelType":"GROUP","crawledData":false,"isUpvoted":false},{"publishDate":"2026-08-03 22:33:27","logo":"","travellerName":"Sarbeswar Basumatary","title":"Experience  in Hotel Ariana Residency, Mumbai","rating":4.0,"reviewText":"Location is very good.\nFood average.\nServices very good.\n\nDifficulties: Had to climb staircase to reach Lift.","id":"01KZ498KNYQ935FRAK9ZX0YDQ2","travelType":"COUPLE","crawledData":false,"isUpvoted":false}],"travelTypes":["EVERYONE","GROUP","COUPLE","SOLO","BUSINESS","FAMILY"],"showUpvote":true,"recentRatings":[3.0,4.0,5.0,1.0,4.0,4.0,5.0,1.0,4.0,5.0],"hotelRatingSummary":[{"concept":"Location","displayText":"Location","reviewCount":135.0,"value":3.9,"show":true,"heroTag":false},{"concept":"Cleanliness","displayText":"Cleanliness","reviewCount":98.0,"value":4.2,"show":true,"heroTag":false},{"concept":"Food","displayText":"Food","reviewCount":66.0,"value":3.4,"show":true,"heroTag":false},{"concept":"Value For Money","displayText":"Value For Money","reviewCount":122.0,"value":3.7,"show":true,"heroTag":false},{"concept":"Facilities","displayText":"Facilities","reviewCount":71.0,"value":3.5,"show":true,"heroTag":false},{"concept":"Child Friendliness","displayText":"Child Friendliness","reviewCount":34.0,"value":4.1,"show":true,"heroTag":false}],"subConcepts":[{"sentiment":"POSITIVE","subConcept":"Clean rooms","relatedReviewCount":110.0,"priorityScore":10110.0,"tagType":"BASE","displayText":"Clean rooms","source":"CGPT"},{"sentiment":"POSITIVE","subConcept":"Good location","relatedReviewCount":108.0,"priorityScore":10108.0,"tagType":"BASE","displayText":"Good location","source":"CGPT"},{"sentiment":"POSITIVE","subConcept":"Pleasant staff","relatedReviewCount":83.0,"priorityScore":10083.0,"tagType":"BASE","displayText":"Pleasant staff","source":"CGPT"},{"sentiment":"POSITIVE","subConcept":"Comfortable stay","relatedReviewCount":57.0,"priorityScore":10057.0,"tagType":"BASE","displayText":"Comfortable stay","source":"CGPT"},{"sentiment":"POSITIVE","subConcept":"Room Quality","relatedReviewCount":50.0,"priorityScore":10050.0,"tagType":"BASE","displayText":"Room Quality","source":"CGPT"},{"sentiment":"POSITIVE","subConcep