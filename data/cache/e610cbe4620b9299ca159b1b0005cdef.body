._AmenitiesListing{ display: flex; flex-wrap: wrap;}
._AmenitiesListing li{ width: 20%;flex-shrink: 0;margin-bottom: 20px;display: flex;align-items: center;}
._AmenitiesListing li a{ width: 80%;text-overflow: ellipsis;white-space: nowrap;overflow: hidden;}
.priceInfoSeo .lineThrough{float: left; padding-right: 10px;margin-top: 3px;}
