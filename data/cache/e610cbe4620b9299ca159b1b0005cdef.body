            <script>window.__INITIAL_STATE__ = {"user":{"userDetails":"","rooms":[{"adultCount":1.0,"childCount":0.0,"totalGuest":1.0,"active":false,"childAges":[],"expanded":true}],"roomStayQualifier":"1e0e","forceLogin":false,"searchClicked":false,"hotelSuggestions":{"data":{"suggestions":[]},"error":false,"loading":false},"defaultSuggestions":{"data":{"suggestions":[]},"error":false,"loading":false}},"hotelDetail":{"staticDetail":{"hotelDetails":{"supressHouseRules":false,"address":{"line1":"DHAKA COLONY, J P ROAD, OPP APNA BAZAR,\r\nANDHERI WEST, Mumbai Suburban, Maharashtra, 400053","line2":"Andheri West"},"checkinTime":"12 PM","checkoutTime":"11 AM","id":"201206031408087893","bedroomCount":0.0,"ingoId":"1000009250","name":"Hotel Ariana Residency, Mumbai","maskedPropertyName":false,"showCallToBook":false,"propertyLayoutTitleText":"Each Hotel unit contains the following:","isABO":false,"locationDetail":{"id":"CTBOM","name":"Mumbai","type":"city","countryId":"IN","countryName":"India"},"starRating":3.0,"starRatingType":"STAR","halalFoodAvailable":false,"highSellingAltAcco":false,"categories":["Mid_Low_DH_DTB","MyBiz Assured","budget_hotels","Inmarket","Flyer Deal"],"pinCode":"400053","propertyType":"Hotel","propertyLabel":"Hotel","hotelIcon":"https://r1imghtlak.mmtcdn.com/5e37e68e37d811edb6320a58a9feac02.jpg","primaryArea":"Andheri West","shortDesc":"Standing on J.P Road, Andheri, Hotel Ariana Residency is barely a 2 minute drive from Chhatrapati Shivaji International Airport. ","longDesc":"Standing on J.P Road, Andheri, Hotel Ariana Residency is barely a 2 minute drive from Chhatrapati Shivaji International Airport. The hotel enjoys proximity to several commercial and entertainment hubs of the city, making it ideal for both business and leisure travellers. Those who want to visit the various attractions of the city can seek travel assistance from the hotel. Other facilities provided here included internet access, laundry and round-the-clock front desk. Guests can savour mouth-watering local and international delicacies at the on-site restaurant. Besides, they can also choose to dine in the privacy of their rooms by availing room service or explore the nearby restaurants for a memorable dining experience. Hotel Ariana Residency offers 33 spacious and well-furnished rooms, provided with comfortable bedding, sofa set, coffee table, work desk and spacious closet. For the convenience of guests, the rooms also have LCD TV with cable channels and direct dial telephone. En suite baths feature modern fittings and are provided with premium toiletries. Soak in the sun at the popular Juhu Beach, which lies within a 20-minute drive of Hotel Ariana Residency.","entireProperty":false,"secrecyOption":false,"houseRules":{"commonRules":[{"category":"Guest Profile","id":"GuestProfile","showInHost":false,"rules":[{"text":"Unmarried couples are not allowed","sentiment":0.0,"templateText":"","display":false},{"text":"Primary guest should be atleast 18 years of age","sentiment":0.0,"templateText":"","display":false},{"text":"Groups with only male guests are not allowed at this property","sentiment":0.0,"templateText":"","display":false}],"showInDetailHome":true,"expandRules":false,"categoryId":1.0,"showInL2Page":true,"showArrowInDetailHome":true},{"category":"ID Proof Related","id":"IDProofRelated","showInHost":false,"rules":[{"text":"Passport, Aadhaar, Driving License and Govt. ID are accepted as ID proof(s)","sentiment":0.0,"templateText":"","display":false},{"text":"Local ids not allowed","sentiment":0.0,"templateText":"","display":false}],"showInDetailHome":false,"expandRules":false,"categoryId":13.0,"showInL2Page":true,"showArrowInDetailHome":true},{"category":"Smoking/Alcohol consumption Rules","id":"SmokingAlcoholconsumptionRules","showInHost":false,"rules":[{"text":"Alcohol consumption is not allowed within the property premises.","sentiment":0.0,"templateText":"","display":false},{"text":"Smoking within the premises is not allowed","sen