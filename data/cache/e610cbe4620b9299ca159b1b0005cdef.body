plateText":"","display":false},{"text":"Guests are requested not to invite outside visitors in the room during their stay.","sentiment":0.0,"templateText":"","display":false},{"text":"Government valid ID proof required(Pan Card not  allowed).\r\nUnmarried couples are not allowed .\r\nForeigners are allowed .","sentiment":0.0,"templateText":"","display":false}],"showInDetailHome":false,"expandRules":false,"categoryId":10.0,"showInL2Page":true,"showArrowInDetailHome":true},{"category":"Infant Policy","id":"InfantPolicy","showInHost":false,"rules":[{"text":"1 infant (0-2 yrs) per room included without counting in total room capacity","sentiment":0.0,"templateText":"","display":false}],"showInDetailHome":false,"expandRules":false,"categoryId":28.0,"showInL2Page":true,"showArrowInDetailHome":true},{"category":"Child \u0026 Extra Bed Policy","id":"extrabedpolicy","showInHost":false,"rules":[{"text":"An extra bed will be provided to accommodate any child included in the booking for a charge mentioned below."},{"text":"INR 1000 will be charged for an extra mattress per child. (To be paid at the property)"},{"text":"An extra bed will be provided to accommodate any additional guest included in the booking for a charge mentioned below."},{"text":"INR 1500 will be charged for an extra mattress per guest. (To be paid at the property)"}],"showInDetailHome":false,"expandRules":false,"showInL2Page":true,"showArrowInDetailHome":true}],"highlightMustReadRules":{"highlightedIcon":"https://go-assets.ibcdn.com/u/MMT/images/1752828299662-couple.png","highlightedTitle":"Couple/Bachelor Rules","highlightedTitleColor":"#007E7D","ruleText":"Unmarried couples are not allowed. Local ids not allowed","background":"#E6FFF9"},"isMealDetailsPresent":false},"foodDiningV2":{"title":"Food and Dining","allRules":[{"category":"Restaurants at the property","id":"restaurantAtTheProperty1","heading":"Restaurant ","description":"","rules":[{"titleText":"Meals Offered","text":"Breakfast,Lunch and Dinner","i