.font14 {font-size: 14px;}
.lineHeight17 {line-height: 17px;}
.appendTop15 {margin-top: 15px;}
.mainContainer {max-width: 1200px;margin: 0 auto;margin-bottom: 20px;}
.faqShowMore {display: inline-flex;background-color: #fff;border: 1px #008CFF solid;padding: 12px 20px;border-radius: 8px;cursor: pointer;outline: 0;font-size: 16px;font-weight: 900;text-transform: uppercase;color: #008CFF;margin-top: 16px;}
.howToShowMore {display: inline-flex;background-color: #fff;border: 1px #008CFF solid;padding: 12px 20px;border-radius: 8px;cursor: pointer;outline: 0;font-size: 16px;font-weight: 900;text-transform: uppercase;color: #008CFF;margin-top: 16px;}
.seasonalShowMore {display: inline-flex;background-color: #fff;border: 1px #008CFF solid;padding: 12px 20px;border-radius: 8px;cursor: pointer;outline: 0;font-size: 16px;font-weight: 900;text-transform: uppercase;color: #008CFF;margin-top: 16px;}
.ol-faqs { margin-left : 20px }
table .ol-faqs { margin-left : 0 }
.acceptedAnswer{ display: flex; align-items: baseline; }
.marginLeft{ margin-left: 5px; }
.headingReview {font-size: 18px;line-height: 22px;font-weight: 900;color: #000;}
.appendBottom16 {margin-bottom: 16px;}

/* Review Section */
.rvsListItem:not(:last-child){border-bottom: 1px #d8d8d8 solid;padding-bottom: 16px;margin-bottom: 16px;}
.rvsListItem__hdr{display: flex;justify-content: space-between;}
.rvsListItem__hdrLft{flex: 1;}
.rvsListItem__title{font-size: 16px;line-height: 19px;color: #4a4a4a;font-weight: 900;}
.rvsListItem__subtitle{font-size: 14px;line-height: 19px;color: #757575;}
.rvsListItem__count{width: 48px;height: 40px;display: inline-flex;align-items: center;justify-content: center;background-color: #fff;border: 1px #0C58B4 solid;border-radius: 4px;font-size: 18px;line-height: 18px;color: #0C58B4;font-weight: 900; margin-left: 20px; flex-shrink: 0;}
.rvsListItem__body{display: grid;grid-template-columns: 1fr;gap: 10px;margin-top: 10px;}
.rvsListItem__body {font-size: 14px;line-height: 17px;color: #4A4A4A;}

/* Block Section */
.blockLinksViewMore {font-size: 14px;line-height: 17px;font-weight: 900;color: #008CFF;cursor: pointer;display: inline-block;margin-top: 16px;}
.popular {background-color: #fff;padding: 20px 16px;border-radius: 16px;}
.popularList {display: grid;grid-template-columns: repeat(4, 1fr);gap: 20px;}
.popularList li {display: grid;grid-template-columns: 1fr;gap: 8px;}
.popularList li:nth-child(n+9) {display: none;}
.popularList.showAll li:nth-child(n+9) {display: block;}
.popularList li a {font-size: 14px; line-height: 17px;font-weight: 400;color: #008CFF;}

