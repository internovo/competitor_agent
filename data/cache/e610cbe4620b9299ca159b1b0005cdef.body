.customLineHeight20{line-height: 20px !important;}
.pageContainer { width: 1200px; margin: 0 auto; padding-top: 30px; }
.cityContainer { background-color: #fff; border: 1px #BABBBA solid; border-radius: 4px; padding: 30px; box-shadow: 0 0 6px rgba(0, 0, 0, 0.1); }
.cityContainer h3 { font-size: 20px; line-height: 24px; color: #4a4a4a; font-weight: 900; margin-bottom: 25px; }
.cityTable tr:nth-child(odd) { background-color: #F5F5F5; }
.cityTable tr td { padding: 14px 22px; }
.cityTable tr td:first-child { font-size: 16px; line-height: 20px; font-weight: 700; color: #000000; width: 275px; border-right: 1px #D8D8D8 solid; }
.cityTable tr td:last-child { font-size: 16px; line-height: 20px; color: #000000; }
.cyanColor{ color:#008cff;}
.whiteColor { color: #ffffff; }

.readmore {height:48px;display: inline-block;padding: 5px 0;}

/* display none after 4th item */
.maxItem3 .section__card li:nth-child(n+4){
    display: none;
}
.viewMoreCta{
    display: none;
}
.maxItem3 .viewMoreCta{
    display: block;
}
.viewLessCta{
    display: block;
}
.maxItem3 .viewLessCta{
    display: none;
}
.minBlock, .blockViewMore { display: none; }
.showMinBlock .minBlock, .showMinBlock .blockViewMore { display: block; }
.maxBlock, .blockViewLess { display: block; }
.showMinBlock .maxBlock, .showMinBlock .blockViewLess { display: none; }
.paddingTopBottom10 {padding: 10px 0;}
.pageContainerMweb{ padding: 10px; }
.gccContentMweb{ background: #FFFFFF; box-shadow: 0px 1px 4px rgba(0, 0, 0, 0.25); border-radius: 4px; padding: 20px 12px; }
.gccContentMweb .h3Mob{ font-size: 16px; line-height: 19px; color: #000000; font-weight: 700; margin-bottom: 8px; }
.gccTableMweb{ border-collapse: collapse; }
.gccTableMweb .tdMob{ padding: 8px 8px; /* border-bottom: 1px #d8d8d8 solid; */ }
.gccTableMweb .tdMob .h5Mob{ font-size: 14px; line-height: 17px; font-weight: 700; color: #000; }
.gccTableMweb .tdMob .pMob{ font-size: 14px; line-height: 17px; color: #4A4A4A; margin-top: 4px; }
.gccTableMweb .tbodyMob .trMob:last-child .tdMob{ border-bottom: 0; /* padding-bottom: 0; */ }
.gccTableMweb .trMob:nth-child(odd){ background:#F5F5F5 }
.gccTableMweb .tdMob:nth-child(even){ border-left:1px solid #D8D8D8 ; }
.gccTableMweb .tdMob:first-child{ width: 200px; }

a.hoverColor:hover{color: #008cff;}
a.blockTitleColor{color:#4a4a4a;}

.aboutAreaContentMainWrapperInner{
    box-shadow: 0 4px 8px 0 rgba(138, 107, 118, 0.08);
    border-radius: 4px;
    padding: 20px;
    border: solid 1px #bababa;
    margin-bottom: 20px;
}

.aboutAreaContentMainWrapper{
    margin: 0 auto;
    width: 1200px;
}

.aboutAreaContent{
    line-height: 1.4;
    height: 38px;
    display: -webkit-box;;
}

.truncateText{
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.blankBox {background-color: #fff;padding: 20px 16px;border-radius: 16px;border: 1px #d8d8d8 solid;}
.appendTop20 {margin-top: 20px;}
.heading {font-size: 18px;line-height: 22px;font-weight: 900;color: #000;}
.qna__listItem {padding: 16px 0;}
.qna__listItem:not(:last-child){border-bottom: 1px #d8d8d8 solid;}
.howTo__listItem {padding: 16px 0;}
