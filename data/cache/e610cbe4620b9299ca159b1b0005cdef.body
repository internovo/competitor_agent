.sRating {
    position: relative;
    display: inline-flex;
    flex-direction: row;
    flex-shrink: 0;
}
.mmtRating{
    display: inline-flex;
    align-items: center;
}
.mmtRating__text{
    font-size: 16px;
    line-height: 19px;
    color: #0C58B4;
    font-weight: 900;
    margin-right: 9px;
}
.mmtRating__tag{
    width: 32px;
    height: 20px;
    background-color: #0C58B4;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    line-height: 17px;
    font-weight: 900;
    color: #fff;
}
.sRating__row {
    font-size: 0;
    display: flex;
    flex-wrap: nowrap;
    overflow: hidden;
}
.sRating__row > img {
    vertical-align: top;
    margin-right: 1px;
}

.hotel-detail-wrapper{
    border-radius: 16px;
}

.nearBy.home-grid.products-grid{
margin: 10px;
}

.paddingLR16{
    padding-left: 8px;
    padding-right: 16px;
}

.prependTop10{
    margin-top: 10px;
}

._Hlisting .hotelSlide {
    border-radius: 16px;
    background-color: #fff;
    padding: 20px 16px;
    border-radius: 16px;
    border: 1px #d8d8d8 solid;
    position: relative;
}

.buttonDT {
    background-color: #fff;
    border-radius: 20px;
    box-shadow: 0 1px 6px 0 rgba(0, 0, 0, .2);
    height: 30px;
    position: absolute;
    right: 20px;
    top: 20px;
    width: 68px;
}

._Hlisting .pvSlideOuter {
    margin-top: 10px;
    position: relative;
}





.seasonal__gi-table {
    display: flex;
    flex-direction: column;
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    overflow: hidden;
    margin-top: 16px;
}

.seasonal__gi-header {
    display: flex;
    background-color: #f2f2f2;
    font-weight: 700;
}

.seasonal__gi-header-cell {
    flex: 1;
    padding: 12px 16px;
    border-right: 1px solid #d8d8d8;
    font-size: 14px;
    font-weight: 700;
    color: #000;
}

.seasonal__gi-header-cell:last-child {
    border-right: none;
}

.seasonal__gi-row {
    display: flex;
    border-bottom: 1px solid #e6e6e6;
}

.seasonal__gi-row:last-child {
    border-bottom: none;
}

.seasonal__gi-cell {
    flex: 1;
    padding: 12px 16px;
    border-right: 1px solid #e6e6e6;
    font-size: 14px;
    line-height: 17px;
    color: #4a4a4a;
}

.seasonal__gi-cell:last-child {
    border-right: none;
}



.seasonal__gi-content {
    padding: 8px 0;
}

.seasonal__gi-content .seasonal__gi-row {
    margin-bottom: 8px;
    font-size: 14px;
    line-height: 17px;
}

.seasonal__gi-content .seasonal__gi-row:last-child {
    margin-bottom: 0;
}

.seasonal__gi-row strong {
    color: #000;
    margin-right: 8px;
}

.seasonal__gi-hotels {
    position: relative;
}



/* Seasonal Data Block Styles - MMT Desktop */
.seasonal__data {
    border-radius: 4px;
    background-color: #fff;
}

.seasonal__table {
    border: 1px solid #d8d8d8;
    border-radius: 4px;
    margin-top: 16px;
    overflow: hidden;
}

.seasonal__table-content {
    display: flex;
    flex-direction: column;
    overflow-x: auto;
    overflow-y: hidden;
    min-width: 100%;
    background-color: #fff;
    position: relative;
}

.seasonal__table-content .seasonal__header,
.seasonal__table-content .seasonal__row {
    min-width: 800px; /* Ensure minimum width for proper scrolling */
}

.seasonal__header {
    display: flex;
    background-color: #f2f2f2;
    font-weight: 700;
    border-bottom: 1px solid #d8d8d8;
}

.seasonal__header-cell {
    flex: 1;
    padding: 16px;
    border-right: 1px solid #d8d8d8;
    font-size: 16px;
    font-weight: 700;
    color: #000;
    text-align: center;
    min-width: 120px;
}

.seasonal__header-cell:last-child {
    border-right: none;
}

.seasonal__header-cell--month {
    flex: 0 0 120px;
    position: sticky;
    left: 0;
    background-color: #f2f2f2;
    z-index: 3;
}

.seasonal__header-cell--temp {
    flex: 0 0 120px;
}

.seasonal__header-cell--season {
    flex: 1.5;
}

.seasonal__header-cell--activities {
    flex: 2;
}

.seasonal__header-cell--hotels {
    flex: 2;
}

.seasonal__row {
    display: flex;
    border-bottom: 1px solid #e6e6e6;
    align-items: stretch;
}

.seasonal__row:last-child {
    border-bottom: none;
}

.seasonal__row--hidden {
    display: none !important;
}

.seasonal__cell {
    flex: 1;
    padding: 16px;
    border-right: 1px solid #e6e6e6;
    font-size: 14px;
    line-height: 17px;
    color: #4a4a4a;
    vertical-align: top;
    min-width: 120px;
}

.seasonal__cell:last-child {
    border-right: none;
}

.seasonal__cell--month {
    flex: 0 0 120px;
    font-weight: 700;
    color: #000;
    text-align: center;
    position: sticky;
    left: 0;
    background-color: #fff;
    z-index: 2;
}

.seasonal__cell--temp {
    flex: 0 0 120px;
    text-align: center;
    font-weight: 600;
    color: #0C58B4;
}

.seasonal__cell--season {
    flex: 1.5;
}

.seasonal__cell--activities {
    flex: 2;
}

.seasonal__cell--hotels {
    flex: 2;
    position: relative;
}

.seasonal__hotels-summary,
.seasonal__activities-summary {
    display: inline;
}

.seasonal__hotels-full,
.seasonal__activities-full {
    display: none;
}

.seasonal__hotels-content,
.seasonal__activities-content {
    color: #4a4a4a;
}


/* Mobile responsive overrides for seasonal table */
@media (max-width: 768px) {
    .seasonal__table-content .seasonal__header,
    .seasonal__table-content .seasonal__row {
        min-width: 600px; /* Smaller minimum width for mobile */
    }
    
    .seasonal__header-cell {
        padding: 12px 8px;
        font-size: 12px;
        min-width: 80px;
    }
    
    .seasonal__header-cell--month {
        flex: 0 0 80px;
    }
    
    .seasonal__header-cell--temp {
        flex: 0 0 80px;
    }
    
    .seasonal__header-cell--season {
        flex: 1.2;
    }
    
    .seasonal__header-cell--activities {
        flex: 1.5;
    }
    
    .seasonal__header-cell--hotels {
        flex: 1.5;
    }
    
    .seasonal__cell {
        padding: 12px 8px;
        font-size: 12px;
        line-height: 14px;
        min-width: 80px;
    }
    
    .seasonal__cell--month {
        flex: 0 0 80px;
    }
    
    .seasonal__cell--temp {
        flex: 0 0 80px;
    }
    
    .seasonal__cell--season {
        flex: 1.2;
    }
    
    .seasonal__cell--activities {
        flex: 1.5;
    }
    
    .seasonal__cell--hotels {
        flex: 1.5;
    }
    
}
