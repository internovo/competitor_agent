            </div>
          <div class="store-details-info-inner" id="store-details-info-inner">
            <h1 class="store-title"
            
              style="color: #000000;"
            
            >${storeListData[0].name}</h1>
            <div class="store-details-address"
            
              style="color: #000000;"
            
            >  
              <div>${storeListData[0].address1}, ${storeListData[0].address2}, ${storeListData[0].city}, ${storeListData[0].province}, ${storeListData[0].zip}</div>
              </div>
               ${hasValidReviews ?
               `<div class="google-logo">
                <div class="google-logo-new">
                  <img class="google-logo-img" src="https://cdn.shopify.com/extensions/019fd0b5-1011-7034-a269-cb491143f5dc/omni-storelocator-app-2-308/assets/google-color-icon.svg" alt="Your image description">
