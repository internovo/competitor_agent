            // Find the parent container
      const storeLocatorInfo = document.querySelector('.storelocator-details-info');
      if (storeLocatorInfo.firstChild) {
          storeLocatorInfo.innerHTML = ''; // Clear previous content
      }
      var newChild = document.createElement('div');
      newChild.innerHTML = headingDetails;
      const existingDetails = document.querySelector('.storedetails');
      if (existingDetails) {
          existingDetails.remove();
