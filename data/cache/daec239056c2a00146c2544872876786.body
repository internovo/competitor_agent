        </div>
        ${countrySection}
        
        `;

        var footerChild = document.createElement('div');
        footerChild.innerHTML = footerData;
        document.querySelector('#footer').appendChild(footerChild);
      }
    }
    

    const getLatLngBounds = async (countries) => {
      const geocoder = new google.maps.Geocoder();
      const bounds = new google.maps.LatLngBounds();
      for (const store of countries) {
        const { country, city } = store;
        const address = `${city}, ${country}`;
        try {
          const result = await new Promise((resolve, reject) => {
            geocoder.geocode({ address }, (results, status) => {
              if (status === google.maps.GeocoderStatus.OK) {
                resolve(results[0].geometry.location);
              } else {
                reject(`Geocode was not successful for ${address}: ${status}`);
              }
            });
          });

          bounds.extend(result); // Extend the bounds to include the location of this country/city
        } catch (error) {
          console.error(error);
        }
      }

      return bounds;
    };

    function geocodeCountry(countryName) {
      const geocoder = new google.maps.Geocoder();
      return new Promise((resolve, reject) => {
        geocoder.geocode({ address: countryName }, (results, status) => {
          if (status === google.maps.GeocoderStatus.OK && results.length > 0) {
            const { lat, lng } = results[0].geometry.location;
            resolve({ lat: lat(), lng: lng() });
          } else {
            reject(new Error(`Geocode failed: ${status}`));
          }
        });
      });
    }
    function waitForGoogleMaps(callback) {
      if (typeof google !== "undefined" && google.maps) {
        callback();
      } else {
        setTimeout(() => waitForGoogleMaps(callback), 100);
      }
    }
    async function initSingleMap(setMarker, uniqueCountries) {
      const { Map } = await google.maps.importLibrary('maps');
      const { marker } = google.maps.importLibrary('marker');
      var settingData = `{"id":"3813ef17-c8bb-4998-a54f-a105134762c7","url_prefix":"storelocator","brand_name":"The Pant Project","meta_title":"The Pant Project Store | Store Locator","google_map_api_key":"AIzaSyBBDv-BIG_zI1zbHN2JehdpfULmRWYatv4","map_theme_customization":"light","map_alignment":"right","store_location_visibility":"disable","meta_description":"The Pant Project Stores","footer_content":"The Pant Project retail stores are open in India, currently Mumbai, Bangalore, Pune, Hyderabad, Ahmedabad & Chandigarh. Stores are open Monday to Sunday, 10:30 AM to 10:00 PM. Shop custom made bottomwear and ready to wear pants in 300+ options.","business_hours":"10:30 AM to 10:00 PM","createdAt":"2025-10-06T10:31:20.976Z","updatedAt":"2025-10-06T10:31:20.976Z"}`;
      const countryCoordinates  = await geocodeCountry(uniqueCountries);
      settingData = JSON.parse(settingData);
      let mapOptions;
      mapOptions = {
        zoom: 10,
        center: countryCoordinates, 
        styles: settingData != null && settingData.map_theme_customization == 'dark' ? mapStyles2 : '',
        streetViewControl: false, // Disable street view
        mapTypeControl: false, // Disable map type control
        fullscreenControl: false, // Disable fullscreen control
      };

      const map = new Map(document.getElementById('store-details-map-views'), mapOptions);

      const markers = setMarker.map((markerData) => {
        var myLatlng = new google.maps.LatLng(markerData.position.lat, markerData.position.long);
        var marker = new google.maps.Marker({
          position: myLatlng,
          map: map,
          title: markerData.title, // Add title to show on hover
        });

        map.setCenter(myLatlng);
        var infowindow = new google.maps.InfoWindow({
          content: markerData.infowindow,
          ariaLabel: markerData.title,
        });

        marker.addListener('click', () => {
          infowindow.open({
            anchor: marker,
            map,
          });
        });
      });

    }

    function setHtml (storeListData) {
