  <div class="product-template-widget--shared"></div>

  <script type="module">
    /* Image for the fly-to-cart flight, same as the ready-made sections do via
       their button's data-image. Card clicks set it below; on a custom-made PDP
       there is no card, so fall back to that page's own widget root. */
    let cmFlyImage = null;
    const cmResolveFlyImage = () =>
      cmFlyImage || document.querySelector('.product-template-widget')?.dataset.productImage || null;

    /* The widget calls addToCartHook synchronously right after it asks Preact to
       close the drawer, so the ADD TO CART button is still on screen here and
       <fly-to-cart> can read its rect (it does so synchronously on append). */
    const cmStartFlyToCart = function () {
      if (typeof window.animateFlyToCart !== 'function') return null;
      const image = cmResolveFlyImage();
      if (!image) return null;
      const source =
        document.querySelector('dialog[open] .add_to_cart-sticky .add-to-cart') ||
        document.querySelector('dialog[open] .add-to-cart') ||
        document.querySelector('.add_to_cart-sticky .add-to-cart');
      if (!source) return null;
      const flyElement = window.animateFlyToCart(source, image);
      if (!flyElement) return null;
      /* The drawer is a showModal() <dialog>, so it lives in the top layer and
         no z-index can paint the flight above it. Promote the element to a
         manual popover: also top layer, and added later, so it stacks above the
         drawer - without the focus trap a nested <dialog> would bring. Paired
         with the fly-to-cart[popover] geometry reset in custom.css. */
      if (typeof flyElement.showPopover === 'function') {
        flyElement.setAttribute('popover', 'manual');
        try {
          flyElement.showPopover();
        } catch (e) {
          /* already shown or not connected - the flight still runs, just behind
             the drawer, which is the pre-popover behaviour */
        }
      }
      return flyElement;
    };

    window.addToCartHook = function (properties) {
      let variantId = $('form[action="/cart/add"] [name="id"]').val();
      let quantity = $('form[action="/cart/add"] [name="quantity"]').val();
      const params = new URL(location.href).searchParams;

      if (properties['variantId']) {
        variantId = properties['variantId'];
        delete properties['variantId'];
      }
      const bundleKey = 'Bundle';
      if (properties.hasOwnProperty(bundleKey)) {
        const bundleValue = properties[bundleKey];
        delete properties[bundleKey];
        properties = { [bundleKey]: bundleValue, ...properties };
      }
      properties['_lineitem_type'] = 'custom-made';
      const data = {
        items: [{ quantity: quantity, id: variantId, properties: properties }],
      };

      /* Fly the product to the cart icon, then open the side cart once the item
         has both landed and actually been added - whichever finishes last, so
         the drawer never opens showing a stale cart. */
      const flyElement = cmStartFlyToCart();
      let hasLanded = flyElement === null;
      let hasAdded = false;
      let cartOpened = false;
      const openSideCartWhenReady = function () {
        if (cartOpened || !hasLanded || !hasAdded) return;
        cartOpened = true;
        const triggers = document.querySelectorAll('*[data-drawer-id="sidebar-cart"]');
        if (triggers[1]) triggers[1].click();
      };
      if (flyElement) {
        const land = function () {
          hasLanded = true;
          openSideCartWhenReady();
        };
        flyElement.addEventListener('fly-to-cart:landed', land, { once: true });
        /* <fly-to-cart> only emits `landed` when the flight runs to completion -
           a cancelled or errored animation emits nothing, so this keeps a failed
           flight from stranding the cart drawer shut. */
        setTimeout(land, 1200);
      }

      $('.add-to-cart').addClass('btn--loading');
      $.ajax({
        type: 'POST',
        url: `${params.get('edit') ? '/cart/change.js' : '/cart/add.js'}`,
        data: params.get('edit') ? { id: variantId, quantity: 1, properties: properties } : data,
        beforeSend: function () {
          $('.loader').show();
        },
        dataType: 'json',
        success: function () {
          $('.add-to-cart').removeClass('btn--loading');
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          if (params.get('edit')) {
            params.delete('edit');
            history.replaceState(null, '', `${location.pathname}?${params.toString()}`);
          }
          hasAdded = true;
          openSideCartWhenReady();
        },
      });
    };

    document.addEventListener('click', function (event) {
      const btn = event.target.closest('.cm-customize-btn');
      if (!btn) return;
      const wrap = btn.closest('.pro-quickview-btn-wrap') || btn.closest('.cm-quick-add-l1');
      const bundleScript = wrap ? wrap.querySelector('.cm_bundles_json') : null;
      console.log('cm-customize-btn clicked', bundleScript);
      cmFlyImage = btn.dataset.cmProductImage || null;
      window.openCMWidget({
        template: btn.dataset.cmTemplate,
        customerId: btn.dataset.cmCustomer || undefined,
        productAvailable: btn.dataset.cmProductAvailable === 'true',
        productData: {
          id: btn.dataset.cmProductId,
          title: btn.dataset.cmProductTitle,
        },
        variantId: btn.dataset.cmVariantId || undefined,
        bundleData: bundleScript ? JSON.parse(bundleScript.textContent) : undefined,
        bundleToSell: bundleScript ? bundleScript.getAttribute('data-bundles_to_sell') : undefined,
        /* Cart-line attribution, following the _from convention the ready-made
           flows already use in assets/custom.js (quick_buy_2, buy_together, ...).
           Underscored properties stay hidden in cart/checkout but persist on the
           order. Per-placement override: data-cm-from on the button. */
        extraProperties: { _from: btn.dataset.cmFrom || 'cm_quick_add' },
      });
    });
  </script>



    <div class="PageContainer">
