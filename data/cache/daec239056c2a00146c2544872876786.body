        storeListData.push({"id":"99373471088","name":"The Pant Project Store - Kammanahalli, Bangalore","phone":"7304232891","whatsapp_number":"7304232891","address1":"4C-412, CMR Road, 2nd Block, 4th Cross Near Jal Vayu Vihar","address2":"HRBR Layout, Sena Vihar, Kammanahalli, Bengaluru","handle":"storelocator-the-pant-project-the-pant-project-store-kammanahalli-bangalore-bengaluru-karnataka-99373471088","city":"Bengaluru","province":"Karnataka","country_name":"India","active":true,"country":"India","country_code":"IN","province_code":"KR","zip":"560084","latitude":"13.0223592","longitude":"77.6379614","store_type":"exclusive store","status":true,"createdAt":"2026-09-08T10:26:45.350Z","updatedAt":"2026-09-08T10:26:45.350Z","additionInfo":[{"additional_info":"","hours":"","total_reviews":"18","average_review":"5","services":"","map_location_cid":"","store_hours":""}]});
      
    
  
  const pageTitle = `The Pant Project Store - Borivali, Mumbai Details`.trim();;
  let filteredStores = storeListData;  
  const url_storelocator = window.location.href.split("?")[0];  
  const idMatch = url_storelocator.match(/(\d+)$/); // grabs last digits
  const locationId = idMatch ? idMatch[1] : null;
  if (pageTitle.toLowerCase() == "storelocator") {
    let filteredStores = storeListData;
    storeListData = filteredStores;
  } else if (locationId) {
    // Filter by ID if found
    storeListData = storeListData.filter(store => String(store.id) === locationId);
  } else if (pageTitle.toLowerCase() !== "storelocator") {
    storeListData = storeListData.filter(store => {
      return (
        store.city?.toLowerCase() === pageTitle.toLowerCase() ||
        store.country?.toLowerCase() === pageTitle.toLowerCase() ||
        store.province?.toLowerCase() === pageTitle.toLowerCase()
      );
    });
  }
  storeListData = storeListData.filter(store => store.status === true || store.status === "true");

</script>
<script>
  var pageHandle = "storelocator-the-pant-project-the-pant-project-store-borivali-mumbai-mumbai-maharashtra-35591495891";
  var lastId = "35591495891";
  var rawValue = [{"name":"Chetan Kotavdekar","initial_letter":"C","review":"Had a great experience at Pant Project. The team was friendly and helpful, the collection was modern and well-designed, and the fit was excellent. The quality of the products stood out, and the overall shopping experience was smooth and enjoyable. Would de","rating":"5"},{"name":"Nandu Kithu","initial_letter":"N","review":"The store is amazing and the store manager was really helpful in finalizing my choices. They even offered delivery across Mumbai from the store. The material is so great and the fit and finish is perfect even though I am plus size person","rating":"5"},{"name":"prathamesh meher","initial_letter":"P","review":"Had a great experience with The Pant Project, Borivali. The quality, fit, and attention to detail were excellent. The staff was helpful and made the entire process smooth. Highly recommended for anyone looking for well-fitted custom trousers!","rating":"5"},{"name":"Pramod Dubey","initial_letter":"P","review":"Had heard a lot about Pant Project and finally walked into their store. Initially, I was a bit skeptical about the material and fitting, but the store team — especially Uday and Tauseef — patiently explained the product and helped me finalize my purchase.","rating":"5"},{"name":"Ani M","initial_letter":"A","review":"Unfortunately pants I order online have always been off with length or waist issues. I had seen ads about The Pant Project online and was curious to try it. Luckily found out there's a store nearby and came in to try the panta. Must say I was really impre","rating":"5"}];
