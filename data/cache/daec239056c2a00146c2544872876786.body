<div
  id="omni-storelocator-settings"
  data-settings='{"hours_services_background":"#000000","brand_text_colour":"#000000","brand_back_colour":"#ffffff","nearby_store_background":"#ffffff","storelocator_footer_background":"#ffffff","reviews_back_colour":"#f6f5ef","store_hours_service_text_color":"#ffffff","hours_tag_color":"#000000","store_heading_label":"Stores","margin_top_desk":36,"margin_bottom_desk":36,"margin_top_mobile":36,"margin_bottom_mobile":36,"enable_store_filter":false,"enable_whatsApp_button":true,"enable_main_storelocator_banner":false,"omni_storelocator_theme_color":"light"}'>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
  const appElement = document.getElementById('omni-storelocator-settings');
  if (!appElement) return;
    const settings = JSON.parse(appElement.getAttribute('data-settings'));   
    const {
      margin_top_desk: marginTopDesktop,
      margin_bottom_desk: marginBottomDesktop,
      margin_top_mobile: marginTopMobile,
      margin_bottom_mobile: marginBottomMobile,
      hours_services_background: brandColor,
      reviews_back_colour: reviewsBrandColor,
      store_hours_service_text_color: storeHoursServiceTextColor,
      store_heading_label: storeHeadingLabel,
    } = settings;
    const sectionHasClass = document.querySelector('.omni-storelocator-new');
    const heading = sectionHasClass.querySelector('.text-center');
   
 // Apply styles to review cards
  const applyReviewCardStyles = () => {
    const reviewSections = document.querySelectorAll('.review-rating-main-cover');
    if (reviewsBrandColor && reviewSections.length > 0) {
      reviewSections.forEach(section => {
        section.style.background = reviewsBrandColor;
      });
    }
  };
  // Watch for DOM changes and reapply styles when cards update
  const observer = new MutationObserver((mutationsList) => {
    for (const mutation of mutationsList) {
      if (mutation.type === 'childList') {
        // applyStyles();
        applyReviewCardStyles(); // reapply every time card is replaced
      }
    }
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true,
  });


  // Initial apply
  // applyStyles();
  applyReviewCardStyles();
    if (!heading) return;
    // Check screen width for responsive styling
    const isMobile = window.matchMedia('(max-width: 767px)').matches;
  
    if (isMobile) {
      if (marginTopMobile !== undefined) {
        heading.style.marginTop = `${marginTopMobile}px`;
      }
      if (marginBottomMobile !== undefined) {
        heading.style.marginBottom = `${marginBottomMobile}px`;
      }
    } else {
      if (marginTopDesktop !== undefined) {
        heading.style.marginTop = `${marginTopDesktop}px`;
      }
      if (marginBottomDesktop !== undefined) {
        heading.style.marginBottom = `${marginBottomDesktop}px`;
      }
    }
 
});
</script>


