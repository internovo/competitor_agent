                  Hours 
                </div>
                <div class="store-details-hours-days">
                ${['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
                  .map(day => {
                    const hour = storeListData[0].additionInfo[0].store_hours?.[day] || settingData.business_hours;
                    return `
                      <div class="store-details-hours-item">
                        <span>${day}</span>
                        <span>${hour}</span>
                      </div>
                    `;
                  }).join('')}
