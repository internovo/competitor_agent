           display: none !important;\n        }\n    }\n\n    cooee-item-detail {\n        .lc-card-container {\n            display: none !important;\n        }\n\n        --lc-card-radius: 0px;\n        height: auto !important;\n        border-radius: 0px !important;\n        bottom: 8px !important;\n        left: 6px !important;\n        width: auto !important;\n\n        .card-wrapper.single-pane {\n            scrollbar-width: none !important;\n        }\n\n        @media(max-width: 360px) {\n            margin-left: 1px !important;\n            width: 320px !important;\n            left: 18px !important;\n        }\n\n        cooee-item-options-picker {\n            margin-left: 80px !important;\n            overflow: visible !important;\n        }\n\n        .card-header {\n            display: none !important;\n        }\n\n        .lc-header {\n            display: none !important;\n        }\n\n        .item-name {\n            display: none !important;\n        }\n\n        .lc-prices {\n            display: none !important;\n        }\n\n        .selected-variant-title {\n            display: none !important;\n        }\n\n        .selected-product-title {\n            display: none !important;\n        }\n\n        .lc-description-title {\n            display: none !important;\n        }\n\n        .lc-description {\n            display: none !important;\n        }\n\n        .more-info-button {\n            display: none !important;\n        }\n\n        .view-cart-button {\n            display: none !important;\n        }\n\n        .image-strip {\n            display: block !important;\n            overflow: hidden !important;\n            width: 100% !important;\n            margin-top: -10px;\n        }\n\n        .image-strip img {\n            display: none !important;\n        }\n\n        .product-selector.active {\n            display: none !important;\n        }\n\n        .product-selector {\n            display: none !important;\n        }\n\n        .image-strip img:first-child {\n            display: block !important;\n            object-fit: cover !important;\n            height: 110px !important;\n            position: absolute !important;\n            top: 1px;\n            z-index: 2;\n        }\n\n        .cta-button {\n            padding: 10px !important;\n            border-radius: 0px !important;\n            width: 80% !important;\n            margin-left: 92px !important;\n            margin-top: -19px !important;\n            font-size: 12px !important;\n        }\n    }\n\n}","itemSwatchMapping":"/* Shoopable video swatches */\n:host(cooee-item-options-picker.shoppable_video) {\n    .option-group {\n        .name {\n            display: none !important;\n        }\n\n        .option-values {\n            flex-wrap: nowrap !important;\n        }\n\n        .option-value {\n            border-radius: 0 !important;\n            --selected-color: unset;\n        }\n\n        .option-value.selected {\n            background-color: #F1E29F !important;\n        }\n\n        .option-value.disabled {\n            opacity: .5;\n            pointer-events: none;\n            position: relative;\n            /* needed for ::after positioning */\n        }\n\n        .option-value.disabled::after {\n            content: \"\";\n            position: absolute;\n            top: 50%;\n            left: 0;\n            width: 100%;\n            height: 1px;\n            background-color: #999;\n            transform: rotate(35deg);\n            transform-origin: center;\n        }\n    }\n\n    .option-group.size {\n        max-width: 260px;\n        /* constrain so overflow has somewhere to kick in — adjust to your layout */\n        overflow: hidden;\n    }\n\n    .option-values {\n        min-width: 0 !important;\n        /* the actual fix: allows the flex item to shrink instead of growing to fit all buttons */\n        flex: 1 1 auto;\n        overflow-x: auto !important;\n        -webkit-overflow-scrolling: touch;\n    }\n}\n\n/* product promotion swatches */\n:host(cooee-item-options-picker.product_promotion) {\n    .option-group {\n\n         .name {\n            display: none !important;\n        }\n        .option-values {\n            flex-wrap: nowrap !important;\n        }\n\n\n        .option-value {\n            border-radius: 4px !important;\n            --selected-color: unset;\n            height: 58px !important;\n            width: 58px !important;\n        }\n\n        .option-value.selected {\n            border: 3px solid black !important;\n        }\n\n        .option-value.disabled {\n            opacity: .5;\n            pointer-events: none;\n            position: relative;\n            /* needed for ::after positioning */\n        }\n\n        .option-value.disabled::after {\n            content: \"\";\n            position: absolute;\n            top: 50%;\n            left: 0;\n            width: 100%;\n            height: 1px;\n            background-color: #999;\n            transform: rotate(35deg);\n            transform-origin: center;\n        }\n    }\n}","commonJS":"setTimeout(() => {\n    window.CooeeSDK.customItemProperties = {\n        'Waist Size': '{{ variant.name }}',\n        'template': '{{ product.templateSuffix | replace(`water-repellent-usp-rtw`, `ready-made`, true) | replace(`ready-made`, `ready-made`, true) | replace(`jeans`, `jean-pants`, true) | replace(`no-fade-product-faq`, `jean-pants`, true) | replace(`water-repellent`, `jean-pants`, true) }}',\n    };\n}, 300);\n\n","widgetPartials":[{"name":"product-badge","template":"{{ @if(product.tags.includes('tppbogo')) }}\n<span class=\"cooee-product-badge cooee-badge-bogo\">B1G1FREE</span>\n{{ /if }}"}]},"checkoutProvider":"third_party","currencies":["INR"],"money":{"format":"Rs. {{ amount_no_decimals }}"},"currency":"INR"}}});
        
    })();
</script>
