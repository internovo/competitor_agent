      // Find the parent container
      const mapStoreLocatorInfo = document.querySelector('.store-details-images-map-view-cover');

      // Remove the existing child before adding a new one
      if (mapStoreLocatorInfo.firstChild) {
        mapStoreLocatorInfo.innerHTML = ''; // Clear previous content
      }
      var newCh = document.createElement('div')
      newCh.innerHTML = pageDetails;
      document.querySelector('.store-details-images-map-view-cover').appendChild(newCh)
      // 1. Get the primary store object safely
      const primaryStore = storeListData && storeListData.length > 0 ? storeListData[0] : null;

      // 2. Generate the rating HTML string using our reusable function
      const reviewSummaryHtml = generateReviewSummaryHtml(primaryStore);

      // 3. Build the fallback map link safely
      const mapCid = primaryStore.additionInfo?.[0]?.map_location_cid || '';
      const mapUrl = mapCid.includes('http') ? mapCid : 'https://maps.google.com/maps?cid=' + mapCid;
 
      var infoWindow = `
        <div class="location-title-div" style="color: #000042;">
         <h3><a href='/pages/${primaryStore.handle}'>${primaryStore.name}</a></h3>
          ${reviewSummaryHtml}
          <p>${primaryStore.address1}, ${primaryStore.address2 || ''}, ${primaryStore.city}, ${primaryStore.province}, ${primaryStore.zip}, ${primaryStore.country_name}</p>
          
          <a href="${mapUrl}" target="_blank" class="visit_link">
            <img class="inner-location-arrow" src="https://cdn.shopify.com/extensions/019fd0b5-1011-7034-a269-cb491143f5dc/omni-storelocator-app-2-308/assets/navigation.png" alt="Your image description">
            <span>Visit</span>
          </a>
      </div>
      `;

      var marker = [];
      
      var latLong = {
        position: { lat: parseFloat(storeListData[0].latitude), long: parseFloat(storeListData[0].longitude) },
        title: storeListData[0].name,
        infowindow: infoWindow,
        locationId: location.id,
      };
      marker.push(latLong);
      waitForGoogleMaps(() => {
        initSingleMap(marker, storeListData[0].country_name);
      });
    }
  
</script>


</div></div>


</div>
      </main>

      <div id="shopify-section-footer" class="shopify-section shopify-section--footer">
<footer
  id="section-footer"
  data-section-id="footer"
  data-section-type="footer"
  class="Footer  Footer--withMargin"
  role="contentinfo"
>
  <div class="Container Footer__Container"><div class="Footer__Inner hidden-pocket"><div class="Footer__Block Footer__Block--newsletter" ><div class="Footer__Title Heading u-h6">Signup &amp; Get 15% off</div><div class="Footer__Content Rte">
                    <p>Subscribe to our newsletter get <strong>15% off</strong> on your first custom-made order, access to exclusive deals, and more.</p>
                  </div><form method="post" action="/contact#footer-newsletter" id="footer-newsletter" accept-charset="UTF-8" class="Footer__Newsletter Form"><input type="hidden" name="form_type" value="customer" /><input type="hidden" name="utf8" value="✓" /><input type="hidden" name="contact[tags]" value="newsletter">
                    <input
                      type="email"
                      name="contact[email]"
                      class="Form__Input"
                      aria-label="Enter your email address"
                      placeholder="Enter your email address"
                      required
                    >
                    <button type="submit" class="Form__Submit Button Button--primary">
