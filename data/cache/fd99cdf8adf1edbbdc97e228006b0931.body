vali-west-1a256b7a71\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Siddha Group\",\"item\":\"https://blox.xyz/buy/mumbai/kandivali-west-siddha-group-1a256b7a71b13a96\"},{\"@type\":\"ListItem\",\"position\":5,\"name\":\"Siddha Seabrook\",\"item\":\"https://blox.xyz/projects/siddha-seabrook\"}]\n}","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\"@type\":\"Question\",\"name\":\"When is the possession date for Siddha Seabrook?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Possession date of Siddha Seabrook is 29 Dec 2023\"}},{\"@type\":\"Question\",\"name\":\"What is the RERA carpet area range of Siddha Seabrook?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The RERA carpet area range for Siddha Seabrook is 496 - 972 sqft\"}},{\"@type\":\"Question\",\"name\":\"What is the price range of Siddha Seabrook?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The price range of Siddha Seabrook is ₹1.08 Cr - 1.65 Cr\"}},{\"@type\":\"Question\",\"name\":\"Where is Siddha Seabrook located?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Siddha Seabrook is located at Siddha Seabrook, Shiv Shankar Nagar, Link Road, Lalji Pada, Kandivali (West), Mumbai, Maharashtra 400067.\"}},{\"@type\":\"Question\",\"name\":\"What configurations are available in Siddha Seabrook?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Siddha Seabrook has 1.5 BHK, 2 BHK, 3 BHK configurations.\"}},{\"@type\":\"Question\",\"name\":\"What is the status of Siddha Seabrook?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The status of Siddha Seabrook is Ready to move.\"}},{\"@type\":\"Question\",\"name\":\"Which amenities are provided in Siddha Seabrook?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The amenities are CCTV / Video Surveillance, Gymnasium, Indoor Games, Intercom Facility, Kids Pool, Library And Business Centre, Luxurious Clubhouse, Party Lawn, Party Lawn, Swimming Pool.\"}},{\"@type\":\"Question\",\"name\":\"Who is the developer of Siddha Seabrook?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The developer of Siddha Seabrook is Siddha Group.\"}}]\n}\n","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"Siddha Seabrook\",\n  \"image\": \"https://cdn.blox.xyz/builders/thumb/301221050206-Siddha.png\",\n  \"description\": \"Siddha Seabrook by Siddha Group is a premium residential project located in Kandivali West, Mumbai. Positioned in a prime suburban neighborhood, it is celebrated as the tallest residential tower in the area, offering residents panoramic city views and a distinctive living experience. The project enjoys excellent connectivity through a well-established public transport network and is surrounded by essential conveniences such as reputed schools, hospitals, ATMs, and markets. Siddha Seabrook is ideal for families and professionals seeking comfort, accessibility, and an elevated lifestyle in one of Mumbai’s most vibrant suburbs.\",\n  \"brand\": {\n\t\t\"@type\": \"Brand\",\n\t\t\"name\": \"Siddha Group\"\n\t},\n  \"offers\": {\n\t\t\"@type\": \"AggregateOffer\",\n    \"url\": \"https://blox.xyz/projects/siddha-seabrook\",\n\t\t\"priceCurrency\": \"INR\",\n\t\t\"lowPrice\": \"10800000.00\",\n\t\t\"highPrice\": \"21900000.00\"\n\t}\n}\n","\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": [\n      \"SingleFamilyResidence\",\n      \"Product\",\n      \"RealEstateListing\"\n  ],\n  \"@id\": \"https://blox.xyz/projects/siddha-seabrook\",\n  \"mpn\": \"P51800008859\",\n  \"brand\": {\n    \"@type\": \"Brand\",\n    \"@id\": \"https://blox.xyz/buy/mumbai/siddha-group-1a256b13a96\",\n    \"name\": \"Siddha Group\"\n  },\n  \"url\": \"https://blox.xyz/projects/siddha-seabrook\",\n  \"containedInPlace\": {\n      \"@type\": \"Place\",\n      \"@id\": \"Siddha Seabrook\",\n      \"url\": \"https://blox.xyz/projects/siddha-seabrook\",\n      \"name\": \"Siddha Seabrook\",\n      \"address\": {\n          \"@type\": \"PostalAddress\",\n          \"streetAddress\": \"Siddha Seabrook, Shiv Shankar Nagar, Link Road, Lalji Pada, Kandivali (West), Mumbai, Maharashtra 400067\",\n          \"addressLocality\": \"Kandivali West\",\n          \"addressRegion\": \"Mumbai\",\n          \"postalCode\": \"400067\",\n          \"addressCountry\": \"IN\"\n      }\n  },\n  \"description\": \"Siddha Seabrook by Siddha Group is a premium residential project located in Kandivali West, Mumbai. Positioned in a prime suburban neighborhood, it is celebrated as the tallest residential tower in the area, offering residents panoramic city views and a distinctive living experience. The project enjoys excellent connectivity through a well-established public transport network and is surrounded by essential conveniences such as reputed schools, hospitals, ATMs, and markets. Siddha Seabrook is ideal for families and professionals seeking comfort, accessibility, and an elevated lifestyle in one of Mumbai’s most vibrant suburbs.\",\n  \"floorSize\": [\n      {\n          \"@type\": \"QuantitativeValue\",\n          \"unitCode\": \"SQFT\",\n          \"minValue\": \"496\",\n          \"maxValue\": \"972\"\n      }\n  ],\n  \"image\": [\n      {\n          \"@type\": \"ImageObject\",\n          \"url\": \"https://cdn.blox.xyz/builders/thumb/301221050206-Siddha.png\"\n      }\n  ],\n  \"name\": \"Siddha Seabrook\",\n  \"offers\": {\n      \"@type\": \"Offer\",\n      \"@id\": \"P51800008859\",\n      \"availability\": \"https://schema.org/InStock\",\n      \"name\": \"Sale of Siddha Seabrook Unit\",\n      \"url\": \"https://blox.xyz/projects/siddha-seabrook\",\n      \"price\": 10800000.00,\n      \"priceCurrency\": \"INR\"\n  }\n}\n"],"aiReviewSummary":{"summary":"Resident Satisfaction: Many residents appreciate the modern lifestyle and the scenic sea views offered from higher floors of this 57-story skyscraper. Connectivity Feedback: Reviews frequently highlight the excellent proximity to the Dahanukarwadi Metro Station and public transport options on Link Road. Quality and Service: Opinions on construction and management are mixed, with some praising the hygiene and maintenance while others report unresponsive staff and delays in addressing concerns. Community and Environment: The society is described as having a friendly, cooperative community, though the presence of nearby slum settlements is a recurring point of concern for some reviewers.","pros":[{"title":"Metro Proximity","description":"The project is located exceptionally close to the Dahanukarwadi Metro Station, significantly easing daily commutes."},{"title":"Modern Amenities","description":"Residents have access to a variety of facilities including a swimming pool, gymnasium, mini theatre, and a rooftop terrace."},{"title":"Scenic Views","description":"Higher-level apartments offer expansive views of the city skyline and the Arabian Sea."},{"title":"Unique Architecture","description":"The building features sky gardens on every fifth floor and is one of the tallest towers in the region."},{"title":"Neighborhood Essentials","description":"Daily needs are easily met with markets, schools, hospitals, and shopping malls located within a short distance."}],"cons":[{"title":"Traffic Congestion","description":"The surrounding roads, particularly during peak hours, are prone to heavy traffic and bottlenecking."},{"title":"External Environment","description":"The project is situated in an area with a high density of slum settlements, which impacts the neighborhood aesthetics."},{"title":"Noise Levels","description":"The lively atmosphere and proximity to the main road result in significant noise pollution that can be disruptive."},{"title":"Parking Constraints","description":"There is limited parking space available for visitors, leading to inconvenience for residents' guests."},{"title":"High Maintenance","description":"Some owners have expressed dissatisfaction with the high monthly maintenance charges relative to the services provided."}],"verdict":["Great for young professionals","Excellent for metro commuters","Good value for high-rise living","Avoid if sensitive to neighborhood noise","Ideal for families seeking modern facilities"]},"googleReviews":{"html_attributions":[],"result":{"rating":4,"reviews":[{"author_name":"Riya R Patwa","author_url":"https://www.google.com/maps/contrib/109970406997146531206/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjUoMobsRjAhXsafp7orfEg-H7aHPFm8PHKEgwXSOW9vaKzSpdik_w=s128-c0x00000000-cc-rp-mo-ba5","rating":5,"relative_time_description":"a month ago","text":"This is Kandivali's tallest tower. The higher you go, the more beautiful the views you'll see. This building offers no water problems, with 24-hour water supply.\nThe biggest problem of this building is its parking. The lift keeps breaking down.","time":1783907532,"translated":false},{"author_name":"Vinod Pathak","author_url":"https://www.google.com/maps/contrib/111895842912862611159/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a/ACg8ocJ3Dz2rggxeCybUSyMLkDw9X2_RbQR9Ewag9RPFh3T-yo5YpQ=s128-c0x00000000-cc-rp-mo","rating":5,"relative_time_description":"11 months ago","text":"Visited a friend’s flat here — impressed by the quality of construction and design. The amenities are top-notch — especially the party hall, games room, and amphitheatre area. Great for families.","time":1757498561,"translated":false},{"author_name":"Arti Dubey","author_url":"https://www.google.com/maps/contrib/118108426592651953533/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a/ACg8ocKhCiIiltk9DLAYuHIStaUF7NX1oAkyrnibrwhbUvUGMGuk=s128-c0x00000000-cc-rp-mo","rating":1,"relative_time_description":"6 months ago","text":"Builder is not paying pending property tax and not giving brokrage to agent since last 8 months ...They dont need any broker support for their Siddha Sky wadala project...very disappointing","time":1770112299,"translated":false},{"author_name":"jay rajgor","author_url":"https://www.google.com/maps/contrib/109916399439192539027/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a-/ALV-UjV3pRr_hYoUUd9znGkQOG2jnVtgDXAi7YLPm6bTuKGXrgtkRKl7=s128-c0x00000000-cc-rp-mo-ba2","rating":1,"relative_time_description":"a year ago","text":"Went to book flat here the staff weren't able to answer our questions tried to manipulate us and link road side of the building are there are dog poops every where kindly do mention instructions because we so people taking their dogs to poop outside the building area on pedestrian footpath. Kindly look into this issue. Do try to maintain hygiene outside the building area also .","time":1755344807,"translated":false},{"author_name":"Nayan Mishra","author_url":"https://www.google.com/maps/contrib/106330900736923480817/reviews","language":"en","original_language":"en","profile_photo_url":"https://lh3.googleusercontent.com/a/ACg8ocI8CewPRvwwYiAxGaLHxn4tYry5EEZj1fDq4h92-fCC_SUpag=s128-c0x00000000-cc-rp-mo","rating":1,"relative_time_description":"6 months ago","text":"We bought a flat in 4906, its been more then 2 years since we are living here, the flat No. 5006 is doing his intireor work for more then 2 years....and when we complain they say [bohot bade politician ka ghar hain😭😭\nDont waste your money.....2 lifts not working and they dont care....plz dont waste your money.....unless youre a politician🥰🥰🥰","time":1770727242,"translated":false}],"url":"https://maps.google.com/?cid=14422117595301493481","user_ratings_total":103},"status":"OK"}},"isMobile":false,"footerData":{"featured":{"kolkata":{"label":"Kolkata","id":14},"mumbai":{"label":"Mumbai","id":256},"navi-mumbai":{"label":"Navi Mumbai","id":261},"pune":{"label":"Pune","id":300},"thane":{"label":"Thane","id":269}},"others":{"alibaug":{"label":"Alibaug","id":1907},"bangalore":{"label":"Bangalore","id":95},"noida":{"label":"Noida","id":84},"palghar":{"label":"Palghar","id":264},"raigad":{"label":"Raigad","id":3323},"telangana":{"label":"Telangana","id":3326}}},"__N_SSP":true},"page":"/projects/[project_name]","query":{"project_name":"siddha-seabrook"},"buildId":"t4LZHlTlBLViwyNa5GApO","isFallback":false,"gssp":true,"appGip":true,"scriptLoader":[]}</script></body></html>