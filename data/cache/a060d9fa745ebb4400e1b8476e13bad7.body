 </div>

<div class="modal fade alert-modal" id="alertModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div id="autoShowPropertyInterest_Container" class="modal-content">
            <form name="requirementForm" class="formBox" novalidate>
                <button type="button" data-dismiss="modal" class="closealertmodal">&times;</button>
                <div class="modal-body clearfix">
                    <div class="modal-body-left" style="background:url(https://teja8.kuikr.com/restatic/build/image/req_form.jpg) no-repeat center center;">
                    </div>
                    <div class="modal-body-right input-div">
                        <div class="alerttext">
                            <h3><i class="icon icon-create-free-alert"></i> Receive Email Alerts for more Properties!</h3>
                            <p>Get the best properties matching your requirements via Email</p>
                        </div>
                        <div class="newmodal">
                            <div class="modal-body-msg-left">
                                <div class="awesome">
                                    <i class="icon-tick_circle"></i> Awesome! You did it.
                                </div>
                                <div class="clearfix"></div>
                                <div class="getintouch">
                                    <p>
                                        Someone will get in touch with you on:<br/>
                                        <b id="successPhone"></b> and <br/>
                                        <b id="successEmail"></b>
                                    </p>
                                </div>

                                <div class="clearfix"></div>

                                <button type="button" class="button button-secondary-line btncls" data-dismiss="modal"><span>Close</span></button>
                            </div>
                            <div class="topPanel"></div>
                            <div class="bottomPanel"></div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="text/x-underscore-template" id="autoShowPropertyInterestTopPanel">
    <div class="modal-body-ext-left" style="padding-bottom: 0;">
        <h3><%= requirementController.getCityName() %></h3>
        <% if(requirementController.adType) { %>
        <div class="positonfiedler" ng-show="adType">
            <ul class="radio-box input-div">
                <li>
                    <input type="radio" id="Buy" name="ad_type" <% if(requirementController.adType == 'sale'||requirementController.adType =='buy') { %> checked <% } %> ng-model="adType" onclick="requirementController.setData('buy','adType')">
                    <label for="Buy">Buy</label>
                </li>

                <li>
                    <input type="radio" id="Rent-Out" name="ad_type" <% if(requirementController.adType == 'rent_in') { %>checked<% } %> ng-model="adType" onclick="requirementController.setData('rent_in','adType')">
                    <label for="Rent-Out">Rent</label>
                </li>
                <li>
                    <input type="radio" id="PG" name="ad_type" <% if(requirementController.adType == 'pg_in') { %>checked <% } %> onclick="requirementController.setData('pg_in','adType')">
                    <label for="PG">PG/Hostels</label>
                </li>
                <div class="clearfix"></div>
            </ul>
        </div>
        <% } %>
        <div class="row">
            <div class="col-xs-12">
                <div class="dropdown-menu-open input-design inputlist open">
                    <!--<input data-toggle="tooltip" data-placement="top" title="You can select multiple localities"
                           type="text"
                           name="locality"
                           ng-model="locality.values"
                           typeahead="s.title for s in getSuggestedLocality($viewValue)"
                           ng-model-options="{ debounce: 500 }"
                           ng-focus="locationFocus=true"
                           ng-blur="locationFocus=false"
                           typeahead-on-select="locationSelection($item)"
                           autocomplete="off"
                           required
                           class=""
                    >-->
                    <div class="location-box-add">
                        <% _.each(requirementController.selectedLocations, function(selLoc){ %>
                        <span>
                            <%= selLoc.title %>
                            <i class="icon icon-reset" onclick="requirementController.locationRemoval('<%= selLoc.id %>')"></i>
                        </span>
                        <% }); %>

                         <div class="searchloc">
                            <input type="text" name="locality" class="typeahead">
                        </div>
                    </div>
                    <label for="locality">Location</label>
                    <div class="clearfix"></div>
                </div>
            </div>
        </div>
        <div class="row">
         <% if(requirementController.showBHKDropDown) { %>
            <div class="col-xs-6 padding-r0">
            <% } else { %>
                <div class="col-xs-12">
            <% } %>
                <div class="dropdown-menu-open <%= requirementController.selectedUnitTypeTxt ? 'open-label' : '' %>">
                    <a href="" data-toggle="dropdown"><span><%= requirementController.selectedUnitTypeTxt %></span>&nbsp;<i class="icon icon-down-open-mini"></i></a>
                    <label>Category</label>
                    <ul class="dropdown-open-onclick dropdown-menu">
                        <% _.each(requirementController.propertyTypes, function(x){ %>
                        <li onclick="requirementController.selectUnitTypeTxt('<%= x %>');requirementController.reRenderAlertTopPanel();"><%= x %></li>
                        <% }); %>
                    </ul>
                </div>
            </div>
            <% if(requirementController.showBHKDropDown) { %>
            <div class="col-xs-6 padding-l0" ng-show="showBHKDropDown">
                <div class="dropdown-menu-open <%= requirementController.selectedBHK ? 'open-label' : '' %>">
                    <a href="" data-toggle="dropdown"><span><%= requirementController.selectedBHK %></span>&nbsp;<i class="icon icon-down-open-mini"></i></a>
                    <label><%= requirementController.want_ad_tree.about_property.bedroom.label %></label>
                    <ul class="dropdown-open-onclick dropdown-menu">
                        <% _.each(requirementController.allBhks, function(x){ %>
                        <li onclick="requirementController.selectBHK('<%= x %>');requirementController.reRenderAlertTopPanel();"><%= x %></li>
                        <% }); %>
                    </ul>
                </div>
            </div>
            <% } %>
        </div>

        <div class="row">
            <div class="col-xs-12">
                <div class="dropdown-menu-open <%= requirementController.want_ad_tree.about_property.price_range.value.min * 1 > -1 || requirementController.want_ad_tree.about_property.price_range.value.max * 1 > -1 ? 'open-label' : '' %>">
                    <a href="" data-toggle="dropdown">
                        <% if((requirementController.want_ad_tree.about_property.price_range.value.min * 1) < 0 && (requirementController.want_ad_tree.about_property.price_range.value.max * 1 < 0)) { %>
                        <span>&nbsp; </span>
                        <% } %>
                        <% if((requirementController.want_ad_tree.about_property.price_range.value.min * 1 > -1 && (requirementController.want_ad_tree.about_property.price_range.value.max * 1 < 0))) { %>
                                        <span>
                                            Approximate <%= currencyFilter(requirementController.want_ad_tree.about_property.price_range.value.min) %><!-- | currencyf -->
                                        </span>
                        <% } %>
                        <% if((requirementController.want_ad_tree.about_property.price_range.value.max *1 > -1) && (requirementController.want_ad_tree.about_property.price_range.value.min * 1 < 0)) { %>
                                        <span>
                                            Less than <%= requirementController.want_ad_tree.about_property.price_range.value.max %><!-- | currencyf -->
                                        </span>
                        <% } %>
                        <% if((requirementController.want_ad_tree.about_property.price_range.value.min* 1) > -1 && (requirementController.want_ad_tree.about_property.price_range.value.max * 1 > -1)) { %>
                                        <span>
                                            <%= currencyFilter(requirementController.want_ad_tree.about_property.price_range.value.min) %> <!-- | currencyf -->
                                            to
                                            <%= currencyFilter(requirementController.want_ad_tree.about_property.price_range.value.max) %><!-- | currencyf -->
                                        </span>
                        <% } %>&nbsp;
                        <i class="icon icon-down-open-mini"></i></a>
                    <label><%= requirementController.want_ad_tree.about_property.price_range.label %></label>

                    <div class="clearfix"></div>

                    <div class="dropdown-open-onclick quikr-dropdown-menu">
                        <ul class="min-list">
                            <li>Min</li>
                            <% _.each(requirementController.want_ad_tree.about_property.price_range.options[requirementController.topCategoryValue][requirementController.adTypeValue]['min'], function(minValue){ %>
                            <li class="<%= minValue.api_value*1 >= requirementController.MinPriceDisable*1 ? 'disabled' : '' %>"
                                onclick="requirementController.setData('<%= minValue.api_value %>', 'priceMin');requirementController.reRenderAlertTopPanel();"
                            ><%= minValue.value %>
                            </li>
                            <% }); %>
                        </ul>
                        <ul class="max-list">
                            <li>Max</li>
                            <% _.each(requirementController.want_ad_tree.about_property.price_range.options[requirementController.topCategoryValue][requirementController.adTypeValue]['max'], function(maxValue) { %>
                            <li class="<%= maxValue.api_value*1 <= requirementController.want_ad_tree.about_property.price_range.value.min*1 ? 'disabled' : '' %>"
                                onclick="requirementController.setData('<%= maxValue.api_value %>', 'priceMax');requirementController.reRenderAlertTopPanel();"
                            ><%= maxValue.value %>
                            </li>
                            <% }); %>
                        </ul>
                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>
        </div>
        <!--rerender for checkbox -->
        <% if(requirementController.gaAction == 'Vap') { %>
        <div class="imanimg">
            <ul class="radio-box input-div cbpos">
                <li>
                    <input type="checkbox" id="sebhk" <%= requirementController.saveAdcheck ? 'checked' : ''  %> onclick="requirementController.checkSaveAdReply(<%= (requirementController.saveAdcheck) %>);requirementController.reRenderAlertTopPanel();">
                    <label for="sebhk">Send my enquiry to the <b> <%= requirementController.userConvert(requirementController.propertySnippet.userType) %> <%= requirementController.setEnquiryname %></b> for property <b><%=requirementController.setEnquiryBhk %>  <%=requirementController.setEnquiryUnit %> for <%= requirementController.propertySnippet.propertyFor %>.</b></label>
                </li>
                <div class="clearfix"></div>
            </ul>
        </div>
         <% } %>
        
    </div>
</script>
<script type="text/x-underscore-template" id="autoShowPropertyInterestBottomPanel">
    <div style="padding:0 20px 30px; position: relative; z-index: 999;">
        <div class="row">
            <div class="col-xs-6 padding-r0">
                <div class="nameWrapper input-design <%= requirementController.enquiry_name ? 'open' : ''  %>">
                    <input
                        type="text"
                        name="name"
                        value="<%= requirementController.enquiry_name %>"
                    >
                    <label>Name</label>
                </div>
            </div>
            <div class="col-xs-6 padding-l0">
                <div class="emailWrapper input-design <%= requirementController.emailList.length > 0 || requirementController.enquiry_email ? 'open' : ''  %>">
                    <% if(requirementController.emailList.length > 0) { %>
                    <div class="dropdown-menu-open">
                        <a href="" data-toggle="dropdown"> <span> <%= requirementController.enquiry_email %> </span> &nbsp;<i class="icon icon-down-open-mini"></i></a>
                        <ul class="dropdown-open-onclick dropdown-menu">
                            <% _.each(requirementController.emailList, function(email){ %>
                            <li onclick="requirementController.setData('<%= email.emailId %>','email');requirementController.reRenderAlertBottomPanel()"><%= email.emailId %></li>
                            <% }); %>
                        </ul>
                    </div>
                    <% } %>
                    <% if(requirementController.emailList.length < 1) { %>
                    <input
                        type="text"
                        name="email"
                        value="<%= requirementController.enquiry_email %>"
                        required
                    >
                    <% } %>
                    <label>Email *</label>

                    <div class="error-container hide">
                        <small class="email_required"> Your email is required.</small>
                        <small class="email_pattern"> That is not a valid email. Please input a valid one.</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="input-design isdnum isdcode open">
            <% if(requirementController.mobileList.length > 0) { %>
            <div class="dropdown-menu-open" dropdown>
                <a href="" data-toggle="dropdown"> <span> <%= requirementController.enquiry_phone %> </span> &nbsp;<i class="icon icon-down-open-mini"></i></a>
                <ul class="dropdown-open-onclick dropdown-menu">
                    <% _.each(requirementController.mobileList, function(mobile){ %>
                    <li onclick="requirementController.setData('<%= mobile.mobileNumber %>','mobile');requirementController.reRenderAlertBottomPanel()"><%= mobile.mobileNumber %></li>
                    <% }); %>
                </ul>
            </div>
            <% } %>
            <div class="stdcode">
    <span>+</span>
    <select>
    	<option selected="selected" value="91">91</option>
    	    </select>
</div>            <% if(requirementController.mobileList.length < 1) { %>
            <input
                type="text"
                name="mobile"
                value="<%= requirementController.enquiry_phone %>"
            >
            <% } %>
            <label class="alltop">Mobile *</label>

            <div class="error-container hide">
                <small class="mobileNo_required"> Your mobile number is required.</small>
                <small class="mobileNo_pattern"> Please enter a valid mobile number.</small>
            </div>
        </div>

<!--        <div class="row activebox" ng-if="otpNeeded && replyerr || otpNeeded ">
            <div class="col-xs-12">
                <otp seller-mobile="enquiry_phone"
                     seller-email=""
                     user-type=""
                     page="REPLY"
                     main-page="pageName"
                     data-html="otpReply"
                     userdata="userdata">
                </otp>
            </div>
        </div>
-->
        <div class="row activebox otpShow">
            <div class="col-xs-12">
                <div>
                    <div class="otpSubmitForm" novalidate>
    <div class="form-group input-div"
         ng-class="(otpSubmitForm.enquiry_otp.$viewValue.length > 0  || otpLabel) ? 'focus-label' :''">
        <div class="input-design open">
            <input type="text"
                   char-limit="10"
                   name="enquiry_otp"
                   autocomplete="off"
                   id="pap_otp"
                   maxlength=4
                   ng-focus="otplabel=true"
                   required
                   placeholder="xxxx"
                   style="z-index:2" 
                   ng-change="(userdata.errorLabel == 'MOBILE_ALREADY_REGISTERED' ? claimedUserMobile() : '')"
                   ga-directive
                   ga-options="{'category': 'button-RealestateResponsiveUI', 'action': 'postad_page1_Real-Estate', 'label': 'click_mobile_otp_reply'}">
            <label>Enter OTP</label>
            <div class="error-container hide">
                <small class="error-msg"></small>
            </div>
        </div>
        <small class="hide otpsuccess">&nbsp;</small>
        <div class="linkbtn" id="homeloanResendOtp" style="width:90px;float:right;z-index:3;" onclick="otpController.reGenerateOTP();">Resend OTP</div>
    </div>
</div>

                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        
        <% if(requirementController.topBanksDetail.topBanks && (requirementController.adType == 'sale'||requirementController.adType =='buy')) { %>
        <div class="row clpos">
            <div class="col-xs-12 col-md-12">
                <div class="checkbox">
                    <input type="checkbox" value="" onchange="requirementController.showHideBank(this)">
                    <% _.each(requirementController.topBanksDetail.topBanks, function(topBank){  var imgName= topBank.bankName.toLowerCase().split(' ').join('_')+'.jpg';%>
                        <img loading="lazy" src="https://teja8.kuikr.com/restatic/build/image/bank_logo/<%= imgName %>" alt="<%= imgName %>" class="bankimg" />
                    <% }); %>

                    <% if(requirementController.topCategoryValue === 'commercial') { %>
                        <span>Yes, I need commercial premises loan</b></span>
                    <% } else { %>
                        <span>Yes, I need a home loan</b></span>
                    <% } %>
                </div>
            </div>
        </div>
        <% } %>
        
        <button
            type="button"
            class="button button-secondary btn-lg wd100" onclick="requirementController.submit(this);"
            >Submit
        </button>
        <div class="qcontent autos"> I authorise Quikr and its business associates, partners and/or affiliates to call, sms or email me in connection with my application or for offering other products and services and I agree to the privacy policy and terms of use.</div>
    </div>
</script><div class="modal fade brokerpopup" id="brokerModel" role="dialog">
    <div class="modal-dialog modal-md">
        <div id="replyBroker_Container" class="modal-content">
        </div>
    </div>
</div>

<div class="modal fade reply-modal" id="replyModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div id="replyBox_Container" class="modal-content">
            <div class="newmodal"></div>
        </div>
    </div>
</div>

<div class="modal fade commonpopup reply-modal" id="commonpopup" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="reply_Container">
            
        </div>
    </div>
</div><!-- voting popup start here -->
<div class="modal fade commonpopup voting_p" id="voting_p" role="dialog" aria-labelledby="pasampleimage" aria-hidden="true">
    <div class="modal-dialog" role="document" id="votingthankyou">
        <div class="modal-content">
            <div class="header-modal">
                <button type="button" class="close noreason" data-dismiss="modal" aria-label="Close">
                  <span class="icon-reset"></span>
                </button>
            </div>
            <div class="modal-body"  id="votingForm">
                <div class="radioboxcheck clearfix" id="reportQuestion">
                                        <div class="input-div">
                        <input type="checkbox" value="Property not available" id="reason1" name="votereasonOpt" >
                        <label for="reason1">Property not available</label>
                    </div>
                                        <div class="input-div">
                        <input type="checkbox" value="Poster not reachable" id="reason2" name="votereasonOpt" >
                        <label for="reason2">Poster not reachable</label>
                    </div>
                                        <div class="input-div">
                        <input type="checkbox" value="Poster is a fraud" id="reason3" name="votereasonOpt" >
                        <label for="reason3">Poster is a fraud</label>
                    </div>
                                        <div class="input-div">
                        <input type="checkbox" value="Wrong/Misleading information" id="reason4" name="votereasonOpt" >
                        <label for="reason4">Wrong/Misleading information</label>
                    </div>
                                        <div class="input-div">
                        <input type="checkbox" value="Fake/Wrong images" id="reason5" name="votereasonOpt" >
                        <label for="reason5">Fake/Wrong images</label>
                    </div>
                                    </div>
                <div class="formbox">
                    <textarea id="votereason" maxlength="500" placeholder="Please share what we can improve!"></textarea>
                    <div class="character_limit">Max 500 character </div>
                    <button type="button" data-dismiss="modal" aria-label="Close" class="button button-secondary-line btnsbt noreason">
                        Cancel
                    </button>
                    <button type="button" id="reasonformsubmit" class="button button-secondary btnsbt">
                        Submit
                    </button>
                </div>
            </div>
            <div class="voting_thnku">
                <strong>Thank you!</strong> for your feedback
                <button type="button" class="button button-secondary btnsbt" data-dismiss="modal" aria-label="Close">
                    OK
                </button>
            </div>
        </div>
    </div>
</div>
<!-- voting popup end here --><script type="text/x-underscore-template" id="projectCarouselGalary">
    <!--  start carousel -->
    <div id="projectCarousel" class="carousel" data-ride="carousel" data-interval="false">
        <!-- Wrapper for slides -->
        <div class="carousel-inner" role="listbox" itemscope itemtype="http://schema.org/ImageObject">
            <% _.each(carauselData, function(data,idx){ %>
            <div class="item <%= idx == 0 ? 'active' : '' %> ">
                <% if(idx == 0) { %>
                <img loading="lazy" src="<%= data.data %>">
                <% } else { %>
                <img loading="lazy" src="" data-src="<%= data.data %>" class="lazyLoadCarouselImages lozad">
                <% } %>
            </div>
            <% }); %>
        </div>

        <!-- Controls -->
        <% if(globals.imageUrl.projectPhotos.length > 0) { %>
        <a class="left carousel-control" href="#projectCarousel" role="button" data-slide="prev">
            <span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <% } %>
        <% if(globals.imageUrl.projectPhotos.length > 0) { %>
        <a class="right carousel-control" href="#projectCarousel" role="button" data-slide="next">
            <span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
        <% } %>
        <!-- Extra -->
        <div class="excontrol hidden-xs">
            <div class="tablerow">
                <% if(globals.imageUrl.projectPhotos.length > 0) { %>
                <div class="scontrol"
                     onclick="Lightbox.openModal(event,'<%= btoa(JSON.stringify(imageLightbox)) %>', 0, 'data',true)"
                     ga-directive
                     ga-options="{'category': 'link-RealestateResponsiveUI', 'action': 'Project_Real-Estate', 'label': 'masthead_photos_click'}"><%= globals.imageUrl.projectPhotos.length %> Photos</div>
                <% } %>
            </div>

            <% if(streetVideos) { %>
            <div class="street_video">
                <span>Street video</span>
            </div>
            <% } %>
        </div>
    </div>
    <!--  end carousel -->

</script><div class="modal fade helpyou" id="myModal" role="dialog" aria-labelledby="myModalLabel">
  <div class="modal-dialog" role="document">
    <div id="requirementDetails" class="modal-content">
      
    </div>
  </div>
</div>
<script type="text/x-underscore-template" id="requirement_details">
    <div class="modal-body">
        <div class="help_l_side">
                <div class="thtop">
                    <img loading="lazy" src="https://teja8.kuikr.com/restatic/build/image/thankyou.png" alt="User" class="usr" />
                </div>
                <div class="co_img">
                    <% if(otpController.viewNumberData !== '') { %>
                        <p>Below are the details to Contact<p>
                        <div class="co_content">
                            <div class="imgbox">
                                <img loading="lazy" width="70"  src="https://teja8.kuikr.com/restatic/build/image/vap-broker-d.png">
                            </div> 
                            <div class="three_c">
                                <% if(otpController.viewNumberData.name !== ''){%> <%=otpController.viewNumberData.name%><%}%>
                                <% if(otpController.viewNumberData.mobile !== ''){%><strong><%=otpController.viewNumberData.mobile%></strong><%}%>
                                <% if(otpController.viewNumberData.email !== ''){%><span><%=otpController.viewNumberData.email%></span><%}%>
                            </div>
                        </div>
                    <% } else { %>
                        <p>The owner will get in touch with you on <span ><%= otpController.enquiry_phone %> </span> and <span><%= otpController.enquiry_email %></span><p>
                    <% } %>
                    <% if((typeof globals.qcashEnabled !== 'undefined') && globals.qcashEnabled !=0) { %>
                        <div class="q_cash_po qcashthankyou clearfix hide">
                              <img loading="lazy" src="https://teja8.kuikr.com/restatic/build/image/QCash_Icon.png"/>
                              <div class="price_q">
                                  <b id="qcashresp">You get <span>&#8377;50 QCash</span></b>
                                  <p>Use now to buy premium Ad packs</p>
                              </div>
                        </div> 
                    <% } %>
                </div>

        </div>
        <div class="help_r_side" id="thankSucess">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" class="icon-reset"></span>
                </button>
                <!--  <div class="mobilno" id="requirementMobile"></div> -->
                <div class="fillform">
                    <h4 class="modal-title" id="myModalLabel">Tell us more about your self & get better matching properties.</h4>
                    <form class="helpfor">
                        <% if(otpController.propertySnippet.propertyFor=='pg' || otpController.propertySnippet.propertyFor=='flatmates') { %>
                        <div class="positonfiedler">
                            <span>Gender</span>
                            <ul class="radio-box input-div">
                                <li>
                                    <input type="radio" id="Buy1" name="ad_type" onclick="otpController.userType('M')">
                                    <label for="Buy1">Male</label>
                                </li>
                                <li>
                                    <input type="radio" id="Rent-Out1" name="ad_type" onclick="otpController.userType('F')">
                                    <label for="Rent-Out1">Female</label>
                                </li>
                                <div class="clearfix"></div>
                            </ul>
                        </div>
                        <% } %>
                        <div class="formdiv <%=otpController.propertySnippet.propertyFor !='sale' ? 'rentenrch': '' %> ">
                            <% if(otpController.propertySnippet.propertyFor=='pg' || otpController.propertySnippet.propertyFor=='flatmates' || otpController.propertySnippet.propertyFor == 'rent') { %>

                            <div class="h_field width50 <%= otpController.relocatingText ? 'open_l' : '' %>" dropdown>
                                <a href="javascript:;" data-toggle="dropdown">
                                    <span><%= otpController.relocatingText %></span>
                                </a>
                                <label>When are you planning to relocate?</label>
                                <i class="icon-down-open-mini"></i>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript:;" onclick="otpController.relocate('30','1 Month')">1 Month</a></li>
                                    <li><a href="javascript:;" onclick="otpController.relocate('60','2 Month')">2 Month</a></li>
                                    <li><a href="javascript:;" onclick="otpController.relocate('150','5 Month')">5 Month</a></li>
                                </ul>
                            </div>
                            <div class="h_field width50 <%= otpController.familyDetailsText ? 'open_l' : '' %>" dropdown>
                                <a href="javascript:;" data-toggle="dropdown">
                                    <span><%= otpController.familyDetailsText %></span>
                                </a>
                                <label>Are you a bechalor or family?</label>
                                <i class="icon-down-open-mini"></i>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript:;" onclick="otpController.family('single','Bachelor')">Bachelor</a></li>
                                    <li><a href="javascript:;" onclick="otpController.family('married','Couple')">Couple</a></li>
                                    <li><a href="javascript:;" onclick="otpController.family('withfamily','Family with Kids')">Family with Kids</a></li>
                                    <li><a href="javascript:;" onclick="otpController.family('jointfamily','Joint Family')">Joint Family</a></li>
                                </ul>
                            </div>
                            <div class="h_field width50 width50 <%= otpController.schoolOfficeText ? 'open_l' : '' %>" dropdown>
                                <a href="javascript:;" data-toggle="dropdown">
                                    <span><%= otpController.schoolOfficeText %></span>
                                </a>
                                <label>Your location preference near to?</label>
                                <i class="icon-down-open-mini"></i>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript:;" onclick="otpController.schoolOffice('School','School')">School</a></li>
                                    <li><a href="javascript:;" onclick="otpController.schoolOffice('Office','Office')">Office</a></li>
                                </ul>
                            </div>
                            <div class="h_field width50 <%= otpController.locality ? 'open_l' : '' %>" dropdown>
                                <input type="text" value="<%= otpController.locality %>" name="local" id="locality_suggest" onkeypress="otpController.localitySuggest()" class="typeahead" data-toggle="dropdown" autocomplete="off">
                                <label>Your office located in?</label>
                                <i class="icon-down-open-mini"></i>
                                <ul class="dropdown-menu" id="autoShowLocality">
                                </ul>
                            </div>
                            <div class="clearfix"></div>
                            <div class="h_field width50 <%= otpController.professoinText ? 'open_l' : '' %>" dropdown>
                                <a href="javascript:;" data-toggle="dropdown">
                                    <span><%= otpController.professoinText %></span>
                                </a>
                                <label>Select your profession?</label>
                                <i class="icon-down-open-mini"></i>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript:;" onclick="otpController.professoin('salaried','Salaried')">Salaried</a></li>
                                    <li><a href="javascript:;" onclick="otpController.professoin('self_employed','Self Employed')">Self Employed</a></li>
                                    <li><a href="javascript:;" onclick="otpController.professoin('student','Student')">Student</a></li>
                                </ul>
                            </div>
                            <div class="h_field width50 <%= otpController.furnishedText ? 'open_l' : '' %>" dropdown>
                                <a href="javascript:;" data-toggle="dropdown">
                                    <span><%= otpController.furnishedText %>&nbsp;</span>
                                </a>
                                <label>Select furnished type</label>
                                <i class="icon-down-open-mini"></i>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript:;" onclick="otpController.furnished('furnished','Furnished')">Furnished</a></li>
                                    <li><a href="javascript:;" onclick="otpController.furnished('unfurnished','Unfurnished')">Unfurnished</a></li>
                                    <li><a href="javascript:;" onclick="otpController.furnished('semi-furnished','Semi-furnished')">Semi-furnished</a></li>
                                </ul>
                            </div>
                            <div class="clearfix"></div>
                            <div class="h_field open_l">
                                <input type="number" value="" id="maxBudget" onkeypress="return this.value.length <= 10">
                                <label>Max Budget</label>
                            </div>
                            <div class="clearfix"></div>
                            <% } %>

                            <% if(globals.pageType =='project' || otpController.propertySnippet.propertyFor =='buy' || otpController.propertySnippet.propertyFor =='sale' ){ %>
                            <div class="h_field width50 <%= otpController.homePurchaseText ? 'open_l' : '' %>" dropdown>
                                <a href="javascript:;" data-toggle="dropdown">
                                    <span><%= otpController.homePurchaseText %></span>
                                </a>
                                <label>How urgent is your home purchase requirement ?</label>
                                <i class="icon-down-open-mini"></i>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript:void(0);" onclick="otpController.homePurchase('URGENT','I need to find something, urgently')">I need to find something, urgently</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.homePurchase('SOON','I need to find something, soon')">I need to find something, soon</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.homePurchase('AWAITING OPTIONS','I can wait till I get a suitable option')">I can wait till I get a suitable option</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.homePurchase('AWAITING GOOD DEAL','I’m looking for a favourable deal')">I’m looking for a favourable deal</a></li>
                                </ul>
                            </div>

                            <% if(!otpController.loanRequirement) { %>
                            <div class="h_field width50 <%= otpController.possessionTypeValue ? 'open_l' : '' %>" dropdown>
                                <a href="javascript:void(0);" data-toggle="dropdown">
                                    <span><%= otpController.possessionTypeValue %></span>
                                </a>
                                <label>How soon are your looking to take possession?</label>
                                <i class="icon-down-open-mini"></i>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript:void(0);" onclick="otpController.possessionType('Ready To Move')">Ready To Move</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.possessionType('Possession in 2026')">Possession in 2026</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.possessionType('Possession in 2027')">Possession in 2027</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.possessionType('Possession after 3 years')">Possession after 3 years</a></li>
                                </ul>
                            </div>
                            <% } %>

                            <div class="h_field width50 <%= otpController.brokerContactedText ? 'open_l' : '' %>" dropdown>
                                <a href="javascript:void(0);" data-toggle="dropdown">
                                    <span><%= otpController.brokerContactedText %></span>
                                </a>
                                <label>Have you contacted brokers/agents for assistance?</label>
                                <i class="icon-down-open-mini"></i>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript:void(0);" onclick="otpController.brokerContacted('IN TOUCH','Yes, I’m in touch with some brokers')">Yes, I’m in touch with some brokers</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.brokerContacted('NOT CONTACTED','No, I’ve not contacted any brokers')">No, I’ve not contacted any brokers</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.brokerContacted('LOOKING FOR','I’m looking for genuine brokers')">I’m looking for genuine brokers</a></li>
                                </ul>
                            </div>

                            <div class="h_field width50 <%= otpController.propertiesVisitedText ? 'open_l' : '' %>" dropdown>
                                <a href="javascript:void(0);" data-toggle="dropdown">
                                    <span><%= otpController.propertiesVisitedText %></span>
                                </a>
                                <label>How many properties have you already visited?</label>
                                <i class="icon-down-open-mini"></i>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript:void(0);" onclick="otpController.propertiesVisited('NONE','I have not yet visited any properties')">I have not yet visited any properties</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.propertiesVisited('LESS THAN 5','I’ve seen less than 5 properties')">I’ve seen less than 5 properties</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.propertiesVisited('GREATER THAN 5','I’ve seen More than 5 properties')">I’ve seen More than 5 properties</a></li>
                                </ul>
                            </div>
                            <% if(otpController.loanRequirement) { %>
                            <div class="h_field width50 <%= otpController.HDFCContactTypeText ? 'open_l' : '' %>" dropdown>
                                <a href="javascript:void(0);" data-toggle="dropdown">
                                    <span><%= otpController.HDFCContactTypeText %></span>
                                </a>
                                <label>How would you like HDFC to contact you?</label>
                                <i class="icon-down-open-mini"></i>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript:void(0);" onclick="otpController.HDFCContactType('TELECALL','Call from HDFC Executive')">Call from HDFC Executive</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.HDFCContactType('VISIT','A personal visit from HDFC Executive')">A personal visit from HDFC Executive</a></li>
                                </ul>
                            </div>


                            <div class="h_field width50 <%= otpController.HDFCContactTimeText ? 'open_l' : '' %>" dropdown>
                                <a href="javascript:void(0);" data-toggle="dropdown">
                                    <span><%= otpController.HDFCContactTimeText %></span>
                                </a>
                                <label>How soon would you like HDFC to contact you?</label>
                                <i class="icon-down-open-mini"></i>
                                <ul class="dropdown-menu">
                                    <li><a href="javascript:void(0);" onclick="otpController.HDFCContactTime('IMMEDIATE','Immediately')">Immediately</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.HDFCContactTime('NEXT WEEK','Next week')">Next week</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.HDFCContactTime('NEXT MONTH','Next month')">Next month</a></li>
                                    <li><a href="javascript:void(0);" onclick="otpController.HDFCContactTime('GREATER THAN 3 MONTHS','After 3 months')">After 3 months</a></li>
                                </ul>
                            </div>
                            <% } %>

                            <div class='h_field width100'>
                                    <textarea name="comments" id="userComments" cols="30" rows="3" placeholder="Please add your comments here">

                                    </textarea>
                            </div>

                            <% } %>
                        </div>
                        <button type="button" class="button button-secondary btn-lg wd100" onclick="otpController.Thankyou()">Submit</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
    </div>
</script>
<!-- SVG Icons -->
<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" display="none">
    <symbol id="icon-thumb" viewbox="0 0 511.999 511.999">
        <g>
            <g>
                <path d="M83.578,167.256H16.716C7.524,167.256,0,174.742,0,183.971v300.881c0,9.225,7.491,16.713,16.716,16.713h66.862
                    c9.225,0,16.716-7.489,16.716-16.713V183.971C100.294,174.742,92.769,167.256,83.578,167.256z" />
            </g>
        </g>
        <g>
            <g>
