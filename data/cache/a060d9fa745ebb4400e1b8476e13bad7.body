    window.Tiles = {};
    Tiles.addEventTile = (cat, pageName, galabel)=> {
        var action = pageName ? pageName + '_Real-Estate' : 'SnB_Search_Real-Estate',
        label = galabel ? galabel : 'Click_tile_Viewad';
        gtag('event', action, {
            'event_category': cat,
            'event_label': label
        });
    }
    Tiles.redirectPage = (event,url)=> {
        var className = event.target.className;
        var patt = new RegExp('notclickb');
        var res =  patt.test(className);
        if(!res){
           if(mobileAndTabletCheck()) {
               window.open(url);
           } else {
               window.open(url, '_blank');
           }
        }
    }
    Tiles.addEventViewDetail = (cat, action, label)=> {
        gtag('event', action, {
            'event_category': cat,
            'event_label': label
        });
    }
