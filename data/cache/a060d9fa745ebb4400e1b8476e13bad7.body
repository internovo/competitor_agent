<div class="quick_links hide" id="quick_links_main">
    <div class="quick_container">
        <div class="quick_button" id="qlButtonLnks">Quick Links</div>
        <div class="quick_links_box" id="qlinkbox"></div>
    </div>
</div>

<script type="text/x-underscore-template" id="quickLinksBoxTpl">
<ul class="nav nav-tabs" id="myTab" role="tablist">
    <% _.each(qlTypes, function(tp) { %>
        <li class="nav-item <%= tp.slug === slug ? 'active' : '' %>">
            <a class="nav-link js-tab-qlinks" data-key="<%= tp.slug %>" href="javascript:void(0);"><%= tp.name %></a>
        </li>
    <% }); %>
    <!-- <li class="nav-item">
        <a class="nav-link js-tab-qlinks" data-key="TopLocalities" id="TopLocality-tab" data-toggle="tab" href="#TopLocality" role="tab" aria-controls="profile" aria-selected="false">TOP LOCALITIES</a>
    </li>
    <li class="nav-item">
        <a class="nav-link js-tab-qlinks" data-key="TopBrokers" id="TopBrokers-tab" data-toggle="tab" href="#TopBrokers" role="tab" aria-controls="contact" aria-selected="false">TOP BROKERS</a>
    </li>
    <li class="nav-item">
        <a class="nav-link js-tab-qlinks" data-key="Blogs" id="Blogs-tab" data-toggle="tab" href="#Blogs" role="tab" aria-controls="contact" aria-selected="false">BLOGS</a>
    </li> -->
</ul>
<div class="tab-content" id="myTabContent">
    <div class="tab-pane fade in active" id="TopProperty" role="tabpanel" aria-labelledby="TopProperty-tab">
        <% if (subTypes.length > 0) { %>
        <div class="top_tabs">
            <ul id="stabln">
                <% _.each(subTypes, function(stp) { %>
                    <li data-subkey="<%= stp %>" class="js-subtab-qlinks <%= (currentSubType === stp) ? 'active' : '' %>"><%= stp %></li>
                <% }); %>
            </ul>
        </div>
        <% } %>
        <div class="tabs_content">
            <ul class="clearfix">
                <% _.each(propertyLinks, function(pl) { %>
                    <li><a title="<%= pl.title %>" href="<%= pl.url %>"><%= pl.title %></a></li>
                <% }); %>
            </ul>
        </div>
    </div>
</div>
</script>
