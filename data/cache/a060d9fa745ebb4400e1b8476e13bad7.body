                            <script id="projectGoogleMap_Template" type="text/x-underscore-template">
    <div class="vap-map wraper-white lozad forw" id="vap-map" etype="map">
        <div class="icon-reset-he mshow">
            <span>Location</span>
            <i class="icon-reset" id="removemobilemap"></i>
        </div>
        <div class="vap-commute-tab">
            <div class="map-tab mrtp15 active" id="commuteTab" data-dest="#project-commute">Commute</div>
            <div class="clearfix"></div>
            <div id="vap-commute" class="localityMap-content active">
                <div class="walkthroughinput heme">
                    <form name="destination" class="rela">
                        <div id="des1">
                            <input autofocus="" class="typeahead" type="text" name="destination1" placeholder="Choose destination 1..." autocomplete="off">
                            <span class="reset src" style="display: none;" onclick="reset(this,0);">&times;</span>
                        </div>
                        <div id="des2">  
                            <input autofocus="" type="text" name="destination2" placeholder="Choose destination 2..." autocomplete="off">
                            <span class="reset des" style="display: none;" onclick="reset(this,1);">&times;</span>
                        </div>
                    </form>
                    <ul id="customCommuteList" class="commutelist custom">
                        <% if(destinations[0]) { %>
                        <li onclick="displayCustomRoute('<%= btoa(JSON.stringify(destinations[0])) %>',true)">
                            <i class="icon <%= destinations[0].icon %>"></i> <%= destinations[0].facilityName %> <br/> <span><%= destinations[0].time %></span>
                            <small><%= destinations[0].distance %></small>
                            <span class="reset customdes" onclick="reset(this,0)">&times;</span>
                        </li>
                        <% } %>
                        <% if(destinations[1]) { %>
                        <li onclick="displayCustomRoute('<%= btoa(JSON.stringify(destinations[1])) %>',true)">
                            <i class="icon <%= destinations[1].icon %>"></i> <%= destinations[1].facilityName %> <br/> <span><%= destinations[1].time %></span>
                            <small><%= destinations[1].distance %></small>
                            <span class="reset customdes" onclick="reset(this,1)">&times;</span>
                        </li>
                        <% } %>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <ul id="fixedCommuteList" class="commutelist"></ul>
            </div>
            <div class="clearfix"></div>
            <div class="lotab">
                <div class="map-tab lef" id="localityTab" data-dest="#project-locality">Locality</div>
                <ul id="project-locality" class="commutelist localityMap-content">
                    <% _.each(projectMap.locality, function(cat, index){ %>
                    <li class="" onclick="plotLocalityPlaces('<%= cat.key %>')"><!-- ga-directive ga-options="{'category': 'button-RealestateResponsiveUI', 'action': 'Project_Real-Estate', 'label': 'locality_poi_@{{cat.key}}_select'}"  -->
                        <%= cat.name %>
                    </li>
                    <% }); %>
                </ul>
                <div class="clearfix"></div>
            </div>
        </div>
        <div id="builder-page-map" class="mapwrapper">
            <div class="pos-relative">
                <div id="project-page-map" style="width: 100%; height: 290px;"> </div>
            </div>
        </div>
    </div>
</script>                        </div>
