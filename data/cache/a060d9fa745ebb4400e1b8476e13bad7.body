    sample = {"id":173560,"name":"Sukhada Apartment","latitude":"19.073696299999998","longitude":"72.90658236666667","status":"completed","imageUrl":"\/\/r1\/20160227\/ak_480_840589905-1456533200_80x80.jpeg","logoImageUrl":null,"address":{"street":null,"locality":"Ghatkopar East","city":"Mumbai","cityId":"31","localityId":"131","locUrl":"https:\/\/www.quikr.com\/homes\/locality\/ghatkopar_east-mumbai\/131"},"qhAddress":"Nath Pai Nagar, Praja Society, Barrister Nath Pai Nagar, Ghatkopar East, Mumbai, Maharashtra, INDIA","mapUrl":"http:\/\/maps.google.com\/maps?q=19.073696299999998,72.90658236666667","area":null,"priceRange":{"low":0,"high":0},"builder":{"name":null,"profileUrl":null},"type":"Apartment","propertyTypes":{"Apartment":"Apartments"},"category":"Residential","description":"<p><strong>Sukhada Apartment <\/strong>is located in in Mumbai and comprises of thoughtfully built Residential Apartments. The project offers easy access to premium and basic facilities such as hospitals, schools, colleges, medical centers, grocery stores, eateries, malls and supermarts etc.<\/p>\n\n<p>Location Advantages:. Sukhada Apartment is located at a prime location of Ghatkopar East such that it provides easy connectivity through wide roads to all other major parts of the city, Mumbai. The complete address of Sukhada Apartment is Nath Pai Nagar, Praja Society, Barrister Nath Pai Nagar, Ghatkopar East, Mumbai, Maharashtra, INDIA.<\/p>\n\n<p>Builder Information:. A leading group in real-estate market in Mumbai, built these unique set of Apartments named Sukhada Apartment. This builder group has earned its name and fame because of timely delivery of world class Residential Apartments and quality of material used according to the demands of the customers.<\/p>\n\n<p>Units and interiors:. Sukhada Apartment offers 1 RK Apartments with different floor plans. The dimensions of area included in this property vary from 200- 200 square feet each. Sukhada Apartment is spread over a wide area with 3 floors. Sukhada Apartment is designed in such a way that these Apartments comprises of enough wide space for an organized home with proper ventilation in each room. The interiors are beautifully crafted with all modern and trendy fittings which give these Apartments, a contemporary look.<\/p>\n\n<p>Comforts and Amenities:. The amenities offered in Sukhada Apartment are 24Hrs Backup Electricity, CCTV Cameras, Covered Car Parking, Lift and Rain Water Harvesting.<\/p>\n\n<p>Construction and Availability Status:. Sukhada Apartment is currently completed project. For more details, you can also go through updated photo galleries, floor plans, latest offers, street videos, construction videos, reviews and locality info for better understanding of the project.<\/p>\n","totalListings":0,"totalFollowers":null,"totalRatings":null,"averageRating":null,"isOnlineBooking":null,"bookingAmount":null,"localityId":"131","launchDate":null,"completionDate":null,"projectUnits":[{"id":454175,"type":"1 RK","subType":"Apartment","superArea":200,"superAreaSqmt":18.58060073852539,"carpetArea":0,"carpetAreaSqmt":0,"plotArea":0,"plotAreaSqmt":0,"bedRooms":"1 RK","bathRooms":"0","balconies":"0","price":null,"areaUnit":"Sq. Ft.","bspPrice":null,"minRentalPrice":null,"maxRantalPrice":null,"minSalePrice":null,"maxSalePrice":null,"floorPlanImage":[],"cfUnitId":null,"floorPlansCf":null,"virtualTourLink":null,"source":null,"isAvailable":0,"modelAvailable":false,"emodelLink":null,"formattedType":"1 RK - Apartment"}],"reraRegistrationNo":null,"reraLink":null,"noOfUnits":32,"noOfFloors":3,"totalProjectArea":"0.00","totalProjectAreaSqmt":0,"isQuikrReality":0,"poi":{"poiName":"The Universal School (Ghatkopar East)","poiId":7361,"travelDistance":0.5,"travelTime":104,"location":{"lat":"19.07652","lon":"72.905262"}},"qhNumberOfLikes":0,"qhNumberOfDislikes":0,"cfNumberOfLikes":0,"cfNumberOfDislikes":0,"currentUserVoteType":null,"covidMeasures":null,"pro_unit_list":{"1":[{"id":454175,"type":"1 RK","subTy