"true"><path d="m9 18 6-6-6-6"></path></svg></button></div></div></div></div></section><section id="location" class="py-3 md:py-7" data-section="about-location"><div class=""><div class="flex flex-col "><div class="flex justify-between items-center flex-nowrap mb-4 md:mb-6"><div class="max-w-full w-auto"><h2 class="relative inline-flex flex-wrap items-baseline px-0 text-text-primary font-medium font-plusJakarta text-[18px] md:text-[24px] "><span class="inline-flex flex-wrap items-baseline"><span class="relative inline-block mr-1 md:mb-1"><span class="relative z-0">About</span></span><span class="absolute left-0 w-[32px] md:w-[64px] h-[2px] md:h-1 rounded-t-2xl bg-primary z-0 mt-1 
            -bottom-1 md:-bottom-1 h-[2px]
          "></span><span class="relative z-0">Location</span></span></h2></div><div class="mt-1 sm:mt-0 flex items-center gap-4 flex-shrink-0"></div></div></div><p class="text-text-secondary font-roboto text-sm md:text-lg text-justify line-clamp-4">Malad West is a lively and self-sufficient Mumbai suburb known for its busy commercial and shopping scene, including major malls and corporate parks. This dynamic area offers a diverse real estate market, from affordable homes to luxury residences. With plenty of dining and entertainment options, and great connectivity through Link Road and SV Road, it provides a lifestyle of ultimate convenience. An investment here guarantees a complete city experience where work and leisure are perfectly balanced in a thriving, well-connected community.</p></div></section><div id="location-map" class="py-3 md:py-7" data-section="map"><div class="w-full  font-sans"><style tag="google-maps-autocomplete">
          .pac-container {
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            margin-top: 8px;
            font-family: inherit;
            z-index: 9999 !important;
            padding: 4px 0;
          }
          .pac-item {
            padding: 10px 16px;
            cursor: pointer;
            border-top: none;
            display: flex;
            align-items: center;
            font-size: 14px;
            color: #374151;
            transition: background-color 0.15s ease;
          }
          .pac-item:hover {
            background-color: #f9fafb;
          }
          .pac-item-query {
            font-size: 14px;
            padding-right: 4px;
            color: #111827;
          }
          .pac-icon {
            margin-right: 12px;
          }
          .pac-logo:after {
            display: none;
          }
        </style><div class="flex flex-col md:flex-row md:justify-between md:items-center mb-6 gap-4"><div class="flex flex-col"><div class="flex flex-col "><div class="flex justify-between items-center flex-nowrap mb-4 md:mb-6"><div class="max-w-full w-auto"><h2 class="relative inline-flex flex-wrap items-baseline px-0 text-text-primary font-medium font-plusJakarta text-[18px] md:text-[24px] "><span class="inline-flex flex-wrap items-baseline"><span class="relative inline-block mr-1 md:mb-1"><span class="relative z-0">Maps</span></span><span class="absolute left-0 w-[32px] md:w-[64px] h-[2px] md:h-1 rounded-t-2xl bg-primary z-0 mt-1 
            -bottom-1 md:-bottom-1 h-[2px]
          "></span></span></h2></div><div class="mt-1 sm:mt-0 flex items-center gap-4 flex-shrink-0"></div></div></div></div><div class="relative w-full md:max-w-sm"><input type="text" class="flex bg-transparent px-3 py-1 file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm w-full lg:h-12 h-10 rounded-full pl-5 pr-28 border border-bgSecondary shadow-md focus-visible:ring-2 focus-visible:ring-primary focus-visible:border-primary transition-all text-[15px]" placeholder="Search a place to get direction" value=""/><button title="Use current location" class="absolute right-12 top-1/2 -translate-y-1/2  text-slate-500 hover:text-primary p-2 transition-all duration-200"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" class="w-4 h-4 lg:w-5 lg:h-5" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill="none" d="M0 0h24v24H0z"></path><path d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3A8.994 8.994 0 0 0 13 3.06V1h-2v2.06A8.994 8.994 0 0 0 3.06 11H1v2h2.06A8.994 8.994 0 0 0 11 20.94V23h2v-2.06A8.994 8.994 0 0 0 20.94 13H23v-2h-2.06zM12 19c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z"></path></svg></button><button class="absolute right-1 top-1/2 -translate-y-1/2  bg-primary hover:bg-primary/90  w-8 h-8 lg:w-10 lg:h-10 rounded-full  flex items-center justify-center  transition-all duration-200"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search w-4 h-4 lg:w-5 lg:h-5 text-white" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg></button></div></div><div class="relative group h-[380px] md:h-[450px] w-full rounded-2xl shadow-xl overflow-hidden bg-bgSecondary border border-white/20"><div class="absolute inset-0 w-full h-full"></div><div class="absolute inset-0 flex items-center justify-center bg-bgSecondary/80 backdrop-blur-[2px]"><div class="flex flex-col items-center gap-2"><div class="w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin"></div><p class="text-sm text-label font-medium">Initializing Map...</p></div></div></div><div class="grid md:grid-cols-2 gap-x-12 gap-y-2 mt-6 px-2"></div></div></div><section id="rera-registered" class="py-3 md:py-7" data-section="rera"><section class="bg-white rounded-[16px] overflow-hidden flex flex-col md:flex-row lg:flex-col xl:flex-row shadow-[1px_1px_8.4px_0px_rgba(0,0,0,0.25)] border-t-[5px] md:border-t-0 md:border-l-[5px] lg:border-l-0 lg:border-t-[5px] xl:border-t-0 xl:border-l-[5px] border-primary font-roboto"><div class="flex-1 p-6 flex flex-col justify-start"><div class="flex items-center gap-2 border border-success bg-[#E7FFF0] text-success rounded-full px-3 py-1.5 w-max font-medium font-plusJakarta text-sm md:text-base mb-6"><img alt="Verified" loading="lazy" width="16" height="16" decoding="async" data-nimg="1" style="color:transparent" src="/icons/green-check.svg"/>RERA Verified Project</div><div class="flex items-center justify-between mb-2 md:mb-4 lg:mb-2 xl:mb-4"><h3 class="text-[14px] md:text-[24px] font-mendium text-text-primary">What is RERA ?</h3></div><div class="text-text-secondary text-sm md:text-[20px] leading-relaxed space-y-4"><p>RERA (Real Estate Regulatory Authority) is a government regulatory body established under the Real Estate (Regulation and Development) Act, 2016 in India.</p><p>Its primary purpose is to regulate the real estate sector, increase transparency, and protect home buyers from fraud, project delays, and unfair practices.</p></div><div class="mt-4 md:mt-7 flex justify-center md:justify-end lg:justify-center xl:justify-end w-full"><button type="button" class="inline-flex items-center justify-center gap-2 rounded-full transition  h-[32px] md:h-[36px] px-6 font-roboto text-[12px] md:text-[14px] lg:text-[16px] bg-primary text-white hover:bg-primary-dark w-full md:w-max lg:w-full xl:w-max !h-[32px] md:!h-[48px] lg:!h-[42px] xl:!h-[48px] !px-12 text-sm md:text-base font-medium shadow-md "><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye mr-0.5" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg>View Certificate</button></div></div><div class="w-full md:w-[350px] lg:w-full xl:w-[300px] shrink-0 bg-callout-primary-light px-4 py-6 md:p-6 lg:px-4 lg:py-6 xl:p-6 flex flex-col items-center justify-center relative"><div class="flex flex-row md:flex-col lg:flex-row xl:flex-col items-center justify-around md:justify-center lg:justify-around xl:justify-center w-full gap-4 md:gap-0 lg:gap-4 xl:gap-0 max-w-full"><div class="mb-0 md:mb-4 shrink-0 cursor-pointer group/stamp relative hover:scale-105 transition-transform duration-300" title="Click to expand RERA QR scanner"><img alt="RERA Approved" loading="lazy" width="147" height="147" decoding="async" data-nimg="1" class="object-contain drop-shadow-md w-[130px] sm:w-[147px] md:w-[140px] lg:w-[147px] xl:w-[140px] h-auto" style="color:transparent" src="https://assets.nobrokerage.com/public/rera.png"/></div><div class="flex flex-col items-center shrink-0"><div class="bg-white p-2 md:p-3 lg:p-2 xl:p-3 rounded-[6px] md:rounded-[12px] lg:rounded-[6px] xl:rounded-[12px] shadow-sm mb-2 md:mb-4 lg:mb-2 xl:mb-4 cursor-pointer hover:scale-105 hover:shadow-md transition-all duration-300 group/qr relative" title="Click to expand RERA QR code"><img alt="RERA QR Code" loading="lazy" width="160" height="160" decoding="async" data-nimg="1" class="w-[86px] h-[86px] md:w-[160px] md:h-[160px] lg:w-[100px] lg:h-[100px] xl:w-[160px] xl:h-[160px] object-cover rounded-[5.71px] md:rounded-[8px] lg:rounded-[5.71px] xl:rounded-[8px]" style="color:transparent" src="https://assets.nobrokerage.com/1763016353585-c0f2840bc98c70ef.jpg"/><div class="absolute inset-0 bg-black/10 opacity-0 group-hover/qr:opacity-100 transition-opacity duration-300 rounded-[6px] md:rounded-[12px] lg:rounded-[6px] xl:rounded-[12px] flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2 text-white drop-shadow-md w-5 h-5 md:w-7 md:h-7" aria-hidden="true"><path d="M15 3h6v6"></path><path d="m21 3-7 7"></path><path d="m3 21 7-7"></path><path d="M9 21H3v-6"></path></svg></div></div><div class="text-center w-full min-h-[32px] md:min-h-[48px] flex flex-col justify-center"><div class="animate-in fade-in zoom-in duration-300"><p class="text-text-secondary text-[11px] md:text-[13px] uppercase font-medium">RERA ID</p><p class="text-text-primary text-[12px] md:text-[15px] font-semibold">P51800055521</p></div></div></div></div></div></section></section><section id="developer" class="py-3 md:py-7" data-section="developer"><div class="bg-white font-roboto"><div class="flex flex-col "><div class="flex justify-between items-center flex-nowrap mb-4 md:mb-6"><div class="max-w-full w-auto"><h2 class="relative inline-flex flex-wrap items-baseline px-0 text-text-primary font-medium font-plusJakarta text-[18px] md:text-[24px] "><span class="inline-flex flex-wrap items-baseline"><span class="relative inline-block mr-1 md:mb-1"><span class="relative z-0">About</span></span><span class="absolute left-0 w-[32px] md:w-[64px] h-[2px] md:h-1 rounded-t-2xl bg-primary z-0 mt-1 
            -bottom-1 md:-bottom-1 h-[2px]
          "></span><span class="relative z-0">Developer</span></span></h2></div><div class="mt-1 sm:mt-0 flex items-center gap-4 flex-shrink-0"></div></div></div><div class="flex items-center gap-4 my-4 md:mt-4 p-2"><a aria-label="Open Ruparel Realty page" title="Ruparel Realty" target="_self" rel="noopener noreferrer" class="relative inline-flex items-center justify-center shrink-0 w-[71px] h-[57px] sm:w-[147px] sm:h-[91px] rounded-md transition-transform duration-200 hover:scale-105 focus:scale-105]" href="/builder/ruparel-realty"><img alt="Ruparel Realty" loading="lazy" decoding="async" data-nimg="fill" class="object-contain" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://assets.nobrokerage.com/production/2026/05/14/IMAGE/ruparel-realty-logo-jpeg-1-6931a9.jpg"/></a><div class="md:ml-6"><div class="flex items-center gap-2"><span class="text-text-primary font-medium text-base md:text-2xl font-roboto">Ruparel Realty</span><img alt="Check" loading="lazy" width="14" height="14" decoding="async" data-nimg="1" class="h-4 w-4 md:h-5 md:w-5" style="color:transparent" src="/icons/green-check.svg"/></div><p class="text-text-primary text-xs md:text-sm mt-2 md:mt-4">Years of Experience –<!-- --> <span class="font-semibold text-text-primary">26<!-- --> years</span></p></div></div><div class="w-full h-px bg-[#9A9A9A80] my-4"></div><div class="mb-4"><p class="text-text-secondary text-sm md:text-lg text-justify line-clamp-4">Ruparel Realty has emerged as a trusted name in Mumbai’s premium real estate segment, driven by a vision to create iconic developments across the city. With over two decades of experience, the group has delivered and developed more than 6 million sq. ft. of residential and commercial spaces. The company’s focus lies in delivering architectural excellence, modern design, and unmatched customer satisfaction. Ruparel Realty’s portfolio spans key areas such as Parel, Kandivali, Chembur, and Navi Mumbai. Each project reflects a commitment to quality and innovation, featuring superior craftsmanship and thoughtfully curated amenities. The company’s approach combines luxury with functionality, ensuring every home enhances the resident’s lifestyle. Guided by integrity and transparency, Ruparel Realty continues to shape Mumbai’s skyline with projects that symbolize comfort, security, and exclusivity.</p></div><div class="flex justify-between items-center py-3 md:py-4 px-2 rounded-[6px] bg-white mt-4"><div class="flex-1 flex flex-col items-center"><span class="text-xl md:text-2xl font-semibold text-primary mb-1 font-plusJakarta">12</span><span class="text-sm md:text-base text-text-primary">Projects</span><span class="text-xs text-text-secondary">Completed</span></div><div class="w-px self-stretch bg-gradient-to-b from-transparent via-black/20 to-transparent"></div><div class="flex-1 flex flex-col items-center"><span class="text-xl md:text-2xl font-semibold text-primary mb-1 font-plusJakarta">21</span><span class="text-sm md:text-base  text-text-primary">Ongoing</span><span class="text-xs text-text-secondary">Projects</span></div><div class="w-px self-stretch bg-gradient-to-b from-transparent via-black/20 to-transparent"></div><div class="flex-1 flex flex-col items-center"><span class="text-xl md:text-2xl font-semibold text-primary mb-1 font-plusJakarta">2</span><span class="text-sm md:text-base text-text-primary">In City</span><span class="text-xs text-text-secondary">Projects</span></div></div><div class="mt-6 md:mt-8 px-2 md:px-0"><a target="_self" rel="noopener noreferrer" class="block w-full" href="/builder/ruparel-realty"><button type="button" class="inline-flex items-center justify-center gap-2 rounded-full transition  h-[32px] md:h-[36px] px-6 font-roboto text-[12px] md:text-[14px] lg:text-[16px] bg-primary text-white hover:bg-primary-dark w-full !rounded-full !py-3 text-sm md:text-lg font-medium">View Details</button></a></div></div></section><div class="min-h-[1px]" style="display:none"></div><div class="min-h-[1px]" style="display:none"></div><div class="min-h-[1px]" style="display:none"></div><section class="py-3 md:py-7"><section class="w-full py-3 md:py-7 bg-gray-50/50 rounded-2xl p-6 md:p-10 border border-gray-100"><div class="max-w-4xl"><h2 class="text-xl md:text-2xl font-bold text-secondary mb-6">Disclaimer</h2><div class="font-roboto space-y-4 text-xs md:text-sm leading-relaxed text-justify text-text-secondary transition-all duration-500 overflow-hidden relative max-h-[100px]"><p>NoBrokerage.com is a real estate advertising and information platform. We are not a real estate broker, agent, or channel partner, and we do not facilitate or participate in any property transactions.</p><p>The data displayed on this website is based on inputs from developers, owners, or public sources, and is provided for informational purposes only. While we aim for accuracy, we do not verify the data and make no guarantees regarding its completeness or correctness.</p><p>No information on this website constitutes legal, financial, or investment advice, nor should it be treated as an invitation to purchase or acquire any property. Project listings do not imply RERA registration or regulatory compliance. Users are advised to verify all information independently and consult the relevant RERA authority. All third-party names, images, logos, and trademarks belong to their respective owners.</p><p class="pt-2">For feedback or concerns, email: <a href="mailto:support@nobrokerage.com" class="font-semibold text-primary hover:underline">support@nobrokerage.com</a></p><div class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-gray-50/90 to-transparent"></div></div><button class="mt-4 text-primary font-bold text-xs md:text-sm hover:underline uppercase tracking-wider transition-colors">Read More</button></div></section></section><section id="reviews" class="py-3 md:py-7" data-section="reviews"><div class="w-full h-64 flex items-center justify-center bg-gray-50 rounded-xl border border-gray-100"><div class="flex flex-col items-center gap-3"><div class="w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin"></div><p class="text-text-secondary font-medium">Loading reviews...</p></div></div></section><div class="min-h-[1px]" style="display:none"></div><div class="min-h-[1px]" style="display:none"></div><section id="faq" data-section="faq" class="py-3 md:py-7"><section class="w-full min-w-0 overflow-hidden"><div class="text-start mb-8 md:mb-12"><div class="mb-4 flex flex-wrap items-center gap-x-2 md:gap-x-3"><h1 class="font-plusJakarta text-text-primary text-xl md:text-[48px] lg:text-[35px] xl:text-[48px] font-bold md:font-semibold m-0 leading-none">Frequently Asked</h1><span class="font-Freehand text-2xl md:text-[56px] lg:text-[35px] xl:text-[56px] font-normal text-primary leading-none">Questions</span></div><p class="text-xs md:text-base font-roboto text-text-secondary">Get answers to the most common questions about <!-- -->Ruparel Stardom in <!-- -->West Pune</p></div><div class="flex flex-col gap-3 md:gap-6"><div class="rounded-xl p-4 md:py-5 md:px-8 gap-4 md:gap-6 shadow-md md:shadow-[1px_1px_7px_rgba(0,0,0,0.21)] transition-all duration-300 w-full min-w-0 overflow-hidden max-w-full bg-gray-50"><button class="flex w-full items-center justify-between text-left gap-3 min-w-0 overflow-hidden"><h3 class="text-sm md:text-lg font-roboto transition-colors flex-1 min-w-0 break-words [overflow-wrap:anywhere] [word-break:break-word] pr-2 text-text-primary">Who is the builder of Ruparel Stardom?</h3><div class="flex h-5 w-5 md:h-8 md:w-8 shrink-0 items-center justify-center rounded-full transition-colors bg-[rgba(154,154,154,0.25)]"><svg class="w-[12px] h-[12px] md:w-6 md:h-6 text-[#505050]" viewBox="0 0 20 20" fill="none"><path d="M5.83329 8.33333L9.99996 12.5L14.1666 8.33333" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></di