.com/production/2026/06/18/IMAGE/lifts-passenger-and-service-dafce3.png\"},{\"name\":\"Reading Zones\",\"icon\":\"https://assets.nobrokerage.com/public/Amenities-new/reading-zones.svg\"},{\"name\":\"Branded Fittings \u0026 Fixtures\",\"icon\":\"https://assets.nobrokerage.com/production/2026/06/18/IMAGE/branded-fittings-and-fixtures-a24bf4.png\"}],\"builder\":[{\"id\":\"cmgrjannr011gqqgde3zzncq1\",\"name\":\"Ruparel realty\",\"slug\":\"ruparel-realty\",\"description\":\"Ruparel Realty has emerged as a trusted name in Mumbai’s premium real estate segment, driven by a vision to create iconic developments across the city. With over two decades of experience, the group has delivered and developed more than 6 million sq. ft. of residential and commercial spaces. The company’s focus lies in delivering architectural excellence, modern design, and unmatched customer satisfaction. Ruparel Realty’s portfolio spans key areas such as Parel, Kandivali, Chembur, and Navi Mumbai. Each project reflects a commitment to quality and innovation, featuring superior craftsmanship and thoughtfully curated amenities. The company’s approach combines luxury with functionality, ensuring every home enhances the resident’s lifestyle. Guided by integrity and transparency, Ruparel Realty continues to shape Mumbai’s skyline with projects that symbolize comfort, security, and exclusivity.\",\"logo\":\"https://assets.nobrokerage.com/production/2026/05/14/IMAGE/ruparel-realty-logo-png-1-36316f.png\",\"builderLogoPng\":\"https://assets.nobrokerage.com/production/2026/05/14/IMAGE/ruparel-realty-logo-png-1-36316f.png\",\"builderLogoJpg\":\"https://assets.nobrokerage.com/production/2026/05/14/IMAGE/ruparel-realty-logo-jpeg-1-6931a9.jpg\",\"yearsOfExperience\":26,\"totalProjects\":33,\"completedProjects\":12,\"ongoingProjects\":21,\"operatingCityCount\":2,\"displayContact\":false,\"displayNumberWebsite\":null}],\"rating\":0,\"metaTitle\":\"Ruparel Stardom\",\"metaDescription\":\"Upgrade to high-demand 2 BHK 3 BHK 4 BHK Jodi Apartments at Ruparel Stardom by Ruparel Realty in Evershine Nagar, Malad West, Mumbai. Book your dream home without hidden costs\\n\",\"metaKeywords\":[\"high-demand\",\"2 BHK\",\"3 BHK\",\"4 BHK Jodi\",\"Apartments\",\"Ruparel Stardom\",\"Ruparel Realty\",\"Evershine Nagar\",\"Malad West\",\"Mumbai\",\"nobrokerage.com\"],\"lift\":true,\"parking\":true,\"contactClicks\":0}}],\"$L25\"]\n"])</script><script>self.__next_f.push([1,"25:[\"$\",\"$L26\",null,{\"s3Url\":null}]\n20:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n1b:null\n"])</script><script>self.__next_f.push([1,"1d:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Ruparel Stardom, Malad West, Mumbai | NoBrokerage.com\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Ruparel Stardom offers an exceptional blend of luxury, connectivity, and modern lifestyle in the heart of Malad West. Developed by the trusted Ruparel Realty, …\"}],[\"$\",\"meta\",\"2\",{\"name\":\"keywords\",\"content\":\"Ruparel Stardom,Ruparel realty,Malad West,Mumbai,1BHK,2BHK,3BHK,price,amenities,RERA,No Brokerage\"}],[\"$\",\"meta\",\"3\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://www.example.com/project/details/ruparel-stardom-evershine-nagar-malad-west-mumbai-668762\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:title\",\"content\":\"Ruparel Stardom, Malad West, Mumbai\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:description\",\"content\":\"Ruparel Stardom offers an exceptional blend of luxury, connectivity, and modern lifestyle in the heart of Malad West. Developed by the trusted Ruparel Realty, …\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:url\",\"content\":\"https://www.example.com/project/details/ruparel-stardom-evershine-nagar-malad-west-mumbai-668762\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:site_name\",\"content\":\"