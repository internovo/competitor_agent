    <section class="hero-banner position-relative text-white d-flex align-items-center" style="min-height: 70vh; background: linear-gradient(135deg, #1a2a3a, #2c3e50);">
    <div class="container">
      <div class="row align-items-center" style="padding: 60px 0 20px 0;">
