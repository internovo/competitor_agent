  <!-- // ===== Menu Script ===== -->
<!-- ===== Menu Script ===== -->
<script>
const hamburger = document.getElementById("hamburger");
const navMenu = document.getElementById("navMenu");

// ===== BREAKPOINT =====
const mobileBreakpoint = 992;

function isMobileView() {
    return window.innerWidth <= mobileBreakpoint;
}

// ===== HAMBURGER =====
hamburger.addEventListener("click", function () {
    navMenu.classList.toggle("active");
});

// ===== POSITION MAIN DROPDOWN INSIDE VIEWPORT =====
function positionDropdown(dropdown) {
    const menu = dropdown.querySelector(".projects-menu");
    if (!menu || isMobileView()) return;

    menu.style.left = "0px";
    menu.style.right = "auto";
    menu.style.transform = "none";

    const dropdownRect = dropdown.getBoundingClientRect();
    const menuRect = menu.getBoundingClientRect();
    const viewportWidth = window.innerWidth;
    const padding = 12;

    let left = 0;

    if (dropdownRect.left + menuRect.width > viewportWidth - padding) {
        left = viewportWidth - padding - dropdownRect.left - menuRect.width;
    }

    if (dropdownRect.left + left < padding) {
        left = padding - dropdownRect.left;
    }

    menu.style.left = `${left}px`;
}

// ===== POSITION SUBMENU INSIDE VIEWPORT =====
function positionSubmenu(subDropdown) {
    const subMenu = subDropdown.querySelector(".sub-menu");
    if (!subMenu || isMobileView()) return;

    subMenu.style.left = "calc(100% + 12px)";
    subMenu.style.right = "auto";
    subMenu.style.transform = "none";

    const subRect = subDropdown.getBoundingClientRect();
    const menuRect = subMenu.getBoundingClientRect();
    const viewportWidth = window.innerWidth;
    const padding = 12;

    let left = subDropdown.offsetWidth + 12;

    if (subRect.left + left + menuRect.width > viewportWidth - padding) {
        left = -(menuRect.width + 12);
    }

    if (subRect.left + left < padding) {
        left = padding - subRect.left;
    }

    subMenu.style.left = `${left}px`;
}

// ===== CLEAR ALL DROPDOWNS =====
function closeAllDropdowns() {
    document.querySelectorAll(".projects-dropdown").forEach(d => {
        d.classList.remove("active");
    });

    document.querySelectorAll(".sub-dropdown").forEach(d => {
        d.classList.remove("active");
    });
}

// ===== MAIN DROPDOWNS =====
document.querySelectorAll(".projects-dropdown").forEach(dropdown => {
    let timeout;
    const toggle = dropdown.querySelector(".projects-toggle");
    const menu = dropdown.querySelector(".projects-menu");

    // ===== DESKTOP / LAPTOP HOVER =====
    dropdown.addEventListener("mouseenter", function () {
        if (isMobileView()) return;

        clearTimeout(timeout);

        document.querySelectorAll(".projects-dropdown").forEach(d => {
            if (d !== dropdown) d.classList.remove("active");
        });

        dropdown.classList.add("active");
        setTimeout(() => positionDropdown(dropdown), 10);
    });

    dropdown.addEventListener("mouseleave", function () {
        if (isMobileView()) return;

        timeout = setTimeout(() => {
            dropdown.classList.remove("active");
        }, 500); // 0.5 sec delay
    });

    if (menu) {
        menu.addEventListener("mouseenter", function () {
            if (isMobileView()) return;
            clearTimeout(timeout);
            dropdown.classList.add("active");
        });

        menu.addEventListener("mouseleave", function () {
            if (isMobileView()) return;
            timeout = setTimeout(() => {
                dropdown.classList.remove("active");
            }, 500);
        });
    }

    // ===== MOBILE / TABLET CLICK =====
    if (toggle) {
        toggle.addEventListener("click", function (e) {
            if (!isMobileView()) return;

            e.preventDefault();
            e.stopPropagation();

            const isOpen = dropdown.classList.contains("active");

            document.querySelectorAll(".projects-dropdown").forEach(d => {
                if (d !== dropdown) d.classList.remove("active");
            });

            document.querySelectorAll(".sub-dropdown").forEach(d => {
                d.classList.remove("active");
            });

            if (isOpen) {
                dropdown.classList.remove("active");
            } else {
                dropdown.classList.add("active");
            }
        });
    }
});

// ===== SUB DROPDOWNS =====
document.querySelectorAll(".sub-dropdown").forEach(subDropdown => {
    let subTimeout;
    const subToggle = subDropdown.querySelector(":scope > a");
    const subMenu = subDropdown.querySelector(".sub-menu");

    // ===== DESKTOP / LAPTOP HOVER =====
    subDropdown.addEventListener("mouseenter", function () {
        if (isMobileView()) return;

        clearTimeout(subTimeout);
        subDropdown.classList.add("active");
        setTimeout(() => positionSubmenu(subDropdown), 10);
    });

    subDropdown.addEventListener("mouseleave", function () {
        if (isMobileView()) return;

        // Wait 0.5 sec before hiding
        subTimeout = setTimeout(() => {
            subDropdown.classList.remove("active");
        }, 500);
    });

    if (subMenu) {
        subMenu.addEventListener("mouseenter", function () {
            if (isMobileView()) return;
            clearTimeout(subTimeout); // Cancel hiding when hovering on sub-menu
            subDropdown.classList.add("active");
        });

        subMenu.addEventListener("mouseleave", function () {
            if (isMobileView()) return;

            // Wait 0.5 sec before hiding after leaving sub-menu
            subTimeout = setTimeout(() => {
                subDropdown.classList.remove("active");
            }, 500);
        });
    }

    // ===== MOBILE / TABLET CLICK =====
    if (subToggle) {
        subToggle.addEventListener("click", function (e) {
            if (!isMobileView()) return;

            e.preventDefault();
            e.stopPropagation();

            const isOpen = subDropdown.classList.contains("active");

            document.querySelectorAll(".sub-dropdown").forEach(d => {
                if (d !== subDropdown) d.classList.remove("active");
            });

            if (isOpen) {
                subDropdown.classList.remove("active");
            } else {
                subDropdown.classList.add("active");
            }
        });
    }
});

// ===== CLICK OUTSIDE =====
document.addEventListener("click", function (e) {
    if (!isMobileView()) return;

    if (!navMenu.contains(e.target) && !hamburger.contains(e.target)) {
        closeAllDropdowns();
        navMenu.classList.remove("active");
        return;
    }

    document.querySelectorAll(".projects-dropdown").forEach(dropdown => {
        if (!dropdown.contains(e.target)) {
            dropdown.classList.remove("active");
        }
    });

    document.querySelectorAll(".sub-dropdown").forEach(subDropdown => {
        if (!subDropdown.contains(e.target)) {
            subDropdown.classList.remove("active");
        }
    });
});

// ===== RESET ON RESIZE =====
window.addEventListener("resize", function () {
    closeAllDropdowns();

    if (!isMobileView()) {
        navMenu.classList.remove("active");
    }
});
</script>
<script>
  function toggleReadMore(btn) {
    const description = btn.previousElementSibling;
    const dots = description.querySelector(".dots");
    const moreText = description.querySelector(".more-text");

    if (moreText.style.display === "inline") {
      moreText.style.display = "none";
      dots.style.display = "inline";
      btn.innerText = "Read More";
    } else {
      moreText.style.display = "inline";
      dots.style.display = "none";
      btn.innerText = "Read Less";
    }
  }
</script>
<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const ctx = document.getElementById('priceTrendChart').getContext('2d');

const gradient = ctx.createLinearGradient(0, 0, 0, 400);
gradient.addColorStop(0, 'rgba(0, 123, 255, 0.3)');
gradient.addColorStop(1, 'rgba(0, 123, 255, 0.05)');

const priceTrendChart = new Chart(ctx, {
    type: 'line',
    data: {
        labels: ['2019','2020','2021','2022','2023','2024','2025','2026'],
        datasets: [{
            label: 'Avg Price (₹/sq.ft)',
            data: [4200,4500,5200,6500,8200,9000,10500,12000],
            fill: true,
            backgroundColor: gradient,
            borderColor: '#007bff',
            borderWidth: 3,
            tension: 0.4,
            pointBackgroundColor: '#007bff',
            pointBorderColor: '#fff',
            pointBorderWidth: 2,
            pointRadius: 4,
            pointHoverRadius: 8,
            pointHoverBackgroundColor: '#0056b3'
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false, // 👈 important for mobile
        interaction: {
            mode: 'nearest',
            intersect: false
        },
        plugins: {
            legend: { display: true },
            tooltip: {
                backgroundColor: '#1a2b49',
                titleColor: '#fff',
                bodyColor: '#fff',
                padding: 12,
                displayColors: false,
                callbacks: {
                    label: function(context) {
                        return '₹ ' + context.raw + ' / sq.ft';
                    }
                }
            }
        },
        scales: {
            y: {
                ticks: {
                    callback: value => '₹' + value
                },
                grid: { color: '#eee' }
            },
            x: {
                grid: { display: false }
            }
        }
    }
});
</script>
</body>  
