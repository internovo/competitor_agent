  <section class="Amenities_warpper bg-grey ptb-80" id="Amenities">
    <div class="container">
        <div class="row">
            <div class="col-md-12 text-center">
                <h2>Amenities at Dhuleva Marine Lines Mumbai</h2>
                <span class="divied"></span>
            </div>
            <div class="col-md-12">
                <div class="amentiBox">
                        <div class="IconBox">
