# Copy to .env and fill in. All optional in fixture mode.

# --- LLM ---------------------------------------------------------------------
# Anthropic is the default and the only provider this repo is tuned for.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Groq is a FALLBACK, kept working but not optimised for. Its free tier allows
# 8k tokens/minute and 200k tokens/day counting prompt + completion: a scan of
# eight projects costs roughly 50k, so a few runs exhaust the day. When that
# happens every extraction raises RateLimitError -- which now FAILS the run
# rather than returning projects with every field unknown.
# GROQ_MAX_OUTPUT_TOKENS keeps one request from breaching the per-minute ceiling
# on its own; a 16k output reservation rejects every request by itself.
# LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_OUTPUT_TOKENS=2048
GROQ_REASONING_EFFORT=low

# --- other keys --------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
TAVILY_API_KEY=

# --- modes -------------------------------------------------------------------
# fixture  -> hand-written competitor data, no network, no LLM needed (default)
# replay   -> serve every HTTP call from data/cache; regexes read the cached
#             pages and Claude is asked only for what they could not answer
# live     -> hit the real sources and write data/cache
FETCH_MODE=fixture

# Comma-separated sources used in replay/live mode
SOURCES=maharera,places,tavily,squareyards,housing,builder_site,propog
DEFAULT_RADIUS_KM=1.5

# --- runs are held in memory only, never on disk ------------------------------
# The canonical copy of a scan is written by the Node API, against Postgres.
MAX_RUNS_HELD=50
RUN_TTL_HOURS=2

# --- unit prices for the run-cost ESTIMATE (not a bill) ----------------------
INR_PER_USD=88.0
LLM_INPUT_USD_PER_MTOK=15.0
LLM_OUTPUT_USD_PER_MTOK=75.0
SEARCH_USD_PER_CALL=0.008
PLACES_USD_PER_CALL=0.032
